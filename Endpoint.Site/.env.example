# رشته اتصال SQL Server (الزامی)
CONNECTION_MVPTest=Server=.;Database=YourDb;Trusted_Connection=True;TrustServerCertificate=True

# اختیاری — احراز هویت و کوکی
# COOKIE_EXPIRETIME=60
# COOKIE_DOMAIN=

# سرویس پیامک LimoSMS
SMS_ApiKey=your-api-key
SMS_Send_Url=https://api.limosms.com/api/sendcode
SMS_CHECK_Url=https://api.limosms.com/api/checkcode
# ارسال متنی دعوت (مثل Wang: peer-to-peer)
SMS_Sender_Number=10000000002027
SMS_Bulk_Send_Url=https://api.limosms.com/api/sendpeertopeersms

# آدرس عمومی همین سایت (بدون اسلش انتهایی) برای لینک داخل پیامک دعوت
# PUBLIC_APP_URL=https://your-domain.com

# بازوی بله (اختیاری)
# BALE_BOT_TOKEN=

# آدرس پایه فایل‌های ذخیره‌شده (بدون اسلش انتهایی)
# در دیتابیس فقط مسیر نسبی ذخیره می‌شود؛ این مقدار موقع نمایش چسبانده می‌شود
FILE_BASE_URL=https://shidatis.com

# اختیاری — دامنه‌های قدیمی برای جدا کردن از URLهای ذخیره‌شده قبلی (با کاما)
# FILE_LEGACY_BASE_URLS=https://old-cdn.example.com,https://shidatis.ir
