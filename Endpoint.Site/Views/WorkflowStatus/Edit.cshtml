@model Endpoint.Site.Models.WorkflowStatusEditVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var sprintName = ViewBag.SprintName as string;
    var projectName = ViewBag.ProjectName as string;
    var sprintId = ViewBag.SprintId as int?;
}

<h2>ویرایش وضعیت</h2>

@if (!string.IsNullOrEmpty(sprintName))
{
    <p class="text-muted">اسپرینت: <strong>@sprintName</strong></p>
}
@if (!string.IsNullOrEmpty(projectName))
{
    <p class="text-muted">پروژه: <strong>@projectName</strong></p>
}

<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="Type" />
    <div class="mb-3">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" type="color" class="form-control form-control-color" />
        <span asp-validation-for="Color" class="text-danger"></span>
        <small class="form-text text-muted">رنگ نمایش وضعیت را انتخاب کنید</small>
    </div>

    <div class="mb-3">
        <label asp-for="Order" class="form-label"></label>
        <input asp-for="Order" type="number" class="form-control" />
        <span asp-validation-for="Order" class="text-danger"></span>
        <small class="form-text text-muted">ترتیب نمایش وضعیت در لیست</small>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
        @if (sprintId.HasValue)
        {
            <a class="btn btn-secondary" href="/WorkflowStatus/Index?sprintId=@sprintId">انصراف</a>
        }
        else
        {
            <a class="btn btn-secondary" asp-action="Index">انصراف</a>
        }
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

