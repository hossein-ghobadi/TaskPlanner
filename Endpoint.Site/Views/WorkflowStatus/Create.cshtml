@model Endpoint.Site.Models.WorkflowStatusCreateVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var sprintName = ViewBag.SprintName as string;
    var projectName = ViewBag.ProjectName as string;
    var sprintId = ViewBag.SprintId as int?;
}

<h2>ایجاد وضعیت جدید</h2>

@if (!string.IsNullOrEmpty(sprintName))
{
    <p class="text-muted">اسپرینت: <strong>@sprintName</strong></p>
}
@if (!string.IsNullOrEmpty(projectName))
{
    <p class="text-muted">پروژه: <strong>@projectName</strong></p>
}

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="ProjectId" />
    <input type="hidden" asp-for="SprintId" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="Type" value="@WorkflowType.InProgress" />
    <div class="mb-3">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" type="color" class="form-control form-control-color" value="#6c757d" />
        <span asp-validation-for="Color" class="text-danger"></span>
        <small class="form-text text-muted">رنگ نمایش وضعیت را انتخاب کنید</small>
    </div>

    <input type="hidden" asp-for="Order" />
    <div class="alert alert-info">
        <small><i class="bi bi-info-circle"></i> وضعیت جدید به صورت خودکار بین "باید انجام شود" (اول) و "انجام شده" (آخر) قرار خواهد گرفت. می‌توانید ترتیب را بعداً با drag & drop تغییر دهید.</small>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">ایجاد وضعیت</button>
        @{
            var sprintId = ViewBag.SprintId as int?;
            if (sprintId.HasValue)
            {
                <a class="btn btn-secondary" href="/WorkflowStatus/Index?sprintId=@sprintId">انصراف</a>
            }
            else
            {
                <a class="btn btn-secondary" href="/WorkflowStatus/Index?projectId=@Model.ProjectId">انصراف</a>
            }
        }
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

