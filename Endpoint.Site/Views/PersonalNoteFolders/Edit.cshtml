@model PersonalNoteFolderEditVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "ویرایش پوشه";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-folder"></i>
                        ویرایش پوشه
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            @TempData["Error"]
                        </div>
                    }

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                <i class="bi bi-folder"></i>
                                نام پوشه <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="مثلاً: کار، شخصی، پروژه‌ها" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ParentFolderId" class="form-label">
                                <i class="bi bi-folder-fill"></i>
                                پوشه والد (اختیاری)
                            </label>
                            <select asp-for="ParentFolderId" class="form-select">
                                @foreach (var folder in ViewBag.Folders as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                {
                                    <option value="@folder.Value">@folder.Text</option>
                                }
                            </select>
                            <small class="form-text text-muted">می‌توانید این پوشه را در داخل یک پوشه دیگر قرار دهید</small>
                            <span asp-validation-for="ParentFolderId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Color" class="form-label">
                                <i class="bi bi-palette"></i>
                                رنگ پوشه (اختیاری)
                            </label>
                            <input type="color" asp-for="Color" class="form-control form-control-color" value="@(Model.Color ?? "#3b82f6")" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" asp-controller="PersonalNotes" class="btn btn-secondary">
                                <i class="bi bi-arrow-right"></i>
                                انصراف
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-lg"></i>
                                ذخیره تغییرات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

