@model Endpoint.Site.Models.VacuumWageCostTestVm
@using TaskPlanner.Domain.Entities.Calculation
@{
    ViewData["Title"] = "تست ماژول دستمزد وکیوم";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0" style="max-width: 960px;">
    <div class="mb-4">
        <div class="mb-2">
            <a href="/ModuleTests/Index" class="text-decoration-none small">
                <i class="bi bi-arrow-right me-1"></i>
                بازگشت به لیست ماژول‌ها
            </a>
        </div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-wind me-2"></i>
            تست ماژول دستمزد وکیوم
        </h2>
        <p class="text-muted mb-0">
            دستمزد وکیوم را برای دسته‌های وکیوم با رینگ محاسبه کنید.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-6">
            <form method="post" asp-action="VacuumWageCost" id="vacuum-wage-cost-form" class="card border-0 shadow-sm">
                @Html.AntiForgeryToken()
                <div class="card-header bg-white py-3">
                    <strong>ورودی‌ها</strong>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" class="form-select" id="category-select">
                            @foreach (var category in Model.AllCategories)
                            {
                                <option value="@((int)category)"
                                        data-can-vacuum="@(category.CanHaveVacuumWageCost() ? "true" : "false")">
                                    @category.GetDisplayName()
                                </option>
                            }
                        </select>
                        <div class="form-text text-muted d-none" id="no-vacuum-hint">
                            دستمزد وکیوم فقط برای وکیوم با رینگ آهن و وکیوم با رینگ استیل است.
                        </div>
                    </div>

                    <div id="vacuum-inputs" class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="EdgeSize" class="form-label"></label>
                            <input asp-for="EdgeSize" class="form-control" type="number" step="any" min="0" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="VacuumUnitPrice" class="form-label"></label>
                            <input asp-for="VacuumUnitPrice" class="form-control" type="number" step="any" min="0" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-play-fill me-1"></i>
                        محاسبه
                    </button>
                </div>
            </form>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white py-3">
                    <strong>قوانین ماژول</strong>
                </div>
                <div class="card-body small">
                    <ul class="mb-0 pe-3">
                        <li class="mb-2"><strong>دسته‌های دارای وکیوم:</strong> وکیوم با رینگ آهن، وکیوم با رینگ استیل</li>
                        <li class="mb-2"><strong>فرمول:</strong> سایز لبه × فی وکیوم</li>
                        <li class="mb-0"><strong>سایر دسته‌ها:</strong> دستمزد وکیوم ندارند</li>
                    </ul>
                </div>
            </div>

            @if (Model.HasResult)
            {
                @if (Model.IsSuccess)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <strong>خروجی شفاف</strong>
                            <span class="badge text-bg-success">موفق</span>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="text-muted small">دسته</div>
                                <div class="fw-semibold">@Model.CategoryDisplayName</div>
                            </div>
                            <div class="alert alert-light border small mb-3">
                                @Model.RuleDescription
                            </div>

                            @if (!Model.Applies)
                            {
                                <div class="p-3 rounded bg-primary-subtle">
                                    <div class="text-muted small">هزینه وکیوم</div>
                                    <div class="fs-4 fw-bold">0</div>
                                </div>
                            }
                            else
                            {
                                <div class="border rounded p-3 mb-3">
                                    <div class="fw-semibold mb-1">هزینه وکیوم</div>
                                    <div class="small text-muted mb-1">@Model.Formula</div>
                                    <div class="font-monospace mb-2">@Model.FormulaWithValues</div>
                                    <div>مبلغ: <strong>@Model.VacuumWageCost.ToString("#,0.####")</strong></div>
                                </div>

                                <div class="p-3 rounded bg-primary-subtle">
                                    <div class="text-muted small">جمع دستمزد وکیوم</div>
                                    <div class="fs-4 fw-bold">@Model.VacuumWageCost.ToString("#,0.####")</div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        @(Model.Message ?? "خطا در محاسبه")
                    </div>
                }
            }
            else
            {
                <div class="alert alert-secondary mb-0">
                    پس از وارد کردن مقادیر و زدن «محاسبه»، خروجی اینجا نمایش داده می‌شود.
                </div>
            }
        </div>
    </div>
</div>

<script>
(() => {
    const categorySelect = document.getElementById('category-select');
    const vacuumInputs = document.getElementById('vacuum-inputs');
    const noVacuumHint = document.getElementById('no-vacuum-hint');

    function syncUi() {
        const opt = categorySelect.options[categorySelect.selectedIndex];
        const canVacuum = opt?.dataset.canVacuum === 'true';
        vacuumInputs.classList.toggle('d-none', !canVacuum);
        noVacuumHint.classList.toggle('d-none', canVacuum);
    }

    categorySelect.addEventListener('change', syncUi);
    syncUi();
})();
</script>
