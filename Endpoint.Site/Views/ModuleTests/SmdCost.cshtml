@model Endpoint.Site.Models.SmdCostTestVm
@using TaskPlanner.Domain.Entities.Calculation
@{
    ViewData["Title"] = "تست ماژول هزینه SMD";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0" style="max-width: 1100px;">
    <div class="mb-4">
        <div class="mb-2">
            <a href="/ModuleTests/Index" class="text-decoration-none small">
                <i class="bi bi-arrow-right me-1"></i>
                بازگشت به لیست ماژول‌ها
            </a>
        </div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-lightbulb me-2"></i>
            تست ماژول هزینه SMD
        </h2>
        <p class="text-muted mb-0">
            هزینه SMD جلو و پشت را بر اساس دسته، طول حقیقی PVC (یا حروف برای آهن/استیل ساده)، عدد طلایی و فی محاسبه کنید.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <form method="post" asp-action="SmdCost" id="smd-cost-form" class="card border-0 shadow-sm">
                @Html.AntiForgeryToken()
                <div class="card-header bg-white py-3">
                    <strong>ورودی‌ها</strong>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" class="form-select" id="category-select">
                            @foreach (var category in Model.AllCategories)
                            {
                                <option value="@((int)category)"
                                        data-can-smd="@(category.CanHaveSmdCost() ? "true" : "false")"
                                        data-can-front="@(category.CanHaveFrontSmd() ? "true" : "false")"
                                        data-can-back="@(category.CanHaveBackSmd() ? "true" : "false")"
                                        data-pen-mode="@(category.UsesPenDiameterForBackSmd() ? "true" : "false")">
                                    @category.GetDisplayName()
                                </option>
                            }
                        </select>
                        <div class="form-text text-muted d-none" id="cut-hint">دسته برش هزینه SMD ندارد.</div>
                    </div>

                    <div id="smd-inputs">
                        <div class="mb-3 pb-2 border-bottom">
                            <div class="row g-2">
                                <div class="col-12 col-md-6" id="front-enable-group">
                                    <div class="form-check">
                                        <input asp-for="EnableFrontSmd" class="form-check-input" type="checkbox" id="enable-front" />
                                        <label asp-for="EnableFrontSmd" class="form-check-label fw-semibold"></label>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6" id="back-enable-group">
                                    <div class="form-check">
                                        <input asp-for="EnableBackSmd" class="form-check-input" type="checkbox" id="enable-back" />
                                        <label asp-for="EnableBackSmd" class="form-check-label fw-semibold"></label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-text mb-0 mt-1" id="simple-front-hint">آهن ساده و استیل ساده SMD جلو ندارند.</div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12" id="actual-pvc-group">
                                <label asp-for="ActualPvcLengthInput" class="form-label"></label>
                                <input asp-for="ActualPvcLengthInput" class="form-control" type="number" step="any" min="0" />
                                <div class="form-text">برای دسته‌های غیر از آهن/استیل ساده.</div>
                            </div>
                            <div class="col-12 col-md-6" id="front-golden-group">
                                <label asp-for="FrontGoldenNumber" class="form-label"></label>
                                <input asp-for="FrontGoldenNumber" class="form-control" type="number" step="any" min="0" />
                            </div>
                            <div class="col-12 col-md-6" id="back-golden-group">
                                <label asp-for="BackGoldenNumber" class="form-label"></label>
                                <input asp-for="BackGoldenNumber" class="form-control" type="number" step="any" min="0" />
                            </div>
                            <div class="col-12 col-md-6" id="front-price-group">
                                <label asp-for="FrontUnitPrice" class="form-label"></label>
                                <input asp-for="FrontUnitPrice" class="form-control" type="number" step="any" min="0" />
                            </div>
                            <div class="col-12 col-md-6" id="back-price-group">
                                <label asp-for="BackUnitPrice" class="form-label"></label>
                                <input asp-for="BackUnitPrice" class="form-control" type="number" step="any" min="0" />
                            </div>
                        </div>

                        <div class="border rounded p-3 mb-3 d-none" id="letters-group">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="fw-semibold">حروف</div>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="add-letter">
                                    <i class="bi bi-plus"></i> حرف
                                </button>
                            </div>
                            <div class="form-text mb-2">فقط برای آهن ساده / استیل ساده — طول و مساحت هر حرف برای قطر قلم.</div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>نام</th>
                                            <th>طول</th>
                                            <th>مساحت</th>
                                            <th style="width:48px"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="letters-body">
                                        @for (var i = 0; i < Model.Letters.Count; i++)
                                        {
                                            <tr>
                                                <td>
                                                    <input name="Letters[@i].Label" value="@Model.Letters[i].Label" class="form-control form-control-sm" />
                                                </td>
                                                <td>
                                                    <input name="Letters[@i].Length" value="@Model.Letters[i].Length" class="form-control form-control-sm" type="number" step="any" min="0" />
                                                </td>
                                                <td>
                                                    <input name="Letters[@i].Area" value="@Model.Letters[i].Area" class="form-control form-control-sm" type="number" step="any" min="0" />
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="حذف">&times;</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="border rounded p-3 mb-3 d-none" id="pen-bands-group">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="fw-semibold">محدوده‌های ضریب قطر قلم</div>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="add-band">
                                    <i class="bi bi-plus"></i> محدوده
                                </button>
                            </div>
                            <div class="form-text mb-2">فقط برای آهن ساده / استیل ساده — بر اساس قطر قلم هر حرف.</div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>از قطر</th>
                                            <th>تا قطر</th>
                                            <th>ضریب</th>
                                            <th style="width:48px"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="bands-body">
                                        @for (var i = 0; i < Model.PenDiameterBands.Count; i++)
                                        {
                                            <tr>
                                                <td>
                                                    <input name="PenDiameterBands[@i].MinDiameter" value="@Model.PenDiameterBands[i].MinDiameter" class="form-control form-control-sm" type="number" step="any" min="0" />
                                                </td>
                                                <td>
                                                    <input name="PenDiameterBands[@i].MaxDiameter" value="@Model.PenDiameterBands[i].MaxDiameter" class="form-control form-control-sm" type="number" step="any" min="0" />
                                                </td>
                                                <td>
                                                    <input name="PenDiameterBands[@i].Coefficient" value="@Model.PenDiameterBands[i].Coefficient" class="form-control form-control-sm" type="number" step="any" min="0" />
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="حذف">&times;</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-play-fill me-1"></i>
                        محاسبه
                    </button>
                </div>
            </form>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white py-3">
                    <strong>قوانین ماژول</strong>
                </div>
                <div class="card-body small">
                    <ul class="mb-0 pe-3">
                        <li class="mb-2"><strong>برش:</strong> هزینه SMD ندارد</li>
                        <li class="mb-2"><strong>آهن/استیل ساده:</strong> فقط SMD پشت — از قطر قلم حروف</li>
                        <li class="mb-2"><strong>سایر:</strong> طول حقیقی PVC به‌صورت یک ورودی؛ SMD جلو/پشت با تیک</li>
                        <li class="mb-0"><strong>جمع:</strong> هزینه SMD جلو + هزینه SMD پشت</li>
                    </ul>
                </div>
            </div>

            @if (Model.HasResult)
            {
                @if (Model.IsSuccess)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <strong>خروجی شفاف</strong>
                            <span class="badge text-bg-success">موفق</span>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="text-muted small">دسته</div>
                                <div class="fw-semibold">@Model.CategoryDisplayName</div>
                            </div>
                            <div class="alert alert-light border small mb-3">
                                @Model.RuleDescription
                            </div>

                            @if (!Model.Applies)
                            {
                                <div class="p-3 rounded bg-primary-subtle">
                                    <div class="text-muted small">جمع هزینه SMD</div>
                                    <div class="fs-4 fw-bold">0</div>
                                </div>
                            }
                            else
                            {
                                <div class="small mb-3">
                                    طول حقیقی PVC:
                                    <strong>@Model.ActualPvcLength.ToString("#,0.####")</strong>
                                </div>

                                @if (Model.UsesPenDiameterMode && Model.LetterContributions.Count > 0)
                                {
                                    <div class="border rounded p-3 mb-3">
                                        <div class="fw-semibold mb-2">سهم حروف (قطر قلم)</div>
                                        @foreach (var item in Model.LetterContributions)
                                        {
                                            <div class="small border-bottom py-2">
                                                <div class="fw-semibold">@item.Label</div>
                                                <div class="text-muted">قطر قلم: @item.PenDiameterFormula</div>
                                                <div class="text-muted">محدوده [@item.MinDiameter.ToString("#,0.####") – @item.MaxDiameter.ToString("#,0.####")] ، ضریب @item.Coefficient.ToString("#,0.####")</div>
                                                <div class="font-monospace">@item.ContributionFormula</div>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (Model.IncludesFrontSmd && Model.FrontSmd is not null)
                                {
                                    <div class="border rounded p-3 mb-3">
                                        <div class="fw-semibold mb-1">@Model.FrontSmd.Name</div>
                                        <div class="small text-muted mb-1">@Model.FrontSmd.CountFormula</div>
                                        <div class="font-monospace mb-2">@Model.FrontSmd.CountFormulaWithValues</div>
                                        <div class="small text-muted mb-1">@Model.FrontSmd.CostFormula</div>
                                        <div class="font-monospace mb-2">@Model.FrontSmd.CostFormulaWithValues</div>
                                        <div>هزینه: <strong>@Model.FrontSmd.Cost.ToString("#,0.####")</strong></div>
                                    </div>
                                }

                                @if (Model.IncludesBackSmd && Model.BackSmd is not null)
                                {
                                    <div class="border rounded p-3 mb-3">
                                        <div class="fw-semibold mb-1">@Model.BackSmd.Name</div>
                                        <div class="small text-muted mb-1">@Model.BackSmd.CountFormula</div>
                                        <div class="font-monospace mb-2">@Model.BackSmd.CountFormulaWithValues</div>
                                        <div class="small text-muted mb-1">@Model.BackSmd.CostFormula</div>
                                        <div class="font-monospace mb-2">@Model.BackSmd.CostFormulaWithValues</div>
                                        <div>هزینه: <strong>@Model.BackSmd.Cost.ToString("#,0.####")</strong></div>
                                    </div>
                                }

                                <div class="p-3 rounded bg-primary-subtle">
                                    <div class="text-muted small">جمع هزینه SMD</div>
                                    <div class="fs-4 fw-bold">@Model.TotalSmdCost.ToString("#,0.####")</div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        @(Model.Message ?? "خطا در محاسبه")
                    </div>
                }
            }
            else
            {
                <div class="alert alert-secondary mb-0">
                    پس از وارد کردن مقادیر و زدن «محاسبه»، خروجی اینجا نمایش داده می‌شود.
                </div>
            }
        </div>
    </div>
</div>

<template id="letter-row-template">
    <tr>
        <td><input name="Letters[__i__].Label" class="form-control form-control-sm" value="حرف" /></td>
        <td><input name="Letters[__i__].Length" class="form-control form-control-sm" type="number" step="any" min="0" value="0" /></td>
        <td><input name="Letters[__i__].Area" class="form-control form-control-sm" type="number" step="any" min="0" value="0" /></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger remove-row" title="حذف">&times;</button></td>
    </tr>
</template>

<template id="band-row-template">
    <tr>
        <td><input name="PenDiameterBands[__i__].MinDiameter" class="form-control form-control-sm" type="number" step="any" min="0" value="0" /></td>
        <td><input name="PenDiameterBands[__i__].MaxDiameter" class="form-control form-control-sm" type="number" step="any" min="0" value="0" /></td>
        <td><input name="PenDiameterBands[__i__].Coefficient" class="form-control form-control-sm" type="number" step="any" min="0" value="1" /></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger remove-row" title="حذف">&times;</button></td>
    </tr>
</template>

<script>
(() => {
    const categorySelect = document.getElementById('category-select');
    const smdInputs = document.getElementById('smd-inputs');
    const cutHint = document.getElementById('cut-hint');
    const enableFront = document.getElementById('enable-front');
    const enableBack = document.getElementById('enable-back');
    const frontEnableGroup = document.getElementById('front-enable-group');
    const simpleFrontHint = document.getElementById('simple-front-hint');
    const actualPvcGroup = document.getElementById('actual-pvc-group');
    const lettersGroup = document.getElementById('letters-group');
    const frontGoldenGroup = document.getElementById('front-golden-group');
    const backGoldenGroup = document.getElementById('back-golden-group');
    const frontPriceGroup = document.getElementById('front-price-group');
    const backPriceGroup = document.getElementById('back-price-group');
    const penBandsGroup = document.getElementById('pen-bands-group');
    const lettersBody = document.getElementById('letters-body');
    const bandsBody = document.getElementById('bands-body');
    const letterTemplate = document.getElementById('letter-row-template').innerHTML;
    const bandTemplate = document.getElementById('band-row-template').innerHTML;

    function selectedOption() {
        return categorySelect.options[categorySelect.selectedIndex];
    }

    function reindex(tbody, prefix) {
        [...tbody.querySelectorAll('tr')].forEach((tr, i) => {
            tr.querySelectorAll('input').forEach(input => {
                const field = input.name.split('.').pop();
                input.name = `${prefix}[${i}].${field}`;
            });
        });
    }

    function syncUi() {
        const opt = selectedOption();
        const canSmd = opt?.dataset.canSmd === 'true';
        const canFront = opt?.dataset.canFront === 'true';
        const penMode = opt?.dataset.penMode === 'true';

        smdInputs.classList.toggle('d-none', !canSmd);
        cutHint.classList.toggle('d-none', canSmd);

        if (!canFront) {
            enableFront.checked = false;
            enableFront.disabled = true;
            frontEnableGroup.classList.add('d-none');
            simpleFrontHint.classList.toggle('d-none', !penMode);
        } else {
            enableFront.disabled = false;
            frontEnableGroup.classList.remove('d-none');
            simpleFrontHint.classList.add('d-none');
        }

        if (penMode) {
            enableBack.checked = true;
            enableBack.disabled = true;
        } else {
            enableBack.disabled = false;
        }

        const frontOn = canFront && enableFront.checked;
        const backOn = enableBack.checked;

        actualPvcGroup.classList.toggle('d-none', penMode);
        lettersGroup.classList.toggle('d-none', !penMode);
        frontGoldenGroup.classList.toggle('d-none', !frontOn);
        frontPriceGroup.classList.toggle('d-none', !frontOn);
        backGoldenGroup.classList.toggle('d-none', !backOn);
        backPriceGroup.classList.toggle('d-none', !backOn);
        penBandsGroup.classList.toggle('d-none', !(penMode && backOn));
    }

    document.getElementById('add-letter').addEventListener('click', () => {
        const i = lettersBody.querySelectorAll('tr').length;
        lettersBody.insertAdjacentHTML('beforeend', letterTemplate.replaceAll('__i__', i).replace('value="حرف"', `value="حرف ${i + 1}"`));
        reindex(lettersBody, 'Letters');
    });

    document.getElementById('add-band').addEventListener('click', () => {
        const i = bandsBody.querySelectorAll('tr').length;
        bandsBody.insertAdjacentHTML('beforeend', bandTemplate.replaceAll('__i__', i));
        reindex(bandsBody, 'PenDiameterBands');
    });

    document.addEventListener('click', (e) => {
        const btn = e.target.closest('.remove-row');
        if (!btn) return;
        const tr = btn.closest('tr');
        const tbody = tr.parentElement;
        if (tbody.querySelectorAll('tr').length <= 1) return;
        tr.remove();
        reindex(tbody, tbody.id === 'letters-body' ? 'Letters' : 'PenDiameterBands');
    });

    categorySelect.addEventListener('change', syncUi);
    enableFront.addEventListener('change', syncUi);
    enableBack.addEventListener('change', syncUi);
    document.getElementById('smd-cost-form').addEventListener('submit', () => {
        enableFront.disabled = false;
        enableBack.disabled = false;
    });
    syncUi();
})();
</script>
