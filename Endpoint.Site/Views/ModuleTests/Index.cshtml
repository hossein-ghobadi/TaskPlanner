@{
    ViewData["Title"] = "تست ماژول‌های محاسبه";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0" style="max-width: 860px;">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-calculator me-2"></i>
            تست ماژول‌های محاسبه
        </h2>
        <p class="text-muted mb-0">
            محیط آزمایشی برای ماژول‌های سرویس محاسبه. هر ماژول ورودی می‌گیرد و خروجی شفاف برمی‌گرداند.
        </p>
    </div>

    <div class="list-group shadow-sm">
        <a href="/ModuleTests/MaterialCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۱ — هزینه متریال</div>
                <div class="small text-muted mt-1">
                    محاسبه هزینه لایه اول/دوم بر اساس دسته محاسباتی، مساحت مصرفی، پرتی و فی.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/EdgeCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۲ — هزینه لبه</div>
                <div class="small text-muted mt-1">
                    متریال لبه، پانچ لبه و دستمزد لبه بر اساس طول حقیقی و طول نسبی PVC.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/SmdCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۳ — هزینه SMD</div>
                <div class="small text-muted mt-1">
                    SMD جلو و پشت بر اساس دسته، عدد طلایی، فی و حروف.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/MetalsCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۴ — هزینه فلزات</div>
                <div class="small text-muted mt-1">
                    پایه، دوغی، فلز پلاست، مونتاژ و دولبه رینگ برای دسته‌های فلزی.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/PvcCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۵ — هزینه PVC</div>
                <div class="small text-muted mt-1">
                    هزینه PVC و PVC بک‌لایت بر اساس مساحت مصرفی و فی PVC.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/GlueCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۶ — هزینه چسب</div>
                <div class="small text-muted mt-1">
                    چسب برش از مساحت لایه‌ها؛ سایر دسته‌ها از طول حقیقی PVC.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/CrystalCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۷ — هزینه کریستال</div>
                <div class="small text-muted mt-1">
                    مساحت حقیقی PVC × فی کریستال (به‌جز برش و آهن/استیل ساده).
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/PaintCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۸ — هزینه رنگ</div>
                <div class="small text-muted mt-1">
                    برش و دسته‌های آهن: (مساحت لایه + طول حقیقی × سایز لبه) × فی رنگ.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/WoodCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۹ — هزینه چوب</div>
                <div class="small text-muted mt-1">
                    فقط وکیوم با رینگ: (مساحت مصرفی چوب + پرت چوب) × فی چوب.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/VacuumWageCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۱۰ — دستمزد وکیوم</div>
                <div class="small text-muted mt-1">
                    فقط وکیوم با رینگ: سایز لبه × فی وکیوم.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/CutSpecificCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۱۱ — اختصاصی برش</div>
                <div class="small text-muted mt-1">
                    فقط برش: طول حقیقی PVC × فی برش × ضریب چندلایه بودن.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
    </div>
</div>
