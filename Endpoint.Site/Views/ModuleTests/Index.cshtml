@{
    ViewData["Title"] = "تست ماژول‌های محاسبه";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0" style="max-width: 860px;">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-calculator me-2"></i>
            تست ماژول‌های محاسبه
        </h2>
        <p class="text-muted mb-0">
            محیط آزمایشی برای ماژول‌های سرویس محاسبه. هر ماژول ورودی می‌گیرد و خروجی شفاف برمی‌گرداند.
        </p>
    </div>

    <div class="list-group shadow-sm">
        <a href="/ModuleTests/MaterialCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۱ — هزینه متریال</div>
                <div class="small text-muted mt-1">
                    محاسبه هزینه لایه اول/دوم بر اساس دسته محاسباتی، مساحت مصرفی، پرتی و فی.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
        <a href="/ModuleTests/EdgeCost" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <div class="fw-semibold">ماژول ۲ — هزینه لبه</div>
                <div class="small text-muted mt-1">
                    متریال لبه، پانچ لبه و دستمزد لبه بر اساس طول حقیقی و طول نسبی PVC.
                </div>
            </div>
            <i class="bi bi-chevron-left"></i>
        </a>
    </div>
</div>
