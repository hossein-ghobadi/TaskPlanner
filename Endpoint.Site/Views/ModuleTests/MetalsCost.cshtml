@model Endpoint.Site.Models.MetalsCostTestVm
@using TaskPlanner.Domain.Entities.Calculation
@{
    ViewData["Title"] = "تست ماژول هزینه فلزات";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0" style="max-width: 1100px;">
    <div class="mb-4">
        <div class="mb-2">
            <a href="/ModuleTests/Index" class="text-decoration-none small">
                <i class="bi bi-arrow-right me-1"></i>
                بازگشت به لیست ماژول‌ها
            </a>
        </div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-gear-wide-connected me-2"></i>
            تست ماژول هزینه فلزات
        </h2>
        <p class="text-muted mb-0">
            هزینه پایه، دوغی، فلز پلاست، مونتاژ و در صورت رینگی بودن دولبه رینگ را محاسبه کنید.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <form method="post" asp-action="MetalsCost" id="metals-cost-form" class="card border-0 shadow-sm">
                @Html.AntiForgeryToken()
                <div class="card-header bg-white py-3">
                    <strong>ورودی‌ها</strong>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" class="form-select" id="category-select">
                            @foreach (var category in Model.MetalsCategories)
                            {
                                <option value="@((int)category)"
                                        data-double-edge="@(category.CanHaveDoubleEdgeRingCost() ? "true" : "false")">
                                    @category.GetDisplayName()
                                </option>
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="ActualPvcLength" class="form-label"></label>
                            <input asp-for="ActualPvcLength" class="form-control" type="number" step="any" min="0" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="BaseUnitPrice" class="form-label"></label>
                            <input asp-for="BaseUnitPrice" class="form-control" type="number" step="any" min="0" />
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <div class="fw-semibold mb-2">دوغی</div>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label asp-for="DoughyConsumedArea" class="form-label"></label>
                                <input asp-for="DoughyConsumedArea" class="form-control" type="number" step="any" min="0" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="DoughyUnitPrice" class="form-label"></label>
                                <input asp-for="DoughyUnitPrice" class="form-control" type="number" step="any" min="0" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="DoughyLaborUnitPrice" class="form-label"></label>
                                <input asp-for="DoughyLaborUnitPrice" class="form-control" type="number" step="any" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <div class="fw-semibold mb-2">فلز پلاست و مونتاژ</div>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label asp-for="EdgeSize" class="form-label"></label>
                                <input asp-for="EdgeSize" class="form-control" type="number" step="any" min="0" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="PlasticEdgeUnitPrice" class="form-label"></label>
                                <input asp-for="PlasticEdgeUnitPrice" class="form-control" type="number" step="any" min="0" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="AssemblyUnitPrice" class="form-label"></label>
                                <input asp-for="AssemblyUnitPrice" class="form-control" type="number" step="any" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-3 d-none" id="double-edge-group">
                        <div class="fw-semibold mb-2">دولبه رینگ</div>
                        <div class="form-text mb-2">فقط برای دسته‌های رینگی و وکیوم با رینگ.</div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="RingEdgeUnitPrice" class="form-label"></label>
                                <input asp-for="RingEdgeUnitPrice" class="form-control" type="number" step="any" min="0" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="DoubleEdgeRingLaborUnitPrice" class="form-label"></label>
                                <input asp-for="DoubleEdgeRingLaborUnitPrice" class="form-control" type="number" step="any" min="0" />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-play-fill me-1"></i>
                        محاسبه
                    </button>
                </div>
            </form>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white py-3">
                    <strong>قوانین ماژول</strong>
                </div>
                <div class="card-body small">
                    <ul class="mb-0 pe-3">
                        <li class="mb-2"><strong>دسته‌های مجاز:</strong> آهن/استیل ساده، آهن/استیل رینگی، وکیوم با رینگ آهن/استیل</li>
                        <li class="mb-2"><strong>پایه:</strong> طول حقیقی PVC × فی پایه</li>
                        <li class="mb-2"><strong>دوغی:</strong> (مساحت دوغی × فی دوغی) + (طول حقیقی × دستمزد دوغی)</li>
                        <li class="mb-2"><strong>فلز پلاست:</strong> طول حقیقی × سایز لبه × فی لبه پلاستیک</li>
                        <li class="mb-2"><strong>مونتاژ:</strong> طول حقیقی × فی مونتاژ</li>
                        <li class="mb-0"><strong>دولبه رینگ:</strong> فقط رینگی‌ها — طول حقیقی × (فی لبه + فی دستمزد دو لبه رینگ)</li>
                    </ul>
                </div>
            </div>

            @if (Model.HasResult)
            {
                @if (Model.IsSuccess)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <strong>خروجی شفاف</strong>
                            <span class="badge text-bg-success">موفق</span>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="text-muted small">دسته</div>
                                <div class="fw-semibold">@Model.CategoryDisplayName</div>
                            </div>
                            <div class="alert alert-light border small mb-3">
                                @Model.RuleDescription
                            </div>

                            @if (!Model.Applies)
                            {
                                <div class="p-3 rounded bg-primary-subtle">
                                    <div class="text-muted small">جمع هزینه فلزات</div>
                                    <div class="fs-4 fw-bold">0</div>
                                </div>
                            }
                            else
                            {
                                <div class="small mb-3">
                                    طول حقیقی PVC:
                                    <strong>@Model.ActualPvcLengthResult.ToString("#,0.####")</strong>
                                </div>

                                @foreach (var item in new[] { Model.BaseCost, Model.DoughyCost, Model.MetalPlasticCost, Model.AssemblyLaborCost, Model.DoubleEdgeRingCost })
                                {
                                    if (item is null) { continue; }
                                    <div class="border rounded p-3 mb-3">
                                        <div class="fw-semibold mb-1">@item.Name</div>
                                        <div class="small text-muted mb-1">@item.Formula</div>
                                        <div class="font-monospace mb-2">@item.FormulaWithValues</div>
                                        <div>مبلغ: <strong>@item.Amount.ToString("#,0.####")</strong></div>
                                    </div>
                                }

                                <div class="p-3 rounded bg-primary-subtle">
                                    <div class="text-muted small">جمع هزینه فلزات</div>
                                    <div class="fs-4 fw-bold">@Model.TotalMetalsCost.ToString("#,0.####")</div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        @(Model.Message ?? "خطا در محاسبه")
                    </div>
                }
            }
            else
            {
                <div class="alert alert-secondary mb-0">
                    پس از وارد کردن مقادیر و زدن «محاسبه»، خروجی اینجا نمایش داده می‌شود.
                </div>
            }
        </div>
    </div>
</div>

<script>
(() => {
    const categorySelect = document.getElementById('category-select');
    const doubleEdgeGroup = document.getElementById('double-edge-group');

    function syncUi() {
        const opt = categorySelect.options[categorySelect.selectedIndex];
        const hasDoubleEdge = opt?.dataset.doubleEdge === 'true';
        doubleEdgeGroup.classList.toggle('d-none', !hasDoubleEdge);
    }

    categorySelect.addEventListener('change', syncUi);
    syncUi();
})();
</script>
