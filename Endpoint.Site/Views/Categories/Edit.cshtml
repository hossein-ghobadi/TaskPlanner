@model CategoryEditVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">
                <i class="bi bi-pencil-square"></i> ویرایش دسته‌بندی
            </h4>
            <small>پروژه: @ViewBag.ProjectName</small>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.HiddenFor(m => m.Id)
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        <strong>نام دسته‌بندی</strong>
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-circle"></i> ذخیره تغییرات
                    </button>
                    <a asp-action="Index" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> انصراف
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
