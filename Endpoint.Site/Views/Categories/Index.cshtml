@model Endpoint.Site.Models.CategoryIndexVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "دسته‌بندی‌های پروژه";
}

<div class="w-100">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-folder2 text-primary me-2"></i>
                دسته‌بندی‌ها
            </h4>
            <small class="text-muted">پروژه: <strong>@Model.ProjectName</strong></small>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-success" asp-action="Create" asp-route-projectId="@Model.ProjectId">
                <i class="bi bi-folder-plus me-1"></i>
                افزودن دسته
            </a>
            <a class="btn btn-outline-secondary" asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">
                <i class="bi bi-arrow-right me-1"></i>
                بازگشت به پروژه
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 w-100">
        <div class="card-body p-0">
            @if (Model.Categories.Count == 0)
            {
                <div class="text-center text-muted py-5 px-3">
                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                    <p class="mb-3">هنوز دسته‌بندی‌ای ثبت نشده است.</p>
                    <a class="btn btn-primary" asp-action="Create" asp-route-projectId="@Model.ProjectId">
                        <i class="bi bi-plus-lg me-1"></i>
                        اولین دسته را بسازید
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">نام دسته‌بندی</th>
                                <th scope="col" class="text-center" style="width: 8rem;">کارها</th>
                                <th scope="col" class="text-end" style="width: 11rem;">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Categories)
                            {
                                var taskCount = c.Tasks?.Count ?? 0;
                                <tr>
                                    <td class="fw-medium">@c.Name</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@taskCount</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@c.Id" title="ویرایش">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
