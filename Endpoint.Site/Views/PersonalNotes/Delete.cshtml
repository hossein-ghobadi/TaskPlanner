@model PersonalNote
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h2>حذف یادداشت شخصی</h2>

<div class="alert alert-warning">
    <h4>آیا مطمئن هستید که می‌خواهید این یادداشت را حذف کنید؟</h4>
</div>

<div class="card" style="border-left: 4px solid @(Model.Color ?? "#ffffff");">
    <div class="card-body">
        @if (Model.IsPinned)
        {
            <span class="badge bg-warning text-dark float-end">📌 پین شده</span>
        }
        <h5 class="card-title">@Model.Title</h5>
        <p><strong>تاریخ ایجاد:</strong> @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</p>
        <hr />
        <div style="white-space: pre-wrap;">@Model.Content</div>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">تایید حذف</button>
    <a class="btn btn-secondary" asp-action="Index">انصراف</a>
</form>


