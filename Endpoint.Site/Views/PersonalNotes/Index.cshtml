@model IEnumerable<PersonalNote>
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>📝 یادداشت‌های شخصی من</h2>
    </div>
    <div class="d-flex gap-2">
        <!-- دکمه تغییر نمایش -->
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-outline-secondary" id="viewCardBtn" onclick="toggleView('card')">
                <i class="bi bi-grid-3x3-gap"></i> کارت
            </button>
            <button type="button" class="btn btn-outline-secondary" id="viewListBtn" onclick="toggleView('list')">
                <i class="bi bi-list-ul"></i> لیست
            </button>
        </div>
        
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i> افزودن یادداشت جدید
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Any())
{
    <!-- نمایش کارتی -->
    <div class="row" id="cardView">
        @foreach (var note in Model)
        {
            var cardColor = !string.IsNullOrEmpty(note.Color) ? note.Color : "#ffffff";
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm hover-shadow clickable-card" 
                     style="border-left: 4px solid @cardColor; cursor: pointer;"
                     onclick="window.location.href='/PersonalNotes/Details?id=@note.Id'">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title">
                                <i class="bi bi-journal-bookmark text-primary"></i>
                                @note.Title
                            </h5>
                            @if (note.IsPinned)
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-pin-angle-fill"></i> پین
                                </span>
                            }
                        </div>
                        
                        <div class="flex-grow-1">
                            @if (!string.IsNullOrEmpty(note.Content))
                            {
                                <p class="card-text text-muted" style="white-space: pre-wrap; max-height: 150px; overflow: hidden;">
                                    @(note.Content.Length > 200 ? note.Content.Substring(0, 200) + "..." : note.Content)
                                </p>
                            }
                            else
                            {
                                <p class="card-text text-muted fst-italic">بدون محتوا</p>
                            }

                            @* نمایش فایل‌های پیوست *@
                            @if (note.Attachments != null && note.Attachments.Any())
                            {
                                <div class="mt-3">
                                    <small class="text-muted">
                                        <i class="bi bi-paperclip"></i>
                                        @note.Attachments.Count فایل پیوست
                                    </small>
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        @foreach (var att in note.Attachments.Take(3))
                                        {
                                            @if (att.FileType == "Image")
                                            {
                                                <img src="@att.FilePath" alt="@att.FileName" 
                                                     class="img-thumbnail" 
                                                     style="width: 60px; height: 60px; object-fit: cover; cursor: pointer;"
                                                     title="@att.FileName"
                                                     onclick="event.stopPropagation(); window.location.href='/PersonalNotes/Details?id=@note.Id'" />
                                            }
                                            else if (att.FileType == "Audio")
                                            {
                                                <div onclick="event.stopPropagation();" style="width: 100%;">
                                                    <audio controls class="w-100" style="max-height: 30px; height: 30px;">
                                                        <source src="@att.FilePath" type="@att.MimeType">
                                                    </audio>
                                                    <small class="text-muted d-block" style="font-size: 0.7em;">@att.FileName</small>
                                                </div>
                                            }
                                            else if (att.FileType == "Document")
                                            {
                                                <a href="@att.FilePath" target="_blank" onclick="event.stopPropagation();" 
                                                   class="text-decoration-none" title="@att.FileName">
                                                    <div class="border rounded p-2 text-center" style="width: 60px;">
                                                        <i class="bi bi-file-earmark-text text-success" style="font-size: 1.5rem;"></i>
                                                        <small class="d-block text-muted" style="font-size: 0.65em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                            @(att.FileName.Length > 8 ? att.FileName.Substring(0, 8) + "..." : att.FileName)
                                                        </small>
                                                    </div>
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@att.FilePath" target="_blank" onclick="event.stopPropagation();" 
                                                   class="text-decoration-none" title="@att.FileName">
                                                    <div class="border rounded p-2 text-center" style="width: 60px;">
                                                        <i class="bi bi-file-earmark text-secondary" style="font-size: 1.5rem;"></i>
                                                        <small class="d-block text-muted" style="font-size: 0.65em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                            @(att.FileName.Length > 8 ? att.FileName.Substring(0, 8) + "..." : att.FileName)
                                                        </small>
                                                    </div>
                                                </a>
                                            }
                                        }
                                        @if (note.Attachments.Count > 3)
                                        {
                                            <span class="badge bg-light text-dark">+@(note.Attachments.Count - 3)</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="bi bi-clock"></i>
                                @note.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                            </small>
                        </div>

                        <div class="btn-group mt-3" role="group" onclick="event.stopPropagation();">
                            <a href="/PersonalNotes/Edit?id=@note.Id" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> ویرایش
                            </a>
                            <a href="/PersonalNotes/Delete?id=@note.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> حذف
                            </a>
                        </div>
                        
                        <form asp-action="TogglePin" asp-route-id="@note.Id" method="post" class="mt-2" onclick="event.stopPropagation();">
                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                                <i class="bi bi-pin-angle"></i> @(note.IsPinned ? "حذف پین" : "پین کردن")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- نمایش لیستی -->
    <div class="table-responsive" id="listView" style="display: none;">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 5%;">وضعیت</th>
                    <th style="width: 20%;">عنوان</th>
                    <th style="width: 30%;">محتوا</th>
                    <th style="width: 15%;">فایل‌های پیوست</th>
                    <th style="width: 15%;">تاریخ ایجاد</th>
                    <th style="width: 15%;">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var note in Model)
                {
                    var cardColor = !string.IsNullOrEmpty(note.Color) ? note.Color : "#ffffff";
                    <tr style="border-left: 4px solid @cardColor; cursor: pointer;" 
                        onclick="window.location.href='/PersonalNotes/Details?id=@note.Id'">
                        <td class="text-center" onclick="event.stopPropagation();">
                            @if (note.IsPinned)
                            {
                                <span class="badge bg-warning text-dark" title="پین شده">
                                    <i class="bi bi-pin-angle-fill"></i>
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <i class="bi bi-journal-bookmark text-primary"></i>
                            <strong>@note.Title</strong>
                        </td>
                        <td>
                            <small class="text-muted" style="display: block; max-height: 60px; overflow: hidden;">
                                @if (!string.IsNullOrEmpty(note.Content))
                                {
                                    @(note.Content.Length > 100 ? note.Content.Substring(0, 100) + "..." : note.Content)
                                }
                                else
                                {
                                    <em class="text-muted">بدون محتوا</em>
                                }
                            </small>
                        </td>
                        <td onclick="event.stopPropagation();">
                            @if (note.Attachments != null && note.Attachments.Any())
                            {
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var att in note.Attachments.Take(2))
                                    {
                                        @if (att.FileType == "Image")
                                        {
                                            <img src="@att.FilePath" alt="@att.FileName" 
                                                 class="img-thumbnail" 
                                                 style="width: 50px; height: 50px; object-fit: cover; cursor: pointer;"
                                                 title="@att.FileName"
                                                 onclick="window.location.href='/PersonalNotes/Details?id=@note.Id'" />
                                        }
                                        else if (att.FileType == "Audio")
                                        {
                                            <div style="min-width: 150px;">
                                                <audio controls style="width: 150px; height: 25px;">
                                                    <source src="@att.FilePath" type="@att.MimeType">
                                                </audio>
                                            </div>
                                        }
                                        else if (att.FileType == "Document")
                                        {
                                            <a href="@att.FilePath" target="_blank" class="text-decoration-none" title="@att.FileName">
                                                <span class="badge bg-success">
                                                    <i class="bi bi-file-earmark-text"></i> 
                                                    @(att.FileName.Length > 15 ? att.FileName.Substring(0, 15) + "..." : att.FileName)
                                                </span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@att.FilePath" target="_blank" class="text-decoration-none" title="@att.FileName">
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-file-earmark"></i> 
                                                    @(att.FileName.Length > 15 ? att.FileName.Substring(0, 15) + "..." : att.FileName)
                                                </span>
                                            </a>
                                        }
                                    }
                                    @if (note.Attachments.Count > 2)
                                    {
                                        <span class="badge bg-light text-dark" title="@note.Attachments.Count فایل">
                                            <i class="bi bi-three-dots"></i> +@(note.Attachments.Count - 2) فایل دیگر
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <small class="text-muted">-</small>
                            }
                        </td>
                        <td>
                            <small class="text-muted">
                                <i class="bi bi-clock"></i>
                                @note.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                                <br />
                                <span class="text-muted">@note.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                            </small>
                        </td>
                        <td onclick="event.stopPropagation();">
                            <div class="btn-group" role="group">
                                <a href="/PersonalNotes/Edit?id=@note.Id" class="btn btn-sm btn-outline-warning" title="ویرایش">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="/PersonalNotes/Delete?id=@note.Id" class="btn btn-sm btn-outline-danger" title="حذف">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                            <form asp-action="TogglePin" asp-route-id="@note.Id" method="post" class="d-inline ms-1">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(note.IsPinned ? "حذف پین" : "پین کردن")">
                                    <i class="bi bi-pin-angle"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i>
        هیچ یادداشت شخصی وجود ندارد.
        <br>
        <a asp-action="Create" class="btn btn-primary mt-2">
            <i class="bi bi-plus-circle"></i> ایجاد اولین یادداشت
        </a>
    </div>
}

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease, transform 0.2s ease;
    }
    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        transform: translateY(-2px);
    }
    .clickable-card {
        cursor: pointer;
    }
    .table-hover tbody tr {
        transition: background-color 0.2s ease;
    }
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }
</style>

<script>
    // ذخیره و بارگذاری حالت نمایش از localStorage
    function toggleView(viewType) {
        const cardView = document.getElementById('cardView');
        const listView = document.getElementById('listView');
        const cardBtn = document.getElementById('viewCardBtn');
        const listBtn = document.getElementById('viewListBtn');
        
        if (viewType === 'card') {
            cardView.style.display = 'flex';
            listView.style.display = 'none';
            cardBtn.classList.add('active');
            listBtn.classList.remove('active');
            localStorage.setItem('personalNotesViewType', 'card');
        } else {
            cardView.style.display = 'none';
            listView.style.display = 'block';
            cardBtn.classList.remove('active');
            listBtn.classList.add('active');
            localStorage.setItem('personalNotesViewType', 'list');
        }
    }
    
    // بارگذاری حالت ذخیره شده هنگام لود صفحه
    document.addEventListener('DOMContentLoaded', function() {
        const savedView = localStorage.getItem('personalNotesViewType') || 'card';
        toggleView(savedView);
    });
</script>
