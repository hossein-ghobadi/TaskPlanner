<script src="~/lib/marked/marked.min.js"></script>
<script src="~/lib/dompurify/dist/purify.min.js"></script>
<script>
    const requestVerificationToken = '@requestToken';

    function normalizeTaskListMarkdown(markdownText) {
        return (markdownText || '')
            .split('\n')
            .map(function (line) {
                if (/^\s*-\[( |x|X)\]\s*/.test(line)) {
                    return line.replace(/^(\s*)-\[( |x|X)\]\s*/, '$1- [$2] ');
                }

                if (/^\s*-\s*\[( |x|X)\]\s*/.test(line)) {
                    return line.replace(/^(\s*)-\s*\[( |x|X)\]\s*/, '$1- [$2] ');
                }

                if (/^\s*\[( |x|X)\]\s+/.test(line)) {
                    return line.replace(/^(\s*)\[( |x|X)\]\s+/, '$1- [$2] ');
                }
                return line;
            })
            .join('\n');
    }

    function updateChecklistMarker(markdownText, checkboxIndex, isChecked) {
        let currentIndex = 0;
        return (markdownText || '').replace(/^(\s*-\s*)\[( |x|X)\]/gm, function (_, prefix, marker) {
            const updated = currentIndex === checkboxIndex
                ? `${prefix}[${isChecked ? 'x' : ' '}]`
                : `${prefix}[${marker}]`;
            currentIndex += 1;
            return updated;
        });
    }

    async function persistChecklistState(noteId, content) {
        const response = await fetch('/PersonalNotes/UpdateContent', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': requestVerificationToken
            },
            body: JSON.stringify({
                noteId: noteId,
                content: content
            })
        });

        if (!response.ok) {
            throw new Error('Save failed');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const previewModal = document.getElementById('attachmentPreviewModal');
        const previewImage = document.getElementById('attachmentPreviewImage');
        const previewCloseBtn = document.getElementById('attachmentPreviewCloseBtn');
        const previewTriggers = document.querySelectorAll('.attachment-preview-trigger');
        let previousBodyOverflow = '';

        const closePreviewModal = function () {
            if (!previewModal || !previewImage) return;
            previewModal.classList.remove('is-open');
            previewModal.setAttribute('aria-hidden', 'true');
            previewImage.src = '';
            previewImage.alt = '';
            document.body.style.overflow = previousBodyOverflow;
        };

        if (previewModal && previewImage && previewTriggers.length > 0) {
            previewTriggers.forEach(function (trigger) {
                trigger.addEventListener('click', function () {
                    const src = trigger.dataset.previewSrc;
                    if (!src) return;

                    previewImage.src = src;
                    previewImage.alt = trigger.dataset.previewAlt || '';
                    previewModal.classList.add('is-open');
                    previewModal.setAttribute('aria-hidden', 'false');
                    previousBodyOverflow = document.body.style.overflow;
                    document.body.style.overflow = 'hidden';
                });
            });

            previewModal.addEventListener('click', function (event) {
                if (event.target instanceof HTMLElement && event.target.dataset.previewClose === 'true') {
                    closePreviewModal();
                }
            });

            if (previewCloseBtn) {
                previewCloseBtn.addEventListener('click', closePreviewModal);
            }

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && previewModal.classList.contains('is-open')) {
                    closePreviewModal();
                }
            });
        }

        if (!window.marked || !window.DOMPurify) {
            document.querySelectorAll('.markdown-render[data-markdown-id]').forEach(function (target) {
                const sourceId = target.dataset.markdownId;
                const source = document.getElementById(sourceId);
                if (!source) return;
                target.textContent = source.value || '';
                target.style.whiteSpace = 'pre-wrap';
            });
            return;
        }

        const targets = document.querySelectorAll('.markdown-render[data-markdown-id]');
        targets.forEach(function (target) {
            const sourceId = target.dataset.markdownId;
            const source = document.getElementById(sourceId);
            if (!source) return;
            const noteId = Number(target.dataset.noteId);

            const markdownText = normalizeTaskListMarkdown(source.value || '');
            const renderedHtml = marked.parse(markdownText, { breaks: true, gfm: true });
            target.innerHTML = DOMPurify.sanitize(renderedHtml);
            source.value = markdownText;

            target.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) {
                checkbox.removeAttribute('disabled');
                const listItem = checkbox.closest('li.task-list-item');
                const toggleCheckedState = function () {
                    if (!listItem) return;
                    listItem.classList.toggle('is-checked', checkbox.checked);
                };
                toggleCheckedState();
                checkbox.addEventListener('change', async function () {
                    toggleCheckedState();

                    const checkboxes = Array.from(target.querySelectorAll('input[type="checkbox"]'));
                    const checkboxIndex = checkboxes.indexOf(checkbox);
                    if (checkboxIndex < 0 || !noteId) return;

                    const updatedMarkdown = updateChecklistMarker(source.value || '', checkboxIndex, checkbox.checked);
                    source.value = updatedMarkdown;

                    try {
                        await persistChecklistState(noteId, updatedMarkdown);
                    } catch {
                        checkbox.checked = !checkbox.checked;
                        toggleCheckedState();
                    }
                });
            });
        });
    });
</script>
