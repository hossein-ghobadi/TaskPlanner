@model PersonalNote
@using DNTPersianUtils.Core
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["UseFluidLayout"] = true;
    var noteColor = !string.IsNullOrEmpty(Model.Color) ? Model.Color : "#3b82f6";
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var createdAtPersian = Model.CreatedAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers();
    var updatedAtPersian = Model.UpdatedAt?.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers();
    var deleteExcerpt = string.IsNullOrWhiteSpace(Model.Content)
        ? ""
        : System.Text.RegularExpressions.Regex.Replace(Model.Content, @"\s+", " ").Trim();
    if (deleteExcerpt.Length > 120)
    {
        deleteExcerpt = deleteExcerpt.Substring(0, 120) + "…";
    }
}

<div class="note-detail-container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-social" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-social" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]
        </div>
    }

    <!-- Back Button -->
    <div class="back-header">
        <a asp-controller="PersonalNotes"
           asp-action="Index"
           asp-route-folderId="@Model.FolderId"
           class="back-btn">
            <i class="bi bi-arrow-right"></i>
            <span>بازگشت به لیست</span>
        </a>
    </div>

    <!-- Main Post Card -->
    <article class="note-detail-post" style="border-top: 4px solid @noteColor;">
        <!-- Post Header -->
        <div class="post-header">
            <div class="post-avatar">
                <div class="avatar-circle" style="background: linear-gradient(135deg, @noteColor 0%, @(noteColor)dd 100%);">
                    <i class="bi bi-journal-text"></i>
                </div>
            </div>
            <div class="post-author">
                <div class="author-name">یادداشت شخصی</div>
                <div class="post-time">
                    <i class="bi bi-clock"></i>
                    <span>@createdAtPersian</span>
                </div>
                @if (!string.IsNullOrEmpty(updatedAtPersian))
                {
                    <div class="post-updated">
                        <i class="bi bi-pencil-square"></i>
                        <span>ویرایش شده در: @updatedAtPersian</span>
                    </div>
                }
            </div>
            <div class="post-actions-header">
                @if (Model.IsPinned)
                {
                    <span class="pin-badge" title="پین شده">
                        <i class="bi bi-pin-angle-fill"></i>
                    </span>
                }
                <div class="dropdown">
                    <button class="btn-options" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="/PersonalNotes/Edit?id=@Model.Id">
                                <i class="bi bi-pencil"></i> ویرایش
                            </a>
                        </li>
                        <li>
                            <form asp-action="TogglePin" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (Model.FolderId.HasValue)
                                {
                                    <input type="hidden" name="folderId" value="@Model.FolderId.Value" />
                                }
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-pin-angle"></i>
                                    @(Model.IsPinned ? "حذف پین" : "پین کردن")
                                </button>
                            </form>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button type="button"
                                    class="dropdown-item text-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteNoteModal"
                                    data-note-id="@Model.Id"
                                    data-note-title="@Model.Title"
                                    data-note-excerpt="@deleteExcerpt">
                                <i class="bi bi-trash"></i> حذف
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Post Content -->
        <div class="post-content">
            <h1 class="post-title">@Model.Title</h1>
            @if (!string.IsNullOrEmpty(Model.Content))
            {
                <textarea id="note-content-@Model.Id" class="markdown-source d-none">@Model.Content</textarea>
                <div class="post-text markdown-render" data-note-id="@Model.Id" data-markdown-id="note-content-@Model.Id"></div>
            }
        </div>

        <!-- Post Attachments -->
        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            <div class="post-attachments">
                @foreach (var att in Model.Attachments)
                {
                    @if (att.FileType == "Image")
                    {
                        <div class="attachment-item attachment-image-full">
                            <img src="@FileUrls.ToPublicUrl(att.FilePath)"
                                 alt="@att.FileName"
                                 class="attachment-img-full attachment-preview-trigger"
                                 data-preview-src="@FileUrls.ToPublicUrl(att.FilePath)"
                                 data-preview-alt="@att.FileName" />
                            <div class="attachment-info-overlay">
                                <span class="attachment-name-full">@att.FileName</span>
                                <a href="@FileUrls.ToPublicUrl(att.FilePath)" download="@att.FileName" class="attachment-download-btn">
                                    <i class="bi bi-download"></i>
                                </a>
                            </div>
                        </div>
                    }
                    else if (att.FileType == "Audio")
                    {
                        <div class="attachment-item attachment-audio-full">
                            <div class="audio-wrapper">
                                <audio controls class="attachment-audio-player-full">
                                    <source src="@FileUrls.ToPublicUrl(att.FilePath)" type="@att.MimeType">
                                </audio>
                                <div class="audio-info">
                                    <span class="audio-name">@att.FileName</span>
                                    <span class="audio-size">@(Math.Round(att.FileSize / 1024.0, 1)) KB</span>
                                </div>
                                <a href="@FileUrls.ToPublicUrl(att.FilePath)" download="@att.FileName" class="audio-download">
                                    <i class="bi bi-download"></i>
                                </a>
                            </div>
                        </div>
                    }
                    else if (att.FileType == "Document")
                    {
                        <a href="@FileUrls.ToPublicUrl(att.FilePath)" target="_blank" class="attachment-item attachment-document-full">
                            <div class="attachment-icon-large">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>
                            <div class="attachment-details-full">
                                <span class="attachment-name-full">@att.FileName</span>
                                <span class="attachment-size-full">@(Math.Round(att.FileSize / 1024.0, 1)) KB</span>
                            </div>
                            <div class="attachment-download-large">
                                <i class="bi bi-download"></i>
                            </div>
                        </a>
                    }
                    else
                    {
                        <a href="@FileUrls.ToPublicUrl(att.FilePath)" target="_blank" class="attachment-item attachment-file-full">
                            <div class="attachment-icon-large">
                                <i class="bi bi-file-earmark"></i>
                            </div>
                            <div class="attachment-details-full">
                                <span class="attachment-name-full">@att.FileName</span>
                                <span class="attachment-size-full">@(Math.Round(att.FileSize / 1024.0, 1)) KB</span>
                            </div>
                            <div class="attachment-download-large">
                                <i class="bi bi-download"></i>
                            </div>
                        </a>
                    }
                }
            </div>
        }

        <!-- Post Footer -->
        <div class="post-footer-detail">
            <div class="post-meta">
                <span class="meta-item">
                    <i class="bi bi-paperclip"></i>
                    <span>@(Model.Attachments?.Count ?? 0) فایل پیوست</span>
                </span>
                @if (Model.IsPinned)
                {
                    <span class="meta-item">
                        <i class="bi bi-pin-angle-fill"></i>
                        <span>پین شده</span>
                    </span>
                }
            </div>
            <div class="post-actions-detail">
                
            </div>
        </div>
    </article>
</div>

<div id="attachmentPreviewModal" class="attachment-preview-modal" aria-hidden="true">
    <div class="attachment-preview-backdrop" data-preview-close="true"></div>
    <div class="attachment-preview-content" role="dialog" aria-modal="true" aria-label="پیش نمایش عکس">
        <button type="button" class="attachment-preview-close" id="attachmentPreviewCloseBtn" aria-label="بستن">
            <i class="bi bi-x-lg"></i>
        </button>
        <img id="attachmentPreviewImage" class="attachment-preview-image" src="" alt="" />
    </div>
</div>

@await Html.PartialAsync("/Views/Shared/Notes/_DeleteNoteModal.cshtml", viewData: new ViewDataDictionary(ViewData)
{
    ["DeleteNotePostUrl"] = Url.Action("Delete", "PersonalNotes")
})

