@using Endpoint.Site.Models
@using TaskPlanner.Domain.Entities.TaskPlanner
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model PersonalNoteEditVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var existingAttachments = ViewBag.ExistingAttachments as ICollection<PersonalNoteAttachment>;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">

<div class="create-note-container">
    <!-- Header -->
    <div class="create-header">
        <a href="/PersonalNotes/Details?id=@Model.Id" class="back-btn">
            <i class="bi bi-arrow-right"></i>
        </a>
        <h1 class="create-title">ویرایش یادداشت</h1>
    </div>

@if (TempData["Success"] != null)
{
        <div class="alert alert-success alert-social" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
}
@if (TempData["Error"] != null)
{
        <div class="alert alert-danger alert-social" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]
        </div>
}

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="create-form">
    <input type="hidden" asp-for="Id" />

        <!-- Main Content Card -->
        <div class="create-card">
            <!-- Title Section -->
            <div class="form-group">
                <input asp-for="Title" class="form-input-title" placeholder="عنوان یادداشت را وارد کنید..." />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

            <!-- Content Section -->
            <div class="form-group">
                <textarea asp-for="Content" class="form-textarea" rows="6" placeholder="متن یادداشت خود را بنویسید..."></textarea>
                <small class="form-text text-muted d-block mt-2">برای چک‌لیست از دکمه checklist استفاده کنید (نمایش: <code>☐</code> / <code>☑</code>).</small>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <!-- Options Row -->
            <div class="form-options">
                <div class="option-group">
                    <label class="color-picker-label">
                        <i class="bi bi-palette"></i>
                        <span>رنگ</span>
                    </label>
                    <input asp-for="Color" type="color" class="color-picker" />
                </div>
                <div class="option-group">
                    <label class="checkbox-label">
                        <input asp-for="IsPinned" type="checkbox" class="checkbox-input" />
                        <span class="checkbox-custom"></span>
                        <span class="checkbox-text">
                            <i class="bi bi-pin-angle"></i>
                            پین کردن
                        </span>
                    </label>
    </div>
    </div>

            <!-- Folder Selection -->
            <div class="form-group mt-3">
                <label class="form-label">
                    <i class="bi bi-folder"></i>
                    پوشه (اختیاری)
                </label>
                <select asp-for="FolderId" class="form-select">
                    @if (ViewBag.Folders != null)
                    {
                        @foreach (var folder in ViewBag.Folders as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                        {
                            <option value="@folder.Value">@folder.Text</option>
                        }
                    }
                </select>
                <small class="form-text text-muted">می‌توانید یادداشت را در یک پوشه قرار دهید</small>
                <span asp-validation-for="FolderId" class="text-danger"></span>
            </div>

            <!-- Existing Attachments -->
    @if (existingAttachments != null && existingAttachments.Any())
    {
                <div class="existing-attachments-section">
                    <div class="section-title">
                        <i class="bi bi-paperclip"></i>
                        <span>فایل‌های موجود (@existingAttachments.Count)</span>
                    </div>
                    <div class="existing-attachments-list" id="existingAttachments">
                @foreach (var att in existingAttachments)
                {
                            <div class="existing-attachment-item" id="attachment-@att.Id">
                                @if (att.FileType == "Image")
                                {
                                    <div class="attachment-preview-image">
                                        <img src="@att.FilePath" alt="@att.FileName" />
                                    </div>
                                    <div class="attachment-preview-info">
                                        <span class="attachment-preview-file-name">@att.FileName</span>
                                        <span class="attachment-preview-file-size">@(Math.Round(att.FileSize / 1024.0, 1)) KB</span>
                                    </div>
                                    <div class="attachment-preview-actions">
                                        <a href="@att.FilePath" target="_blank" class="btn-download">
                                            <i class="bi bi-download"></i>
                                            <span>دانلود</span>
                                        </a>
                                        <button type="button" class="btn-delete" onclick="deleteAttachment(@att.Id)">
                                            <i class="bi bi-trash"></i>
                                            <span>حذف</span>
                                        </button>
                                    </div>
                                }
                                else if (att.FileType == "Audio")
                                {
                                    <div class="attachment-preview-audio">
                                        <audio controls>
                                            <source src="@att.FilePath" type="@att.MimeType">
                                        </audio>
                                    </div>
                                    <div class="attachment-preview-info">
                                        <span class="attachment-preview-file-name">@att.FileName</span>
                                        <span class="attachment-preview-file-size">@(Math.Round(att.FileSize / 1024.0, 1)) KB</span>
                                    </div>
                                    <div class="attachment-preview-actions">
                                        <a href="@att.FilePath" target="_blank" class="btn-download">
                                            <i class="bi bi-download"></i>
                                            <span>دانلود</span>
                                        </a>
                                        <button type="button" class="btn-delete" onclick="deleteAttachment(@att.Id)">
                                            <i class="bi bi-trash"></i>
                                            <span>حذف</span>
                                        </button>
                                    </div>
                                }
                                else if (att.FileType == "Document")
                                {
                                    <div class="attachment-preview-file-icon-large">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </div>
                                    <div class="attachment-preview-info">
                                        <span class="attachment-preview-file-name">@att.FileName</span>
                                        <span class="attachment-preview-file-size">@(Math.Round(att.FileSize / 1024.0, 1)) KB</span>
                                    </div>
                                    <div class="attachment-preview-actions">
                                        <a href="@att.FilePath" target="_blank" class="btn-download">
                                            <i class="bi bi-download"></i>
                                            <span>دانلود</span>
                                        </a>
                                        <button type="button" class="btn-delete" onclick="deleteAttachment(@att.Id)">
                                            <i class="bi bi-trash"></i>
                                            <span>حذف</span>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="attachment-preview-file-icon-large">
                                        <i class="bi bi-file-earmark"></i>
                                    </div>
                                    <div class="attachment-preview-info">
                                        <span class="attachment-preview-file-name">@att.FileName</span>
                                        <span class="attachment-preview-file-size">@(Math.Round(att.FileSize / 1024.0, 1)) KB</span>
                                </div>
                                    <div class="attachment-preview-actions">
                                        <a href="@att.FilePath" target="_blank" class="btn-download">
                                            <i class="bi bi-download"></i>
                                            <span>دانلود</span>
                                        </a>
                                        <button type="button" class="btn-delete" onclick="deleteAttachment(@att.Id)">
                                            <i class="bi bi-trash"></i>
                                            <span>حذف</span>
                                    </button>
                                </div>
                                }
                    </div>
                }
            </div>
            <div id="deletedAttachmentsContainer"></div>
        </div>
    }

            <!-- New Attachments Section -->
            <div class="attachments-section">
                <label class="attachment-label">
                    <input type="file" name="NewAttachments" class="file-input-hidden" id="fileInput" multiple 
               accept="image/*,audio/*,.pdf,.doc,.docx,.txt,.zip,.rar"
               onchange="handleFileSelect(event)" />
                    <div class="file-input-trigger">
                        <i class="bi bi-plus-circle"></i>
                        <span>افزودن فایل جدید</span>
                    </div>
                </label>
                
                <!-- File Preview -->
                <div id="filesPreview" class="files-preview"></div>
    </div>

            <!-- Voice Recording Section -->
            <div class="voice-section">
                <button type="button" class="voice-btn" id="recordBtn" onclick="toggleRecording()">
                    <span class="voice-icon" id="recordIcon">
                        <i class="bi bi-mic"></i>
                    </span>
                    <span class="voice-text" id="recordText">ضبط صدا</span>
                    <span class="voice-timer" id="recordTimer">00:00</span>
                    </button>
                <div id="audioPreview" class="audio-preview"></div>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <a class="btn-cancel" href="/PersonalNotes/Details?id=@Model.Id">
                <i class="bi bi-x-circle"></i>
                <span>انصراف</span>
            </a>
            <button type="submit" class="btn-submit">
                <i class="bi bi-check-lg"></i>
                <span>ذخیره تغییرات</span>
            </button>
        </div>
    </form>
    </div>

<style>
    /* Import all styles from Create.cshtml - same styling */
    .create-note-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .create-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid #e9ecef;
    }

    .back-btn {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        border-radius: 50%;
        color: #3b82f6;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .back-btn:hover {
        background: #e9ecef;
        transform: scale(1.1);
    }

    .create-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .alert-social {
        border-radius: 12px;
        border: none;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 500;
    }

    .create-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .validation-summary {
        background: #fee;
        border: 1px solid #fcc;
        border-radius: 8px;
        padding: 1rem;
        color: #c33;
        list-style: none;
        margin: 0;
    }

    .create-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-input-title {
        width: 100%;
        border: none;
        border-bottom: 2px solid #e9ecef;
        padding: 0.75rem 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: #1a1a1a;
        background: transparent;
        transition: border-color 0.2s ease;
    }

    .form-input-title:focus {
        outline: none;
        border-bottom-color: #3b82f6;
    }

    .form-textarea {
        width: 100%;
        border: none;
        padding: 0;
        font-size: 1.05rem;
        line-height: 1.6;
        color: #4a5568;
        background: transparent;
        resize: vertical;
        min-height: 150px;
        font-family: inherit;
    }

    .form-textarea:focus {
        outline: none;
    }
    .EasyMDEContainer {
        direction: ltr;
    }

    .EasyMDEContainer .CodeMirror {
        min-height: 220px;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        font-size: 1rem;
        direction: ltr;
        text-align: right;
        unicode-bidi: plaintext;
    }

    .EasyMDEContainer .CodeMirror pre,
    .EasyMDEContainer .CodeMirror-line {
        direction: ltr;
        text-align: right;
        unicode-bidi: plaintext;
    }

    .EasyMDEContainer .editor-toolbar {
        text-align: right;
    }

    .EasyMDEContainer .editor-toolbar {
        border: 1px solid #e9ecef;
        border-bottom: none;
        border-radius: 10px 10px 0 0;
    }

    .form-options {
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 1rem 0;
        border-top: 1px solid #e9ecef;
        border-bottom: 1px solid #e9ecef;
    }

    .option-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .color-picker-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #6c757d;
        font-size: 0.9rem;
        cursor: pointer;
    }

    .color-picker {
        width: 40px;
        height: 40px;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        cursor: pointer;
        padding: 0;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        user-select: none;
    }

    .checkbox-input {
        display: none;
    }

    .checkbox-custom {
        width: 20px;
        height: 20px;
        border: 2px solid #dee2e6;
        border-radius: 4px;
        position: relative;
        transition: all 0.2s ease;
    }

    .checkbox-input:checked + .checkbox-custom {
        background: #3b82f6;
        border-color: #3b82f6;
    }

    .checkbox-input:checked + .checkbox-custom::after {
        content: '✓';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        font-size: 12px;
        font-weight: bold;
    }

    .checkbox-text {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #4a5568;
        font-size: 0.9rem;
    }

    .existing-attachments-section {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e9ecef;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 1rem;
    }

    .existing-attachments-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.75rem;
    }

    .existing-attachment-item {
        position: relative;
        background: #f8f9fa;
        border-radius: 10px;
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: all 0.2s ease;
    }

    .existing-attachment-item:hover {
        background: #e9ecef;
        transform: translateY(-2px);
    }

    .attachment-preview-image {
        position: relative;
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 8px;
        background: white;
    }

    .attachment-preview-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 8px;
    }

    .attachment-preview-audio {
        background: white;
        border-radius: 8px;
        padding: 0.75rem;
    }

    .attachment-preview-audio audio {
        width: 100%;
        height: 32px;
    }

    .attachment-preview-file-icon-large {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 8px;
        margin: 0 auto;
    }

    .attachment-preview-file-icon-large i {
        font-size: 2.5rem;
        color: #6c757d;
    }

    .attachment-preview-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        text-align: center;
    }

    .attachment-preview-file-name {
        font-size: 0.9rem;
        font-weight: 500;
        color: #1a1a1a;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .attachment-preview-file-size {
        font-size: 0.8rem;
        color: #6c757d;
    }

    .attachment-preview-actions {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
    }

    .btn-download,
    .btn-delete {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .btn-download {
        background: #e7f3ff;
        color: #0066cc;
    }

    .btn-download:hover {
        background: #d0e7ff;
        color: #0052a3;
        transform: translateY(-1px);
    }

    .btn-delete {
        background: #fee;
        color: #dc3545;
    }

    .btn-delete:hover {
        background: #fdd;
        color: #c82333;
        transform: translateY(-1px);
    }


    .attachments-section {
        margin-top: 1.5rem;
    }

    .attachment-label {
        cursor: pointer;
    }

    .file-input-hidden {
        display: none;
    }

    .file-input-trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        background: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 10px;
        color: #6c757d;
        transition: all 0.2s ease;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .file-input-trigger:hover {
        background: #e9ecef;
        border-color: #3b82f6;
        color: #3b82f6;
    }

    .files-preview {
        margin-top: 1rem;
    }

    .files-preview-header {
        font-size: 0.9rem;
        color: #6c757d;
        margin-bottom: 0.75rem;
        font-weight: 500;
    }

    .files-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.75rem;
    }

    .file-preview-item {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 0.75rem;
        position: relative;
        transition: all 0.2s ease;
    }

    .file-preview-item:hover {
        background: #e9ecef;
        transform: translateY(-2px);
    }

    .file-preview-image {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        border-radius: 8px;
        overflow: hidden;
        background: white;
        margin-bottom: 0.5rem;
    }

    .file-preview-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .file-preview-audio {
        position: relative;
        background: white;
        border-radius: 8px;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .file-preview-audio audio {
        width: 100%;
        height: 32px;
    }

    .file-preview-icon {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 8px;
        margin-bottom: 0.5rem;
        font-size: 3rem;
        color: #6c757d;
    }

    .file-remove-btn {
        position: absolute;
        top: -8px;
        left: -8px;
        width: 28px;
        height: 28px;
        background: white;
        border: 2px solid #dee2e6;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ef4444;
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0;
        font-size: 1rem;
    }

    .file-remove-btn:hover {
        background: #fee;
        border-color: #ef4444;
        transform: scale(1.1);
    }

    .file-preview-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .file-name {
        font-size: 0.85rem;
        font-weight: 500;
        color: #1a1a1a;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .file-size {
        font-size: 0.75rem;
        color: #6c757d;
    }

    .voice-section {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e9ecef;
    }

    .voice-btn {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1.5rem;
        background: #f8f9fa;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        color: #6c757d;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        width: 100%;
        justify-content: center;
    }

    .voice-btn:hover {
        background: #e9ecef;
        border-color: #3b82f6;
        color: #3b82f6;
    }

    .voice-btn.recording {
        background: #fee;
        border-color: #ef4444;
        color: #ef4444;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    .voice-icon {
        font-size: 1.25rem;
    }

    .voice-timer {
        margin-right: auto;
        font-weight: 600;
    }

    .audio-preview {
        margin-top: 1rem;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
    }

    .btn-cancel {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: #f8f9fa;
        border: none;
        border-radius: 10px;
        color: #6c757d;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .btn-cancel:hover {
        background: #e9ecef;
        color: #1a1a1a;
    }

    .btn-submit {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 2rem;
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border: none;
        border-radius: 10px;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    }

    @@media (max-width: 768px) {
        .create-note-container {
            padding: 1rem 0.5rem;
        }

        .create-card {
            padding: 1.5rem;
        }

        .form-options {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .files-list {
            grid-template-columns: 1fr;
        }

        .file-preview-icon {
            font-size: 2rem;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-cancel,
        .btn-submit {
            width: 100%;
            justify-content: center;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
    <script>
        let noteEditor;
        const deletedIds = [];
        const token = '@token';
        let selectedFiles = []; // ذخیره فایل‌های جدید انتخاب شده

        function normalizeTaskListMarkdown(markdownText) {
            return (markdownText || '')
                .split('\n')
                .map(function (line) {
                    if (/^\s*-\[( |x|X)\]\s*/.test(line)) {
                        return line.replace(/^(\s*)-\[( |x|X)\]\s*/, '$1- [$2] ');
                    }

                    if (/^\s*-\s*\[( |x|X)\]\s*/.test(line)) {
                        return line.replace(/^(\s*)-\s*\[( |x|X)\]\s*/, '$1- [$2] ');
                    }

                    if (/^\s*\[( |x|X)\]\s+/.test(line)) {
                        return line.replace(/^(\s*)\[( |x|X)\]\s+/, '$1- [$2] ');
                    }

                    return line;
                })
                .join('\n');
        }

        function markdownToEditorChecklist(text) {
            return normalizeTaskListMarkdown(text)
                .split('\n')
                .map(function (line) {
                    return line.replace(/^(\s*)-\s*\[( |x|X)\]\s*(.*)$/, function (_, indent, marker, content) {
                        const symbol = marker.toLowerCase() === 'x' ? '☑' : '☐';
                        return `${indent}${symbol} ${content}`;
                    });
                })
                .join('\n');
        }

        function editorChecklistToMarkdown(text) {
            return normalizeTaskListMarkdown(
                (text || '')
                    .split('\n')
                    .map(function (line) {
                        if (/^\s*☐\s*/.test(line)) {
                            return line.replace(/^(\s*)☐\s*(.*)$/, '$1- [ ] $2');
                        }
                        if (/^\s*☑\s*/.test(line)) {
                            return line.replace(/^(\s*)☑\s*(.*)$/, '$1- [x] $2');
                        }
                        return line;
                    })
                    .join('\n')
            );
        }

        function insertChecklistItem(editor) {
            const cm = editor.codemirror;
            const cursor = cm.getCursor();
            cm.replaceSelection('☐ ');
            cm.setCursor({ line: cursor.line, ch: cursor.ch + 2 });
            cm.focus();
        }

        function bindChecklistAutoContinue(editor) {
            const cm = editor.codemirror;
            cm.on('keydown', function (_, event) {
                if (event.key !== 'Enter') return;

                const cursor = cm.getCursor();
                const lineText = cm.getLine(cursor.line) || '';
                const checklistMatch = lineText.match(/^(\s*)(☐|☑)\s+(.*)$/);
                if (!checklistMatch) return;

                event.preventDefault();
                const indent = checklistMatch[1] || '';
                cm.replaceSelection(`\n${indent}☐ `);
            });
        }

        function bindChecklistToggleByClick(editor) {
            const cm = editor.codemirror;
            cm.getWrapperElement().addEventListener('mousedown', function (event) {
                if (event.button !== 0) return;

                const pos = cm.coordsChar({ left: event.clientX, top: event.clientY }, 'window');
                const lineText = cm.getLine(pos.line) || '';
                const match = lineText.match(/^(\s*)(☐|☑)\s+/);
                if (!match) return;

                const symbolStart = (match[1] || '').length;
                const isOnSymbol = pos.ch >= symbolStart && pos.ch <= symbolStart + 1;
                if (!isOnSymbol) return;

                event.preventDefault();
                const newSymbol = match[2] === '☐' ? '☑' : '☐';
                cm.replaceRange(newSymbol, { line: pos.line, ch: symbolStart }, { line: pos.line, ch: symbolStart + 1 });
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const contentElement = document.getElementById('Content');
            if (!contentElement) return;

            noteEditor = new EasyMDE({
                element: contentElement,
                spellChecker: false,
                status: false,
                direction: 'ltr',
                toolbar: [
                    'bold',
                    'italic',
                    'heading',
                    '|',
                    'quote',
                    'unordered-list',
                    'ordered-list',
                    {
                        name: 'checklist',
                        action: function customChecklist(editor) { insertChecklistItem(editor); },
                        className: 'fa fa-check-square-o',
                        title: 'چک‌لیست'
                    },
                    '|',
                    'guide'
                ]
            });

            const editorContent = markdownToEditorChecklist(noteEditor.value());
            if (editorContent !== noteEditor.value()) {
                noteEditor.value(editorContent);
            }

            bindChecklistAutoContinue(noteEditor);
            bindChecklistToggleByClick(noteEditor);
        });

        document.querySelector('.create-form').addEventListener('submit', function () {
            if (!noteEditor) return;
            const markdownContent = editorChecklistToMarkdown(noteEditor.value());
            noteEditor.value(markdownContent);
        });

        // مدیریت انتخاب فایل‌ها
        function handleFileSelect(event) {
            const fileInput = event.target;
            const files = Array.from(fileInput.files);
            
            // اضافه کردن فایل‌های جدید به لیست
            files.forEach(file => {
                // بررسی تکراری نبودن
                const exists = selectedFiles.some(f => f.name === file.name && f.size === file.size);
                if (!exists) {
                    selectedFiles.push(file);
                }
            });
            
            updateFilesPreview();
            updateFileInput();
        }

        // به‌روزرسانی پیش‌نمایش فایل‌های جدید
        function updateFilesPreview() {
            const previewContainer = document.getElementById('filesPreview');
            
            if (selectedFiles.length === 0) {
                previewContainer.innerHTML = '';
                return;
            }
            
            previewContainer.innerHTML = `
                <div class="files-preview-header">
                    <strong>${selectedFiles.length} فایل جدید برای آپلود</strong>
                </div>
                <div class="files-list" id="newFilesList"></div>
            `;
            
            const filesList = document.getElementById('newFilesList');
            
            selectedFiles.forEach((file, index) => {
                const fileCard = createFilePreviewCard(file, index);
                filesList.appendChild(fileCard);
            });
        }

        // ساخت کارت پیش‌نمایش فایل
        function createFilePreviewCard(file, index) {
            const col = document.createElement('div');
            col.className = 'col-md-6 col-lg-4';
            
            const card = document.createElement('div');
            card.className = 'card h-100';
            
            const cardBody = document.createElement('div');
            cardBody.className = 'card-body';
            
            let previewHtml = '';
            
            if (file.type.startsWith('image/')) {
                const imageUrl = URL.createObjectURL(file);
                previewHtml = `
                    <div class="text-center mb-2">
                        <img src="${imageUrl}" alt="${file.name}" 
                             class="img-fluid rounded" 
                             style="max-height: 150px; object-fit: cover;" />
                    </div>
                    <span class="badge bg-primary mb-2">
                        <i class="bi bi-image"></i> تصویر
                    </span>
                `;
            } else if (file.type.startsWith('audio/')) {
                const audioUrl = URL.createObjectURL(file);
                previewHtml = `
                    <div class="mb-2">
                        <audio controls class="w-100" style="max-height: 40px;">
                            <source src="${audioUrl}" type="${file.type}">
                        </audio>
                    </div>
                    <span class="badge bg-info mb-2">
                        <i class="bi bi-music-note"></i> صوت
                    </span>
                `;
            } else if (file.type.includes('pdf')) {
                previewHtml = `
                    <div class="text-center mb-2">
                        <i class="bi bi-file-pdf text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <span class="badge bg-danger mb-2">
                        <i class="bi bi-file-pdf"></i> PDF
                    </span>
                `;
            } else if (file.type.includes('word') || file.type.includes('document')) {
                previewHtml = `
                    <div class="text-center mb-2">
                        <i class="bi bi-file-word text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <span class="badge bg-success mb-2">
                        <i class="bi bi-file-earmark-text"></i> سند
                    </span>
                `;
            } else {
                previewHtml = `
                    <div class="text-center mb-2">
                        <i class="bi bi-file-earmark text-secondary" style="font-size: 3rem;"></i>
                    </div>
                    <span class="badge bg-secondary mb-2">
                        <i class="bi bi-file-earmark"></i> فایل
                    </span>
                `;
            }
            
            cardBody.innerHTML = `
                ${previewHtml}
                <div class="small text-muted mb-2" style="word-break: break-word;">
                    <strong>${file.name}</strong>
                </div>
                <div class="small text-muted">
                    حجم: ${formatFileSize(file.size)}
                </div>
                <button type="button" class="btn btn-sm btn-danger w-100 mt-2" onclick="removeNewFile(${index})">
                    <i class="bi bi-trash"></i> حذف
                </button>
            `;
            
            card.appendChild(cardBody);
            col.appendChild(card);
            
            return col;
        }

        // فرمت کردن حجم فایل
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        // حذف فایل جدید از لیست
        function removeNewFile(index) {
            selectedFiles.splice(index, 1);
            updateFilesPreview();
            updateFileInput();
        }

        // به‌روزرسانی input فایل
        function updateFileInput() {
            const fileInput = document.getElementById('fileInput');
            const dataTransfer = new DataTransfer();
            
            selectedFiles.forEach(file => {
                dataTransfer.items.add(file);
            });
            
            fileInput.files = dataTransfer.files;
        }

        function deleteAttachment(id) {
            if (!confirm('آیا از حذف این فایل مطمئن هستید؟')) return;

            const card = document.getElementById('attachment-' + id);
            if (card) {
                card.remove();
                deletedIds.push(id);
                
                const container = document.getElementById('deletedAttachmentsContainer');
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'DeletedAttachmentIds';
                input.value = id;
                container.appendChild(input);
            }
        }

        // ضبط ویس
        let mediaRecorder;
        let audioChunks = [];
        let recordingStartTime;
        let timerInterval;

        async function toggleRecording() {
            if (!mediaRecorder || mediaRecorder.state === 'inactive') {
                await startRecording();
            } else {
                stopRecording();
            }
        }

        async function startRecording() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = (event) => {
                    if (event.data && event.data.size > 0) {
                        audioChunks.push(event.data);
                        console.log('Audio chunk captured:', event.data.size, 'bytes');
                    }
                };

                mediaRecorder.onstop = () => {
                    console.log('Recording stopped. Total chunks:', audioChunks.length);
                    
                    if (audioChunks.length === 0) {
                        alert('هیچ داده صوتی ضبط نشد. لطفاً دوباره تلاش کنید.');
                        stream.getTracks().forEach(track => track.stop());
                        return;
                    }
                    
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    console.log('Audio blob size:', audioBlob.size, 'bytes');
                    
                    if (audioBlob.size === 0) {
                        alert('فایل صوتی خالی است. لطفاً دوباره تلاش کنید.');
                        stream.getTracks().forEach(track => track.stop());
                        return;
                    }
                    
                    const audioUrl = URL.createObjectURL(audioBlob);
                    
                    const preview = document.getElementById('audioPreview');
                    const audioElement = document.createElement('audio');
                    audioElement.controls = true;
                    audioElement.src = audioUrl;
                    audioElement.className = 'w-100 mt-2';
                    preview.innerHTML = '';
                    preview.appendChild(audioElement);

                    const fileName = `voice_${new Date().getTime()}.webm`;
                    const file = new File([audioBlob], fileName, { type: 'audio/webm' });
                    addFileToInput(file);

                    stream.getTracks().forEach(track => track.stop());
                };

                // شروع ضبط با timeslice برای جمع‌آوری بهتر داده‌ها
                mediaRecorder.start(100);
                recordingStartTime = Date.now();
                console.log('Voice recording started...');
                
                document.getElementById('recordBtn').classList.add('recording');
                document.getElementById('recordIcon').innerHTML = '<i class="bi bi-stop-fill"></i>';
                document.getElementById('recordText').textContent = 'در حال ضبط...';

                timerInterval = setInterval(updateTimer, 1000);
            } catch (error) {
                alert('خطا در دسترسی به میکروفن: ' + error.message);
            }
        }

        function stopRecording() {
            if (mediaRecorder && mediaRecorder.state === 'recording') {
                mediaRecorder.stop();
                clearInterval(timerInterval);

                document.getElementById('recordBtn').classList.remove('recording');
                document.getElementById('recordIcon').innerHTML = '<i class="bi bi-mic"></i>';
                document.getElementById('recordText').textContent = 'ضبط صدا';
                document.getElementById('recordTimer').textContent = '00:00';
            }
        }

        function updateTimer() {
            const elapsed = Math.floor((Date.now() - recordingStartTime) / 1000);
            const minutes = Math.floor(elapsed / 60).toString().padStart(2, '0');
            const seconds = (elapsed % 60).toString().padStart(2, '0');
            document.getElementById('recordTimer').textContent = `${minutes}:${seconds}`;
        }

        function addFileToInput(file) {
            console.log('📎 addFileToInput called with:', file.name, file.size, 'bytes');
            
            // اضافه کردن به لیست فایل‌های انتخاب شده
            const exists = selectedFiles.some(f => f.name === file.name && f.size === file.size);
            if (!exists) {
                selectedFiles.push(file);
                updateFilesPreview();
                updateFileInput();
            }
            
            console.log('📎 Total files:', selectedFiles.length);
        }
    </script>
}
