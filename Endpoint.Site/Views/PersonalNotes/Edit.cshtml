@using Endpoint.Site.Models
@using TaskPlanner.Domain.Entities.TaskPlanner
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model PersonalNoteEditVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var existingAttachments = ViewBag.ExistingAttachments as ICollection<PersonalNoteAttachment>;
}

<h2>ویرایش یادداشت شخصی</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label">عنوان یادداشت</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Content" class="form-label">محتوا</label>
        <textarea asp-for="Content" class="form-control" rows="8"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Color" class="form-label">رنگ (اختیاری)</label>
        <input asp-for="Color" type="color" class="form-control" />
        <small class="form-text text-muted">رنگی برای خط کناری کارت یادداشت انتخاب کنید.</small>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="IsPinned" type="checkbox" class="form-check-input" />
        <label asp-for="IsPinned" class="form-check-label">پین کردن این یادداشت</label>
    </div>

    <!-- فایل‌های موجود -->
    @if (existingAttachments != null && existingAttachments.Any())
    {
        <div class="mb-3">
            <label class="form-label">📎 فایل‌های پیوست موجود (@existingAttachments.Count فایل)</label>
            <div class="row g-2" id="existingAttachments">
                @foreach (var att in existingAttachments)
                {
                    <div class="col-md-6 col-lg-4" id="attachment-@att.Id">
                        <div class="card h-100">
                            <div class="card-body">
                                @if (att.FileType == "Image")
                                {
                                    <div class="text-center mb-2">
                                        <img src="@att.FilePath" alt="@att.FileName" 
                                             class="img-fluid rounded" 
                                             style="max-height: 150px; object-fit: cover;" />
                                    </div>
                                    <span class="badge bg-primary mb-2">
                                        <i class="bi bi-image"></i> تصویر
                                    </span>
                                }
                                else if (att.FileType == "Audio")
                                {
                                    <div class="mb-2">
                                        <audio controls class="w-100" style="max-height: 40px;">
                                            <source src="@att.FilePath" type="@att.MimeType">
                                        </audio>
                                    </div>
                                    <span class="badge bg-info mb-2">
                                        <i class="bi bi-music-note"></i> صوت
                                    </span>
                                }
                                else if (att.FileType == "Document")
                                {
                                    <div class="text-center mb-2">
                                        <i class="bi bi-file-earmark-text text-success" style="font-size: 3rem;"></i>
                                    </div>
                                    <span class="badge bg-success mb-2">
                                        <i class="bi bi-file-earmark-text"></i> سند
                                    </span>
                                }
                                else
                                {
                                    <div class="text-center mb-2">
                                        <i class="bi bi-file-earmark text-secondary" style="font-size: 3rem;"></i>
                                    </div>
                                    <span class="badge bg-secondary mb-2">
                                        <i class="bi bi-file-earmark"></i> فایل
                                    </span>
                                }
                                <div class="small text-muted mb-2" style="word-break: break-word;">
                                    <strong>@att.FileName</strong>
                                </div>
                                <div class="small text-muted mb-2">
                                    حجم: @(Math.Round(att.FileSize / 1024.0, 2)) KB
                                </div>
                                <div class="d-grid gap-2">
                                    <a href="@att.FilePath" target="_blank" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-download"></i> دانلود
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteAttachment(@att.Id)">
                                        <i class="bi bi-trash"></i> حذف
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div id="deletedAttachmentsContainer"></div>
        </div>
    }

    <!-- آپلود فایل‌های جدید -->
    <div class="mb-3">
        <label class="form-label">📎 افزودن فایل‌های جدید</label>
        <input type="file" name="NewAttachments" class="form-control" id="fileInput" multiple 
               accept="image/*,audio/*,.pdf,.doc,.docx,.txt,.zip,.rar"
               onchange="handleFileSelect(event)" />
        <small class="text-muted">
            فرمت‌های مجاز: تصویر (jpg, png, gif), صوت (mp3, wav, ogg), سند (pdf, doc, docx)
            <br>
            حداکثر حجم هر فایل: 10 مگابایت - می‌توانید چندین فایل را یکجا انتخاب کنید
        </small>
        
        <!-- پیش‌نمایش فایل‌های جدید -->
        <div id="filesPreview" class="mt-3"></div>
    </div>

    <!-- 🎤 ضبط ویس آنلاین -->
    <div class="mb-3">
        <label class="form-label">🎤 ضبط ویس آنلاین</label>
        <div class="card">
            <div class="card-body">
                <div class="d-flex gap-2 align-items-center mb-2">
                    <button type="button" class="btn btn-danger" id="recordBtn" onclick="toggleRecording()">
                        <span id="recordIcon">●</span> <span id="recordText">شروع ضبط</span>
                    </button>
                    <span id="recordTimer" class="text-muted">00:00</span>
                </div>
                <div id="audioPreview"></div>
                <small class="text-muted">با کلیک روی دکمه، ضبط صدا شروع می‌شود. مجدداً کلیک کنید تا ضبط متوقف شود.</small>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-warning">ذخیره تغییرات</button>
    <a class="btn btn-secondary" asp-action="Index">انصراف</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const deletedIds = [];
        const token = '@token';
        let selectedFiles = []; // ذخیره فایل‌های جدید انتخاب شده

        // مدیریت انتخاب فایل‌ها
        function handleFileSelect(event) {
            const fileInput = event.target;
            const files = Array.from(fileInput.files);
            
            // اضافه کردن فایل‌های جدید به لیست
            files.forEach(file => {
                // بررسی تکراری نبودن
                const exists = selectedFiles.some(f => f.name === file.name && f.size === file.size);
                if (!exists) {
                    selectedFiles.push(file);
                }
            });
            
            updateFilesPreview();
            updateFileInput();
        }

        // به‌روزرسانی پیش‌نمایش فایل‌های جدید
        function updateFilesPreview() {
            const previewContainer = document.getElementById('filesPreview');
            
            if (selectedFiles.length === 0) {
                previewContainer.innerHTML = '';
                return;
            }
            
            previewContainer.innerHTML = `
                <div class="alert alert-success">
                    <strong>${selectedFiles.length} فایل جدید برای آپلود:</strong>
                </div>
                <div class="row g-2" id="newFilesList"></div>
            `;
            
            const filesList = document.getElementById('newFilesList');
            
            selectedFiles.forEach((file, index) => {
                const fileCard = createFilePreviewCard(file, index);
                filesList.appendChild(fileCard);
            });
        }

        // ساخت کارت پیش‌نمایش فایل
        function createFilePreviewCard(file, index) {
            const col = document.createElement('div');
            col.className = 'col-md-6 col-lg-4';
            
            const card = document.createElement('div');
            card.className = 'card h-100';
            
            const cardBody = document.createElement('div');
            cardBody.className = 'card-body';
            
            let previewHtml = '';
            
            if (file.type.startsWith('image/')) {
                const imageUrl = URL.createObjectURL(file);
                previewHtml = `
                    <div class="text-center mb-2">
                        <img src="${imageUrl}" alt="${file.name}" 
                             class="img-fluid rounded" 
                             style="max-height: 150px; object-fit: cover;" />
                    </div>
                    <span class="badge bg-primary mb-2">
                        <i class="bi bi-image"></i> تصویر
                    </span>
                `;
            } else if (file.type.startsWith('audio/')) {
                const audioUrl = URL.createObjectURL(file);
                previewHtml = `
                    <div class="mb-2">
                        <audio controls class="w-100" style="max-height: 40px;">
                            <source src="${audioUrl}" type="${file.type}">
                        </audio>
                    </div>
                    <span class="badge bg-info mb-2">
                        <i class="bi bi-music-note"></i> صوت
                    </span>
                `;
            } else if (file.type.includes('pdf')) {
                previewHtml = `
                    <div class="text-center mb-2">
                        <i class="bi bi-file-pdf text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <span class="badge bg-danger mb-2">
                        <i class="bi bi-file-pdf"></i> PDF
                    </span>
                `;
            } else if (file.type.includes('word') || file.type.includes('document')) {
                previewHtml = `
                    <div class="text-center mb-2">
                        <i class="bi bi-file-word text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <span class="badge bg-success mb-2">
                        <i class="bi bi-file-earmark-text"></i> سند
                    </span>
                `;
            } else {
                previewHtml = `
                    <div class="text-center mb-2">
                        <i class="bi bi-file-earmark text-secondary" style="font-size: 3rem;"></i>
                    </div>
                    <span class="badge bg-secondary mb-2">
                        <i class="bi bi-file-earmark"></i> فایل
                    </span>
                `;
            }
            
            cardBody.innerHTML = `
                ${previewHtml}
                <div class="small text-muted mb-2" style="word-break: break-word;">
                    <strong>${file.name}</strong>
                </div>
                <div class="small text-muted">
                    حجم: ${formatFileSize(file.size)}
                </div>
                <button type="button" class="btn btn-sm btn-danger w-100 mt-2" onclick="removeNewFile(${index})">
                    <i class="bi bi-trash"></i> حذف
                </button>
            `;
            
            card.appendChild(cardBody);
            col.appendChild(card);
            
            return col;
        }

        // فرمت کردن حجم فایل
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        // حذف فایل جدید از لیست
        function removeNewFile(index) {
            selectedFiles.splice(index, 1);
            updateFilesPreview();
            updateFileInput();
        }

        // به‌روزرسانی input فایل
        function updateFileInput() {
            const fileInput = document.getElementById('fileInput');
            const dataTransfer = new DataTransfer();
            
            selectedFiles.forEach(file => {
                dataTransfer.items.add(file);
            });
            
            fileInput.files = dataTransfer.files;
        }

        function deleteAttachment(id) {
            if (!confirm('آیا از حذف این فایل مطمئن هستید؟')) return;

            const card = document.getElementById('attachment-' + id);
            if (card) {
                card.remove();
                deletedIds.push(id);
                
                const container = document.getElementById('deletedAttachmentsContainer');
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'DeletedAttachmentIds';
                input.value = id;
                container.appendChild(input);
            }
        }

        // ضبط ویس
        let mediaRecorder;
        let audioChunks = [];
        let recordingStartTime;
        let timerInterval;

        async function toggleRecording() {
            if (!mediaRecorder || mediaRecorder.state === 'inactive') {
                await startRecording();
            } else {
                stopRecording();
            }
        }

        async function startRecording() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = (event) => {
                    if (event.data && event.data.size > 0) {
                        audioChunks.push(event.data);
                        console.log('Audio chunk captured:', event.data.size, 'bytes');
                    }
                };

                mediaRecorder.onstop = () => {
                    console.log('Recording stopped. Total chunks:', audioChunks.length);
                    
                    if (audioChunks.length === 0) {
                        alert('هیچ داده صوتی ضبط نشد. لطفاً دوباره تلاش کنید.');
                        stream.getTracks().forEach(track => track.stop());
                        return;
                    }
                    
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    console.log('Audio blob size:', audioBlob.size, 'bytes');
                    
                    if (audioBlob.size === 0) {
                        alert('فایل صوتی خالی است. لطفاً دوباره تلاش کنید.');
                        stream.getTracks().forEach(track => track.stop());
                        return;
                    }
                    
                    const audioUrl = URL.createObjectURL(audioBlob);
                    
                    const preview = document.getElementById('audioPreview');
                    const audioElement = document.createElement('audio');
                    audioElement.controls = true;
                    audioElement.src = audioUrl;
                    audioElement.className = 'w-100 mt-2';
                    preview.innerHTML = '';
                    preview.appendChild(audioElement);

                    const fileName = `voice_${new Date().getTime()}.webm`;
                    const file = new File([audioBlob], fileName, { type: 'audio/webm' });
                    addFileToInput(file);

                    stream.getTracks().forEach(track => track.stop());
                };

                // شروع ضبط با timeslice برای جمع‌آوری بهتر داده‌ها
                mediaRecorder.start(100);
                recordingStartTime = Date.now();
                console.log('Voice recording started...');
                
                document.getElementById('recordBtn').classList.remove('btn-danger');
                document.getElementById('recordBtn').classList.add('btn-success');
                document.getElementById('recordIcon').textContent = '■';
                document.getElementById('recordText').textContent = 'توقف ضبط';

                timerInterval = setInterval(updateTimer, 1000);
            } catch (error) {
                alert('خطا در دسترسی به میکروفن: ' + error.message);
            }
        }

        function stopRecording() {
            if (mediaRecorder && mediaRecorder.state === 'recording') {
                mediaRecorder.stop();
                clearInterval(timerInterval);

                document.getElementById('recordBtn').classList.remove('btn-success');
                document.getElementById('recordBtn').classList.add('btn-danger');
                document.getElementById('recordIcon').textContent = '●';
                document.getElementById('recordText').textContent = 'شروع ضبط';
                document.getElementById('recordTimer').textContent = '00:00';
            }
        }

        function updateTimer() {
            const elapsed = Math.floor((Date.now() - recordingStartTime) / 1000);
            const minutes = Math.floor(elapsed / 60).toString().padStart(2, '0');
            const seconds = (elapsed % 60).toString().padStart(2, '0');
            document.getElementById('recordTimer').textContent = `${minutes}:${seconds}`;
        }

        function addFileToInput(file) {
            console.log('📎 addFileToInput called with:', file.name, file.size, 'bytes');
            
            // اضافه کردن به لیست فایل‌های انتخاب شده
            const exists = selectedFiles.some(f => f.name === file.name && f.size === file.size);
            if (!exists) {
                selectedFiles.push(file);
                updateFilesPreview();
                updateFileInput();
            }
            
            console.log('📎 Total files:', selectedFiles.length);
        }
    </script>
}
