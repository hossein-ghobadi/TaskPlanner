@model Endpoint.Site.Models.CombinedInvitationsVm
@using DNTPersianUtils.Core
@using TaskPlanner.Domain.Entities.TaskPlanner
@using System.Security.Claims

@{
    ViewData["Title"] = "دعوت‌های من";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    /* === Invitations: clean, classic, accessible redesign === */
    .invitations-page {
        padding: 0.35rem 0.25rem 1rem;
        color: #1f2937;
        width: 100%;
        max-width: none;
        margin: 0;
    }

    .invitations-page h2 {
        font-size: 1.38rem;
        margin-bottom: 0.45rem !important;
        color: #1f2937;
        font-weight: 700;
    }

    .invitations-subtitle {
        color: #6b7280;
        font-size: 0.9rem;
        margin-bottom: 0.95rem;
    }

    .invitations-page .card {
        border: 1px solid #d7dce2;
        border-radius: 10px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05) !important;
        margin-bottom: 0.85rem !important;
        overflow: hidden;
    }

    .invitations-page .card-body {
        padding: 0 !important;
        background: #fff;
    }

    .invitations-page .card-header {
        font-size: 0.94rem;
        padding: 0.65rem 0.9rem;
        background: #f8f9fa !important;
        color: #374151;
        border-bottom: 1px solid #e4e7eb;
        font-weight: 700;
        letter-spacing: 0;
    }

    .invitations-page .table-mobile-cards { border: none; }
    .invitations-page .table-mobile-cards thead { display: none; }
    .invitations-page .table-mobile-cards tbody tr {
        display: block;
        border: 1px solid #e1e5ea;
        border-radius: 9px;
        margin: 0.65rem;
        padding: 0.75rem 0.8rem;
        background: #fff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    }
    .invitations-page .table-mobile-cards tbody tr td {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.38rem 0;
        border: none !important;
        gap: 0.65rem;
        word-break: break-word;
    }
    .invitations-page .table-mobile-cards tbody tr td::before {
        content: attr(data-label);
        font-weight: 600;
        color: #6b7280;
        font-size: 0.8rem;
        flex-shrink: 0;
    }
    .invitations-page .table-mobile-cards tbody tr td[data-actions] {
        flex-wrap: wrap;
        justify-content: flex-start;
        align-items: center;
        gap: 0.4rem;
        padding-top: 0.6rem;
        border-top: 1px solid #eceff3;
        margin-top: 0.2rem;
    }
    .invitations-page .table-mobile-cards tbody tr td[data-actions]::before { display: none; }
    .invitations-page .table-mobile-cards .btn-sm {
        font-size: 0.78rem;
        border-radius: 7px;
        padding: 0.26rem 0.55rem;
    }

    .invitations-page .table-mobile-cards [data-actions] form {
        margin: 0;
    }

    .invitations-page .btn {
        min-height: 34px;
    }

    .invitations-page .table-mobile-cards .badge {
        font-weight: 600;
        border-radius: 7px;
        font-size: 0.74rem;
        padding: 0.35em 0.55em;
    }

    .invitations-page .invite-form-mobile .col-md-8,
    .invitations-page .invite-form-mobile .col-md-4 {
        flex: 0 0 100%;
        max-width: 100%;
    }
    .invitations-page .invite-form-mobile .col-md-4 .btn { margin-top: 0.45rem; }

    .invitations-page .invite-form-mobile .row { margin: 0 -0.25rem; }
    .invitations-page .invite-form-mobile .row > [class^="col"] { padding: 0 0.25rem; }

    .invitations-page .table-responsive {
        margin: 0;
        border-radius: 0;
    }

    .invitations-page .table {
        --bs-table-bg: #fff;
        --bs-table-striped-bg: #fafafa;
        --bs-table-border-color: #e5e7eb;
    }

    .invitations-page .table thead th {
        background: #f6f7f9 !important;
        color: #374151;
        font-size: 0.84rem;
        font-weight: 700;
        padding: 0.62rem 0.7rem;
    }

    .invitations-page .table td {
        color: #374151;
        font-size: 0.86rem;
    }

    .invitations-page .table td[data-label="عملیات"] {
        min-width: 175px;
    }

    .invitations-page .border-top.p-3.bg-light {
        background: #f8f9fa !important;
        border-top: 1px solid #e5e7eb !important;
        padding: 0.85rem !important;
    }

    .invitations-page .invite-form-mobile .form-control {
        border-radius: 8px;
        border-color: #cfd6df;
        min-height: 38px;
    }

    .invitations-page .invite-form-mobile .btn-primary {
        border-radius: 8px;
        min-height: 38px;
    }

    .invitations-page .table .btn-outline-danger,
    .invitations-page .table .btn-danger {
        border-width: 1px;
    }

    .invitations-page .section-empty {
        padding: 1rem 1rem 1.1rem;
        margin: 0;
        color: #6b7280;
        font-size: 0.9rem;
    }

    @@media (min-width: 768px) {
        .invitations-page .table-mobile-cards thead { display: table-header-group; }
        .invitations-page .table-mobile-cards tbody tr {
            display: table-row;
            border: none;
            border-bottom: 1px solid #e5e7eb;
            margin: 0;
            padding: 0;
            border-radius: 0;
            box-shadow: none;
        }
        .invitations-page .table-mobile-cards tbody tr td {
            display: table-cell;
            padding: 0.65rem 0.72rem;
            border: none;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: middle;
        }
        .invitations-page .table-mobile-cards tbody tr td::before { display: none; }
        .invitations-page .table-mobile-cards tbody tr td[data-actions] {
            border-top: none;
            margin-top: 0;
            padding-top: 0.65rem;
            white-space: nowrap;
        }
        .invitations-page .table-mobile-cards tbody tr td[data-actions] .btn {
            margin: 0 0.12rem;
        }
    }

    @@media (min-width: 576px) {
        .invitations-page h2 { font-size: 1.5rem; }
    }

    @@media (max-width: 575.98px) {
        .invitations-page .alert { font-size: 0.9rem; padding: 0.72rem 0.9rem; }
        .invitations-page h2 { font-size: 1.2rem; }
        .invitations-page .table-mobile-cards tbody tr {
            margin: 0.5rem;
            padding: 0.65rem 0.7rem;
        }
        .invitations-subtitle { font-size: 0.84rem; }
    }
</style>

<div class="invitations-page">
<h2>دعوت‌های من</h2>
<p class="invitations-subtitle">مدیریت دعوت‌های پروژه، همکاری و اعضای سیستم در یک نمای ساده و قابل‌دسترسی</p>

<!-- ✅ پیام‌های عمومی -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-x-circle-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light fw-bold">دعوت‌های پروژه</div>
    <div class="card-body p-0">
        @if (Model.ProjectInvitations.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle table-mobile-cards">
                    <thead class="table-light">
                        <tr>
                            <th>پروژه</th>
                            <th>دعوت‌کننده</th>
                            <th>شماره</th>
                            <th>تاریخ ارسال</th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.ProjectInvitations)
                        {
                            <tr>
                                <td data-label="پروژه">@inv.Project?.Name</td>
                                <td data-label="دعوت‌کننده">
                                    @(ViewBag.UserLookup.ContainsKey(inv.InviterId)
                                        ? ViewBag.UserLookup[inv.InviterId]
                                        : "کاربر ناشناس")
                                </td>
                                <td data-label="شماره">@inv.InviteePhone</td>
                                <td data-label="تاریخ ارسال">@inv.CreatedAt.ToLocalTime().ToShortPersianDateTimeString()</td>
                                <td data-label="وضعیت">
                                    @switch (inv.Status)
                                    {
                                        case InvitationStatus.Pending:
                                            <span class="badge bg-warning text-dark">🕓 در انتظار پاسخ</span>
                                            break;
                                        case InvitationStatus.Accepted:
                                            <span class="badge bg-success">✅ پذیرفته‌شده</span>
                                            break;
                                        case InvitationStatus.Rejected:
                                            <span class="badge bg-danger">❌ رد شده</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center" data-label="عملیات" data-actions>
                                    @if (inv.Status == InvitationStatus.Pending)
                                    {
                                        <form 
                                              asp-controller="ProjectInvitations"
                                              asp-action="RespondToInvite"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@inv.Id" />
                                            <button name="accept" value="true" class="btn btn-success btn-sm">پذیرفتن</button>
                                            <button name="accept" value="false" class="btn btn-danger btn-sm">رد</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="section-empty">هیچ دعوت پروژه‌ای در انتظار پاسخ نیست.</p>
        }
    </div>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light fw-bold">دعوت‌های لید (CRM)</div>
    <div class="card-body p-0">
        @if (Model.LeadInvitationsReceived.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle table-mobile-cards">
                    <thead class="table-light">
                        <tr>
                            <th>لید</th>
                            <th>دعوت‌کننده</th>
                            <th>شماره شما</th>
                            <th>تاریخ</th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.LeadInvitationsReceived)
                        {
                            <tr>
                                <td data-label="لید">@(inv.Lead?.Title ?? ("لید #" + inv.LeadId))</td>
                                <td data-label="دعوت‌کننده">
                                    @(ViewBag.UserLookup != null && ViewBag.UserLookup.ContainsKey(inv.InviterId)
                                        ? ViewBag.UserLookup[inv.InviterId]
                                        : "کاربر ناشناس")
                                </td>
                                <td data-label="شماره شما">@inv.InviteePhone</td>
                                <td data-label="تاریخ">@inv.CreatedAt.ToLocalTime().ToShortPersianDateTimeString()</td>
                                <td data-label="وضعیت">
                                    @switch (inv.Status)
                                    {
                                        case InvitationStatus.Pending:
                                            <span class="badge bg-warning text-dark">در انتظار پاسخ</span>
                                            break;
                                        case InvitationStatus.Accepted:
                                            <span class="badge bg-success">پذیرفته‌شده</span>
                                            break;
                                        case InvitationStatus.Rejected:
                                            <span class="badge bg-danger">رد شده</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center" data-label="عملیات" data-actions>
                                    @if (inv.Status == InvitationStatus.Pending)
                                    {
                                        <form asp-controller="Leads" asp-action="RespondLeadInvite" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@inv.Id" />
                                            <button name="accept" value="true" type="submit" class="btn btn-success btn-sm">پذیرفتن</button>
                                            <button name="accept" value="false" type="submit" class="btn btn-danger btn-sm">رد</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="section-empty">دعوت لید CRM دریافت نکرده‌اید.</p>
        }
    </div>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light fw-bold">دعوت‌های همکاری</div>
    <div class="card-body p-0">
        @if (Model.UserInvitations.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle table-mobile-cards">
                    <thead class="table-light">
                        <tr>
                            <th>دعوت‌کننده</th>
                            <th>شماره شما</th>
                            <th>تاریخ ارسال</th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.UserInvitations)
                        {
                            <tr>
                                <td data-label="دعوت‌کننده">
                                    @(ViewBag.UserLookup.ContainsKey(inv.InviterId)
                                        ? ViewBag.UserLookup[inv.InviterId]
                                        : "کاربر ناشناس")
                                </td>
                                <td data-label="شماره شما">@inv.InviteePhone</td>
                                <td data-label="تاریخ ارسال">@inv.CreatedAt.ToLocalTime().ToShortPersianDateTimeString()</td>
                                <td data-label="وضعیت">
                                    @switch (inv.Status)
                                    {
                                        case InvitationStatus.Pending:
                                            <span class="badge bg-warning text-dark">🕓 در انتظار پاسخ</span>
                                            break;
                                        case InvitationStatus.Accepted:
                                            <span class="badge bg-success">✅ پذیرفته‌شده</span>
                                            break;
                                        case InvitationStatus.Rejected:
                                            <span class="badge bg-danger">❌ رد شده</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center" data-label="عملیات" data-actions>
                                    @if (inv.Status == InvitationStatus.Pending)
                                    {
                                        <form 
                                              asp-controller="Invitations"
                                              asp-action="RespondToSystemInvite"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@inv.Id" />
                                            <button name="accept" value="true" class="btn btn-success btn-sm">پذیرفتن</button>
                                            <button name="accept" value="false" class="btn btn-danger btn-sm">رد</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="section-empty">هیچ دعوتی برای همکاری در انتظار پاسخ نیست.</p>
        }

        <div class="border-top p-3 bg-light">
            <h6 class="fw-bold mb-3">ارسال دعوت جدید به همکاری</h6>

            <!-- پیام فقط برای فرم دعوت -->
            @if (TempData["InviteSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @TempData["InviteSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["InviteError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle-fill"></i> @TempData["InviteError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form 
                  asp-controller="Invitations"
                  asp-action="InviteSystemUser"
                  method="post"
                  class="row g-2 align-items-center invite-form-mobile">
                @Html.AntiForgeryToken()
                <div class="col-12 col-md-8">
                    <input name="phone"
                           type="text"
                           class="form-control"
                           placeholder="شماره موبایل کاربر (مثلاً 09xxxxxxxxx)"
                           required />
                </div>
                <div class="col-12 col-md-4">
                    <button type="submit" class="btn btn-primary w-100">ارسال دعوت</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light fw-bold">دعوت‌هایی که ارسال کرده‌اید</div>
    <div class="card-body p-0">
        @if (Model.SentProjectInvitations.Any() || Model.SentSystemInvitations.Any() || Model.LeadInvitationsSent.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle table-mobile-cards">
                    <thead class="table-light">
                        <tr>
                            <th>نوع دعوت</th>
                            <th>پروژه / توضیحات</th>
                            <th>شماره دعوت‌شونده</th>
                            <th>نام دعوت‌شونده</th>
                            <th>تاریخ ارسال</th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.SentProjectInvitations)
                        {
                            <tr>
                                <td data-label="نوع دعوت"><span class="badge bg-primary">پروژه</span></td>
                                <td data-label="پروژه">@(inv.Project?.Name ?? "پروژه نامشخص")</td>
                                <td data-label="شماره دعوت‌شونده">@inv.InviteePhone</td>
                                <td data-label="نام دعوت‌شونده">
                                    @if (!string.IsNullOrEmpty(inv.InviteeId) && ViewBag.UserLookup.ContainsKey(inv.InviteeId))
                                    {
                                        @ViewBag.UserLookup[inv.InviteeId]
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td data-label="تاریخ ارسال">@inv.CreatedAt.ToLocalTime().ToShortPersianDateTimeString()</td>
                                <td data-label="وضعیت">
                                    @switch (inv.Status)
                                    {
                                        case InvitationStatus.Pending:
                                            <span class="badge bg-warning text-dark">🕓 در انتظار پاسخ</span>
                                            break;
                                        case InvitationStatus.Accepted:
                                            <span class="badge bg-success">✅ پذیرفته‌شده</span>
                                            break;
                                        case InvitationStatus.Rejected:
                                            <span class="badge bg-danger">❌ رد شده</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center" data-label="عملیات" data-actions>
                                    @if (inv.Status == InvitationStatus.Pending)
                                    {
                                        <form asp-controller="Projects"
                                              asp-action="DeleteProjectInvite"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('حذف این دعوت؟');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="projectId" value="@inv.ProjectId" />
                                            <input type="hidden" name="inviteId" value="@inv.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> حذف
                                            </button>
                                        </form>
                                    }
                                    else if (inv.Status == InvitationStatus.Accepted && !string.IsNullOrEmpty(inv.InviteeId) && inv.ProjectId.HasValue)
                                    {
                                        <form asp-controller="Invitations"
                                              asp-action="RemoveMemberFromProject"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('آیا از حذف این عضو از پروژه اطمینان دارید؟');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="projectId" value="@inv.ProjectId" />
                                            <input type="hidden" name="memberUserId" value="@inv.InviteeId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-person-x"></i> حذف از پروژه
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @foreach (var inv in Model.SentSystemInvitations)
                        {
                            <tr>
                                <td data-label="نوع دعوت"><span class="badge bg-secondary">همکاری</span></td>
                                <td data-label="توضیحات">دعوت به همکاری</td>
                                <td data-label="شماره دعوت‌شونده">@inv.InviteePhone</td>
                                <td data-label="نام دعوت‌شونده">
                                    @if (!string.IsNullOrEmpty(inv.InviteeId) && ViewBag.UserLookup.ContainsKey(inv.InviteeId))
                                    {
                                        @ViewBag.UserLookup[inv.InviteeId]
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td data-label="تاریخ ارسال">@inv.CreatedAt.ToLocalTime().ToShortPersianDateTimeString()</td>
                                <td data-label="وضعیت">
                                    @switch (inv.Status)
                                    {
                                        case InvitationStatus.Pending:
                                            <span class="badge bg-warning text-dark">🕓 در انتظار پاسخ</span>
                                            break;
                                        case InvitationStatus.Accepted:
                                            <span class="badge bg-success">✅ پذیرفته‌شده</span>
                                            break;
                                        case InvitationStatus.Rejected:
                                            <span class="badge bg-danger">❌ رد شده</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center" data-label="عملیات" data-actions>
                                    @if (inv.Status == InvitationStatus.Pending)
                                    {
                                        <form asp-controller="Invitations"
                                              asp-action="DeleteSystemInvite"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('حذف این دعوت؟');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@inv.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> حذف
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @foreach (var inv in Model.LeadInvitationsSent)
                        {
                            <tr>
                                <td data-label="نوع دعوت"><span class="badge bg-info text-dark">لید CRM</span></td>
                                <td data-label="پروژه">@(inv.Lead?.Title ?? ("لید #" + inv.LeadId))</td>
                                <td data-label="شماره دعوت‌شونده">@inv.InviteePhone</td>
                                <td data-label="نام دعوت‌شونده">
                                    @if (!string.IsNullOrEmpty(inv.InviteeId) && ViewBag.UserLookup != null && ViewBag.UserLookup.ContainsKey(inv.InviteeId))
                                    {
                                        @ViewBag.UserLookup[inv.InviteeId]
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td data-label="تاریخ ارسال">@inv.CreatedAt.ToLocalTime().ToShortPersianDateTimeString()</td>
                                <td data-label="وضعیت">
                                    @switch (inv.Status)
                                    {
                                        case InvitationStatus.Pending:
                                            <span class="badge bg-warning text-dark">در انتظار پاسخ</span>
                                            break;
                                        case InvitationStatus.Accepted:
                                            <span class="badge bg-success">پذیرفته‌شده</span>
                                            break;
                                        case InvitationStatus.Rejected:
                                            <span class="badge bg-danger">رد شده</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center" data-label="عملیات" data-actions>
                                    @if (inv.Status == InvitationStatus.Pending)
                                    {
                                        <form asp-controller="Leads" asp-action="CancelLeadInvite" method="post" class="d-inline" onsubmit="return confirm('لغو این دعوت لید؟');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="invitationId" value="@inv.Id" />
                                            <input type="hidden" name="leadId" value="@inv.LeadId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> لغو</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="section-empty">هیچ دعوتی ارسال نکرده‌اید.</p>
        }
    </div>
</div>

<!-- 👥 لیست همکاران -->
@{
    var collaboratorsList = ViewBag.Collaborators as List<Dictionary<string, object>> ?? new List<Dictionary<string, object>>();
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    
    // پیدا کردن پروژه‌هایی که کاربر فعلی ایجاد کرده
    var myProjectIds = new List<int>();
    try
    {
        var myProjects = ViewBag.MyProjects as List<int> ?? new List<int>();
        myProjectIds = myProjects;
    }
    catch { }
}
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light fw-bold">
        <i class="bi bi-people-fill text-success me-2"></i>
        همکاران من
        @if (collaboratorsList.Any())
        {
            <span class="badge bg-success ms-2">@collaboratorsList.Count</span>
        }
    </div>
    <div class="card-body p-0">
        @if (collaboratorsList.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle table-mobile-cards">
                    <thead class="table-light">
                        <tr>
                            <th>نام</th>
                            <th>شماره تلفن</th>
                            <th>ایمیل</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var collaborator in collaboratorsList)
                        {
                            <tr>
                                <td data-label="نام">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-person-circle text-primary me-2" style="font-size: 1.5rem;"></i>
                                        <span class="fw-semibold">@collaborator["DisplayName"]</span>
                                    </div>
                                </td>
                                <td data-label="شماره تلفن">
                                    @if (collaborator.ContainsKey("Phone") && !string.IsNullOrWhiteSpace(collaborator["Phone"]?.ToString()))
                                    {
                                        @collaborator["Phone"]
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td data-label="ایمیل">
                                    @if (collaborator.ContainsKey("Email") && !string.IsNullOrWhiteSpace(collaborator["Email"]?.ToString()))
                                    {
                                        @collaborator["Email"]
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center" data-label="عملیات" data-actions>
                                    <form asp-controller="Invitations"
                                          asp-action="RemoveCollaboratorFromSystem"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('⚠️ هشدار جدی!\n\nآیا از حذف این همکار از کل سیستم همکاری اطمینان دارید؟\n\nاین عمل:\n✅ تمام دعوت‌های سیستم را حذف می‌کند\n✅ کاربر را از تمام پروژه‌هایی که شما ایجاد کرده‌اید حذف می‌کند\n✅ تمام دعوت‌های پروژه‌ای مرتبط را حذف می‌کند\n\n⚠️ این عمل غیرقابل بازگشت است!');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="collaboratorUserId" value="@collaborator["Id"]" />
                                        <button type="submit" class="btn btn-danger btn-sm" title="حذف از همکاری (از تمام پروژه‌های شما)">
                                            <i class="bi bi-person-x-fill me-1"></i>
                                            حذف از همکاری
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center">
                <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-3 mb-0">هنوز همکاری ندارید</p>
                <p class="text-muted small">با ارسال دعوت به همکاری، همکاران شما در اینجا نمایش داده می‌شوند</p>
            </div>
        }
    </div>
</div>
</div>