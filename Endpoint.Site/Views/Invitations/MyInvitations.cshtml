@model Endpoint.Site.Models.CombinedInvitationsVm
@using DNTPersianUtils.Core
@using TaskPlanner.Domain.Entities.TaskPlanner
@using System.Security.Claims

@{
    ViewData["Title"] = "دعوت‌های من";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">📨 دعوت‌های من</h2>

<!-- ✅ پیام‌های عمومی -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-x-circle-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 🧩 دعوت‌های پروژه -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light fw-bold">🧩 دعوت‌های پروژه</div>
    <div class="card-body p-0">
        @if (Model.ProjectInvitations.Any())
        {
            <table class="table table-striped table-bordered mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>پروژه</th>
                        <th>دعوت‌کننده</th>
                        <th>شماره</th>
                        <th>تاریخ ارسال</th>
                        <th>وضعیت</th>
                        <th class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model.ProjectInvitations)
                    {
                        <tr>
                            <td>@inv.Project?.Name</td>
                            <td>
                                @(ViewBag.UserLookup.ContainsKey(inv.InviterId)
                                    ? ViewBag.UserLookup[inv.InviterId]
                                    : "کاربر ناشناس")
                            </td>
                            <td>@inv.InviteePhone</td>
                            <td>@inv.CreatedAt.ToLocalTime().ToShortPersianDateTimeString()</td>
                            <td>
                                @switch (inv.Status)
                                {
                                    case InvitationStatus.Pending:
                                        <span class="badge bg-warning text-dark">🕓 در انتظار پاسخ</span>
                                        break;
                                    case InvitationStatus.Accepted:
                                        <span class="badge bg-success">✅ پذیرفته‌شده</span>
                                        break;
                                    case InvitationStatus.Rejected:
                                        <span class="badge bg-danger">❌ رد شده</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                @if (inv.Status == InvitationStatus.Pending)
                                {
                                    <form 
                                          asp-controller="ProjectInvitations"
                                          asp-action="RespondToInvite"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@inv.Id" />
                                        <button name="accept" value="true" class="btn btn-success btn-sm">پذیرفتن</button>
                                        <button name="accept" value="false" class="btn btn-danger btn-sm">رد</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted p-3 mb-0">هیچ دعوت پروژه‌ای در انتظار پاسخ نیست.</p>
        }
    </div>
</div>

<!-- 🌐 دعوت‌های عضویت در سیستم -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light fw-bold">🌐 دعوت‌های همکاری</div>
    <div class="card-body p-0">
        @if (Model.UserInvitations.Any())
        {
            <table class="table table-striped table-bordered mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>دعوت‌کننده</th>
                        <th>شماره شما</th>
                        <th>تاریخ ارسال</th>
                        <th>وضعیت</th>
                        <th class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model.UserInvitations)
                    {
                        <tr>
                            <td>
                                @(ViewBag.UserLookup.ContainsKey(inv.InviterId)
                                    ? ViewBag.UserLookup[inv.InviterId]
                                    : "کاربر ناشناس")
                            </td>
                            <td>@inv.InviteePhone</td>
                            <td>@inv.CreatedAt.ToLocalTime().ToShortPersianDateTimeString()</td>
                            <td>
                                @switch (inv.Status)
                                {
                                    case InvitationStatus.Pending:
                                        <span class="badge bg-warning text-dark">🕓 در انتظار پاسخ</span>
                                        break;
                                    case InvitationStatus.Accepted:
                                        <span class="badge bg-success">✅ پذیرفته‌شده</span>
                                        break;
                                    case InvitationStatus.Rejected:
                                        <span class="badge bg-danger">❌ رد شده</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                @if (inv.Status == InvitationStatus.Pending)
                                {
                                    <form 
                                          asp-controller="Invitations"
                                          asp-action="RespondToSystemInvite"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@inv.Id" />
                                        <button name="accept" value="true" class="btn btn-success btn-sm">پذیرفتن</button>
                                        <button name="accept" value="false" class="btn btn-danger btn-sm">رد</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted p-3 mb-0">هیچ دعوتی برای همکاری در انتظار پاسخ نیست.</p>
        }

        <!-- 🔹 فرم ارسال دعوت جدید -->
        <div class="border-top p-3 bg-light">
            <h6 class="fw-bold mb-3">➕ ارسال دعوت جدید به همکاری</h6>

            <!-- پیام فقط برای فرم دعوت -->
            @if (TempData["InviteSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @TempData["InviteSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["InviteError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle-fill"></i> @TempData["InviteError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form 
                  asp-controller="Invitations"
                  asp-action="InviteSystemUser"
                  method="post"
                  class="row g-2 align-items-center">
                @Html.AntiForgeryToken()
                <div class="col-md-8">
                    <input name="phone"
                           type="text"
                           class="form-control"
                           placeholder="شماره موبایل کاربر (مثلاً 09xxxxxxxxx)"
                           required />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">ارسال دعوت</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 📤 دعوت‌های ارسال‌شده توسط من -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light fw-bold">📤 دعوت‌هایی که ارسال کرده‌اید</div>
    <div class="card-body p-0">
        @if (Model.SentProjectInvitations.Any() || Model.SentSystemInvitations.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>نوع دعوت</th>
                            <th>پروژه / توضیحات</th>
                            <th>شماره دعوت‌شونده</th>
                            <th>نام دعوت‌شونده</th>
                            <th>تاریخ ارسال</th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.SentProjectInvitations)
                        {
                            <tr>
                                <td><span class="badge bg-primary">پروژه</span></td>
                                <td>@(inv.Project?.Name ?? "پروژه نامشخص")</td>
                                <td>@inv.InviteePhone</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(inv.InviteeId) && ViewBag.UserLookup.ContainsKey(inv.InviteeId))
                                    {
                                        @ViewBag.UserLookup[inv.InviteeId]
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@inv.CreatedAt.ToLocalTime().ToShortPersianDateTimeString()</td>
                                <td>
                                    @switch (inv.Status)
                                    {
                                        case InvitationStatus.Pending:
                                            <span class="badge bg-warning text-dark">🕓 در انتظار پاسخ</span>
                                            break;
                                        case InvitationStatus.Accepted:
                                            <span class="badge bg-success">✅ پذیرفته‌شده</span>
                                            break;
                                        case InvitationStatus.Rejected:
                                            <span class="badge bg-danger">❌ رد شده</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    @if (inv.Status == InvitationStatus.Pending)
                                    {
                                        <form asp-controller="Projects"
                                              asp-action="DeleteProjectInvite"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('حذف این دعوت؟');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="projectId" value="@inv.ProjectId" />
                                            <input type="hidden" name="inviteId" value="@inv.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> حذف
                                            </button>
                                        </form>
                                    }
                                    else if (inv.Status == InvitationStatus.Accepted && !string.IsNullOrEmpty(inv.InviteeId) && inv.ProjectId.HasValue)
                                    {
                                        <form asp-controller="Invitations"
                                              asp-action="RemoveMemberFromProject"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('آیا از حذف این عضو از پروژه اطمینان دارید؟');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="projectId" value="@inv.ProjectId" />
                                            <input type="hidden" name="memberUserId" value="@inv.InviteeId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-person-x"></i> حذف از پروژه
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @foreach (var inv in Model.SentSystemInvitations)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">همکاری</span></td>
                                <td>دعوت به همکاری</td>
                                <td>@inv.InviteePhone</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(inv.InviteeId) && ViewBag.UserLookup.ContainsKey(inv.InviteeId))
                                    {
                                        @ViewBag.UserLookup[inv.InviteeId]
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@inv.CreatedAt.ToLocalTime().ToShortPersianDateTimeString()</td>
                                <td>
                                    @switch (inv.Status)
                                    {
                                        case InvitationStatus.Pending:
                                            <span class="badge bg-warning text-dark">🕓 در انتظار پاسخ</span>
                                            break;
                                        case InvitationStatus.Accepted:
                                            <span class="badge bg-success">✅ پذیرفته‌شده</span>
                                            break;
                                        case InvitationStatus.Rejected:
                                            <span class="badge bg-danger">❌ رد شده</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    @if (inv.Status == InvitationStatus.Pending)
                                    {
                                        <form asp-controller="Invitations"
                                              asp-action="DeleteSystemInvite"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('حذف این دعوت؟');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@inv.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> حذف
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted p-3 mb-0">هیچ دعوتی ارسال نکرده‌اید.</p>
        }
    </div>
</div>

<!-- 👥 لیست همکاران -->
@{
    var collaboratorsList = ViewBag.Collaborators as List<Dictionary<string, object>> ?? new List<Dictionary<string, object>>();
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    
    // پیدا کردن پروژه‌هایی که کاربر فعلی ایجاد کرده
    var myProjectIds = new List<int>();
    try
    {
        var myProjects = ViewBag.MyProjects as List<int> ?? new List<int>();
        myProjectIds = myProjects;
    }
    catch { }
}
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light fw-bold">
        <i class="bi bi-people-fill text-success me-2"></i>
        همکاران من
        @if (collaboratorsList.Any())
        {
            <span class="badge bg-success ms-2">@collaboratorsList.Count</span>
        }
    </div>
    <div class="card-body p-0">
        @if (collaboratorsList.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>نام</th>
                            <th>شماره تلفن</th>
                            <th>ایمیل</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var collaborator in collaboratorsList)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-person-circle text-primary me-2" style="font-size: 1.5rem;"></i>
                                        <span class="fw-semibold">@collaborator["DisplayName"]</span>
                                    </div>
                                </td>
                                <td>
                                    @if (collaborator.ContainsKey("Phone") && !string.IsNullOrWhiteSpace(collaborator["Phone"]?.ToString()))
                                    {
                                        @collaborator["Phone"]
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (collaborator.ContainsKey("Email") && !string.IsNullOrWhiteSpace(collaborator["Email"]?.ToString()))
                                    {
                                        @collaborator["Email"]
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-controller="Invitations"
                                          asp-action="RemoveCollaboratorFromSystem"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('⚠️ هشدار جدی!\n\nآیا از حذف این همکار از کل سیستم همکاری اطمینان دارید؟\n\nاین عمل:\n✅ تمام دعوت‌های سیستم را حذف می‌کند\n✅ کاربر را از تمام پروژه‌هایی که شما ایجاد کرده‌اید حذف می‌کند\n✅ تمام دعوت‌های پروژه‌ای مرتبط را حذف می‌کند\n\n⚠️ این عمل غیرقابل بازگشت است!');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="collaboratorUserId" value="@collaborator["Id"]" />
                                        <button type="submit" class="btn btn-danger btn-sm" title="حذف از همکاری (از تمام پروژه‌های شما)">
                                            <i class="bi bi-person-x-fill me-1"></i>
                                            حذف از همکاری
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center">
                <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-3 mb-0">هنوز همکاری ندارید</p>
                <p class="text-muted small">با ارسال دعوت به همکاری، همکاران شما در اینجا نمایش داده می‌شوند</p>
            </div>
        }
    </div>
</div>