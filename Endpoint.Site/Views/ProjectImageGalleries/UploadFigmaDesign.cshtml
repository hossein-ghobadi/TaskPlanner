@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "آپلود طراحی";
    ViewData["UseFluidLayout"] = true;
    var projectId = ViewBag.ProjectId as int?;
    var folderId = ViewBag.FolderId as int?;
}

<div class="container-fluid px-0 mt-2 upload-figma-page">
    <div class="row g-0">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #8B5CF6 0%, #6366F1 100%);">
                    <h4 class="mb-0">
                        <i class="bi bi-file-earmark-zip"></i>
                        آپلود طراحی
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            @TempData["Error"]
                        </div>
                    }

                    <p class="text-muted mb-4">
                        فایل zip اکسپورت شده از فیگما (design (9).zip یا هر نام دیگر) را انتخاب کنید. تصاویر داخل zip استخراج شده و در گالری پروژه ذخیره می‌شوند و سپس نمایش طراحی فیگما برای شما باز می‌شود.
                    </p>

                    <form asp-action="UploadFigmaDesign" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@projectId" />
                        @if (folderId.HasValue)
                        {
                            <input type="hidden" name="folderId" value="@folderId" />
                        }

                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-cloud-upload"></i>
                                فایل zip اکسپورت فیگما
                            </label>
                            <div class="file-upload-area border rounded p-5 text-center" style="background: #f8f9fa; cursor: pointer;" onclick="document.getElementById('figmaZipFile').click();">
                                <i class="bi bi-file-earmark-zip" style="font-size: 4rem; color: #8B5CF6;"></i>
                                <p class="mt-3 mb-1 fw-bold">کلیک کنید یا فایل را اینجا بکشید</p>
                                <small class="text-muted">فقط فایل‌های .zip (اکسپورت طراحی فیگما) — حداکثر ۲۵۰ مگابایت</small>
                                <input type="file" name="figmaZipFile" id="figmaZipFile" class="form-control d-none" accept=".zip" />
                            </div>
                            <div id="fileChosen" class="mt-2 text-muted small"></div>
                        </div>

                        <div class="d-flex justify-content-between gap-2 flex-wrap">
                            <a asp-action="Index" asp-route-projectId="@projectId" asp-route-folderId="@folderId" class="btn btn-secondary">
                                <i class="bi bi-arrow-right"></i>
                                انصراف
                            </a>
                            <button type="submit" class="btn btn-primary" id="btnSubmit" disabled style="background: linear-gradient(135deg, #8B5CF6 0%, #6366F1 100%); border: none;">
                                <i class="bi bi-upload"></i>
                                آپلود و نمایش طراحی
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('figmaZipFile').addEventListener('change', function () {
            var chosen = document.getElementById('fileChosen');
            var btn = document.getElementById('btnSubmit');
            if (this.files.length > 0) {
                chosen.textContent = 'انتخاب شده: ' + this.files[0].name;
                btn.disabled = false;
            } else {
                chosen.textContent = '';
                btn.disabled = true;
            }
        });
        var area = document.querySelector('.file-upload-area');
        if (area) {
            area.addEventListener('dragover', function (e) { e.preventDefault(); area.style.background = '#e9ecef'; });
            area.addEventListener('dragleave', function (e) { e.preventDefault(); area.style.background = '#f8f9fa'; });
            area.addEventListener('drop', function (e) {
                e.preventDefault();
                area.style.background = '#f8f9fa';
                if (e.dataTransfer.files.length > 0) {
                    var input = document.getElementById('figmaZipFile');
                    input.files = e.dataTransfer.files;
                    input.dispatchEvent(new Event('change'));
                }
            });
        }
    </script>
    <style>
        .app-main-body {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        .upload-figma-page {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        .file-upload-area:hover { background: #e9ecef !important; border-color: #8B5CF6 !important; }
    </style>
}
