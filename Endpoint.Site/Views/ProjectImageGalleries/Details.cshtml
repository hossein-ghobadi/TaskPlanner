@model ProjectImageGallery
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-image"></i>
                            @Model.Title
                        </h4>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light btn-sm">
                                <i class="bi bi-pencil"></i>
                                ویرایش
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i>
                                حذف
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-3">
                            <p class="text-muted">@Model.Description</p>
                        </div>
                    }

                    <div class="image-detail-view text-center mb-3">
                        <img src="@FileUrls.ToPublicUrl(Model.FilePath)" alt="@Model.Title" class="img-fluid rounded" style="max-height: 600px;" />
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="info-item">
                                <i class="bi bi-calendar"></i>
                                <strong>تاریخ ایجاد:</strong>
                                <span>@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                            </div>
                        </div>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <div class="col-md-6">
                                <div class="info-item">
                                    <i class="bi bi-pencil"></i>
                                    <strong>آخرین ویرایش:</strong>
                                    <span>@Model.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                                </div>
                            </div>
                        }
                        @if (Model.Folder != null)
                        {
                            <div class="col-md-6">
                                <div class="info-item">
                                    <i class="bi bi-folder"></i>
                                    <strong>پوشه:</strong>
                                    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-folderId="@Model.FolderId">@Model.Folder.Name</a>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-4">
                        <a asp-action="Index" asp-controller="ProjectImageGalleries" asp-route-projectId="@Model.ProjectId" asp-route-folderId="@Model.FolderId" class="btn btn-secondary">
                            <i class="bi bi-arrow-right"></i>
                            بازگشت به گالری
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .info-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .info-item i {
        color: #6c757d;
    }
</style>

