@model IEnumerable<ProjectImageGallery>
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

@{
    var folders = ViewBag.Folders as List<ProjectImageGalleryFolder> ?? new List<ProjectImageGalleryFolder>();
    var currentFolder = ViewBag.CurrentFolder as ProjectImageGalleryFolder;
    var breadcrumbFolders = ViewBag.BreadcrumbFolders as List<ProjectImageGalleryFolder> ?? new List<ProjectImageGalleryFolder>();
    var folderId = ViewBag.FolderId as int?;
    var projectId = ViewBag.ProjectId as int?;
    var folderImagesCount = ViewBag.FolderImagesCount as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="gallery-container-wrapper">
    <!-- Sidebar for Folders -->
    <div class="folders-sidebar">
        <div class="sidebar-header">
            <h3>
                <i class="bi bi-folder-fill"></i>
                پوشه‌ها
            </h3>
            <a asp-action="Create" asp-controller="ProjectImageGalleryFolders" asp-route-projectId="@projectId" class="btn-add-folder" title="ایجاد پوشه جدید">
                <i class="bi bi-plus-lg"></i>
            </a>
        </div>
        
        <div class="folders-list">
            <!-- Root Level - All Images -->
            <a href="/ProjectImageGalleries/Index?projectId=@projectId" class="folder-item @(!folderId.HasValue ? "active" : "")">
                <i class="bi bi-images"></i>
                <span>همه عکس‌ها</span>
            </a>

            <!-- Folders Tree -->
            @foreach (var folder in folders)
            {
                var isActive = folderId.HasValue && folder.Id == folderId.Value;
                var folderColor = folder.Color ?? "#3b82f6";
                
                <div class="folder-item-wrapper">
                    <div class="folder-item-with-actions">
                        <a href="/ProjectImageGalleries/Index?projectId=@projectId&folderId=@folder.Id" class="folder-item @(isActive ? "active" : "")" style="border-right: 3px solid @folderColor;">
                            <i class="bi bi-folder@(isActive ? "-fill" : "")" style="color: @folderColor;"></i>
                            <span>@folder.Name</span>
                            <span class="folder-count">@(folderImagesCount.ContainsKey(folder.Id) ? folderImagesCount[folder.Id] : 0)</span>
                        </a>
                        <div class="folder-actions" onclick="event.stopPropagation();">
                            <a href="/ProjectImageGalleryFolders/Edit?id=@folder.Id" class="folder-action-btn" title="ویرایش پوشه">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="folder-action-btn folder-action-danger btn-delete-folder" title="حذف پوشه" data-folder-id="@folder.Id" data-folder-name="@folder.Name" data-bs-toggle="modal" data-bs-target="#deleteFolderModal">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Content -->
    <div class="gallery-content">
        <!-- Header Section -->
        <div class="gallery-header">
            <div class="header-content">
                <div class="breadcrumb-nav">
                    @if (currentFolder != null)
                    {
                        <a href="/Projects/Details/@projectId" class="breadcrumb-item" title="بازگشت به پروژه">
                            <i class="bi bi-folder2"></i>
                            @ViewBag.ProjectName
                        </a>
                        <span class="breadcrumb-separator">/</span>
                        <a href="/ProjectImageGalleries/Index?projectId=@projectId" class="breadcrumb-item" title="همه عکس‌های پروژه">
                            <i class="bi bi-house"></i>
                            همه عکس‌ها
                        </a>
                        @foreach (var parentFolder in breadcrumbFolders)
                        {
                            var parentColor = parentFolder.Color ?? "#3b82f6";
                            <span class="breadcrumb-separator">/</span>
                            <a href="/ProjectImageGalleries/Index?projectId=@projectId&folderId=@parentFolder.Id" class="breadcrumb-item" title="بازگشت به پوشه @parentFolder.Name">
                                <i class="bi bi-folder-fill" style="color: @parentColor;"></i>
                                @parentFolder.Name
                            </a>
                        }
                        <span class="breadcrumb-separator">/</span>
                        <span class="breadcrumb-current">
                            <i class="bi bi-folder-fill" style="color: @(currentFolder.Color ?? "#3b82f6");"></i>
                            @currentFolder.Name
                        </span>
                    }
                    else
                    {
                        <a href="/Projects/Details/@projectId" class="breadcrumb-item" title="بازگشت به پروژه">
                            <i class="bi bi-folder2"></i>
                            @ViewBag.ProjectName
                        </a>
                        <span class="breadcrumb-separator">/</span>
                        <span class="breadcrumb-current">
                            <i class="bi bi-images"></i>
                            همه عکس‌ها
                        </span>
                    }
                </div>
                <p class="gallery-subtitle">عکس‌ها و تصاویر مربوط به این پروژه</p>
            </div>
            <div class="header-actions">
                <a class="btn-create-folder" asp-action="Create" asp-controller="ProjectImageGalleryFolders" asp-route-projectId="@projectId" asp-route-parentFolderId="@folderId">
                    <i class="bi bi-folder-plus"></i>
                    <span>پوشه جدید</span>
                </a>
                <a class="btn-figma-design" href="/ProjectImageGalleries/UploadFigmaDesign?projectId=@projectId&folderId=@folderId">
                    <i class="bi bi-file-earmark-zip"></i>
                    <span>آپلود طراحی</span>
                </a>
                <a class="btn-view-figma" href="/ProjectImageGalleries/ViewFigmaDesign?projectId=@projectId@(folderId.HasValue ? "&folderId=" + folderId : "")">
                    <i class="bi bi-palette-fill"></i>
                    <span>نمایش طراحی</span>
                </a>
                <button type="button" class="btn-create-image" data-bs-toggle="modal" data-bs-target="#createImageModal" id="btnOpenCreateModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>افزودن عکس</span>
                </button>
                <a class="btn-back-project" href="/Projects/Details/@projectId">
                    <i class="bi bi-arrow-right"></i>
                    <span>بازگشت به پروژه</span>
                </a>
            </div>
        </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-gallery" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-gallery" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]
        </div>
    }

        @if (Model.Any())
        {
            <!-- نوار انتخاب دسته‌ای -->
            <div class="bulk-actions-bar mb-3" id="bulkActionsBar" style="display: none;">
                <label class="bulk-select-all d-flex align-items-center gap-2">
                    <input type="checkbox" id="selectAllGalleryImages" class="form-check-input" />
                    <span>انتخاب همه</span>
                </label>
                <span class="bulk-selected-count" id="bulkSelectedCount"></span>
                <button type="button" class="btn btn-danger btn-sm" id="btnBulkDelete" data-bs-toggle="modal" data-bs-target="#deleteBatchImageModal" title="حذف انتخاب‌شده‌ها">
                    <i class="bi bi-trash"></i>
                    حذف انتخاب‌شده‌ها
                </button>
            </div>
            <!-- Image Gallery Grid -->
            <div class="image-gallery-grid">
                @foreach (var image in Model.OrderByDescending(img => img.CreatedAt))
                {
                    <div class="gallery-item" data-image-id="@image.Id" onclick="window.location.href='/ProjectImageGalleries/Details?id=@image.Id'">
                        <div class="gallery-item-checkbox-wrap" onclick="event.stopPropagation();">
                            <input type="checkbox" class="form-check-input gallery-item-checkbox" value="@image.Id" name="ids" />
                        </div>
                        <div class="gallery-item-image">
                            <img src="@image.FilePath" alt="@image.Title" loading="lazy" />
                            <div class="gallery-item-overlay">
                                <div class="gallery-item-title">@image.Title</div>
                                @if (!string.IsNullOrEmpty(image.Description))
                                {
                                    <div class="gallery-item-description">@image.Description</div>
                                }
                            </div>
                        </div>
                        <div class="gallery-item-actions" onclick="event.stopPropagation();">
                            <a href="/ProjectImageGalleries/Edit?id=@image.Id" class="gallery-action-btn" title="ویرایش">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="gallery-action-btn gallery-action-danger btn-delete-image" title="حذف" data-image-id="@image.Id" data-bs-toggle="modal" data-bs-target="#deleteImageModal">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-image"></i>
                </div>
                <h3>هنوز عکسی در این گالری وجود ندارد</h3>
                <p>با افزودن اولین عکس خود شروع کنید</p>
                <button type="button" class="btn-create-image" data-bs-toggle="modal" data-bs-target="#createImageModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>افزودن اولین عکس</span>
                </button>
            </div>
        }
    </div>
</div>

<!-- مودال افزودن عکس -->
<div class="modal fade" id="createImageModal" tabindex="-1" aria-labelledby="createImageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createImageModalLabel">
                    <i class="bi bi-image"></i>
                    افزودن عکس به گالری
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <form id="createImageForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProjectId" id="createModalProjectId" value="@projectId" />
                <input type="hidden" name="FolderId" id="createModalFolderId" value="@(folderId?.ToString() ?? "")" />
                <div class="modal-body">
                    <div id="createImageError" class="alert alert-danger d-none" role="alert"></div>
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-upload"></i>
                            فایل‌های عکس <span class="text-danger">*</span>
                        </label>
                        <div class="file-upload-area border rounded p-4 text-center" style="background: #f8f9fa; cursor: pointer;" onclick="document.getElementById('createModalImageFiles').click();">
                            <i class="bi bi-cloud-upload" style="font-size: 2rem; color: #6c757d;"></i>
                            <p class="mt-2 mb-0">برای انتخاب عکس‌ها کلیک کنید</p>
                            <small class="text-muted">می‌توانید چند عکس را همزمان انتخاب کنید</small>
                        </div>
                        <input type="file" name="ImageFiles" id="createModalImageFiles" class="form-control d-none" accept="image/*" multiple />
                        <div id="createModalFilePreview" class="mt-3"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-primary" id="createImageSubmitBtn">
                        <i class="bi bi-check-lg"></i>
                        افزودن عکس
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- مودال تأیید حذف عکس -->
<div class="modal fade" id="deleteImageModal" tabindex="-1" aria-labelledby="deleteImageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteImageModalLabel">
                    <i class="bi bi-trash text-danger"></i>
                    حذف عکس
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <form id="deleteImageForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteImageId" value="" />
                <div class="modal-body">
                    <p class="mb-0">آیا از حذف این عکس اطمینان دارید؟</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger" id="deleteImageSubmitBtn">
                        <i class="bi bi-trash"></i>
                        حذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- مودال تأیید حذف پوشه -->
<div class="modal fade" id="deleteFolderModal" tabindex="-1" aria-labelledby="deleteFolderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteFolderModalLabel">
                    <i class="bi bi-trash text-danger"></i>
                    حذف پوشه
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <form id="deleteFolderForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteFolderId" value="" />
                <div class="modal-body">
                    <p class="mb-0" id="deleteFolderConfirmText">آیا از حذف این پوشه و تمام زیرپوشه‌های آن اطمینان دارید؟</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger" id="deleteFolderSubmitBtn">
                        <i class="bi bi-trash"></i>
                        حذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- مودال تأیید حذف دسته‌ای عکس‌ها -->
<div class="modal fade" id="deleteBatchImageModal" tabindex="-1" aria-labelledby="deleteBatchImageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteBatchImageModalLabel">
                    <i class="bi bi-trash text-danger"></i>
                    حذف دسته‌ای عکس‌ها
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <form id="deleteBatchImageForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="mb-0" id="deleteBatchConfirmText">آیا از حذف عکس‌های انتخاب‌شده اطمینان دارید؟</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger" id="deleteBatchImageSubmitBtn">
                        <i class="bi bi-trash"></i>
                        حذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    const deleteImageUrl = '@Url.Action("Delete", "ProjectImageGalleries")';
    const deleteBatchImageUrl = '@Url.Action("DeleteBatch", "ProjectImageGalleries")';
    const createImageUrl = '@Url.Action("Create", "ProjectImageGalleries")';
    const deleteFolderUrl = '@Url.Action("Delete", "ProjectImageGalleryFolders")';
    const galleryIndexUrl = '@Url.Action("Index", "ProjectImageGalleries")';

    const createImageModal = document.getElementById('createImageModal');
    const createImageForm = document.getElementById('createImageForm');
    const createImageError = document.getElementById('createImageError');
    const createModalImageFiles = document.getElementById('createModalImageFiles');
    const createModalFilePreview = document.getElementById('createModalFilePreview');
    const createImageSubmitBtn = document.getElementById('createImageSubmitBtn');

    const deleteImageModal = document.getElementById('deleteImageModal');
    const deleteImageForm = document.getElementById('deleteImageForm');
    const deleteImageId = document.getElementById('deleteImageId');

    const deleteFolderModal = document.getElementById('deleteFolderModal');
    const deleteFolderForm = document.getElementById('deleteFolderForm');
    const deleteFolderId = document.getElementById('deleteFolderId');

    if (deleteFolderModal) {
        deleteFolderModal.addEventListener('shown.bs.modal', function(e) {
            const trigger = e.relatedTarget;
            if (trigger && trigger.getAttribute('data-folder-id')) {
                deleteFolderId.value = trigger.getAttribute('data-folder-id');
                const nameEl = document.getElementById('deleteFolderConfirmText');
                if (nameEl) nameEl.textContent = 'آیا از حذف پوشه «' + (trigger.getAttribute('data-folder-name') || '') + '» و تمام زیرپوشه‌های آن اطمینان دارید؟';
            }
        });
    }

    if (deleteFolderForm) {
        deleteFolderForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const id = deleteFolderId.value;
            if (!id) return;
            const formData = new FormData(deleteFolderForm);
            const btn = document.getElementById('deleteFolderSubmitBtn');
            btn.disabled = true;
            fetch(deleteFolderUrl, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.text().then(function(t) { return { ok: r.ok, status: r.status, text: t }; }); })
            .then(function(o) {
                var data;
                try { data = JSON.parse(o.text); } catch(_) {
                    data = { success: false, message: o.status === 400 ? 'درخواست نامعتبر. لطفاً صفحه را یک‌بار رفرش کنید و دوباره تلاش کنید.' : 'خطا در سرور (کد: ' + o.status + ')' };
                }
                if (!data.success && !data.message) data.message = 'خطا در حذف پوشه';
                if (data.success) {
                    const bsModal = bootstrap.Modal.getInstance(deleteFolderModal);
                    if (bsModal) bsModal.hide();
                    window.location.href = galleryIndexUrl + '?projectId=' + data.projectId + (data.parentFolderId ? '&folderId=' + data.parentFolderId : '');
                } else {
                    alert(data.message);
                }
            })
            .catch(function() { alert('خطا در ارتباط با سرور. اتصال اینترنت یا سرور را بررسی کنید.'); })
            .finally(function() { btn.disabled = false; });
        });
    }

    if (deleteImageModal) {
        deleteImageModal.addEventListener('shown.bs.modal', function(e) {
            const trigger = e.relatedTarget;
            if (trigger && trigger.getAttribute('data-image-id')) {
                deleteImageId.value = trigger.getAttribute('data-image-id');
            }
        });
    }

    if (deleteImageForm) {
        deleteImageForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const id = deleteImageId.value;
            if (!id) return;
            const formData = new FormData(deleteImageForm);
            const btn = document.getElementById('deleteImageSubmitBtn');
            btn.disabled = true;
            fetch(deleteImageUrl, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.text().then(function(t) { return { ok: r.ok, status: r.status, text: t }; }); })
            .then(function(o) {
                var data;
                try { data = JSON.parse(o.text); } catch(_) {
                    data = { success: false, message: o.status === 400 ? 'درخواست نامعتبر. لطفاً صفحه را یک‌بار رفرش کنید و دوباره تلاش کنید.' : 'خطا در سرور (کد: ' + o.status + ')' };
                }
                if (!data.success && !data.message) data.message = 'خطا در حذف عکس';
                if (data.success) {
                    const item = document.querySelector('.gallery-item[data-image-id="' + id + '"]');
                    if (item) item.remove();
                    const bsModal = bootstrap.Modal.getInstance(deleteImageModal);
                    if (bsModal) bsModal.hide();
                } else {
                    alert(data.message);
                }
            })
            .catch(function() { alert('خطا در ارتباط با سرور. اتصال اینترنت یا سرور را بررسی کنید.'); })
            .finally(function() { btn.disabled = false; });
        });
    }

    // حذف دسته‌ای
    const bulkActionsBar = document.getElementById('bulkActionsBar');
    const selectAllGalleryImages = document.getElementById('selectAllGalleryImages');
    const bulkSelectedCount = document.getElementById('bulkSelectedCount');
    const deleteBatchImageForm = document.getElementById('deleteBatchImageForm');
    const deleteBatchImageModal = document.getElementById('deleteBatchImageModal');
    const deleteBatchConfirmText = document.getElementById('deleteBatchConfirmText');

    function updateBulkUI() {
        const checkboxes = document.querySelectorAll('.gallery-item-checkbox');
        const checked = document.querySelectorAll('.gallery-item-checkbox:checked');
        if (!bulkActionsBar || !checkboxes.length) return;
        if (checked.length > 0) {
            bulkActionsBar.style.display = 'flex';
            bulkSelectedCount.textContent = checked.length + ' عکس انتخاب شده';
            if (selectAllGalleryImages) selectAllGalleryImages.checked = checked.length === checkboxes.length;
        } else {
            bulkActionsBar.style.display = 'none';
            if (selectAllGalleryImages) selectAllGalleryImages.checked = false;
        }
    }

    document.querySelectorAll('.gallery-item-checkbox').forEach(function(cb) {
        cb.addEventListener('click', function(e) { e.stopPropagation(); });
        cb.addEventListener('change', updateBulkUI);
    });
    if (selectAllGalleryImages) {
        selectAllGalleryImages.addEventListener('change', function() {
            document.querySelectorAll('.gallery-item-checkbox').forEach(function(cb) { cb.checked = selectAllGalleryImages.checked; });
            updateBulkUI();
        });
    }
    if (deleteBatchImageModal) {
        deleteBatchImageModal.addEventListener('shown.bs.modal', function() {
            const n = document.querySelectorAll('.gallery-item-checkbox:checked').length;
            if (deleteBatchConfirmText) deleteBatchConfirmText.textContent = n === 1 ? 'آیا از حذف این عکس اطمینان دارید؟' : 'آیا از حذف ' + n + ' عکس انتخاب‌شده اطمینان دارید؟';
        });
    }
    if (deleteBatchImageForm) {
        deleteBatchImageForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const checked = document.querySelectorAll('.gallery-item-checkbox:checked');
            if (!checked.length) return;
            const formData = new FormData(deleteBatchImageForm);
            checked.forEach(function(cb) { formData.append('ids', cb.value); });
            const btn = document.getElementById('deleteBatchImageSubmitBtn');
            btn.disabled = true;
            fetch(deleteBatchImageUrl, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.text().then(function(t) { return { ok: r.ok, status: r.status, text: t }; }); })
            .then(function(o) {
                var data;
                try { data = JSON.parse(o.text); } catch(_) {
                    data = { success: false, message: o.status === 400 ? 'درخواست نامعتبر.' : 'خطا در سرور (کد: ' + o.status + ')' };
                }
                if (data.success) {
                    checked.forEach(function(cb) {
                        const item = document.querySelector('.gallery-item[data-image-id="' + cb.value + '"]');
                        if (item) item.remove();
                    });
                    const bsModal = bootstrap.Modal.getInstance(deleteBatchImageModal);
                    if (bsModal) bsModal.hide();
                    updateBulkUI();
                    alert(data.message);
                    if (document.querySelectorAll('.gallery-item').length === 0)
                        window.location.reload();
                } else {
                    alert(data.message || 'خطا در حذف دسته‌ای عکس‌ها.');
                }
            })
            .catch(function() { alert('خطا در ارتباط با سرور.'); })
            .finally(function() { btn.disabled = false; });
        });
    }

    if (createModalImageFiles) {
        createModalImageFiles.addEventListener('change', function() {
            createModalFilePreview.innerHTML = '';
            const files = this.files;
            if (files.length === 0) return;
            const row = document.createElement('div');
            row.className = 'row g-2';
            for (let i = 0; i < files.length; i++) {
                if (!files[i].type.startsWith('image/')) continue;
                const col = document.createElement('div');
                col.className = 'col-4';
                col.innerHTML = '<img src="' + URL.createObjectURL(files[i]) + '" class="img-fluid rounded" style="height:80px;object-fit:cover" alt="" />';
                row.appendChild(col);
            }
            createModalFilePreview.appendChild(row);
        });
    }

    if (createImageModal) {
        createImageModal.addEventListener('hidden.bs.modal', function() {
            createImageForm.reset();
            createModalFilePreview.innerHTML = '';
            createImageError.classList.add('d-none');
        });
    }

    if (createImageForm) {
        createImageForm.addEventListener('submit', function(e) {
            e.preventDefault();
            if (!createModalImageFiles.files || createModalImageFiles.files.length === 0) {
                createImageError.textContent = 'لطفاً حداقل یک عکس انتخاب کنید.';
                createImageError.classList.remove('d-none');
                return;
            }
            createImageError.classList.add('d-none');
            const formData = new FormData(createImageForm);
            createImageSubmitBtn.disabled = true;
            fetch(createImageUrl, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.text().then(function(t) { return { ok: r.ok, status: r.status, text: t }; }); })
            .then(function(o) {
                var data;
                try { data = JSON.parse(o.text); } catch(_) {
                    data = { success: false, message: o.status === 400 ? 'درخواست نامعتبر. صفحه را رفرش کنید و دوباره تلاش کنید.' : 'خطا در سرور (کد: ' + o.status + ')' };
                }
                if (data.success) {
                    const bsModal = bootstrap.Modal.getInstance(createImageModal);
                    if (bsModal) bsModal.hide();
                    window.location.reload();
                } else {
                    createImageError.textContent = data.message || (data.errors && data.errors.join('\n')) || 'خطا در افزودن عکس';
                    createImageError.classList.remove('d-none');
                }
            })
            .catch(function() { createImageError.textContent = 'خطا در ارتباط با سرور. اتصال اینترنت یا سرور را بررسی کنید.'; createImageError.classList.remove('d-none'); })
            .finally(function() { createImageSubmitBtn.disabled = false; });
        });
    }
})();
</script>
}

