@model IReadOnlyList<TaskPlanner.Application.Services.LeaveService.LeaveCalendarDayDto>
@using DNTPersianUtils.Core
@{
    ViewData["Title"] = "تقویم مرخصی";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
    var startOfWeek = (DateTime)ViewBag.StartOfWeek;
    var endOfWeek = (DateTime)ViewBag.EndOfWeek;
    var offset = (int)ViewBag.Offset;
    var weekDays = new[] { "شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنج‌شنبه", "جمعه" };
}

<style>
    .leave-week-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 12px; }
    .leave-day-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        min-height: 140px;
        padding: 10px;
    }
    .leave-day-card.is-today { border-color: #6366f1; box-shadow: 0 0 0 1px #6366f1; }
    .leave-day-title { font-weight: 700; font-size: 0.9rem; margin-bottom: 8px; color: #374151; }
    .leave-item {
        font-size: 0.78rem;
        padding: 4px 8px;
        border-radius: 8px;
        margin-bottom: 6px;
        color: #fff;
        line-height: 1.3;
    }
    @@media (max-width: 992px) {
        .leave-week-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 576px) {
        .leave-week-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-calendar3 me-2"></i>تقویم مرخصی‌های ثبت‌شده توسط من</h2>
            <div class="text-muted">@startOfWeek.ToShortPersianDateString().ToPersianNumbers() — @endOfWeek.ToShortPersianDateString().ToPersianNumbers()</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="@Url.Action("Calendar", new { offset = offset - 1 })"><i class="bi bi-chevron-right"></i></a>
            <a class="btn btn-outline-secondary" href="@Url.Action("Calendar")">این هفته</a>
            <a class="btn btn-outline-secondary" href="@Url.Action("Calendar", new { offset = offset + 1 })"><i class="bi bi-chevron-left"></i></a>
            <a class="btn btn-outline-primary" href="@Url.Action("Index")">لیست</a>
        </div>
    </div>

    <div class="leave-week-grid">
        @for (var i = 0; i < Model.Count; i++)
        {
            var day = Model[i];
            var isToday = day.Date == DateTime.Today;
            <div class="leave-day-card @(isToday ? "is-today" : "")">
                <div class="leave-day-title">
                    @weekDays[i]
                    <span class="text-muted">@day.Date.ToShortPersianDateString().ToPersianNumbers()</span>
                </div>
                @if (day.Items.Any())
                {
                    foreach (var item in day.Items)
                    {
                        <div class="leave-item" style="background:@item.LeaveTypeColor">
                            <div class="fw-semibold">@item.ColleagueName</div>
                            <div>@item.LeaveTypeName</div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted small">—</div>
                }
            </div>
        }
    </div>
</div>
