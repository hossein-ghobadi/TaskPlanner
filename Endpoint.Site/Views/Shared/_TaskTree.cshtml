@using DNTPersianUtils.Core

  @model TaskPlanner.Domain.Entities.TaskPlanner.TaskItem

<li>
    <div class="d-flex justify-content-between align-items-center">
        <span>
            <strong>@Model.Title</strong>
            <small class="text-muted">(@Model.Category?.Name)</small>
        </span>
        <span>
            <a class="btn btn-sm btn-warning"
               asp-controller="Tasks"
               asp-action="Edit"
               asp-route-id="@Model.Id">
                <i class="bi bi-pencil me-1"></i>
                ویرایش
            </a>
            <a class="btn btn-sm btn-danger"
               asp-controller="Tasks"
               asp-action="Delete"
               asp-route-id="@Model.Id">
                <i class="bi bi-trash me-1"></i>
                حذف
            </a>
            <a class="btn btn-sm btn-info"
               asp-controller="Tasks"
               asp-action="Details"
               asp-route-id="@Model.Id">
                <i class="bi bi-chat-dots me-1"></i>
                گفتگو
            </a>
        </span>
    </div>

    @if (Model.ChildIssues?.Any() == true)
    {
        <ul class="ms-4 list-unstyled">
            @foreach (var sub in Model.ChildIssues)
            {
                @Html.Partial("_TaskTree", sub)
            }
        </ul>
    }
</li>
