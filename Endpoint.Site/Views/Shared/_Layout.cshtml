@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using Endpoint.Site.Helpers
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var useFluidLayout = (ViewData["UseFluidLayout"] as bool?) ?? false;
    ViewBag.AntiforgeryToken = antiforgeryToken;
    var layoutProjectId = ProjectSidebarResolver.ResolveProjectId(ViewContext);
    var appMainBodyClass = useFluidLayout
        ? "px-1 px-md-2 py-2"
        : (layoutProjectId.HasValue
            ? "container-fluid px-3 px-md-4 px-xl-5 mt-3 mt-md-4"
            : "container mt-3 mt-md-4");
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectMannaging</title>

    @* فونت Vazir *@
    <link rel="stylesheet" href="~/lib/vazir-font/dist/font-face.css" asp-append-version="true" />

    @* Bootstrap RTL + Icons *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" />

    @*
        استایل‌های اصلی پروژه (bundle)
        شامل: site.css + app-shell.css + project-sidebar.css
        برای رِبیلد: pwsh ./build-css-bundle.ps1
    *@
    <link rel="stylesheet" href="~/css/app-bundle.css" asp-append-version="true" />

    @*
        Persian Datepicker و ChatBox از layout حذف شده‌اند:
        - Persian Datepicker → فقط در صفحاتی که فرم تاریخ دارند (از طریق Partial _DatePickerAssets)
        - ChatBox/SignalR → فقط در صفحاتی که چت دارند (از طریق Partial _ChatAssets)
    *@
    <style>
        body {
            background-color: #f8f9fa;
        }

        /* نوار بالا */
        .navbar-dark {
            background-color: #1f2327 !important;
        }

        .navbar-dark .navbar-brand {
                color: #ffffff !important;
                font-weight: bold;
            }

            .navbar-dark .nav-link {
                color: #d1d5db !important;
                font-size: 0.9rem;
                transition: color 0.2s ease;
            }

                .navbar-dark .nav-link:hover {
                    color: #ffffff !important;
                }

        /* بخش خوش‌آمد و دکمه‌ها */
        .user-info {
            color: #9ca3af;
            font-size: 0.85rem;
        }

            .user-info span {
                color: #a5b4fc;
                font-weight: 500;
            }

        .btn-logout {
            color: #fca5a5;
            border: 1px solid rgba(244, 63, 94, 0.6);
            background: transparent;
            border-radius: 8px;
            padding: 4px 12px;
            font-size: 0.8rem;
            transition: all 0.2s ease-in-out;
        }

            .btn-logout:hover {
                background: rgba(244, 63, 94, 0.25);
                color: #fff;
            }

        .btn-login {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 4px 12px;
            font-size: 0.8rem;
            transition: all 0.2s ease-in-out;
            font-weight: 500;
        }

            .btn-login:hover {
                background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
                transform: translateY(-1px);
                box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
            }

        .btn-register {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            padding: 4px 12px;
            font-size: 0.8rem;
            transition: all 0.2s ease-in-out;
            font-weight: 500;
        }

            .btn-register:hover {
                background: rgba(255, 255, 255, 0.2);
                border-color: rgba(255, 255, 255, 0.3);
                color: #fff;
            }

        .navbar-notification-btn {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease-in-out;
        }

        .navbar-notification-btn:hover,
        .navbar-notification-btn:focus {
            background: rgba(255, 255, 255, 0.16);
            outline: none;
        }

        .navbar-notification-btn i {
            font-size: 1.2rem;
        }

        

        .notification-menu {
            width: 260px !important;
            inset: auto !important;
        }

        /* جلوگیری از بهم‌ریختگی badge */
        #notificationBadge {
            transform: translate(-50%, -50%) !important;
        }

        .notification-menu-header {
            background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
            color: #fff;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .notification-menu-header h6 {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .btn-notification-refresh {
            background: rgba(255, 255, 255, 0.18);
            border: none;
            color: #fff;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s ease;
        }

        .btn-notification-refresh:hover {
            transform: rotate(-90deg);
        }

        .notification-list {
            max-height: 340px;
            overflow-y: auto;
        }

        .notification-item {
            border: none;
            border-bottom: 1px solid #f1f5f9;
            padding: 14px 18px;
            background: #fff;
            transition: background-color 0.2s ease-in-out, transform 0.15s ease;
        }

        .notification-item:last-child {
            border-bottom: none;
        }

        .notification-item:hover {
            background-color: #f8fafc;
            transform: translateX(-2px);
        }

        .notification-item-unread {
            background: linear-gradient(135deg, #eff6ff 0%, #eef2ff 100%);
        }

        .notification-item-title {
            font-weight: 600;
            color: #1f2937;
            font-size: 0.95rem;
        }

        .notification-item-message {
            color: #6b7280;
            font-size: 0.85rem;
            margin-top: 4px;
        }

        .notification-item-time {
            color: #94a3b8;
            font-size: 0.75rem;
            margin-top: 8px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .notification-empty {
            padding: 42px 20px;
            color: #94a3b8;
            text-align: center;
            font-size: 0.9rem;
        }

        .notification-empty i {
            font-size: 1.8rem;
            display: block;
            margin-bottom: 12px;
            color: #cbd5f5;
        }

        .notification-footer {
            background: #f8fafc;
            padding: 12px 16px;
        }

        .notification-footer button {
            border-radius: 12px;
            font-size: 0.85rem;
            padding: 10px;
            border: 1px solid #dbeafe;
            background: #fff;
            color: #3b82f6;
            transition: all 0.2s ease;
        }

        .notification-footer button:hover {
            background: #eff6ff;
        }
    </style>
</head>
<body data-antiforgery-token="@antiforgeryToken">
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <div class="app-mobile-topbar d-lg-none">
            <button type="button" class="app-mobile-menu-btn" id="mobileSidebarToggle" aria-label="باز کردن منو">
                <i class="bi bi-list"></i>
            </button>
            @*<span class="app-mobile-brand">Task Planner</span>*@
        </div>
        <div class="app-mobile-backdrop d-lg-none" id="mobileSidebarBackdrop"></div>
        <div class="app-global-notification d-none">
            <button type="button" class="app-global-notification-btn position-relative"
                    id="notificationBell" aria-expanded="false" aria-controls="notificationPanel">
                <i class="bi bi-bell"></i>
                <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-danger d-none"
                      id="notificationBadge">0</span>
            </button>
            <div id="notificationPanel" class="app-notification-panel" role="dialog" aria-label="اعلان‌ها">
                <div class="notification-menu-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="bg-white bg-opacity-20 rounded-circle d-inline-flex align-items-center justify-content-center"
                              style="width:28px;height:28px;">
                            <i class="bi bi-bell-fill"></i>
                        </span>
                        <h6 class="mb-0">اعلان‌ها</h6>
                    </div>
                    <button class="btn-notification-refresh" id="refreshNotificationsBtn" type="button">
                        <i class="bi bi-arrow-repeat"></i>
                    </button>
                </div>
                <div id="notificationList" class="notification-list">
                    <div class="notification-empty" id="notificationEmpty">
                        <i class="bi bi-bell-slash"></i>
                        در حال بارگذاری...
                    </div>
                </div>
                <div class="notification-footer">
                    <form id="markAllNotificationsForm" class="d-grid gap-1">
                        <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken" />
                        <button class="btn btn-light" type="submit">علامت‌گذاری همه</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="app-notification-backdrop d-none" id="notificationBackdrop"></div>

        <div class="app-shell">
            @await Html.PartialAsync("_AppSidebar")
            <div class="app-main">
                <main class="app-main-body @appMainBodyClass">
                    @if (layoutProjectId.HasValue)
                    {
                        <div class="row g-3 g-lg-4 project-details-shell align-items-start">
                            <aside class="col-12 col-lg-4 col-xl-3 project-sidebar-col" aria-label="ناوبری پروژه">
                                @await Component.InvokeAsync("ProjectSidebar", new { projectId = layoutProjectId.Value })
                            </aside>
                            <div class="col-12 col-lg-8 col-xl-9 project-details-main">
                                @RenderBody()
                            </div>
                        </div>
                    }
                    else
                    {
                        @RenderBody()
                    }
                </main>
                
            </div>
        </div>
    }
    else
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                @*<a class="navbar-brand d-flex align-items-center" href="/">
                    <i class="bi bi-grid-3x3-gap-fill me-2"></i>
                    Task Planner
                </a>*@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <div class="d-flex align-items-center gap-3">
                        <a class="btn-login" href="/login">ورود</a>
                        <a class="btn-register ms-2" href="/register">ثبت‌نام</a>
                    </div>
                </div>
            </div>
        </nav>

        <main class="@(useFluidLayout ? "container-fluid px-2 px-md-3 px-xl-4 mt-3" : "container mt-4")">
            @RenderBody()
        </main>

        <footer class="text-center p-4 mt-5" style="background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%); border-top: 1px solid #e5e7eb;">
            
        </footer>
    }

    @*
        jQuery بدون defer است تا اسکریپت‌های inline در @@RenderSection("Scripts") بعد از لود jQuery اجرا شوند.
        (با defer، ترتیب واقعی می‌شود: ابتدا کل @@section Scripts، سپس اسکریپت‌های defer → $ تعریف نشده و خطا می‌دهد.)
        Bootstrap با defer می‌ماند؛ بعد از jQuery blocking و @@section Scripts، با سایر deferها به ترتیب اجرا می‌شود.
    *@
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true" defer></script>
    @*
        persian-date و persian-datepicker از layout حذف شده‌اند.
        صفحاتی که نیاز دارند، در داخل @@section Scripts خود این Partial را include می‌کنند:
            @@await Html.PartialAsync("_DatePickerAssets")
    *@

    @if (User?.Identity?.IsAuthenticated == true)
    {
        @* اسکریپت اعلان‌ها به فایل خارجی منتقل شده تا cache طولانی‌مدت بشود *@
        <script src="~/js/notifications.js" asp-append-version="true" defer></script>
        <script src="~/js/app-sidebar.js" asp-append-version="true" defer></script>
    }


    @RenderSection("Scripts", required: false)
</body>
</html>
