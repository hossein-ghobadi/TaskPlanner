@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Task Planner</title>

    <!-- فونت Vazir -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vazir-font@30.1.0/dist/font-face.css" />

    <!-- Bootstrap RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Persian Datepicker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/css/persian-datepicker.min.css" />

    <!-- استایل‌های اصلی پروژه -->
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            background-color: #f8f9fa;
        }

        /* نوار بالا */
        .navbar-dark {
            background-color: #1f2327 !important;
        }

            .navbar-dark .navbar-brand {
                color: #ffffff !important;
                font-weight: bold;
            }

            .navbar-dark .nav-link {
                color: #d1d5db !important;
                font-size: 0.9rem;
                transition: color 0.2s ease;
            }

                .navbar-dark .nav-link:hover {
                    color: #ffffff !important;
                }

        /* بخش خوش‌آمد و دکمه‌ها */
        .user-info {
            color: #9ca3af;
            font-size: 0.85rem;
        }

            .user-info span {
                color: #a5b4fc;
                font-weight: 500;
            }

        .btn-logout {
            color: #fca5a5;
            border: 1px solid rgba(244, 63, 94, 0.6);
            background: transparent;
            border-radius: 8px;
            padding: 4px 12px;
            font-size: 0.8rem;
            transition: all 0.2s ease-in-out;
        }

            .btn-logout:hover {
                background: rgba(244, 63, 94, 0.25);
                color: #fff;
            }

        .btn-login {
            background-color: #6366f1;
            color: #fff;
            border-radius: 8px;
            padding: 4px 12px;
            font-size: 0.8rem;
            transition: background-color 0.2s ease-in-out;
        }

            .btn-login:hover {
                background-color: #4f46e5;
            }
    </style>
</head>
<body>
    <!-- 🔹 نوار ناوبری -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Projects/Index">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i>
                داشبورد
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <div class="d-flex align-items-center gap-2">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <div class="user-info">
                            سلام، <span>@User.Identity.Name</span>
                        </div>
                        <form method="post" action="/account/logout" class="m-0">
                            <input name="__RequestVerificationToken" type="hidden"
                                   value="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
                            <button class="btn-logout" type="submit">خروج</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn-login text-decoration-none" href="/login">ورود</a>
                        <a class="btn btn-outline-light text-decoration-none ms-2" href="/register" style="padding: 4px 12px; border-radius: 8px; font-size: 0.8rem;">ثبت نام</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- 🔸 محتوای اصلی -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- 🔹 فوتر -->
    <footer class="bg-light text-center p-3 mt-4 border-top">
        <p class="mb-0 text-muted">© 2025 - Task Planner</p>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/persian-date@1.1.0/dist/persian-date.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/js/persian-datepicker.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
