@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/designs-fonts.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/designs.css" asp-append-version="true" />

<div class="design-page">
    <header class="design-toolbar">
        <div class="design-toolbar-brand">
            <span class="design-toolbar-mark" aria-hidden="true"><i class="bi bi-vector-pen"></i></span>
            <div>
                <h1>طراحی</h1>
                <p>متن، منحنی و خروجی SVG</p>
            </div>
        </div>

        <div class="design-toolbar-groups">
            <div class="design-tool-group" role="group" aria-label="افزودن">
                <button class="design-tool-btn is-accent" type="button" id="addTextBoxBtn" title="افزودن تکست باکس">
                    <i class="bi bi-plus-lg"></i>
                    <span>متن</span>
                </button>
                <button class="design-tool-btn" type="button" id="uploadSvgBtn" title="آپلود SVG">
                    <i class="bi bi-upload"></i>
                    <span>SVG</span>
                </button>
                <input id="designSvgFile" class="d-none" type="file" accept=".svg,image/svg+xml" />
            </div>

            <div class="design-tool-group" role="group" aria-label="ابزار بوم">
                <button class="design-tool-btn" type="button" id="measureToolBtn" aria-pressed="false" title="اندازه‌گیری فاصله بین دو نقطه">
                    <i class="bi bi-rulers"></i>
                    <span>اندازه</span>
                </button>
                <button class="design-tool-btn d-none" type="button" id="clearMeasureBtn" title="پاک کردن اندازه‌گیری">
                    <i class="bi bi-eraser"></i>
                    <span>پاک اندازه</span>
                </button>
            </div>

            <div class="design-tool-group" role="group" aria-label="ویرایش">
                <button class="design-tool-btn is-danger" type="button" id="deleteTextBoxBtn" disabled title="حذف انتخاب‌شده">
                    <i class="bi bi-trash"></i>
                    <span>حذف</span>
                </button>
                <button class="design-tool-btn" type="button" id="clearDesignBtn" title="پاکسازی همه">
                    <i class="bi bi-x-circle"></i>
                    <span>پاکسازی</span>
                </button>
            </div>

            <div class="design-tool-group design-tool-group-view" role="group" aria-label="نمایش">
                <label class="design-unit-field">
                    <span>واحد</span>
                    <select id="designUnitSelect" title="واحد اندازه‌گیری" aria-label="واحد اندازه‌گیری">
                        <option value="px">px</option>
                        <option value="mm">mm</option>
                        <option value="cm" selected>cm</option>
                        <option value="m">m</option>
                        <option value="in">in</option>
                    </select>
                </label>
                <div class="design-zoom-group" role="group" aria-label="زوم بوم">
                    <button type="button" id="zoomOutBtn" title="کوچک‌نمایی">−</button>
                    <button type="button" id="zoomResetBtn" title="بازگشت به ۱۰۰٪">
                        <span id="zoomLevelLabel">۱۰۰٪</span>
                    </button>
                    <button type="button" id="zoomInBtn" title="بزرگ‌نمایی">+</button>
                </div>
            </div>

            <div class="design-tool-group" role="group" aria-label="خروجی">
                <button class="design-tool-btn is-primary" type="button" id="exportSvgBtn" title="خروجی SVG">
                    <i class="bi bi-download"></i>
                    <span>خروجی</span>
                </button>
            </div>
        </div>
    </header>

    <div class="design-workspace">
        <aside class="design-panel">
            <section class="design-panel-section">
                <h2>لایه‌ها</h2>
                <div id="designBoxList" class="design-box-list" aria-label="فهرست آیتم‌های بوم"></div>
            </section>

            <section class="design-panel-section">
                <h2>ویژگی‌ها</h2>
                <div id="selectionHint" class="design-hint">یک لایه انتخاب کنید یا متن جدید بسازید.</div>

                <div id="designControls" class="design-controls is-disabled">
                    <div class="design-control-text">
                        <div class="design-field">
                            <label class="design-label" for="designFontSelect">فونت</label>
                            <select id="designFontSelect" class="design-select">
                                <option value="Vazir" selected>وزیر (Vazir)</option>
                                <option value="Vazirmatn">وزیرمتن (Vazirmatn)</option>
                                <option value="Samim">صمیم (Samim)</option>
                                <option value="Sahel">ساحل (Sahel)</option>
                                <option value="Tanha">تنها (Tanha)</option>
                                <option value="Tahoma">Tahoma</option>
                                <option value="Arial">Arial</option>
                                <option value="Georgia">Georgia</option>
                                <option value="Times New Roman">Times New Roman</option>
                                <option value="Courier New">Courier New</option>
                                <option value="Segoe UI">Segoe UI</option>
                            </select>
                        </div>

                        <div class="design-field">
                            <label class="design-label" for="designFontFile">فونت سفارشی</label>
                            <input id="designFontFile" class="design-file" type="file" accept=".ttf,.otf,.woff,.woff2,font/ttf,font/otf,font/woff,font/woff2" />
                            <p class="design-help">TTF، OTF یا WOFF را انتخاب کنید.</p>
                        </div>

                        <div class="design-field">
                            <div class="design-label-row">
                                <label class="design-label" for="designFontSizeInput">اندازه</label>
                                <span class="design-value" id="designFontSizeValue" aria-live="polite">48</span>
                            </div>
                            <input id="designFontSizeInput" class="design-range" type="range" min="12" max="240" step="1" value="48" />
                        </div>
                    </div>

                    <div class="design-control-paint">
                        <div class="design-field">
                            <label class="design-label" for="designFillColor">رنگ پر</label>
                            <input id="designFillColor" class="d-none" type="color" value="#111827" />
                            <div id="designFillSpectrum" class="design-spectrum" data-spectrum="fill" aria-label="طیف رنگ پر"></div>
                            <p class="design-help design-control-text">بخشی از متن را انتخاب کنید تا فقط همان بخش رنگ شود.</p>
                            <p class="design-help design-control-svg-only d-none">رنگ روی شکل انتخاب‌شده اعمال می‌شود.</p>
                        </div>

                        <div class="design-field">
                            <label class="design-label" for="designStrokeColor">رنگ حاشیه</label>
                            <input id="designStrokeColor" class="d-none" type="color" value="#111827" />
                            <div id="designStrokeSpectrum" class="design-spectrum" data-spectrum="stroke" aria-label="طیف رنگ حاشیه"></div>
                        </div>

                        <div class="design-field">
                            <div class="design-label-row">
                                <label class="design-label" for="designStrokeWidthInput">ضخامت حاشیه</label>
                                <span class="design-value" id="designStrokeWidthValue" aria-live="polite">0</span>
                            </div>
                            <input id="designStrokeWidthInput" class="design-range" type="range" min="0" max="12" step="0.5" value="0" />
                            <p class="design-help">حاشیه فقط دور شکل اضافه می‌شود و داخل رنگ پر نمی‌رود.</p>
                        </div>
                    </div>

                    <div class="design-control-text">
                        <div class="design-field">
                            <button class="design-action-btn" type="button" id="convertToCurvesBtn">
                                <i class="bi bi-bezier2"></i>
                                تبدیل به منحنی
                            </button>
                            <p class="design-help">بعد از تبدیل، فونت و ویرایش متن در دسترس نیست.</p>
                        </div>
                    </div>

                    <div class="design-control-svg-only d-none">
                        <div class="design-field">
                            <button class="design-action-btn" type="button" id="breakApartBtn">
                                <i class="bi bi-bounding-box"></i>
                                جدا کردن اجزا
                            </button>
                            <p class="design-help">حروف به‌هم‌پیوسته یک شکل می‌مانند و فقط نقطه‌ها جدا می‌شوند.</p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="design-panel-section design-panel-export">
                <h2>خروجی</h2>
                <div class="design-field mb-0">
                    <label class="design-label" for="designFileName">نام فایل</label>
                    <input id="designFileName" class="design-input" type="text" value="design" maxlength="80" />
                </div>
            </section>
        </aside>

        <section class="design-canvas-wrap">
            <div class="design-canvas-body">
                <div class="design-board" id="designBoard">
                    <div class="design-ruler-corner" aria-hidden="true"></div>
                    <canvas id="designRulerH" class="design-ruler design-ruler-h" width="1200" height="24" aria-label="خط‌کش افقی"></canvas>
                    <canvas id="designRulerV" class="design-ruler design-ruler-v" width="24" height="800" aria-label="خط‌کش عمودی"></canvas>
                    <div id="designStage" class="design-stage" aria-label="بوم طراحی">
                        <div id="designCanvasScaler" class="design-canvas-scaler">
                            <div id="designCanvas" class="design-canvas">
                                <svg id="designMeasureLayer" class="design-measure-layer" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <line id="measureLine" x1="0" y1="0" x2="0" y2="0" class="d-none"></line>
                                    <circle id="measurePointA" cx="0" cy="0" r="4" class="d-none"></circle>
                                    <circle id="measurePointB" cx="0" cy="0" r="4" class="d-none"></circle>
                                    <rect id="measureLabelBg" x="0" y="0" rx="4" ry="4" width="0" height="0" class="d-none"></rect>
                                    <text id="measureLabel" x="0" y="0" class="d-none"></text>
                                </svg>
                                <div id="designGuideX" class="design-guide design-guide-x d-none"></div>
                                <div id="designGuideY" class="design-guide design-guide-y d-none"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="design-zoom-toolbar" role="group" aria-label="زوم سریع">
                    <button type="button" id="zoomOutFab" title="کوچک‌نمایی">−</button>
                    <button type="button" id="zoomResetFab" title="۱۰۰٪">۱۰۰٪</button>
                    <button type="button" id="zoomInFab" title="بزرگ‌نمایی">+</button>
                </div>
                <div id="designMeasureInfo" class="design-measure-info d-none" aria-live="polite"></div>
                <div id="designStatus" class="design-status" aria-live="polite"></div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/lib/opentype.js/opentype.min.js" asp-append-version="true"></script>
    <script src="~/lib/paper/paper-full.min.js" asp-append-version="true"></script>
    <script src="~/lib/arabic-reshaper/arabic-reshaper.js" asp-append-version="true"></script>
    <script src="~/js/designs-vector.js" asp-append-version="true"></script>
    <script src="~/js/designs.js" asp-append-version="true"></script>
}
