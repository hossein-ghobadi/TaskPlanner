@model TaskPlanner.Domain.Entities.TaskPlanner.FeatureCodeReview
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "حذف امتیاز Code Review";
}

<div class="w-100">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-trash"></i> حذف امتیاز Code Review</h4>
        </div>
        <div class="card-body">
            <p>
                آیا از حذف امتیاز <strong>@Model.Score</strong>
                برای <strong>@ViewBag.RevieweeName</strong>
                در فیچر <strong>@ViewBag.FeatureName</strong>
                مطمئن هستید؟
            </p>
            <p class="text-muted small mb-3">
                ثبت‌شده توسط @ViewBag.ReviewerName
                @if (!string.IsNullOrWhiteSpace(Model.Comment))
                {
                    <span>— «@Model.Comment»</span>
                }
            </p>
            <form asp-action="DeleteCodeReview" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> حذف قطعی
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.FeatureId" class="btn btn-secondary">انصراف</a>
                </div>
            </form>
        </div>
    </div>
</div>
