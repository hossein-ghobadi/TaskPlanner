@model Endpoint.Site.Models.FeatureSettingsVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "تنظیمات فیچر";
}

<div class="w-100">
    <div class="card shadow-sm w-100">
        <div class="card-header bg-secondary text-white">
            <h4 class="mb-0">
                <i class="bi bi-gear"></i> تنظیمات فیچر
            </h4>
            <small>@Model.FeatureName</small>
        </div>
        <div class="card-body">
            <form asp-action="Settings" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProjectId" />
                <input type="hidden" asp-for="FeatureName" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CodeReviewerUserId" class="form-label">
                        <strong>مسئول Code Review</strong>
                    </label>
                    <select asp-for="CodeReviewerUserId" class="form-select" asp-items="Model.MemberOptions">
                        <option value="">-- انتخاب نشده --</option>
                    </select>
                    <div class="form-text">
                        این فرد می‌تواند امتیاز Code Review را به اعضای پروژه بدهد.
                    </div>
                    <span asp-validation-for="CodeReviewerUserId" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> ذخیره تنظیمات
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">انصراف</a>
                </div>
            </form>
        </div>
    </div>
</div>
