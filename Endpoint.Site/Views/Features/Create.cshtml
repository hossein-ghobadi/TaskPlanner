@model Endpoint.Site.Models.FeatureCreateVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "افزودن فیچر";
}

<div class="w-100">
    <div class="card shadow-sm w-100">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">
                <i class="bi bi-puzzle"></i> افزودن فیچر جدید
            </h4>
            <small>پروژه: @ViewBag.ProjectName</small>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <input type="hidden" name="projectId" value="@ViewBag.ProjectId" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        <strong>نام فیچر</strong>
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Name" class="form-control" placeholder="مثال: فهرست محصولات" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"><strong>توضیحات</strong></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="خلاصه هدف فیچر"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="alert alert-info small">
                    پس از ایجاد، مشخصات کامل (کارکردها، وضعیت‌های صفحه، قرارداد API و قوانین کسب‌وکار) را در صفحه جزئیات تکمیل کنید.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> ثبت فیچر
                    </button>
                    <a asp-action="Index" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> انصراف
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
