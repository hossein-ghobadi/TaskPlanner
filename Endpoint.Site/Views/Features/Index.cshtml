@model Endpoint.Site.Models.FeatureIndexVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "فیچرهای پروژه";
}

<div class="w-100">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-puzzle text-primary me-2"></i>
                فیچرها
            </h4>
            <small class="text-muted">پروژه: <strong>@Model.ProjectName</strong></small>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-success" asp-action="Create" asp-route-projectId="@Model.ProjectId">
                <i class="bi bi-plus-lg me-1"></i>
                افزودن فیچر
            </a>
            <a class="btn btn-outline-secondary" asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">
                <i class="bi bi-arrow-right me-1"></i>
                بازگشت به پروژه
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 w-100">
        <div class="card-body p-0">
            @if (Model.Features.Count == 0)
            {
                <div class="text-center text-muted py-5 px-3">
                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                    <p class="mb-3">هنوز فیچری ثبت نشده است.</p>
                    <a class="btn btn-primary" asp-action="Create" asp-route-projectId="@Model.ProjectId">
                        <i class="bi bi-plus-lg me-1"></i>
                        اولین فیچر را بسازید
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>نام فیچر</th>
                                <th class="text-center">کارکردها</th>
                                <th class="text-center">API</th>
                                <th class="text-center">تسک‌ها</th>
                                <th>مسئول Review</th>
                                <th class="text-end">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.Features)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@f.Id" class="fw-medium text-decoration-none">@f.Name</a>
                                        @if (!string.IsNullOrWhiteSpace(f.Description))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 280px;">@f.Description</div>
                                        }
                                    </td>
                                    <td class="text-center"><span class="badge bg-secondary">@f.FunctionCount</span></td>
                                    <td class="text-center"><span class="badge bg-secondary">@f.ApiContractCount</span></td>
                                    <td class="text-center"><span class="badge bg-secondary">@f.TaskCount</span></td>
                                    <td>@(f.CodeReviewerName ?? "—")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@f.Id" title="جزئیات">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@f.Id" title="ویرایش">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@f.Id" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
