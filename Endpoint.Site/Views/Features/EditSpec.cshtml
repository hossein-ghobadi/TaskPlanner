@model Endpoint.Site.Models.FeatureSpecEditVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "ویرایش مشخصات فیچر";
    var httpMethods = new[] { "GET", "POST", "PUT", "PATCH", "DELETE" };
}

<div class="w-100">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h4 class="mb-0 fw-bold">ویرایش مشخصات: @Model.FeatureName</h4>
            <small class="text-muted">کارکردها، وضعیت‌های صفحه، قرارداد API و قوانین کسب‌وکار</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">بازگشت</a>
    </div>

    <form asp-action="EditSpec" method="post" id="featureSpecForm">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ProjectId" />
        <input type="hidden" asp-for="FeatureName" />

        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong><i class="bi bi-list-check text-success me-1"></i> کارکردها</strong>
                <button type="button" class="btn btn-sm btn-outline-success" id="addFunctionBtn">
                    <i class="bi bi-plus"></i> افزودن
                </button>
            </div>
            <div class="card-body" id="functionsContainer">
                @for (var i = 0; i < Model.Functions.Count; i++)
                {
                    <div class="input-group mb-2 function-row">
                        <span class="input-group-text">•</span>
                        <input asp-for="Functions[i].Title" class="form-control" placeholder="مثال: نمایش فهرست محصولات" />
                        <button type="button" class="btn btn-outline-danger remove-row-btn" title="حذف"><i class="bi bi-trash"></i></button>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white">
                <strong><i class="bi bi-window-stack text-info me-1"></i> وضعیت‌های صفحه</strong>
            </div>
            <div class="card-body">
                @for (var i = 0; i < Model.PageStates.Count; i++)
                {
                    <div class="border rounded p-3 mb-3">
                        <input type="hidden" asp-for="PageStates[i].Id" />
                        <input type="hidden" asp-for="PageStates[i].StateType" />
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary">@Model.PageStates[i].StateType.GetDisplayName()</span>
                            <div class="form-check">
                                <input class="form-check-input" asp-for="PageStates[i].HasSeparateDesign" />
                                <label class="form-check-label" asp-for="PageStates[i].HasSeparateDesign">طراحی جداگانه دارد</label>
                            </div>
                        </div>
                        <label class="form-label">رفتار سیستم</label>
                        <textarea asp-for="PageStates[i].BehaviorDescription" class="form-control" rows="2"></textarea>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong><i class="bi bi-braces text-primary me-1"></i> قرارداد API</strong>
                <button type="button" class="btn btn-sm btn-outline-primary" id="addApiBtn">
                    <i class="bi bi-plus"></i> افزودن Endpoint
                </button>
            </div>
            <div class="card-body" id="apiContainer">
                @for (var i = 0; i < Model.ApiContracts.Count; i++)
                {
                    <div class="border rounded p-3 mb-3 api-row">
                        <div class="d-flex justify-content-between mb-2">
                            <strong>Endpoint #@(i + 1)</strong>
                            <button type="button" class="btn btn-sm btn-outline-danger remove-row-btn"><i class="bi bi-trash"></i></button>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label">Method</label>
                                <select asp-for="ApiContracts[i].HttpMethod" class="form-select">
                                    @foreach (var m in httpMethods)
                                    {
                                        if (string.Equals(Model.ApiContracts[i].HttpMethod, m, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@m" selected="selected">@m</option>
                                        }
                                        else
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-9">
                                <label class="form-label">Endpoint</label>
                                <input asp-for="ApiContracts[i].Endpoint" class="form-control" placeholder="/api/products" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Request</label>
                                <textarea asp-for="ApiContracts[i].RequestDescription" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Response</label>
                                <textarea asp-for="ApiContracts[i].ResponseDescription" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Error Response</label>
                                <textarea asp-for="ApiContracts[i].ErrorResponseDescription" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Status Codes</label>
                                <input asp-for="ApiContracts[i].StatusCodes" class="form-control" placeholder="200, 400, 401, 404" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Pagination</label>
                                <input asp-for="ApiContracts[i].Pagination" class="form-control"
                                       placeholder="page, pageSize — مثلاً page=1&pageSize=20" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Filter</label>
                                <input asp-for="ApiContracts[i].Filter" class="form-control"
                                       placeholder="status, search — مثلاً status=Active&search=علی" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Sort</label>
                                <input asp-for="ApiContracts[i].Sort" class="form-control"
                                       placeholder="sortBy, sortDir — مثلاً sortBy=createdAt&sortDir=desc" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">فیلدها (نام، نوع، Required/Nullable)</label>
                                <textarea asp-for="ApiContracts[i].FieldsDescription" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong><i class="bi bi-shield-check text-warning me-1"></i> قوانین کسب‌وکار</strong>
                <button type="button" class="btn btn-sm btn-outline-warning" id="addRuleBtn">
                    <i class="bi bi-plus"></i> افزودن
                </button>
            </div>
            <div class="card-body" id="rulesContainer">
                @for (var i = 0; i < Model.BusinessRules.Count; i++)
                {
                    <div class="input-group mb-2 rule-row">
                        <span class="input-group-text">•</span>
                        <input asp-for="BusinessRules[i].Description" class="form-control" placeholder="مثال: اگر محصول موجود نیست، دکمه خرید غیرفعال شود" />
                        <button type="button" class="btn btn-outline-danger remove-row-btn"><i class="bi bi-trash"></i></button>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> ذخیره مشخصات
            </button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">انصراف</a>
        </div>
    </form>
</div>

<template id="functionRowTemplate">
    <div class="input-group mb-2 function-row">
        <span class="input-group-text">•</span>
        <input name="Functions[__i__].Title" class="form-control" placeholder="مثال: نمایش فهرست محصولات" />
        <button type="button" class="btn btn-outline-danger remove-row-btn"><i class="bi bi-trash"></i></button>
    </div>
</template>

<template id="ruleRowTemplate">
    <div class="input-group mb-2 rule-row">
        <span class="input-group-text">•</span>
        <input name="BusinessRules[__i__].Description" class="form-control" placeholder="قانون کسب‌وکار" />
        <button type="button" class="btn btn-outline-danger remove-row-btn"><i class="bi bi-trash"></i></button>
    </div>
</template>

<template id="apiRowTemplate">
    <div class="border rounded p-3 mb-3 api-row">
        <div class="d-flex justify-content-between mb-2">
            <strong>Endpoint جدید</strong>
            <button type="button" class="btn btn-sm btn-outline-danger remove-row-btn"><i class="bi bi-trash"></i></button>
        </div>
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label">Method</label>
                <select name="ApiContracts[__i__].HttpMethod" class="form-select">
                    <option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option><option>DELETE</option>
                </select>
            </div>
            <div class="col-md-9">
                <label class="form-label">Endpoint</label>
                <input name="ApiContracts[__i__].Endpoint" class="form-control" placeholder="/api/..." />
            </div>
            <div class="col-md-6">
                <label class="form-label">Request</label>
                <textarea name="ApiContracts[__i__].RequestDescription" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label">Response</label>
                <textarea name="ApiContracts[__i__].ResponseDescription" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label">Error Response</label>
                <textarea name="ApiContracts[__i__].ErrorResponseDescription" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label">Status Codes</label>
                <input name="ApiContracts[__i__].StatusCodes" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Pagination</label>
                <input name="ApiContracts[__i__].Pagination" class="form-control"
                       placeholder="page, pageSize — مثلاً page=1&pageSize=20" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Filter</label>
                <input name="ApiContracts[__i__].Filter" class="form-control"
                       placeholder="status, search — مثلاً status=Active&search=علی" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Sort</label>
                <input name="ApiContracts[__i__].Sort" class="form-control"
                       placeholder="sortBy, sortDir — مثلاً sortBy=createdAt&sortDir=desc" />
            </div>
            <div class="col-12">
                <label class="form-label">فیلدها</label>
                <textarea name="ApiContracts[__i__].FieldsDescription" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>
</template>

<script>
(function () {
    function reindex(container, rowSelector, namePrefix) {
        const rows = container.querySelectorAll(rowSelector);
        rows.forEach((row, index) => {
            row.querySelectorAll('[name]').forEach(el => {
                el.name = el.name.replace(new RegExp(namePrefix + '\\[\\d+\\]'), namePrefix + '[' + index + ']');
            });
        });
    }

    function bindRemove(container, rowSelector, namePrefix) {
        container.addEventListener('click', function (e) {
            const btn = e.target.closest('.remove-row-btn');
            if (!btn) return;
            const row = btn.closest(rowSelector);
            if (row) {
                row.remove();
                reindex(container, rowSelector, namePrefix);
            }
        });
    }

    function addFromTemplate(container, templateId, rowSelector, namePrefix) {
        const tpl = document.getElementById(templateId);
        const index = container.querySelectorAll(rowSelector).length;
        const html = tpl.innerHTML.replace(/__i__/g, index);
        container.insertAdjacentHTML('beforeend', html);
    }

    const functionsContainer = document.getElementById('functionsContainer');
    const rulesContainer = document.getElementById('rulesContainer');
    const apiContainer = document.getElementById('apiContainer');

    bindRemove(functionsContainer, '.function-row', 'Functions');
    bindRemove(rulesContainer, '.rule-row', 'BusinessRules');
    bindRemove(apiContainer, '.api-row', 'ApiContracts');

    document.getElementById('addFunctionBtn').addEventListener('click', function () {
        addFromTemplate(functionsContainer, 'functionRowTemplate', '.function-row', 'Functions');
    });
    document.getElementById('addRuleBtn').addEventListener('click', function () {
        addFromTemplate(rulesContainer, 'ruleRowTemplate', '.rule-row', 'BusinessRules');
    });
    document.getElementById('addApiBtn').addEventListener('click', function () {
        addFromTemplate(apiContainer, 'apiRowTemplate', '.api-row', 'ApiContracts');
    });
})();
</script>
