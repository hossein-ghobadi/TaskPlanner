        function getImplementationCommentFileIcon(file) {
            var name = (file.name || '').toLowerCase();
            var type = (file.type || '').toLowerCase();
            if (type.indexOf('audio/') === 0 || /\.(mp3|wav|ogg|m4a|webm|aac)$/.test(name)) return 'bi-mic';
            if (/\.(pdf)$/.test(name)) return 'bi-file-earmark-pdf';
            if (/\.(doc|docx)$/.test(name)) return 'bi-file-earmark-word';
            if (/\.(xls|xlsx)$/.test(name)) return 'bi-file-earmark-excel';
            if (/\.(zip|rar)$/.test(name)) return 'bi-file-earmark-zip';
            return 'bi-paperclip';
