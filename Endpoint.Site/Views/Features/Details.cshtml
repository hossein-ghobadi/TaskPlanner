<script>
    (function () {
        var apiContractsById = {};
        @foreach (var api in Model.ApiContracts)
        {
            <text>
            apiContractsById[@api.Id] = {
                id: @api.Id,
                httpMethod: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(api.HttpMethod)),
                endpoint: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(api.Endpoint)),
                requestDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(api.RequestDescription ?? "")),
                responseDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(api.ResponseDescription ?? "")),
                errorResponseDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(api.ErrorResponseDescription ?? "")),
                statusCodes: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(api.StatusCodes ?? "")),
                pagination: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(api.Pagination ?? "")),
                filter: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(api.Filter ?? "")),
                sort: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(api.Sort ?? "")),
                fieldsDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(api.FieldsDescription ?? ""))
            };
            </text>
        }

        var fieldTypeOptions = ['string', 'int', 'long', 'decimal', 'bool', 'DateTime', 'Guid', 'object', 'array'];

        function createFieldRow(container, field) {
            field = field || { name: '', type: 'string', nullability: 'Required' };
            var row = document.createElement('div');
            row.className = 'input-group input-group-sm mb-2 api-field-row';

            var nameInput = document.createElement('input');
            nameInput.type = 'text';
            nameInput.className = 'form-control api-field-name';
            nameInput.placeholder = 'نام فیلد';
            nameInput.value = field.name || '';
            nameInput.maxLength = 200;

            var typeSelect = document.createElement('select');
            typeSelect.className = 'form-select api-field-type';
            typeSelect.style.maxWidth = '8rem';
            fieldTypeOptions.forEach(function (t) {
                var opt = document.createElement('option');
                opt.value = t;
                opt.textContent = t;
                if ((field.type || 'string').toLowerCase() === t.toLowerCase()) opt.selected = true;
                typeSelect.appendChild(opt);
            });
            if (field.type && fieldTypeOptions.every(function (t) { return t.toLowerCase() !== field.type.toLowerCase(); })) {
                var custom = document.createElement('option');
                custom.value = field.type;
                custom.textContent = field.type;
                custom.selected = true;
                typeSelect.appendChild(custom);
            }

            var nullSelect = document.createElement('select');
            nullSelect.className = 'form-select api-field-nullability';
            nullSelect.style.maxWidth = '8rem';
            ['Required', 'Nullable'].forEach(function (n) {
                var opt = document.createElement('option');
                opt.value = n;
                opt.textContent = n;
                if ((field.nullability || 'Required') === n) opt.selected = true;
                nullSelect.appendChild(opt);
            });

            var removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'btn btn-outline-danger';
            removeBtn.title = 'حذف';
            removeBtn.innerHTML = '<i class="bi bi-trash"></i>';
            removeBtn.addEventListener('click', function () { row.remove(); });

            row.appendChild(nameInput);
            row.appendChild(typeSelect);
            row.appendChild(nullSelect);
            row.appendChild(removeBtn);
            container.appendChild(row);
        }

        function clearFieldRows(container) {
            if (container) container.innerHTML = '';
        }

        function parseFieldsDescription(text) {
            if (!text || !String(text).trim()) return [];
            return String(text).split(/\r?\n/).map(function (line) {
                line = line.trim();
                if (!line) return null;
                var parts = line.split('|').map(function (p) { return p.trim(); });
                if (parts.length >= 3) {
                    return { name: parts[0], type: parts[1], nullability: parts[2] === 'Nullable' ? 'Nullable' : 'Required' };
                }
                return { name: line, type: 'string', nullability: 'Required' };
            }).filter(Boolean);
        }

        function serializeFieldRows(container) {
            if (!container) return '';
            var lines = [];
            container.querySelectorAll('.api-field-row').forEach(function (row) {
                var name = (row.querySelector('.api-field-name')?.value || '').trim();
                if (!name) return;
                var type = (row.querySelector('.api-field-type')?.value || 'string').trim();
                var nullability = row.querySelector('.api-field-nullability')?.value || 'Required';
                lines.push(name + ' | ' + type + ' | ' + nullability);
            });
            return lines.join('\n');
        }

        function loadFieldsInto(container, text) {
            clearFieldRows(container);
            var fields = parseFieldsDescription(text);
            if (fields.length === 0) {
                createFieldRow(container);
                return;
            }
            fields.forEach(function (f) { createFieldRow(container, f); });
        }

        var addFieldsList = document.getElementById('addApiFieldsList');
        var editFieldsList = document.getElementById('editApiFieldsList');

        document.getElementById('addApiFieldRowBtn')?.addEventListener('click', function () {
            createFieldRow(addFieldsList);
        });
        document.getElementById('editApiFieldRowBtn')?.addEventListener('click', function () {
            createFieldRow(editFieldsList);
        });

        document.getElementById('addApiContractModal')?.addEventListener('show.bs.modal', function () {
            loadFieldsInto(addFieldsList, '');
        });

        document.querySelector('#addApiContractModal form')?.addEventListener('submit', function () {
            document.getElementById('addApiFieldsDescription').value = serializeFieldRows(addFieldsList);
        });
        document.querySelector('#editApiContractModal form')?.addEventListener('submit', function () {
            document.getElementById('editApiFieldsDescription').value = serializeFieldRows(editFieldsList);
        });

        document.getElementById('editFunctionModal')?.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('editFunctionId').value = btn.getAttribute('data-id') || '';
            document.getElementById('editFunctionTitle').value = btn.getAttribute('data-title') || '';
        });

        document.getElementById('deleteFunctionModal')?.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('deleteFunctionId').value = btn.getAttribute('data-id') || '';
            document.getElementById('deleteFunctionTitle').textContent = btn.getAttribute('data-title') || '';
        });

        document.getElementById('editBusinessRuleModal')?.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('editBusinessRuleId').value = btn.getAttribute('data-id') || '';
            document.getElementById('editBusinessRuleDescription').value = btn.getAttribute('data-description') || '';
        });

        document.getElementById('deleteBusinessRuleModal')?.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('deleteBusinessRuleId').value = btn.getAttribute('data-id') || '';
            document.getElementById('deleteBusinessRuleDescription').textContent = btn.getAttribute('data-description') || '';
        });

        document.getElementById('editPageStateModal')?.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('editPageStateId').value = btn.getAttribute('data-id') || '';
            document.getElementById('editPageStateName').textContent = btn.getAttribute('data-state-name') || '';
            document.getElementById('editPageStateBehavior').value = btn.getAttribute('data-behavior') || '';
            document.getElementById('editPageStateSeparate').checked = btn.getAttribute('data-separate') === 'true';
        });

        document.getElementById('deletePageStateModal')?.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('deletePageStateId').value = btn.getAttribute('data-id') || '';
            document.getElementById('deletePageStateName').textContent = btn.getAttribute('data-state-name') || '';
        });

        document.getElementById('editApiContractModal')?.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            var id = btn.getAttribute('data-id');
            var api = apiContractsById[id];
            if (!api) return;
            document.getElementById('editApiId').value = api.id;
            document.getElementById('editApiHttpMethod').value = api.httpMethod || 'GET';
            document.getElementById('editApiEndpoint').value = api.endpoint || '';
            document.getElementById('editApiRequest').value = api.requestDescription || '';
            document.getElementById('editApiResponse').value = api.responseDescription || '';
            document.getElementById('editApiError').value = api.errorResponseDescription || '';
            document.getElementById('editApiStatusCodes').value = api.statusCodes || '';
            document.getElementById('editApiPagination').value = api.pagination || '';
            document.getElementById('editApiFilter').value = api.filter || '';
            document.getElementById('editApiSort').value = api.sort || '';
            loadFieldsInto(editFieldsList, api.fieldsDescription || '');
        });

        document.getElementById('deleteApiContractModal')?.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('deleteApiId').value = btn.getAttribute('data-id') || '';
            document.getElementById('deleteApiLabel').textContent = btn.getAttribute('data-label') || '';
        });
    })();
</script>