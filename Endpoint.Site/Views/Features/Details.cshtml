@model Endpoint.Site.Models.FeatureDetailsVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@using DNTPersianUtils.Core
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Name;
    const bool showPageStatesAndApiSection = false;
    var featureTaskAntiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="w-100">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
        <div>
            <h4 class="mb-1 fw-bold">
                <i class="bi bi-puzzle text-primary me-2"></i>
                @Model.Name
            </h4>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <small class="text-muted">پروژه: <strong>@Model.ProjectName</strong></small>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-muted mt-2 mb-0">@Model.Description</p>
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.CanManageFeatureSpec)
            {
                <a class="btn btn-outline-secondary" asp-action="Settings" asp-route-id="@Model.Id">
                    <i class="bi bi-gear me-1"></i> تنظیمات
                </a>
            }
            <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="bi bi-pencil me-1"></i> ویرایش
            </a>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-projectId="@Model.ProjectId">
                بازگشت
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold">
                        <i class="bi bi-list-check text-success me-1"></i> کارکردها
                    </span>
                    @if (Model.CanManageFeatureSpec)
                    {
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addFunctionModal">
                            <i class="bi bi-plus"></i> افزودن
                        </button>
                    }
                </div>
                <div class="card-body" id="functionsCardBody">
                    <p class="text-muted mb-0 @(Model.Functions.Count == 0 ? "" : "d-none")" id="functionsEmpty">هنوز کارکردی تعریف نشده است.</p>
                    <ul class="list-unstyled mb-0 @(Model.Functions.Count == 0 ? "d-none" : "")" id="functionsList">
                        @foreach (var item in Model.Functions)
                        {
                            <li class="d-flex justify-content-between align-items-start gap-2 mb-2" data-id="@item.Id">
                                <span class="item-text">@item.Title</span>
                                @if (Model.CanManageFeatureSpec)
                                {
                                    <div class="btn-group btn-group-sm flex-shrink-0">
                                        <button type="button"
                                                class="btn btn-outline-secondary py-0 px-1"
                                                title="ویرایش"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editFunctionModal"
                                                data-id="@item.Id"
                                                data-title="@item.Title">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-danger py-0 px-1"
                                                title="حذف"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteFunctionModal"
                                                data-id="@item.Id"
                                                data-title="@item.Title">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold">
                        <i class="bi bi-shield-check text-warning me-1"></i> قوانین کسب‌وکار
                    </span>
                    @if (Model.CanManageFeatureSpec)
                    {
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addBusinessRuleModal">
                            <i class="bi bi-plus"></i> افزودن
                        </button>
                    }
                </div>
                <div class="card-body" id="businessRulesCardBody">
                    <p class="text-muted mb-0 @(Model.BusinessRules.Count == 0 ? "" : "d-none")" id="businessRulesEmpty">هنوز قانونی تعریف نشده است.</p>
                    <ul class="list-unstyled mb-0 @(Model.BusinessRules.Count == 0 ? "d-none" : "")" id="businessRulesList">
                        @foreach (var item in Model.BusinessRules)
                        {
                            <li class="d-flex justify-content-between align-items-start gap-2 mb-2" data-id="@item.Id">
                                <span class="item-text">@item.Description</span>
                                @if (Model.CanManageFeatureSpec)
                                {
                                    <div class="btn-group btn-group-sm flex-shrink-0">
                                        <button type="button"
                                                class="btn btn-outline-secondary py-0 px-1"
                                                title="ویرایش"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editBusinessRuleModal"
                                                data-id="@item.Id"
                                                data-description="@item.Description">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-danger py-0 px-1"
                                                title="حذف"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteBusinessRuleModal"
                                                data-id="@item.Id"
                                                data-description="@item.Description">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold">
                        <i class="bi bi-journal-text text-secondary me-1"></i> تغییرات حین پیاده‌سازی
                    </span>
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addImplementationCommentModal">
                        <i class="bi bi-plus"></i> ثبت یادداشت
                    </button>
                </div>
                <div class="card-body" id="implementationCommentsCardBody">
                    <p class="text-muted mb-0 @(Model.ImplementationComments.Count == 0 ? "" : "d-none")" id="implementationCommentsEmpty">
                        هنوز تغییری در حین پیاده‌سازی ثبت نشده است.
                    </p>
                    <div class="@(Model.ImplementationComments.Count == 0 ? "d-none" : "")" id="implementationCommentsList">
                        @foreach (var comment in Model.ImplementationComments)
                        {
                            <div class="border rounded p-3 mb-2 implementation-comment-item" data-id="@comment.Id">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                    <div>
                                        <strong class="item-author">@comment.AuthorName</strong>
                                        <span class="text-muted small ms-2 item-date">@comment.CreatedAtDisplay</span>
                                    </div>
                                    @if (comment.CanDelete)
                                    {
                                        <div class="btn-group btn-group-sm flex-shrink-0">
                                            <button type="button"
                                                    class="btn btn-outline-secondary py-0 px-1"
                                                    title="ویرایش"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editImplementationCommentModal"
                                                    data-id="@comment.Id">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-danger py-0 px-1"
                                                    title="حذف"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteImplementationCommentModal"
                                                    data-id="@comment.Id">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(comment.Body))
                                {
                                    <div class="item-body mb-0">@comment.Body</div>
                                }
                                @if (comment.Attachments.Count > 0)
                                {
                                    <div class="item-attachments mt-2 d-flex flex-wrap gap-2 align-items-start">
                                        @foreach (var att in comment.Attachments)
                                        {
                                            var isImage = string.Equals(att.FileType, "Image", StringComparison.OrdinalIgnoreCase)
                                                || (att.MimeType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ?? false);
                                            if (isImage)
                                            {
                                                <button type="button"
                                                        class="btn p-0 border-0 implementation-comment-image-thumb"
                                                        data-image-url="@att.FilePath"
                                                        data-image-name="@att.FileName"
                                                        title="نمایش تصویر">
                                                    <img src="@att.FilePath" alt="@att.FileName" class="rounded border" style="max-height: 160px; max-width: 240px; object-fit: cover; cursor: zoom-in;" />
                                                </button>
                                            }
                                            else if (string.Equals(att.FileType, "Audio", StringComparison.OrdinalIgnoreCase)
                                                || (att.MimeType?.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) ?? false))
                                            {
                                                <div class="implementation-comment-file-chip">
                                                    <audio controls preload="metadata" src="@att.FilePath" style="max-width: 260px;"></audio>
                                                    <a href="@att.FilePath" target="_blank" rel="noopener noreferrer" class="small d-inline-block mt-1">
                                                        <i class="bi bi-download"></i> @att.FileName
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <a href="@att.FilePath"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   class="implementation-comment-file-chip btn btn-outline-secondary btn-sm text-start">
                                                    <i class="bi bi-paperclip me-1"></i>@att.FileName
                                                </a>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (showPageStatesAndApiSection)
        {
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold">
                        <i class="bi bi-window-stack text-info me-1"></i> وضعیت‌های صفحه
                    </span>
                    @{
                        var existingStateTypes = Model.PageStates.Select(p => p.StateType).ToHashSet();
                        var availableStateTypes = Enum.GetValues<FeaturePageStateType>()
                            .Where(t => !existingStateTypes.Contains(t))
                            .ToList();
                    }
                    @if (Model.CanManagePageStatesAndApi)
                    {
                        <button type="button"
                                class="btn btn-sm btn-primary @(availableStateTypes.Count == 0 ? "d-none" : "")"
                                id="addPageStateBtn"
                                data-bs-toggle="modal"
                                data-bs-target="#addPageStateModal">
                            <i class="bi bi-plus"></i> افزودن
                        </button>
                    }
                </div>
                <div class="card-body p-0" id="pageStatesCardBody">
                    <p class="text-muted mb-0 p-3 @(Model.PageStates.Count == 0 ? "" : "d-none")" id="pageStatesEmpty">هنوز وضعیت صفحه‌ای تعریف نشده است.</p>
                    <div class="table-responsive @(Model.PageStates.Count == 0 ? "d-none" : "")" id="pageStatesTableWrap">
                        <table class="table mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 9rem;">وضعیت</th>
                                    <th>رفتار</th>
                                    <th style="width: 8rem;">طراحی جدا</th>
                                    @if (Model.CanManagePageStatesAndApi)
                                    {
                                        <th style="width: 6rem;"></th>
                                    }
                                </tr>
                            </thead>
                            <tbody id="pageStatesList">
                                @foreach (var s in Model.PageStates)
                                {
                                    <tr data-id="@s.Id" data-state-type="@((int)s.StateType)">
                                        <td><span class="badge bg-secondary">@s.StateType.GetDisplayName()</span></td>
                                        <td class="item-behavior">@s.BehaviorDescription</td>
                                        <td class="item-separate">@(s.HasSeparateDesign ? "بله" : "خیر")</td>
                                        @if (Model.CanManagePageStatesAndApi)
                                        {
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button"
                                                            class="btn btn-outline-secondary py-0 px-1"
                                                            title="ویرایش"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#editPageStateModal"
                                                            data-id="@s.Id"
                                                            data-state-name="@s.StateType.GetDisplayName()"
                                                            data-behavior="@s.BehaviorDescription"
                                                            data-separate="@(s.HasSeparateDesign ? "true" : "false")">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-outline-danger py-0 px-1"
                                                            title="حذف"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deletePageStateModal"
                                                            data-id="@s.Id"
                                                            data-state-name="@s.StateType.GetDisplayName()">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold">
                        <i class="bi bi-braces text-primary me-1"></i> قرارداد API
                    </span>
                    @if (Model.CanManagePageStatesAndApi)
                    {
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addApiContractModal">
                            <i class="bi bi-plus"></i> افزودن
                        </button>
                    }
                </div>
                <div class="card-body">
                    @if (Model.ApiContracts.Count == 0)
                    {
                        <p class="text-muted mb-0">هنوز قرارداد API تعریف نشده است.</p>
                    }
                    else
                    {
                        @foreach (var api in Model.ApiContracts)
                        {
                            <div class="border rounded p-3 mb-3">
                                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-2">
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <span class="badge bg-dark">@api.HttpMethod</span>
                                        <code>@api.Endpoint</code>
                                        @if (!string.IsNullOrWhiteSpace(api.StatusCodes))
                                        {
                                            <span class="badge bg-light text-dark">Status: @api.StatusCodes</span>
                                        }
                                    </div>
                                    @if (Model.CanManagePageStatesAndApi)
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-secondary py-0 px-1"
                                                    title="ویرایش"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editApiContractModal"
                                                    data-id="@api.Id">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-danger py-0 px-1"
                                                    title="حذف"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteApiContractModal"
                                                    data-id="@api.Id"
                                                    data-label="@($"{api.HttpMethod} {api.Endpoint}")">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                                <div class="row g-2 small">
                                    @if (!string.IsNullOrWhiteSpace(api.RequestDescription))
                                    {
                                        <div class="col-md-6"><strong>Request:</strong><pre class="bg-light p-2 rounded mb-0">@api.RequestDescription</pre></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(api.ResponseDescription))
                                    {
                                        <div class="col-md-6"><strong>Response:</strong><pre class="bg-light p-2 rounded mb-0">@api.ResponseDescription</pre></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(api.ErrorResponseDescription))
                                    {
                                        <div class="col-md-6"><strong>Error Response:</strong><pre class="bg-light p-2 rounded mb-0">@api.ErrorResponseDescription</pre></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(api.FieldsDescription))
                                    {
                                        <div class="col-12">
                                            <strong>فیلدها:</strong>
                                            @{
                                                var fieldLines = api.FieldsDescription
                                                    .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                                                    .Select(l => l.Trim())
                                                    .Where(l => l.Length > 0)
                                                    .ToList();
                                                var parsedFields = fieldLines
                                                    .Select(l =>
                                                    {
                                                        var parts = l.Split('|');
                                                        if (parts.Length >= 3)
                                                        {
                                                            return new
                                                            {
                                                                Name = parts[0].Trim(),
                                                                Type = parts[1].Trim(),
                                                                Nullability = parts[2].Trim(),
                                                                Ok = true
                                                            };
                                                        }
                                                        return new { Name = l, Type = "", Nullability = "", Ok = false };
                                                    })
                                                    .ToList();
                                                var allParsed = parsedFields.Count > 0 && parsedFields.All(f => f.Ok);
                                            }
                                            @if (allParsed)
                                            {
                                                <div class="table-responsive mt-1">
                                                    <table class="table table-sm table-bordered mb-0 bg-light">
                                                        <thead>
                                                            <tr>
                                                                <th>نام</th>
                                                                <th>نوع</th>
                                                                <th>الزام</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var f in parsedFields)
                                                            {
                                                                <tr>
                                                                    <td><code>@f.Name</code></td>
                                                                    <td>@f.Type</td>
                                                                    <td>@f.Nullability</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <pre class="bg-light p-2 rounded mb-0 mt-1">@api.FieldsDescription</pre>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(api.Pagination) || !string.IsNullOrWhiteSpace(api.Filter) || !string.IsNullOrWhiteSpace(api.Sort))
                                    {
                                        <div class="col-12">
                                            @if (!string.IsNullOrWhiteSpace(api.Pagination)) { <div><strong>Pagination:</strong> @api.Pagination</div> }
                                            @if (!string.IsNullOrWhiteSpace(api.Filter)) { <div><strong>Filter:</strong> @api.Filter</div> }
                                            @if (!string.IsNullOrWhiteSpace(api.Sort)) { <div><strong>Sort:</strong> @api.Sort</div> }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        }

        <div class="@(Model.CanManageCodeReview ? "col-lg-7" : "col-lg-12")">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-list-task me-1"></i> تسک‌های فیچر</span>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="featureTasksSortToggle"
                                title="مرتب‌سازی بر اساس تاریخ ایجاد"
                                data-sort="desc">
                            <i class="bi bi-sort-down"></i>
                            <span class="feature-tasks-sort-label">جدیدتر</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-success" onclick="openFeatureCreateTask()">
                            <i class="bi bi-plus"></i> تسک جدید
                        </button>
                    </div>
                </div>
                <div class="card-body p-0" id="featureTasksCardBody">
                    @if (Model.Tasks.Count == 0)
                    {
                        <p class="text-muted p-3 mb-0" id="featureTasksEmpty">هنوز تسکی به این فیچر متصل نشده است. تسک‌ها می‌توانند داخل یا خارج اسپرینت باشند.</p>
                        <div class="table-responsive d-none" id="featureTasksTableWrap">
                            <table class="table mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>کلید</th>
                                        <th>عنوان</th>
                                        <th>مسئول</th>
                                        <th>اسپرینت</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="featureTasksTableBody"></tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" id="featureTasksTableWrap">
                            <table class="table mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>کلید</th>
                                        <th>عنوان</th>
                                        <th>مسئول</th>
                                        <th>اسپرینت</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="featureTasksTableBody">
                                    @foreach (var t in Model.Tasks)
                                    {
                                        <tr data-task-id="@t.Id" data-created-at="@((long)(t.CreatedAt.ToUniversalTime() - DateTime.UnixEpoch).TotalMilliseconds)">
                                            <td><code>@(t.IssueKey ?? "—")</code></td>
                                            <td>
                                                @t.Title
                                                @if (t.IsCompleted)
                                                {
                                                    <span class="badge bg-success ms-1">انجام‌شده</span>
                                                }
                                            </td>
                                            <td>@(t.AssignedUserName ?? "—")</td>
                                            <td>
                                                @if (t.InSprint)
                                                {
                                                    <span class="badge bg-info text-dark">@(t.SprintName ?? "اسپرینت")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">خارج از اسپرینت</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-primary feature-edit-task-btn"
                                                            title="ویرایش"
                                                            data-task-id="@t.Id">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger feature-delete-task-btn"
                                                            title="حذف"
                                                            data-task-id="@t.Id"
                                                            data-task-title="@t.Title">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (Model.CanManageCodeReview)
        {
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-code-square me-1"></i> Code Review</span>
                    <a class="btn btn-sm btn-primary" asp-action="AddCodeReview" asp-route-id="@Model.Id">
                        <i class="bi bi-plus"></i> ثبت امتیاز
                    </a>
                </div>
                <div class="card-body">
                    <div class="mb-3 small">
                        <strong>مسئول Review:</strong>
                        @(Model.CodeReviewerName ?? "تعیین نشده")
                        @if (Model.CanChangeCodeReviewer)
                        {
                            <a asp-action="Settings" asp-route-id="@Model.Id" class="ms-2">تغییر</a>
                        }
                    </div>
                    @if (Model.CodeReviews.Count == 0)
                    {
                        <p class="text-muted mb-0">هنوز امتیازی ثبت نشده است.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var r in Model.CodeReviews)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong>@r.RevieweeName</strong>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-primary">@r.Score</span>
                                            <a asp-action="DeleteCodeReview" asp-route-id="@r.Id"
                                               class="btn btn-sm btn-outline-danger py-0 px-1"
                                               title="حذف امتیاز">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="small text-muted">توسط @r.ReviewerName</div>
                                    @if (!string.IsNullOrWhiteSpace(r.Comment))
                                    {
                                        <div class="small mt-1">@r.Comment</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        }
    </div>
</div>

