                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> انصراف
                </button>
                <button type="button" class="btn btn-primary" id="featureTaskSubmitBtn">
                    <i class="bi bi-plus-lg me-1"></i> <span id="featureTaskSubmitText">افزودن کار</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="featureDeleteTaskModal" tabindex="-1" aria-labelledby="featureDeleteTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="featureDeleteTaskModalLabel">
                    <i class="bi bi-trash me-1"></i> حذف کار
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="featureDeleteTaskId" />
                <p class="mb-0">آیا از حذف کار <strong id="featureDeleteTaskTitle"></strong> مطمئن هستید؟</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-danger" id="featureDeleteTaskConfirmBtn">حذف</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var effortLabels = { '': 'تعیین نشده', '1': 'ساده', '2': 'متوسط', '3': 'پرزحمت' };
        var effortSelect = document.getElementById('featureTaskEffort');
        var effortDisplay = document.getElementById('featureTaskEffortDisplay');
        var originalFeatureTask = null;
        var defaultProjectIssueTypeId = document.getElementById('featureTaskProjectIssueTypeId')?.value || '';
        var defaultIssueTypeBase = document.getElementById('featureTaskIssueType')?.value || '3';

        effortSelect?.addEventListener('change', function () {
            if (effortDisplay) effortDisplay.textContent = effortLabels[this.value] || 'تعیین نشده';
        });

        function mapStoryPointsToEffortLevel(sp) {
            if (sp == null || sp === '') return '';
            var n = parseInt(sp, 10);
            if (Number.isNaN(n)) return '';
            if (n <= 3) return '1';
            if (n <= 8) return '2';
            return '3';
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.textContent = text == null ? '' : String(text);
            return div.innerHTML;
        }

        var featureSubtaskParentId = null;
        var featureSubtaskUiBound = false;

        function setFeatureChecklistVisible(show, parentId) {
            var panel = document.getElementById('featureChecklistPanel');
            if (!panel) return;
            if (show && parentId) {
                panel.style.display = '';
                featureSubtaskParentId = parentId;
                ensureFeatureSubtaskUiBound();
                var note = document.getElementById('featureInlineSubtaskNote');
                if (note) note.textContent = '';
                loadFeatureSubtasks(parentId);
            } else {
                panel.style.display = 'none';
                featureSubtaskParentId = null;
                var listEl = document.getElementById('featureInlineSubtasksList');
                if (listEl) listEl.innerHTML = '';
                var badge = document.getElementById('featureSubtaskProgressBadge');
                if (badge) badge.textContent = '0/0';
                var titleInput = document.getElementById('featureInlineSubtaskTitle');
                if (titleInput) titleInput.value = '';
            }
        }

        function isFeatureTaskTypeForChecklist(issueType) {
            var et = issueType != null ? parseInt(issueType, 10) : parseInt(defaultIssueTypeBase, 10);
            return et === 3;
        }

        function renderFeatureSubtasks(items) {
            var listEl = document.getElementById('featureInlineSubtasksList');
            if (!listEl) return;
            var subtasks = Array.isArray(items) ? items : [];
            var badge = document.getElementById('featureSubtaskProgressBadge');
            if (badge) {
                var done = subtasks.filter(function (s) { return s.isCompleted; }).length;
                badge.textContent = subtasks.length ? (done + '/' + subtasks.length) : '0/0';
            }
            if (subtasks.length === 0) {
                listEl.innerHTML = '<li class="feature-subtask-empty">هنوز کارکی ثبت نشده است.</li>';
                return;
            }
            listEl.innerHTML = subtasks.map(function (st) {
                var id = Number(st.id || 0);
                var title = escapeHtml(st.title || '');
                var completed = !!st.isCompleted;
                return '<li class="feature-subtask-item" data-subtask-id="' + id + '">' +
                    '<div class="feature-subtask-item-main">' +
                    '<input type="checkbox" class="feature-subtask-check" data-subtask-id="' + id + '"' + (completed ? ' checked' : '') + ' />' +
                    '<span class="feature-subtask-title editable' + (completed ? ' completed' : '') + '" data-subtask-id="' + id + '" title="برای ویرایش کلیک کنید">' + title + '</span>' +
                    '</div>' +
                    '<div class="feature-subtask-actions">' +
                    '<button type="button" class="feature-subtask-edit-btn" data-subtask-id="' + id + '" title="ویرایش" aria-label="ویرایش"><i class="bi bi-pencil"></i></button>' +
                    '<button type="button" class="feature-subtask-delete-btn" data-subtask-id="' + id + '" title="حذف" aria-label="حذف"><i class="bi bi-trash"></i></button>' +
                    '</div></li>';
            }).join('');
        }

        function beginFeatureSubtaskEdit(subtaskId) {
            var listEl = document.getElementById('featureInlineSubtasksList');
            if (!listEl) return;
            var li = listEl.querySelector('.feature-subtask-item[data-subtask-id="' + subtaskId + '"]');
            if (!li || li.querySelector('.feature-subtask-edit-input')) return;
            var titleSpan = li.querySelector('.feature-subtask-title');
            if (!titleSpan) return;
            var currentTitle = titleSpan.textContent.trim();
            var completed = titleSpan.classList.contains('completed');

            var input = document.createElement('textarea');
            input.className = 'form-control form-control-sm feature-subtask-edit-input';
            input.value = currentTitle;
            input.maxLength = 500;
            input.rows = Math.min(6, Math.max(2, (currentTitle.match(/\n/g) || []).length + 2));
            titleSpan.replaceWith(input);
            input.focus();
            input.setSelectionRange(input.value.length, input.value.length);

            var saving = false;
            var restoreTitle = function (text) {
                var span = document.createElement('span');
                span.className = 'feature-subtask-title editable' + (completed ? ' completed' : '');
                span.dataset.subtaskId = String(subtaskId);
                span.title = 'برای ویرایش کلیک کنید';
                span.textContent = text;
                input.replaceWith(span);
            };
            var cancelEdit = function () {
                if (saving) return;
                restoreTitle(currentTitle);
            };
            var commitEdit = async function () {
                if (saving) return;
                var noteEl = document.getElementById('featureInlineSubtaskNote');
                var newTitle = input.value.trim();
                if (!newTitle) {
                    if (noteEl) noteEl.textContent = 'عنوان کارک الزامی است.';
                    input.focus();
                    return;
                }
                if (newTitle === currentTitle) {
                    cancelEdit();
                    return;
                }
                saving = true;
                try {
                    if (noteEl) noteEl.textContent = 'در حال ذخیره...';
                    await updateFeatureSubtask(subtaskId, newTitle);
                    if (noteEl) noteEl.textContent = '';
                } catch (error) {
                    if (noteEl) noteEl.textContent = (error && error.message) || 'ویرایش کارک انجام نشد.';
                    saving = false;
                    restoreTitle(currentTitle);
                }
            };

            input.addEventListener('keydown', function (ev) {
                if (ev.key === 'Enter' && (ev.ctrlKey || ev.metaKey)) {
                    ev.preventDefault();
                    commitEdit();
                } else if (ev.key === 'Escape') {
                    ev.preventDefault();
                    cancelEdit();
                }
            });
            input.addEventListener('blur', function () {
                setTimeout(function () {
                    if (document.activeElement === input) return;
                    commitEdit();
                }, 120);
            });
        }

        async function updateFeatureSubtask(subtaskId, title) {
            var response = await fetch('/Tasks/UpdateInlineSubtask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ subtaskId: subtaskId, title: title })
            });
            if (!response.ok) {
                var errText = await response.text();
                throw new Error(errText || 'update_failed');
            }
            var result = await response.json();
            if (!result.success) throw new Error(result.message || 'update_failed');
            if (featureSubtaskParentId) await loadFeatureSubtasks(featureSubtaskParentId);
        }

        async function loadFeatureSubtasks(parentId) {
            var listEl = document.getElementById('featureInlineSubtasksList');
            if (!listEl) return;
            try {
                var response = await fetch('/Tasks/GetSubtasks?parentId=' + parentId, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!response.ok) throw new Error('load_failed');
                var data = await response.json();
                renderFeatureSubtasks(data);
            } catch {
                listEl.innerHTML = '<li class="feature-subtask-empty">خطا در دریافت کارک‌ها.</li>';
            }
        }

        async function addFeatureSubtask(parentId) {
            var input = document.getElementById('featureInlineSubtaskTitle');
            var noteEl = document.getElementById('featureInlineSubtaskNote');
            if (!input) return;
            var title = (input.value || '').trim();
            if (!title) {
                if (noteEl) noteEl.textContent = 'عنوان کارک الزامی است.';
                return;
            }
            try {
                if (noteEl) noteEl.textContent = 'در حال افزودن...';
                var response = await fetch('/Tasks/AddInlineSubtask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ parentId: parentId, title: title })
                });
                if (!response.ok) {
                    var err = await response.text();
                    throw new Error(err || 'add_failed');
                }
                input.value = '';
                if (noteEl) noteEl.textContent = '';
                await loadFeatureSubtasks(parentId);
            } catch (error) {
                if (noteEl) noteEl.textContent = (error && error.message) || 'افزودن کارک انجام نشد.';
            }
        }

        async function toggleFeatureSubtask(subtaskId) {
            var noteEl = document.getElementById('featureInlineSubtaskNote');
            try {
                var response = await fetch('/Tasks/ToggleInlineSubtask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ subtaskId: subtaskId })
                });
                if (!response.ok) {
                    var err = await response.text();
                    throw new Error(err || 'toggle_failed');
                }
                if (featureSubtaskParentId) await loadFeatureSubtasks(featureSubtaskParentId);
            } catch (error) {
                if (noteEl) noteEl.textContent = (error && error.message) || 'تغییر وضعیت کارک انجام نشد.';
                if (featureSubtaskParentId) await loadFeatureSubtasks(featureSubtaskParentId);
            }
        }

        async function deleteFeatureSubtask(subtaskId) {
            var noteEl = document.getElementById('featureInlineSubtaskNote');
            if (!confirm('این کارک حذف شود؟')) return;
            try {
                var response = await fetch('/Tasks/DeleteTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ taskId: subtaskId })
                });
                if (!response.ok) {
                    var err = await response.text();
                    throw new Error(err || 'delete_failed');
                }
                if (featureSubtaskParentId) await loadFeatureSubtasks(featureSubtaskParentId);
            } catch (error) {
                if (noteEl) noteEl.textContent = (error && error.message) || 'حذف کارک انجام نشد.';
            }
        }

        function ensureFeatureSubtaskUiBound() {
            if (featureSubtaskUiBound) return;
            var addBtn = document.getElementById('featureAddSubtaskBtn');
            var input = document.getElementById('featureInlineSubtaskTitle');
            var listEl = document.getElementById('featureInlineSubtasksList');
            if (!addBtn || !input) return;
            featureSubtaskUiBound = true;
            addBtn.addEventListener('click', function () {
                if (featureSubtaskParentId) addFeatureSubtask(featureSubtaskParentId);
            });
            input.addEventListener('keydown', function (ev) {
                if (ev.key === 'Enter' && (ev.ctrlKey || ev.metaKey)) {
                    ev.preventDefault();
                    if (featureSubtaskParentId) addFeatureSubtask(featureSubtaskParentId);
                }
            });
            if (listEl && !listEl.dataset.delegationBound) {
                listEl.dataset.delegationBound = '1';
                listEl.addEventListener('change', function (e) {
                    var t = e.target;
                    if (t.classList && t.classList.contains('feature-subtask-check')) {
                        var sid = parseInt(t.getAttribute('data-subtask-id'), 10);
                        if (sid) toggleFeatureSubtask(sid);
                    }
                });
                listEl.addEventListener('click', function (e) {
                    var editBtn = e.target.closest('.feature-subtask-edit-btn');
                    if (editBtn) {
                        e.preventDefault();
                        var sid = parseInt(editBtn.getAttribute('data-subtask-id'), 10);
                        if (sid) beginFeatureSubtaskEdit(sid);
                        return;
                    }
                    var titleEl = e.target.closest('.feature-subtask-title.editable');
                    if (titleEl) {
                        var sid2 = parseInt(titleEl.getAttribute('data-subtask-id'), 10);
                        if (sid2) beginFeatureSubtaskEdit(sid2);
                        return;
                    }
                    var btn = e.target.closest('.feature-subtask-delete-btn');
                    if (btn) {
                        var sid3 = parseInt(btn.getAttribute('data-subtask-id'), 10);
                        if (sid3) deleteFeatureSubtask(sid3);
                    }
                });
            }
        }

        function buildTaskActionsHtml(taskId, title) {
            var btn = document.createElement('div');
            btn.className = 'btn-group btn-group-sm';
            btn.innerHTML =
                '<button type="button" class="btn btn-outline-primary feature-edit-task-btn" title="ویرایش" data-task-id="' + taskId + '">' +
                '<i class="bi bi-pencil"></i></button>' +
                '<button type="button" class="btn btn-outline-danger feature-delete-task-btn" title="حذف" data-task-id="' + taskId + '" data-task-title="">' +
                '<i class="bi bi-trash"></i></button>';
            var deleteBtn = btn.querySelector('.feature-delete-task-btn');
            if (deleteBtn) deleteBtn.setAttribute('data-task-title', title || '');
            return btn.outerHTML;
        }

        function resetFeatureTaskAttachments() {
            var box = document.getElementById('featureTaskChatBox');
            var count = document.getElementById('featureTaskCommentCount');
            var messageInput = document.getElementById('featureTaskMessageInput');
            var fileInput = document.getElementById('featureTaskFileInput');
            var selectedFiles = document.getElementById('featureTaskSelectedFiles');
            var audioPreview = document.getElementById('featureTaskAudioPreview');
            var note = document.getElementById('featureTaskChatNote');
            if (box) box.innerHTML = '<div class="feature-task-chat-empty">هنوز پیوستی ثبت نشده است.</div>';
            if (count) count.textContent = '0';
            if (messageInput) messageInput.value = '';
            if (fileInput) fileInput.value = '';
            if (selectedFiles) selectedFiles.innerHTML = '';
            if (audioPreview) audioPreview.innerHTML = '';
            if (note) {
                note.textContent = '';
                note.classList.remove('error');
            }
            stopFeatureTaskRecording(true);
        }

        function resetFeatureTaskForm() {
            document.getElementById('featureTaskId').value = '';
            document.getElementById('featureTaskTitle').value = '';
            document.getElementById('featureTaskDescription').value = '';
            document.getElementById('featureTaskCategory').value = '';
            document.getElementById('featureTaskAssignee').value = '';
            document.getElementById('featureTaskStartDate').value = '';
            document.getElementById('featureTaskDurationDays').value = '';
            document.getElementById('featureTaskProjectIssueTypeId').value = defaultProjectIssueTypeId;
            document.getElementById('featureTaskIssueType').value = defaultIssueTypeBase;
            document.getElementById('featureTaskStoryPoints').value = '';
            if (effortSelect) effortSelect.value = '';
            if (effortDisplay) effortDisplay.textContent = 'تعیین نشده';
            originalFeatureTask = null;
            resetFeatureTaskAttachments();
            setFeatureChecklistVisible(false);
        }

        function setFeatureTaskModalMode(mode) {
            document.getElementById('featureTaskMode').value = mode;
            var titleEl = document.getElementById('featureTaskModalTitleText');
            var iconEl = document.getElementById('featureTaskModalIcon');
            var submitText = document.getElementById('featureTaskSubmitText');
            var submitBtn = document.getElementById('featureTaskSubmitBtn');
            var chatSection = document.getElementById('featureTaskChatSection');
            if (mode === 'edit') {
                if (titleEl) titleEl.textContent = 'جزئیات و ویرایش کار';
                if (iconEl) iconEl.className = 'bi bi-pencil-square me-2';
                if (submitText) submitText.textContent = 'ذخیره تغییرات';
                if (submitBtn) submitBtn.querySelector('i')?.setAttribute('class', 'bi bi-check-lg me-1');
                if (chatSection) chatSection.style.display = '';
            } else {
                if (titleEl) titleEl.textContent = 'افزودن کار جدید';
                if (iconEl) iconEl.className = 'bi bi-plus-circle me-2';
                if (submitText) submitText.textContent = 'افزودن کار';
                if (submitBtn) {
                    var icon = submitBtn.querySelector('i');
                    if (icon) icon.className = 'bi bi-plus-lg me-1';
                }
                if (chatSection) chatSection.style.display = 'none';
                setFeatureChecklistVisible(false);
            }
        }

        window.openFeatureCreateTask = function () {
            setFeatureTaskModalMode('create');
            resetFeatureTaskForm();
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('featureTaskModal'));
            modal.show();
            setTimeout(function () { document.getElementById('featureTaskTitle')?.focus(); }, 200);
        };

        window.openFeatureEditTask = async function (taskId) {
            if (!taskId) return;
            setFeatureTaskModalMode('edit');
            resetFeatureTaskForm();
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('featureTaskModal'));
            modal.show();

            try {
                var response = await fetch('/Tasks/GetTaskDetails?id=' + taskId);
                var taskData = await response.json();
                if (!response.ok || !taskData.success) {
                    throw new Error(taskData.message || 'خطا در دریافت اطلاعات کار');
                }

                originalFeatureTask = taskData;
                document.getElementById('featureTaskId').value = taskData.id;
                document.getElementById('featureTaskProjectId').value = taskData.projectId;
                document.getElementById('featureTaskProjectIssueTypeId').value = taskData.projectIssueTypeId || '';
                document.getElementById('featureTaskIssueType').value = taskData.issueType || defaultIssueTypeBase;
                document.getElementById('featureTaskTitle').value = taskData.title || '';
                document.getElementById('featureTaskDescription').value = taskData.description || '';
                document.getElementById('featureTaskStartDate').value = taskData.startDateSh || '';
                document.getElementById('featureTaskDurationDays').value =
                    taskData.durationDays == null ? '' : String(taskData.durationDays);
                document.getElementById('featureTaskCategory').value = taskData.categoryId || '';
                document.getElementById('featureTaskAssignee').value = taskData.assignedUserId || '';
                document.getElementById('featureTaskStoryPoints').value =
                    taskData.storyPoints == null ? '' : String(taskData.storyPoints);

                var effort = mapStoryPointsToEffortLevel(taskData.storyPoints);
                if (effortSelect) effortSelect.value = effort;
                if (effortDisplay) effortDisplay.textContent = effortLabels[effort] || 'تعیین نشده';
                loadFeatureTaskChat(taskId);
                if (isFeatureTaskTypeForChecklist(taskData.issueType)) {
                    setFeatureChecklistVisible(true, taskId);
                } else {
                    setFeatureChecklistVisible(false);
                }
            } catch (err) {
                alert(err.message || 'خطا در بارگذاری کار');
                bootstrap.Modal.getInstance(document.getElementById('featureTaskModal'))?.hide();
            }
        };

        var featureTaskMediaRecorder = null;
        var featureTaskAudioChunks = [];
        var featureTaskRecordingStream = null;
        var featureTaskTimerInterval = null;
        var featureTaskRecordingStartTime = null;
        var featureTaskAntiForgeryToken = document.getElementById('featureTaskAntiForgery')?.value || '@featureTaskAntiforgeryToken';

        function normalizeFeatureAttachmentUrl(rawUrl) {
            if (!rawUrl) return '';
            var value = String(rawUrl).trim();
            if (!value) return '';
            if (/^https?:\/\//i.test(value) || value.startsWith('blob:') || value.startsWith('data:')) return value;
            return value.startsWith('/') ? value : '/' + value;
        }

        function isFeatureImageAttachment(att) {
            var fileType = String(att?.fileType || att?.mimeType || '').toLowerCase();
            var fileName = String(att?.fileName || '').toLowerCase();
            return fileType.includes('image') || /\.(png|jpe?g|gif|webp|bmp|svg)$/i.test(fileName);
        }

        function isFeatureAudioAttachment(att) {
            var fileType = String(att?.fileType || att?.mimeType || '').toLowerCase();
            var fileName = String(att?.fileName || '').toLowerCase();
            return fileType.includes('audio') || /\.(mp3|wav|ogg|m4a|webm|aac)$/i.test(fileName);
        }

        function formatFeatureChatDateTime(value) {
            if (!value) return '';
            var parsed = new Date(value);
            if (Number.isNaN(parsed.getTime())) return escapeHtml(String(value));
            return new Intl.DateTimeFormat('fa-IR', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            }).format(parsed);
        }

        function setFeatureTaskChatNote(text, isError) {
            var note = document.getElementById('featureTaskChatNote');
            if (!note) return;
            note.textContent = text || '';
            note.classList.toggle('error', !!isError);
        }

        function renderFeatureTaskChat(comments) {
            var boxEl = document.getElementById('featureTaskChatBox');
            var countEl = document.getElementById('featureTaskCommentCount');
            if (!boxEl) return;

            var items = Array.isArray(comments) ? comments : [];
            if (countEl) countEl.textContent = String(items.length);

            if (items.length === 0) {
                boxEl.innerHTML = '<div class="feature-task-chat-empty">هنوز پیوستی ثبت نشده است.</div>';
                return;
            }

            boxEl.innerHTML = items.map(function (comment) {
                var userName = escapeHtml(comment.userName || 'کاربر');
                var createdAt = formatFeatureChatDateTime(comment.createdAt);
                var messageText = escapeHtml(comment.message || '');
                var commentId = Number(comment.id || 0);
                var canDelete = Boolean(comment.isCurrentUser);
                var sideClass = canDelete ? 'own' : 'other';
                var userBadge = canDelete ? '<span class="feature-task-chat-user-badge">شما</span>' : '';
                var attachments = Array.isArray(comment.attachments) ? comment.attachments : [];
                var attachmentsHtml = attachments.map(function (att) {
                    var fileName = escapeHtml(att.fileName || 'فایل');
                    var fileUrl = normalizeFeatureAttachmentUrl(att.filePath || att.url || '');
                    if (isFeatureImageAttachment(att)) {
                        var safeUrl = escapeHtml(fileUrl);
                        return '<div class="feature-task-chat-attachment"><i class="bi bi-image"></i>' +
                            '<a href="' + safeUrl + '" target="_blank" rel="noopener noreferrer">' + fileName + '</a></div>' +
                            '<div class="feature-task-chat-attachment">' +
                            '<button type="button" class="feature-task-chat-image-thumb" data-image-url="' + safeUrl + '" data-image-name="' + fileName + '" title="نمایش بزرگ">' +
                            '<img src="' + safeUrl + '" alt="' + fileName + '" onerror="this.style.display=\'none\';" />' +
                            '</button></div>';
                    }
                    if (isFeatureAudioAttachment(att)) {
                        return '<div class="feature-task-chat-attachment"><i class="bi bi-mic"></i>' +
                            '<a href="' + fileUrl + '" target="_blank" rel="noopener noreferrer">' + fileName + '</a></div>' +
                            '<div class="feature-task-chat-attachment"><audio controls src="' + fileUrl + '"></audio></div>';
                    }
                    return '<div class="feature-task-chat-attachment"><i class="bi bi-paperclip"></i>' +
                        '<a href="' + fileUrl + '" target="_blank" rel="noopener noreferrer">' + fileName + '</a></div>';
                }).join('');

                return '<div class="feature-task-chat-message ' + sideClass + '">' +
                    '<div class="feature-task-chat-card">' +
                    '<div class="feature-task-chat-meta"><span>' + userName + userBadge + '</span>' +
                    '<span class="feature-task-chat-meta-right"><span>' + createdAt + '</span>' +
                    (canDelete && commentId
                        ? '<button type="button" class="feature-task-chat-delete" data-comment-id="' + commentId + '">حذف</button>'
                        : '') +
                    '</span></div>' +
                    (messageText ? '<div class="feature-task-chat-text">' + messageText + '</div>' : '') +
                    (attachmentsHtml ? '<div class="feature-task-chat-attachments">' + attachmentsHtml + '</div>' : '') +
                    '</div></div>';
            }).join('');

            boxEl.scrollTop = boxEl.scrollHeight;
        }

        async function loadFeatureTaskChat(taskId) {
            var boxEl = document.getElementById('featureTaskChatBox');
            if (!boxEl || !taskId) return;
            boxEl.innerHTML = '<div class="feature-task-chat-empty">در حال بارگذاری...</div>';
            try {
                var response = await fetch('/Tasks/GetComments?taskId=' + taskId, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!response.ok) throw new Error('خطا در دریافت پیوست‌ها');
                var comments = await response.json();
                renderFeatureTaskChat(comments);
            } catch (err) {
                boxEl.innerHTML = '<div class="feature-task-chat-empty">' + escapeHtml(err.message || 'خطا در دریافت پیوست‌ها') + '</div>';
                var countEl = document.getElementById('featureTaskCommentCount');
                if (countEl) countEl.textContent = '0';
            }
        }

        function showFeatureTaskSelectedFiles() {
            var fileInput = document.getElementById('featureTaskFileInput');
            var selectedFilesDiv = document.getElementById('featureTaskSelectedFiles');
            if (!fileInput || !selectedFilesDiv) return;
            selectedFilesDiv.innerHTML = '';
            Array.from(fileInput.files || []).forEach(function (file) {
                var wrapper = document.createElement('div');
                wrapper.className = 'feature-task-file-preview-item';
                if (file.type && file.type.startsWith('image/')) {
                    var img = document.createElement('img');
                    img.src = URL.createObjectURL(file);
                    wrapper.appendChild(img);
                } else {
                    var icon = document.createElement('span');
                    icon.textContent = '📎';
                    wrapper.appendChild(icon);
                }
                var nameSpan = document.createElement('span');
                nameSpan.textContent = file.name;
                nameSpan.style.flex = '1';
                wrapper.appendChild(nameSpan);
                var removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.textContent = '✕';
                removeBtn.addEventListener('click', function () {
                    removeFeatureTaskSelectedFile(file.name);
                });
                wrapper.appendChild(removeBtn);
                selectedFilesDiv.appendChild(wrapper);
            });
            syncFeatureTaskAudioPreview();
        }

        function removeFeatureTaskSelectedFile(fileName) {
            var fileInput = document.getElementById('featureTaskFileInput');
            if (!fileInput) return;
            var dt = new DataTransfer();
            Array.from(fileInput.files || []).forEach(function (f) {
                if (f.name !== fileName) dt.items.add(f);
            });
            fileInput.files = dt.files;
            showFeatureTaskSelectedFiles();
        }

        function syncFeatureTaskAudioPreview() {
            var fileInput = document.getElementById('featureTaskFileInput');
            var preview = document.getElementById('featureTaskAudioPreview');
            if (!fileInput || !preview) return;
            var hasAudio = Array.from(fileInput.files || []).some(function (f) {
                return (f.type || '').startsWith('audio/');
            });
            if (!hasAudio) preview.innerHTML = '';
        }

        function addFeatureTaskFileToInput(file) {
            var fileInput = document.getElementById('featureTaskFileInput');
            if (!fileInput) return;
            var dt = new DataTransfer();
            Array.from(fileInput.files || []).forEach(function (f) { dt.items.add(f); });
            dt.items.add(file);
            fileInput.files = dt.files;
            showFeatureTaskSelectedFiles();
        }

        function stopFeatureTaskRecording(silent) {
            if (featureTaskMediaRecorder && featureTaskMediaRecorder.state === 'recording') {
                featureTaskMediaRecorder.stop();
            }
            if (featureTaskTimerInterval) {
                clearInterval(featureTaskTimerInterval);
                featureTaskTimerInterval = null;
            }
            var recordBtn = document.getElementById('featureTaskRecordBtn');
            var recordText = document.getElementById('featureTaskRecordText');
            var recordTimer = document.getElementById('featureTaskRecordTimer');
            if (recordBtn) recordBtn.classList.remove('recording');
            if (recordText) recordText.textContent = 'ضبط ویس';
            if (recordTimer) recordTimer.textContent = '';
            if (featureTaskRecordingStream) {
                featureTaskRecordingStream.getTracks().forEach(function (t) { t.stop(); });
                featureTaskRecordingStream = null;
            }
            if (silent) {
                featureTaskMediaRecorder = null;
                featureTaskAudioChunks = [];
            }
        }

        async function toggleFeatureTaskRecording() {
            var recordBtn = document.getElementById('featureTaskRecordBtn');
            var recordText = document.getElementById('featureTaskRecordText');
            var recordTimer = document.getElementById('featureTaskRecordTimer');
            var audioPreview = document.getElementById('featureTaskAudioPreview');
            if (!recordBtn || !recordText || !recordTimer) return;

            if (featureTaskMediaRecorder && featureTaskMediaRecorder.state === 'recording') {
                stopFeatureTaskRecording(false);
                return;
            }

            try {
                featureTaskRecordingStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                var mimeType = MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm'
                    : (MediaRecorder.isTypeSupported('audio/mp4') ? 'audio/mp4' : 'audio/wav');
                featureTaskAudioChunks = [];
                featureTaskMediaRecorder = new MediaRecorder(featureTaskRecordingStream, { mimeType: mimeType });
                featureTaskMediaRecorder.ondataavailable = function (e) {
                    if (e.data && e.data.size > 0) featureTaskAudioChunks.push(e.data);
                };
                featureTaskMediaRecorder.onstop = function () {
                    if (featureTaskAudioChunks.length === 0) {
                        setFeatureTaskChatNote('فایل صوتی خالی است.', true);
                        return;
                    }
                    var blob = new Blob(featureTaskAudioChunks, { type: mimeType });
                    var url = URL.createObjectURL(blob);
                    if (audioPreview) {
                        audioPreview.innerHTML = '';
                        var audioEl = document.createElement('audio');
                        audioEl.controls = true;
                        audioEl.src = url;
                        audioPreview.appendChild(audioEl);
                    }
                    var extension = mimeType === 'audio/mp4' ? 'm4a' : 'webm';
                    var file = new File([blob], 'voice_' + Date.now() + '.' + extension, { type: mimeType });
                    addFeatureTaskFileToInput(file);
                    if (featureTaskRecordingStream) {
                        featureTaskRecordingStream.getTracks().forEach(function (t) { t.stop(); });
                        featureTaskRecordingStream = null;
                    }
                };
                featureTaskMediaRecorder.start(100);
                featureTaskRecordingStartTime = Date.now();
                recordBtn.classList.add('recording');
                recordText.textContent = 'توقف';
                featureTaskTimerInterval = setInterval(function () {
                    var elapsed = Math.floor((Date.now() - featureTaskRecordingStartTime) / 1000);
                    var m = String(Math.floor(elapsed / 60)).padStart(2, '0');
                    var s = String(elapsed % 60).padStart(2, '0');
                    recordTimer.textContent = m + ':' + s;
                }, 1000);
            } catch (err) {
                setFeatureTaskChatNote('خطا در دسترسی به میکروفن: ' + (err.message || ''), true);
            }
        }

        async function sendFeatureTaskChat() {
            var taskId = parseInt(document.getElementById('featureTaskId')?.value || '0', 10);
            var messageInput = document.getElementById('featureTaskMessageInput');
            var fileInput = document.getElementById('featureTaskFileInput');
            var sendBtn = document.getElementById('featureTaskSendBtn');
            if (!taskId) {
                setFeatureTaskChatNote('ابتدا کار را ذخیره کنید، سپس پیوست اضافه کنید.', true);
                return;
            }
            if (!messageInput || !fileInput || !sendBtn) return;

            var message = (messageInput.value || '').trim();
            var files = Array.from(fileInput.files || []);
            if (!message && files.length === 0) {
                setFeatureTaskChatNote('حداقل یک پیام یا پیوست وارد کنید.', true);
                return;
            }

            var formData = new FormData();
            formData.append('TaskId', String(taskId));
            formData.append('Message', message);
            formData.append('__RequestVerificationToken', featureTaskAntiForgeryToken);
            files.forEach(function (file) { formData.append('Attachments', file); });

            try {
                sendBtn.disabled = true;
                setFeatureTaskChatNote('در حال ارسال...');
                var response = await fetch('/Tasks/PostComment', {
                    method: 'POST',
                    headers: { RequestVerificationToken: featureTaskAntiForgeryToken },
                    body: formData
                });
                if (!response.ok) {
                    var rawError = await response.text();
                    throw new Error(rawError || ('HTTP ' + response.status));
                }
                messageInput.value = '';
                fileInput.value = '';
                document.getElementById('featureTaskSelectedFiles').innerHTML = '';
                document.getElementById('featureTaskAudioPreview').innerHTML = '';
                setFeatureTaskChatNote('');
                await loadFeatureTaskChat(taskId);
            } catch (err) {
                setFeatureTaskChatNote(err.message ? ('ارسال انجام نشد: ' + err.message) : 'ارسال انجام نشد.', true);
            } finally {
                sendBtn.disabled = false;
            }
        }

        async function deleteFeatureTaskComment(commentId) {
            if (!commentId || !confirm('این پیام/پیوست حذف شود؟')) return;
            var taskId = parseInt(document.getElementById('featureTaskId')?.value || '0', 10);
            var formData = new FormData();
            formData.append('commentId', String(commentId));
            formData.append('__RequestVerificationToken', featureTaskAntiForgeryToken);
            try {
                setFeatureTaskChatNote('در حال حذف...');
                var response = await fetch('/Tasks/DeleteComment', {
                    method: 'POST',
                    body: formData
                });
                if (!response.ok) {
                    var rawError = await response.text();
                    throw new Error(rawError || ('HTTP ' + response.status));
                }
                setFeatureTaskChatNote('');
                if (taskId) await loadFeatureTaskChat(taskId);
            } catch (err) {
                setFeatureTaskChatNote(err.message ? ('حذف انجام نشد: ' + err.message) : 'حذف انجام نشد.', true);
            }
        }

        document.getElementById('featureTaskFileInput')?.addEventListener('change', showFeatureTaskSelectedFiles);
        document.getElementById('featureTaskSendBtn')?.addEventListener('click', sendFeatureTaskChat);
        document.getElementById('featureTaskRecordBtn')?.addEventListener('click', toggleFeatureTaskRecording);
        document.getElementById('featureTaskMessageInput')?.addEventListener('keydown', function (event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendFeatureTaskChat();
            }
        });
        document.getElementById('featureTaskMessageInput')?.addEventListener('paste', function (event) {
            if (!event.clipboardData || !event.clipboardData.items) return;
            var handled = false;
            for (var i = 0; i < event.clipboardData.items.length; i++) {
                var item = event.clipboardData.items[i];
                if (item.kind !== 'file') continue;
                var file = item.getAsFile();
                if (!file) continue;
                if (!file.name || file.name === 'image.png' || file.name === 'blob') {
                    var ext = (file.type.split('/')[1] || 'png').replace('jpeg', 'jpg');
                    if (!ext || ext === 'plain') ext = 'bin';
                    file = new File([file], 'clipboard-' + Date.now() + '-' + i + '.' + ext, { type: file.type || 'application/octet-stream' });
                }
                addFeatureTaskFileToInput(file);
                handled = true;
            }
            if (handled) event.preventDefault();
        });
        document.getElementById('featureTaskChatBox')?.addEventListener('click', function (event) {
            var btn = event.target.closest('.feature-task-chat-delete');
            if (!btn) return;
            var commentId = parseInt(btn.getAttribute('data-comment-id') || '0', 10);
            if (commentId) deleteFeatureTaskComment(commentId);
        });

        function getFeatureTasksSortDir() {
            var btn = document.getElementById('featureTasksSortToggle');
            return (btn && btn.getAttribute('data-sort') === 'asc') ? 'asc' : 'desc';
        }

        function updateFeatureTasksSortButton() {
            var btn = document.getElementById('featureTasksSortToggle');
            if (!btn) return;
            var dir = getFeatureTasksSortDir();
            var icon = btn.querySelector('i');
            var label = btn.querySelector('.feature-tasks-sort-label');
            if (dir === 'asc') {
                if (icon) icon.className = 'bi bi-sort-up';
                if (label) label.textContent = 'قدیمی‌تر';
                btn.title = 'مرتب‌سازی: قدیمی‌تر — کلیک برای جدیدتر';
            } else {
                if (icon) icon.className = 'bi bi-sort-down';
                if (label) label.textContent = 'جدیدتر اول';
                btn.title = 'مرتب‌سازی: جدیدتر — کلیک برای قدیمی‌تر';
            }
        }

        function sortFeatureTasksTable() {
            var body = document.getElementById('featureTasksTableBody');
            if (!body) return;
            var dir = getFeatureTasksSortDir();
            var rows = Array.from(body.querySelectorAll('tr'));
            rows.sort(function (a, b) {
                var aMs = parseInt(a.getAttribute('data-created-at') || '0', 10);
                var bMs = parseInt(b.getAttribute('data-created-at') || '0', 10);
                return dir === 'asc' ? (aMs - bMs) : (bMs - aMs);
            });
            rows.forEach(function (row) { body.appendChild(row); });
        }

        document.getElementById('featureTasksSortToggle')?.addEventListener('click', function () {
            var next = getFeatureTasksSortDir() === 'desc' ? 'asc' : 'desc';
            this.setAttribute('data-sort', next);
            updateFeatureTasksSortButton();
            sortFeatureTasksTable();
        });
        updateFeatureTasksSortButton();

        window.openFeatureDeleteTask = function (taskId, title) {
            document.getElementById('featureDeleteTaskId').value = taskId;
            document.getElementById('featureDeleteTaskTitle').textContent = title || '';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('featureDeleteTaskModal')).show();
        };

        function appendFeatureTaskRow(task) {
            var empty = document.getElementById('featureTasksEmpty');
            var wrap = document.getElementById('featureTasksTableWrap');
            var body = document.getElementById('featureTasksTableBody');
            if (!body || !wrap) return;

            if (empty) empty.classList.add('d-none');
            wrap.classList.remove('d-none');

            var sprintHtml = task.inSprint
                ? '<span class="badge bg-info text-dark">' + escapeHtml(task.sprintName || 'اسپرینت') + '</span>'
                : '<span class="text-muted">خارج از اسپرینت</span>';
            var completedBadge = task.isCompleted ? ' <span class="badge bg-success ms-1">انجام‌شده</span>' : '';
            var createdAtMs = task.createdAtMs
                || (task.createdAt ? Date.parse(task.createdAt) : Date.now());
            if (Number.isNaN(createdAtMs)) createdAtMs = Date.now();

            var tr = document.createElement('tr');
            tr.setAttribute('data-task-id', task.taskId);
            tr.setAttribute('data-created-at', String(createdAtMs));
            tr.innerHTML =
                '<td><code>' + escapeHtml(task.issueKey || '—') + '</code></td>' +
                '<td>' + escapeHtml(task.title || '') + completedBadge + '</td>' +
                '<td>' + escapeHtml(task.assignedUserName || '—') + '</td>' +
                '<td>' + sprintHtml + '</td>' +
                '<td class="text-end">' + buildTaskActionsHtml(task.taskId, task.title) + '</td>';
            body.appendChild(tr);
            sortFeatureTasksTable();
        }

        function updateFeatureTaskRow(taskId, data) {
            var row = document.querySelector('#featureTasksTableBody tr[data-task-id="' + taskId + '"]');
            if (!row) return;

            row.setAttribute('data-task-id', taskId);
            var cells = row.children;
            if (cells.length < 5) return;
            cells[1].innerHTML = escapeHtml(data.title || '');
            cells[2].textContent = data.assignedUserName || '—';
            cells[4].innerHTML = buildTaskActionsHtml(taskId, data.title);
        }

        function removeFeatureTaskRow(taskId) {
            var row = document.querySelector('#featureTasksTableBody tr[data-task-id="' + taskId + '"]');
            if (row) row.remove();

            var body = document.getElementById('featureTasksTableBody');
            if (body && body.children.length === 0) {
                var empty = document.getElementById('featureTasksEmpty');
                var wrap = document.getElementById('featureTasksTableWrap');
                if (wrap) wrap.classList.add('d-none');
                if (empty) empty.classList.remove('d-none');
                else {
                    var cardBody = document.getElementById('featureTasksCardBody');
                    if (cardBody && !document.getElementById('featureTasksEmpty')) {
                        var p = document.createElement('p');
                        p.id = 'featureTasksEmpty';
                        p.className = 'text-muted p-3 mb-0';
                        p.textContent = 'هنوز تسکی به این فیچر متصل نشده است. تسک‌ها می‌توانند داخل یا خارج اسپرینت باشند.';
                        cardBody.prepend(p);
                    }
                }
            }
        }

        // mark existing server-rendered rows
        document.querySelectorAll('#featureTasksTableBody tr').forEach(function (row) {
            var btn = row.querySelector('[data-task-id]');
            if (btn) row.setAttribute('data-task-id', btn.getAttribute('data-task-id'));
        });

        document.getElementById('featureTasksCardBody')?.addEventListener('click', function (event) {
            var editBtn = event.target.closest('.feature-edit-task-btn');
            if (editBtn) {
                var editId = parseInt(editBtn.getAttribute('data-task-id'), 10);
                if (editId) openFeatureEditTask(editId);
                return;
            }

            var deleteBtn = event.target.closest('.feature-delete-task-btn');
            if (deleteBtn) {
                var deleteId = parseInt(deleteBtn.getAttribute('data-task-id'), 10);
                var deleteTitle = deleteBtn.getAttribute('data-task-title') || '';
                if (deleteId) openFeatureDeleteTask(deleteId, deleteTitle);
            }
        });

        document.getElementById('featureTaskSubmitBtn')?.addEventListener('click', async function () {
            var mode = document.getElementById('featureTaskMode').value || 'create';
            var title = (document.getElementById('featureTaskTitle')?.value || '').trim();
            if (!title) {
                alert('عنوان کار الزامی است.');
                document.getElementById('featureTaskTitle')?.focus();
                return;
            }

            var btn = document.getElementById('featureTaskSubmitBtn');
            var original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال ذخیره...';

            try {
                if (mode === 'edit') {
                    var taskId = parseInt(document.getElementById('featureTaskId').value, 10);
                    var issueType = document.getElementById('featureTaskIssueType').value;
                    if (!issueType) throw new Error('نوع کار نامعتبر است.');

                    var formData = {
                        Id: taskId,
                        Title: title,
                        Description: document.getElementById('featureTaskDescription').value || '',
                        IssueType: parseInt(issueType, 10),
                        ProjectIssueTypeId: document.getElementById('featureTaskProjectIssueTypeId').value
                            ? parseInt(document.getElementById('featureTaskProjectIssueTypeId').value, 10) : null,
                        ProjectId: parseInt(document.getElementById('featureTaskProjectId').value, 10),
                        StartDateSh: (document.getElementById('featureTaskStartDate').value || '').trim(),
                        DurationDays: (function () {
                            var raw = document.getElementById('featureTaskDurationDays')?.value;
                            if (raw === '' || raw == null) return null;
                            var n = parseInt(raw, 10);
                            return Number.isNaN(n) ? null : n;
                        })(),
                        CategoryId: document.getElementById('featureTaskCategory').value
                            ? parseInt(document.getElementById('featureTaskCategory').value, 10) : null,
                        FeatureId: parseInt(document.getElementById('featureTaskFeatureId').value, 10),
                        AssignedUserId: document.getElementById('featureTaskAssignee').value || null,
                        EffortLevel: document.getElementById('featureTaskEffort').value
                            ? parseInt(document.getElementById('featureTaskEffort').value, 10) : null,
                        StoryPoints: document.getElementById('featureTaskStoryPoints').value
                            ? parseInt(document.getElementById('featureTaskStoryPoints').value, 10)
                            : (originalFeatureTask?.storyPoints ?? null)
                    };

                    var editResponse = await fetch('/Tasks/EditFromBoard', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify(formData),
                        credentials: 'same-origin'
                    });
                    var editResult = await editResponse.json();
                    if (!editResponse.ok || !editResult.success) {
                        throw new Error(editResult.message || 'خطا در ویرایش کار');
                    }

                    var assigneeSelect = document.getElementById('featureTaskAssignee');
                    var assigneeName = formData.AssignedUserId
                        ? (assigneeSelect.options[assigneeSelect.selectedIndex]?.text || '—')
                        : '—';
                    updateFeatureTaskRow(taskId, { title: formData.Title, assignedUserName: assigneeName });
                    bootstrap.Modal.getInstance(document.getElementById('featureTaskModal'))?.hide();
                } else {
                    var payload = {
                        projectId: parseInt(document.getElementById('featureTaskProjectId').value, 10),
                        featureId: parseInt(document.getElementById('featureTaskFeatureId').value, 10),
                        title: title,
                        description: document.getElementById('featureTaskDescription').value || '',
                        categoryId: document.getElementById('featureTaskCategory').value
                            ? parseInt(document.getElementById('featureTaskCategory').value, 10) : null,
                        assignedUserId: document.getElementById('featureTaskAssignee').value || null,
                        startDateSh: (document.getElementById('featureTaskStartDate').value || '').trim(),
                        durationDays: (function () {
                            var raw = document.getElementById('featureTaskDurationDays')?.value;
                            if (raw === '' || raw == null) return null;
                            var n = parseInt(raw, 10);
                            return Number.isNaN(n) ? null : n;
                        })(),
                        effortLevel: document.getElementById('featureTaskEffort').value
                            ? parseInt(document.getElementById('featureTaskEffort').value, 10) : null
                    };
                    var pit = document.getElementById('featureTaskProjectIssueTypeId').value;
                    if (pit) payload.projectIssueTypeId = parseInt(pit, 10);

                    var createResponse = await fetch('/Tasks/CreateForFeature', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    var createResult = await createResponse.json();
                    if (!createResponse.ok || !createResult.success) {
                        throw new Error(createResult.message || 'خطا در افزودن کار');
                    }

                    appendFeatureTaskRow(createResult);
                    setFeatureTaskModalMode('edit');
                    document.getElementById('featureTaskId').value = createResult.taskId || '';
                    resetFeatureTaskAttachments();
                    if (createResult.taskId) {
                        loadFeatureTaskChat(createResult.taskId);
                        if (isFeatureTaskTypeForChecklist(document.getElementById('featureTaskIssueType').value)) {
                            setFeatureChecklistVisible(true, createResult.taskId);
                        }
                    }
                    setFeatureTaskChatNote('کار ایجاد شد. می‌توانید پیوست اضافه کنید.');
                }
            } catch (err) {
                alert(err.message || 'خطا در ذخیره کار');
            } finally {
                btn.disabled = false;
                btn.innerHTML = original;
            }
        });

        document.getElementById('featureDeleteTaskConfirmBtn')?.addEventListener('click', async function () {
            var taskId = parseInt(document.getElementById('featureDeleteTaskId').value, 10);
            if (!taskId) return;

            var btn = this;
            var original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال حذف...';

            try {
                var response = await fetch('/Tasks/DeleteTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ taskId: taskId })
                });
                var result = await response.json().catch(function () { return {}; });
                if (!response.ok || result.success === false) {
                    throw new Error(result.message || 'خطا در حذف کار');
                }

                removeFeatureTaskRow(taskId);
                bootstrap.Modal.getInstance(document.getElementById('featureDeleteTaskModal'))?.hide();
            } catch (err) {
                alert(err.message || 'خطا در حذف کار');
            } finally {
                btn.disabled = false;
                btn.innerHTML = original;
            }
        });
    })();
</script>