<div class="modal fade" id="addApiContractModal" tabindex="-1" aria-labelledby="addApiContractModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="AddApiContract" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="FeatureId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="addApiContractModalLabel">
                        <i class="bi bi-plus-circle me-1"></i> افزودن قرارداد API
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Method <span class="text-danger">*</span></label>
                            <select class="form-select" name="HttpMethod" required>
                                <option>GET</option>
                                <option>POST</option>
                                <option>PUT</option>
                                <option>PATCH</option>
                                <option>DELETE</option>
                            </select>
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Endpoint <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="Endpoint" maxlength="500" required placeholder="/api/products" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Request</label>
                            <textarea class="form-control" name="RequestDescription" rows="3" maxlength="4000"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Response</label>
                            <textarea class="form-control" name="ResponseDescription" rows="3" maxlength="4000"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Error Response</label>
                            <textarea class="form-control" name="ErrorResponseDescription" rows="2" maxlength="4000"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status Codes</label>
                            <input type="text" class="form-control" name="StatusCodes" maxlength="200" placeholder="200, 400, 401, 404" />
                        </div>
                        <div class="col-12">
                            <div class="row g-3 api-query-params">
                                <div class="col-md-4">
                                    <div class="api-param-block">
                                        <div class="d-flex justify-content-between align-items-center api-param-header">
                                            <label class="form-label mb-0 fw-semibold">Pagination</label>
                                            <button type="button" class="btn btn-sm btn-outline-primary" data-param-add="addApiPaginationList" title="افزودن">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                        <div id="addApiPaginationList" class="api-param-list" data-placeholder="مثلاً page"></div>
                                        <input type="hidden" name="Pagination" id="addApiPagination" />
                                        <small class="text-muted form-text-example">مثال: page, pageSize</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="api-param-block">
                                        <div class="d-flex justify-content-between align-items-center api-param-header">
                                            <label class="form-label mb-0 fw-semibold">Filter</label>
                                            <button type="button" class="btn btn-sm btn-outline-primary" data-param-add="addApiFilterList" title="افزودن">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                        <div id="addApiFilterList" class="api-param-list" data-placeholder="مثلاً status"></div>
                                        <input type="hidden" name="Filter" id="addApiFilter" />
                                        <small class="text-muted form-text-example">مثال: status, search</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="api-param-block">
                                        <div class="d-flex justify-content-between align-items-center api-param-header">
