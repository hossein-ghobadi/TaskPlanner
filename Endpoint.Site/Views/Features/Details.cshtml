        border-radius: 50%;
        color: #fff;
        font-size: 0.85rem;
        cursor: pointer;
    }
    #featureTaskModal .feature-subtask-edit-btn { background: #3b82f6; }
    #featureTaskModal .feature-subtask-edit-btn:hover { background: #2563eb; }
    #featureTaskModal .feature-subtask-delete-btn { background: #ef4444; }
    #featureTaskModal .feature-subtask-delete-btn:hover { background: #dc2626; }
    #featureTaskModal .feature-subtask-empty {
        border: 1px dashed #d1d5db;
        border-radius: 10px;
        padding: 0.55rem;
        font-size: 0.82rem;
        color: #6b7280;
        background: #f9fafb;
        text-align: center;
    }
    #featureTaskModal .feature-subtask-note {
        margin-top: 0.35rem;
        font-size: 0.8rem;
        color: #6b7280;
    }
</style>

<div class="modal fade" id="featureTaskModal" tabindex="-1" aria-labelledby="featureTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="featureTaskModalLabel">
                    <i class="bi bi-plus-circle me-2" id="featureTaskModalIcon"></i>
                    <span id="featureTaskModalTitleText">افزودن کار جدید</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="featureTaskMode" value="create" />
                <input type="hidden" id="featureTaskId" value="" />
                <input type="hidden" id="featureTaskProjectId" value="@Model.ProjectId" />
                <input type="hidden" id="featureTaskFeatureId" value="@Model.Id" />
                <input type="hidden" id="featureTaskProjectIssueTypeId" value="@(defaultProjectIssueTypeId?.ToString() ?? "")" />
                <input type="hidden" id="featureTaskIssueType" value="@defaultIssueTypeBase" />
                <input type="hidden" id="featureTaskStoryPoints" value="" />

                <div class="row g-3">
                    <div class="col-lg-8">
                        <div class="feature-task-main-card">
                            <div class="mb-3">
                                <label for="featureTaskTitle" class="form-label">عنوان کار <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="featureTaskTitle" required placeholder="عنوان کار را وارد کنید" />
                            </div>
                            <div class="mb-3">
                                <label for="featureTaskDescription" class="form-label">توضیحات</label>
                                <textarea class="form-control" id="featureTaskDescription" rows="5" placeholder="توضیحات کار را وارد کنید"></textarea>
                            </div>

                            <div class="feature-checklist-card" id="featureChecklistPanel" style="display:none;" aria-label="چک لیست کارک‌ها">
                                <div class="feature-checklist-header">
                                    <div class="feature-checklist-title">
                                        <i class="bi bi-list-check"></i>
                                        چک لیست
                                    </div>
                                    <span class="feature-checklist-progress" id="featureSubtaskProgressBadge">0/0</span>
                                </div>
                                <div class="feature-subtask-input-row">
                                    <textarea id="featureInlineSubtaskTitle" class="form-control" rows="2" placeholder="عنوان کارک..."></textarea>
                                    <button type="button" id="featureAddSubtaskBtn" class="btn btn-sm btn-primary">افزودن</button>
                                </div>
                                <ul id="featureInlineSubtasksList" class="feature-subtask-list"></ul>
                                <div id="featureInlineSubtaskNote" class="feature-subtask-note"></div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">سطح کار</label>
                                <div class="form-control bg-light" id="featureTaskEffortDisplay">تعیین نشده</div>
                                <small class="text-muted">برای تغییر، از ستون اطلاعات استفاده کنید.</small>
                            </div>

                            <div class="feature-task-chat mt-3" id="featureTaskChatSection" style="display: none;">
                                <div class="feature-task-chat-header">
                                    <h5>
                                        <i class="bi bi-paperclip"></i>
                                        پیوست
                                    </h5>
                                    <span class="feature-task-chat-count" id="featureTaskCommentCount">0</span>
                                </div>
                                <div class="feature-task-chat-messages" id="featureTaskChatBox">
                                    <div class="feature-task-chat-empty">هنوز پیوستی ثبت نشده است.</div>
                                </div>
                                <div class="feature-task-chat-input">
                                    <div class="feature-task-chat-input-row">
                                        <textarea id="featureTaskMessageInput" placeholder="توضیح پیوست را بنویسید... (Ctrl+V برای چسباندن تصویر)" rows="1"></textarea>
                                        <button type="button" class="feature-task-chat-send" id="featureTaskSendBtn">
                                            <i class="bi bi-send"></i>
                                            افزودن
                                        </button>
                                    </div>
                                    <div class="feature-task-chat-actions">
                                        <label class="feature-task-chat-action">
                                            <i class="bi bi-paperclip"></i>
                                            فایل
                                            <input type="file" id="featureTaskFileInput" multiple accept="image/*,audio/*,.pdf,.doc,.docx,.txt" style="display: none;" />
                                        </label>
                                        <button type="button" class="feature-task-chat-action" id="featureTaskRecordBtn">
                                            <span id="featureTaskRecordIcon"><i class="bi bi-mic"></i></span>
                                            <span id="featureTaskRecordText">ضبط ویس</span>
                                        </button>
                                        <span id="featureTaskRecordTimer" class="feature-task-chat-action" style="background: transparent; border: none; cursor: default;"></span>
                                    </div>
                                    <div id="featureTaskSelectedFiles" class="feature-task-file-preview"></div>
                                    <div id="featureTaskAudioPreview" class="feature-task-file-preview"></div>
                                    <div id="featureTaskChatNote" class="feature-task-chat-note"></div>
                                    <input type="hidden" name="__RequestVerificationToken" value="@featureTaskAntiforgeryToken" id="featureTaskAntiForgery" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="feature-task-side-card">
                            <div class="info-block">
                                <div class="small-title">زمان‌بندی</div>
                                <label for="featureTaskStartDate" class="form-label">تاریخ شروع <span class="text-muted small">(اختیاری)</span></label>
                                <input type="text" class="form-control mb-2" id="featureTaskStartDate" autocomplete="off" placeholder="مثلاً 1404/01/15" />
                                <label for="featureTaskDurationDays" class="form-label">مدت انجام (روز)</label>
                                <input type="number" class="form-control mb-2" id="featureTaskDurationDays" min="0" max="3650" placeholder="مثلاً ۳" />
                                <small class="text-muted d-block mb-2">با تاریخ شروع، مهلت انجام خودکار محاسبه می‌شود.</small>
                            </div>
                            <div class="info-block">
                                <div class="small-title">اطلاعات</div>
                                <label for="featureTaskCategory" class="form-label">دسته‌بندی</label>
                                <select class="form-select mb-2" id="featureTaskCategory">
                                    <option value="">-- بدون دسته --</option>
                                    @foreach (var cat in featureTaskCategories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>

                                <label class="form-label">فیچر</label>
                                <input type="text" class="form-control mb-2 bg-light" value="@Model.Name" readonly />

                                <label for="featureTaskAssignee" class="form-label">مسئول کار</label>
                                <select class="form-select mb-2" id="featureTaskAssignee">
                                    <option value="">-- انتخاب کاربر --</option>
                                    @foreach (var m in featureTaskMembers)
                                    {
                                        <option value="@m.UserId">@m.DisplayName</option>
                                    }
                                </select>

                                <label for="featureTaskEffort" class="form-label">سطح کار</label>
                                <select class="form-select mb-0" id="featureTaskEffort">
                                    <option value="">-- انتخاب سطح --</option>
                                    <option value="1">ساده</option>
                                    <option value="2">متوسط</option>
                                    <option value="3">پرزحمت</option>
