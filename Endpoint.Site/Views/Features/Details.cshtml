        function getAttachmentFileIcon(fileName, fileType, mimeType) {
            var name = String(fileName || '').toLowerCase();
            var type = String(fileType || '').toLowerCase();
            var mime = String(mimeType || '').toLowerCase();
            if (type === 'audio' || mime.indexOf('audio/') === 0 || /\.(mp3|wav|ogg|m4a|webm|aac)$/.test(name)) return 'bi-mic';
            if (type === 'image' || mime.indexOf('image/') === 0) return 'bi-image';
            if (/\.(pdf)$/.test(name)) return 'bi-file-earmark-pdf';
            if (/\.(doc|docx)$/.test(name)) return 'bi-file-earmark-word';
            if (/\.(xls|xlsx)$/.test(name)) return 'bi-file-earmark-excel';
            if (/\.(zip|rar)$/.test(name)) return 'bi-file-earmark-zip';
            return 'bi-paperclip';
        }

        function refreshEditImplementationCommentExisting() {
            var container = document.getElementById('editImplementationCommentExistingAttachments');
            var emptyEl = document.getElementById('editImplementationCommentExistingEmpty');
            if (!container) return;
            container.innerHTML = '';

            var visible = editImplementationCommentExisting.filter(function (att) {
                return editImplementationCommentRemoveIds.indexOf(att.id) === -1;
            });

            if (emptyEl) emptyEl.classList.toggle('d-none', visible.length > 0);

            visible.forEach(function (att) {
                var fileType = String(att.fileType || '').toLowerCase();
                var mimeType = String(att.mimeType || '').toLowerCase();
                var isImage = fileType === 'image' || mimeType.indexOf('image/') === 0;
                var wrapper = document.createElement('div');
                wrapper.className = 'file-preview-item';
                wrapper.setAttribute('data-attachment-id', att.id);
                if (isImage) {
                    wrapper.innerHTML =
                        '<button type="button" class="btn p-0 border-0 implementation-comment-image-thumb" data-image-url="' + escapeHtml(att.filePath) + '" data-image-name="' + escapeHtml(att.fileName) + '" title="نمایش تصویر">' +
                        '<img src="' + escapeHtml(att.filePath) + '" alt="' + escapeHtml(att.fileName) + '" />' +
                        '</button>' +
                        '<button type="button" class="remove-btn" data-existing-id="' + att.id + '" aria-label="حذف">&times;</button>';
                } else {
                    wrapper.innerHTML =
                        '<div class="file-preview-doc">' +
                        '<i class="bi ' + getAttachmentFileIcon(att.fileName, att.fileType, att.mimeType) + '"></i>' +
                        '<span title="' + escapeHtml(att.fileName) + '">' + escapeHtml(att.fileName) + '</span>' +
                        '</div>' +
                        '<button type="button" class="remove-btn" data-existing-id="' + att.id + '" aria-label="حذف">&times;</button>';
