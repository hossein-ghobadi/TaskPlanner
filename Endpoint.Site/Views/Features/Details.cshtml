        (function initImplementationCommentImageLightbox() {
            var overlay = document.getElementById('implementationCommentImageLightbox');
            var img = document.getElementById('implementationCommentImageLightboxImg');
            var caption = document.getElementById('implementationCommentImageLightboxCaption');
            var closeBtn = overlay && overlay.querySelector('.implementation-comment-image-lightbox-close');
            if (!overlay || !img) return;

            function openLightbox(url, name) {
                if (!url) return;
                img.src = url;
                img.alt = name || '';
                if (caption) caption.textContent = name || '';
                overlay.hidden = false;
                document.body.style.overflow = 'hidden';
            }

            function closeLightbox() {
                overlay.hidden = true;
                img.src = '';
                img.alt = '';
                if (caption) caption.textContent = '';
                document.body.style.overflow = '';
            }

            document.addEventListener('click', function (event) {
                var btn = event.target.closest('.implementation-comment-image-thumb, .feature-task-chat-image-thumb');
                if (!btn) return;
                event.preventDefault();
                openLightbox(btn.getAttribute('data-image-url'), btn.getAttribute('data-image-name'));
            });

            closeBtn?.addEventListener('click', function (event) {
                event.stopPropagation();
                closeLightbox();
            });

            overlay.addEventListener('click', function (event) {
                if (event.target === overlay) closeLightbox();
            });

            img.addEventListener('click', function (event) {
                event.stopPropagation();
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && !overlay.hidden) closeLightbox();
            });
        })();

