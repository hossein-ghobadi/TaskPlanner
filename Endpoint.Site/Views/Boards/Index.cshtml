@model Endpoint.Site.Models.BoardsIndexVm
@using System.Security.Claims
@using DNTPersianUtils.Core
@{
    ViewData["Title"] = "تخته‌های من";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
    var currentUserId = Model?.CurrentUserId ?? User.FindFirstValue(ClaimTypes.NameIdentifier);
    var boards = Model?.Boards ?? new List<Endpoint.Site.Models.BoardCardVm>();
}

<style>
    .boards-page {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0.35rem 0.25rem 0.9rem;
    }

    .boards-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.8rem;
        padding-bottom: 0.55rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .boards-title {
        margin: 0;
        color: #1f2937;
        font-size: 1.45rem;
        font-weight: 700;
    }

    .boards-grid {
        display: grid !important;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: 0.9rem;
    }

    .boards-grid > .col {
        width: auto;
        max-width: none;
        padding: 0;
        margin: 0;
    }

    .boards-page .project-card {
        border: 1px solid #d8dee5;
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(15, 23, 42, 0.05);
        transition: box-shadow 0.18s ease, border-color 0.18s ease;
        background: #fff;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .boards-page .project-card:hover {
        border-color: #c6d0dc;
        box-shadow: 0 5px 14px rgba(15, 23, 42, 0.08);
    }

    .boards-page .project-card .card-body {
        padding: 0.85rem 0.9rem;
    }

    .boards-page .project-card .card-title {
        font-size: 1.02rem;
    }

    .boards-page .description-text {
        min-height: 2.4rem;
        line-height: 1.55;
        display: -webkit-box;
        line-clamp: 2;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .boards-page .project-card .card-footer {
        background: #f8f9fa;
        border-top: 1px solid #e6e9ed;
        padding: 0.52rem 0.75rem;
    }

    .boards-page .project-card-add {
        border: 2px dashed #cfd6de;
        background: #fcfcfb;
    }

    .boards-page .add-project-icon {
        width: 58px;
        height: 58px;
        border-radius: 12px;
        background: #e5e7eb;
        color: #374151;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

   @@media (max-width: 768px) {
        .boards-title {
            font-size: 1.25rem;
        }

        .boards-grid {
            row-gap: 0.7rem !important;
        }
    }
</style>

<div class="boards-page">
<div class="boards-head">
    <h2 class="boards-title"><i class="bi bi-kanban me-2"></i>تخته‌های من</h2>
</div>

<div class="row boards-grid" id="boardsCardsContainer">
    <!-- کارت افزودن تخته جدید -->
    <div class="col">
        <button id="openCreateBoardBtn" type="button" class="project-card project-card-add w-100 text-start border-0" data-bs-toggle="modal" data-bs-target="#createBoardModal" onclick="openCreateBoardModal(event)">
            <div class="card-body d-flex flex-column align-items-center justify-content-center" style="min-height: 172px;">
                <div class="add-project-icon mb-3">
                    <i class="bi bi-plus-circle"></i>
                </div>
                <h5 class="card-title fw-bold mb-2">تخته جدید</h5>
                <p class="card-text text-muted text-center mb-0">ایجاد یک تخته جدید</p>
            </div>
        </button>
    </div>

    @if (boards.Any())
    {
        @await Html.PartialAsync("_BoardCards", boards, new ViewDataDictionary(ViewData)
        {
            ["CurrentUserId"] = currentUserId
        })
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center mb-0">
                <i class="bi bi-info-circle me-2"></i>
                هنوز تخته‌ای ایجاد نکرده‌اید. برای شروع، یک تخته جدید ایجاد کنید.
            </div>
        </div>
    }
</div>

<div id="boardsLoadMoreState"
     class="text-center mt-4 text-muted"
     data-next-page="@((Model?.Page ?? 1) + 1)"
     data-page-size="@(Model?.PageSize ?? 4)"
     data-has-more="@((Model?.HasMoreBoards ?? false) ? "true" : "false")"
     style="display:@((Model?.HasMoreBoards ?? false) ? "block" : "none")">
    <span id="boardsLoadMoreText">برای بارگذاری بیشتر اسکرول کنید...</span>
</div>
<div id="boardsLoadMoreSentinel" style="height:1px;" aria-hidden="true"></div>

<!-- Modal برای ایجاد تخته -->
<div class="modal fade" id="createBoardModal" tabindex="-1" aria-labelledby="createBoardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createBoardModalLabel">
                    <i class="bi bi-plus-circle me-2"></i>
                    ایجاد تخته جدید
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" asp-controller="Boards" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">نام تخته <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Name" id="createBoardName" required placeholder="نام تخته" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label">توضیحات</label>
                        <textarea class="form-control" name="Description" rows="3" placeholder="توضیحات اختیاری"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-primary">ایجاد تخته</button>
                </div>
            </form>
        </div>
    </div>
</div>
</div>

<!-- Modal برای حذف تخته -->
<div class="modal fade" id="deleteBoardModal" tabindex="-1" aria-labelledby="deleteBoardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteBoardModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    حذف تخته
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    آیا از حذف این تخته اطمینان دارید؟ تمام کارهای این تخته نیز حذف خواهند شد.
                </div>
                <dl class="row">
                    <dt class="col-sm-4">نام تخته:</dt>
                    <dd class="col-sm-8" id="deleteBoardName"></dd>
                    <dt class="col-sm-4">تعداد کارها:</dt>
                    <dd class="col-sm-8" id="deleteBoardTaskCount"></dd>
                </dl>
                <input type="hidden" id="deleteBoardId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>
                    انصراف
                </button>
                <button type="button" class="btn btn-danger" onclick="submitDeleteBoard()">
                    <i class="bi bi-trash me-2"></i>
                    بله، حذف کن
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal برای ویرایش تخته -->
<div class="modal fade" id="editBoardModal" tabindex="-1" aria-labelledby="editBoardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editBoardModalLabel">ویرایش تخته</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editBoardFormModal">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editBoardId" name="Id" />
                    
                    <div class="mb-3">
                        <label for="editBoardName" class="form-label">نام تخته <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editBoardName" name="Name" required placeholder="نام تخته" />
                        <span class="text-danger" id="editBoardNameError"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label for="editBoardDescription" class="form-label">توضیحات</label>
                        <textarea class="form-control" id="editBoardDescription" name="Description" rows="3" placeholder="توضیحات اختیاری"></textarea>
                        <span class="text-danger" id="editBoardDescriptionError"></span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="submitEditBoard()">
                    <i class="bi bi-check-circle me-2"></i>
                    ذخیره تغییرات
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var loadMoreState = document.getElementById('boardsLoadMoreState');
        var loadMoreText = document.getElementById('boardsLoadMoreText');
        var sentinel = document.getElementById('boardsLoadMoreSentinel');
        var cardsContainer = document.getElementById('boardsCardsContainer');
        if (!loadMoreState || !loadMoreText || !sentinel || !cardsContainer) return;

        var isLoading = false;
        var ticking = false;

        var loadNextPage = async function () {
            if (isLoading) return;
            if (loadMoreState.getAttribute('data-has-more') !== 'true') return;

            var nextPage = loadMoreState.getAttribute('data-next-page');
            var pageSize = loadMoreState.getAttribute('data-page-size');
            if (!nextPage || !pageSize) return;

            isLoading = true;
            loadMoreText.textContent = 'در حال بارگذاری...';

            try {
                var url = '/Boards/IndexCards?page=' + encodeURIComponent(nextPage) + '&pageSize=' + encodeURIComponent(pageSize);
                var response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!response.ok) throw new Error('load-failed');

                var html = await response.text();
                cardsContainer.insertAdjacentHTML('beforeend', html);

                var hasMore = response.headers.get('X-Has-More') === 'true';
                loadMoreState.setAttribute('data-has-more', hasMore ? 'true' : 'false');
                if (hasMore) {
                    loadMoreState.setAttribute('data-next-page', String(parseInt(nextPage, 10) + 1));
                    loadMoreText.textContent = 'برای بارگذاری بیشتر اسکرول کنید...';
                } else {
                    loadMoreState.style.display = 'none';
                }
            } catch (_) {
                loadMoreText.textContent = 'خطا در بارگذاری. با اسکرول دوباره تلاش می‌شود...';
            } finally {
                isLoading = false;
            }
        };

        var shouldLoadMoreByViewport = function () {
            if (loadMoreState.getAttribute('data-has-more') !== 'true') return false;
            var rect = sentinel.getBoundingClientRect();
            return rect.top <= (window.innerHeight + 260);
        };

        var onScrollOrResize = function () {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(function () {
                if (shouldLoadMoreByViewport()) loadNextPage();
                ticking = false;
            });
        };

        if (window.__boardsInfiniteObserver && typeof window.__boardsInfiniteObserver.disconnect === 'function') {
            window.__boardsInfiniteObserver.disconnect();
        }

        if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) loadNextPage();
                });
            }, { root: null, rootMargin: '200px 0px', threshold: 0 });
            window.__boardsInfiniteObserver = observer;
            observer.observe(sentinel);
        }

        window.addEventListener('scroll', onScrollOrResize, { passive: true });
        window.addEventListener('resize', onScrollOrResize, { passive: true });
        onScrollOrResize();
    })();

    function openCreateBoardModal(event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }

        var modalElement = document.getElementById('createBoardModal');
        if (!modalElement || typeof bootstrap === 'undefined') return;

        var modal = bootstrap.Modal.getOrCreateInstance(modalElement);
        modal.show();
    }

    document.getElementById('createBoardModal')?.addEventListener('shown.bs.modal', function () {
        document.getElementById('createBoardName')?.focus();
    });

    // تبدیل ارقام انگلیسی به فارسی
    function toPersianNumbers(str) {
        const persianDigits = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
        return String(str).replace(/\d/g, (digit) => persianDigits[parseInt(digit)]);
    }

    function getCsrfToken() {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    // باز کردن Modal ویرایش تخته
    async function openEditBoardModal(boardId) {
        try {
            const response = await fetch('@Url.Action("GetBoard", "Boards")?id=' + boardId);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                document.getElementById('editBoardId').value = result.board.id;
                document.getElementById('editBoardName').value = result.board.name || '';
                document.getElementById('editBoardDescription').value = result.board.description || '';
                
                // پاک کردن خطاهای قبلی
                document.getElementById('editBoardNameError').textContent = '';
                document.getElementById('editBoardDescriptionError').textContent = '';
                
                const modal = new bootstrap.Modal(document.getElementById('editBoardModal'));
                modal.show();
            } else {
                alert('خطا: ' + (result.message || 'خطا در دریافت اطلاعات تخته'));
            }
        } catch (error) {
            console.error('خطا در دریافت اطلاعات تخته:', error);
            alert('خطا در دریافت اطلاعات تخته: ' + error.message);
        }
    }

    // ارسال فرم ویرایش تخته
    async function submitEditBoard() {
        const name = document.getElementById('editBoardName').value.trim();
        const description = document.getElementById('editBoardDescription').value.trim();
        const boardId = document.getElementById('editBoardId').value;

        if (!name) {
            document.getElementById('editBoardNameError').textContent = 'نام تخته الزامی است';
            return;
        }

        // پاک کردن خطاهای قبلی
        document.getElementById('editBoardNameError').textContent = '';
        document.getElementById('editBoardDescriptionError').textContent = '';

        const submitBtn = document.querySelector('#editBoardModal .btn-primary');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال ذخیره...';

        try {
            const csrfToken = getCsrfToken();
            const formData = new FormData();
            formData.append('Id', boardId);
            formData.append('Name', name);
            formData.append('Description', description);
            if (csrfToken) {
                formData.append('__RequestVerificationToken', csrfToken);
            }

            const response = await fetch('@Url.Action("Edit", "Boards")?id=' + boardId, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': csrfToken,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('editBoardModal'));
                modal.hide();
                location.reload();
            } else {
                // نمایش خطاهای اعتبارسنجی
                if (result.errors) {
                    if (result.errors.Name) {
                        document.getElementById('editBoardNameError').textContent = result.errors.Name[0] || '';
                    }
                    if (result.errors.Description) {
                        document.getElementById('editBoardDescriptionError').textContent = result.errors.Description[0] || '';
                    }
                }
                alert('خطا: ' + (result.message || 'خطا در ویرایش تخته'));
            }
        } catch (error) {
            console.error('خطا در ویرایش تخته:', error);
            alert('خطا در ویرایش تخته: ' + error.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }

    // باز کردن Modal حذف تخته
    function openDeleteBoardModal(boardId, boardName, taskCount) {
        document.getElementById('deleteBoardId').value = boardId;
        document.getElementById('deleteBoardName').textContent = boardName;
        document.getElementById('deleteBoardTaskCount').textContent = toPersianNumbers(taskCount) + ' کار';
        
        const modal = new bootstrap.Modal(document.getElementById('deleteBoardModal'));
        modal.show();
    }

    // ارسال درخواست حذف تخته
    async function submitDeleteBoard() {
        const boardId = document.getElementById('deleteBoardId').value;
        
        if (!boardId) {
            alert('خطا: شناسه تخته یافت نشد');
            return;
        }

        const submitBtn = document.querySelector('#deleteBoardModal .btn-danger');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال حذف...';

        try {
            const csrfToken = getCsrfToken();
            const formData = new FormData();
            formData.append('id', boardId);
            if (csrfToken) {
                formData.append('__RequestVerificationToken', csrfToken);
            }

            const response = await fetch('@Url.Action("Delete", "Boards")?id=' + boardId, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': csrfToken,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            // اگر پاسخ HTML است (redirect)، صفحه را reload کن
            const contentType = response.headers.get('content-type');
            if (contentType && contentType.includes('text/html')) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteBoardModal'));
                modal.hide();
                window.location.href = '@Url.Action("Index", "Boards")';
                return;
            }

            const result = await response.json();
            
            if (result.success || response.redirected) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteBoardModal'));
                modal.hide();
                window.location.href = '@Url.Action("Index", "Boards")';
            } else {
                alert('خطا: ' + (result.message || 'خطا در حذف تخته'));
            }
        } catch (error) {
            console.error('خطا در حذف تخته:', error);
            alert('خطا در حذف تخته: ' + error.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }
</script>

