@model Endpoint.Site.Models.BoardDetailsVm
@using TaskPlanner.Domain.Entities.Boards
@using System.Security.Claims
@using DNTPersianUtils.Core
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = Model.Name;
    Layout = "/Views/Shared/_Layout.cshtml";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var availableUsers = ViewBag.AvailableUsers as dynamic;
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    
    // استفاده از وضعیت‌های دیتابیس
    var allStatusesList = Model.Statuses.OrderBy(s => s.Order).ToList();
    var allStatuses = allStatusesList.Select(s => s.Name).ToList();
    if (!allStatuses.Any())
    {
        // اگر وضعیتی وجود ندارد، فقط "To Do" را نمایش بده
        allStatuses = new[] { "To Do" }.ToList();
        allStatusesList = new List<BoardStatus>();
    }
    
    // اطمینان از اینکه "To Do" اول باشد (برای نمایش در سمت چپ)
    var toDoStatus = allStatusesList.FirstOrDefault(s => s.Name.Equals("To Do", StringComparison.OrdinalIgnoreCase));
    if (toDoStatus != null)
    {
        allStatusesList.Remove(toDoStatus);
        allStatusesList.Insert(0, toDoStatus); // اضافه کردن به اول برای نمایش در سمت چپ
    }
}

<style>
    .board-container {
        direction: rtl;
        padding: 1rem;
