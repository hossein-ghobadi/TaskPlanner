    // ارسال فرم سریع افزودن وضعیت
    async function submitQuickAddStatus(boardId) {
        const input = document.getElementById('quick-add-status-input');
        const name = input?.value.trim();
        
        if (!name) {
            alert('لطفاً نام وضعیت را وارد کنید');
            return;
        }

        const form = document.getElementById('quick-add-status-form');
        const button = form?.previousElementSibling;
        
        // غیرفعال کردن input
        if (input) {
            input.disabled = true;
        }

        try {
            const response = await fetch('@Url.Action("AddStatus", "Boards")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                body: `boardId=${boardId}&name=${encodeURIComponent(name)}&description=&color=#6c757d`
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                // پاک کردن input و مخفی کردن فرم
                if (input) {
                    input.value = '';
                    input.disabled = false;
                }
                hideQuickAddStatus();
                
                // بارگذاری مجدد صفحه برای نمایش وضعیت جدید
                location.reload();
            } else {
                alert('خطا: ' + (result.message || 'خطا در افزودن وضعیت'));
                if (input) {
                    input.disabled = false;
                    input.focus();
                }
            }
        } catch (error) {
            console.error('خطا در افزودن وضعیت:', error);
            alert('خطا در افزودن وضعیت: ' + error.message);
            if (input) {
                input.disabled = false;
                input.focus();
            }
        }
    }

