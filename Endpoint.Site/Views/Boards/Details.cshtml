    function editSubtaskInline(subtaskId, currentTitle) {
        const item = document.querySelector(`[data-subtask-id="${subtaskId}"]`);
        if (!item) return;
        
        const textElement = item.querySelector('.checklist-item-text');
        const currentText = textElement.textContent;
        
        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'form-control form-control-sm';
        input.value = currentText;
        input.onblur = () => saveSubtaskTitle(subtaskId, input.value);
        input.onkeypress = (e) => {
            if (e.key === 'Enter') {
                input.blur();
            } else if (e.key === 'Escape') {
                textElement.textContent = currentText;
                input.replaceWith(textElement);
            }
        };
        
        textElement.replaceWith(input);
        input.focus();
        input.select();
    }
    
    async function saveSubtaskTitle(subtaskId, newTitle) {
        if (!newTitle.trim()) {
            await loadSubtasks(currentTaskDetailsId);
            return;
        }
        
        try {
            const taskResponse = await fetch('@Url.Action("GetTask", "BoardTasks")?id=' + subtaskId);
            const taskResult = await taskResponse.json();
            
            if (!taskResult.success) {
                await loadSubtasks(currentTaskDetailsId);
                return;
            }
            
            const task = taskResult.task;
            
            const formData = new FormData();
            formData.append('Id', subtaskId);
            formData.append('Title', newTitle.trim());
            formData.append('Description', task.description || '');
            formData.append('Status', task.status || 'To Do');
            formData.append('BoardId', task.boardId);
            formData.append('AssignedUserId', task.assignedUserId || '');
            formData.append('__RequestVerificationToken', '@antiforgeryToken');
            
            const response = await fetch('@Url.Action("UpdateTask", "BoardTasks")', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (result.success) {
                await loadSubtasks(currentTaskDetailsId);
            } else {
                alert('خطا: ' + (result.message || 'خطا در ویرایش کارک'));
                await loadSubtasks(currentTaskDetailsId);
