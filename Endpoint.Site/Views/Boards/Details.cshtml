    async function loadTaskDetails(taskId) {
        try {
            const response = await fetch('@Url.Action("GetTask", "BoardTasks")?id=' + taskId);
            const result = await response.json();
            
            if (result.success) {
                const task = result.task;
                
                // نمایش وضعیت تکمیل
                const completeCheckbox = document.getElementById('taskDetailsCompleteCheckbox');
                completeCheckbox.checked = task.isCompleted || false;
                
                // نمایش عنوان
                const titleElement = document.getElementById('taskDetailsTitle');
                titleElement.textContent = task.title || 'بدون عنوان';
                
                // اعمال استایل برای عنوان کارهای تکمیل‌شده
                if (task.isCompleted) {
                    titleElement.style.textDecoration = 'line-through';
                    titleElement.style.color = '#6c757d';
                } else {
                    titleElement.style.textDecoration = 'none';
                    titleElement.style.color = '';
                }
                
                // نمایش توضیحات
                const descriptionText = task.description || '';
                const descriptionElement = document.getElementById('taskDetailsDescriptionText');
                if (descriptionText) {
                    descriptionElement.textContent = descriptionText;
                    descriptionElement.classList.remove('text-muted');
                } else {
                    descriptionElement.textContent = 'افزودن توضیحات بیشتر...';
                    descriptionElement.classList.add('text-muted');
                }
                document.getElementById('taskDetailsDescriptionInput').value = descriptionText;
                
                // نمایش وضعیت (فقط خواندنی)
                const statusDisplay = document.getElementById('taskDetailsStatusDisplay');
                statusDisplay.textContent = task.status || 'To Do';
                document.getElementById('taskDetailsStatus').value = task.status || 'To Do';
                
                // نمایش اختصاص به
                await loadUsersForDetails(task.boardId);
                document.getElementById('taskDetailsAssignedUser').value = task.assignedUserId || '';
                
                // نمایش تاریخ سررسید
                const dueDateInput = document.getElementById('taskDetailsDueDate');
                const dueDateStatus = document.getElementById('taskDetailsDueDateStatus');
                if (task.dueDate) {
                    const dueDate = new Date(task.dueDate);
                    dueDateInput.value = dueDate.toISOString().split('T')[0];
                    
                    // محاسبه وضعیت تاریخ
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);
                    const dueDateOnly = new Date(dueDate);
                    dueDateOnly.setHours(0, 0, 0, 0);
                    
                    if (dueDateOnly < today) {
                        dueDateStatus.textContent = '⚠️ سررسید گذشته';
                        dueDateStatus.className = 'text-danger small';
                    } else if (dueDateOnly.getTime() === today.getTime()) {
                        dueDateStatus.textContent = '⏰ امروز';
                        dueDateStatus.className = 'text-warning small';
                    } else {
                        const daysLeft = Math.ceil((dueDateOnly - today) / (1000 * 60 * 60 * 24));
                        dueDateStatus.textContent = `📅 ${daysLeft} روز مانده`;
                        dueDateStatus.className = 'text-success small';
                    }
                } else {
                    dueDateInput.value = '';
                    dueDateStatus.textContent = '';
                }
                
                // نمایش تاریخ ایجاد
                if (task.createdAt) {
                    const date = new Date(task.createdAt);
                    document.getElementById('taskDetailsCreatedAt').textContent = date.toLocaleDateString('fa-IR');
                }
                
                // بارگذاری کارک‌ها
                await loadSubtasks(taskId);
                
                // بارگذاری یادداشت‌ها
                await loadCommentsForDetails(taskId);
            } else {
                alert('خطا: ' + (result.message || 'خطا در بارگذاری اطلاعات کار'));
            }
        } catch (error) {
            console.error('خطا در بارگذاری اطلاعات کار:', error);
            alert('خطا در بارگذاری اطلاعات کار: ' + error.message);
        }
    }
    
    async function loadSubtasks(taskId) {
        try {
            const response = await fetch('@Url.Action("GetTask", "BoardTasks")?id=' + taskId);
            const result = await response.json();
            
            if (result.success) {
                const subtasks = result.task.subtasks || [];
                renderChecklist(subtasks);
            } else {
                renderChecklist([]);
            }
        } catch (error) {
            console.error('خطا در بارگذاری کارک‌ها:', error);
            renderChecklist([]);
        }
    }
    
    function renderChecklist(subtasks) {
        const container = document.getElementById('taskDetailsChecklist');
        const progressElement = document.getElementById('taskDetailsChecklistProgress');
        
        if (!subtasks || subtasks.length === 0) {
            container.innerHTML = '<div class="text-muted text-center py-3">هنوز کارکی اضافه نشده است</div>';
            progressElement.textContent = '0/0';
            return;
        }
        
        const completedCount = subtasks.filter(st => st.status === 'Done').length;
        progressElement.textContent = `${completedCount}/${subtasks.length}`;
        
        let html = '';
        subtasks.forEach(subtask => {
            const isCompleted = subtask.status === 'Done';
            html += `
                <div class="checklist-item" data-subtask-id="${subtask.id}">
                    <input type="checkbox" ${isCompleted ? 'checked' : ''} 
                           onchange="toggleSubtaskStatus(${subtask.id}, this.checked)" />
                    <span class="checklist-item-text ${isCompleted ? 'completed' : ''}" 
                          onclick="editSubtaskInline(${subtask.id}, ${JSON.stringify(subtask.title)})">
                        ${escapeHtml(subtask.title)}
                    </span>
                    <div class="checklist-item-actions">
                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                onclick="deleteSubtaskFromDetails(${subtask.id})" title="حذف">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            `;
        });
        
        container.innerHTML = html;
    }
    
    async function toggleSubtaskStatus(subtaskId, isChecked) {
        try {
            const newStatus = isChecked ? 'Done' : 'To Do';
            const formData = new FormData();
            formData.append('Id', subtaskId);
            formData.append('Status', newStatus);
            formData.append('__RequestVerificationToken', '@antiforgeryToken');
            
            const response = await fetch('@Url.Action("UpdateTask", "BoardTasks")', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (result.success) {
                // به‌روزرسانی نمایش
                await loadSubtasks(currentTaskDetailsId);
                
                // بررسی اینکه آیا همه کارک‌ها تکمیل شدن
                await checkAndUpdateParentTaskCompletion();
            } else {
                alert('خطا: ' + (result.message || 'خطا در تغییر وضعیت کارک'));
                // بازگشت به حالت قبلی
                await loadSubtasks(currentTaskDetailsId);
            }
        } catch (error) {
            console.error('خطا در تغییر وضعیت کارک:', error);
            alert('خطا در تغییر وضعیت کارک: ' + error.message);
            await loadSubtasks(currentTaskDetailsId);
        }
    }
    
    async function checkAndUpdateParentTaskCompletion() {
        // اگر toggle از طریق کار اصلی انجام شده، کاری نکن
        if (isTogglingFromParent) return;
        
        try {
            // دریافت اطلاعات کار و کارک‌های آن
            const response = await fetch('@Url.Action("GetTask", "BoardTasks")?id=' + currentTaskDetailsId);
            const result = await response.json();
            
            if (!result.success) return;
            
            const task = result.task;
            const subtasks = task.subtasks || [];
            
            // اگر کارکی وجود نداشته باشد، کاری نکن
            if (subtasks.length === 0) return;
            
            // بررسی اینکه آیا همه کارک‌ها Done هستند
            const allCompleted = subtasks.every(st => st.status === 'Done');
            const currentlyCompleted = task.isCompleted || false;
            
            // اگر وضعیت تغییر کرده باشد، به‌روزرسانی کن
            if (allCompleted && !currentlyCompleted) {
                // همه کارک‌ها تکمیل شدن، کار اصلی رو هم تکمیل کن
                await toggleTaskCompleteWithoutReload(true);
            } else if (!allCompleted && currentlyCompleted) {
                // حداقل یک کارک incomplete شده، کار اصلی رو هم uncomplete کن
                await toggleTaskCompleteWithoutReload(false);
            }
        } catch (error) {
            console.error('خطا در بررسی وضعیت کار والد:', error);
        }
    }
    
    async function toggleTaskCompleteWithoutReload(shouldComplete) {
        try {
            const response = await fetch('@Url.Action("ToggleComplete", "BoardTasks")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({
                    'id': currentTaskDetailsId,
                    '__RequestVerificationToken': '@antiforgeryToken'
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                // فقط checkbox رو به‌روزرسانی کن بدون reload
                document.getElementById('taskDetailsCompleteCheckbox').checked = result.isCompleted;
                
                // به‌روزرسانی استایل عنوان
                const titleElement = document.getElementById('taskDetailsTitle');
                if (result.isCompleted) {
                    titleElement.style.textDecoration = 'line-through';
                    titleElement.style.color = '#6c757d';
                } else {
                    titleElement.style.textDecoration = 'none';
                    titleElement.style.color = '';
                }
            }
        } catch (error) {
            console.error('خطا در تغییر وضعیت تکمیل:', error);
        }
    }
    
