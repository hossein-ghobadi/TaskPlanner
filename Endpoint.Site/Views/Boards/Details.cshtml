    // مدیریت Modal یادداشت
    let currentTaskId = null;
    const currentUserId = '@currentUserId';

    function openTaskModal(taskId, taskTitle) {
        currentTaskId = taskId;
        document.getElementById('taskIdForComment').value = taskId;
        document.getElementById('taskTitleInModal').textContent = taskTitle;
        document.getElementById('commentForm').reset();
        document.getElementById('commentsContainer').innerHTML = '<div class="text-center text-muted py-3"><i class="bi bi-hourglass-split"></i> در حال بارگذاری...</div>';
        
        const modal = new bootstrap.Modal(document.getElementById('taskModal'));
        modal.show();
        
        loadComments(taskId);
    }

    async function loadComments(taskId) {
        try {
            const response = await fetch('@Url.Action("GetComments", "BoardTasks")?taskId=' + taskId);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                displayComments(result.comments);
            } else {
                document.getElementById('commentsContainer').innerHTML = 
                    `<div class="alert alert-danger">${result.message || 'خطا در بارگذاری یادداشت‌ها'}</div>`;
            }
        } catch (error) {
            console.error('خطا در بارگذاری یادداشت‌ها:', error);
            document.getElementById('commentsContainer').innerHTML = 
                `<div class="alert alert-danger">خطا در بارگذاری یادداشت‌ها: ${error.message}</div>`;
        }
    }

    function displayComments(comments) {
        const container = document.getElementById('commentsContainer');
        
        if (!comments || comments.length === 0) {
            container.innerHTML = '<div class="text-center text-muted py-3">هنوز یادداشتی ثبت نشده است</div>';
            return;
        }

        let html = '';
        comments.forEach(comment => {
            html += `
                <div class="border-bottom pb-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong>${escapeHtml(comment.userName)}</strong>
                            <small class="text-muted ms-2">${formatDate(comment.createdAt)}</small>
                            ${comment.isEdited ? '<span class="badge bg-secondary">ویرایش شده</span>' : ''}
                        </div>
                        ${comment.userId === currentUserId ? `
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteComment(${comment.id})">
                                <i class="bi bi-trash"></i>
                            </button>
                        ` : ''}
                    </div>
                    ${comment.message ? `<p class="mb-2">${escapeHtml(comment.message)}</p>` : ''}
                    ${comment.attachments && comment.attachments.length > 0 ? `
                        <div class="attachments mt-2">
                            ${comment.attachments.map(att => `
                                <a href="/${att.filePath}" target="_blank" class="badge bg-info text-decoration-none me-1">
                                    <i class="bi bi-paperclip"></i> ${escapeHtml(att.fileName)}
                                </a>
                            `).join('')}
                        </div>
                    ` : ''}
                </div>
            `;
        });
        
        container.innerHTML = html;
    }

    document.getElementById('commentForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> در حال ارسال...';
        
        try {
            const response = await fetch('@Url.Action("AddComment", "BoardTasks")', {
                method: 'POST',
                body: formData
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}, body: ${errorText}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                this.reset();
                await loadComments(currentTaskId);
            } else {
                alert('خطا: ' + (result.message || 'خطا در ارسال یادداشت'));
            }
        } catch (error) {
            console.error('خطا در ارسال یادداشت:', error);
            alert('خطا در ارسال یادداشت: ' + error.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    });

    async function deleteComment(commentId) {
        if (!confirm('آیا از حذف این یادداشت اطمینان دارید؟')) {
            return;
        }
        
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '@antiforgeryToken';
            const response = await fetch('@Url.Action("DeleteComment", "BoardTasks")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token,
                    'X-CSRF-TOKEN': token
                },
                body: JSON.stringify({ commentId: commentId })
            });
            
            const result = await response.json();
            
            if (result.success) {
                await loadComments(currentTaskId);
            } else {
                alert('خطا: ' + result.message);
            }
        } catch (error) {
            console.error('خطا:', error);
            alert('خطا در حذف یادداشت');
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function formatDate(dateString) {
        const date = new Date(dateString);
        return date.toLocaleDateString('fa-IR', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    // مدیریت Drag and Drop برای ستون‌های وضعیت
    let draggedStatusColumn = null;

    function handleStatusColumnDragStart(e) {
        if (!e.currentTarget.classList.contains('status-column')) return;
        // جلوگیری از drag کردن "To Do"
        if (e.currentTarget.classList.contains('to-do-column')) {
            e.preventDefault();
            return false;
        }
        draggedStatusColumn = e.currentTarget;
        e.currentTarget.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
    }

    function handleStatusColumnDragOver(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        
        const container = document.getElementById('boardColumns');
        if (!container || !draggedStatusColumn) return;
        
        // جلوگیری از drop روی کارت افزودن وضعیت
        const addStatusColumn = container.querySelector('.add-status-column');
        if (addStatusColumn && (e.target === addStatusColumn || addStatusColumn.contains(e.target))) {
            return;
        }
        
        const afterElement = getDragAfterStatusColumn(container, e.clientX);
        
        // اطمینان از اینکه روی کارت افزودن وضعیت drop نمی‌شود
        if (afterElement && afterElement.classList.contains('add-status-column')) {
            const addStatusIndex = Array.from(container.children).indexOf(addStatusColumn);
            const draggedIndex = Array.from(container.children).indexOf(draggedStatusColumn);
            
            if (draggedIndex < addStatusIndex) {
                // اگر قبل از کارت افزودن وضعیت است، بعد از آخرین وضعیت قرار بگیرد
                const statusColumns = Array.from(container.querySelectorAll('.status-column:not(.dragging)'));
                if (statusColumns.length > 0) {
                    container.insertBefore(draggedStatusColumn, statusColumns[statusColumns.length - 1].nextSibling);
                } else {
                    container.insertBefore(draggedStatusColumn, addStatusColumn);
                }
            } else {
                // اگر بعد از کارت افزودن وضعیت است، قبل از آن قرار بگیرد
                container.insertBefore(draggedStatusColumn, addStatusColumn);
            }
            return;
        }
        
        if (afterElement == null) {
            // اگر بعد از همه است، قبل از کارت افزودن وضعیت قرار بگیرد
            if (addStatusColumn) {
                container.insertBefore(draggedStatusColumn, addStatusColumn);
            } else {
                container.appendChild(draggedStatusColumn);
            }
        } else {
            container.insertBefore(draggedStatusColumn, afterElement);
        }
    }

    function handleStatusColumnDrop(e) {
        e.preventDefault();
        if (draggedStatusColumn) {
            updateStatusColumnOrder();
        }
    }

    function handleStatusColumnDragEnd(e) {
        if (e.currentTarget.classList.contains('status-column')) {
            e.currentTarget.classList.remove('dragging');
        }
        draggedStatusColumn = null;
    }

    function getDragAfterStatusColumn(container, x) {
        // فقط وضعیت‌ها را در نظر بگیر، نه کارت افزودن وضعیت
        const draggableElements = [...container.querySelectorAll('.status-column:not(.dragging):not(.add-status-column)')];
        
        return draggableElements.reduce((closest, child) => {
            const box = child.getBoundingClientRect();
            const offset = x - box.left - box.width / 2;
            
            if (offset < 0 && offset > closest.offset) {
                return { offset: offset, element: child };
            } else {
                return closest;
            }
        }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    async function updateStatusColumnOrder() {
        // فقط وضعیت‌ها را در نظر بگیر، نه کارت افزودن وضعیت
        const statusColumns = Array.from(document.querySelectorAll('.status-column:not(.add-status-column)'));
        
        // جدا کردن "To Do" از بقیه
        const toDoColumn = statusColumns.find(col => col.dataset.status && col.dataset.status.toLowerCase() === 'to do');
        const otherColumns = statusColumns.filter(col => !col.dataset.status || col.dataset.status.toLowerCase() !== 'to do');
        
        // اطمینان از اینکه "To Do" اول باشد
        const orderedColumns = toDoColumn ? [toDoColumn, ...otherColumns] : otherColumns;
        
        const statusOrders = orderedColumns
            .filter(col => col.dataset.statusId) // فقط آنهایی که statusId دارند
            .map((column, index) => ({
                statusId: parseInt(column.dataset.statusId),
                order: index + 1
            }));

        if (statusOrders.length === 0) return;

        try {
            const response = await fetch('@Url.Action("UpdateStatusOrder", "Boards")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                body: JSON.stringify({ boardId: @Model.Id, statusOrders: statusOrders })
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                location.reload();
            } else {
                alert('خطا: ' + (result.message || 'خطا در تغییر ترتیب وضعیت‌ها'));
                location.reload();
            }
        } catch (error) {
            console.error('خطا در تغییر ترتیب وضعیت‌ها:', error);
            alert('خطا در تغییر ترتیب وضعیت‌ها: ' + error.message);
            location.reload();
        }
    }

    // باز کردن Modal افزودن وضعیت
    function openAddStatusModal() {
        const modal = new bootstrap.Modal(document.getElementById('addStatusModal'));
        document.getElementById('addStatusFormModal').reset();
        document.getElementById('addStatusColor').value = '#6c757d';
        modal.show();
    }

    // ارسال فرم افزودن وضعیت
    async function submitAddStatus() {
        const name = document.getElementById('addStatusName').value.trim();
        const description = document.getElementById('addStatusDescription').value.trim();
        const color = document.getElementById('addStatusColor').value || '#6c757d';

        if (!name) {
            alert('لطفاً نام وضعیت را وارد کنید');
            return;
        }

        const submitBtn = document.querySelector('#addStatusModal .btn-primary');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال افزودن...';

        try {
            const response = await fetch('@Url.Action("AddStatus", "Boards")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                body: `boardId=@Model.Id&name=${encodeURIComponent(name)}&description=${encodeURIComponent(description)}&color=${encodeURIComponent(color)}`
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('addStatusModal'));
                modal.hide();
                location.reload();
            } else {
                alert('خطا: ' + (result.message || 'خطا در افزودن وضعیت'));
            }
        } catch (error) {
            console.error('خطا در افزودن وضعیت:', error);
            alert('خطا در افزودن وضعیت: ' + error.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }

    // Event listener for delete status buttons
    document.addEventListener('DOMContentLoaded', function() {
        const deleteButtons = document.querySelectorAll('.delete-status-btn');
        deleteButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                e.stopPropagation();
