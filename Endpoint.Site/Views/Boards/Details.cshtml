                        <div class="attachments mt-2">
                            ${comment.attachments.map(att => {
                                // اگر filePath با http شروع می‌شود، URL کامل است، در غیر این صورت مسیر نسبی است
                                const fileUrl = att.filePath && (att.filePath.startsWith('http://') || att.filePath.startsWith('https://')) 
                                    ? att.filePath 
