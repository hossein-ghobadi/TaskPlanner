            container.innerHTML = '<div class="text-center text-muted py-3">هنوز یادداشتی ثبت نشده است</div>';
            return;
        }

        let html = '';
        comments.forEach(comment => {
            html += `
                <div class="border-bottom pb-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong>${escapeHtml(comment.userName)}</strong>
                            <small class="text-muted ms-2">${formatDate(comment.createdAt)}</small>
                            ${comment.isEdited ? '<span class="badge bg-secondary">ویرایش شده</span>' : ''}
                        </div>
                        ${comment.userId === currentUserId ? `
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteComment(${comment.id})">
                                <i class="bi bi-trash"></i>
                            </button>
                        ` : ''}
                    </div>
                    ${comment.message ? `<p class="mb-2">${escapeHtml(comment.message)}</p>` : ''}
                    ${comment.attachments && comment.attachments.length > 0 ? `
                        <div class="attachments mt-2">
                            ${comment.attachments.map(att => {
                                // اگر filePath با http شروع می‌شود، URL کامل است، در غیر این صورت مسیر نسبی است
                                let fileUrl = '';
                                if (att.filePath) {
                                    if (att.filePath.startsWith('http://') || att.filePath.startsWith('https://')) {
                                        fileUrl = att.filePath;
                                    } else {
                                        fileUrl = `/${att.filePath}`;
                                    }
                                }
                                return `
                                    <a href="${escapeHtml(fileUrl)}" target="_blank" class="badge bg-info text-decoration-none me-1">
                                        <i class="bi bi-paperclip"></i> ${escapeHtml(att.fileName)}
                                    </a>
                                `;
                            }).join('')}
                        </div>
                    ` : ''}
                </div>
            `;
        });
        
        container.innerHTML = html;
    }

