        modal.show();
    }

    // ارسال فرم افزودن وضعیت
    async function submitAddStatus() {
        const name = document.getElementById('addStatusName').value.trim();
        const description = document.getElementById('addStatusDescription').value.trim();
        const color = document.getElementById('addStatusColor').value || '#6c757d';

        if (!name) {
            alert('لطفاً نام وضعیت را وارد کنید');
            return;
        }

        const submitBtn = document.querySelector('#addStatusModal .btn-primary');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال افزودن...';

        try {
            const response = await fetch('@Url.Action("AddStatus", "Boards")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                body: `boardId=@Model.Id&name=${encodeURIComponent(name)}&description=${encodeURIComponent(description)}&color=${encodeURIComponent(color)}`
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('addStatusModal'));
                modal.hide();
                location.reload();
            } else {
                alert('خطا: ' + (result.message || 'خطا در افزودن وضعیت'));
            }
        } catch (error) {
            console.error('خطا در افزودن وضعیت:', error);
            alert('خطا در افزودن وضعیت: ' + error.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }

    // Event listener for delete status buttons
    document.addEventListener('DOMContentLoaded', function() {
        const deleteButtons = document.querySelectorAll('.delete-status-btn');
        deleteButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                e.stopPropagation();
                e.preventDefault();
                const statusId = parseInt(this.getAttribute('data-status-id'));
                const statusName = this.getAttribute('data-status-name');
                console.log('Delete button clicked:', statusId, statusName);
                deleteStatusFromColumn(statusId, statusName);
            });
        });
    });

    // باز کردن Modal ویرایش تخته
    async function openEditBoardModal() {
        try {
            const response = await fetch('@Url.Action("GetBoard", "Boards")?id=@Model.Id');
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                document.getElementById('editBoardId').value = result.board.id;
                document.getElementById('editBoardName').value = result.board.name || '';
                document.getElementById('editBoardDescription').value = result.board.description || '';
                
                // پاک کردن خطاهای قبلی
                document.getElementById('editBoardNameError').textContent = '';
                document.getElementById('editBoardDescriptionError').textContent = '';
                
                const modal = new bootstrap.Modal(document.getElementById('editBoardModal'));
                modal.show();
            } else {
                alert('خطا: ' + (result.message || 'خطا در دریافت اطلاعات تخته'));
            }
        } catch (error) {
            console.error('خطا در دریافت اطلاعات تخته:', error);
            alert('خطا در دریافت اطلاعات تخته: ' + error.message);
        }
    }

    // ارسال فرم ویرایش تخته
    async function submitEditBoard() {
        const name = document.getElementById('editBoardName').value.trim();
        const description = document.getElementById('editBoardDescription').value.trim();
        const boardId = document.getElementById('editBoardId').value;

        if (!name) {
            document.getElementById('editBoardNameError').textContent = 'نام تخته الزامی است';
            return;
        }

        // پاک کردن خطاهای قبلی
        document.getElementById('editBoardNameError').textContent = '';
        document.getElementById('editBoardDescriptionError').textContent = '';

        const submitBtn = document.querySelector('#editBoardModal .btn-primary');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال ذخیره...';

        try {
            const formData = new FormData();
            formData.append('Id', boardId);
            formData.append('Name', name);
            formData.append('Description', description);
            formData.append('__RequestVerificationToken', '@antiforgeryToken');

            const response = await fetch('@Url.Action("Edit", "Boards")?id=' + boardId, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': '@antiforgeryToken',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('editBoardModal'));
                modal.hide();
                location.reload();
            } else {
                // نمایش خطاهای اعتبارسنجی
                if (result.errors) {
                    if (result.errors.Name) {
                        document.getElementById('editBoardNameError').textContent = result.errors.Name[0] || '';
                    }
                    if (result.errors.Description) {
                        document.getElementById('editBoardDescriptionError').textContent = result.errors.Description[0] || '';
                    }
                }
                alert('خطا: ' + (result.message || 'خطا در ویرایش تخته'));
            }
        } catch (error) {
            console.error('خطا در ویرایش تخته:', error);
            alert('خطا در ویرایش تخته: ' + error.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }
</script>

