<script>
    let draggedTask = null;
    let draggedTaskElement = null;
    const boardBackgroundKey = `boardBg_${@Model.Id}`;
    const boardBackgroundOptions = ['plain', 'gradient', 'soft', 'pattern', 'pastel', 'photo-1', 'photo-2'];
    const boardBackgroundPhotoClasses = ['board-bg-photo-1', 'board-bg-photo-2'];

    function applyBoardBackground(style) {
        const container = document.getElementById('boardContainer');
        if (!container) return;
        const theme = boardBackgroundOptions.includes(style) ? style : 'plain';
        boardBackgroundOptions.forEach(opt => container.classList.remove(`board-bg-${opt}`));
        boardBackgroundPhotoClasses.forEach(cls => container.classList.remove(cls));
        if (theme.startsWith('photo-')) {
            container.classList.add('board-bg-photo', `board-bg-${theme}`);
        } else {
            container.classList.add(`board-bg-${theme}`);
            container.classList.remove('board-bg-photo');
        }
        const select = document.getElementById('boardBackgroundSelect');
        if (select && select.value !== theme) {
            select.value = theme;
        }
    }

    function changeBoardBackground(style) {
        applyBoardBackground(style);
        try {
            localStorage.setItem(boardBackgroundKey, style);
        } catch (err) {
            console.warn('Cannot persist board background', err);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        try {
            const saved = localStorage.getItem(boardBackgroundKey);
            applyBoardBackground(saved || 'plain');
        } catch {
            applyBoardBackground('plain');
        }
    });

    function handleDragStart(e) {
        // اگر کارک است، اجازه drag نده
        if (e.target.dataset.parentTaskId && e.target.dataset.parentTaskId !== '') {
            e.preventDefault();
            return false;
        }

        draggedTask = {
            id: parseInt(e.target.dataset.taskId),
            status: e.target.dataset.status,
            element: e.target
        };
        draggedTaskElement = e.target;
        
        // تاخیر کوچک برای اضافه کردن کلاس dragging
        setTimeout(() => {
            if (draggedTaskElement) {
                draggedTaskElement.classList.add('dragging');
            }
        }, 0);
        
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', e.target.dataset.taskId);
        
        // تصویر شفاف برای drag ghost
        const dragImage = e.target.cloneNode(true);
        dragImage.style.opacity = '0.8';
        dragImage.style.transform = 'rotate(-3deg)';
        document.body.appendChild(dragImage);
        dragImage.style.position = 'absolute';
        dragImage.style.top = '-1000px';
        e.dataTransfer.setDragImage(dragImage, 0, 0);
        setTimeout(() => dragImage.remove(), 0);
    }

    function handleDragEnd(e) {
        if (e.target) {
            e.target.classList.remove('dragging');
        }
        document.querySelectorAll('.column-tasks').forEach(col => {
            col.classList.remove('drag-over');
        });
        document.querySelectorAll('.board-column').forEach(col => {
            col.classList.remove('drag-over');
        });
    }

    // تابع کمکی برای یافتن موقعیت درج بر اساس موقعیت موس
    function getDragAfterTask(container, y) {
        const draggableElements = [...container.querySelectorAll('.task-card:not(.dragging)')];
        
        return draggableElements.reduce((closest, child) => {
            const box = child.getBoundingClientRect();
            const offset = y - box.top - box.height / 2;
            
            if (offset < 0 && offset > closest.offset) {
                return { offset: offset, element: child };
            } else {
                return closest;
            }
        }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    function handleDragOver(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        
        if (!draggedTaskElement) return;
        
        const columnTasks = e.currentTarget;
        columnTasks.classList.add('drag-over');
        
        const column = columnTasks.closest('.board-column');
        if (column) {
            column.classList.add('drag-over');
        }

        // نمایش پیش‌نمایش محل درج
        const afterElement = getDragAfterTask(columnTasks, e.clientY);
        
        // حذف کارت از موقعیت فعلی اگر در همان ستون است
        if (draggedTaskElement.parentElement === columnTasks) {
            draggedTaskElement.remove();
        }
        
        // درج کارت در موقعیت جدید
        if (afterElement == null) {
            // اگر هیچ المنتی بعد از موقعیت فعلی نیست، به آخر اضافه کن
            if (!columnTasks.contains(draggedTaskElement)) {
                columnTasks.appendChild(draggedTaskElement);
            }
        } else {
            // درج قبل از المنت هدف
            if (!columnTasks.contains(draggedTaskElement) || draggedTaskElement.nextSibling !== afterElement) {
                columnTasks.insertBefore(draggedTaskElement, afterElement);
            }
        }
    }

    function handleDragLeave(e) {
        // فقط زمانی که از ستون خارج می‌شویم
        if (e.currentTarget.contains(e.relatedTarget)) {
            return;
        }
        
        const columnTasks = e.currentTarget;
        columnTasks.classList.remove('drag-over');
        
        const column = columnTasks.closest('.board-column');
        if (column) {
            column.classList.remove('drag-over');
        }
    }

    function handleDrop(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const columnTasks = e.currentTarget;
        const newStatus = columnTasks.dataset.status;
        columnTasks.classList.remove('drag-over');
        
        const column = columnTasks.closest('.board-column');
        if (column) {
            column.classList.remove('drag-over');
        }

        if (!draggedTask || !draggedTaskElement) return;

        // اگر کارک است، اجازه جابجایی نده
        if (draggedTaskElement.dataset.parentTaskId && draggedTaskElement.dataset.parentTaskId !== '') {
            alert('کارک‌ها قابل جابجایی نیستند');
            draggedTaskElement.classList.remove('dragging');
            draggedTask = null;
            draggedTaskElement = null;
            return;
        }

        // حذف کلاس dragging
        draggedTaskElement.classList.remove('dragging');
        
        // به‌روزرسانی وضعیت
        draggedTaskElement.setAttribute('data-status', newStatus);
        
        // اگر در همان ستون است، فقط ترتیب را تغییر بده
        const isSameColumn = draggedTask.status === newStatus;
        
        // حذف کار از مکان قبلی در DOM (اگر در ستون دیگری است)
        const oldColumn = document.querySelector(`#tasks-${draggedTask.status}`);

        // محاسبه ترتیب جدید
        const taskOrders = [];
        const allTasks = Array.from(columnTasks.querySelectorAll('.task-card'));
        allTasks.forEach((taskEl, index) => {
            const taskId = parseInt(taskEl.dataset.taskId);
            if (taskId) {
                taskOrders.push({
                    taskId: taskId,
                    status: newStatus,
                    order: index + 1
                });
            }
        });

        // اگر ستون تغییر کرده، کارهای ستون قبلی را هم به‌روزرسانی کن
        if (!isSameColumn && oldColumn) {
            const oldTasks = Array.from(oldColumn.querySelectorAll('.task-card'));
            oldTasks.forEach((taskEl, index) => {
                const taskId = parseInt(taskEl.dataset.taskId);
                if (taskId) {
                    taskOrders.push({
                        taskId: taskId,
                        status: draggedTask.status,
                        order: index + 1
                    });
                }
            });
        }

        // ارسال درخواست به سرور
        updateTaskOrder(taskOrders);

        draggedTask = null;
        draggedTaskElement = null;
    }

