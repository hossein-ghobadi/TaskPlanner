    async function updateTaskField(fieldName, fieldValue) {
        if (!currentTaskDetailsId) return;
        
        try {
            const taskResponse = await fetch('@Url.Action("GetTask", "BoardTasks")?id=' + currentTaskDetailsId);
            const taskResult = await taskResponse.json();
            
            if (!taskResult.success) {
                alert('خطا در دریافت اطلاعات کار');
                return;
            }
            
            const task = taskResult.task;
            const formData = new FormData();
            formData.append('Id', currentTaskDetailsId);
            
            // فقط فیلد تغییر یافته را ارسال می‌کنیم
            if (fieldName === 'AssignedUserId') {
                formData.append('AssignedUserId', fieldValue);
            } else if (fieldName === 'DueDate') {
                if (fieldValue) {
                    formData.append('DueDate', fieldValue);
                }
            } else if (fieldName === 'Status') {
                formData.append('Status', fieldValue);
            }
            
            formData.append('__RequestVerificationToken', '@antiforgeryToken');
            
            const response = await fetch('@Url.Action("UpdateTask", "BoardTasks")', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (!result.success) {
                alert('خطا: ' + (result.message || 'خطا در به‌روزرسانی کار'));
                // بازگشت به حالت قبلی
                await loadTaskDetails(currentTaskDetailsId);
            }
        } catch (error) {
            console.error('خطا در به‌روزرسانی کار:', error);
            alert('خطا در به‌روزرسانی کار: ' + error.message);
            await loadTaskDetails(currentTaskDetailsId);
        }
    }
    
