    async function toggleTaskComplete() {
        if (!currentTaskDetailsId) return;
        
        // ست کردن flag برای جلوگیری از auto-toggle از طریق کارک‌ها
        isTogglingFromParent = true;
        
        try {
            const response = await fetch('@Url.Action("ToggleComplete", "BoardTasks")', {
                method: 'POST',
