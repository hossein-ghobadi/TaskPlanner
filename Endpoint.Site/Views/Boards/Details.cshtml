    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // تبدیل ارقام انگلیسی به فارسی
    function toPersianNumbers(str) {
        const persianDigits = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
        return String(str).replace(/\d/g, (digit) => persianDigits[parseInt(digit)]);
    }

    function formatDate(dateString) {
        const date = new Date(dateString);
        const formatted = date.toLocaleDateString('fa-IR', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
        return toPersianNumbers(formatted);
    }

    // مدیریت Drag and Drop برای ستون‌های وضعیت
    let draggedStatusColumn = null;
    let currentDropTarget = null; // حفظ برای سازگاری، اما در منطق جدید استفاده نمی‌شود

    function handleStatusColumnDragStart(e) {
        if (!e.currentTarget.classList.contains('status-column')) return;
        // جلوگیری از drag کردن "To Do"
        if (e.currentTarget.classList.contains('to-do-column')) {
            e.preventDefault();
            return false;
        }
        draggedStatusColumn = e.currentTarget;
        currentDropTarget = null;
        e.currentTarget.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/html', e.currentTarget.innerHTML);
    }

    function handleStatusColumnDragOver(e) {
        // فقط اجازه drop بده، جابجایی را در drop انجام می‌دهیم تا لرزش حذف شود
        if (!draggedStatusColumn) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
    }

    function handleStatusColumnDrop(e) {
        e.preventDefault();
        
        if (!draggedStatusColumn) {
            return;
        }

        const targetColumn = e.currentTarget.closest('.status-column');
        const board = document.getElementById('boardColumns');

        if (!targetColumn || !board || targetColumn === draggedStatusColumn || targetColumn.classList.contains('add-status-column')) {
            clearStatusColumnDragState();
            return;
        }

        // محاسبه اندیس‌ها برای درج بدون لرزش
        const columns = Array.from(board.querySelectorAll('.status-column:not(.add-status-column)'));
        const dragIndex = columns.indexOf(draggedStatusColumn);
        const targetIndex = columns.indexOf(targetColumn);

        if (dragIndex === -1 || targetIndex === -1) {
            clearStatusColumnDragState();
            return;
        }

        if (targetIndex < dragIndex) {
            board.insertBefore(draggedStatusColumn, targetColumn);
        } else {
            board.insertBefore(draggedStatusColumn, targetColumn.nextElementSibling);
        }

        clearStatusColumnDragState();
        updateStatusColumnOrder();
    }

    function handleStatusColumnDragEnd(e) {
        if (e.currentTarget.classList.contains('status-column')) {
            e.currentTarget.classList.remove('dragging');
        }
        
        clearStatusColumnDragState();
    }

    function handleStatusColumnDragEnter(e) {
        if (!draggedStatusColumn) return;
        const targetColumn = e.currentTarget.closest('.status-column');
        if (!targetColumn || targetColumn === draggedStatusColumn || targetColumn.classList.contains('add-status-column')) return;
        targetColumn.classList.add('drop-target');
    }

    function handleStatusColumnDragLeave(e) {
        if (!draggedStatusColumn) return;
        const targetColumn = e.currentTarget.closest('.status-column');
        if (!targetColumn) return;
        targetColumn.classList.remove('drop-target');
    }

    function clearStatusColumnDragState() {
        document.querySelectorAll('.status-column').forEach(col => col.classList.remove('drop-target', 'dragging'));
        draggedStatusColumn = null;
        currentDropTarget = null;
    }

    async function updateStatusColumnOrder() {
        // فقط ستون‌های قابل‌جابجایی (بدون کارت افزودن وضعیت و بدون ستون To Do)
        const statusColumns = Array.from(
            document.querySelectorAll('.status-column:not(.add-status-column):not(.to-do-column)')
        );
        
        const statusOrders = statusColumns
            .filter(col => col.dataset.statusId) // فقط ستون‌هایی که statusId دارند
            .map((column, index) => ({
                statusId: parseInt(column.dataset.statusId),
                order: index + 1
            }));

        if (statusOrders.length === 0) return;

        try {
            const response = await fetch('@Url.Action("UpdateStatusOrder", "Boards")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                body: JSON.stringify({ boardId: @Model.Id, statusOrders: statusOrders })
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                location.reload();
            } else {
                alert('خطا: ' + (result.message || 'خطا در تغییر ترتیب وضعیت‌ها'));
                location.reload();
            }
        } catch (error) {
            console.error('خطا در تغییر ترتیب وضعیت‌ها:', error);
            alert('خطا در تغییر ترتیب وضعیت‌ها: ' + error.message);
            location.reload();
        }
    }

