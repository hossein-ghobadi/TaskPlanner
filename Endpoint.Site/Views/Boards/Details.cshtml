<div class="board-container" id="boardContainer">
    <div class="board-header">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h2>@Model.Name</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted mb-2">@Model.Description</p>
                }
                <div class="d-flex gap-3 align-items-center">
                    <small class="text-muted">
                        <i class="bi bi-person"></i>
                        سازنده: @Model.CreatorUserName
                    </small>
                    <small class="text-muted">
                        <i class="bi bi-list-task"></i>
                        @Model.TotalTasks.ToString().ToPersianNumbers() کار
                    </small>
                    <small class="text-muted">
                        <i class="bi bi-check-circle"></i>
                        @Model.CompletedTasks.ToString().ToPersianNumbers() انجام شده
                    </small>
                </div>
            </div>
            <div class="d-flex flex-column align-items-end gap-2">
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-right"></i>
                        بازگشت به لیست
                    </a>
                    <a asp-action="Invite" asp-route-boardId="@Model.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-person-plus"></i>
                        دعوت کاربر
                    </a>
                    @if (Model.CreatorUserId == currentUserId)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openEditBoardModal()">
                            <i class="bi bi-pencil"></i>
                            ویرایش
                        </button>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="boardBackgroundSelect" class="text-muted small mb-0">پس‌زمینه:</label>
                    <select id="boardBackgroundSelect" class="form-select form-select-sm" style="min-width: 170px;" onchange="changeBoardBackground(this.value)">
                        <option value="plain">ساده</option>
                        <option value="gradient">گرادیان</option>
                        <option value="soft">نرم و محو</option>
                        <option value="pattern">الگوی نقطه‌ای</option>
                        <option value="pastel">پاستلی</option>
                        <option value="photo-1">عکس ۱</option>
                        <option value="photo-2">عکس ۲</option>
                    </select>
                </div>
            </div>
        </div>
        
        <!-- لیست اعضا -->
        @if (Model.Members.Any())
        {
            <div class="mt-3">
                <small class="text-muted d-block mb-2">اعضای تخته:</small>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var member in Model.Members)
                    {
                        <span class="badge bg-secondary">@member.DisplayName</span>
                    }
                </div>
            </div>
        }
    </div>

    <!-- ستون‌های تخته -->
    <div class="board-columns" id="boardColumns" ondrop="handleStatusColumnDrop(event)" ondragover="handleStatusColumnDragOver(event)">
        @foreach (var statusObj in allStatusesList)
        {
            var status = statusObj.Name;
            var tasks = Model.TasksByStatus.ContainsKey(status) ? Model.TasksByStatus[status] : new List<BoardTask>();
            var isToDo = status.Equals("To Do", StringComparison.OrdinalIgnoreCase);
            <div class="board-column status-column @(isToDo ? "to-do-column" : "")" 
                 data-status="@status" 
                 data-status-id="@statusObj.Id"
                 draggable="@(!isToDo ? "true" : "false")"
                 ondragstart="@(!isToDo ? "handleStatusColumnDragStart(event)" : "")"
                 ondragend="@(!isToDo ? "handleStatusColumnDragEnd(event)" : "")"
                 ondragenter="@(!isToDo ? "handleStatusColumnDragEnter(event)" : "")"
                 ondragleave="@(!isToDo ? "handleStatusColumnDragLeave(event)" : "")"
                 ondragover="@(!isToDo ? "handleStatusColumnDragOver(event)" : "")"
                 ondrop="@(!isToDo ? "handleStatusColumnDrop(event)" : "")">
                <div class="column-header">
                    <div class="d-flex align-items-center gap-2">
                        @if (!isToDo)
                        {
                            <i class="bi bi-grip-vertical text-muted" style="cursor: grab;" title="بکشید و رها کنید برای تغییر ترتیب"></i>
                        }
                        <span>@status</span>
                        <span class="badge bg-primary">@tasks.Count.ToString().ToPersianNumbers()</span>
                    </div>
                    @if (!isToDo && Model.CreatorUserId == currentUserId)
                    {
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-danger p-1 delete-status-btn" 
                                    data-status-id="@statusObj.Id" 
                                    data-status-name="@status" 
                                    title="حذف وضعیت">
                                <i class="bi bi-trash" style="font-size: 0.8rem;"></i>
                            </button>
                        </div>
                    }
                </div>
                <div class="column-tasks" id="tasks-@status" data-status="@status" ondrop="handleDrop(event)" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)">
                    @foreach (var task in tasks.OrderBy(t => t.Order).ThenBy(t => t.CreatedAt))
                    {
                        var isSubtask = task.ParentTaskId.HasValue;
                        var completedStyle = task.IsCompleted ? "opacity: 0.7; background: #f8f9fa;" : "";
                        <div class="task-card @(task.IsCompleted ? "task-completed" : "")" draggable="@(!isSubtask ? "true" : "false")" data-task-id="@task.Id" data-status="@task.Status" data-parent-task-id="@(task.ParentTaskId?.ToString() ?? "")" ondragstart="handleDragStart(event)" ondragend="handleDragEnd(event)" style="@(isSubtask ? "cursor: default;" : "") @completedStyle">
                            <div onclick="if(!event.target.closest('a, button')) openTaskDetailsModal(@task.Id)" style="cursor: pointer;">
                                @if (task.IsCompleted)
                                {
                                    <div class="mb-2">
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill"></i>
                                            تکمیل شده
                                        </span>
                                        @if (task.CompletedAt.HasValue)
                                        {
                                            <small class="text-muted ms-2">@task.CompletedAt.Value.ToShortPersianDateString().ToPersianNumbers()</small>
                                        }
                                    </div>
                                }
                                <div class="task-title" style="@(task.IsCompleted ? "text-decoration: line-through; color: #6c757d;" : "")">@task.Title</div>
                                @if (!string.IsNullOrWhiteSpace(task.Description))
                                {
                                    <div class="task-description">@(task.Description.Length > 100 ? task.Description.Substring(0, 100) + "..." : task.Description)</div>
                                }
                                <div class="task-footer">
                                    @if (!string.IsNullOrWhiteSpace(task.AssignedUserId))
                                    {
                                        <span class="task-badge badge-assigned">
                                            <i class="bi bi-person"></i>
                                            اختصاص داده شده
                                        </span>
                                    }
                                    <small>@task.CreatedAt.ToShortPersianDateString().ToPersianNumbers()</small>
                                </div>
                            </div>
                            
                            <!-- دکمه‌های عملیات -->
                            <div class="d-flex gap-2 mt-2" onclick="event.stopPropagation();">
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteTaskDirectly(@task.Id)" title="حذف کار">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
                <!-- دکمه افزودن کار -->
                <button type="button" class="add-task-btn" onclick="showQuickAddTask(event, '@status', @Model.Id, @statusObj.Id)">
                    <i class="bi bi-plus"></i>
                    <span>افزودن کار</span>
                </button>
                <!-- فرم سریع افزودن کار -->
                <div class="quick-add-task-form" id="quick-add-form-@statusObj.Id">
                    <input type="text" 
                           class="quick-add-task-input" 
                           id="quick-add-input-@statusObj.Id"
                           placeholder="عنوان کار را وارد کنید..."
                           onkeypress="handleQuickAddKeyPress(event, '@status', @Model.Id, @statusObj.Id)" />
                    <div class="quick-add-task-actions">
                        <button type="button" class="btn-add-task" onclick="submitQuickAddTask('@status', @Model.Id, @statusObj.Id)">
                            افزودن
                        </button>
                        <button type="button" class="btn-cancel-task" onclick="hideQuickAddTask(@statusObj.Id)">
                            انصراف
                        </button>
                    </div>
                </div>
            </div>
        }
        
        <!-- دکمه افزودن وضعیت جدید - فقط برای سازنده -->
        @if (Model.CreatorUserId == currentUserId)
        {
            <div class="board-column add-status-column" draggable="false">
                <!-- دکمه افزودن وضعیت -->
                <button type="button" class="add-status-btn" onclick="showQuickAddStatus(event, @Model.Id)">
                    <i class="bi bi-plus"></i>
                    <span>افزودن وضعیت</span>
                </button>
                <!-- فرم سریع افزودن وضعیت -->
                <div class="quick-add-status-form" id="quick-add-status-form">
                    <input type="text" 
                           class="quick-add-status-input" 
                           id="quick-add-status-input"
                           placeholder="نام وضعیت را وارد کنید..."
                           onkeypress="handleQuickAddStatusKeyPress(event, @Model.Id)" />
                    <div class="quick-add-status-actions">
                        <button type="button" class="btn-add-status" onclick="submitQuickAddStatus(@Model.Id)">
                            افزودن
                        </button>
                        <button type="button" class="btn-cancel-status" onclick="hideQuickAddStatus()">
                            انصراف
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal برای افزودن کار -->
<div class="modal fade" id="addTaskModal" tabindex="-1" aria-labelledby="addTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTaskModalLabel">افزودن کار جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addTaskForm">
                    <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken" />
