    async function addSubtaskFromDetails() {
        const input = document.getElementById('addSubtaskInput');
        const title = input?.value.trim();
        
        if (!title) {
            alert('لطفاً عنوان آیتم چک لیست را وارد کنید');
            return;
        }
        
        if (!currentTaskDetailsId) {
            alert('خطا: شناسه کار یافت نشد');
            return;
        }
        
        // دریافت اطلاعات کار اصلی
        try {
            const taskResponse = await fetch('@Url.Action("GetTask", "BoardTasks")?id=' + currentTaskDetailsId);
            const taskResult = await taskResponse.json();
            
            if (!taskResult.success) {
                alert('خطا در دریافت اطلاعات کار');
                return;
            }
            
            const task = taskResult.task;
            
            // افزودن کارک
            const formData = new FormData();
            formData.append('BoardId', task.boardId);
            formData.append('Title', title);
            formData.append('Status', task.status || 'To Do');
            formData.append('Description', '');
