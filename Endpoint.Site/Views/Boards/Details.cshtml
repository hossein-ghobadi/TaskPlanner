<script>
    let draggedTask = null;
    let draggedTaskElement = null;

    function handleDragStart(e) {
        // اگر کارک است، اجازه drag نده
        if (e.target.dataset.parentTaskId && e.target.dataset.parentTaskId !== '') {
            e.preventDefault();
            return false;
        }

        draggedTask = {
            id: parseInt(e.target.dataset.taskId),
            status: e.target.dataset.status,
            element: e.target
        };
        draggedTaskElement = e.target;
        e.target.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/html', e.target.outerHTML);
    }

    function handleDragEnd(e) {
        e.target.classList.remove('dragging');
        document.querySelectorAll('.column-tasks').forEach(col => {
            col.classList.remove('drag-over');
        });
        document.querySelectorAll('.board-column').forEach(col => {
            col.classList.remove('drag-over');
        });
    }

    function handleDragOver(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        
        const columnTasks = e.currentTarget;
        columnTasks.classList.add('drag-over');
        
        const column = columnTasks.closest('.board-column');
        if (column) {
            column.classList.add('drag-over');
        }
    }

    function handleDragLeave(e) {
        const columnTasks = e.currentTarget;
        columnTasks.classList.remove('drag-over');
        
        const column = columnTasks.closest('.board-column');
        if (column) {
            column.classList.remove('drag-over');
        }
    }

    function handleDrop(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const columnTasks = e.currentTarget;
        const newStatus = columnTasks.dataset.status;
        columnTasks.classList.remove('drag-over');
        
        const column = columnTasks.closest('.board-column');
        if (column) {
            column.classList.remove('drag-over');
        }

        if (!draggedTask) return;

        // اگر کارک است، اجازه جابجایی نده
        if (draggedTaskElement.dataset.parentTaskId && draggedTaskElement.dataset.parentTaskId !== '') {
            alert('کارک‌ها قابل جابجایی نیستند');
            draggedTaskElement.classList.remove('dragging');
            draggedTask = null;
            draggedTaskElement = null;
            return;
        }

        // اگر در همان ستون است، فقط ترتیب را تغییر بده
        const isSameColumn = draggedTask.status === newStatus;
        
        // حذف کار از مکان قبلی
        const oldColumn = document.querySelector(`#tasks-${draggedTask.status}`);
        draggedTaskElement.remove();

        // اضافه کردن کار به مکان جدید
        const tasks = Array.from(columnTasks.querySelectorAll('.task-card:not(.dragging)'));
        
        // پیدا کردن موقعیت درج
        let insertBefore = null;
        const afterElement = e.target.closest('.task-card');
        if (afterElement && afterElement !== draggedTaskElement) {
            insertBefore = afterElement;
        }

        // ایجاد عنصر جدید
        const newTaskElement = draggedTaskElement.cloneNode(true);
        newTaskElement.classList.remove('dragging');
        newTaskElement.setAttribute('data-status', newStatus);
        newTaskElement.setAttribute('draggable', 'true');
        newTaskElement.addEventListener('dragstart', handleDragStart);
        newTaskElement.addEventListener('dragend', handleDragEnd);

        if (insertBefore) {
            columnTasks.insertBefore(newTaskElement, insertBefore);
        } else {
            columnTasks.appendChild(newTaskElement);
        }

        // محاسبه ترتیب جدید
        const taskOrders = [];
        const allTasks = Array.from(columnTasks.querySelectorAll('.task-card'));
        allTasks.forEach((taskEl, index) => {
            const taskId = parseInt(taskEl.dataset.taskId);
            if (taskId) {
                taskOrders.push({
                    taskId: taskId,
                    status: newStatus,
                    order: index + 1
                });
            }
        });

        // اگر ستون تغییر کرده، کارهای ستون قبلی را هم به‌روزرسانی کن
        if (!isSameColumn && oldColumn) {
            const oldTasks = Array.from(oldColumn.querySelectorAll('.task-card'));
            oldTasks.forEach((taskEl, index) => {
                const taskId = parseInt(taskEl.dataset.taskId);
                if (taskId) {
                    taskOrders.push({
                        taskId: taskId,
                        status: draggedTask.status,
                        order: index + 1
                    });
                }
            });
        }

        // ارسال درخواست به سرور
        updateTaskOrder(taskOrders);

        draggedTask = null;
        draggedTaskElement = null;
    }

    async function updateTaskOrder(taskOrders) {
        try {
            const response = await fetch('@Url.Action("UpdateTaskOrder", "BoardTasks")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                body: JSON.stringify({ taskOrders: taskOrders })
            });

            const result = await response.json();
            if (!result.success) {
                console.error('خطا در به‌روزرسانی ترتیب:', result.message);
                // بارگذاری مجدد صفحه در صورت خطا
                location.reload();
            }
        } catch (error) {
            console.error('خطا در ارسال درخواست:', error);
            location.reload();
        }
    }

    // جلوگیری از کلیک هنگام drag
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.task-card').forEach(card => {
            card.addEventListener('mousedown', function(e) {
                // اگر روی دکمه یا لینک کلیک شده، drag را غیرفعال کن
                if (e.target.closest('a, button')) {
                    this.draggable = false;
                    setTimeout(() => {
                        this.draggable = true;
                    }, 100);
                }
            });
        });
    });

    // مدیریت Modal افزودن کار
    let currentBoardId = @Model.Id;
    let availableUsers = [];

    async function loadAvailableUsers(boardId) {
        if (availableUsers.length > 0) return availableUsers;
        
        try {
            const response = await fetch('@Url.Action("GetAvailableUsers", "BoardTasks")?boardId=' + boardId);
            const result = await response.json();
            
            if (result.success) {
                availableUsers = result.users;
                return availableUsers;
            }
        } catch (error) {
            console.error('خطا در بارگذاری کاربران:', error);
        }
        return [];
    }

    async function openAddTaskModal(status, boardId) {
        const modal = new bootstrap.Modal(document.getElementById('addTaskModal'));
        document.getElementById('addTaskModalLabel').textContent = 'افزودن کار جدید';
        document.getElementById('addTaskForm').reset();
        document.getElementById('addTaskBoardId').value = boardId;
        document.getElementById('addTaskStatus').value = status;
        document.getElementById('addTaskStatusSelect').value = status;
        document.getElementById('addTaskStatusDisplay').value = status;
        document.getElementById('addTaskParentTaskId').value = '';
        
        // بارگذاری لیست کاربران
        const users = await loadAvailableUsers(boardId);
        const select = document.getElementById('addTaskAssignedUserId');
        select.innerHTML = '<option value="">بدون اختصاص</option>';
        users.forEach(user => {
            const option = document.createElement('option');
            option.value = user.id;
            option.textContent = user.displayName;
            select.appendChild(option);
        });
        
        modal.show();
    }

    async function openAddSubtaskModal(parentTaskId, status, boardId) {
        const modal = new bootstrap.Modal(document.getElementById('addTaskModal'));
        document.getElementById('addTaskModalLabel').textContent = 'افزودن کارک جدید';
        document.getElementById('addTaskForm').reset();
        document.getElementById('addTaskBoardId').value = boardId;
        document.getElementById('addTaskStatus').value = status;
        document.getElementById('addTaskStatusSelect').value = status;
        document.getElementById('addTaskStatusDisplay').value = status;
        document.getElementById('addTaskParentTaskId').value = parentTaskId;
        
        // بارگذاری لیست کاربران
        const users = await loadAvailableUsers(boardId);
        const select = document.getElementById('addTaskAssignedUserId');
        select.innerHTML = '<option value="">بدون اختصاص</option>';
        users.forEach(user => {
            const option = document.createElement('option');
            option.value = user.id;
            option.textContent = user.displayName;
            select.appendChild(option);
        });
        
        modal.show();
    }

    async function submitAddTask() {
        const form = document.getElementById('addTaskForm');
        const formData = new FormData(form);
        
        // اطمینان از اینکه Status از select گرفته می‌شود
        formData.set('Status', document.getElementById('addTaskStatusSelect').value);
        
        const submitBtn = document.querySelector('#addTaskModal .btn-primary');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>در حال ایجاد...';
        
        try {
            const response = await fetch('@Url.Action("CreateTask", "BoardTasks")', {
                method: 'POST',
                body: formData
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('addTaskModal'));
                modal.hide();
                form.reset();
                // بارگذاری مجدد صفحه
                location.reload();
            } else {
                alert('خطا: ' + (result.message || 'خطا در ایجاد کار'));
            }
        } catch (error) {
            console.error('خطا در ایجاد کار:', error);
            alert('خطا در ایجاد کار: ' + error.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }

    // Reset modal title when closed
    document.getElementById('addTaskModal').addEventListener('hidden.bs.modal', function () {
        document.getElementById('addTaskModalLabel').textContent = 'افزودن کار جدید';
    });

    // مدیریت Modal ویرایش کار
    async function openEditTaskModal(taskId) {
        const modal = new bootstrap.Modal(document.getElementById('editTaskModal'));
        
        // بارگذاری اطلاعات کار
        try {
            const response = await fetch('@Url.Action("GetTask", "BoardTasks")?id=' + taskId);
            const result = await response.json();
            
            if (result.success) {
                const task = result.task;
                document.getElementById('editTaskId').value = task.id;
                document.getElementById('editTaskBoardId').value = task.boardId;
                document.getElementById('editTaskTitle').value = task.title || '';
                document.getElementById('editTaskDescription').value = task.description || '';
                document.getElementById('editTaskStatusSelect').value = task.status;
                
                // بارگذاری لیست کاربران
                const users = await loadAvailableUsers(task.boardId);
                const select = document.getElementById('editTaskAssignedUserId');
                select.innerHTML = '<option value="">بدون اختصاص</option>';
                users.forEach(user => {
                    const option = document.createElement('option');
                    option.value = user.id;
                    option.textContent = user.displayName;
                    if (user.id === task.assignedUserId) {
                        option.selected = true;
                    }
                    select.appendChild(option);
                });
                
                modal.show();
            } else {
                alert('خطا: ' + (result.message || 'خطا در بارگذاری اطلاعات کار'));
            }
        } catch (error) {
            console.error('خطا در بارگذاری اطلاعات کار:', error);
            alert('خطا در بارگذاری اطلاعات کار: ' + error.message);
        }
    }

    async function submitEditTask() {
        const form = document.getElementById('editTaskForm');
        const formData = new FormData(form);
        
        const submitBtn = document.querySelector('#editTaskModal .btn-primary');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>در حال ذخیره...';
        
        try {
            const response = await fetch('@Url.Action("UpdateTask", "BoardTasks")', {
                method: 'POST',
                body: formData
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('editTaskModal'));
                modal.hide();
                // بارگذاری مجدد صفحه
                location.reload();
            } else {
                alert('خطا: ' + (result.message || 'خطا در ویرایش کار'));
            }
        } catch (error) {
            console.error('خطا در ویرایش کار:', error);
            alert('خطا در ویرایش کار: ' + error.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }

    async function deleteTaskFromModal() {
        const taskId = document.getElementById('editTaskId').value;
        
        if (!taskId) {
            alert('خطا: شناسه کار یافت نشد');
            return;
        }

        await deleteTaskById(taskId, true);
    }

    async function deleteTaskDirectly(taskId) {
        await deleteTaskById(taskId, false);
    }

    // مدیریت وضعیت‌ها
    let boardStatuses = [];

    async function openManageStatusesModal() {
        const modal = new bootstrap.Modal(document.getElementById('manageStatusesModal'));
        await loadStatuses();
        modal.show();
    }

    async function loadStatuses() {
        try {
            const response = await fetch('@Url.Action("GetStatuses", "Boards")?boardId=@Model.Id');
            const result = await response.json();
            
            if (result.success) {
                boardStatuses = result.statuses;
                displayStatuses();
            } else {
                alert('خطا: ' + (result.message || 'خطا در بارگذاری وضعیت‌ها'));
            }
        } catch (error) {
            console.error('خطا در بارگذاری وضعیت‌ها:', error);
            alert('خطا در بارگذاری وضعیت‌ها: ' + error.message);
        }
    }

    function displayStatuses() {
        const container = document.getElementById('statusesList');
        if (!boardStatuses || boardStatuses.length === 0) {
            container.innerHTML = '<div class="text-center text-muted py-3">هنوز وضعیتی تعریف نشده است</div>';
            return;
        }

        let html = '';
        boardStatuses.forEach((status, index) => {
            html += `
                <div class="list-group-item d-flex justify-content-between align-items-center status-item" 
                     draggable="true" 
                     data-status-id="${status.id}"
                     data-order="${status.order}"
                     ondragstart="handleStatusDragStart(event)"
                     ondragover="handleStatusDragOver(event)"
                     ondrop="handleStatusDrop(event)"
                     ondragend="handleStatusDragEnd(event)"
                     style="cursor: move; user-select: none;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-grip-vertical text-muted" style="cursor: grab;"></i>
                        <span class="badge" style="background-color: ${status.color || '#6c757d'}">${escapeHtml(status.name)}</span>
                        ${status.description ? `<small class="text-muted">${escapeHtml(status.description)}</small>` : ''}
                    </div>
                    <button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation(); deleteStatus(${status.id}, '${escapeHtml(status.name)}')">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;
        });
        container.innerHTML = html;
    }

    let draggedStatusElement = null;
    let draggedStatusId = null;

    function handleStatusDragStart(e) {
        draggedStatusElement = e.currentTarget;
        draggedStatusId = parseInt(e.currentTarget.dataset.statusId);
        e.currentTarget.style.opacity = '0.5';
        e.currentTarget.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
    }

    function handleStatusDragOver(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        
        const afterElement = getDragAfterElement(e.currentTarget.parentElement, e.clientY);
        const dragging = document.querySelector('.status-item.dragging');
        
        if (afterElement == null) {
            e.currentTarget.parentElement.appendChild(draggedStatusElement);
        } else {
            e.currentTarget.parentElement.insertBefore(draggedStatusElement, afterElement);
        }
    }

    function handleStatusDrop(e) {
        e.preventDefault();
        updateStatusOrder();
    }

    function handleStatusDragEnd(e) {
        e.currentTarget.style.opacity = '1';
        e.currentTarget.classList.remove('dragging');
    }

    function getDragAfterElement(container, y) {
        const draggableElements = [...container.querySelectorAll('.status-item:not(.dragging)')];
        
        return draggableElements.reduce((closest, child) => {
            const box = child.getBoundingClientRect();
            const offset = y - box.top - box.height / 2;
            
            if (offset < 0 && offset > closest.offset) {
                return { offset: offset, element: child };
            } else {
                return closest;
            }
        }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    async function updateStatusOrder() {
        const statusItems = Array.from(document.querySelectorAll('.status-item'));
        const statusOrders = statusItems.map((item, index) => ({
            statusId: parseInt(item.dataset.statusId),
            order: index + 1
        }));

        try {
            const response = await fetch('@Url.Action("UpdateStatusOrder", "Boards")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                body: JSON.stringify({ boardId: @Model.Id, statusOrders: statusOrders })
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                await loadStatuses();
                // بارگذاری مجدد صفحه برای به‌روزرسانی ستون‌ها
                location.reload();
            } else {
                alert('خطا: ' + (result.message || 'خطا در تغییر ترتیب وضعیت‌ها'));
                await loadStatuses(); // بازگشت به حالت قبلی
            }
        } catch (error) {
            console.error('خطا در تغییر ترتیب وضعیت‌ها:', error);
            alert('خطا در تغییر ترتیب وضعیت‌ها: ' + error.message);
            await loadStatuses(); // بازگشت به حالت قبلی
        }
    }

    document.getElementById('addStatusForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const name = document.getElementById('newStatusName').value.trim();
        const color = document.getElementById('newStatusColor').value;
        
        if (!name) {
            alert('نام وضعیت الزامی است');
            return;
        }

        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>در حال افزودن...';
        
        try {
            const response = await fetch('@Url.Action("AddStatus", "Boards")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                body: `boardId=@Model.Id&name=${encodeURIComponent(name)}&color=${encodeURIComponent(color)}`
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success) {
                document.getElementById('newStatusName').value = '';
                document.getElementById('newStatusColor').value = '#6c757d';
                await loadStatuses();
            } else {
                alert('خطا: ' + (result.message || 'خطا در افزودن وضعیت'));
            }
        } catch (error) {
            console.error('خطا در افزودن وضعیت:', error);
            alert('خطا در افزودن وضعیت: ' + error.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    });

    async function deleteStatus(statusId, statusName) {
        if (!confirm(`آیا از حذف وضعیت "${statusName}" اطمینان دارید؟`)) {
            return;
        }
        await deleteStatusById(statusId);
    }

    async function deleteStatusFromColumn(statusId, statusName) {
        console.log('deleteStatusFromColumn called:', statusId, statusName);
        
        if (!confirm(`آیا از حذف وضعیت "${statusName}" اطمینان دارید؟`)) {
            console.log('User cancelled deletion');
            return;
        }
        
        console.log('Calling deleteStatusById with statusId:', statusId);
        await deleteStatusById(statusId);
    }

    async function deleteStatusById(statusId) {
        console.log('deleteStatusById called with statusId:', statusId);
        
        try {
            const formData = new FormData();
            formData.append('statusId', statusId);
            formData.append('__RequestVerificationToken', '@antiforgeryToken');

            console.log('Sending delete request to:', '@Url.Action("DeleteStatus", "Boards")');
            
            const response = await fetch('@Url.Action("DeleteStatus", "Boards")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                body: formData
            });
            
            console.log('Response status:', response.status);
            console.log('Response ok:', response.ok);
            
            if (!response.ok) {
                const errorText = await response.text();
                console.error('Response error:', errorText);
                alert('خطا در حذف وضعیت: ' + errorText);
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            console.log('Response result:', result);
            
            if (result.success) {
                alert('وضعیت با موفقیت حذف شد');
                location.reload();
            } else {
                alert('خطا: ' + (result.message || 'خطا در حذف وضعیت'));
            }
        } catch (error) {
            console.error('خطا در حذف وضعیت:', error);
            alert('خطا در حذف وضعیت: ' + error.message);
        }
    }

    async function deleteTaskById(taskId, closeModal) {
        if (!confirm('آیا از حذف این کار اطمینان دارید؟ این عمل قابل بازگشت نیست.')) {
