@{
    ViewData["Title"] = "دعوت کاربر به تخته";
    Layout = "/Views/Shared/_Layout.cshtml";
    var boardId = ViewBag.BoardId as int?;
    var boardName = ViewBag.BoardName as string;
    var projectCollaborators = ViewBag.ProjectCollaborators as IEnumerable<dynamic>;
    
    var hasProjectCollaborators = projectCollaborators != null && projectCollaborators.Any();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="bi bi-person-plus me-2"></i>
                        دعوت کاربر به تخته: @boardName
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Invite" method="post">
                        <input type="hidden" name="boardId" value="@boardId" />
                        
                        @if (hasProjectCollaborators)
                        {
                            <div class="mb-4">
                                <h5 class="mb-3">
                                    <i class="bi bi-people-fill me-2 text-primary"></i>
                                    همکاران پروژه‌ای
                                </h5>
                                <div class="list-group">
                                    @foreach (var user in projectCollaborators)
                                    {
                                        <label class="list-group-item">
                                            <input type="checkbox" name="selectedUserIds" value="@user.Id" class="form-check-input me-2">
                                            <span class="badge bg-primary me-2">پروژه</span>
                                            @user.DisplayName
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                همکاری برای دعوت وجود ندارد. برای دعوت کاربران، ابتدا باید در پروژه‌های مشترک با آن‌ها باشید.
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" @(!hasProjectCollaborators ? "disabled" : "")>
                                <i class="bi bi-check-circle me-2"></i>
                                دعوت همکاران انتخاب شده
                            </button>
                            <a asp-action="Details" asp-route-id="@boardId" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-2"></i>
                                انصراف
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

