@{
    ViewData["Title"] = "دعوت کاربر به تخته";
    Layout = "/Views/Shared/_Layout.cshtml";
    var boardId = ViewBag.BoardId as int?;
    var boardName = ViewBag.BoardName as string;
    var availableUsers = ViewBag.AvailableUsers as dynamic;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="bi bi-person-plus me-2"></i>
                        دعوت کاربر به تخته: @boardName
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Invite" method="post">
                        <input type="hidden" name="boardId" value="@boardId" />
                        <div class="mb-3">
                            <label class="form-label">انتخاب کاربران</label>
                            @if (availableUsers != null && ((IEnumerable<dynamic>)availableUsers).Any())
                            {
                                <div class="list-group">
                                    @foreach (var user in (IEnumerable<dynamic>)availableUsers)
                                    {
                                        <label class="list-group-item">
                                            <input type="checkbox" name="selectedUserIds" value="@user.Id" class="form-check-input me-2">
                                            @user.DisplayName
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle me-2"></i>
                                    کاربری برای دعوت وجود ندارد.
                                </div>
                            }
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" @(availableUsers == null || !((IEnumerable<dynamic>)availableUsers).Any() ? "disabled" : "")>
                                <i class="bi bi-check-circle me-2"></i>
                                دعوت کاربران
                            </button>
                            <a asp-action="Details" asp-route-id="@boardId" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-2"></i>
                                انصراف
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

