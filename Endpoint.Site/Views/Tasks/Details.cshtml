@model TaskItem
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var returnAction = Model.IsCompleted && (Model.ParentTask?.IsCompleted ?? true)
        ? "Completed"
        : "Index";
    var pc = new System.Globalization.PersianCalendar();
    string ToJalali(DateTime d) => $"{pc.GetYear(d):0000}/{pc.GetMonth(d):00}/{pc.GetDayOfMonth(d):00}";
    
    // تبدیل اعداد به حروف فارسی
    string ConvertToPersianWords(int number)
    {
        if (number == 0) return "صفر";
        
        string[] ones = { "", "یک", "دو", "سه", "چهار", "پنج", "شش", "هفت", "هشت", "نه", "ده", "یازده", "دوازده", "سیزده", "چهارده", "پانزده", "شانزده", "هفده", "هجده", "نوزده" };
        string[] tens = { "", "", "بیست", "سی", "چهل", "پنجاه", "شصت", "هفتاد", "هشتاد", "نود" };
        string[] hundreds = { "", "یکصد", "دویست", "سیصد", "چهارصد", "پانصد", "ششصد", "هفتصد", "هشتصد", "نهصد" };
        string[] thousands = { "", "هزار", "میلیون", "میلیارد" };
        
        if (number < 20)
            return ones[number];
        
        if (number < 100)
        {
            int ten = number / 10;
            int one = number % 10;
            if (one == 0)
                return tens[ten];
            return tens[ten] + " و " + ones[one];
        }
        
        if (number < 1000)
        {
            int hundred = number / 100;
            int remainder = number % 100;
            if (remainder == 0)
                return hundreds[hundred];
            return hundreds[hundred] + " و " + ConvertToPersianWords(remainder);
        }
        
        if (number < 10000)
        {
            int thousand = number / 1000;
            int remainder = number % 1000;
            string result = (thousand == 1 ? "" : ConvertToPersianWords(thousand) + " ") + thousands[1];
            if (remainder == 0)
                return result;
            return result + " و " + ConvertToPersianWords(remainder);
        }
        
        return number.ToString();
    }
    
    string ToJalaliWithWords(DateTime d)
    {
        int year = pc.GetYear(d);
        int month = pc.GetMonth(d);
        int day = pc.GetDayOfMonth(d);
        
        string monthName = month switch
        {
            1 => "فروردین",
            2 => "اردیبهشت",
            3 => "خرداد",
            4 => "تیر",
            5 => "مرداد",
            6 => "شهریور",
            7 => "مهر",
            8 => "آبان",
            9 => "آذر",
            10 => "دی",
            11 => "بهمن",
            12 => "اسفند",
            _ => month.ToString()
        };
        
        return $"{ConvertToPersianWords(day)} {monthName} {ConvertToPersianWords(year)}";
    }
}

<style>
    /* استایل‌های مدرن برای صفحه کار */
    .task-details-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
    }

    /* هدر کار */
    .task-header {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border-radius: 20px;
        padding: 30px;
        color: white;
        margin-bottom: 30px;
        box-shadow: 0 10px 40px rgba(59, 130, 246, 0.3);
    }

    .task-header h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .task-header .task-icon {
        font-size: 2.5rem;
    }

    .task-header .task-key {
        background: rgba(255, 255, 255, 0.2);
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .task-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 20px;
    }

    .task-meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.15);
        padding: 8px 16px;
        border-radius: 12px;
        font-size: 0.9rem;
    }

    .task-meta-item i {
        font-size: 1.1rem;
    }

    /* کارت‌های اطلاعات */
    .info-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .info-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }

    .info-card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .info-card-title i {
        color: #3b82f6;
        font-size: 1.3rem;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-item-label {
        color: #6b7280;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-item-value {
        color: #1f2937;
        font-weight: 500;
        text-align: left;
    }

    .badge-modern {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    /* بخش چت */
    .chat-container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 700px;
    }

    .chat-header {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        padding: 20px 25px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-header h5 {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .chat-count-badge {
        background: rgba(255, 255, 255, 0.25);
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background: #f9fafb;
    }

    .chat-message {
        margin-bottom: 20px;
        animation: fadeInUp 0.3s ease;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .chat-message.own {
        display: flex;
        justify-content: flex-end;
    }

    .chat-message.other {
        display: flex;
        justify-content: flex-start;
    }

    .message-bubble {
        max-width: 70%;
        padding: 12px 18px;
        border-radius: 18px;
        position: relative;
        word-wrap: break-word;
    }

    .message-bubble.own {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .message-bubble.other {
        background: white;
        color: #1f2937;
        border-bottom-left-radius: 4px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .message-user {
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 5px;
        color: #3b82f6;
    }

    .message-text {
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .message-time {
        font-size: 0.75rem;
        opacity: 0.7;
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .message-actions {
        margin-top: 8px;
        display: flex;
        gap: 10px;
    }

    .message-actions a {
        color: inherit;
        opacity: 0.7;
        transition: opacity 0.2s;
        text-decoration: none;
        font-size: 0.85rem;
    }

    .message-actions a:hover {
        opacity: 1;
    }

    .chat-input-area {
        padding: 20px;
        background: white;
        border-top: 1px solid #e5e7eb;
    }

    .chat-input-wrapper {
        display: flex;
        gap: 10px;
        align-items: flex-end;
    }

    .chat-input {
        flex: 1;
        border: 2px solid #e5e7eb;
        border-radius: 25px;
        padding: 12px 20px;
        font-size: 0.95rem;
        transition: border-color 0.2s;
        resize: none;
        min-height: 50px;
        max-height: 120px;
    }

    .chat-input:focus {
        outline: none;
        border-color: #3b82f6;
    }

    .chat-actions {
        display: flex;
        gap: 8px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .chat-action-btn {
        background: #f3f4f6;
        border: none;
        border-radius: 12px;
        padding: 10px 16px;
        font-size: 0.85rem;
        color: #4b5563;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .chat-action-btn:hover {
        background: #e5e7eb;
        color: #1f2937;
    }

    .chat-action-btn.recording {
        background: #fee2e2;
        color: #dc2626;
    }

    .chat-action-btn.recording:hover {
        background: #fecaca;
    }

    .chat-send-btn {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border: none;
        border-radius: 25px;
        padding: 12px 24px;
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chat-send-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }

    .chat-send-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .file-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .file-preview-item {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
    }

    .file-preview-item img {
        max-width: 150px;
        max-height: 150px;
        border-radius: 12px;
    }

    .file-preview-item .remove-btn {
        position: absolute;
        top: 5px;
        right: 5px;
        background: rgba(220, 38, 38, 0.9);
        color: white;
        border: none;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.8rem;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #9ca3af;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 15px;
        opacity: 0.5;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .status-badge.completed {
        background: #d1fae5;
        color: #065f46;
    }

    .status-badge.in-progress {
        background: #fef3c7;
        color: #92400e;
    }

    /* دکمه بازگشت */
    .back-btn {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px 20px;
        color: #4b5563;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        margin-bottom: 20px;
    }

    .back-btn:hover {
        background: #f9fafb;
        border-color: #3b82f6;
        color: #3b82f6;
    }

    /* ریسپانسیو */
    @@media (max-width: 768px) {
        .task-header h1 {
            font-size: 1.5rem;
        }

        .task-meta {
            flex-direction: column;
            gap: 10px;
        }

        .message-bubble {
            max-width: 85%;
        }

        .chat-container {
            height: 600px;
        }
    }
</style>

<div class="task-details-page">
    <!-- دکمه بازگشت -->
    <a class="back-btn" asp-action="@returnAction" asp-route-projectId="@Model.ProjectId">
        <i class="bi bi-arrow-right"></i>
        بازگشت به لیست
    </a>

    <!-- هدر کار -->
    <div class="task-header">
        <h1>
            <span class="task-icon" title="@Model.IssueTypeName">@Model.IssueTypeIcon</span>
            <span>@Model.Title</span>
            @if (!string.IsNullOrEmpty(Model.IssueKey))
            {
                <span class="task-key">@Model.IssueKey</span>
            }
        </h1>
        <div class="task-meta">
            <div class="task-meta-item">
                <i class="bi bi-folder"></i>
                <span>@Model.Project?.Name</span>
            </div>
            @if (Model.Category != null)
            {
                <div class="task-meta-item">
                    <i class="bi bi-tag"></i>
                    <span>@Model.Category.Name</span>
                </div>
            }
            <div class="task-meta-item">
                <i class="bi bi-@(Model.IsCompleted ? "check-circle" : "clock")"></i>
                <span class="status-badge @(Model.IsCompleted ? "completed" : "in-progress")">
                    @(Model.IsCompleted ? "✅ انجام شده" : "⏳ در حال انجام")
                </span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- ستون چپ: جزئیات -->
        <div class="col-lg-5">
            <!-- اطلاعات اصلی -->
            <div class="info-card">
                <div class="info-card-title">
                    <i class="bi bi-info-circle"></i>
                    اطلاعات اصلی
                </div>
                <div class="info-item">
                    <span class="info-item-label">
                        <i class="bi bi-type"></i>
                        نوع کار
                    </span>
                    <span class="info-item-value">
                        <span class="badge badge-modern @Model.IssueType.GetBadgeColor()">@Model.IssueTypeName</span>
                    </span>
                </div>
                <div class="info-item">
                    <span class="info-item-label">
                        <i class="bi bi-calendar-event"></i>
                        تاریخ شروع
                    </span>
                    <span class="info-item-value">@ToJalali(Model.StartDate)</span>
                </div>
                @if (Model.DueDate.HasValue)
                {
                    <div class="info-item">
                        <span class="info-item-label">
                            <i class="bi bi-calendar-check"></i>
                            مهلت انجام
                        </span>
                        <span class="info-item-value">@ToJalali(Model.DueDate.Value)</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.AssignedUserId))
                {
                    <div class="info-item">
                        <span class="info-item-label">
                            <i class="bi bi-person"></i>
                            مسئول
                        </span>
                        <span class="info-item-value">مشخص شده</span>
                    </div>
                }
            </div>

            <!-- توضیحات -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="info-card">
                    <div class="info-card-title">
                        <i class="bi bi-file-text"></i>
                        توضیحات
                    </div>
                    <p style="color: #4b5563; line-height: 1.8; margin: 0;">@Model.Description</p>
                </div>
            }
        </div>

        <!-- ستون راست: چت -->
        <div class="col-lg-7">
            <div class="chat-container">
                <div class="chat-header">
                    <h5>
                        <i class="bi bi-chat-dots"></i>
                        گفتگوی گروهی
                    </h5>
                    <span class="chat-count-badge" id="commentCount">0</span>
                </div>
                
                <div class="chat-messages" id="chatBox">
                    <div class="empty-state" id="loadingComments">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">در حال بارگذاری...</span>
                        </div>
                    </div>
                </div>

                <div class="chat-input-area">
                    <form id="chatForm">
                        <div class="chat-input-wrapper">
                            <textarea 
                                id="messageInput" 
                                class="chat-input" 
                                placeholder="پیام خود را بنویسید..."
                                rows="1"></textarea>
                            <button type="submit" id="sendBtn" class="chat-send-btn">
                                <i class="bi bi-send"></i>
                                ارسال
                            </button>
                        </div>
                        
                        <div class="chat-actions">
                            <label class="chat-action-btn">
                                <i class="bi bi-paperclip"></i>
                                فایل
                                <input type="file" id="fileInput" name="Attachments" multiple accept="image/*,audio/*,.pdf,.doc,.docx,.txt" style="display: none;" onchange="handleFileInputChange()" />
                            </label>
                            
                            <button type="button" class="chat-action-btn" id="recordBtn" onclick="toggleRecording()">
                                <span id="recordIcon"><i class="bi bi-mic"></i></span>
                                <span id="recordText">ضبط ویس</span>
                            </button>
                            
                            <span id="recordTimer" class="chat-action-btn" style="background: transparent; padding: 0;"></span>
                        </div>
                        
                        <!-- نمایش فایل‌های انتخاب شده -->
                        <div id="selectedFiles" class="file-preview"></div>
                        <div id="audioPreview" class="mt-2"></div>
                        <div id="clipboardPreviews" class="file-preview"></div>
                        
                        <input type="hidden" name="TaskId" value="@Model.Id" />
                        <input type="hidden" name="__RequestVerificationToken" value="@token" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const taskId = @Model.Id;
    const currentUserId = '@ViewBag.CurrentUserId';
    const token = '@token';
    const sendButton = document.getElementById('sendBtn');
    const recordButton = document.getElementById('recordBtn');

    // ضبط ویس
    let mediaRecorder;
    let audioChunks = [];
    let recordingStartTime;
    let timerInterval;

    // بارگذاری کامنت‌ها
    async function loadComments() {
        try {
            const response = await fetch(`/Tasks/GetComments?taskId=${taskId}`);
            const comments = await response.json();
            
            const chatBox = document.getElementById('chatBox');
            
            if (comments.length === 0) {
                chatBox.innerHTML = `
                    <div class="empty-state">
                        <i class="bi bi-chat-left"></i>
                        <p>هنوز پیامی ارسال نشده است.</p>
                    </div>
                `;
            } else {
                chatBox.innerHTML = '';
                comments.forEach(comment => {
                    chatBox.appendChild(createCommentElement(comment));
                });
                chatBox.scrollTop = chatBox.scrollHeight;
            }
            
            document.getElementById('commentCount').textContent = comments.length;
            document.getElementById('loadingComments')?.remove();
        } catch (error) {
            console.error('خطا در بارگذاری کامنت‌ها:', error);
        }
    }

    // ساخت المان کامنت
    function createCommentElement(comment) {
        const div = document.createElement('div');
        div.className = `chat-message ${comment.isCurrentUser ? 'own' : 'other'}`;
        div.id = `comment-${comment.id}`;
        
        const date = new Date(comment.createdAt).toLocaleString('fa-IR');
        
        let attachmentsHtml = '';
        if (comment.attachments && comment.attachments.length > 0) {
            attachmentsHtml = '<div class="mt-2">';
            comment.attachments.forEach(att => {
                if (att.fileType === 'Image') {
                    attachmentsHtml += `<div class="mb-2"><a href="${att.filePath}" target="_blank" rel="noopener"><img src="${att.filePath}" alt="${att.fileName}" class="img-fluid rounded" style="max-height: 200px; cursor: zoom-in; border-radius: 12px;" /></a></div>`;
                } else if (att.fileType === 'Audio') {
                    attachmentsHtml += `<div class="mb-2"><audio controls class="w-100" style="border-radius: 12px;"><source src="${att.filePath}" type="${att.mimeType}"></audio></div>`;
                } else {
                    attachmentsHtml += `<div class="mb-2"><a href="${att.filePath}" target="_blank" rel="noopener" class="text-decoration-none" style="color: inherit; opacity: 0.8;"><i class="bi bi-file-earmark"></i> ${att.fileName} (${Math.round(att.fileSize / 1024)} KB)</a></div>`;
                }
            });
            attachmentsHtml += '</div>';
        }
        
        div.innerHTML = `
            <div class="message-bubble ${comment.isCurrentUser ? 'own' : 'other'}">
                ${!comment.isCurrentUser ? `<div class="message-user">${comment.userName}</div>` : ''}
                ${comment.message ? `<div class="message-text">${comment.message}</div>` : ''}
                ${attachmentsHtml}
                <div class="message-time">
                    <i class="bi bi-clock"></i>
                    <span>${date}</span>
                </div>
                ${comment.isCurrentUser ? `
                    <div class="message-actions">
                        <a href="#" onclick="deleteComment(${comment.id}, this); return false;">
                            <i class="bi bi-trash"></i> حذف
                        </a>
                    </div>
                ` : ''}
            </div>
        `;
        
        return div;
    }

    // نمایش فایل‌های انتخاب شده (فقط فایل‌های غیر تصویری)
    function showSelectedFiles() {
        const fileInput = document.getElementById('fileInput');
        const selectedFilesDiv = document.getElementById('selectedFiles');
        
        if (!selectedFilesDiv) return;
        
        // همیشه ابتدا پاک می‌کنیم
        selectedFilesDiv.innerHTML = '';
        
        if (fileInput.files.length > 0) {
            Array.from(fileInput.files).forEach((file, index) => {
                // فقط فایل‌های غیر تصویری را در selectedFiles نمایش می‌دهیم
                // تصاویر در clipboardPreviews نمایش داده می‌شوند
                if (!file.type.startsWith('image/')) {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'file-preview-item';
                    wrapper.style.background = '#f3f4f6';
                    wrapper.style.padding = '10px 15px';
                    wrapper.style.borderRadius = '12px';
                    wrapper.innerHTML = `
                        <span style="font-size: 0.85rem;">${file.name}</span>
                        <button type="button" class="remove-btn" onclick="removeFileFromInput(${index})" style="position: static; margin-right: 10px;">&times;</button>
                    `;
                    selectedFilesDiv.appendChild(wrapper);
                }
            });
        }
        // refreshClipboardPreviews دیگر اینجا صدا زده نمی‌شود چون در addFileToInput صدا زده می‌شود
    }

    // ضبط ویس
    async function toggleRecording() {
        if (!mediaRecorder || mediaRecorder.state === 'inactive') {
            await startRecording();
        } else {
            stopRecording();
        }
    }

    async function startRecording() {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            
            let mimeType = 'audio/webm';
            if (MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) {
                mimeType = 'audio/webm;codecs=opus';
            } else if (MediaRecorder.isTypeSupported('audio/ogg;codecs=opus')) {
                mimeType = 'audio/ogg;codecs=opus';
            } else if (MediaRecorder.isTypeSupported('audio/mp4')) {
                mimeType = 'audio/mp4';
            }
            
            mediaRecorder = new MediaRecorder(stream, { mimeType: mimeType });
            audioChunks = [];

            mediaRecorder.ondataavailable = (event) => {
                if (event.data && event.data.size > 0) {
                    audioChunks.push(event.data);
                }
            };

            mediaRecorder.onstop = () => {
                if (audioChunks.length === 0) {
                    alert('هیچ داده صوتی ضبط نشد. لطفاً دوباره تلاش کنید.');
                    stream.getTracks().forEach(track => track.stop());
                    return;
                }
                
                const recordedMimeType = mediaRecorder.mimeType;
                const audioBlob = new Blob(audioChunks, { type: recordedMimeType });
                
                if (audioBlob.size === 0) {
                    alert('فایل صوتی خالی است. لطفاً دوباره تلاش کنید.');
                    stream.getTracks().forEach(track => track.stop());
                    return;
                }
                
                const audioUrl = URL.createObjectURL(audioBlob);
                
                const preview = document.getElementById('audioPreview');
                const audioElement = document.createElement('audio');
                audioElement.controls = true;
                audioElement.src = audioUrl;
                audioElement.className = 'w-100';
                audioElement.style.borderRadius = '12px';
                preview.innerHTML = '';
                preview.appendChild(audioElement);

                const extension = recordedMimeType.includes('ogg') ? '.ogg' : recordedMimeType.includes('mp4') ? '.m4a' : '.webm';
                const fileName = `voice_${new Date().getTime()}${extension}`;
                const file = new File([audioBlob], fileName, { type: recordedMimeType });
                addFileToInput(file);

                stream.getTracks().forEach(track => track.stop());
            };

            mediaRecorder.start(100);
            recordingStartTime = Date.now();
            
            recordButton.classList.add('recording');
            recordButton.querySelector('#recordIcon').innerHTML = '<i class="bi bi-stop-circle"></i>';
            recordButton.querySelector('#recordText').textContent = 'توقف';

            timerInterval = setInterval(updateTimer, 1000);
        } catch (error) {
            alert('خطا در دسترسی به میکروفن: ' + error.message);
        }
    }

    function stopRecording() {
        if (mediaRecorder && mediaRecorder.state === 'recording') {
            mediaRecorder.stop();
            clearInterval(timerInterval);

            recordButton.classList.remove('recording');
            recordButton.querySelector('#recordIcon').innerHTML = '<i class="bi bi-mic"></i>';
            recordButton.querySelector('#recordText').textContent = 'ضبط ویس';
            document.getElementById('recordTimer').textContent = '';
        }
    }

    function updateTimer() {
        const elapsed = Math.floor((Date.now() - recordingStartTime) / 1000);
        const minutes = Math.floor(elapsed / 60).toString().padStart(2, '0');
        const seconds = (elapsed % 60).toString().padStart(2, '0');
        document.getElementById('recordTimer').textContent = `${minutes}:${seconds}`;
    }

    function addFileToInput(file) {
        const fileInput = document.getElementById('fileInput');
        const selectedFilesDiv = document.getElementById('selectedFiles');
        
        // ابتدا selectedFiles را پاک می‌کنیم تا از نمایش موقت جلوگیری شود
        if (selectedFilesDiv) {
            selectedFilesDiv.innerHTML = '';
        }
        
        const dataTransfer = new DataTransfer();
        
        for (let i = 0; i < fileInput.files.length; i++) {
            dataTransfer.items.add(fileInput.files[i]);
        }
        
        dataTransfer.items.add(file);
        fileInput.files = dataTransfer.files;
        
        // ابتدا تصاویر را نمایش می‌دهیم، سپس فایل‌های غیر تصویری
        refreshClipboardPreviews();
        showSelectedFiles();
    }

    function removeFileFromInput(index) {
        const fileInput = document.getElementById('fileInput');
        const selectedFilesDiv = document.getElementById('selectedFiles');
        
        // ابتدا selectedFiles را پاک می‌کنیم
        if (selectedFilesDiv) {
            selectedFilesDiv.innerHTML = '';
        }
        
        const dataTransfer = new DataTransfer();

        for (let i = 0; i < fileInput.files.length; i++) {
            if (i !== index) {
                dataTransfer.items.add(fileInput.files[i]);
            }
        }

        fileInput.files = dataTransfer.files;
        
        // ابتدا تصاویر را نمایش می‌دهیم، سپس فایل‌های غیر تصویری
        refreshClipboardPreviews();
        showSelectedFiles();
    }

    function refreshClipboardPreviews() {
        const fileInput = document.getElementById('fileInput');
        const previewContainer = document.getElementById('clipboardPreviews');
        if (!previewContainer) {
            return;
        }

        previewContainer.innerHTML = '';
        Array.from(fileInput.files).forEach((file, index) => {
            if (file.type.startsWith('image/')) {
                const url = URL.createObjectURL(file);
                const wrapper = document.createElement('div');
                wrapper.className = 'file-preview-item';
                wrapper.innerHTML = `
                    <img src="${url}" alt="${file.name}" />
                    <button type="button" class="remove-btn" onclick="removeFileFromInput(${index})">&times;</button>
                `;
                previewContainer.appendChild(wrapper);
            }
        });
    }

    // تابع برای handle کردن تغییرات file input
    function handleFileInputChange() {
        const selectedFilesDiv = document.getElementById('selectedFiles');
        
        // ابتدا selectedFiles را پاک می‌کنیم تا از نمایش موقت جلوگیری شود
        if (selectedFilesDiv) {
            selectedFilesDiv.innerHTML = '';
        }
        
        // ابتدا تصاویر را نمایش می‌دهیم، سپس فایل‌های غیر تصویری
        refreshClipboardPreviews();
        showSelectedFiles();
    }

    // چسباندن تصویر از کلیپ‌بورد
    document.getElementById('messageInput').addEventListener('paste', (event) => {
        if (!event.clipboardData || !event.clipboardData.items) {
            return;
        }

        const items = event.clipboardData.items;
        let handled = false;

        for (let i = 0; i < items.length; i++) {
            const item = items[i];
            if (item.kind === 'file' && item.type.startsWith('image/')) {
                const file = item.getAsFile();
                if (file) {
                    addFileToInput(file);
                    handled = true;
                    // addFileToInput خودش showSelectedFiles و refreshClipboardPreviews را صدا می‌زند
                }
            }
        }

        if (handled) {
            event.preventDefault();
        }
    });

    // تنظیم ارتفاع خودکار برای textarea
    const messageInput = document.getElementById('messageInput');
    messageInput.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 120) + 'px';
    });

    // ارسال کامنت
    document.getElementById('chatForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const messageInput = document.getElementById('messageInput');
        const fileInput = document.getElementById('fileInput');
        const message = messageInput.value.trim();
        
        if (!message && fileInput.files.length === 0) {
            alert('لطفاً پیام یا فایلی ارسال کنید');
            return;
        }
        if (sendButton.disabled) {
            return;
        }

        sendButton.disabled = true;
        const shouldDisableRecord = recordButton && !recordButton.disabled;
        if (shouldDisableRecord) {
            recordButton.disabled = true;
        }

        try {
            const formData = new FormData();
            formData.append('TaskId', taskId);
            formData.append('Message', message);
            formData.append('__RequestVerificationToken', token);
            
            for (let i = 0; i < fileInput.files.length; i++) {
                formData.append('Attachments', fileInput.files[i]);
            }
            
            const response = await fetch('/Tasks/PostComment', {
                method: 'POST',
                body: formData
            });
            
            if (response.ok) {
                const comment = await response.json();
                const chatBox = document.getElementById('chatBox');
                
                if (chatBox.querySelector('.empty-state')) {
                    chatBox.innerHTML = '';
                }
                
                chatBox.appendChild(createCommentElement(comment));
                chatBox.scrollTop = chatBox.scrollHeight;
                
                messageInput.value = '';
                messageInput.style.height = 'auto';
                fileInput.value = '';
                document.getElementById('selectedFiles').innerHTML = '';
                document.getElementById('audioPreview').innerHTML = '';
                refreshClipboardPreviews();
                
                const count = parseInt(document.getElementById('commentCount').textContent);
                document.getElementById('commentCount').textContent = count + 1;
            } else {
                const errorText = await response.text();
                alert('خطا در ارسال پیام: ' + errorText);
            }
        } catch (error) {
            console.error('خطا در ارسال پیام:', error);
            alert('خطا در ارسال پیام');
        } finally {
            sendButton.disabled = false;
            if (shouldDisableRecord && recordButton) {
                recordButton.disabled = false;
            }
        }
    });

    // حذف کامنت
    async function deleteComment(commentId, triggerElement) {
        if (!confirm('آیا مطمئن هستید که می‌خواهید این پیام را حذف کنید؟')) {
            return;
        }

        let previousContent = '';
        if (triggerElement) {
            previousContent = triggerElement.innerHTML;
            triggerElement.style.pointerEvents = 'none';
            triggerElement.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
        }
        
        try {
            const formData = new FormData();
            formData.append('commentId', commentId);
            formData.append('__RequestVerificationToken', token);
            
            const response = await fetch('/Tasks/DeleteComment', {
                method: 'POST',
                body: formData
            });
            
            if (response.ok) {
                document.getElementById(`comment-${commentId}`)?.remove();
                
                const count = parseInt(document.getElementById('commentCount').textContent);
                document.getElementById('commentCount').textContent = Math.max(0, count - 1);
                
                const chatBox = document.getElementById('chatBox');
                if (chatBox.children.length === 0) {
                    chatBox.innerHTML = `
                        <div class="empty-state">
                            <i class="bi bi-chat-left"></i>
                            <p>هنوز پیامی ارسال نشده است.</p>
                        </div>
                    `;
                }
            }
        } catch (error) {
            console.error('خطا در حذف پیام:', error);
            alert('خطا در حذف پیام');
        } finally {
            if (triggerElement && document.body.contains(triggerElement)) {
                triggerElement.style.pointerEvents = '';
                triggerElement.innerHTML = previousContent || '<i class="bi bi-trash"></i> حذف';
            }
        }
    }

    loadComments();
    setInterval(loadComments, 5000);
</script>
}




@* 

 @model TaskItem
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var returnAction = Model.IsCompleted && (Model.ParentTask?.IsCompleted ?? true)
        ? "Completed"
        : "Index";
    var pc = new System.Globalization.PersianCalendar();
    string ToJalali(DateTime d) => $"{pc.GetYear(d):0000}/{pc.GetMonth(d):00}/{pc.GetDayOfMonth(d):00}";
    
    // تبدیل اعداد به حروف فارسی
    string ConvertToPersianWords(int number)
    {
        if (number == 0) return "صفر";
        
        string[] ones = { "", "یک", "دو", "سه", "چهار", "پنج", "شش", "هفت", "هشت", "نه", "ده", "یازده", "دوازده", "سیزده", "چهارده", "پانزده", "شانزده", "هفده", "هجده", "نوزده" };
        string[] tens = { "", "", "بیست", "سی", "چهل", "پنجاه", "شصت", "هفتاد", "هشتاد", "نود" };
        string[] hundreds = { "", "یکصد", "دویست", "سیصد", "چهارصد", "پانصد", "ششصد", "هفتصد", "هشتصد", "نهصد" };
        string[] thousands = { "", "هزار", "میلیون", "میلیارد" };
        
        if (number < 20)
            return ones[number];
        
        if (number < 100)
        {
            int ten = number / 10;
            int one = number % 10;
            if (one == 0)
                return tens[ten];
            return tens[ten] + " و " + ones[one];
        }
        
        if (number < 1000)
        {
            int hundred = number / 100;
            int remainder = number % 100;
            if (remainder == 0)
                return hundreds[hundred];
            return hundreds[hundred] + " و " + ConvertToPersianWords(remainder);
        }
        
        if (number < 10000)
        {
            int thousand = number / 1000;
            int remainder = number % 1000;
            string result = (thousand == 1 ? "" : ConvertToPersianWords(thousand) + " ") + thousands[1];
            if (remainder == 0)
                return result;
            return result + " و " + ConvertToPersianWords(remainder);
        }
        
        return number.ToString();
    }
    
    string ToJalaliWithWords(DateTime d)
    {
        int year = pc.GetYear(d);
        int month = pc.GetMonth(d);
        int day = pc.GetDayOfMonth(d);
        
        string monthName = month switch
        {
            1 => "فروردین",
            2 => "اردیبهشت",
            3 => "خرداد",
            4 => "تیر",
            5 => "مرداد",
            6 => "شهریور",
            7 => "مهر",
            8 => "آبان",
            9 => "آذر",
            10 => "دی",
            11 => "بهمن",
            12 => "اسفند",
            _ => month.ToString()
        };
        
        return $"{ConvertToPersianWords(day)} {monthName} {ConvertToPersianWords(year)}";
    }
}

