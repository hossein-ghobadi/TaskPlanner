        border-radius: 12px;
        padding: 10px 20px;
        color: #4b5563;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        margin-bottom: 20px;
    }

    .back-btn:hover {
        background: #f9fafb;
        border-color: #3b82f6;
        color: #3b82f6;
    }

    /* ریسپانسیو */
    @@media (max-width: 768px) {
        .task-header h1 {
            font-size: 1.5rem;
        }

        .task-meta {
            flex-direction: column;
            gap: 10px;
        }

        .message-bubble {
            max-width: 85%;
        }

        .chat-container {
            height: 600px;
        }
    }
</style>

<!-- بخش چت فقط؛ حذف سایر بخش‌ها -->
<div class="task-details-page">
  

        <div class="col-lg-7">
            <div class="chat-container">
                <div class="chat-header">
                    <h5>
                        <i class="bi bi-chat-dots"></i>
                        گفتگوی گروهی
                    </h5>
                    <span class="chat-count-badge" id="commentCount">0</span>
                </div>

                <div class="chat-messages" id="chatBox">
                    <div class="empty-state" id="loadingComments">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">در حال بارگذاری...</span>
                        </div>
                    </div>
                </div>

                <div class="chat-input-area">
                    <form id="chatForm">
                        <div class="chat-input-wrapper">
                            <textarea id="messageInput"
                                      class="chat-input"
                                      placeholder="پیام خود را بنویسید..."
                                      rows="1"></textarea>
                            <button type="submit" id="sendBtn" class="chat-send-btn">
                                <i class="bi bi-send"></i>
                                ارسال
                            </button>
                        </div>

                        <div class="chat-actions">
                            <label class="chat-action-btn">
                                <i class="bi bi-paperclip"></i>
                                فایل
                                <input type="file" id="fileInput" name="Attachments" multiple accept="image/*,audio/*,.pdf,.doc,.docx,.txt" style="display: none;" onchange="handleFileInputChange()" />
                            </label>

                            <button type="button" class="chat-action-btn" id="recordBtn" onclick="toggleRecording()">
                                <span id="recordIcon"><i class="bi bi-mic"></i></span>
                                <span id="recordText">ضبط ویس</span>
                            </button>

                            <span id="recordTimer" class="chat-action-btn" style="background: transparent; padding: 0;"></span>
                        </div>

                        <!-- نمایش فایل‌های انتخاب شده -->
                        <div id="selectedFiles" class="file-preview"></div>
                        <div id="audioPreview" class="mt-2"></div>
                        <div id="clipboardPreviews" class="file-preview"></div>

                        <input type="hidden" name="TaskId" value="@Model.Id" />
                        <input type="hidden" name="__RequestVerificationToken" value="@token" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // تنظیمات پایه از Razor
             

        const taskId = @Model.Id;
        const token = '@token';
        let mediaRecorder;
        let audioChunks = [];
        let recordingStartTime;
        let timerInterval;

        // بارگذاری پیام‌ها
        async function loadComments() {
          try {
            const response = await fetch(`/Tasks/GetComments?taskId=${taskId}`);
            const comments = await response.json();
            const chatBox = document.getElementById('chatBox');
            if (!comments || comments.length === 0) {
              chatBox.innerHTML = `<div class="empty-state">هنوز پیامی ارسال نشده است.</div>`;
            } else {
              chatBox.innerHTML = '';
              comments.forEach(comment => {
                chatBox.appendChild(createCommentElement(comment));
              });
              chatBox.scrollTop = chatBox.scrollHeight;
            }
            // شمار پیام‌ها
            const count = comments?.length ?? 0;
            document.getElementById('commentCount').textContent = count;
          } catch (error) {
            console.error('خطا در بارگذاری کامنت‌ها:', error);
          } finally {
            document.getElementById('loadingComments')?.remove();
          }
        }

        // ساخت المان کامنت
        function createCommentElement(comment) {
          const div = document.createElement('div');
          div.className = `chat-message ${comment.isCurrentUser ? 'own' : 'other'}`;
          div.id = `comment-${comment.id}`;

          const date = new Date(comment.createdAt).toLocaleString('fa-IR');
          let attachmentsHtml = '';
          if (comment.attachments && comment.attachments.length > 0) {
            attachmentsHtml = comment.attachments.map(att => {
              if (att.fileType === 'Image') {
                return `<img src="${att.url}" alt="" style="max-width:200px; display:block; margin-top:6px;" />`;
              } else if (att.fileType === 'Audio') {
                return `<audio controls src="${att.url}" style="width:100%; margin-top:6px;"></audio>`;
              } else {
                return `<a href="${att.url}" target="_blank">${att.fileName}</a>`;
              }
            }).join('');
          }

          div.innerHTML = `
            ${!comment.isCurrentUser ? `<div class="message-user">${comment.userName}</div>` : ''}
            <div class="message-text">${comment.message ?? ''}</div>
            ${attachmentsHtml}
            <div class="message-time">${date} ${comment.isCurrentUser ? `<a href="#" onclick="deleteComment(${comment.id})" style="margin-left:8px;">حذف</a>` : ''}</div>
          `;
          return div;
        }

        // نمایش فایل‌های انتخاب‌شده (فقط غیر تصویری)
        function showSelectedFiles() {
          const fileInput = document.getElementById('fileInput');
          const selectedFilesDiv = document.getElementById('selectedFiles');
          if (!selectedFilesDiv) return;

          selectedFilesDiv.innerHTML = '';
          if (fileInput.files.length > 0) {
            Array.from(fileInput.files).forEach((file) => {
              if (!file.type.startsWith('image/')) {
                const wrapper = document.createElement('div');
                wrapper.className = 'file-preview-item';
                wrapper.style.background = '#f3f4f6';
                wrapper.style.padding = '10px 15px';
                wrapper.style.borderRadius = '12px';
                wrapper.textContent = file.name;
                selectedFilesDiv.appendChild(wrapper);
              }
            });
          }
        }

        // ضبط ویس
        async function toggleRecording() {
          if (!mediaRecorder || mediaRecorder.state === 'inactive') {
            await startRecording();
          } else {
            stopRecording();
          }
        }

        async function startRecording() {
          try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            let mimeType = 'audio/webm';
            if (MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) {
              mimeType = 'audio/webm;codecs=opus';
            } else if (MediaRecorder.isTypeSupported('audio/ogg;codecs=opus')) {
              mimeType = 'audio/ogg;codecs=opus';
            } else if (MediaRecorder.isTypeSupported('audio/mp4')) {
              mimeType = 'audio/mp4';
            }

            mediaRecorder = new MediaRecorder(stream, { mimeType });
            audioChunks = [];
            mediaRecorder.ondataavailable = (e) => {
              if (e.data && e.data.size > 0) audioChunks.push(e.data);
            };
            mediaRecorder.onstop = () => {
              if (audioChunks.length === 0) {
                alert('فایل صوتی خالی است.');
                stream.getTracks().forEach(t => t.stop());
                return;
              }
              const blob = new Blob(audioChunks, { type: mediaRecorder.mimeType });
              const url = URL.createObjectURL(blob);
              const audioEl = document.createElement('audio');
              audioEl.controls = true;
              audioEl.src = url;
              document.getElementById('audioPreview').innerHTML = '';
              document.getElementById('audioPreview').appendChild(audioEl);

              // اضافه کردن به ورودی فایل برای ارسال
              const file = new File([blob], `voice_${Date.now()}.webm`, { type: mediaRecorder.mimeType });
              addFileToInput(file);
              stream.getTracks().forEach(t => t.stop());
            };

            mediaRecorder.start(100);
            recordingStartTime = Date.now();
            document.getElementById('recordBtn').classList.add('recording');
            document.getElementById('recordText').textContent = 'توقف';
            timerInterval = setInterval(() => {
              const elapsed = Math.floor((Date.now() - recordingStartTime) / 1000);
              const m = String(Math.floor(elapsed / 60)).padStart(2, '0');
              const s = String(elapsed % 60).padStart(2, '0');
              document.getElementById('recordTimer').textContent = `${m}:${s}`;
            }, 1000);
          } catch (error) {
            alert('خطا در دسترسی به میکروفن: ' + error.message);
          }
        }

        function stopRecording() {
          if (mediaRecorder && mediaRecorder.state === 'recording') {
            mediaRecorder.stop();
            clearInterval(timerInterval);
            document.getElementById('recordBtn').classList.remove('recording');
            document.getElementById('recordText').textContent = 'ضبط ویس';
            document.getElementById('recordTimer').textContent = '';
          }
        }

        // افزودن فایل به ورودی فرم برای ارسال
        function addFileToInput(file) {
          const fileInput = document.getElementById('fileInput');
          const dataTransfer = new DataTransfer();
          // نگه دار همه فایل‌های قبلی و اضافه کن فایل جدید
          for (let i = 0; i < fileInput.files.length; i++) dataTransfer.items.add(fileInput.files[i]);
          dataTransfer.items.add(file);
          fileInput.files = dataTransfer.files;
          showSelectedFiles();
        }

        // هندلرها
        function handleFileInputChange() {
          showSelectedFiles();
        }

        // ارسال پیام
        async function sendMessage() {
          const messageInput = document.getElementById('messageInput');
          const message = messageInput.value.trim();

          const formData = new FormData();
          formData.append('TaskId', taskId);
          formData.append('Message', message);
          formData.append('__RequestVerificationToken', token);

          const fileInput = document.getElementById('fileInput');
          Array.from(fileInput.files || []).forEach((f) => formData.append('Attachments', f));

          try {
            const response = await fetch('/Tasks/AddComment', {
              method: 'POST',
              body: formData
            });
            if (response.ok) {
              messageInput.value = '';
              fileInput.value = '';
              showSelectedFiles();
              loadComments(); // بروزرسانی سریع
            } else {
              alert('خطا در ارسال پیام');
            }
          } catch (err) {
            console.error(err);
          }
        }

        // حذف پیام (اختیاری)
        function deleteComment(commentId) {
          fetch(`/Tasks/DeleteComment?commentId=${commentId}`, { method: 'POST' })
            .then(res => res.ok && loadComments())
            .catch(() => {});
        }

        // رویدادهای پایه
        document.getElementById('sendBtn').addEventListener('click', sendMessage);
        document.getElementById('fileInput').addEventListener('change', handleFileInputChange);
        document.getElementById('messageInput').addEventListener('paste', () => {
          // اختیاری: پاست کردن فایل‌ها
        });

        // مقداردهی‌های اولیه و دوره‌ای
        document.addEventListener('DOMContentLoaded', () => {
          loadComments();
          setInterval(loadComments, 5000);
        });
    </script>
}
