@model TaskItem
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="row">
    <!-- جزئیات تسک -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">جزئیات تسک</h5>
            </div>
            <div class="card-body">
                <h4>
                    <span class="me-2" title="@Model.IssueTypeName">@Model.IssueTypeIcon</span>
                    @Model.Title
                    @if (!string.IsNullOrEmpty(Model.IssueKey))
                    {
                        <small class="text-muted">(@Model.IssueKey)</small>
                    }
                </h4>
                <p><strong>نوع:</strong> <span class="badge @@Model.IssueType.GetBadgeColor()">@Model.IssueTypeName</span></p>
                <p><strong>پروژه:</strong> @Model.Project?.Name</p>
                <p><strong>دسته‌بندی:</strong> @Model.Category?.Name</p>
                <p><strong>توضیحات:</strong> @Model.Description</p>
                <p><strong>تاریخ شروع:</strong> @Model.StartDate.ToString("yyyy/MM/dd")</p>
                @if (Model.DueDate.HasValue)
                {
                    <p><strong>مهلت انجام:</strong> @Model.DueDate.Value.ToString("yyyy/MM/dd")</p>
                }
                <p><strong>وضعیت:</strong> @(Model.IsCompleted ? "✅ انجام شده" : "⏳ در حال انجام")</p>
                @if (!string.IsNullOrEmpty(Model.AssignedUserId))
                {
                    <p><strong>مسئول:</strong> مشخص شده</p>
                }
                
                <div class="mt-3">
@*                     <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">ویرایش</a>
 *@                    <a class="btn btn-secondary" asp-action="Index" asp-route-projectId="@Model.ProjectId">بازگشت به لیست</a>
                </div>
            </div>
        </div>
    </div>

    <!-- گفتگوی گروهی -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">💬 گفتگوی گروهی</h5>
                <span class="badge bg-light text-dark" id="commentCount">0</span>
            </div>
            
            <div class="card-body" style="height: 400px; overflow-y: auto;" id="chatBox">
                <div class="text-center text-muted" id="loadingComments">
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                </div>
            </div>

            <div class="card-footer">
                <form id="chatForm">
                    <div class="mb-2">
                        <input type="text" id="messageInput" class="form-control" placeholder="پیام خود را بنویسید..." />
                    </div>
                    
                    <!-- آپلود فایل و ضبط ویس -->
                    <div class="mb-2">
                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <label class="btn btn-sm btn-outline-primary mb-0">
                                📎 فایل
                                <input type="file" id="fileInput" name="Attachments" multiple accept="image/*,audio/*,.pdf,.doc,.docx,.txt" style="display: none;" onchange="showSelectedFiles()" />
                            </label>
                            
                            <button type="button" class="btn btn-sm btn-outline-danger" id="recordBtn" onclick="toggleRecording()">
                                <span id="recordIcon">🎤</span> <span id="recordText">ضبط ویس</span>
                            </button>
                            
                            <span id="recordTimer" class="text-muted small"></span>
                            
                            <button type="submit" id="sendBtn" class="btn btn-sm btn-primary ms-auto">ارسال</button>
                        </div>
                    </div>
                    
                    <!-- نمایش فایل‌های انتخاب شده -->
                    <div id="selectedFiles" class="small text-muted"></div>
                    <div id="audioPreview"></div>
                    
                    <input type="hidden" name="TaskId" value="@Model.Id" />
                    <input type="hidden" name="__RequestVerificationToken" value="@token" />
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const taskId = @Model.Id;
    const currentUserId = '@ViewBag.CurrentUserId';
    const token = '@token';
    const sendButton = document.getElementById('sendBtn');
    const recordButton = document.getElementById('recordBtn');

    // ضبط ویس
    let mediaRecorder;
    let audioChunks = [];
    let recordingStartTime;
    let timerInterval;

    // بارگذاری کامنت‌ها
    async function loadComments() {
        try {
            const response = await fetch(`/Tasks/GetComments?taskId=${taskId}`);
            const comments = await response.json();
            
            const chatBox = document.getElementById('chatBox');
            
            if (comments.length === 0) {
                chatBox.innerHTML = '<div class="text-center text-muted">هنوز پیامی ارسال نشده است.</div>';
            } else {
                chatBox.innerHTML = '';
                comments.forEach(comment => {
                    chatBox.appendChild(createCommentElement(comment));
                });
                chatBox.scrollTop = chatBox.scrollHeight;
            }
            
            document.getElementById('commentCount').textContent = comments.length;
            document.getElementById('loadingComments')?.remove();
        } catch (error) {
            console.error('خطا در بارگذاری کامنت‌ها:', error);
        }
    }

    // ساخت المان کامنت
    function createCommentElement(comment) {
        const div = document.createElement('div');
        div.className = 'mb-3';
        div.id = `comment-${comment.id}`;
        
        // در RTL: float-start = سمت راست، float-end = سمت چپ
        div.style.textAlign = comment.isCurrentUser ? 'right' : 'left';
        
        const date = new Date(comment.createdAt).toLocaleString('fa-IR');
        
        let attachmentsHtml = '';
        if (comment.attachments && comment.attachments.length > 0) {
            attachmentsHtml = '<div class="mt-2">';
            comment.attachments.forEach(att => {
                if (att.fileType === 'Image') {
                    attachmentsHtml += `<div class="mb-2"><a href="${att.filePath}" target="_blank" rel="noopener"><img src="${att.filePath}" alt="${att.fileName}" class="img-fluid rounded" style="max-height: 150px; cursor: zoom-in;" /></a></div>`;
                } else if (att.fileType === 'Audio') {
                    attachmentsHtml += `<div class="mb-2"><audio controls class="w-100"><source src="${att.filePath}" type="${att.mimeType}"></audio></div>`;
                } else {
                    attachmentsHtml += `<div class="mb-2"><a href="${att.filePath}" target="_blank" rel="noopener" class="text-decoration-none">📄 ${att.fileName} (${Math.round(att.fileSize / 1024)} KB)</a></div>`;
                }
            });
            attachmentsHtml += '</div>';
        }
        
        div.innerHTML = `
            <div class="d-inline-block ${comment.isCurrentUser ? 'bg-primary text-white' : 'bg-light text-dark'} p-3 rounded-3 shadow-sm" style="max-width: 75%;">
                ${!comment.isCurrentUser ? `<div class="fw-bold small mb-1" style="color: #0d6efd;">${comment.userName}</div>` : ''}
                ${comment.message ? `<div class="mb-1">${comment.message}</div>` : ''}
                ${attachmentsHtml}
                <div class="small ${comment.isCurrentUser ? 'text-white-50' : 'text-muted'} mt-1 d-flex justify-content-between align-items-center">
                    <span>${date}</span>
                    ${comment.isCurrentUser ? `<a href="#" class="text-white ms-2 text-decoration-none delete-comment-link" onclick="deleteComment(${comment.id}, this); return false;">🗑️ حذف</a>` : ''}
                </div>
            </div>
        `;
        
        return div;
    }

    // نمایش فایل‌های انتخاب شده
    function showSelectedFiles() {
        const fileInput = document.getElementById('fileInput');
        const selectedFilesDiv = document.getElementById('selectedFiles');
        
        if (fileInput.files.length > 0) {
            const fileNames = Array.from(fileInput.files).map(f => f.name).join(', ');
            selectedFilesDiv.textContent = `فایل‌های انتخاب شده: ${fileNames}`;
        } else {
            selectedFilesDiv.textContent = '';
        }
        refreshClipboardPreviews();
    }

    // ضبط ویس
    async function toggleRecording() {
        if (!mediaRecorder || mediaRecorder.state === 'inactive') {
            await startRecording();
        } else {
            stopRecording();
        }
    }

    async function startRecording() {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            
            // انتخاب بهترین فرمت صوتی موجود
            let mimeType = 'audio/webm';
            if (MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) {
                mimeType = 'audio/webm;codecs=opus';
            } else if (MediaRecorder.isTypeSupported('audio/ogg;codecs=opus')) {
                mimeType = 'audio/ogg;codecs=opus';
            } else if (MediaRecorder.isTypeSupported('audio/mp4')) {
                mimeType = 'audio/mp4';
            }
            
            console.log('Using MIME type:', mimeType);
            mediaRecorder = new MediaRecorder(stream, { mimeType: mimeType });
            audioChunks = [];

            mediaRecorder.ondataavailable = (event) => {
                if (event.data && event.data.size > 0) {
                    audioChunks.push(event.data);
                    console.log('Audio chunk captured:', event.data.size, 'bytes');
                }
            };

            mediaRecorder.onstop = () => {
                console.log('Recording stopped. Total chunks:', audioChunks.length);
                
                if (audioChunks.length === 0) {
                    alert('هیچ داده صوتی ضبط نشد. لطفاً دوباره تلاش کنید.');
                    stream.getTracks().forEach(track => track.stop());
                    return;
                }
                
                const recordedMimeType = mediaRecorder.mimeType;
                const audioBlob = new Blob(audioChunks, { type: recordedMimeType });
                console.log('Audio blob size:', audioBlob.size, 'bytes');
                
                if (audioBlob.size === 0) {
                    alert('فایل صوتی خالی است. لطفاً دوباره تلاش کنید.');
                    stream.getTracks().forEach(track => track.stop());
                    return;
                }
                
                const audioUrl = URL.createObjectURL(audioBlob);
                
                const preview = document.getElementById('audioPreview');
                const audioElement = document.createElement('audio');
                audioElement.controls = true;
                audioElement.src = audioUrl;
                audioElement.className = 'w-100 mt-2';
                preview.innerHTML = '';
                preview.appendChild(audioElement);

                // تعیین پسوند فایل بر اساس MIME type
                const extension = recordedMimeType.includes('ogg') ? '.ogg' : recordedMimeType.includes('mp4') ? '.m4a' : '.webm';
                const fileName = `voice_${new Date().getTime()}${extension}`;
                const file = new File([audioBlob], fileName, { type: recordedMimeType });
                addFileToInput(file);

                stream.getTracks().forEach(track => track.stop());
            };

            // شروع ضبط با timeslice برای جمع‌آوری بهتر داده‌ها (هر 100 میلی‌ثانیه)
            mediaRecorder.start(100);
            recordingStartTime = Date.now();
            console.log('Recording started...');
            
            document.getElementById('recordBtn').classList.remove('btn-outline-danger');
            document.getElementById('recordBtn').classList.add('btn-danger');
            document.getElementById('recordIcon').textContent = '■';
            document.getElementById('recordText').textContent = 'توقف';

            timerInterval = setInterval(updateTimer, 1000);
        } catch (error) {
            alert('خطا در دسترسی به میکروفن: ' + error.message);
        }
    }

    function stopRecording() {
        if (mediaRecorder && mediaRecorder.state === 'recording') {
            mediaRecorder.stop();
            clearInterval(timerInterval);

            document.getElementById('recordBtn').classList.remove('btn-danger');
            document.getElementById('recordBtn').classList.add('btn-outline-danger');
            document.getElementById('recordIcon').textContent = '🎤';
            document.getElementById('recordText').textContent = 'ضبط ویس';
            document.getElementById('recordTimer').textContent = '';
        }
    }

    function updateTimer() {
        const elapsed = Math.floor((Date.now() - recordingStartTime) / 1000);
        const minutes = Math.floor(elapsed / 60).toString().padStart(2, '0');
        const seconds = (elapsed % 60).toString().padStart(2, '0');
        document.getElementById('recordTimer').textContent = `${minutes}:${seconds}`;
    }

    function addFileToInput(file) {
        const fileInput = document.getElementById('fileInput');
        const dataTransfer = new DataTransfer();
        
        for (let i = 0; i < fileInput.files.length; i++) {
            dataTransfer.items.add(fileInput.files[i]);
        }
        
        dataTransfer.items.add(file);
        fileInput.files = dataTransfer.files;
        showSelectedFiles();
        refreshClipboardPreviews();
    }

    function removeFileFromInput(index) {
        const fileInput = document.getElementById('fileInput');
        const dataTransfer = new DataTransfer();

        for (let i = 0; i < fileInput.files.length; i++) {
            if (i !== index) {
                dataTransfer.items.add(fileInput.files[i]);
            }
        }

        fileInput.files = dataTransfer.files;
        showSelectedFiles();
        refreshClipboardPreviews();
    }

    function refreshClipboardPreviews() {
        const fileInput = document.getElementById('fileInput');
        const previewContainer = document.getElementById('clipboardPreviews');
        if (!previewContainer) {
            return;
        }

        previewContainer.innerHTML = '';
        Array.from(fileInput.files).forEach((file, index) => {
            if (file.type.startsWith('image/')) {
                const url = URL.createObjectURL(file);
                const wrapper = document.createElement('div');
                wrapper.className = 'position-relative d-inline-block me-2 mb-2';
                wrapper.innerHTML = `
                    <img src="${url}" alt="${file.name}" class="img-fluid rounded" style="max-height: 120px;" />
                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1" onclick="removeFileFromInput(${index})">&times;</button>
                `;
                previewContainer.appendChild(wrapper);
            }
        });
    }

    const filesInfoContainer = document.getElementById('selectedFiles');
    if (filesInfoContainer) {
        filesInfoContainer.insertAdjacentHTML('afterend', '<div id="clipboardPreviews" class="mt-2"></div>');
    }

    // چسباندن تصویر از کلیپ‌بورد
    document.getElementById('messageInput').addEventListener('paste', (event) => {
        if (!event.clipboardData || !event.clipboardData.items) {
            return;
        }

        const items = event.clipboardData.items;
        let handled = false;

        for (let i = 0; i < items.length; i++) {
            const item = items[i];
            if (item.kind === 'file' && item.type.startsWith('image/')) {
                const file = item.getAsFile();
                if (file) {
                    addFileToInput(file);
                    handled = true;

                    // پیش‌نمایش سریع تصویر اضافه‌شده
                    refreshClipboardPreviews();
                }
            }
        }

        if (handled) {
            event.preventDefault();
            const filesInfo = document.getElementById('selectedFiles');
            if (filesInfo.textContent) {
                filesInfo.textContent += '، تصویر از کلیپ‌بورد';
            } else {
                filesInfo.textContent = 'تصویر از کلیپ‌بورد اضافه شد.';
            }
        }
    });

    // ارسال کامنت
    document.getElementById('chatForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const messageInput = document.getElementById('messageInput');
        const fileInput = document.getElementById('fileInput');
        const message = messageInput.value.trim();
        
        if (!message && fileInput.files.length === 0) {
            alert('لطفاً پیام یا فایلی ارسال کنید');
            return;
        }
        if (sendButton.disabled) {
            return;
        }

        const wasDisabled = sendButton.disabled;
        sendButton.disabled = true;
        const shouldDisableRecord = recordButton && !recordButton.disabled;
        if (shouldDisableRecord) {
            recordButton.disabled = true;
        }

        try {
            const formData = new FormData();
            formData.append('TaskId', taskId);
            formData.append('Message', message);
            formData.append('__RequestVerificationToken', token);
            
            // افزودن فایل‌ها
            for (let i = 0; i < fileInput.files.length; i++) {
                formData.append('Attachments', fileInput.files[i]);
            }
            
            const response = await fetch('/Tasks/PostComment', {
                method: 'POST',
                body: formData
            });
            
            if (response.ok) {
                const comment = await response.json();
                const chatBox = document.getElementById('chatBox');
                
                if (chatBox.querySelector('.text-center.text-muted')) {
                    chatBox.innerHTML = '';
                }
                
                chatBox.appendChild(createCommentElement(comment));
                chatBox.scrollTop = chatBox.scrollHeight;
                
                messageInput.value = '';
                fileInput.value = '';
                document.getElementById('selectedFiles').textContent = '';
                document.getElementById('audioPreview').innerHTML = '';
                refreshClipboardPreviews();
                
                const count = parseInt(document.getElementById('commentCount').textContent);
                document.getElementById('commentCount').textContent = count + 1;
            } else {
                const errorText = await response.text();
                alert('خطا در ارسال پیام: ' + errorText);
            }
        } catch (error) {
            console.error('خطا در ارسال پیام:', error);
            alert('خطا در ارسال پیام');
        } finally {
            sendButton.disabled = false;
            if (shouldDisableRecord && recordButton) {
                recordButton.disabled = false;
            }
        }
    });

    // حذف کامنت
    async function deleteComment(commentId, triggerElement) {
        if (!confirm('آیا مطمئن هستید که می‌خواهید این پیام را حذف کنید؟')) {
            return;
        }

        let previousContent = '';
        if (triggerElement) {
            previousContent = triggerElement.innerHTML;
            triggerElement.style.pointerEvents = 'none';
            triggerElement.innerHTML = '<span class="spinner-border spinner-border-sm text-white" role="status" aria-hidden="true"></span>';
        }
        
        try {
            const formData = new FormData();
            formData.append('commentId', commentId);
            formData.append('__RequestVerificationToken', token);
            
            const response = await fetch('/Tasks/DeleteComment', {
                method: 'POST',
                body: formData
            });
            
            if (response.ok) {
                document.getElementById(`comment-${commentId}`)?.remove();
                
                const count = parseInt(document.getElementById('commentCount').textContent);
                document.getElementById('commentCount').textContent = Math.max(0, count - 1);
                
                const chatBox = document.getElementById('chatBox');
                if (chatBox.children.length === 0) {
                    chatBox.innerHTML = '<div class="text-center text-muted">هنوز پیامی ارسال نشده است.</div>';
                }
            }
        } catch (error) {
            console.error('خطا در حذف پیام:', error);
            alert('خطا در حذف پیام');
        } finally {
            if (triggerElement && document.body.contains(triggerElement)) {
                triggerElement.style.pointerEvents = '';
                triggerElement.innerHTML = previousContent || '🗑️ حذف';
            }
        }
    }

    loadComments();
    setInterval(loadComments, 5000);
</script>
}
