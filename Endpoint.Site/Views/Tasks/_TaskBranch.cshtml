@using DNTPersianUtils.Core
@model TaskPlanner.Domain.Entities.TaskPlanner.TaskItem
@{
    var userLookup = ViewBag.UserLookup as Dictionary<string, string>;
    var hasSubs = Model.ChildIssues?.Any() ?? false;
    var collapseId = $"collapse_{Model.Id}";
}

<style>
    .task-card__children {
        overflow: visible !important;
    }
    .task-tree-wrapper,
    .task-node {
        overflow: visible !important;
    }
    .task-card {
        overflow: visible !important;
        cursor: pointer;
    }
</style>

@{
    var isChildCard = Model.ParentTaskId != null;
    var isCompleted = Model.IsCompleted;
    var dueState = Model.DueDate switch
    {
        null => "badge rounded-pill bg-secondary-subtle text-secondary",
        var due when due.Value.Date < DateTime.Today => "badge rounded-pill bg-danger-subtle text-danger",
        var due when due.Value.Date <= DateTime.Today.AddDays(3) => "badge rounded-pill bg-warning-subtle text-warning",
        _ => "badge rounded-pill bg-success-subtle text-success"
    };
    var assignedName = Model.AssignedUserId != null && userLookup.ContainsKey(Model.AssignedUserId)
        ? userLookup[Model.AssignedUserId]
        : "تعیین نشده";
    string GetIssueTypePillClass(TaskItem task) 
    {
        // اگر ProjectIssueType وجود دارد و Color دارد، از آن استفاده کن
        if (task.ProjectIssueType != null && !string.IsNullOrWhiteSpace(task.ProjectIssueType.Color))
        {
            return ""; // رنگ از ProjectIssueType.Color استفاده می‌شود
        }
        
        // در غیر این صورت از IssueType استفاده کن
        return task.IssueType switch
        {
            IssueType.Epic => "badge rounded-pill bg-primary",
            IssueType.Story => "badge rounded-pill bg-info",
            IssueType.Task => "badge rounded-pill bg-success",
            IssueType.Subtask => "badge rounded-pill bg-secondary",
            IssueType.Bug => "badge rounded-pill bg-danger",
            _ => "badge rounded-pill bg-dark"
        };
    }
    
    string GetIssueTypeStyle(TaskItem task)
    {
        // اگر ProjectIssueType وجود دارد و Color دارد، از آن استفاده کن
        if (task.ProjectIssueType != null && !string.IsNullOrWhiteSpace(task.ProjectIssueType.Color))
        {
            return $"background-color: {task.ProjectIssueType.Color}; color: #fff;";
        }
        return "";
    }
}

<div class="task-card @(isCompleted ? "task-card--completed" : "")"
     role="button"
     tabindex="0"
     onclick="@(isChildCard ? $"event.stopPropagation(); openEditTaskModal({Model.Id})" : $"openEditTaskModal({Model.Id})")"
     onkeydown="@(isChildCard
         ? $"if(event.key==='Enter' || event.key===' '){{ event.preventDefault(); event.stopPropagation(); openEditTaskModal({Model.Id}); }}"
         : $"if(event.key==='Enter' || event.key===' '){{ event.preventDefault(); openEditTaskModal({Model.Id}); }}")">
    <div class="task-card__body">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="d-flex align-items-start gap-3">
                <div class="flex-shrink-0" style="width: 40px; height: 40px; border-radius: 8px; background: #f3f4f6; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                    @Model.IssueTypeIcon
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h6 class="mb-0 fw-semibold" style="font-size: 1rem; color: #1f2937;">
                            @Model.Title
                        </h6>
                        @if (!string.IsNullOrEmpty(Model.IssueKey))
                        {
                            <span class="badge rounded-pill" style="background: #e5e7eb; color: #374151; font-size: 0.75rem;">@Model.IssueKey</span>
                        }
                        <span class="@GetIssueTypePillClass(Model)" style="@GetIssueTypeStyle(Model); font-size: 0.75rem;">
                            @Model.IssueTypeName
                        </span>
                        @if (isCompleted)
                        {
                            <span class="badge rounded-pill" style="background: #d1fae5; color: #065f46; font-size: 0.75rem;">
                                <i class="bi bi-check2-circle me-1"></i> خاتمه یافته
                            </span>
                        }
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2" style="font-size: 0.875rem; color: #6b7280;">
                        <span>
                            <i class="bi bi-person me-1"></i>
                            @assignedName
                        </span>
                        @if (Model.DueDate != null)
                        {
                            <span class="@dueState">
                                <i class="bi bi-calendar3 me-1"></i>
                                @Model.DueDate.Value.ToShortPersianDateString()
                            </span>
                        }
                        @if (Model.WorkflowStatus != null)
                        {
                            <span class="badge rounded-pill"
                                  style="background-color: @Model.WorkflowStatus.Color; color: #fff; font-size: 0.75rem;">
                                @Model.WorkflowStatus.Name
                            </span>
                        }
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1">
                @if (hasSubs)
                {
                    <button class="btn btn-sm" style="border: 1px solid #e5e7eb; background: white; color: #6b7280; border-radius: 6px; padding: 0.25rem 0.5rem;"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="false"
                            aria-controls="@collapseId"
                            onclick="event.stopPropagation();"
                            title="زیرکارها">
                        <i class="bi bi-diagram-3"></i>
                    </button>
                }
                @if (!Model.IsCompleted)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            style="border-radius: 6px; padding: 0.25rem 0.5rem;"
                            onclick="event.stopPropagation(); deleteTask(@Model.Id)"
                            title="حذف کار">
                        <i class="bi bi-trash"></i>
                    </button>
                }
            </div>
        </div>
    </div>

    @if (hasSubs)
    {
<div id="@collapseId" class="collapse" style="border-top: 1px solid #e5e7eb;">
            <div class="task-card__children" style="padding: 1rem 1rem 0.5rem 3rem;">
                @foreach (var sub in Model.ChildIssues)
                {
                    @Html.Partial("_TaskBranch", sub)
                }
            </div>
        </div>
    }
</div>

