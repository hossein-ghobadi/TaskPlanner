@model Endpoint.Site.Models.TaskCreateVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var projectIssueTypes = ViewBag.ProjectIssueTypes as List<ProjectIssueType> ?? new List<ProjectIssueType>();
    
    // جدا کردن انواع پیش‌فرض (Epic, Task, Subtask) و انواع سفارشی (Story-level)
    var epicType = projectIssueTypes.FirstOrDefault(pit => pit.Level == IssueTypeLevel.Epic);
    var taskType = projectIssueTypes.FirstOrDefault(pit => pit.Level == IssueTypeLevel.StoryLevel && pit.BaseType == IssueType.Task);
    var subtaskType = projectIssueTypes.FirstOrDefault(pit => pit.Level == IssueTypeLevel.Subtask);
    var customStoryLevelTypes = projectIssueTypes.Where(pit => pit.Level == IssueTypeLevel.StoryLevel && pit.IsCustom).OrderBy(pit => pit.Order).ToList();
    
    var hasCustomTypes = customStoryLevelTypes.Any();
}

<h2>🎯 افزودن کار</h2>
<style>
    .issue-type-chip.active {
        background-color: #2563eb;
        color: #fff;
        border-color: #2563eb;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
    }
    .issue-type-chip,
    .issue-type-chip-clear {
        transition: all 0.2s ease;
    }
</style>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- نوع Issue -->
    <div class="mb-3">
        <label asp-for="IssueType" class="form-label">
            <strong>نوع کار</strong> 
            <span class="text-danger">*</span>
        </label>
        <select asp-for="IssueType" class="form-control" id="issueTypeSelect">
            @if (epicType != null)
            {
                <option value="@((int)IssueType.Epic)" data-project-issue-type-id="@epicType.Id" data-level="@((int)IssueTypeLevel.Epic)">@epicType.Icon @epicType.Name</option>
            }
            else
            {
                <option value="@((int)IssueType.Epic)" data-level="@((int)IssueTypeLevel.Epic)">📦 اپیک</option>
            }
            
            @if (taskType != null)
            {
                <option value="@((int)IssueType.Task)" data-project-issue-type-id="@taskType.Id" data-level="@((int)IssueTypeLevel.StoryLevel)">@taskType.Icon @taskType.Name</option>
            }
            else
            {
                <option value="@((int)IssueType.Task)" data-level="@((int)IssueTypeLevel.StoryLevel)">✅ تسک</option>
            }
            
            @foreach (var customType in customStoryLevelTypes)
            {
                var isSelected = Model?.ProjectIssueTypeId == customType.Id;
                <option value="@((int)customType.BaseType)" data-project-issue-type-id="@customType.Id" data-level="@((int)IssueTypeLevel.StoryLevel)" selected="@isSelected">@customType.Icon @customType.Name</option>
            }
        </select>
        <small class="form-text text-muted">
            <strong>راهنما:</strong> اپیک بزرگ‌ترین واحد است. تسک و انواع سفارشی برای کارهای اصلی استفاده می‌شوند. زیرتسک فقط از داخل خود تسک‌ها قابل ایجاد است.
        </small>
        <span asp-validation-for="IssueType" class="text-danger"></span>
    </div>
    
    @if (hasCustomTypes)
    {
        <div class="mb-3">
            <label class="form-label">
                <strong>انواع سفارشی پروژه (Story-level)</strong>
            </label>
            <input type="hidden" asp-for="ProjectIssueTypeId" id="projectIssueTypeId" />
            <div class="d-flex flex-wrap gap-2" id="projectIssueTypeChips">
                @foreach (var pit in customStoryLevelTypes)
                {
                    var active = Model?.ProjectIssueTypeId == pit.Id ? "active" : string.Empty;
                    <button type="button"
                            class="btn btn-outline-primary issue-type-chip @active"
                            data-id="@pit.Id"
                            data-base="@((int)pit.BaseType)"
                            data-level="@((int)IssueTypeLevel.StoryLevel)">
                        <span class="me-1">@pit.Icon</span>
                        @pit.Name
                    </button>
                }
                <button type="button"
                        class="btn btn-light issue-type-chip-clear @(Model?.ProjectIssueTypeId == null || (Model?.ProjectIssueTypeId == taskType?.Id) ? "active" : string.Empty)">
                    استفاده از تسک پیش‌فرض
                </button>
            </div>
            <small class="form-text text-muted">
                انواع سفارشی شما که هم‌سطح با تسک هستند و می‌توانند در اسپرینت قرار بگیرند، زیرتسک داشته باشند و بخشی از اپیک باشند.
            </small>
        </div>
    }
    else
    {
        <input type="hidden" asp-for="ProjectIssueTypeId" id="projectIssueTypeId" />
    }

    <div class="mb-3">
        <label asp-for="Title" class="form-label">
            <strong>عنوان</strong>
            <span class="text-danger">*</span>
        </label>
        <input asp-for="Title" class="form-control" placeholder="مثلاً: پیاده‌سازی سیستم لاگین" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">توضیحات</label>
        <textarea asp-for="Description" class="form-control" rows="4" 
                  placeholder="توضیحات کامل درباره این Issue..."></textarea>
    </div>

    <div class="mb-3">
        <label>تاریخ شروع</label>
        <input type="text" id="StartDateDisplay" class="form-control" autocomplete="off" />
        <input type="hidden" asp-for="StartDateSh" id="StartDate" />
        <span asp-validation-for="StartDateSh" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>تاریخ پایان</label>
        <input type="text" id="DueDateDisplay" class="form-control" autocomplete="off" />
        <input type="hidden" asp-for="DueDateSh" id="DueDate" />
        <span asp-validation-for="DueDateSh" class="text-danger"></span>
    </div>
    
    <!-- پروژه (فقط نمایشی - غیرقابل تغییر) -->
    <div class="mb-3">
        <label class="form-label">
            <strong>پروژه</strong>
            <span class="text-danger">*</span>
        </label>
        <input type="text" class="form-control" value="@ViewBag.ProjectName" readonly disabled style="background-color: #e9ecef; cursor: not-allowed;" />
        <input type="hidden" asp-for="ProjectId" id="projectSelect" />
        <small class="form-text text-muted">کار فقط در این پروژه ایجاد می‌شود</small>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">دسته‌بندی (Component) - اختیاری</label>
        <select asp-for="CategoryId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
            <option value="">-- بدون دسته‌بندی --</option>
        </select>
        <small class="form-text text-muted">مثل Component در Jira - می‌توانید خالی بگذارید</small>
    </div>
    <div class="mb-3">
        <label asp-for="AssignedUserId" class="form-label">مسئول تسک</label>
        <select asp-for="AssignedUserId" class="form-control" id="assignedUserSelect"
                asp-items="@(new SelectList(ViewBag.AssignedUsers, "Id", "Name", Model?.AssignedUserId))">
            <option value="">-- انتخاب کاربر --</option>
        </select>
        <span asp-validation-for="AssignedUserId" class="text-danger"></span>
    </div>
    <!-- Parent Issue (فقط برای Subtask الزامی است) -->
    <div class="mb-3" id="parentIssueDiv">
        <label asp-for="ParentId" class="form-label">
            <strong>والد کار</strong>
            <span id="parentRequired" class="text-danger" style="display:none">*</span>
        </label>
        <select asp-for="ParentId" class="form-control" id="parentIssueSelect">
            <option value="">-- بدون والد --</option>
            @if (ViewBag.Tasks != null)
            {
                @foreach (var task in ViewBag.Tasks)
                {
                    <option value="@task.Id" data-issue-type="@((int)task.IssueType)">@task.Title</option>
                }
            }
        </select>
        <small class="form-text text-muted" id="parentHelp">
            Story می‌تونه زیر Epic باشه، Subtask باید زیر Task/Story/Bug باشه
        </small>
        <span asp-validation-for="ParentId" class="text-danger"></span>
    </div>

    <!-- Story Points (فقط برای Story و Task) -->
    <div class="mb-3" id="storyPointsDiv" style="display:none">
        <label asp-for="StoryPoints" class="form-label">
            <strong>امتیاز کار</strong>
        </label>
        <input asp-for="StoryPoints" type="number" min="0" max="100" class="form-control" 
               placeholder="مثلاً: 5" />
        <small class="form-text text-muted">
            برای تخمین پیچیدگی و حجم کار (معمولاً اعداد Fibonacci: 1, 2, 3, 5, 8, 13...)
        </small>
        <span asp-validation-for="StoryPoints" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> ثبت Issue
        </button>
        <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i> انصراف
        </a>
    </div>
</form>
@section Scripts {
    <script>
        // تاریخ شروع
                // تاریخ شروع
        $("#StartDateDisplay").persianDatepicker({
            format: 'YYYY/MM/DD',
            autoClose: true,
            altField: '#StartDate',
            altFormat: 'YYYY/MM/DD',   // 👈 خروجی Hidden هم شمسی
            calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' }},
            timePicker: { enabled: false }
        });

        // تاریخ پایان
        $("#DueDateDisplay").persianDatepicker({
            format: 'YYYY/MM/DD',
            autoClose: true,
            altField: '#DueDate',
            altFormat: 'YYYY/MM/DD',
            calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' }},
            timePicker: { enabled: false }
        });
        // 🎯 مدیریت نمایش فیلدها بر اساس IssueType و Level
        const IssueTypes = {
            Epic: 1,
            Story: 2,
            Task: 3,
            Subtask: 4,
            Bug: 5
        };
        
        const IssueTypeLevels = {
            Epic: 1,
            StoryLevel: 2,
            Subtask: 3
        };

        const projectIssueTypeInput = document.getElementById('projectIssueTypeId');
        const issueTypeChips = document.querySelectorAll('.issue-type-chip');
        const clearIssueTypeChip = document.querySelector('.issue-type-chip-clear');

        function setActiveProjectIssueChip(targetButton) {
            issueTypeChips.forEach(btn => btn.classList.remove('active'));
            if (clearIssueTypeChip) {
                clearIssueTypeChip.classList.remove('active');
            }

            if (targetButton) {
                targetButton.classList.add('active');
            }
        }

        issueTypeChips.forEach(btn => {
            btn.addEventListener('click', function () {
                const baseType = this.dataset.base;
                const id = this.dataset.id;
                if (projectIssueTypeInput) {
                    projectIssueTypeInput.value = id;
                }

                const select = document.getElementById('issueTypeSelect');
                if (select) {
                    const optionToSelect = select.querySelector(`option[data-project-issue-type-id="${id}"]`);
                    if (optionToSelect) {
                        select.value = optionToSelect.value;
                    }
                    $('#issueTypeSelect').trigger('change');
                }

                setActiveProjectIssueChip(this);
            });
        });

        if (clearIssueTypeChip) {
            clearIssueTypeChip.addEventListener('click', function () {
                if (projectIssueTypeInput) {
                    projectIssueTypeInput.value = '';
                }
                // انتخاب تسک پیش‌فرض
                const select = document.getElementById('issueTypeSelect');
                if (select) {
                    const taskOption = select.querySelector('option[value="@((int)IssueType.Task)"][data-level="@((int)IssueTypeLevel.StoryLevel)"]');
                    if (taskOption && !taskOption.hasAttribute('data-project-issue-type-id')) {
                        select.value = taskOption.value;
                    } else {
                        const taskWithId = select.querySelector('option[value="@((int)IssueType.Task)"]');
                        if (taskWithId) {
                            select.value = taskWithId.value;
                            const taskId = taskWithId.getAttribute('data-project-issue-type-id');
                            if (taskId && projectIssueTypeInput) {
                                projectIssueTypeInput.value = taskId;
                            }
                        }
                    }
                    $('#issueTypeSelect').trigger('change');
                }
                setActiveProjectIssueChip(this);
            });
        }

        const preselectedProjectIssueTypeId = projectIssueTypeInput ? projectIssueTypeInput.value : '';
        if (preselectedProjectIssueTypeId) {
            const activeButton = document.querySelector(`.issue-type-chip[data-id="${preselectedProjectIssueTypeId}"]`);
            if (activeButton) {
                setActiveProjectIssueChip(activeButton);
            }
        } else if (clearIssueTypeChip) {
            setActiveProjectIssueChip(clearIssueTypeChip);
        }

        const selectElement = document.getElementById('issueTypeSelect');
        if (selectElement) {
            selectElement.addEventListener('change', function () {
                const selectedOption = this.options[this.selectedIndex];
                const projectIssueTypeId = selectedOption.getAttribute('data-project-issue-type-id');
                const level = parseInt(selectedOption.getAttribute('data-level') || '0');
                
                if (projectIssueTypeId && projectIssueTypeInput) {
                    projectIssueTypeInput.value = projectIssueTypeId;
                    const chip = document.querySelector(`.issue-type-chip[data-id="${projectIssueTypeId}"]`);
                    if (chip) {
                        setActiveProjectIssueChip(chip);
                    } else if (clearIssueTypeChip && level === IssueTypeLevels.StoryLevel) {
                        // اگر نوع Story-level است اما chip سفارشی نیست، clear را فعال کن
                        setActiveProjectIssueChip(clearIssueTypeChip);
                    }
                } else if (projectIssueTypeInput) {
                    projectIssueTypeInput.value = '';
                    if (clearIssueTypeChip && (level === IssueTypeLevels.StoryLevel || level === 0)) {
                        setActiveProjectIssueChip(clearIssueTypeChip);
                    } else {
                        setActiveProjectIssueChip(null);
                    }
                }
            });
        }

        function updateFieldsBasedOnIssueType() {
            const select = document.getElementById('issueTypeSelect');
            const selectedOption = select.options[select.selectedIndex];
            const selectedType = parseInt(select.value);
            const level = parseInt(selectedOption.getAttribute('data-level') || '0');
            const parentSelect = $('#parentIssueSelect');
            
            // Story Points: فقط برای Story-level types (Task و انواع سفارشی)
            if (level === IssueTypeLevels.StoryLevel) {
                $('#storyPointsDiv').show();
            } else {
                $('#storyPointsDiv').hide();
                $('#StoryPoints').val(''); // پاک کردن مقدار
            }

            // Parent Issue: 
            // - برای Subtask الزامی است (باید Story-level type باشد)
            // - برای Story-level types اختیاری (فقط می‌تونه زیر Epic باشه)
            // - برای Epic غیرفعال (نمی‌تونه parent داشته باشه)
            if (level === IssueTypeLevels.Subtask) {
                $('#parentIssueDiv').show();
                $('#parentRequired').show();
                $('#parentHelp').text('زیرتسک باید حتماً Parent داشته باشد (تسک یا انواع Story-level)');
                parentSelect.prop('required', true);
                
                // ذخیره مقدار فعلی
                const currentValue = parentSelect.val();
                
                // نمایش فقط Story-level types (Task و انواع سفارشی)
                parentSelect.find('option').each(function() {
                    const $option = $(this);
                    const issueType = parseInt($option.data('issue-type'));
                    if ($option.val() === '') {
                        // گزینه "بدون Parent" مخفی شود چون برای Subtask الزامی است
                        $option.hide();
                    } else if (issueType === IssueTypes.Task || 
                               issueType === IssueTypes.Story || 
                               issueType === IssueTypes.Bug) {
                        // فقط Story-level types نمایش داده شوند
                        $option.show();
                    } else {
                        // Epic و Subtask مخفی شوند
                        $option.hide();
                        // اگر مقدار فعلی یکی از اینها باشد، آن را پاک کن
                        if ($option.val() === currentValue) {
                            parentSelect.val('');
                        }
                    }
                });
            } 
            else if (level === IssueTypeLevels.StoryLevel) {
                $('#parentIssueDiv').show();
                $('#parentRequired').hide();
                $('#parentHelp').text('این نوع می‌تواند زیر اپیک قرار بگیرد (اختیاری) - فقط اپیک قابل انتخاب است');
                parentSelect.prop('required', false);
                
                // ذخیره مقدار فعلی (اگر Epic انتخاب شده باشد)
                const currentValue = parentSelect.val();
                
                // مخفی کردن همه گزینه‌ها به جز Epic
                parentSelect.find('option').each(function() {
                    const $option = $(this);
                    const issueType = parseInt($option.data('issue-type'));
                    if ($option.val() === '') {
                        // گزینه "بدون Parent" همیشه نمایش داده شود
                        $option.show();
                    } else if (issueType === IssueTypes.Epic) {
                        // فقط Epic نمایش داده شود
                        $option.show();
                    } else {
                        // سایر انواع مخفی شوند
                        $option.hide();
                        // اگر مقدار فعلی یکی از اینها باشد، آن را پاک کن
                        if ($option.val() === currentValue) {
                            parentSelect.val('');
                        }
                    }
                });
            }
            else {
                // Epic نمی‌تونه parent داشته باشه
                $('#parentIssueDiv').hide();
                parentSelect.val(''); // پاک کردن انتخاب
                parentSelect.prop('required', false);
            }
        }

        // اجرای اولیه
        updateFieldsBasedOnIssueType();

        // تغییر IssueType
        $('#issueTypeSelect').on('change', function() {
            updateFieldsBasedOnIssueType();
            const selectedOption = this.options[this.selectedIndex];
            const level = parseInt(selectedOption.getAttribute('data-level') || '0');
            if (level === IssueTypeLevels.Epic || level === IssueTypeLevels.Subtask) {
                if (projectIssueTypeInput) {
                    projectIssueTypeInput.value = '';
                }
                if (clearIssueTypeChip) {
                    setActiveProjectIssueChip(clearIssueTypeChip);
                } else {
                    setActiveProjectIssueChip(null);
                }
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            if (!form) return;

            let isSubmittingForm = false;
            const submitButton = form.querySelector('button[type="submit"]');
            const originalButtonContent = submitButton ? submitButton.innerHTML : '';

            form.addEventListener('submit', function (event) {
                if (isSubmittingForm) {
                    event.preventDefault();
                    return false;
                }

                isSubmittingForm = true;
                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>در حال ثبت...';
                }
            });

            // در صورت برگشت صفحه با خطای اعتبارسنجی، دکمه دوباره فعال شود
            window.addEventListener('pageshow', function (event) {
                if (event.persisted || (submitButton && submitButton.disabled)) {
                    isSubmittingForm = false;
                    if (submitButton) {
                        submitButton.disabled = false;
                        submitButton.innerHTML = originalButtonContent;
                    }
                }
            });
        });
    </script>
}
