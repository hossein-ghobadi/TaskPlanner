@model Endpoint.Site.Models.TaskCreateVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h2>🎯 افزودن کار</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- نوع Issue -->
    <div class="mb-3">
        <label asp-for="IssueType" class="form-label">
            <strong>نوع کار</strong> 
            <span class="text-danger">*</span>
        </label>
        <select asp-for="IssueType" class="form-control" id="issueTypeSelect">
            <option value="@((int)IssueType.Epic)">📦 Epic - اپیک (بالاترین سطح)</option>
            <option value="@((int)IssueType.Story)">📝 Story - استوری (User Story)</option>
            <option value="@((int)IssueType.Task)" selected>✅ Task - تسک (کار عادی)</option>
            <option value="@((int)IssueType.Bug)">🐛 Bug - باگ (مشکل یا خطا)</option>
        </select>
        <small class="form-text text-muted">
            <strong>راهنما:</strong> Epic بزرگترین واحد، Story برای User Story، Task برای کارهای عادی
        </small>
        <span asp-validation-for="IssueType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">
            <strong>عنوان</strong>
            <span class="text-danger">*</span>
        </label>
        <input asp-for="Title" class="form-control" placeholder="مثلاً: پیاده‌سازی سیستم لاگین" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">توضیحات</label>
        <textarea asp-for="Description" class="form-control" rows="4" 
                  placeholder="توضیحات کامل درباره این Issue..."></textarea>
    </div>

    <div class="mb-3">
        <label>تاریخ شروع</label>
        <input type="text" id="StartDateDisplay" class="form-control" autocomplete="off" />
        <input type="hidden" asp-for="StartDateSh" id="StartDate" />
        <span asp-validation-for="StartDateSh" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>تاریخ پایان</label>
        <input type="text" id="DueDateDisplay" class="form-control" autocomplete="off" />
        <input type="hidden" asp-for="DueDateSh" id="DueDate" />
        <span asp-validation-for="DueDateSh" class="text-danger"></span>
    </div>
    
    <!-- پروژه (فقط نمایشی - غیرقابل تغییر) -->
    <div class="mb-3">
        <label class="form-label">
            <strong>پروژه</strong>
            <span class="text-danger">*</span>
        </label>
        <input type="text" class="form-control" value="@ViewBag.ProjectName" readonly disabled style="background-color: #e9ecef; cursor: not-allowed;" />
        <input type="hidden" asp-for="ProjectId" id="projectSelect" />
        <small class="form-text text-muted">کار فقط در این پروژه ایجاد می‌شود</small>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">دسته‌بندی (Component) - اختیاری</label>
        <select asp-for="CategoryId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
            <option value="">-- بدون دسته‌بندی --</option>
        </select>
        <small class="form-text text-muted">مثل Component در Jira - می‌توانید خالی بگذارید</small>
    </div>
    <div class="mb-3">
        <label asp-for="AssignedUserId" class="form-label">مسئول تسک</label>
        <select asp-for="AssignedUserId" class="form-control" id="assignedUserSelect"
                asp-items="@(new SelectList(ViewBag.AssignedUsers, "Id", "Name", Model?.AssignedUserId))">
            <option value="">-- انتخاب کاربر --</option>
        </select>
        <span asp-validation-for="AssignedUserId" class="text-danger"></span>
    </div>
    <!-- Parent Issue (فقط برای Subtask الزامی است) -->
    <div class="mb-3" id="parentIssueDiv">
        <label asp-for="ParentId" class="form-label">
            <strong>والد کار</strong>
            <span id="parentRequired" class="text-danger" style="display:none">*</span>
        </label>
        <select asp-for="ParentId" class="form-control" id="parentIssueSelect">
            <option value="">-- بدون والد --</option>
            @if (ViewBag.Tasks != null)
            {
                @foreach (var task in ViewBag.Tasks)
                {
                    <option value="@task.Id" data-issue-type="@((int)task.IssueType)">@task.Title</option>
                }
            }
        </select>
        <small class="form-text text-muted" id="parentHelp">
            Story می‌تونه زیر Epic باشه، Subtask باید زیر Task/Story/Bug باشه
        </small>
        <span asp-validation-for="ParentId" class="text-danger"></span>
    </div>

    <!-- Story Points (فقط برای Story و Task) -->
    <div class="mb-3" id="storyPointsDiv" style="display:none">
        <label asp-for="StoryPoints" class="form-label">
            <strong>امتیاز کار</strong>
        </label>
        <input asp-for="StoryPoints" type="number" min="0" max="100" class="form-control" 
               placeholder="مثلاً: 5" />
        <small class="form-text text-muted">
            برای تخمین پیچیدگی و حجم کار (معمولاً اعداد Fibonacci: 1, 2, 3, 5, 8, 13...)
        </small>
        <span asp-validation-for="StoryPoints" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> ثبت Issue
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i> انصراف
        </a>
    </div>
</form>
@section Scripts {
    <script>
        // تاریخ شروع
                // تاریخ شروع
        $("#StartDateDisplay").persianDatepicker({
            format: 'YYYY/MM/DD',
            autoClose: true,
            altField: '#StartDate',
            altFormat: 'YYYY/MM/DD',   // 👈 خروجی Hidden هم شمسی
            calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' }},
            timePicker: { enabled: false }
        });

        // تاریخ پایان
        $("#DueDateDisplay").persianDatepicker({
            format: 'YYYY/MM/DD',
            autoClose: true,
            altField: '#DueDate',
            altFormat: 'YYYY/MM/DD',
            calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' }},
            timePicker: { enabled: false }
        });
        // 🎯 مدیریت نمایش فیلدها بر اساس IssueType
        const IssueTypes = {
            Epic: 1,
            Story: 2,
            Task: 3,
            Subtask: 4,
            Bug: 5
        };

        function updateFieldsBasedOnIssueType() {
            const selectedType = parseInt($('#issueTypeSelect').val());
            const parentSelect = $('#parentIssueSelect');
            
            // Story Points: فقط برای Story و Task نمایش داده شود
            if (selectedType === IssueTypes.Story || selectedType === IssueTypes.Task) {
                $('#storyPointsDiv').show();
            } else {
                $('#storyPointsDiv').hide();
                $('#StoryPoints').val(''); // پاک کردن مقدار
            }

            // Parent Issue: 
            // - برای Subtask الزامی است (باید Task, Story یا Bug باشد)
            // - برای Story اختیاری (فقط می‌تونه زیر Epic باشه)
            // - برای Task اختیاری (فقط می‌تونه زیر Epic باشه)
            // - برای Bug اختیاری (فقط می‌تونه زیر Epic باشه)
            // - برای Epic غیرفعال (نمی‌تونه parent داشته باشه)
            if (selectedType === IssueTypes.Subtask) {
                $('#parentIssueDiv').show();
                $('#parentRequired').show();
                $('#parentHelp').text('Subtask باید حتماً Parent داشته باشد (Task, Story یا Bug)');
                parentSelect.prop('required', true);
                
                // ذخیره مقدار فعلی
                const currentValue = parentSelect.val();
                
                // نمایش فقط Task, Story, Bug
                parentSelect.find('option').each(function() {
                    const $option = $(this);
                    const issueType = parseInt($option.data('issue-type'));
                    if ($option.val() === '') {
                        // گزینه "بدون Parent" مخفی شود چون برای Subtask الزامی است
                        $option.hide();
                    } else if (issueType === IssueTypes.Task || 
                               issueType === IssueTypes.Story || 
                               issueType === IssueTypes.Bug) {
                        // فقط Task, Story, Bug نمایش داده شوند
                        $option.show();
                    } else {
                        // Epic و Subtask مخفی شوند
                        $option.hide();
                        // اگر مقدار فعلی یکی از اینها باشد، آن را پاک کن
                        if ($option.val() === currentValue) {
                            parentSelect.val('');
                        }
                    }
                });
            } 
            else if (selectedType === IssueTypes.Story || 
                     selectedType === IssueTypes.Task || 
                     selectedType === IssueTypes.Bug) {
                $('#parentIssueDiv').show();
                $('#parentRequired').hide();
                const issueTypeName = selectedType === IssueTypes.Story ? 'Story' : 
                                     selectedType === IssueTypes.Task ? 'Task' : 'Bug';
                $('#parentHelp').text(`${issueTypeName} می‌تواند زیر Epic قرار بگیرد (اختیاری) - فقط Epic قابل انتخاب است`);
                parentSelect.prop('required', false);
                
                // ذخیره مقدار فعلی (اگر Epic انتخاب شده باشد)
                const currentValue = parentSelect.val();
                
                // مخفی کردن همه گزینه‌ها به جز Epic
                parentSelect.find('option').each(function() {
                    const $option = $(this);
                    const issueType = parseInt($option.data('issue-type'));
                    if ($option.val() === '') {
                        // گزینه "بدون Parent" همیشه نمایش داده شود
                        $option.show();
                    } else if (issueType === IssueTypes.Epic) {
                        // فقط Epic نمایش داده شود
                        $option.show();
                    } else {
                        // سایر انواع (Task, Story, Bug, Subtask) مخفی شوند
                        $option.hide();
                        // اگر مقدار فعلی یکی از اینها باشد، آن را پاک کن
                        if ($option.val() === currentValue) {
                            parentSelect.val('');
                        }
                    }
                });
            }
            else {
                // Epic نمی‌تونه parent داشته باشه
                $('#parentIssueDiv').hide();
                parentSelect.val(''); // پاک کردن انتخاب
                parentSelect.prop('required', false);
            }
        }

        // اجرای اولیه
        updateFieldsBasedOnIssueType();

        // تغییر IssueType
        $('#issueTypeSelect').on('change', function() {
            updateFieldsBasedOnIssueType();
        });
    </script>
}
