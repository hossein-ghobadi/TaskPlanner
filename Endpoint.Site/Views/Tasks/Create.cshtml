@model Endpoint.Site.Models.TaskCreateVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    var isModal = (Context.Request.Query.ContainsKey("fromModal") && Context.Request.Query["fromModal"] == "true")
                  || (Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("fromModal") && Context.Request.Form["fromModal"] == "true");
    Layout = isModal ? null : "/Views/Shared/_Layout.cshtml";
    var projectIssueTypes = ViewBag.ProjectIssueTypes as List<ProjectIssueType> ?? new List<ProjectIssueType>();
    
    // دریافت همه انواع به جز Subtask (کارک) - مرتب بر اساس Order
    var availableIssueTypes = projectIssueTypes
        .Where(pit => pit.Level != IssueTypeLevel.Subtask)
        .OrderBy(pit => pit.Order)
        .ThenBy(pit => pit.Level)
        .ToList();
    var defaultTaskIssueType = availableIssueTypes.FirstOrDefault(pit => pit.BaseType == IssueType.Task)
        ?? availableIssueTypes.FirstOrDefault();
    var resolvedProjectIssueTypeId = Model?.ProjectIssueTypeId ?? defaultTaskIssueType?.Id;
}

@if (isModal)
{
    <link rel="stylesheet" href="~/lib/vazir-font/dist/font-face.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/persian-datepicker/dist/css/persian-datepicker.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/persian-date/dist/persian-date.min.js"></script>
    <script src="~/lib/persian-datepicker/dist/js/persian-datepicker.min.js"></script>
}

<style>
    .modal-mode-root {
        direction: rtl;
        font-family: var(--primary-font-family, 'Vazir', 'Tahoma', 'Arial', sans-serif);
    }
    .task-form-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 0;
    }
    .task-form-container.modal-mode {
        max-width: 100%;
        margin: 0;
        padding: 0;
    }
    .task-form-container.modal-mode .form-header {
        display: none;
    }
    .task-create-modal-shell {
        min-height: auto;
        background: transparent;
        padding: 0;
    }
    
    .form-header {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        color: white;
        box-shadow: 0 10px 40px rgba(59, 130, 246, 0.3);
    }
    
    .form-header h2 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    
    .form-header .icon {
        font-size: 2.5rem;
    }
    
    .form-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #f0f0f0;
        transition: all 0.3s ease;
    }
    
    .form-card:hover {
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
        transform: translateY(-2px);
    }
    
    .form-card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #f3f4f6;
    }
    
    .form-card-title i {
        color: #2563eb;
        font-size: 1.3rem;
    }
    
    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .form-label i {
        color: #2563eb;
        font-size: 1rem;
    }
    
    .form-control, .form-select {
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        outline: none;
    }
    
    .form-control:disabled {
        background-color: #f9fafb;
        cursor: not-allowed;
        opacity: 0.7;
    }
    
    .help-text {
        background: #eff6ff;
        border-right: 4px solid #2563eb;
        padding: 1rem;
        border-radius: 8px;
        margin-top: 0.75rem;
        font-size: 0.9rem;
        color: #1e40af;
    }
    
    .btn-modern {
        border-radius: 12px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
    }
    
    .btn-modern-primary {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
    }
    
    .btn-modern-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
        color: white;
    }
    
    .btn-modern-secondary {
        background: #f3f4f6;
        color: #374151;
    }
    
    .btn-modern-secondary:hover {
        background: #e5e7eb;
        transform: translateY(-2px);
        color: #374151;
    }
    
    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 2px solid #f3f4f6;
    }
    
    .field-group {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }
    
    @@media (max-width: 768px) {
        .form-header {
            padding: 1.5rem;
        }
        
        .form-header h2 {
            font-size: 1.5rem;
        }
        
        .form-card {
            padding: 1.5rem;
        }
        
        .field-group {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="modal-mode-root @(isModal ? "task-create-modal-shell" : "")">
<div class="task-form-container @(isModal ? "modal-mode" : "")">
    <div class="form-header">
        <h2>
            <span class="icon">🎯</span>
            افزودن کار جدید
        </h2>
    </div>

    <form asp-action="Create" method="post">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }

        @if (isModal)
        {
            <input type="hidden" name="fromModal" value="true" />
        }
        <input type="hidden" asp-for="ProjectIssueTypeId" id="projectIssueTypeId" value="@resolvedProjectIssueTypeId" />
        <input type="hidden" asp-for="ProjectId" id="projectSelect" />
        <input type="hidden" asp-for="IssueType" value="@((int)IssueType.Task)" />

        <!-- اطلاعات اصلی -->
        <div class="form-card">
            <div class="form-card-title">
                <i class="bi bi-info-circle"></i>
                اطلاعات اصلی
            </div>
            
            @*<div class="mb-4">
                <label class="form-label">
                    <i class="bi bi-tag"></i>
                    نوع کار
                </label>
                <input type="text" class="form-control" value="Task" readonly />
                <small class="text-muted">نوع این آیتم همیشه «تسک» است.</small>
            </div>
            *@
            <div class="mb-4">
                <label asp-for="Title" class="form-label">
                    <i class="bi bi-card-heading"></i>
                    عنوان کار
                    <span class="text-danger">*</span>
                </label>
                <input asp-for="Title" class="form-control" placeholder="مثلاً: پیاده‌سازی سیستم لاگین" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-0">
                <label asp-for="Description" class="form-label">
                    <i class="bi bi-file-text"></i>
                    توضیحات
                </label>
                <textarea asp-for="Description" class="form-control" rows="4" 
                          placeholder="توضیحات کامل درباره این کار..."></textarea>
            </div>
        </div>

        <!-- جزئیات تکمیلی -->
        <div class="form-card">
            <div class="form-card-title">
                <i class="bi bi-calendar3"></i>
                جزئیات تکمیلی
            </div>
            
            <div class="field-group">
                <div>
                    <label class="form-label">
                        <i class="bi bi-calendar-event"></i>
                        تاریخ شروع <span class="text-muted small">(اختیاری)</span>
                    </label>
                    <input type="text" id="StartDateDisplay" class="form-control" autocomplete="off" placeholder="انتخاب تاریخ" />
                    <input type="hidden" asp-for="StartDateSh" id="StartDate" />
                    <span asp-validation-for="StartDateSh" class="text-danger small"></span>
                </div>

                <div>
                    <label class="form-label">
                        <i class="bi bi-hourglass-split"></i>
                        مدت انجام (روز)
                    </label>
                    <input type="number" asp-for="DurationDays" class="form-control" min="0" max="3650" placeholder="مثلاً ۳" />
                    <small class="text-muted">با تاریخ شروع، مهلت انجام خودکار محاسبه می‌شود.</small>
                    <span asp-validation-for="DurationDays" class="text-danger small"></span>
                </div>
            </div>

            <div class="field-group mt-4">
                <div>
                    <label class="form-label">
                        <i class="bi bi-folder"></i>
                        پروژه
                        <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" value="@ViewBag.ProjectName" readonly disabled />
                    <span asp-validation-for="ProjectId" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="CategoryId" class="form-label">
                        <i class="bi bi-collection"></i>
                        دسته‌بندی (اختیاری)
                    </label>
                    <select asp-for="CategoryId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                        <option value="">-- بدون دسته‌بندی --</option>
                    </select>
                </div>
            </div>

            <div class="field-group mt-4">
                <div>
                    <label asp-for="AssignedUserId" class="form-label">
                        <i class="bi bi-person"></i>
                        مسئول کار
                    </label>
                    <select asp-for="AssignedUserId" class="form-select" id="assignedUserSelect"
                            asp-items="@(new SelectList(ViewBag.AssignedUsers, "Id", "Name", Model?.AssignedUserId))">
                        <option value="">-- انتخاب کاربر --</option>
                    </select>
                    <span asp-validation-for="AssignedUserId" class="text-danger small"></span>
                </div>

                <div id="effortLevelDiv">
                    <label asp-for="EffortLevel" class="form-label">
                        <i class="bi bi-star"></i>
                        سطح کار
                    </label>
                    <select asp-for="EffortLevel" class="form-select">
                        <option value="">-- انتخاب سطح --</option>
                        <option value="@((int)TaskEffortLevel.Simple)">ساده</option>
                        <option value="@((int)TaskEffortLevel.Medium)">متوسط</option>
                        <option value="@((int)TaskEffortLevel.Hard)">پرزحمت</option>
                    </select>
                    <small class="text-muted small">این مقدار برای سازگاری با داده‌های قبلی به امتیاز داخلی تبدیل می‌شود.</small>
                    <span asp-validation-for="EffortLevel" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- دکمه‌های عملیات -->
        <div class="form-actions">
            <button type="submit" class="btn btn-modern btn-modern-primary">
                <i class="bi bi-check-circle"></i>
                ثبت کار
            </button>
            @if (isModal)
            {
                <button type="button" class="btn btn-modern btn-modern-secondary" onclick="closeCreateTaskModal()">
                    <i class="bi bi-x-circle"></i>
                    انصراف
                </button>
            }
            else
            {
                <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-modern btn-modern-secondary">
                    <i class="bi bi-x-circle"></i>
                    انصراف
                </a>
            }
        </div>
    </form>
</div>
</div>

@if (isModal)
{
    <script>
        (function () {
            $("#StartDateDisplay").persianDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true,
                initialValue: false,
                initialValueType: 'persian',
                altField: '#StartDate',
                altFormat: 'YYYY/MM/DD',
                calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' } },
                timePicker: { enabled: false },
                onSelect: function () {
                    if (!$("#StartDateDisplay").val()) {
                        $("#StartDate").val('');
                    }
                }
            });
            $("#StartDate").val('');

            let isSubmittingForm = false;
            const form = document.querySelector('form');
            const submitButton = form?.querySelector('button[type="submit"]');
            const originalButtonContent = submitButton ? submitButton.innerHTML : '';

            form?.addEventListener('submit', function (event) {
                if (!$("#StartDateDisplay").val()?.trim()) {
                    $("#StartDate").val('');
                }
                if (isSubmittingForm) {
                    event.preventDefault();
                    return false;
                }
                isSubmittingForm = true;
                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>در حال ثبت...';
                }
            });

            window.addEventListener('pageshow', function (event) {
                if (event.persisted || (submitButton && submitButton.disabled)) {
                    isSubmittingForm = false;
                    if (submitButton) {
                        submitButton.disabled = false;
                        submitButton.innerHTML = originalButtonContent;
                    }
                }
            });
        })();

        function closeCreateTaskModal() {
            if (window.self !== window.top) {
                window.parent.postMessage('taskCreateCancel', '*');
            } else {
                window.history.back();
            }
        }

        @if (Context.Request.Query.ContainsKey("saved") && Context.Request.Query["saved"] == "true")
        {
            <text>
            (function notifyCreateSuccess() {
                const createdTaskId = '@(Context.Request.Query.ContainsKey("taskId") ? Context.Request.Query["taskId"].ToString() : "")';
                if (window.self !== window.top) {
                    window.parent.postMessage({ type: 'taskCreateSuccess', taskId: createdTaskId }, '*');
                }
            })();
            </text>
        }
    </script>
}

@if (!isModal)
{
@section Scripts {
    @await Html.PartialAsync("_DatePickerAssets")
    <script>
        // تاریخ شروع
                // تاریخ شروع
        $("#StartDateDisplay").persianDatepicker({
            format: 'YYYY/MM/DD',
            autoClose: true,
            initialValue: false,
            initialValueType: 'persian',
            altField: '#StartDate',
            altFormat: 'YYYY/MM/DD',
            calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' }},
            timePicker: { enabled: false },
            onSelect: function () {
                if (!$("#StartDateDisplay").val()) {
                    $("#StartDate").val('');
                }
            }
        });
        $("#StartDate").val('');

        // تاریخ پایان حذف شد — مهلت از تاریخ شروع + مدت محاسبه می‌شود.
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            if (!form) return;

            let isSubmittingForm = false;
            const submitButton = form.querySelector('button[type="submit"]');
            const originalButtonContent = submitButton ? submitButton.innerHTML : '';

            form.addEventListener('submit', function (event) {
                if (!$("#StartDateDisplay").val()?.trim()) {
                    $("#StartDate").val('');
                }
                if (isSubmittingForm) {
                    event.preventDefault();
                    return false;
                }

                isSubmittingForm = true;
                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>در حال ثبت...';
                }
            });

            // در صورت برگشت صفحه با خطای اعتبارسنجی، دکمه دوباره فعال شود
            window.addEventListener('pageshow', function (event) {
                if (event.persisted || (submitButton && submitButton.disabled)) {
                    isSubmittingForm = false;
                    if (submitButton) {
                        submitButton.disabled = false;
                        submitButton.innerHTML = originalButtonContent;
                    }
                }
            });
        });

        function closeCreateTaskModal() {
            if (window.self !== window.top) {
                window.parent.postMessage('taskCreateCancel', '*');
            } else {
                window.history.back();
            }
        }

        @if (isModal && Context.Request.Query.ContainsKey("saved") && Context.Request.Query["saved"] == "true")
        {
            <text>
            (function notifyCreateSuccess() {
                const createdTaskId = '@(Context.Request.Query.ContainsKey("taskId") ? Context.Request.Query["taskId"].ToString() : "")';
                if (window.self !== window.top) {
                    window.parent.postMessage({ type: 'taskCreateSuccess', taskId: createdTaskId }, '*');
                }
            })();
            </text>
        }
    </script>
}
}
