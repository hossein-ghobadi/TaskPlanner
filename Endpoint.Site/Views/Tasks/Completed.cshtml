@using DNTPersianUtils.Core
@model IEnumerable<TaskPlanner.Domain.Entities.TaskPlanner.TaskItem>

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var projectId = Context.Request.Query["projectId"].ToString();
    var projectIdInt = !string.IsNullOrEmpty(projectId) ? int.Parse(projectId) : (int?)null;
}

<h2 class="mb-4">✅ کارهای خاتمه یافته</h2>

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary"
           asp-controller="Tasks"
           asp-action="Index"
           asp-route-projectId="@projectIdInt">
            <i class="bi bi-arrow-left"></i> بازگشت به کارهای فعال
        </a>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-info text-white" asp-controller="Tasks" asp-action="Weekly">
            <i class="bi bi-calendar-week"></i> برنامه هفتگی
        </a>
        <a class="btn btn-primary" asp-controller="Projects" asp-action="Index">
            <i class="bi bi-grid-3x3-gap"></i> پروژه‌ها
        </a>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">هنوز هیچ کاری خاتمه نیافته است.</div>
}
else
{
    var completedRootTasks = Model
        .Where(t => t.ParentTaskId == null && t.IsCompleted)
        .OrderByDescending(t => t.UpdatedAt)
        .ToList();

    if (completedRootTasks.Any())
    {
        <div id="completedTaskTree">
            @foreach (var parent in completedRootTasks)
            {
                @Html.Partial("_TaskBranch", parent)
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">تسک خاتمه یافته‌ای برای نمایش وجود ندارد.</div>
    }
}

