                                        <i class="bi bi-list-check"></i>
                                        چک لیست
                                    </div>
                                    <span class="checklist-progress-badge" id="inlineSubtaskProgressBadge">0/0</span>
                                </div>
                                <div class="subtask-input-row">
                                    <input type="text" id="inlineSubtaskTitle" class="form-control" placeholder="عنوان کارک..." />
                                    <button type="button" id="addInlineSubtaskBtn" class="btn btn-modern btn-modern-warning">افزودن</button>
                                </div>
                                <ul id="inlineSubtasksList" class="subtask-list"></ul>
                                <div id="inlineSubtaskNote" class="chat-note"></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- اطلاعات اصلی -->
            <div class="form-card">
                <div class="form-card-title">
                    <i class="bi bi-info-circle"></i>
                    اطلاعات اصلی
                </div>
                <div class="mb-4">
                    <label asp-for="IssueType" class="form-label">
                        <i class="bi bi-tag"></i>
                        نوع کار
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="IssueType" class="form-select" id="issueTypeSelect" disabled>
                        @foreach (var issueType in availableIssueTypes)
                        {
                            var isSelected = Model.ProjectIssueTypeId == issueType.Id ||
                                             (Model.ProjectIssueTypeId == null && Model.IssueType == issueType.BaseType);
                            <option value="@((int)issueType.BaseType)"
                                    data-project-issue-type-id="@issueType.Id"
                                    data-level="@((int)issueType.Level)"
                                    selected="@isSelected">
                                @issueType.Icon @issueType.Name
                            </option>
