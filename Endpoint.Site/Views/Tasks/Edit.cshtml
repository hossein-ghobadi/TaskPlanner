                    </select>
                    <small class="text-muted small">نوع کار قابل تغییر نیست</small>
                    <span asp-validation-for="IssueType" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Title" class="form-label">
                        <i class="bi bi-card-heading"></i>
                        عنوان کار
                    </label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="mb-0">
                    <label asp-for="Description" class="form-label">
                        <i class="bi bi-file-text"></i>
                        توضیحات
                    </label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>
            </div>

            <!-- جزئیات تکمیلی -->
            <div class="form-card">
                <div class="form-card-title">
                    <i class="bi bi-calendar3"></i>
                    جزئیات تکمیلی
                </div>
                <div class="field-group">
                    <div>
                        <label class="form-label">
                            <i class="bi bi-calendar-event"></i>
                            تاریخ شروع
                        </label>
                        <input type="text" id="StartDateDisplay" class="form-control" autocomplete="off" value="@Model.StartDateSh" />
                        <input type="hidden" asp-for="StartDateSh" id="StartDate" value="@Model.StartDateSh" />
                        <span asp-validation-for="StartDateSh" class="text-danger small"></span>
                    </div>
                    <div>
                        <label class="form-label">
                            <i class="bi bi-calendar-check"></i>
                            تاریخ پایان
                        </label>
                        <input type="text" id="DueDateDisplay" class="form-control" autocomplete="off" value="@Model.DueDateSh" />
                        <input type="hidden" asp-for="DueDateSh" id="DueDate" value="@Model.DueDateSh" />
                        <span asp-validation-for="DueDateSh" class="text-danger small"></span>
                    </div>
                </div>
                <div class="field-group mt-4">
                    <div>
                        <label class="form-label">
                            <i class="bi bi-folder"></i>
                            پروژه
                        </label>
                        <select asp-for="ProjectId" class="form-select" disabled asp-items="@(new SelectList(ViewBag.Projects, "Id", "Name", Model.ProjectId))"></select>
                        <small class="text-muted small">پروژه قابل تغییر نیست</small>
                        <span asp-validation-for="ProjectId" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="CategoryId" class="form-label">
                            <i class="bi bi-collection"></i>
                            دسته‌بندی (اختیاری)
                        </label>
                        <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                            <option value="">-- بدون دسته‌بندی --</option>
                        </select>
                    </div>
                </div>
                <div class="field-group mt-4">
                    <div>
                        <label asp-for="AssignedUserId" class="form-label">
                            <i class="bi bi-person"></i>
                            مسئول کار
                        </label>
                        <select asp-for="AssignedUserId" class="form-select" asp-items="@(new SelectList(ViewBag.AssignedUsers, "Id", "Name", Model.AssignedUserId))">
                            <option value="">-- انتخاب کاربر --</option>
                        </select>
                        <span asp-validation-for="AssignedUserId" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="EffortLevel" class="form-label">
                            <i class="bi bi-star"></i>
                            سطح کار
                        </label>
                        <select asp-for="EffortLevel" class="form-select">
                            <option value="">-- انتخاب سطح --</option>
                            <option value="@((int)TaskEffortLevel.Simple)">ساده</option>
                            <option value="@((int)TaskEffortLevel.Medium)">متوسط</option>
                            <option value="@((int)TaskEffortLevel.Hard)">پرزحمت</option>
                        </select>
                        <span asp-validation-for="EffortLevel" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            @if (Model.IssueType == IssueType.Task)
            {
            <div class="checklist-page-bottom-row">
                <div class="form-card checklist-card checklist-panel-corner checklist-panel-corner--page" id="inlineSubtaskPanel">
                    <div class="checklist-header">
                        <div class="checklist-title">
                            <i class="bi bi-list-check"></i>
                            چک لیست
                        </div>
                        <span class="checklist-progress-badge" id="inlineSubtaskProgressBadge">0/0</span>
                    </div>
                    <div class="subtask-input-row">
                        <input type="text" id="inlineSubtaskTitle" class="form-control" placeholder="عنوان کارک..." />
                        <button type="button" id="addInlineSubtaskBtn" class="btn btn-modern btn-modern-warning">افزودن</button>
                    </div>
                    <ul id="inlineSubtasksList" class="subtask-list"></ul>
                    <div id="inlineSubtaskNote" class="chat-note"></div>
                </div>
            </div>
            }
        }

        <!-- دکمه‌های عملیات -->
        <div class="form-actions">
            <button type="submit" class="btn btn-modern btn-modern-warning">
                <i class="bi bi-check-circle"></i>
                ذخیره تغییرات
        </button>
            @if (isModal)
            {
                <button type="button" class="btn btn-modern btn-modern-secondary" onclick="closeEditTaskModal()">
                    <i class="bi bi-x-circle"></i>
                    انصراف
                </button>
            }
            else
            {
                <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-modern btn-modern-secondary">
                    <i class="bi bi-x-circle"></i>
                    انصراف
                </a>
            }
    </div>
</form>
</div>
</div>

<script>
    const editTaskIdForChat = @Model.Id;

    function escapeHtml(text) {
        if (text == null) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function normalizeAttachmentUrl(rawUrl) {
        const value = (rawUrl || '').trim();
        if (!value) return '#';
        if (value.startsWith('http://') || value.startsWith('https://') || value.startsWith('blob:') || value.startsWith('data:')) {
            return value;
        }
        return value.startsWith('/') ? value : `/${value}`;
    }

    function isImageAttachment(att) {
        const fileType = String(att?.fileType || att?.mimeType || '').toLowerCase();
        const fileName = String(att?.fileName || '').toLowerCase();
        return fileType.includes('image') || /\.(png|jpe?g|gif|webp|bmp|svg)$/i.test(fileName);
    }

    function isAudioAttachment(att) {
        const fileType = String(att?.fileType || att?.mimeType || '').toLowerCase();
        const fileName = String(att?.fileName || '').toLowerCase();
        return fileType.includes('audio') || /\.(mp3|wav|ogg|m4a|webm|aac)$/i.test(fileName);
    }

    function formatPersianDateTime(value) {
        if (!value) return '';
        const parsed = new Date(value);
        if (Number.isNaN(parsed.getTime())) {
            return escapeHtml(String(value));
        }
        return new Intl.DateTimeFormat('fa-IR', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit'
        }).format(parsed);
    }

    function renderTaskChat(comments) {
        const boxEl = document.getElementById('taskChatBox');
        if (!boxEl) return;

        const items = Array.isArray(comments) ? comments : [];
        if (items.length === 0) {
            boxEl.innerHTML = '<div class="chat-empty">هنوز پیامی یا پیوستی ثبت نشده است.</div>';
            return;
        }

        boxEl.innerHTML = items.map(comment => {
            const userName = escapeHtml(comment.userName || 'کاربر');
            const createdAt = formatPersianDateTime(comment.createdAt);
            const messageText = escapeHtml(comment.message || '');
            const commentId = Number(comment.id || 0);
            const canDelete = Boolean(comment.isCurrentUser);
            const sideClass = canDelete ? 'own' : 'other';
            const userBadge = canDelete ? '<span class="chat-user-badge">شما</span>' : '';
            const attachments = Array.isArray(comment.attachments) ? comment.attachments : [];
            const attachmentsHtml = attachments.map(att => {
                const fileName = escapeHtml(att.fileName || 'فایل');
                const fileUrl = normalizeAttachmentUrl(att.filePath || att.url || '');
                if (isImageAttachment(att)) {
                    return `
                        <div class="chat-attachment-item">
                            <i class="bi bi-image"></i>
                            <a href="${fileUrl}" target="_blank" rel="noopener noreferrer">${fileName}</a>
                        </div>
                        <div class="chat-attachment-item">
                            <img src="${fileUrl}" alt="${fileName}" class="chat-attachment-image" onerror="this.style.display='none';" />
                        </div>
                    `;
                }
                if (isAudioAttachment(att)) {
                    return `
                        <div class="chat-attachment-item">
                            <i class="bi bi-mic"></i>
                            <a href="${fileUrl}" target="_blank" rel="noopener noreferrer">${fileName}</a>
                        </div>
                        <div class="chat-attachment-item">
                            <audio controls src="${fileUrl}" class="chat-attachment-audio"></audio>
                        </div>
                    `;
                }
                return `<div class="chat-attachment-item"><i class="bi bi-paperclip"></i><a href="${fileUrl}" target="_blank" rel="noopener noreferrer">${fileName}</a></div>`;
            }).join('');

            return `
                <div class="chat-message ${sideClass}">
                    <div class="chat-message-card">
                        <div class="chat-meta">
                            <span>${userName}${userBadge}</span>
                            <span class="chat-meta-right">
                                <span>${createdAt}</span>
                                ${canDelete && commentId ? `<button type="button" class="chat-delete-btn" onclick="deleteTaskComment(${commentId})">حذف</button>` : ''}
                            </span>
                        </div>
                        ${messageText ? `<div class="chat-text">${messageText}</div>` : ''}
                        ${attachmentsHtml ? `<div class="chat-attachments">${attachmentsHtml}</div>` : ''}
                    </div>
                </div>
            `;
        }).join('');

        boxEl.scrollTop = boxEl.scrollHeight;
    }

    async function loadTaskChat(taskId) {
        const boxEl = document.getElementById('taskChatBox');
        if (!boxEl) return;

        try {
            const response = await fetch(`/Tasks/GetComments?taskId=${taskId}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!response.ok) {
                throw new Error('load_failed');
            }
            const comments = await response.json();
            renderTaskChat(comments);
        } catch (error) {
            const message = error && error.message ? escapeHtml(error.message) : 'خطا در دریافت گفتگو.';
            boxEl.innerHTML = `<div class="chat-empty">${message}</div>`;
        }
    }

    async function sendTaskChat(taskId) {
        const messageInput = document.getElementById('chatMessageInput');
        const fileInput = document.getElementById('chatFileInput');
        const sendBtn = document.getElementById('sendChatBtn');
        const noteEl = document.getElementById('chatComposerNote');
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        if (!messageInput || !fileInput || !sendBtn || !noteEl || !tokenInput) return;

        const message = (messageInput.value || '').trim();
        const files = fileInput.files ? Array.from(fileInput.files) : [];
        if (!message && files.length === 0) {
            noteEl.textContent = 'حداقل یک پیام یا پیوست وارد کنید.';
            return;
        }

        const formData = new FormData();
        formData.append('TaskId', String(taskId));
        formData.append('Message', message);
        formData.append('__RequestVerificationToken', tokenInput.value);
        files.forEach(file => formData.append('Attachments', file));

        try {
            sendBtn.disabled = true;
            noteEl.textContent = 'در حال ارسال...';

            const response = await fetch('/Tasks/PostComment', {
                method: 'POST',
                headers: {
                    RequestVerificationToken: tokenInput.value
                },
                body: formData
            });
            if (!response.ok) {
                const rawError = await response.text();
                throw new Error(rawError || `HTTP ${response.status}`);
            }

            messageInput.value = '';
            fileInput.value = '';
            document.getElementById('selectedFiles').innerHTML = '';
            document.getElementById('audioPreview').innerHTML = '';
            noteEl.textContent = '';
            await loadTaskChat(taskId);
        } catch (error) {
            noteEl.textContent = error && error.message
                ? `ارسال انجام نشد: ${error.message}`
                : 'ارسال انجام نشد. دوباره تلاش کنید.';
        } finally {
            sendBtn.disabled = false;
        }
    }

    async function deleteTaskComment(commentId) {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const noteEl = document.getElementById('chatComposerNote');
        if (!tokenInput || !commentId) return;
        if (!confirm('این پیام/پیوست حذف شود؟')) return;

        const formData = new FormData();
        formData.append('commentId', String(commentId));
        formData.append('__RequestVerificationToken', tokenInput.value);

        try {
            if (noteEl) noteEl.textContent = 'در حال حذف...';
            const response = await fetch('/Tasks/DeleteComment', {
                method: 'POST',
                body: formData
            });
            if (!response.ok) {
                const rawError = await response.text();
                throw new Error(rawError || `HTTP ${response.status}`);
            }
            await loadTaskChat(editTaskIdForChat);
            if (noteEl) noteEl.textContent = '';
        } catch (error) {
            if (noteEl) {
                noteEl.textContent = error && error.message
                    ? `حذف انجام نشد: ${error.message}`
                    : 'حذف انجام نشد.';
            }
        }
    }

    let mediaRecorder = null;
    let audioChunks = [];
    let recordingStream = null;
    let timerInterval = null;
    let recordingStartTime = null;

    function showSelectedFiles() {
        const fileInput = document.getElementById('chatFileInput');
        const selectedFiles = document.getElementById('selectedFiles');
        if (!fileInput || !selectedFiles) return;

        const files = Array.from(fileInput.files || []);
        if (files.length === 0) {
            selectedFiles.innerHTML = '';
            syncAudioPreviewWithSelectedFiles();
            return;
        }

        selectedFiles.innerHTML = files.map(f => `
            <div class="file-item">
                <span>${escapeHtml(f.name)}</span>
                <button type="button" onclick="removeSelectedFile('${encodeURIComponent(f.name)}')">حذف</button>
            </div>
        `).join('');

        syncAudioPreviewWithSelectedFiles();
    }

    function removeSelectedFile(encodedName) {
        const fileName = decodeURIComponent(encodedName);
        const input = document.getElementById('chatFileInput');
        if (!input) return;
        const dt = new DataTransfer();
        Array.from(input.files || []).forEach(f => {
            if (f.name !== fileName) dt.items.add(f);
        });
        input.files = dt.files;
        showSelectedFiles();
    }

    function syncAudioPreviewWithSelectedFiles() {
        const input = document.getElementById('chatFileInput');
        const preview = document.getElementById('audioPreview');
        if (!input || !preview) return;

        const hasAudioFile = Array.from(input.files || []).some(f => (f.type || '').startsWith('audio/'));
        if (!hasAudioFile) {
            preview.innerHTML = '';
        }
    }

    function addFileToInput(file) {
        const input = document.getElementById('chatFileInput');
        if (!input) return;
        const dt = new DataTransfer();
        Array.from(input.files || []).forEach(f => dt.items.add(f));
        dt.items.add(file);
        input.files = dt.files;
        showSelectedFiles();
    }

    async function toggleRecording() {
        const recordBtn = document.getElementById('recordBtn');
        const recordText = document.getElementById('recordText');
        const recordTimer = document.getElementById('recordTimer');
        if (!recordBtn || !recordText || !recordTimer) return;

        if (!mediaRecorder || mediaRecorder.state === 'inactive') {
            try {
                recordingStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                const mimeType = MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm' : 'audio/mp4';
                audioChunks = [];
                mediaRecorder = new MediaRecorder(recordingStream, { mimeType });
                mediaRecorder.ondataavailable = (e) => {
                    if (e.data && e.data.size > 0) audioChunks.push(e.data);
                };
                mediaRecorder.onstop = () => {
                    if (!audioChunks.length) return;
                    const blob = new Blob(audioChunks, { type: mimeType });
                    const ext = mimeType === 'audio/mp4' ? 'm4a' : 'webm';
                    const file = new File([blob], `voice_${Date.now()}.${ext}`, { type: mimeType });
                    addFileToInput(file);

                    const preview = document.getElementById('audioPreview');
                    if (preview) {
                        const url = URL.createObjectURL(blob);
                        preview.innerHTML = `<audio controls src="${url}" style="width:100%; max-width:320px;"></audio>`;
                    }
                };

                mediaRecorder.start(100);
                recordBtn.classList.add('recording');
                recordText.textContent = 'توقف';
                recordingStartTime = Date.now();
                timerInterval = window.setInterval(() => {
                    const elapsed = Math.floor((Date.now() - recordingStartTime) / 1000);
                    const m = String(Math.floor(elapsed / 60)).padStart(2, '0');
                    const s = String(elapsed % 60).padStart(2, '0');
                    recordTimer.textContent = `${m}:${s}`;
                }, 1000);
            } catch (error) {
                const noteEl = document.getElementById('chatComposerNote');
                if (noteEl) noteEl.textContent = 'دسترسی میکروفن داده نشد.';
            }
            return;
        }

        mediaRecorder.stop();
        if (recordingStream) {
            recordingStream.getTracks().forEach(t => t.stop());
            recordingStream = null;
        }
        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }
        recordBtn.classList.remove('recording');
        recordText.textContent = 'ضبط ویس';
        recordTimer.textContent = '';
    }

    function initTaskChatComposer(taskId) {
        const sendBtn = document.getElementById('sendChatBtn');
        const messageInput = document.getElementById('chatMessageInput');
        const fileInput = document.getElementById('chatFileInput');
        const recordBtn = document.getElementById('recordBtn');
        if (!sendBtn) return;

        sendBtn.addEventListener('click', function () {
            sendTaskChat(taskId);
        });

        messageInput?.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                sendTaskChat(taskId);
            }
        });

        fileInput?.addEventListener('change', showSelectedFiles);
        recordBtn?.addEventListener('click', toggleRecording);
    }

    function renderInlineSubtasks(items) {
        const listEl = document.getElementById('inlineSubtasksList');
        if (!listEl) return;

        const subtasks = Array.isArray(items) ? items : [];
        const badge = document.getElementById('inlineSubtaskProgressBadge');
        if (badge) {
            const done = subtasks.filter(s => s.isCompleted).length;
            badge.textContent = subtasks.length ? `${done}/${subtasks.length}` : '0/0';
        }
        if (subtasks.length === 0) {
            listEl.innerHTML = '<li class="subtask-empty">هنوز کارکی ثبت نشده است.</li>';
            return;
        }

        listEl.innerHTML = subtasks.map(st => {
            const id = Number(st.id || 0);
            const title = escapeHtml(st.title || '');
            const completed = !!st.isCompleted;
            return `
                <li class="subtask-item" data-subtask-id="${id}">
                    <div class="subtask-item-main">
                        <input type="checkbox" class="inline-subtask-check" data-subtask-id="${id}" ${completed ? 'checked' : ''} />
                        <span class="subtask-title editable ${completed ? 'completed' : ''}" data-subtask-id="${id}" title="برای ویرایش کلیک کنید">${title}</span>
                    </div>
                    <div class="subtask-item-actions">
                        <button type="button" class="subtask-edit-btn" data-subtask-id="${id}" title="ویرایش" aria-label="ویرایش"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="subtask-delete-btn" data-subtask-id="${id}" title="حذف" aria-label="حذف"><i class="bi bi-trash"></i></button>
                    </div>
                </li>
            `;
        }).join('');
    }

    function beginInlineSubtaskEdit(subtaskId) {
        const listEl = document.getElementById('inlineSubtasksList');
        if (!listEl) return;
        const li = listEl.querySelector(`.subtask-item[data-subtask-id="${subtaskId}"]`);
        if (!li || li.querySelector('.subtask-edit-input')) return;

        const titleSpan = li.querySelector('.subtask-title');
        if (!titleSpan) return;
        const currentTitle = titleSpan.textContent.trim();
        const completed = titleSpan.classList.contains('completed');

        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'form-control form-control-sm subtask-edit-input';
        input.value = currentTitle;
        input.maxLength = 500;
        titleSpan.replaceWith(input);
        input.focus();
        input.select();

        let saving = false;
        const restoreTitle = (text) => {
            const span = document.createElement('span');
            span.className = `subtask-title editable${completed ? ' completed' : ''}`;
            span.dataset.subtaskId = String(subtaskId);
            span.title = 'برای ویرایش کلیک کنید';
            span.textContent = text;
            input.replaceWith(span);
        };

        const cancelEdit = () => {
            if (saving) return;
            restoreTitle(currentTitle);
        };

        const commitEdit = async () => {
            if (saving) return;
            const noteEl = document.getElementById('inlineSubtaskNote');
            const newTitle = input.value.trim();
            if (!newTitle) {
                if (noteEl) noteEl.textContent = 'عنوان کارک الزامی است.';
                input.focus();
                return;
            }
            if (newTitle === currentTitle) {
                cancelEdit();
                return;
            }
            saving = true;
            try {
                if (noteEl) noteEl.textContent = 'در حال ذخیره...';
                await updateInlineSubtask(subtaskId, newTitle);
                if (noteEl) noteEl.textContent = '';
            } catch (error) {
                if (noteEl) noteEl.textContent = error?.message || 'ویرایش کارک انجام نشد.';
                saving = false;
                restoreTitle(currentTitle);
            }
        };

        input.addEventListener('keydown', function (ev) {
            if (ev.key === 'Enter') {
                ev.preventDefault();
                commitEdit();
            } else if (ev.key === 'Escape') {
                ev.preventDefault();
                cancelEdit();
            }
        });
        input.addEventListener('blur', function () {
            setTimeout(function () {
                if (document.activeElement === input) return;
                commitEdit();
            }, 120);
        });
    }

    async function updateInlineSubtask(subtaskId, title) {
        const response = await fetch('/Tasks/UpdateInlineSubtask', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subtaskId, title })
        });
        if (!response.ok) {
            const errText = await response.text();
            throw new Error(errText || 'update_failed');
        }
        const result = await response.json();
        if (!result.success) {
            throw new Error(result.message || 'update_failed');
        }
        await loadInlineSubtasks(editTaskIdForChat);
    }

    async function loadInlineSubtasks(parentTaskId) {
        const listEl = document.getElementById('inlineSubtasksList');
        if (!listEl) return;
        try {
            const response = await fetch(`/Tasks/GetSubtasks?parentId=${parentTaskId}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!response.ok) throw new Error('load_failed');
            const data = await response.json();
            renderInlineSubtasks(data);
        } catch {
            listEl.innerHTML = '<li class="subtask-empty">خطا در دریافت کارک‌ها.</li>';
        }
    }

    async function addInlineSubtask(parentTaskId) {
        const input = document.getElementById('inlineSubtaskTitle');
        const noteEl = document.getElementById('inlineSubtaskNote');
        if (!input) return;
        const title = (input.value || '').trim();
        if (!title) {
            if (noteEl) noteEl.textContent = 'عنوان کارک الزامی است.';
            return;
        }

        try {
            if (noteEl) noteEl.textContent = 'در حال افزودن...';
            const response = await fetch('/Tasks/AddInlineSubtask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ parentId: parentTaskId, title })
            });
            if (!response.ok) {
                const err = await response.text();
                throw new Error(err || 'add_failed');
            }
            input.value = '';
            if (noteEl) noteEl.textContent = '';
            await loadInlineSubtasks(parentTaskId);
        } catch (error) {
            if (noteEl) noteEl.textContent = error?.message || 'افزودن کارک انجام نشد.';
        }
    }

    async function toggleInlineSubtask(subtaskId) {
        const noteEl = document.getElementById('inlineSubtaskNote');
        try {
            const response = await fetch('/Tasks/ToggleInlineSubtask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ subtaskId })
            });
            if (!response.ok) {
                const err = await response.text();
                throw new Error(err || 'toggle_failed');
            }
            await loadInlineSubtasks(editTaskIdForChat);
        } catch (error) {
            if (noteEl) noteEl.textContent = error?.message || 'تغییر وضعیت کارک انجام نشد.';
            await loadInlineSubtasks(editTaskIdForChat);
        }
    }

    async function deleteInlineSubtask(subtaskId) {
        const noteEl = document.getElementById('inlineSubtaskNote');
        if (!confirm('این کارک حذف شود؟')) return;
        try {
            const response = await fetch('/Tasks/DeleteTask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ taskId: subtaskId })
            });
            if (!response.ok) {
                const err = await response.text();
                throw new Error(err || 'delete_failed');
            }
            await loadInlineSubtasks(editTaskIdForChat);
        } catch (error) {
            if (noteEl) noteEl.textContent = error?.message || 'حذف کارک انجام نشد.';
        }
    }

    function initInlineSubtaskPanel(parentTaskId) {
        const addBtn = document.getElementById('addInlineSubtaskBtn');
        const input = document.getElementById('inlineSubtaskTitle');
        const listEl = document.getElementById('inlineSubtasksList');
        if (!addBtn || !input) return;

        addBtn.addEventListener('click', () => addInlineSubtask(parentTaskId));
        input.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
                event.preventDefault();
                addInlineSubtask(parentTaskId);
            }
        });

        if (listEl && !listEl.dataset.delegationBound) {
            listEl.dataset.delegationBound = '1';
            listEl.addEventListener('change', function (e) {
                const t = e.target;
                if (t.classList && t.classList.contains('inline-subtask-check')) {
                    const sid = parseInt(t.getAttribute('data-subtask-id'), 10);
                    if (sid) toggleInlineSubtask(sid);
                }
            });
            listEl.addEventListener('click', function (e) {
                const editBtn = e.target.closest('.subtask-edit-btn');
                if (editBtn) {
                    e.preventDefault();
                    const sid = parseInt(editBtn.getAttribute('data-subtask-id'), 10);
                    if (sid) beginInlineSubtaskEdit(sid);
                    return;
                }
                const titleEl = e.target.closest('.subtask-title.editable');
                if (titleEl) {
                    const sid = parseInt(titleEl.getAttribute('data-subtask-id'), 10);
                    if (sid) beginInlineSubtaskEdit(sid);
                    return;
                }
                const deleteBtn = e.target.closest('.subtask-delete-btn');
                if (deleteBtn) {
                    const sid = parseInt(deleteBtn.getAttribute('data-subtask-id'), 10);
                    if (sid) deleteInlineSubtask(sid);
                }
            });
        }

        loadInlineSubtasks(parentTaskId);
    }
</script>

