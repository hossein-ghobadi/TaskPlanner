@model Endpoint.Site.Models.TaskEditVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    var isModal = (Context.Request.Query.ContainsKey("fromModal") && Context.Request.Query["fromModal"] == "true")
                  || (Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("fromModal") && Context.Request.Form["fromModal"] == "true");
    Layout = isModal ? null : "/Views/Shared/_Layout.cshtml";
    var projectIssueTypes = ViewBag.ProjectIssueTypes as List<ProjectIssueType> ?? new List<ProjectIssueType>();
    
    // به‌طور معمول کارک در لیست انتخاب نیست؛ اگر خود این آیتم کارک باشد، همان ProjectIssueType را نگه دار تا مقدار نمایش درست باشد
    var availableIssueTypes = projectIssueTypes
        .Where(pit => pit.Level != IssueTypeLevel.Subtask || Model.ProjectIssueTypeId == pit.Id)
        .OrderBy(pit => pit.Order)
        .ThenBy(pit => pit.Level)
        .ToList();
    var effortLevelLabel = Model.EffortLevel switch
    {
        TaskEffortLevel.Simple => "ساده",
        TaskEffortLevel.Medium => "متوسط",
        TaskEffortLevel.Hard => "پرزحمت",
        _ => "تعیین نشده"
    };
}

@if (isModal)
{
    <link rel="stylesheet" href="~/lib/vazir-font/dist/font-face.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/persian-datepicker/dist/css/persian-datepicker.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/persian-date/dist/persian-date.min.js"></script>
    <script src="~/lib/persian-datepicker/dist/js/persian-datepicker.min.js"></script>
}

<style>
    .modal-mode-root {
        direction: rtl;
        font-family: var(--primary-font-family, 'Vazir', 'Tahoma', 'Arial', sans-serif);
        position: relative;
        min-height: 100vh;
        min-height: 100dvh;
    }
    .task-form-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 0;
    }
    .task-form-container.modal-mode {
        max-width: 100%;
        margin: 0;
        padding: 0;
        position: relative;
        min-height: 100vh;
        min-height: 100dvh;
    }
    .task-form-container.modal-mode .form-header {
        display: none;
    }
    
    .form-header {
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        color: white;
        box-shadow: 0 10px 40px rgba(37, 99, 235, 0.3);
    }
    
    .form-header h2 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    
    .form-header .icon {
        font-size: 2.5rem;
    }
    
    .form-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #f0f0f0;
        transition: all 0.3s ease;
    }
    
    .form-card:hover {
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
        transform: translateY(-2px);
    }
    
    .form-card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #f3f4f6;
    }
    
    .form-card-title i {
        color: #2563eb;
        font-size: 1.3rem;
    }
    
    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .form-label i {
        color: #2563eb;
        font-size: 1rem;
    }
    
    .form-control, .form-select {
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        outline: none;
    }
    
    .form-control:disabled {
        background-color: #f9fafb;
        cursor: not-allowed;
        opacity: 0.7;
    }
    
    .help-text {
        background: #eff6ff;
        border-right: 4px solid #2563eb;
        padding: 1rem;
        border-radius: 8px;
        margin-top: 0.75rem;
        font-size: 0.9rem;
        color: #1e40af;
    }
    
    .btn-modern {
        border-radius: 12px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
    }
    
    .btn-modern-warning {
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
    }
    
    .btn-modern-warning:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(30, 64, 175, 0.5);
        color: white;
    }
    
    .btn-modern-secondary {
        background: #f3f4f6;
        color: #374151;
    }
    
    .btn-modern-secondary:hover {
        background: #e5e7eb;
        transform: translateY(-2px);
        color: #374151;
    }
    
    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 2px solid #f3f4f6;
    }
    
    .field-group {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .chat-box {
        max-height: 320px;
        overflow-y: auto;
        padding: 0.5rem;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }

    .chat-empty {
        color: #6b7280;
        font-size: 0.92rem;
        background: #fff;
        border: 1px dashed #d1d5db;
        border-radius: 10px;
        padding: 0.75rem 1rem;
    }

    .chat-message {
        display: flex;
        margin-bottom: 0.7rem;
    }

    .chat-message:last-child {
        margin-bottom: 0;
    }

    .chat-message.own { justify-content: flex-end; }
    .chat-message.other { justify-content: flex-start; }

    .chat-message-card {
        width: min(100%, 620px);
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        padding: 0.7rem 0.8rem;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    }

    .chat-message.own .chat-message-card {
        background: #2563eb;
        border-color: #2563eb;
        color: #fff;
    }

    .chat-message.own .chat-meta,
    .chat-message.own .chat-text {
        color: #e5edff;
    }

    .chat-message.own .chat-attachment-item a { color: #fff; text-decoration: underline; }
    .chat-message.own .chat-delete-btn {
        border-color: rgba(255,255,255,0.5);
        background: rgba(255,255,255,0.2);
        color: #fff;
    }

    .chat-meta {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: #6b7280;
        margin-bottom: 0.35rem;
    }

    .chat-meta-right {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .chat-delete-btn {
        border: 1px solid #fecaca;
        background: #fff1f2;
        color: #dc2626;
        border-radius: 999px;
        padding: 0.1rem 0.45rem;
        font-size: 0.72rem;
        line-height: 1.2;
        cursor: pointer;
    }

    .chat-delete-btn:hover {
        background: #ffe4e6;
    }

    .chat-user-badge {
        display: inline-flex;
        align-items: center;
        font-size: 0.72rem;
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        background: #eef2ff;
        color: #3730a3;
        margin-inline-start: 0.35rem;
    }

    .chat-message.own .chat-user-badge {
        background: rgba(255,255,255,0.2);
        color: #fff;
    }

    .chat-text {
        font-size: 0.92rem;
        color: #1f2937;
        margin-bottom: 0.35rem;
        white-space: pre-wrap;
    }

    .chat-attachments {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        margin-top: 0.35rem;
    }

    .chat-attachment-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.88rem;
    }

    .chat-attachment-item a {
        color: #1d4ed8;
        text-decoration: none;
    }

    .chat-attachment-item a:hover {
        text-decoration: underline;
    }

    .chat-attachment-image {
        max-width: 240px;
        width: 100%;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        display: block;
    }

    .chat-attachment-audio {
        width: 100%;
        max-width: 320px;
    }

    .chat-composer {
        margin-top: 0.9rem;
    }

    .chat-composer .composer-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.6rem;
        align-items: center;
    }

    .chat-actions {
        margin-top: 0.6rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .chat-action-btn {
        border: 1px solid #d1d5db;
        background: #fff;
        border-radius: 8px;
        padding: 0.3rem 0.6rem;
        font-size: 0.82rem;
        color: #374151;
        cursor: pointer;
    }

    .chat-action-btn.recording {
        border-color: #ef4444;
        color: #ef4444;
    }

    .file-preview {
        margin-top: 0.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .file-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 0.35rem 0.55rem;
        font-size: 0.82rem;
    }

    .file-item button {
        border: none;
        background: transparent;
        color: #dc2626;
        cursor: pointer;
    }

    .chat-note {
        margin-top: 0.5rem;
        font-size: 0.82rem;
        color: #6b7280;
    }

    .checklist-card {
        border: 1px solid #e8eaef;
        border-radius: 12px;
        background: #fafbfc;
    }

    .checklist-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.85rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .checklist-title {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 1rem;
        font-weight: 600;
        color: #1f2937;
    }

    .checklist-title i {
        color: #4b5563;
        font-size: 1.1rem;
    }

    .checklist-progress-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.5rem;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        background: #4b5563;
        color: #fff;
    }

    .subtask-input-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .subtask-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .subtask-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.65rem;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #fff;
        padding: 0.55rem 0.65rem;
    }

    .subtask-item-main {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        min-width: 0;
        flex: 1;
    }

    .subtask-item-main input[type="checkbox"] {
        width: 1.05rem;
        height: 1.05rem;
        margin-top: 0.2rem;
        flex-shrink: 0;
        cursor: pointer;
    }

    .subtask-title {
        white-space: normal;
        word-break: break-word;
        font-size: 0.9rem;
        line-height: 1.45;
        flex: 1;
        min-width: 0;
    }

    .subtask-title.completed {
        text-decoration: line-through;
        color: #9ca3af;
    }

    .subtask-title.editable {
        cursor: text;
    }

    .subtask-title.editable:hover {
        color: #2563eb;
    }

    .subtask-edit-input {
        font-size: 0.9rem;
        padding: 0.2rem 0.45rem;
        min-width: 0;
        flex: 1;
    }

    .subtask-item-actions {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        flex-shrink: 0;
    }

    .subtask-edit-btn {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: #3b82f6;
        color: #fff;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .subtask-edit-btn:hover {
        background: #2563eb;
        color: #fff;
    }

    .subtask-delete-btn {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: #ef4444;
        color: #fff;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .subtask-delete-btn:hover {
        background: #dc2626;
        color: #fff;
    }

    .subtask-empty {
        border: 1px dashed #d1d5db;
        border-radius: 10px;
        padding: 0.65rem 0.75rem;
        font-size: 0.84rem;
        color: #6b7280;
        background: #f9fafb;
        text-align: center;
    }

    /* حالت مودال: چک‌لیست به‌صورت عادی زیر "مسئول کار" نمایش داده می‌شود */
    .task-form-container.modal-mode .checklist-panel-corner--modal {
        margin-top: 1rem;
    }

    /* صفحه کامل ویرایش: چک لیست پایین، هم‌تراز سمت چپ (در RTL با flex-end) */
    .checklist-page-bottom-row {
        display: flex;
        justify-content: flex-end;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .checklist-page-bottom-row .checklist-panel-corner--page {
        width: 100%;
        max-width: 420px;
    }
    
    @@media (max-width: 768px) {
        .form-header {
            padding: 1.5rem;
        }
        
        .form-header h2 {
            font-size: 1.5rem;
        }
        
        .form-card {
            padding: 1.5rem;
        }
        
        .field-group {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="modal-mode-root">
<div class="task-form-container @(isModal ? "modal-mode" : "")">
    <div class="form-header">
        <h2>
            <span class="icon">✏️</span>
            ویرایش کار
        </h2>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <input type="hidden" asp-for="ProjectIssueTypeId" id="projectIssueTypeId" />
        <input type="hidden" asp-for="IssueType" id="issueTypeHidden" />
        @Html.HiddenFor(m => m.ProjectId)
        @if (isModal)
        {
            <input type="hidden" name="fromModal" value="true" />
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }

        @if (isModal)
        {
            <div class="row g-3">
                <div class="col-lg-8">
                    <!-- اطلاعات اصلی -->
                    <div class="form-card">
                        <div class="form-card-title">
                            <i class="bi bi-info-circle"></i>
                            اطلاعات اصلی
                        </div>
                        <div class="mb-4">
                            <label asp-for="IssueType" class="form-label">
                                <i class="bi bi-tag"></i>
                                نوع کار
                                <span class="text-danger">*</span>
                            </label>
                            <select asp-for="IssueType" class="form-select" id="issueTypeSelect" disabled>
                                @foreach (var issueType in availableIssueTypes)
                                {
                                    var isSelected = Model.ProjectIssueTypeId == issueType.Id ||
                                                     (Model.ProjectIssueTypeId == null && Model.IssueType == issueType.BaseType);
                                    <option value="@((int)issueType.BaseType)"
                                            data-project-issue-type-id="@issueType.Id"
                                            data-level="@((int)issueType.Level)"
                                            selected="@isSelected">
                                        @issueType.Icon @issueType.Name
                                    </option>
                                }
                            </select>
                            <small class="text-muted small">نوع کار قابل تغییر نیست</small>
                            <span asp-validation-for="IssueType" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label">
                                <i class="bi bi-card-heading"></i>
                                عنوان کار
                            </label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="mb-0">
                            <label asp-for="Description" class="form-label">
                                <i class="bi bi-file-text"></i>
                                توضیحات
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>
                        <div class="mt-3">
                            <label class="form-label">
                                <i class="bi bi-star"></i>
                                سطح کار
                            </label>
                            <div class="form-control bg-light d-flex align-items-center">
                                @effortLevelLabel
                            </div>
                            <small class="text-muted small">برای تغییر، از فیلد ستون سمت راست استفاده کنید.</small>
                        </div>
                    </div>

                    <!-- پیوست‌ها -->
                    <div class="form-card">
                        <div class="form-card-title">
                            <i class="bi bi-paperclip"></i>
                            پیوست‌ها و گفتگو
                        </div>
                        <div id="taskChatBox" class="chat-box">
                            <div class="chat-empty">در حال بارگذاری گفتگو...</div>
                        </div>
                        <div class="chat-composer">
                            <div class="composer-row">
                                <input type="text" id="chatMessageInput" class="form-control" placeholder="پیام یا توضیح پیوست..." />
                                <button type="button" id="sendChatBtn" class="btn btn-modern btn-modern-warning">
                                    <i class="bi bi-send"></i>
                                    افزودن
                                </button>
                            </div>
                            <div class="chat-actions">
                                <label class="chat-action-btn">
                                    <i class="bi bi-paperclip"></i> فایل
                                    <input type="file" id="chatFileInput" multiple accept="image/*,audio/*,.pdf,.doc,.docx,.txt" style="display:none;" />
                                </label>
                                <button type="button" class="chat-action-btn" id="recordBtn">
                                    <span id="recordText">ضبط ویس</span>
                                </button>
                                <span id="recordTimer" class="chat-action-btn" style="background: transparent; border: none;"></span>
                            </div>
                            <div id="selectedFiles" class="file-preview"></div>
                            <div id="audioPreview" class="file-preview"></div>
                            <div id="chatComposerNote" class="chat-note"></div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- زمان‌بندی -->
                    <div class="form-card">
                        <div class="form-card-title">
                            <i class="bi bi-calendar3"></i>
                            زمان‌بندی
                        </div>
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-calendar-event"></i>
                                تاریخ شروع
                            </label>
                            <input type="text" id="StartDateDisplay" class="form-control" autocomplete="off" value="@Model.StartDateSh" />
                            <input type="hidden" asp-for="StartDateSh" id="StartDate" value="@Model.StartDateSh" />
                            <span asp-validation-for="StartDateSh" class="text-danger small"></span>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">
                                <i class="bi bi-calendar-check"></i>
                                تاریخ پایان
                            </label>
                            <input type="text" id="DueDateDisplay" class="form-control" autocomplete="off" value="@Model.DueDateSh" />
                            <input type="hidden" asp-for="DueDateSh" id="DueDate" value="@Model.DueDateSh" />
                            <span asp-validation-for="DueDateSh" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- اطلاعات -->
                    <div class="form-card">
                        <div class="form-card-title">
                            <i class="bi bi-info-square"></i>
                            اطلاعات
                        </div>
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-folder"></i>
                                پروژه
                            </label>
                            <select asp-for="ProjectId" class="form-select" disabled asp-items="@(new SelectList(ViewBag.Projects, "Id", "Name", Model.ProjectId))"></select>
                            <small class="text-muted small">پروژه قابل تغییر نیست</small>
                            <span asp-validation-for="ProjectId" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label">
                                <i class="bi bi-collection"></i>
                                دسته‌بندی (اختیاری)
                            </label>
                            <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                                <option value="">-- بدون دسته‌بندی --</option>
                            </select>
