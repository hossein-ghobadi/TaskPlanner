            $("#DueDate").val($("#DueDateDisplay").val() || "");

            // 🎯 مدیریت IssueType و ProjectIssueType
            const projectIssueTypeInput = document.getElementById('projectIssueTypeId');
            
            // مدیریت تغییر نوع کار و تنظیم ProjectIssueTypeId
            const selectElement = document.getElementById('issueTypeSelect');
            if (selectElement) {
                selectElement.addEventListener('change', function () {
                    const selectedOption = this.options[this.selectedIndex];
                    const projectIssueTypeId = selectedOption.getAttribute('data-project-issue-type-id');
                    
                    if (projectIssueTypeId && projectIssueTypeInput) {
                        projectIssueTypeInput.value = projectIssueTypeId;
                    } else if (projectIssueTypeInput) {
                        projectIssueTypeInput.value = '';
                    }
                });
                
                // تنظیم مقدار اولیه
                const selectedOption = selectElement.options[selectElement.selectedIndex];
                if (selectedOption) {
                    const projectIssueTypeId = selectedOption.getAttribute('data-project-issue-type-id');
                    if (projectIssueTypeId && projectIssueTypeInput) {
                        projectIssueTypeInput.value = projectIssueTypeId;
                    }
                }
            }

            loadTaskChat(@Model.Id);
            initTaskChatComposer(@Model.Id);
            @if (Model.IssueType == IssueType.Task)
            {
                <text>initInlineSubtaskPanel(@Model.Id);</text>
            }
        })();

        function closeEditTaskModal() {
            if (window.self !== window.top) {
                window.parent.postMessage('taskEditCancel', '*');
            } else {
                window.history.back();
            }
        }

        @if (Context.Request.Query.ContainsKey("saved") && Context.Request.Query["saved"] == "true")
        {
            <text>
            (function notifyEditSuccess() {
                const editedTaskId = '@(Context.Request.Query.ContainsKey("id") ? Context.Request.Query["id"].ToString() : "")';
                if (window.self !== window.top) {
                    window.parent.postMessage({ type: 'taskEditSuccess', taskId: editedTaskId }, '*');
                }
            })();
            </text>
        }
    </script>
}
