@using DNTPersianUtils.Core
@using TaskPlanner.Domain.Entities.TaskPlanner
@model IEnumerable<TaskPlanner.Domain.Entities.TaskPlanner.TaskItem>

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var startOfWeek = (DateTime)ViewBag.StartOfWeek;
    var endOfWeek = (DateTime)ViewBag.EndOfWeek;
    int offset = (int)ViewBag.Offset;
    var selectedProjectId = ViewBag.SelectedProjectId as int?;
    var userProjects = ViewBag.UserProjects;
    
    // روزهای هفته
    var weekDays = new[] { "شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنج‌شنبه", "جمعه" };
    
    // نام ماه‌های شمسی
    var persianMonths = new[] { "فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند" };
    
    // استخراج ماه و سال از تاریخ شروع هفته
    var startPersianDate = startOfWeek.ToShortPersianDateString().Split('/');
    var monthNumber = int.Parse(startPersianDate[1]);
    var monthName = persianMonths[monthNumber - 1];
    var year = startPersianDate[0];
    
    // گروه‌بندی کارها بر اساس تاریخ
    var tasksByDate = Model
        .Where(t => t.StartDate.HasValue && t.StartDate.Value >= startOfWeek && t.StartDate.Value <= endOfWeek)
        .GroupBy(t => t.StartDate!.Value.Date)
        .ToDictionary(g => g.Key, g => g.ToList());
}

<style>
    .weekly-calendar {
        background: linear-gradient(135deg, rgba(248, 249, 255, 0.9), #ffffff);
        border-radius: 18px;
        box-shadow: 0 10px 40px rgba(80, 85, 249, 0.12);
        padding: 32px;
        margin-top: 20px;
        border: 1px solid rgba(73, 84, 255, 0.1);
        position: relative;
        overflow: hidden;
    }
    
    .weekly-calendar::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -60px;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle at center, rgba(80, 85, 249, 0.15), transparent 70%);
        filter: blur(20px);
        pointer-events: none;
    }
    
    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 24px;
        border-bottom: 2px solid rgba(80, 85, 249, 0.15);
        position: relative;
    }
    
    .calendar-title {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0 0 6px 0;
        letter-spacing: -0.5px;
    }
    
    .calendar-month {
        font-size: 1.1rem;
        font-weight: 600;
        color: #64748b;
        margin: 0 0 6px 0;
    }
    
    .calendar-date-range {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 500;
    }
    
    .calendar-nav {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }
    
    .project-filter {
        margin-bottom: 24px;
        padding: 18px 20px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.05), rgba(79, 70, 229, 0.05));
        border-radius: 14px;
        border: 1px solid rgba(80, 85, 249, 0.2);
        box-shadow: 0 4px 12px rgba(80, 85, 249, 0.08);
    }
    
    .project-filter label {
        font-weight: 600;
        color: #3634a5;
        margin-bottom: 10px;
        display: block;
        font-size: 0.95rem;
    }
    
    .project-filter select {
        border-radius: 10px;
        border: 1.5px solid rgba(80, 85, 249, 0.3);
        padding: 10px 14px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background: #fff;
        color: #1e293b;
    }
    
    .project-filter select:focus {
        border-color: #6366f1;
        outline: none;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }
    
    .btn-nav {
        padding: 10px 18px;
        border-radius: 10px;
        border: 1.5px solid rgba(80, 85, 249, 0.3);
        background: #fff;
        color: #6366f1;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        box-shadow: 0 2px 8px rgba(80, 85, 249, 0.1);
    }
    
    .btn-nav:hover {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: #fff;
        border-color: #6366f1;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(80, 85, 249, 0.3);
    }
    
    .btn-nav.active {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: #fff;
        border-color: #6366f1;
        box-shadow: 0 4px 16px rgba(80, 85, 249, 0.25);
    }
    
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 12px;
        margin-top: 20px;
    }
    
    .calendar-day {
        background: #fff;
        border-radius: 12px;
        padding: 12px;
        min-height: 300px;
        border: 1px solid rgba(80, 85, 249, 0.12);
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
    }
    
    .calendar-day:hover {
        box-shadow: 0 8px 24px rgba(80, 85, 249, 0.15);
    }
    
    .calendar-day.today {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(79, 70, 229, 0.08));
        border-color: #6366f1;
        border-width: 2px;
        box-shadow: 0 8px 24px rgba(99, 102, 241, 0.2);
    }
    
    .day-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(80, 85, 249, 0.15);
    }
    
    .day-name {
        font-weight: 600;
        font-size: 0.75rem;
        color: #64748b;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .day-number {
        font-size: 1.4rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1;
    }
    
    .day-number.today-badge {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: #fff;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }
    
    .day-tasks {
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
        overflow-y: auto;
    }
    
    .day-tasks::-webkit-scrollbar {
        width: 4px;
    }
    
    .day-tasks::-webkit-scrollbar-track {
        background: rgba(248, 249, 255, 0.5);
        border-radius: 4px;
    }
    
    .day-tasks::-webkit-scrollbar-thumb {
        background: rgba(80, 85, 249, 0.3);
        border-radius: 4px;
    }
    
    .day-tasks::-webkit-scrollbar-thumb:hover {
        background: rgba(80, 85, 249, 0.5);
    }
    
    .task-card {
        background: linear-gradient(135deg, rgba(248, 249, 255, 0.6), #ffffff);
        border: 1px solid rgba(80, 85, 249, 0.2);
        border-radius: 8px;
        padding: 8px 10px;
        transition: all 0.2s ease;
        border-right: 3px solid #6366f1;
        cursor: default;
    }
    
    .task-card:hover {
        box-shadow: 0 4px 12px rgba(80, 85, 249, 0.15);
        border-right-color: #4f46e5;
        background: #fff;
    }
    
    .task-title {
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 3px;
        display: flex;
        align-items: center;
        gap: 5px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.85rem;
    }
    
    .task-key {
        font-size: 0.65rem;
        color: #64748b;
        font-family: monospace;
        margin-bottom: 3px;
        font-weight: 500;
    }
    
    .task-meta {
        font-size: 0.7rem;
        color: #64748b;
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 3px;
    }
    
    .task-project {
        font-weight: 500;
        color: #475569;
    }
    
    .task-assignee {
        display: flex;
        align-items: center;
        gap: 3px;
        color: #64748b;
    }
    
    .empty-day {
        color: #cbd5e1;
        font-size: 0.85rem;
        text-align: center;
        padding: 30px 0;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    @@media (max-width: 1400px) {
        .calendar-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
    
    @@media (max-width: 992px) {
        .calendar-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    
    @@media (max-width: 768px) {
        .weekly-calendar {
            padding: 20px;
        }
        
        .calendar-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }
        
        .calendar-header {
            flex-direction: column;
            gap: 20px;
            align-items: flex-start;
        }
        
        .calendar-nav {
            width: 100%;
            justify-content: space-between;
        }
        
        .btn-nav {
            flex: 1;
            text-align: center;
            padding: 8px 12px;
            font-size: 0.85rem;
        }
        
        .calendar-day {
            min-height: 180px;
            padding: 12px;
        }
        
        .calendar-title {
            font-size: 1.6rem;
        }
    }
    
    @@media (max-width: 576px) {
        .weekly-calendar {
            padding: 16px;
            border-radius: 14px;
        }
        
        .calendar-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }
        
        .calendar-title {
            font-size: 1.4rem;
        }
        
        .calendar-day {
            min-height: 160px;
        }
    }
</style>

<div class="weekly-calendar">
    <div class="project-filter">
        <label for="projectFilter">فیلتر پروژه</label>
        <select id="projectFilter" class="form-select" onchange="filterByProject(this.value)">
            <option value="">همه پروژه‌ها</option>
            @foreach (var project in userProjects)
            {
                var isSelected = selectedProjectId.HasValue && selectedProjectId.Value == project.Id;
                if (isSelected)
                {
                    <option value="@project.Id" selected="selected">
                        @project.Name
                    </option>
                }
                else
                {
                    <option value="@project.Id">
                        @project.Name
                    </option>
                }
            }
        </select>
    </div>
    
    <div class="calendar-header">
        <div>
            <h2 class="calendar-title">برنامه هفتگی</h2>
            <div class="calendar-month">@monthName @year</div>
            <div class="calendar-date-range">@startOfWeek.ToShortPersianDateString() - @endOfWeek.ToShortPersianDateString()</div>
        </div>
        <div class="calendar-nav">
            <a class="btn-nav" asp-action="Weekly" asp-route-offset="@(offset - 1)" asp-route-projectId="@selectedProjectId">← هفته قبل</a>
            <a class="btn-nav @(offset == 0 ? "active" : "")" asp-action="Weekly" asp-route-offset="0" asp-route-projectId="@selectedProjectId">امروز</a>
            <a class="btn-nav" asp-action="Weekly" asp-route-offset="@(offset + 1)" asp-route-projectId="@selectedProjectId">هفته بعد →</a>
        </div>
    </div>
    
    <div class="calendar-grid">
        @for (int i = 0; i < 7; i++)
        {
            var currentDate = startOfWeek.AddDays(i);
            var isToday = currentDate.Date == DateTime.Today.Date;
            var dayTasks = tasksByDate.ContainsKey(currentDate.Date) ? tasksByDate[currentDate.Date] : new List<TaskItem>();
            var dayNumber = currentDate.ToShortPersianDateString().Split('/')[2];
            
            <div class="calendar-day @(isToday ? "today" : "")">
                <div class="day-header">
                    <div class="day-name">@weekDays[i]</div>
                    <div class="day-number @(isToday ? "today-badge" : "")">
                        @dayNumber
                    </div>
                </div>
                
                <div class="day-tasks">
                    @if (dayTasks.Any())
                    {
                        @foreach (var task in dayTasks.OrderBy(t => t.StartDate))
                        {
                            <div class="task-card">
                                <div class="task-title">
                                    <span>@task.IssueTypeIcon</span>
                                    <span>@task.Title</span>
                                </div>
                                @if (!string.IsNullOrEmpty(task.IssueKey))
                                {
                                    <div class="task-key">@task.IssueKey</div>
                                }
                                    @if (task.Project != null || (task.AssignedUserId != null && ViewBag.UserLookup != null && ((Dictionary<string, string>)ViewBag.UserLookup).ContainsKey(task.AssignedUserId)))
                                    {
                                        <div class="task-meta">
                                            @if (task.Project != null)
                                            {
                                                <span class="task-project">@task.Project.Name</span>
                                            }
                                            @if (task.AssignedUserId != null && ViewBag.UserLookup != null && ((Dictionary<string, string>)ViewBag.UserLookup).ContainsKey(task.AssignedUserId))
                                            {
                                                <span class="task-assignee">
                                                    @(((Dictionary<string, string>)ViewBag.UserLookup)[task.AssignedUserId])
                                                </span>
                                            }
                                        </div>
                                    }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-day">—</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<script>
    function filterByProject(projectId) {
        const offset = @offset;
        const url = projectId 
            ? `/Tasks/Weekly?offset=${offset}&projectId=${projectId}`
            : `/Tasks/Weekly?offset=${offset}`;
        window.location.href = url;
    }
</script>
