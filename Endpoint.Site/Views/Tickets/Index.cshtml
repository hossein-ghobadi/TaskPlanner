@model Endpoint.Site.Models.TicketIndexVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@using DNTPersianUtils.Core
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "تیکت‌های پروژه";

    string StatusBadge(TicketStatus status) => status switch
    {
        TicketStatus.Open => "bg-warning text-dark",
        TicketStatus.Answered => "bg-success",
        TicketStatus.Closed => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string StatusText(TicketStatus status) => status switch
    {
        TicketStatus.Open => "باز",
        TicketStatus.Answered => "پاسخ‌داده‌شده",
        TicketStatus.Closed => "بسته",
        _ => status.ToString()
    };

    string TypeBadge(TicketType type) => type switch
    {
        TicketType.SpecificationMissing => "bg-info text-dark",
        TicketType.Bug => "bg-danger",
        TicketType.CriticalBug => "bg-danger",
        TicketType.Improvement => "bg-primary",
        TicketType.Other => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string TypeText(TicketType type) => type switch
    {
        TicketType.SpecificationMissing => "نقص مشخصات",
        TicketType.Bug => "باگ",
        TicketType.CriticalBug => "باگ بحرانی",
        TicketType.Improvement => "بهبود",
        TicketType.Other => "سایر",
        _ => type.ToString()
    };

    string PersianDate(DateTime dt) =>
        dt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers();
}

<div class="w-100">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-ticket-detailed text-primary me-2"></i>
                تیکت‌ها
            </h4>
            <small class="text-muted">پروژه: <strong>@Model.ProjectName</strong></small>
            @if (Model.IsProjectCreator)
            {
                <div class="small text-muted mt-1">به عنوان سازنده پروژه، همه تیکت‌ها را می‌بینید.</div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-success" asp-action="Create" asp-route-projectId="@Model.ProjectId">
                <i class="bi bi-plus-lg me-1"></i>
                تیکت جدید
            </a>
            <a class="btn btn-outline-secondary" asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">
                <i class="bi bi-arrow-right me-1"></i>
                بازگشت به پروژه
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <input type="hidden" name="projectId" value="@Model.ProjectId" />
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="featureId">فیچر</label>
                    <select class="form-select form-select-sm" id="featureId" name="featureId" asp-items="Model.FeatureOptions"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="askedToUserId">فرد مورد سوال</label>
                    <select class="form-select form-select-sm" id="askedToUserId" name="askedToUserId">
                        <option value="">همه افراد</option>
                        @foreach (var m in Model.MemberOptions)
                        {
                            if (string.Equals(m.Value, Model.AskedToUserId, StringComparison.Ordinal))
                            {
                                <option value="@m.Value" selected>@m.Text</option>
                            }
                            else
                            {
                                <option value="@m.Value">@m.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="createdByUserId">پرسیده‌شده توسط</label>
                    <select class="form-select form-select-sm" id="createdByUserId" name="createdByUserId">
                        <option value="">همه افراد</option>
                        @foreach (var m in Model.MemberOptions)
                        {
                            if (string.Equals(m.Value, Model.CreatedByUserId, StringComparison.Ordinal))
                            {
                                <option value="@m.Value" selected>@m.Text</option>
                            }
                            else
                            {
                                <option value="@m.Value">@m.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-funnel me-1"></i> فیلتر
                    </button>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-projectId="@Model.ProjectId">
                        پاک کردن
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 w-100">
        <div class="card-body p-0">
            @if (Model.Tickets.Count == 0)
            {
                <div class="text-center text-muted py-5 px-3">
                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                    @{
                        var hasFilter = Model.FeatureId.HasValue
                            || !string.IsNullOrWhiteSpace(Model.AskedToUserId)
                            || !string.IsNullOrWhiteSpace(Model.CreatedByUserId);
                    }
                    @if (hasFilter)
                    {
                        <p class="mb-3">تیکتی با این فیلترها پیدا نشد.</p>
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-projectId="@Model.ProjectId">
                            پاک کردن فیلتر
                        </a>
                    }
                    else
                    {
                        <p class="mb-3">هنوز تیکتی ثبت نشده است.</p>
                        <a class="btn btn-primary" asp-action="Create" asp-route-projectId="@Model.ProjectId">
                            <i class="bi bi-plus-lg me-1"></i>
                            اولین تیکت را بسازید
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>عنوان</th>
                                <th>نوع</th>
                                <th>فیچر</th>
                                <th>مورد سوال</th>
                                <th>پرسیده‌شده توسط</th>
                                <th>وضعیت</th>
                                <th class="text-end">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Tickets)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@t.Id" class="fw-medium text-decoration-none">@t.Title</a>
                                        <div class="small text-muted">@PersianDate(t.CreatedAt)</div>
                                    </td>
                                    <td><span class="badge @TypeBadge(t.Type)">@TypeText(t.Type)</span></td>
                                    <td>@(t.FeatureName ?? "—")</td>
                                    <td>@t.AskedToUserName</td>
                                    <td>@t.CreatedByUserName</td>
                                    <td><span class="badge @StatusBadge(t.Status)">@StatusText(t.Status)</span></td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@t.Id" title="جزئیات">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
