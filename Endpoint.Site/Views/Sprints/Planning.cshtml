@model Endpoint.Site.Models.SprintBoardVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var backlog = ViewBag.BacklogIssues as IList<TaskItem>;
    var sprintStatus = (SprintStatus)ViewBag.SprintStatus;
    bool canEdit = sprintStatus != SprintStatus.Completed;
}

<style>
    .planning-container {
        display: flex;
        gap: 1rem;
        height: calc(100vh - 200px);
    }
    .planning-column {
        flex: 1;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #dee2e6;
        padding: 1rem;
        overflow-y: auto;
    }
    .column-header {
        font-weight: bold;
        padding: 0.75rem;
        background: #e9ecef;
        border-radius: 6px;
        margin-bottom: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .planning-issue {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        cursor: move;
        transition: all 0.2s;
        position: relative;
    }
    .planning-issue:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .planning-issue.dragging {
        opacity: 0.5;
    }
    .issue-priority {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        width: 4px;
        height: calc(100% - 1rem);
        border-radius: 2px;
    }
    .priority-critical { background-color: #dc3545; }
    .priority-high { background-color: #fd7e14; }
    .priority-medium { background-color: #ffc107; }
    .priority-low { background-color: #28a745; }
    .drop-zone-active {
        background-color: #e3f2fd;
        border-color: #2196f3;
    }
    .planning-issue.drop-target {
        border-top: 3px solid #2196f3;
        background-color: #e3f2fd;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">📅 برنامه‌ریزی اسپرینت</h2>
        <p class="text-muted mb-0">
            <strong>اسپرینت:</strong> @Model.SprintName | 
            <strong>پروژه:</strong> <a href="/Projects/Details/@Model.ProjectId">@Model.ProjectName</a>
            @if (sprintStatus == SprintStatus.Completed)
            {
                <span class="badge bg-secondary ms-2">تکمیل شده</span>
            }
            else if (sprintStatus == SprintStatus.Active)
            {
                <span class="badge bg-success ms-2">فعال</span>
            }
            else
            {
                <span class="badge bg-warning ms-2">در حال برنامه‌ریزی</span>
            }
        </p>
    </div>
    <div>
        <a class="btn btn-secondary" href="/Sprints/Details/@Model.SprintId">جزئیات اسپرینت</a>
        @if (sprintStatus == SprintStatus.Active)
        {
            <a class="btn btn-primary" href="/Sprints/Board/@Model.SprintId">تخته کانبان</a>
        }
    </div>
</div>

<div class="planning-container">
    <!-- ستون بک‌لاگ -->
    <div class="planning-column">
        <div class="column-header">
            <span>🗂️ بک‌لاگ پروژه</span>
            <span class="badge bg-secondary">@(backlog?.Count ?? 0)</span>
        </div>
        <div id="backlogList" 
             @if (canEdit) { <text>ondrop="onDropToBacklog(event)" ondragover="handleBacklogDragOver(event)" ondragenter="onDragEnterColumn(event)" ondragleave="onDragLeaveColumn(event)"</text> }>
            @if (backlog != null && backlog.Any())
            {
                foreach (var issue in backlog)
                {
                    <div class="planning-issue" 
                         draggable="@(canEdit ? "true" : "false")"
                         ondragstart="onDragIssue(event, @issue.Id, 'backlog')"
                         data-issue-id="@issue.Id">
                        <div class="issue-priority priority-@issue.Priority.ToString().ToLower()"></div>
                        <div class="d-flex align-items-start">
                            <span class="me-2" title="@issue.IssueTypeName">@issue.IssueTypeIcon</span>
                            <div style="flex: 1;">
                                <div class="fw-bold">@issue.IssueKey - @issue.Title</div>
                                <div class="text-muted small mt-1">
                                    👤 @issue.AssignedUserName
                                    @if (issue.StoryPoints.HasValue)
                                    {
                                        <span class="ms-2">⚡ @issue.StoryPoints SP</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-muted text-center p-4">
                    <i class="bi bi-inbox"></i><br>
                    هیچ Issue در بک‌لاگ وجود ندارد
                </div>
            }
        </div>
    </div>

    <!-- ستون Issues اسپرینت -->
    <div class="planning-column">
        <div class="column-header">
            <span>📋 Issues اسپرینت</span>
            <span class="badge bg-primary">@Model.SprintIssues.Count</span>
        </div>
        <div id="sprintList"
             @if (canEdit) { <text>ondrop="onDropToSprint(event)" ondragover="handleSprintDragOver(event)" ondragenter="onDragEnterColumn(event)" ondragleave="onDragLeaveColumn(event)"</text> }>
            @if (Model.SprintIssues.Any())
            {
                foreach (var issue in Model.SprintIssues)
                {
                    <div class="planning-issue" 
                         draggable="@(canEdit ? "true" : "false")"
                         ondragstart="onDragIssue(event, @issue.Id, 'sprint')"
                         ondragover="onDragOverIssue(event, @issue.Id)"
                         ondragenter="onDragEnterIssue(event, @issue.Id)"
                         ondragleave="onDragLeaveIssue(event)"
                         ondrop="onDropOnIssue(event, @issue.Id)"
                         data-issue-id="@issue.Id">
                        <div class="issue-priority priority-@issue.Priority.ToString().ToLower()"></div>
                        <div class="d-flex align-items-start justify-content-between">
                            <div class="d-flex align-items-start" style="flex: 1;">
                                <span class="me-2" title="@issue.IssueTypeName">@issue.IssueTypeIcon</span>
                                <div>
                                    <div class="fw-bold">@issue.IssueKey - @issue.Title</div>
                                    <div class="text-muted small mt-1">
                                        👤 @issue.AssignedUserName
                                        @if (issue.StoryPoints.HasValue)
                                        {
                                            <span class="ms-2">⚡ @issue.StoryPoints SP</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            @if (canEdit)
                            {
                                <button class="btn btn-sm btn-outline-danger" onclick="removeFromSprint(@issue.Id)" title="حذف از اسپرینت">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-muted text-center p-4">
                    <i class="bi bi-inbox"></i><br>
                    هیچ Issue در اسپرینت وجود ندارد
                    @if (canEdit)
                    {
                        <div class="mt-2 small">Issues را از بک‌لاگ بکشید اینجا بیندازید</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const sprintId = @Model.SprintId;
        let draggedIssueId = null;
        let draggedSource = null;
        let draggedElement = null;
        let draggedOverElement = null;

        function onDragIssue(e, issueId, source) {
            draggedIssueId = issueId;
            draggedSource = source;
            draggedElement = e.currentTarget;
            e.currentTarget.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
        }

        function onDragOverIssue(e, issueId) {
            // فقط برای مرتب‌سازی داخل Sprint - event را propagate نمی‌کنیم
            if (draggedSource === 'sprint' && draggedElement && e.currentTarget !== draggedElement) {
                e.preventDefault();
                e.stopPropagation();
                e.dataTransfer.dropEffect = 'move';
            }
            // اگر از Backlog باشد، اجازه می‌دهیم event به ستون برسد
        }

        function handleSprintDragOver(e) {
            e.preventDefault();
            // فقط اگر از Backlog باشد
            if (draggedSource === 'backlog') {
                e.dataTransfer.dropEffect = 'move';
            }
        }

        function handleBacklogDragOver(e) {
            e.preventDefault();
            // فقط اگر از Sprint باشد
            if (draggedSource === 'sprint') {
                e.dataTransfer.dropEffect = 'move';
            }
        }

        function onDragEnterIssue(e, issueId) {
            // فقط برای مرتب‌سازی داخل Sprint
            if (draggedSource === 'sprint' && draggedElement && e.currentTarget !== draggedElement) {
                e.preventDefault();
                e.stopPropagation();
                draggedOverElement = e.currentTarget;
                e.currentTarget.classList.add('drop-target');
            }
            // اگر از Backlog باشد، event را propagate می‌کنیم
        }

        function onDragLeaveIssue(e) {
            e.currentTarget.classList.remove('drop-target');
            // اگر از Backlog باشد، event را propagate می‌کنیم
            if (draggedSource === 'backlog') {
                return;
            }
            e.preventDefault();
            e.stopPropagation();
        }

        function onDragEnterColumn(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drop-zone-active');
        }

        function onDragLeaveColumn(e) {
            e.currentTarget.classList.remove('drop-zone-active');
            // حذف border از همه Issues
            document.querySelectorAll('.planning-issue').forEach(el => {
                el.classList.remove('drop-target');
            });
        }

        async function onDropToSprint(e) {
            e.preventDefault();
            e.stopPropagation();
            onDragLeaveColumn(e);
            
            if (!draggedIssueId) return;

            // اگر از Backlog باشد → اضافه کردن به Sprint
            if (draggedSource === 'backlog') {
                try {
                    const res = await fetch('/Sprints/AddTaskToSprint', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams({ sprintId: sprintId, taskId: draggedIssueId })
                    });

                    const result = await res.json();
                    if (result.success) {
                        location.reload();
                    } else {
                        alert('خطا: ' + result.message);
                    }
                } catch (err) {
                    alert('خطای شبکه');
                } finally {
                    draggedIssueId = null;
                    draggedSource = null;
                    draggedElement = null;
                }
                return;
            }

            // اگر از همان Sprint باشد → مرتب‌سازی (این قسمت در onDropOnIssue انجام می‌شود)
            if (draggedSource === 'sprint') {
                // منطق مرتب‌سازی در onDropOnIssue انجام می‌شود
                return;
            }

            draggedIssueId = null;
            draggedSource = null;
            draggedElement = null;
            draggedOverElement = null;
        }

        // Drop روی یک Issue خاص (برای مرتب‌سازی)
        async function onDropOnIssue(e, targetIssueId) {
            // حذف class drop-target
            document.querySelectorAll('.planning-issue').forEach(el => {
                el.classList.remove('drop-target');
            });
            
            // اگر از Backlog باشد → به ستون منتقل می‌کنیم
            if (draggedSource === 'backlog') {
                e.preventDefault();
                e.stopPropagation();
                // مستقیماً تابع ستون را صدا می‌زنیم
                await onDropToSprint(e);
                return;
            }
            
            // فقط اگر از همان Sprint باشد → مرتب‌سازی
            if (draggedSource !== 'sprint' || !draggedElement) {
                draggedIssueId = null;
                draggedSource = null;
                draggedElement = null;
                draggedOverElement = null;
                return;
            }
            
            e.preventDefault();
            e.stopPropagation();

            const targetElement = e.currentTarget;
            const sprintList = document.getElementById('sprintList');
            
            // اگر روی همان Issue drop کردیم، کاری نکن
            if (draggedElement === targetElement) {
                draggedIssueId = null;
                draggedSource = null;
                draggedElement = null;
                draggedOverElement = null;
                return;
            }

            // پیدا کردن ایندکس‌ها
            const allIssues = Array.from(sprintList.querySelectorAll('.planning-issue[data-issue-id]'));
            const draggedIndex = allIssues.indexOf(draggedElement);
            const targetIndex = allIssues.indexOf(targetElement);

            if (draggedIndex !== targetIndex && draggedIndex !== -1 && targetIndex !== -1) {
                // جابجایی در DOM
                if (draggedIndex < targetIndex) {
                    sprintList.insertBefore(draggedElement, targetElement.nextSibling);
                } else {
                    sprintList.insertBefore(draggedElement, targetElement);
                }

                // به‌روزرسانی ترتیب در دیتابیس
                const newOrder = Array.from(sprintList.querySelectorAll('.planning-issue[data-issue-id]'))
                    .map(el => parseInt(el.getAttribute('data-issue-id')))
                    .filter(id => !isNaN(id));

                try {
                    const res = await fetch(`/Sprints/UpdateSprintOrder?sprintId=${sprintId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(newOrder)
                    });

                    const result = await res.json();
                    if (!result.success) {
                        console.error('خطا در به‌روزرسانی ترتیب:', result.message);
                        location.reload();
                    }
                } catch (err) {
                    console.error('خطا در به‌روزرسانی ترتیب:', err);
                    location.reload();
                }
            }

            draggedIssueId = null;
            draggedSource = null;
            draggedElement = null;
            draggedOverElement = null;
        }

        async function onDropToBacklog(e) {
            e.preventDefault();
            e.stopPropagation();
            onDragLeaveColumn(e);
            
            if (!draggedIssueId || draggedSource !== 'sprint') return;

            if (!confirm('آیا مطمئن هستید که می‌خواهید این Issue را از اسپرینت حذف کنید؟')) {
                return;
            }

            try {
                const res = await fetch('/Sprints/RemoveTaskFromSprint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ sprintId: sprintId, taskId: draggedIssueId })
                });

                const result = await res.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert('خطا: ' + result.message);
                }
            } catch (err) {
                alert('خطای شبکه');
            } finally {
                draggedIssueId = null;
                draggedSource = null;
            }
        }

        async function removeFromSprint(issueId) {
            if (!confirm('آیا مطمئن هستید که می‌خواهید این Issue را از اسپرینت حذف کنید؟')) {
                return;
            }

            try {
                const res = await fetch('/Sprints/RemoveTaskFromSprint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ sprintId: sprintId, taskId: issueId })
                });

                const result = await res.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert('خطا: ' + result.message);
                }
            } catch (err) {
                alert('خطای شبکه');
            }
        }

        document.addEventListener('dragend', function() {
            document.querySelectorAll('.drop-zone-active').forEach(el => {
                el.classList.remove('drop-zone-active');
            });
            document.querySelectorAll('.dragging').forEach(el => {
                el.classList.remove('dragging');
            });
        });
    </script>
}

