@model Endpoint.Site.Areas.TaskPlanner.Models.SprintCreateVm
@using DNTPersianUtils.Core
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h2>ایجاد اسپرینت جدید</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">نام اسپرینت</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">توضیحات</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label">پروژه</label>
        <input asp-for="ProjectId" type="hidden" />
        <input type="text" class="form-control" value="@ViewBag.ProjectName" readonly />
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label">تاریخ شروع <span class="text-danger">*</span></label>
        <input type="text" id="StartDateDisplay" class="form-control" placeholder="تاریخ شروع را انتخاب کنید" required />
        <input type="hidden" asp-for="StartDate" name="StartDate" id="StartDateHidden" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
        <small class="text-muted d-block">لطفاً تاریخ شروع را انتخاب کنید</small>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate" class="form-label">تاریخ پایان <span class="text-danger">*</span></label>
        <input type="text" id="EndDateDisplay" class="form-control" placeholder="تاریخ پایان را انتخاب کنید" required />
        <input type="hidden" asp-for="EndDate" name="EndDate" id="EndDateHidden" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
        <small class="text-muted d-block">لطفاً تاریخ پایان را انتخاب کنید</small>
    </div>

    <div class="mb-3">
        <label asp-for="Goal" class="form-label">هدف اسپرینت</label>
        <textarea asp-for="Goal" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Goal" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">ایجاد اسپرینت</button>
        <a class="btn btn-secondary" href="/TaskPlanner/Sprints/Index">انصراف</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // تقویم فارسی برای تاریخ شروع
            $('#StartDateDisplay').persianDatepicker({
                format: 'YYYY/MM/DD',
                altField: '#StartDateHidden',
                altFormat: 'YYYY-MM-DD',
                observer: true,
                timePicker: {
                    enabled: false
                },
                autoClose: true,
                initialValue: true,
                initialValueType: 'persian',
                onSelect: function(unixDate) {
                    // Ensure hidden field is updated
                    const selectedDate = $(this).val();
                    if (selectedDate) {
                        $('#StartDateHidden').val(selectedDate);
                    }
                }
            });

            // تقویم فارسی برای تاریخ پایان
            $('#EndDateDisplay').persianDatepicker({
                format: 'YYYY/MM/DD',
                altField: '#EndDateHidden',
                altFormat: 'YYYY-MM-DD',
                observer: true,
                timePicker: {
                    enabled: false
                },
                autoClose: true,
                initialValue: true,
                initialValueType: 'persian',
                onSelect: function(unixDate) {
                    // Ensure hidden field is updated
                    const selectedDate = $(this).val();
                    if (selectedDate) {
                        $('#EndDateHidden').val(selectedDate);
                    }
                }
            });

            // Validate before form submission
            $('form').on('submit', function(e) {
                const startDate = $('#StartDateHidden').val();
                const endDate = $('#EndDateHidden').val();
                
                if (!startDate || startDate.trim() === '') {
                    alert('لطفاً تاریخ شروع را انتخاب کنید.');
                    e.preventDefault();
                    return false;
                }
                
                if (!endDate || endDate.trim() === '') {
                    alert('لطفاً تاریخ پایان را انتخاب کنید.');
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}

