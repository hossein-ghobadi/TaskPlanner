@model Endpoint.Site.Models.SprintCreateVm
@using DNTPersianUtils.Core
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h2>ایجاد اسپرینت جدید</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">نام اسپرینت</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">توضیحات</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label">پروژه</label>
        <input asp-for="ProjectId" type="hidden" />
        <input type="text" class="form-control" value="@ViewBag.ProjectName" readonly />
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label">تاریخ شروع <span class="text-danger">*</span></label>
        <input type="text" id="StartDateDisplay" class="form-control" autocomplete="off" />
        <input type="hidden" asp-for="StartDate" id="StartDate" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate" class="form-label">تاریخ پایان <span class="text-danger">*</span></label>
        <input type="text" id="EndDateDisplay" class="form-control" autocomplete="off" />
        <input type="hidden" asp-for="EndDate" id="EndDate" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Goal" class="form-label">هدف اسپرینت</label>
        <textarea asp-for="Goal" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Goal" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">ایجاد اسپرینت</button>
        <a class="btn btn-secondary" href="/TaskPlanner/Sprints/Index">انصراف</a>
    </div>
</form>

@section Scripts {
    <script>
        // تاریخ شروع
        $("#StartDateDisplay").persianDatepicker({
            format: 'YYYY/MM/DD',
            autoClose: true,
            altField: '#StartDate',
            altFormat: 'YYYY-MM-DD'
        });

        // تاریخ پایان
        $("#EndDateDisplay").persianDatepicker({
            format: 'YYYY/MM/DD',
            autoClose: true,
            altField: '#EndDate',
            altFormat: 'YYYY-MM-DD'
        });
    </script>
}

