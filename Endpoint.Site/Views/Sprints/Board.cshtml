                        async function sendMessage() {
                const messageInput = document.getElementById('messageInput');
                const taskId = document.getElementById('editTaskId').value;
                let message = messageInput.value.trim();
                const fileInput = document.getElementById('fileInput');

                // دیباگ: نمایش مقادیر
                console.log('TaskId:', taskId);
                console.log('Message:', message);
                console.log('Files:', fileInput.files.length);
                console.log('Token:', token);

                if (!taskId) {
                    alert('شناسه کار مشخص نیست');
                    return;
                }

                // اصلاح: اگر پیام خالی بود اما فایل وجود دارد، خطا نده
                if (!message && fileInput.files.length === 0) {
                    alert('پیام خالی است');
                    return;
                }

                const replyToCommentId = document.getElementById('replyToCommentId')?.value;
                if (replyToCommentId && replyContext) {
                    const replyMarker = `[[reply:${replyToCommentId}:${encodeURIComponent(replyContext.userName)}:${encodeURIComponent(replyContext.target)}]]`;
                    message = message ? `${replyMarker}\n${message}` : replyMarker;
                }

                const formData = new FormData();
                formData.append('TaskId', taskId);
                formData.append('Message', message);
                formData.append('__RequestVerificationToken', token);

                Array.from(fileInput.files || []).forEach((f) => formData.append('Attachments', f));

                try {
                    const response = await fetch('/Tasks/PostComment', {
                        method: 'POST',
                        body: formData
                    });

                    console.log('Response status:', response.status);
                    console.log('Response ok:', response.ok);

                    if (response.ok) {
                        messageInput.value = '';
                        fileInput.value = '';
                        document.getElementById('selectedFiles').innerHTML = '';
                        document.getElementById('audioPreview').innerHTML = '';
                        clearReplyContext();
                        loadComments();
                    } else {
                        const errorText = await response.text();
                        console.log('Error response:', errorText);
                        alert('خطا در ارسال پیام: ' + errorText);
                    }
                } catch (err) {
                    console.error('Fetch error:', err);
                    alert('خطا در ارتباط با سرور: ' + err.message);
                }
            }





