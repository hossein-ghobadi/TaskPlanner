                                         data-status-id="@status.Id"
                                         data-status-name="@status.Name"
                                         data-is-completed="@issue.IsCompleted.ToString().ToLower()"
                                         data-title="@issue.Title"
                                         data-assignee="@((issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "نامشخص"))"
                                         data-assignee-id="@(issue.AssignedUserId ?? "unassigned")"
                                         data-key="@issue.IssueKey"
                                         data-due="@dueDate?.ToString("o")"
                                         data-due-soon="@dueSoonFlag.ToString().ToLower()">

                                        <div class="task-card-header">
                                            <div class="task-actions">
                                                <span class="issue-type-icon" title="@issue.IssueTypeName">@issue.IssueTypeIcon</span>
                                                
                                                
                                                @if (Model.Status == SprintStatus.Active && status.Id != finalStatus.Id && !issue.IsCompleted)
                                                {
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                                type="button"
                                                                id="taskMenu-@issue.Id"
                                                                data-bs-toggle="dropdown"
                                                                aria-expanded="false"
                                                                onclick="event.stopPropagation(); event.preventDefault();"
                                                                title="عملیات بیشتر">
                                                            <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="taskMenu-@issue.Id">
                                                            
                                                            @if (finalStatus != null && status.Id != finalStatus.Id)
                                                            {
                                                                <li>
                                                                    <a class="dropdown-item complete-task-btn" href="#" onclick="event.stopPropagation(); event.preventDefault(); completeTask(@issue.Id);">
                                                                        <i class="bi bi-check-lg text-success me-2"></i>خاتمه کار
                                                                    </a>
                                                                </li>
                                                                @if (!issue.IsCompleted)
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" href="#" onclick="event.stopPropagation(); event.preventDefault(); removeTaskFromSprint(@issue.Id);">
                                                                            <i class="bi bi-x-circle text-warning me-2"></i>خارج کردن از اسپرینت
                                                                        </a>
                                                                    </li>
                                                                }
                                                            }
                                                            
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li>
                                                                <a class="dropdown-item text-danger" href="#" onclick="event.stopPropagation(); event.preventDefault(); deleteTask(@issue.Id, '@issue.Title');">
                                                                    <i class="bi bi-trash me-2"></i>حذف کار
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="task-title">

                                        <a href="#" onclick="event.stopPropagation(); event.preventDefault(); openEditTaskModal(@issue.Id); return false;">@issue.Title</a>
                                    </div>
                                        
                                        @if (!string.IsNullOrWhiteSpace(issue.Description))
                                        {
                                            <div class="task-description">@(issue.Description.Length > 100 ? issue.Description.Substring(0, 100) + "..." : issue.Description)</div>
                                        }
                                        <div class="task-footer">
                                            @if (!string.IsNullOrWhiteSpace(issue.AssignedUserId))
                                            {
                                                <span class="task-badge badge-assigned">
                                                    <i class="bi bi-person"></i>
                                                    @(issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "اختصاص داده شده")
                                                </span>
                                            }
                                            <small>@issue.DueDate.ToShortPersianDateString().ToPersianNumbers()</small>
                                        </div>
                                        
                                        <!-- دکمه‌های عملیات -->
                                        <div class="d-flex gap-2 mt-2" onclick="event.stopPropagation();">
                                            @if (finalStatus != null && status.Id != finalStatus.Id && !issue.IsCompleted)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success" onclick="completeTask(@issue.Id)" title="تکمیل کار">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteTask(@issue.Id, '@issue.Title')" title="حذف کار">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            }
                                            
                                        </div>

                                        @if (issue.ChildIssues.Count>0 )
                                        {
                                            <div class="subtasks-container mt-2" id="subtasks-@issue.Id" style="display: none; border-top: 1px solid #dee2e6; padding-top: 8px;">
                                                @foreach (var subtask in issue.ChildIssues.OrderBy(c => c.CreatedAt))
                                                {
                                                    <div class="subtask-item d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded" style="font-size: 0.85rem;">
                                                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                                                            <input type="checkbox"
                                                                   class="form-check-input task-complete-checkbox"
                                                                   id="task_@subtask.Id"
                                                                                            @(subtask.IsCompleted ? "checked" : "")
                                                                   onchange="toggleTaskComplete(@subtask.Id, this.checked)" />
                                                                                                          <a href="/Tasks/ToggleCompleteSubTask/@subtask.Id" class="btn btn-sm btn-outline-info p-0 px-1"
                                                                                   onclick="event.stopPropagation();"
                                                                                   title="جزئیات"
                                                                                   style="font-size: 0.7rem;">
                                                                                    <i class="bi bi-eye"></i>
                                                                                </a>
                                                                                                    <li>
                                                                                                                <a class="dropdown-item text-danger" href="#" onclick="event.stopPropagation(); event.preventDefault(); toggleSubtask(@subtask.Id);">
                                                                                                <i class="bi bi-trash me-2"></i>حذف کار
                                                                                            </a>
                                                                                        </li>
                                                                                                            
                                                            <div class="flex-grow-1">
                                                                <div class="fw-bold">@subtask.Title</div>
                                                                @if (!string.IsNullOrEmpty(subtask.Description))
                                                                {
                                                                    <small class="text-muted">@(subtask.Description.Length > 50 ? subtask.Description.Substring(0, 50) + "..." : subtask.Description)</small>
                                                                }
                                                            </div>
                                                        </div>
                                                        @*@if (Model.Status == SprintStatus.Active)
                                                        {
                                                            <div class="dropdown">
                                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle p-0 px-1"
                                                                        type="button"
                                                                        id="subtaskMenu-@subtask.Id"
                                                                        data-bs-toggle="dropdown"
                                                                        aria-expanded="false"
                                                                        onclick="event.stopPropagation(); event.preventDefault();"
                                                                        title="عملیات بیشتر"
                                                                        style="font-size: 0.7rem;">
                                                                    <i class="bi bi-three-dots-vertical"></i>
                                                                </button>
                                                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="subtaskMenu-@subtask.Id">
                                                                    <li>
                                                                        <a class="dropdown-item" href="#" onclick="event.stopPropagation(); event.preventDefault(); openEditTaskModal(@subtask.Id);">
                                                                            <i class="bi bi-pencil-square text-primary me-2"></i>ویرایش کار
                                                                        </a>
                                                                    </li>
                                                                    <li>

                                                                    <a class="dropdown-item" href="#" onclick="event.stopPropagation(); event.preventDefault(); openEditTaskModal(@issue.Id); return false;">@issue.Title</a>
                                                                    </li>
                                                                    @{
                                                                        var subtaskStatus = Model.Statuses.FirstOrDefault(s => s.Id == subtask.StatusId);
                                                                        var subtaskIsFinal = subtaskStatus != null && subtaskStatus.IsFinal;
                                                                    }
                                                                    @if (finalStatus != null && !subtaskIsFinal)
                                                                    {
                                                                        <li>
                                                                            <a class="dropdown-item complete-task-btn" href="#" onclick="event.stopPropagation(); event.preventDefault(); completeTask(@subtask.Id);">
                                                                                <i class="bi bi-check-lg text-success me-2"></i>خاتمه کار
                                                                            </a>
                                                                        </li>
                                                                    }
                                                                    <li><hr class="dropdown-divider"></li>
                                                                    <li>
                                                                        <a class="dropdown-item text-danger" href="#" onclick="event.stopPropagation(); event.preventDefault(); deleteTask(@subtask.Id, '@subtask.Title');">
                                                                            <i class="bi bi-trash me-2"></i>حذف کار
                                                                        </a>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <a href="/Tasks/Details/@subtask.Id" class="btn btn-sm btn-outline-info p-0 px-1"
                                                               onclick="event.stopPropagation();"
                                                               title="جزئیات"
                                                               style="font-size: 0.7rem;">
                                                                <i class="bi bi-eye"></i>
                                                            </a>
                                                        }*@
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-message text-muted text-center small p-4" role="status">
                                    <span class="column-empty-msg-inner">
                                        <i class="bi bi-inbox" aria-hidden="true"></i>
                                        <span>هیچ آیتمی وجود ندارد</span>
                                    </span>
                                </div>
                            }
                        </div>
                        <!-- افزودن کار درون‌خطی -->
                        @if (Model.Status == SprintStatus.Active)
                        {
                            <div class="board-column-add-wrap">
                                <button type="button" class="add-task-btn quick-add-column-btn board-inline-add-trigger" data-status-id="@status.Id" data-status-name="@status.Name">
                                    <i class="bi bi-plus"></i>
                                    <span>افزودن کار</span>
                                </button>
                                <div class="board-inline-add d-none" data-status-id="@status.Id" data-status-name="@status.Name" aria-hidden="true">
                                    <input type="text" class="form-control board-inline-add-input" maxlength="500" placeholder="عنوان کار را وارد کنید..." autocomplete="off" />
                                    <div class="board-inline-add-actions">
                                        <button type="button" class="btn btn-sm btn-board-inline-primary board-inline-add-submit">افزودن</button>
                                        <button type="button" class="btn btn-sm btn-board-inline-secondary board-inline-add-cancel">انصراف</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
    </div>

    <div class="backlog-panel" id="backlogPanel" aria-hidden="true">
        <div class="backlog-panel-header">
            <h3>
                <i class="bi bi-inbox"></i>
                بک لاگ
                <span class="badge bg-primary" id="backlogCountBadge">@backLog.Count.ToString().ToPersianNumbers()</span>
            </h3>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="showBoardView()">
                <i class="bi bi-kanban"></i> بازگشت به تخته
            </button>
        </div>
        <div class="backlog-tasks" id="tasks-backlog">
            @if (backLog.Any())
            {
                foreach (var issue in backLog)
                {
                    var dueDate = issue.DueDate;
                    var now = DateTime.UtcNow;
                    var dueSoonFlag = dueDate.HasValue && dueDate.Value >= now && dueDate.Value <= now.AddDays(3);
                    <div class="task-card"
                         onclick="handleCardClick(event, @issue.Id)"
                         data-issue-id="@issue.Id"
                         data-title="@issue.Title"
                         data-assignee="@((issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "نامشخص"))"
                         data-assignee-id="@(issue.AssignedUserId ?? "unassigned")"
                         data-key="@issue.IssueKey"
                         data-due="@dueDate?.ToString("o")"
                         data-due-soon="@dueSoonFlag.ToString().ToLower()">

                        <div class="task-card-header">
                            <div class="task-actions">
                                <span class="issue-type-icon" title="@issue.IssueTypeName">@issue.IssueTypeIcon</span>
                            </div>
                        </div>

                        <div class="task-title">
                            <a href="#" onclick="event.stopPropagation(); event.preventDefault(); openEditTaskModal(@issue.Id); return false;">@issue.Title</a>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(issue.Description))
                        {
                            <div class="task-description">@(issue.Description.Length > 100 ? issue.Description.Substring(0, 100) + "..." : issue.Description)</div>
                        }
                        <div class="task-footer">
                            @if (!string.IsNullOrWhiteSpace(issue.AssignedUserId))
                            {
                                <span class="task-badge badge-assigned">
                                    <i class="bi bi-person"></i>
                                    @(issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "اختصاص داده شده")
                                </span>
                            }
                            <small>@issue.CreatedAt.ToShortPersianDateString().ToPersianNumbers()</small>
                        </div>

                        <div class="d-flex gap-2 mt-2" onclick="event.stopPropagation();">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addTaskToSprint(@issue.Id)" title="افزودن به اسپرینت">
                                <i class="bi bi-plus-circle-fill"></i>
                                افزودن به اسپرینت
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-message text-muted text-center small p-4" role="status">
                    <span class="column-empty-msg-inner">
                        <i class="bi bi-inbox" aria-hidden="true"></i>
                        <span>هیچ آیتمی در بک لاگ وجود ندارد</span>
                    </span>
                </div>
            }
        </div>
    </div>
</div>

