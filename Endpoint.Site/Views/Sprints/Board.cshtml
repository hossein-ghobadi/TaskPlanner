        }

    /* دکمه بازگشت */
    .back-btn {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px 20px;
        color: #4b5563;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
