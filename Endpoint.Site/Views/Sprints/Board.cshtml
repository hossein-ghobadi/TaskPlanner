    /* بخش پیوست */
    .chat-container {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #dbe7ff;
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 640px;
    }

    .chat-header {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        padding: 16px 20px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .chat-header h5 {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .chat-count-badge {
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.28);
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        background: #f8fbff;
    }

    .chat-message {
        margin-bottom: 20px;
        animation: fadeInUp 0.3s ease;
        scroll-margin-top: 110px;
    }
    .chat-message.target-highlight {
        outline: 2px solid #60a5fa;
        border-radius: 10px;
        background: rgba(96, 165, 250, 0.12);
        transition: all 0.35s ease;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .chat-message.own {
        display: flex;
        justify-content: flex-end;
    }

    .chat-message.other {
        display: flex;
        justify-content: flex-start;
    }

    .message-bubble {
        max-width: 70%;
        padding: 12px 18px;
        border-radius: 18px;
        position: relative;
        word-wrap: break-word;
    }

        .message-bubble.own {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
            border-bottom-right-radius: 4px;
        }

        .message-bubble.other {
            background: white;
            color: #1f2937;
            border-bottom-left-radius: 4px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

    .message-card {
        width: min(100%, 460px);
        border-radius: 14px;
        border: 1px solid #dbe6ff;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(2, 6, 23, 0.06);
        padding: 10px 12px;
    }
    .chat-message.own .message-card {
        border-color: #bfdbfe;
        background: #f8fbff;
    }
