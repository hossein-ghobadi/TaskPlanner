@model Endpoint.Site.Models.SprintBoardVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var sprintId = ViewBag.SprintId as int?;
    var projectId = ViewBag.ProjectId as int?;
    var workflowStatuses = ViewBag.WorkflowStatuses as List<WorkflowStatus> ?? new List<WorkflowStatus>();
    var defaultStatus = Model.Statuses.FirstOrDefault(s => s.IsDefault) ?? Model.Statuses.FirstOrDefault();
    var defaultStatusName = defaultStatus?.Name ?? "ستون اول";
    var finalStatus = Model.Statuses.FirstOrDefault(s => s.IsFinal);
    var finalStatusName = finalStatus?.Name ?? "Done";
}

<style>
    .board-layout {
        display: grid;
        grid-template-columns: minmax(0, 4fr) minmax(260px, 1fr);
        gap: 1.5rem;
        margin-top: 1.5rem;
        direction: ltr;
    }
    .board-main {
        background: #fdfdfd;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(15,23,42,0.08);
        padding: 1.5rem;
        border: 1px solid #eef0f4;
        direction: rtl;
    }
    .board-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        direction: rtl;
    }
    .sidebar-card {
        background: linear-gradient(160deg, #ffffff 0%, #f0f4ff 120%);
        border-radius: 18px;
        padding: 1.25rem;
        border: 1px solid rgba(148,163,184,0.3);
        box-shadow: 0 8px 24px rgba(37,99,235,0.08);
    }
    .sidebar-card h5 {
        font-weight: 700;
    }
    .kanban-board {
        display: flex;
        gap: 1rem;
        padding: 1rem 0;
        width: 100%;
    }
    .kanban-column {
        flex: 1;
        min-width: 250px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }
    .kanban-column.column-dragging {
        opacity: 0.6;
    }
    .kanban-column.column-drop-target {
        outline: 2px dashed #2196f3;
        box-shadow: 0 0 0 2px rgba(33,150,243,0.2);
    }
    @@media (max-width: 992px) {
        .board-layout {
            grid-template-columns: 1fr;
        }
    }
    @@media (max-width: 768px) {
        .kanban-board {
            overflow-x: auto;
        }
        .kanban-column {
            min-width: 280px;
            flex: 0 0 280px;
        }
    }
    .kanban-column-header {
        padding: 12px;
        font-weight: bold;
        color: white;
        border-radius: 8px 8px 0 0;
        text-align: center;
        margin-bottom: 8px;
    }
    .kanban-column-body {
        padding: 8px;
        min-height: 400px;
        max-height: 70vh;
        overflow-y: auto;
    }
    .kanban-card {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 8px;
        cursor: grab;
        transition: all 0.2s;
    }
    .kanban-card:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        transform: translateY(-2px);
    }
    .kanban-card:active {
        cursor: grabbing;
    }
    .kanban-card.dragging {
        opacity: 0.5;
    }
    .issue-key {
        font-weight: bold;
        font-size: 0.85rem;
        color: #495057;
    }
    .issue-title {
        font-size: 0.9rem;
        margin: 6px 0;
        color: #212529;
    }
    .issue-meta {
        font-size: 0.75rem;
        color: #6c757d;
        margin-top: 6px;
    }
    .issue-type-icon {
        font-size: 1.2rem;
    }
    .drop-zone {
        min-height: 400px;
        display: flex;
        flex-direction: column;
        pointer-events: auto;
    }
    .drop-zone .empty-message {
        pointer-events: none;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .available-tasks-list {
        max-height: 70vh;
        overflow-y: auto;
        border-radius: 12px;
    }
    .available-task-item {
        border: 1px solid rgba(15,23,42,0.08);
        border-radius: 14px;
        padding: 0.9rem;
        background: #fff;
        margin-bottom: 0.7rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .available-task-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(15,23,42,0.08);
    }
    .quick-add-column-btn {
        border-radius: 999px;
        border: 1px solid rgba(37,99,235,0.2);
        padding: 0.15rem 0.5rem;
        background: rgba(37,99,235,0.08);
        color: #2563eb;
        transition: all 0.2s ease;
    }
    .quick-add-column-btn:hover {
        background: #2563eb;
        color: #fff;
        box-shadow: 0 6px 16px rgba(37,99,235,0.2);
    }
    .quick-task-card {
        border-radius: 20px;
        border: none;
        background: #ffffff;
        box-shadow: 0 15px 35px rgba(15,23,42,0.08);
        overflow: hidden;
    }
    .quick-task-card .card-header,
    #quickTaskModal .modal-header {
        background: linear-gradient(125deg, #2563eb, #4f46e5);
        color: #fff;
        padding: 1.25rem 1.5rem;
        border: none;
    }
    .quick-task-card label,
    #quickTaskModal label {
        font-weight: 600;
        color: #0f172a;
    }
    .helper-text {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 0.25rem;
    }
    .issue-type-chips {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .chip-option {
        border-radius: 999px;
        border: 1px solid #cbd5f5;
        padding: 0.35rem 1rem;
        background: #fff;
        color: #2563eb;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .chip-option.active {
        background: #2563eb;
        color: #fff;
        border-color: #1d4ed8;
        box-shadow: 0 6px 16px rgba(37,99,235,0.25);
    }
    .quick-task-meta {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        color: #94a3b8;
        font-size: 0.85rem;
    }
    .board-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 1rem;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 0.9rem 1.2rem;
        box-shadow: 0 6px 18px rgba(15,23,42,0.05);
    }
    .toolbar-input,
    .toolbar-select {
        border-radius: 999px;
        border: 1px solid #cbd5f5;
        padding: 0.45rem 1rem;
        min-width: 200px;
        background: #f8fbff;
    }
    .toolbar-input:focus,
    .toolbar-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,0.15);
    }
    .btn-toggle {
        border-radius: 999px;
        border: 1px solid #cbd5f5;
        background: #fff;
        color: #2563eb;
        padding: 0.4rem 1rem;
        transition: all 0.2s;
    }
    .btn-toggle.active {
        background: #2563eb;
        color: #fff;
        border-color: #1d4ed8;
        box-shadow: 0 6px 18px rgba(37,99,235,0.3);
    }
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 0.75rem;
        margin-bottom: 1rem;
    }
    .stat-card {
        border-radius: 16px;
        padding: 1rem;
        background: linear-gradient(145deg, #eff4ff, #ffffff);
        border: 1px solid #e0e7ff;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);
    }
    .stat-card h6 {
        font-size: 0.85rem;
        color: #64748b;
        margin-bottom: 0.4rem;
    }
    .stat-card .value {
        font-size: 1.4rem;
        font-weight: 700;
        color: #1e293b;
    }
    .stat-card small {
        color: #94a3b8;
    }
    .kanban-card[data-due-soon="true"] {
        border-color: #f97316;
        box-shadow: 0 0 0 1px rgba(249,115,22,0.2);
    }
    .kanban-card.filtered-out {
        opacity: 0.35;
        pointer-events: none;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">📋 تخته کانبان</h2>
        <p class="text-muted mb-0">
            <strong>اسپرینت:</strong> @Model.SprintName | 
            <strong>پروژه:</strong> <a href="/Projects/Details/@Model.ProjectId">@Model.ProjectName</a>
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status == SprintStatus.Active)
        {
            <form method="post" action="/Sprints/ChangeStatus" class="d-inline" id="completeSprintForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.SprintId" />
                <input type="hidden" name="status" value="@((int)SprintStatus.Completed)" />
                <button type="button" class="btn btn-danger" onclick="completeSprint()">
                    <i class="bi bi-check-circle"></i> خاتمه اسپرینت
                </button>
            </form>
        }
        @if (Model.Status != SprintStatus.Completed)
        {
            <button type="button"
                    class="btn btn-outline-success"
                    onclick="openAddStatusModal()">
                <i class="bi bi-columns-gap"></i> افزودن وضعیت
            </button>
        }
        <a class="btn btn-primary" href="/Projects/Details/@Model.ProjectId">
            <i class="bi bi-folder-open"></i> جزئیات پروژه
        </a>
        <a class="btn btn-outline-primary" href="/Projects/Index">
            <i class="bi bi-grid-3x3-gap"></i> پروژه‌ها
        </a>
    </div>
</div>

@if (Model.Status != SprintStatus.Completed)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 mt-3 rounded-pill px-4 py-2 shadow-sm">
        <i class="bi bi-info-circle fs-5"></i>
        <span>در طول اسپرینت می‌توانید ستون جدید اضافه کنید و با کشیدن سرستون هر وضعیت، ترتیب ستون‌ها را آزادانه تغییر دهید.</span>
    </div>
}


<div class="board-layout">
    <div class="board-main">
        <div class="stats-grid">
            <div class="stat-card">
                <h6>پیشرفت اسپرینت</h6>
                <div class="value">@Model.CompletionPercentage.ToString("F1")%</div>
                <small>از @Model.TotalTasks تسک</small>
            </div>
            <div class="stat-card">
                <h6>انجام شده</h6>
                <div class="value text-success">@Model.CompletedTasks</div>
                <small>تسک کامل شده</small>
            </div>
            <div class="stat-card">
                <h6>در حال انجام</h6>
                <div class="value text-primary">@Model.InProgressTasks</div>
                <small>تمرکز فعلی تیم</small>
            </div>
            <div class="stat-card">
                <h6>مسدود / معلق</h6>
                <div class="value text-danger">@Model.BlockedTasks</div>
                <small>نیازمند پیگیری</small>
            </div>
        </div>

        <div class="board-toolbar">
            <div class="flex-grow-1 d-flex gap-2">
                <div class="flex-grow-1">
                    <input type="text" id="boardSearchInput" class="form-control toolbar-input w-100" placeholder="جستجو در عنوان، مسئول یا کلید تسک">
                </div>
                <select id="statusFilterSelect" class="form-select toolbar-select">
                    <option value="all">همه ستون‌ها</option>
                    @foreach (var status in Model.Statuses.OrderBy(s => s.Order))
                    {
                        <option value="@status.Id">@status.Name</option>
                    }
                </select>
            </div>
            <button type="button" id="dueSoonToggle" class="btn btn-toggle">
                <i class="bi bi-alarm"></i> موعد نزدیک
            </button>
        </div>

        <div class="kanban-board" id="board" data-sprint-id="@Model.SprintId">
    @foreach (var status in Model.Statuses.OrderBy(s => s.Order))
    {
        <div class="kanban-column"
             ondragover="onDragOverColumn(event)"
             ondragenter="onDragEnter(event)"
             ondragleave="onDragLeave(event)"
             ondrop="onDropIssue(event, @status.Id)"
             data-status-id="@status.Id">
            <div class="kanban-column-header d-flex justify-content-between align-items-center gap-2"
                 style="background-color: @(status.Color ?? "#6c757d");"
                 draggable="@(Model.Status != SprintStatus.Completed ? "true" : "false")"
                 ondragstart="onColumnDragStart(event)"
                 ondragend="onColumnDragEnd(event)">
                <div class="d-flex align-items-center gap-2">
                    <span>@status.Name</span>
                    <span class="badge bg-light text-dark ms-1">
                        @{
                            var count = Model.SprintIssues.Count(t =>
                            (t.StatusId ?? (Model.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)) == status.Id);
                        }
                        @count
                    </span>
                </div>
                <div class="d-flex align-items-center gap-1">
                    @if (Model.Status == SprintStatus.Active)
                    {
                        <button type="button"
                                class="quick-add-column-btn"
                                data-status-id="@status.Id"
                                data-status-name="@status.Name"
                                title="افزودن سریع به این ستون">
                            <i class="bi bi-magic"></i>
                        </button>
                    }
                    @if (Model.Status != SprintStatus.Completed && !status.IsDefault && !status.IsFinal)
                    {
                        <button type="button"
                                class="btn btn-sm btn-light text-danger"
                                data-status-name="@status.Name"
                                title="حذف وضعیت"
                                onclick="event.preventDefault(); event.stopPropagation(); deleteStatus(@status.Id, this.dataset.statusName);">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="kanban-column-body drop-zone"
                 data-status-id="@status.Id">
                @{
                    var cards = Model.SprintIssues
                    .Where(t => (t.StatusId ?? (Model.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)) == status.Id)
                    .OrderBy(t => t.Priority)
                    .ToList();
                }
                @if (cards.Any())
                {
                    foreach (var issue in cards)
                    {
                        var dueDate = issue.DueDate;
                        var dueSoonFlag = dueDate.HasValue && dueDate.Value >= DateTime.UtcNow && dueDate.Value <= DateTime.UtcNow.AddDays(3);
                        <div class="kanban-card"
                             draggable="true"
                             ondragstart="onDragIssue(event, @issue.Id)"
                             onclick="handleCardClick(event, @issue.Id)"
                             data-issue-id="@issue.Id"
                             data-status-id="@status.Id"
                             data-status-name="@status.Name"
                             data-title="@issue.Title"
                             data-assignee="@((issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "نامشخص"))"
                             data-key="@issue.IssueKey"
                             data-due="@dueDate?.ToString("o")"
                             data-due-soon="@dueSoonFlag.ToString().ToLower()"
                             style="cursor: pointer;">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="issue-key">@issue.IssueKey</span>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="issue-type-icon" title="@issue.IssueTypeName">@issue.IssueTypeIcon</span>
                                    @if (Model.Status == SprintStatus.Active && finalStatus != null && status.Id != finalStatus.Id)
                                    {
                                        <button class="btn btn-sm btn-success p-0 px-1 complete-task-btn"
                                                onclick="event.stopPropagation(); event.preventDefault(); completeTask(@issue.Id);"
                                                title="خاتمه تسک"
                                                style="font-size: 0.7rem; line-height: 1;">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                    @if (Model.Status == SprintStatus.Active && issue.CanHaveChildren)
                                    {
                                        <button class="btn btn-sm btn-outline-primary p-0 px-1"
                                                onclick="event.stopPropagation(); event.preventDefault(); openAddSubtaskModal(@issue.Id, '@issue.IssueKey');"
                                                title="افزودن زیرتسک"
                                                style="font-size: 0.7rem; line-height: 1;">
                                            <i class="bi bi-plus-circle"></i>
                                        </button>
                                    }
                                    @if (Model.Status == SprintStatus.Active)
                                    {
                                        <button class="btn btn-sm btn-outline-warning p-0 px-1"
                                                onclick="event.stopPropagation(); event.preventDefault(); removeTaskFromSprint(@issue.Id);"
                                                title="خارج کردن از اسپرینت"
                                                style="font-size: 0.7rem; line-height: 1;">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger p-0 px-1"
                                                onclick="event.stopPropagation(); event.preventDefault(); deleteTask(@issue.Id, '@issue.Title');"
                                                title="حذف تسک"
                                                style="font-size: 0.7rem; line-height: 1;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="issue-title">@issue.Title</div>

                            <div class="issue-meta">
                                <div>👤 @(issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "نامشخص")</div>
                                @if (issue.DueDatePersian != "تعیین نشده")
                                {
                                    <div>🗓️ @issue.DueDatePersian</div>
                                }
                                @if (issue.StoryPoints.HasValue && issue.StoryPoints > 0)
                                {
                                    <div>⚡ @issue.StoryPoints SP</div>
                                }
                                @if (issue.ChildIssues != null && issue.ChildIssues.Any())
                                {
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <button class="btn btn-sm btn-outline-secondary p-0 px-2"
                                                onclick="event.stopPropagation(); event.preventDefault(); toggleSubtasks(@issue.Id);"
                                                style="font-size: 0.7rem;">
                                            <i class="bi bi-chevron-down" id="subtask-icon-@issue.Id"></i>
                                            @issue.ChildIssues.Count زیرتسک
                                        </button>
                                    </div>
                                }
                            </div>

                            @* نمایش زیرتسک‌ها *@
                            @if (issue.ChildIssues != null && issue.ChildIssues.Any())
                            {
                                <div class="subtasks-container mt-2" id="subtasks-@issue.Id" style="display: none; border-top: 1px solid #dee2e6; padding-top: 8px;">
                                    @foreach (var subtask in issue.ChildIssues.OrderBy(c => c.CreatedAt))
                                    {
                                        <div class="subtask-item d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded" style="font-size: 0.85rem;">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="issue-type-icon" style="font-size: 0.9rem;">@subtask.IssueTypeIcon</span>
                                                <div>
                                                    <div class="fw-bold">@subtask.IssueKey: @subtask.Title</div>
                                                    @if (!string.IsNullOrEmpty(subtask.Description))
                                                    {
                                                        <small class="text-muted">@(subtask.Description.Length > 50 ? subtask.Description.Substring(0, 50) + "..." : subtask.Description)</small>
                                                    }
                                                </div>
                                            </div>
                                            <div class="d-flex gap-1">
                                                <a href="/Tasks/Details/@subtask.Id" class="btn btn-sm btn-outline-info p-0 px-1"
                                                   onclick="event.stopPropagation();"
                                                   title="جزئیات"
                                                   style="font-size: 0.7rem;">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                @if (Model.Status == SprintStatus.Active)
                                                {
                                                    <button class="btn btn-sm btn-outline-danger p-0 px-1"
                                                            onclick="event.stopPropagation(); event.preventDefault(); deleteTask(@subtask.Id, '@subtask.Title');"
                                                            title="حذف زیرتسک"
                                                            style="font-size: 0.7rem;">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="empty-message text-muted text-center small p-4">
                        <i class="bi bi-inbox"></i><br>
                        هیچ آیتمی وجود ندارد
                    </div>
                }
            </div>
        </div>
    }
</div>
<!-- اطلاعات اسپرینت -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h5>اطلاعات اسپرینت</h5>
                <p><strong>نام:</strong> @Model.SprintName</p>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p><strong>توضیحات:</strong> @Model.Description</p>
                }
                @if (!string.IsNullOrEmpty(Model.Goal))
                {
                    <p><strong>هدف:</strong> @Model.Goal</p>
                }
                <p><strong>تاریخ شروع:</strong> @Model.StartDatePersian</p>
                <p><strong>تاریخ پایان:</strong> @Model.EndDatePersian</p>
                <p>
                    <strong>وضعیت:</strong> 
                    <span class="badge @(Model.Status == SprintStatus.Active ? "bg-success" : Model.Status == SprintStatus.Completed ? "bg-secondary" : "bg-warning")">
                        @(Model.Status == SprintStatus.Active ? "فعال" : Model.Status == SprintStatus.Completed ? "خاتمه یافته" : "در حال برنامه‌ریزی")
                    </span>
                </p>
            </div>
            <div class="col-md-6">
                <h5>آمار</h5>
                <div class="mb-3">
                    <h6>پیشرفت کلی</h6>
                    <div class="progress">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @Model.CompletionPercentage%" aria-valuenow="@Model.CompletionPercentage" aria-valuemin="0" aria-valuemax="100">
                            @Model.CompletionPercentage.ToString("F1")%
                        </div>
                    </div>
                </div>
                <ul class="list-group">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        کل تسک‌ها
                        <span class="badge bg-primary rounded-pill">@Model.TotalTasks</span>
                    </li>
                    @foreach (var status in workflowStatuses)
                    {
                        var taskCountForStatus = Model.SprintIssues.Count(t => t.StatusId == status.Id);
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span style="color: @status.Color;">@status.Name</span>
                            <span class="badge rounded-pill" style="background-color: @status.Color;">@taskCountForStatus</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
        </div>
    </div>

    <aside class="board-sidebar">
        @if (Model.Status == SprintStatus.Active)
        {
            <div class="sidebar-card">
