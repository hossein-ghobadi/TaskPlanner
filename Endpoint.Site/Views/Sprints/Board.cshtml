@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        let draggedIssueId = null;
        let draggedCard = null;
        let isDragging = false;
        let mouseDownX = 0;
        let mouseDownY = 0;
        let isColumnDragging = false;
        let draggedColumnElement = null;
        const projectId = @(projectId ?? 0);
        const sprintId = @(sprintId ?? 0);
        const canManageStatuses = @((Model.Status != SprintStatus.Completed).ToString().ToLower());
        const defaultStatusId = @(defaultStatus?.Id ?? 0);
        const defaultStatusName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaultStatusName));
        const finalStatusId = @(finalStatus?.Id ?? 0);
        const finalStatusName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalStatusName));
        let quickTaskTargetStatusId = defaultStatusId;
        let quickTaskTargetStatusName = defaultStatusName;
        const boardFilters = {
            text: '',
            status: 'all',
            dueSoon: false
        };

        function showNotification(message, type = 'success') {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const alertHtml = `
                <div class="alert ${alertClass} alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 9999; min-width: 300px;">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('body').append(alertHtml);
            
            setTimeout(() => {
                $('.alert').fadeOut(300, function() {
                    $(this).remove();
                });
            }, 3000);
        }

        function evaluateDueSoon(card) {
            const dueValue = card.dataset.due;
            if (!dueValue) {
                return false;
            }
            const dueDate = new Date(dueValue);
            if (Number.isNaN(dueDate.getTime())) {
                return false;
            }
            const now = new Date();
            const diffHours = (dueDate.getTime() - now.getTime()) / 36e5;
            return diffHours >= 0 && diffHours <= 72;
        }

        function applyBoardFilters() {
            const text = boardFilters.text.trim().toLowerCase();
            const status = boardFilters.status;
            const dueSoon = boardFilters.dueSoon;

            document.querySelectorAll('.task-card').forEach(card => {
                if (!card.dataset.initializedDue) {
                    card.dataset.initializedDue = 'true';
                    card.dataset.dueSoon = card.dataset.dueSoon === 'true' ? 'true' : (evaluateDueSoon(card) ? 'true' : 'false');
                } else if (dueSoon) {
                    card.dataset.dueSoon = evaluateDueSoon(card) ? 'true' : 'false';
                }

                const title = (card.dataset.title || '').toLowerCase();
                const assignee = (card.dataset.assignee || '').toLowerCase();
                const key = (card.dataset.key || '').toLowerCase();

                const matchesText = !text || title.includes(text) || assignee.includes(text) || key.includes(text);
                const matchesStatus = status === 'all' || card.dataset.statusId === status;
                const matchesDue = !dueSoon || card.dataset.dueSoon === 'true';

                const visible = matchesText && matchesStatus && matchesDue;
                card.classList.toggle('filtered-out', !visible);
            });
        }

        function scrollToStatusColumn(statusId) {
            if (!statusId || statusId === 'all') {
                return;
            }
            const column = document.querySelector(`.kanban-column[data-status-id="${statusId}"]`);
            column?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }

        function registerBoardFilterEvents() {
            const searchInput = document.getElementById('boardSearchInput');
            const statusSelect = document.getElementById('statusFilterSelect');
            const dueToggle = document.getElementById('dueSoonToggle');

            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    boardFilters.text = e.target.value || '';
                    applyBoardFilters();
                });
            }

            if (statusSelect) {
                statusSelect.addEventListener('change', (e) => {
                    boardFilters.status = e.target.value || 'all';
                    applyBoardFilters();
                    scrollToStatusColumn(boardFilters.status);
                });
            }

            if (dueToggle) {
                dueToggle.addEventListener('click', () => {
                    boardFilters.dueSoon = !boardFilters.dueSoon;
                    dueToggle.classList.toggle('active', boardFilters.dueSoon);
                    applyBoardFilters();
                });
            }
        }

        function setQuickTaskTarget(statusId, statusName) {
            quickTaskTargetStatusId = statusId || defaultStatusId;
            quickTaskTargetStatusName = statusName || defaultStatusName;
            const targetDisplay = document.getElementById('quickTaskTargetDisplay');
            if (targetDisplay) {
                targetDisplay.textContent = quickTaskTargetStatusName;
            }
        }

        async function openQuickTaskModalForStatus(statusId, statusName) {
            if (!statusId) {
                showNotification('ستون انتخاب‌شده معتبر نیست', 'error');
                return;
            }
            setQuickTaskTarget(statusId, statusName);
            const modalElement = document.getElementById('quickTaskModal');
            if (!modalElement) {
                return;
            }
            
            // بارگذاری issue types به صورت داینامیک
            const container = document.getElementById('issueTypeChipsContainer');
            if (container) {
                container.innerHTML = '<div class="text-muted small">در حال بارگذاری...</div>';
            }
            
            const issueTypes = await loadProjectIssueTypes();
            renderIssueTypeChips(issueTypes);
            
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalElement);
            modalInstance.show();
        }

        // دریافت ProjectIssueTypes به صورت داینامیک
        async function loadProjectIssueTypes() {
            if (!projectId) {
                console.error('ProjectId is not available');
                return [];
            }

            try {
                const response = await fetch(`/Sprints/GetProjectIssueTypes?projectId=${projectId}`);
                const data = await response.json();
                
                if (data.success && data.issueTypes) {
                    return data.issueTypes;
                } else {
                    console.error('Failed to load issue types:', data.message);
                    return [];
                }
            } catch (error) {
                console.error('Error loading issue types:', error);
                return [];
            }
        }

        // ساخت issue type chips به صورت داینامیک
        function renderIssueTypeChips(issueTypes) {
            const container = document.getElementById('issueTypeChipsContainer');
            const hiddenSelect = document.getElementById('quickTaskType');
            const projectIssueTypeIdInput = document.getElementById('quickTaskProjectIssueTypeId');
            
            if (!container) return;

            // فیلتر کردن فقط انواعی که می‌توانند به Sprint اضافه شوند
            const availableTypes = issueTypes.filter(type => 
                type.level === 'StoryLevel' && type.canAddToSprint
            );

            // اگر خالی بود، از همه Story-level types استفاده کن
            const finalTypes = availableTypes.length > 0 
                ? availableTypes 
                : issueTypes.filter(type => type.level === 'StoryLevel');

            // اگر هنوز خالی بود، از همه انواع استفاده کن (fallback)
            const typesToShow = finalTypes.length > 0 ? finalTypes : issueTypes;

            if (typesToShow.length === 0) {
                container.innerHTML = '<div class="text-danger small">هیچ نوع کاری یافت نشد</div>';
                return;
            }

            // پیدا کردن نوع پیش‌فرض (Task یا اولین گزینه)
            const defaultType = typesToShow.find(t => t.baseType === 'Task' && !t.isCustom) 
                               || typesToShow[0];

            // پاک کردن container
            container.innerHTML = '';
            hiddenSelect.innerHTML = '';

            // ساخت chips
            typesToShow.forEach((type, index) => {
                const isActive = defaultType && type.id === defaultType.id;
                
                // ساخت button chip
                const chipBtn = document.createElement('button');
                chipBtn.type = 'button';
                chipBtn.className = `chip-option ${isActive ? 'active' : ''}`;
                chipBtn.dataset.issueType = getIssueTypeEnumValue(type.baseType);
                chipBtn.dataset.projectIssueTypeId = type.id;
                chipBtn.innerHTML = `<span class="me-1">${type.icon || '📝'}</span> ${type.name}`;
                
                container.appendChild(chipBtn);

                // ساخت option برای select hidden
                const option = document.createElement('option');
                option.value = getIssueTypeEnumValue(type.baseType);
                option.dataset.projectIssueTypeId = type.id;
                option.textContent = `${type.icon || '📝'} ${type.name}`;
                if (isActive) {
                    option.selected = true;
                }
                hiddenSelect.appendChild(option);
            });

            // تنظیم مقدار پیش‌فرض
            if (defaultType && projectIssueTypeIdInput) {
                projectIssueTypeIdInput.value = defaultType.id;
            }

            // اضافه کردن event listeners
            initQuickAddTypeChips();
        }

        // تبدیل نام baseType به مقدار enum (مطابق با IssueType enum در C#)
        function getIssueTypeEnumValue(baseType) {
            const enumMap = {
                'Epic': 1,
                'Story': 2,
                'Task': 3,
                'Subtask': 4,
                'Bug': 5
            };
            return enumMap[baseType] !== undefined ? enumMap[baseType] : 3; // default: Task
        }

        function initQuickAddTypeChips() {
            const hiddenSelect = document.getElementById('quickTaskType');
            const projectIssueTypeIdInput = document.getElementById('quickTaskProjectIssueTypeId');
            const chipButtons = document.querySelectorAll('.issue-type-chips .chip-option');
            
            if (!hiddenSelect || !chipButtons.length) {
                return;
            }
            
            chipButtons.forEach(btn => {
                // حذف event listener قبلی (اگر وجود دارد)
                const newBtn = btn.cloneNode(true);
                btn.parentNode.replaceChild(newBtn, btn);
                
                newBtn.addEventListener('click', () => {
                    // دریافت دوباره همه دکمه‌ها از DOM (نه از متغیر قدیمی)
                    const allChipButtons = document.querySelectorAll('.issue-type-chips .chip-option');
                    allChipButtons.forEach(b => b.classList.remove('active'));
                    newBtn.classList.add('active');
                    hiddenSelect.value = newBtn.dataset.issueType;
                    
                    // تنظیم projectIssueTypeId
                    if (projectIssueTypeIdInput && newBtn.dataset.projectIssueTypeId) {
                        projectIssueTypeIdInput.value = newBtn.dataset.projectIssueTypeId;
                    } else if (projectIssueTypeIdInput) {
                        projectIssueTypeIdInput.value = '';
                    }
                });
            });
        }

        function resetQuickTaskTypeChips() {
            // این تابع دیگر استفاده نمی‌شود چون issue types به صورت داینامیک بارگذاری می‌شوند
            // اما برای سازگاری با کدهای قدیمی، آن را نگه می‌داریم
            const chipButtons = document.querySelectorAll('.issue-type-chips .chip-option');
            if (chipButtons.length > 0) {
                chipButtons.forEach(btn => btn.classList.remove('active'));
                chipButtons[0]?.classList.add('active');
                
                const hiddenSelect = document.getElementById('quickTaskType');
                const projectIssueTypeIdInput = document.getElementById('quickTaskProjectIssueTypeId');
                
                if (hiddenSelect && chipButtons[0]) {
                    hiddenSelect.value = chipButtons[0].dataset.issueType || hiddenSelect.value;
                }
                
                if (projectIssueTypeIdInput && chipButtons[0]?.dataset.projectIssueTypeId) {
                    projectIssueTypeIdInput.value = chipButtons[0].dataset.projectIssueTypeId;
                }
            }
        }

        function appendQuickTaskCard(task) {
            if (!task || !task.statusId) {
                return;
            }
            const columnBody = document.querySelector(`.kanban-column-body[data-status-id="${task.statusId}"]`);
            if (!columnBody) {
                return;
            }

            const emptyMessage = columnBody.querySelector('.empty-message');
            if (emptyMessage) {
                emptyMessage.remove();
            }

            const card = document.createElement('div');
            card.className = 'task-card';
            card.draggable = true;
            card.dataset.issueId = task.id;
            card.dataset.statusId = task.statusId;
            card.dataset.statusName = task.statusName || '';
            card.dataset.title = task.title || '';
            card.dataset.assignee = 'نامشخص';
            card.dataset.key = task.issueKey || '';
            card.dataset.due = '';
            card.dataset.dueSoon = 'false';
            card.addEventListener('dragstart', (e) => onDragIssue(e, task.id));
            card.addEventListener('click', (e) => handleCardClick(e, task.id));

            const safeTitle = escapeHtml(task.title || '');
            const safeKey = escapeHtml(task.issueKey || 'جدید');
            const deleteTitleArgument = (task.title || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");

            const canComplete = canManageStatuses && finalStatusId && task.statusId !== finalStatusId;
            const completeButtonHtml = canComplete ? `
                <button class="btn btn-sm btn-success complete-task-btn"
                        onclick="event.stopPropagation(); event.preventDefault(); completeTask(${task.id});"
                        title="خاتمه کار">
                    <i class="bi bi-check-lg"></i>
                </button>` : '';

            const actionButtons = canManageStatuses ? `
                ${completeButtonHtml}
                <button class="btn btn-sm btn-outline-warning"
                        onclick="event.stopPropagation(); event.preventDefault(); removeTaskFromSprint(${task.id});"
                        title="خارج کردن از اسپرینت">
                    <i class="bi bi-x-circle"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger"
                        onclick="event.stopPropagation(); event.preventDefault(); deleteTask(${task.id}, '${deleteTitleArgument}');"
                        title="حذف کار">
                    <i class="bi bi-trash"></i>
                </button>` : '';

            card.innerHTML = `
                <div class="task-card-header">
                    <span class="task-key">${safeKey}</span>
                    <div class="task-actions">
                        <span class="issue-type-icon" title="Task">🆕</span>
                        ${actionButtons}
                    </div>
                </div>
                <div class="task-title">
                    <a href="/Tasks/Details/${task.id}" onclick="event.stopPropagation();">${safeTitle}</a>
                </div>
                <div class="task-meta">
                    <div>👤 نامشخص</div>
                </div>
            `;

            columnBody.prepend(card);
            updateIssueCounts();
        }

        function escapeHtml(value) {
            return (value ?? '').toString()
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function ensureColumnHasEmptyMessage(columnBody) {
            if (!columnBody) return;
            if (columnBody.querySelector('.task-card')) {
                return;
            }
            let emptyMessage = columnBody.querySelector('.empty-message');
            if (!emptyMessage) {
                emptyMessage = document.createElement('div');
                emptyMessage.className = 'empty-message text-muted text-center small p-4';
                emptyMessage.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                columnBody.appendChild(emptyMessage);
            } else {
                emptyMessage.style.display = 'block';
            }
        }

        function moveCardToColumn(card, targetStatusId, targetStatusName) {
            if (!card || !targetStatusId) {
                return false;
            }
            const columnBody = document.querySelector(`.kanban-column-body[data-status-id="${targetStatusId}"]`);
            if (!columnBody) {
                return false;
            }

            const emptyMessage = columnBody.querySelector('.empty-message');
            if (emptyMessage) {
                emptyMessage.remove();
            }

            const sourceColumn = card.closest('.kanban-column-body');
            columnBody.prepend(card);
            card.dataset.statusId = targetStatusId;
            if (targetStatusName) {
                card.dataset.statusName = targetStatusName;
            }

            const completeBtn = card.querySelector('.complete-task-btn');
            if (completeBtn) {
                if (targetStatusId === finalStatusId) {
                    completeBtn.remove();
                }
            }

            if (sourceColumn && sourceColumn !== columnBody) {
                ensureColumnHasEmptyMessage(sourceColumn);
            }

            updateIssueCounts();
            return true;
        }

        async function postJson(url, payload) {
            let res;
            try {
                res = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(payload)
                });
            } catch (networkError) {
                throw new Error('خطا در ارتباط با سرور');
            }

            const text = await res.text();
            let data = null;

            if (text) {
                try {
                    data = JSON.parse(text);
                } catch (err) {
                    data = null;
                }
            }

            if (!res.ok || (data && data.success === false)) {
                throw new Error(data?.message || text || 'خطای ناشناخته');
            }

            return data || { success: true };
        }

        function resetDropZoneStyles() {
            document.querySelectorAll('.drop-zone').forEach(zone => {
                zone.style.backgroundColor = '';
                zone.style.borderColor = '';
            });
        }

        function highlightColumnTarget(column, isActive) {
            if (!column) return;
            if (isActive) {
                column.classList.add('column-drop-target');
            } else {
                column.classList.remove('column-drop-target');
            }
        }

        function onColumnDragStart(e) {
            if (!canManageStatuses) {
                e.preventDefault();
                return;
            }
            if (e.target.closest('button')) {
                e.preventDefault();
                return;
            }

            const column = e.currentTarget.closest('.kanban-column');
            if (!column) {
                return;
            }

            isColumnDragging = true;
            draggedColumnElement = column;
            column.classList.add('column-dragging');
            if (e.dataTransfer) {
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', 'column');
            }
        }

        function onColumnDragEnd() {
            if (draggedColumnElement) {
                draggedColumnElement.classList.remove('column-dragging');
                draggedColumnElement = null;
            }
            isColumnDragging = false;
            document.querySelectorAll('.kanban-column').forEach(col => col.classList.remove('column-drop-target'));
            resetDropZoneStyles();
        }

        function handleColumnDrop(targetColumn) {
            if (!isColumnDragging || !draggedColumnElement || !targetColumn || draggedColumnElement === targetColumn) {
                onColumnDragEnd();
                return;
            }

            const board = document.getElementById('board');
            if (!board) {
                onColumnDragEnd();
                return;
            }

            const columns = Array.from(board.children);
            const dragIndex = columns.indexOf(draggedColumnElement);
            const targetIndex = columns.indexOf(targetColumn);

            if (dragIndex === -1 || targetIndex === -1) {
                onColumnDragEnd();
                return;
            }

            if (targetIndex < dragIndex) {
                board.insertBefore(draggedColumnElement, targetColumn);
            } else {
                board.insertBefore(draggedColumnElement, targetColumn.nextElementSibling);
            }

            onColumnDragEnd();
            persistColumnOrder();
        }

        async function persistColumnOrder() {
            if (!canManageStatuses) {
                return;
            }

            const columns = document.querySelectorAll('.kanban-column');
            if (!columns.length) {
                return;
            }

            const statusOrders = Array.from(columns)
                .map((column, index) => ({
                    statusId: parseInt(column.dataset.statusId, 10),
                    order: index + 1
                }))
                .filter(item => !Number.isNaN(item.statusId));

            if (!statusOrders.length) {
                return;
            }

            try {
                const data = await postJson('/WorkflowStatus/UpdateOrder', {
                    sprintId: sprintId,
                    statusOrders: statusOrders
                });
                showNotification(data.message || 'ترتیب ستون‌ها ذخیره شد', 'success');
            } catch (error) {
                showNotification(error.message || 'خطا در ذخیره ترتیب ستون‌ها', 'error');
            }
        }

        function openAddStatusModal() {
            if (!canManageStatuses) {
                showNotification('اسپرینت تکمیل‌شده قابل ویرایش نیست', 'error');
                return;
            }

            const modalElement = document.getElementById('addStatusModal');
            if (!modalElement) {
                return;
            }

            const nameInput = document.getElementById('statusName');
            const descInput = document.getElementById('statusDescription');
            const colorInput = document.getElementById('statusColor');
            if (nameInput) nameInput.value = '';
            if (descInput) descInput.value = '';
            if (colorInput) {
                colorInput.value = '#0d6efd';
            }

            const modal = new bootstrap.Modal(modalElement);
            modal.show();
        }

        async function submitStatus() {
            if (!canManageStatuses) {
                showNotification('اسپرینت تکمیل‌شده قابل ویرایش نیست', 'error');
                return;
            }

            const nameInput = document.getElementById('statusName');
            const colorInput = document.getElementById('statusColor');
            const descInput = document.getElementById('statusDescription');
            if (!nameInput) {
                return;
            }

            const name = nameInput.value.trim();
            if (!name) {
                showNotification('نام وضعیت الزامی است', 'error');
                nameInput.focus();
                return;
            }

            const payload = {
                sprintId: sprintId,
                name: name,
                color: colorInput?.value,
                description: descInput?.value?.trim() || null
            };

            const submitBtn = document.getElementById('addStatusSubmitBtn');
            const originalText = submitBtn?.innerHTML;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> در حال ثبت...';
            }

            try {
                const data = await postJson('/WorkflowStatus/CreateInline', payload);
                showNotification(data.message || 'وضعیت جدید ایجاد شد', 'success');
                const modalElement = document.getElementById('addStatusModal');
                if (modalElement) {
                    bootstrap.Modal.getInstance(modalElement)?.hide();
                }
                setTimeout(() => location.reload(), 1000);
            } catch (error) {
                showNotification(error.message || 'خطا در ایجاد وضعیت', 'error');
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText || '<i class="bi bi-plus-circle"></i> ایجاد وضعیت';
                }
            }
        }

        async function deleteStatus(statusId, statusName = '') {
            if (!canManageStatuses) {
                showNotification('اسپرینت تکمیل‌شده قابل ویرایش نیست', 'error');
                return;
            }

            if (!statusId) {
                return;
            }

            const confirmed = confirm(`آیا از حذف وضعیت "${statusName || ''}" مطمئن هستید؟\nتمام کارهای این وضعیت به وضعیت شروع منتقل می‌شوند.`);
            if (!confirmed) {
                return;
            }

            try {
                const data = await postJson('/WorkflowStatus/DeleteInline', { statusId });
                showNotification(data.message || 'وضعیت حذف شد', 'success');
                setTimeout(() => location.reload(), 800);
            } catch (error) {
                showNotification(error.message || 'خطا در حذف وضعیت', 'error');
            }
        }

        function onDragIssue(e, issueId) {
            isDragging = true;
            draggedIssueId = issueId;
            draggedCard = e.currentTarget;
            draggedCard.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', issueId);
            draggedCard.style.height = `${draggedCard.offsetHeight}px`;
        }

        function handleCardClick(e, issueId) {
            // اگر drag در حال انجام است یا از دکمه/لینک کلیک شده، از redirect جلوگیری کن
            if (isDragging) {
                return;
            }
            if (draggedCard) {
                draggedCard.style.height = '';
            }
            // بررسی اینکه آیا از دکمه یا لینک کلیک شده یا نه
            if (e.target.closest('button') || e.target.closest('a')) {
                return;
            }
            // در غیر این صورت، به جزئیات کار برو
            window.location.href = '/Tasks/Details/' + issueId;
        }

        // ثبت موقعیت mouse down برای تشخیص drag vs click
        document.addEventListener('mousedown', function(e) {
            if (e.target.closest('.task-card')) {
                mouseDownX = e.clientX;
                mouseDownY = e.clientY;
            }
        });

        // بررسی اینکه آیا واقعاً drag شده یا فقط click
        document.addEventListener('mousemove', function(e) {
            if (mouseDownX !== 0 && mouseDownY !== 0) {
                const deltaX = Math.abs(e.clientX - mouseDownX);
                const deltaY = Math.abs(e.clientY - mouseDownY);
                // اگر بیش از 5 پیکسل حرکت کرده، drag است
                if (deltaX > 5 || deltaY > 5) {
                    isDragging = true;
                }
            }
        });

        // Reset موقعیت mouse بعد از mouse up
        document.addEventListener('mouseup', function(e) {
            if (!isDragging) {
                mouseDownX = 0;
                mouseDownY = 0;
            }
        });

        function getDropZoneElement(element) {
            if (!element) return null;
            return element.classList?.contains('drop-zone')
                ? element
                : element.querySelector?.('.drop-zone');
        }

        function onDragOverColumn(e) {
            if (isColumnDragging) {
                e.preventDefault();
                return;
            }
            e.preventDefault();
        }

        function highlightDropZone(element, isActive) {
            const zone = getDropZoneElement(element);
            if (!zone) return;
            if (isActive) {
                zone.style.backgroundColor = '#e3f2fd';
                zone.style.borderColor = '#2196f3';
            } else {
                zone.style.backgroundColor = '';
                zone.style.borderColor = '';
            }
        }

        function onDragEnter(e) {
            e.preventDefault();
            if (isColumnDragging) {
                highlightColumnTarget(e.currentTarget.closest('.kanban-column'), true);
                return;
            }
            highlightDropZone(e.currentTarget, true);
        }

        function onDragLeave(e) {
            if (isColumnDragging) {
                highlightColumnTarget(e.currentTarget.closest('.kanban-column'), false);
                return;
            }
            highlightDropZone(e.currentTarget, false);
        }

        async function onDropIssue(e, toStatusId) {
            e.preventDefault();
            if (isColumnDragging) {
                const columnElement = e.currentTarget.closest('.kanban-column');
                highlightColumnTarget(columnElement, false);
                handleColumnDrop(columnElement);
                return;
            }

            const dropZone = getDropZoneElement(e.currentTarget);
            if (dropZone) {
                highlightDropZone(dropZone, false);
            }
            
            const issueId = draggedIssueId || parseInt(e.dataTransfer.getData('text/plain'));
            if (!issueId) return;

            if (draggedCard) {
                draggedCard.style.opacity = '0.5';
            }

            try {
                const res = await fetch('/Tasks/MoveIssue', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ 
                        taskId: issueId, 
                        toStatusId: toStatusId,
                        reason: 'تماس از تخته کانبان'
                    })
                });

                if (!res.ok) {
                    const errorText = await res.text();
                    alert('خطا: ' + errorText || 'خطا در انتقال وضعیت');
                    if (draggedCard) {
                        draggedCard.style.opacity = '1';
                    }
                    return;
                }

                const result = await res.json();
                console.log('Success:', result);

                if (draggedCard) {
                    draggedCard.classList.remove('dragging');
                    draggedCard.style.opacity = '1';
                    
                    const sourceColumn = draggedCard.closest('.kanban-column-body');
                    
                    if (dropZone) {
                        const emptyMessage = dropZone.querySelector('.empty-message');
                        if (emptyMessage) {
                            emptyMessage.style.display = 'none';
                        }
                        
                        dropZone.appendChild(draggedCard);
                    }
                    
                    if (sourceColumn && sourceColumn !== dropZone) {
                        const sourceCards = sourceColumn.querySelectorAll('.task-card');
                        if (sourceCards.length === 0) {
                            const sourceEmptyMessage = sourceColumn.querySelector('.empty-message');
                            if (sourceEmptyMessage) {
                                sourceEmptyMessage.style.display = 'block';
                            } else {
                                const emptyMsg = document.createElement('div');
                                emptyMsg.className = 'empty-message text-muted text-center small p-4';
                                emptyMsg.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                                sourceColumn.appendChild(emptyMsg);
                            }
                        }
                    }
                    
                    updateIssueCounts();
                } else {
                    location.reload();
                }

            } catch (err) {
                console.error('Error:', err);
                alert('خطای شبکه: ' + err.message);
                if (draggedCard) {
                    draggedCard.style.opacity = '1';
                }
            } finally {
                draggedIssueId = null;
                draggedCard = null;
            }
        }

        async function completeTask(taskId) {
            if (!taskId) return;
            if (!finalStatusId) {
                showNotification('ستون نهایی برای این اسپرینت تعریف نشده است', 'error');
                return;
            }

            const card = document.querySelector(`.task-card[data-issue-id="${taskId}"]`);
            const previousOpacity = card ? card.style.opacity : null;
            if (card) {
                card.style.opacity = '0.5';
            }

            try {
                await postJson('/Tasks/MoveIssue', {
                    taskId: taskId,
                    toStatusId: finalStatusId,
                    reason: 'تکمیل از طریق دکمه'
                });

                const moved = moveCardToColumn(card, finalStatusId, finalStatusName);
                if (!moved) {
                    setTimeout(() => location.reload(), 500);
                } else {
                    showNotification('کار با موفقیت خاتمه یافت.', 'success');
                }
            } catch (error) {
                showNotification(error.message || 'خطا در خاتمه کار', 'error');
                if (card) {
                    card.style.opacity = previousOpacity ?? '1';
                }
            } finally {
                if (card) {
                    card.style.opacity = '1';
                }
            }
        }

        function updateIssueCounts() {
            document.querySelectorAll('.kanban-column').forEach(column => {
                const body = column.querySelector('.kanban-column-body');
                const count = body ? body.querySelectorAll('.task-card').length : 0;
                const badge = column.querySelector('.kanban-column-header .badge');
                if (badge) {
                    badge.textContent = count;
                }
            });
        }

        document.addEventListener('dragend', function() {
            if (isColumnDragging) {
                onColumnDragEnd();
                return;
            }
            isDragging = false;
            mouseDownX = 0;
            mouseDownY = 0;
            resetDropZoneStyles();
        });

        document.addEventListener('click', function(e) {
            const quickBtn = e.target.closest('.quick-add-column-btn');
            if (quickBtn) {
                e.preventDefault();
                e.stopPropagation();
                const statusId = parseInt(quickBtn.dataset.statusId, 10);
                openQuickTaskModalForStatus(statusId, quickBtn.dataset.statusName);
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            registerBoardFilterEvents();
            applyBoardFilters();
            const quickTaskModal = document.getElementById('quickTaskModal');
            if (quickTaskModal) {
                quickTaskModal.addEventListener('hidden.bs.modal', () => {
                    setQuickTaskTarget(defaultStatusId, defaultStatusName);
                    document.getElementById('quickTaskForm')?.reset();
                    // پاک کردن issue type chips برای بارگذاری مجدد در دفعه بعد
                    const container = document.getElementById('issueTypeChipsContainer');
                    if (container) {
                        container.innerHTML = '<div class="text-muted small">در حال بارگذاری...</div>';
                    }
                });
                
                // بارگذاری issue types هنگام باز شدن modal (برای اولین بار)
                quickTaskModal.addEventListener('show.bs.modal', async function() {
                    const container = document.getElementById('issueTypeChipsContainer');
                    if (container && container.innerHTML.includes('در حال بارگذاری')) {
                        const issueTypes = await loadProjectIssueTypes();
                        renderIssueTypeChips(issueTypes);
                    }
                });
            }
            
            // اسکرول به ستون و highlight کارت جدید بعد از reload
            const scrollToStatusId = sessionStorage.getItem('scrollToStatusAfterReload');
            const highlightTaskId = sessionStorage.getItem('highlightTaskAfterReload');
            
            if (scrollToStatusId) {
                setTimeout(function() {
                    const column = document.querySelector(`.kanban-column[data-status-id="${scrollToStatusId}"]`);
                    if (column) {
                        column.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                        
                        // highlight کارت جدید
                        if (highlightTaskId) {
                            const taskCard = document.querySelector(`.task-card[data-issue-id="${highlightTaskId}"]`);
                            if (taskCard) {
                                taskCard.style.transition = 'all 0.3s ease';
                                taskCard.style.boxShadow = '0 0 20px rgba(37, 99, 235, 0.6)';
                                taskCard.style.transform = 'scale(1.02)';
                                
                                setTimeout(function() {
                                    taskCard.style.boxShadow = '';
                                    taskCard.style.transform = '';
                                }, 2000);
                            }
                        }
                    }
                    
                    // پاک کردن sessionStorage
                    sessionStorage.removeItem('scrollToStatusAfterReload');
                    sessionStorage.removeItem('highlightTaskAfterReload');
                }, 300);
            }
        });

        // بارگذاری کارهای موجود (فقط برای اسپرینت فعال)
        @if (Model.Status == SprintStatus.Active)
        {
            <text>
            function loadAvailableTasks() {
                $.ajax({
                    url: '/Sprints/GetProjectTasks',
                    type: 'GET',
                    data: { projectId: projectId, sprintId: sprintId },
                    success: function(response) {
                        if (response.success) {
                            displayAvailableTasks(response.tasks);
                        } else {
                            $('#availableTasksContainer').html('<p class="text-muted">خطا در بارگذاری کارها: ' + response.message + '</p>');
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#availableTasksContainer').html('<p class="text-danger">خطا در ارتباط با سرور: ' + error + '</p>');
                    }
                });
            }

            let selectedTaskId = null;
            let clickTimeout = null;

            function displayAvailableTasks(tasks) {
                const container = $('#availableTasksContainer');
                
                if (tasks.length === 0) {
                    container.html('<div class="empty-message"><i class="bi bi-inbox"></i><br>کار قابل اضافه شدن وجود ندارد</div>');
                    return;
                }

                let html = '';
                tasks.forEach(task => {
                    html += `
                        <div class="available-task-item" data-task-id="${task.id}">
                            <div class="available-task-title">
                                <a href="/Tasks/Details/${task.id}" onclick="event.stopPropagation();">${escapeHtml(task.title || 'بدون عنوان')}</a>
                            </div>
                            <div class="available-task-meta">${escapeHtml(task.categoryName ?? 'بدون دسته')} • ${escapeHtml(task.assignedUserName ?? 'تخصیص نیافته')}</div>
                        </div>
                    `;
                });
                
                container.html(html);
                
                // اضافه کردن event listener برای انتخاب با یک کلیک
                container.off('click', '.available-task-item').on('click', '.available-task-item', function(e) {
                    e.stopPropagation();
                    const taskId = $(this).data('task-id');
                    if (!taskId) return;
                    
                    const taskItem = $(this);
                    
                    // اگر همان کار قبلی انتخاب شده بود، با دوبار کلیک اضافه کن
                    if (selectedTaskId === taskId) {
                        clearTimeout(clickTimeout);
                        addTaskToSprint(taskId);
                        selectedTaskId = null;
                        $('.available-task-item').removeClass('selected');
                    } else {
                        // انتخاب کار جدید
                        clearTimeout(clickTimeout);
                        $('.available-task-item').removeClass('selected');
                        taskItem.addClass('selected');
                        selectedTaskId = taskId;
                        
                        // اگر بعد از 2 ثانیه کلیک دیگری نشد، انتخاب را لغو کن
                        clickTimeout = setTimeout(() => {
                            $('.available-task-item').removeClass('selected');
                            selectedTaskId = null;
                        }, 2000);
                    }
                });
            }

            let addingTaskInProgress = false;
            
            function addTaskToSprint(taskId) {
                // جلوگیری از دوبار کلیک
                if (addingTaskInProgress) {
                    return;
                }
                
                addingTaskInProgress = true;
                
                // غیرفعال کردن کارت در حال اضافه شدن
                const taskItem = $(`.available-task-item[data-task-id="${taskId}"]`);
                taskItem.css('opacity', '0.5').css('pointer-events', 'none');
                
                $.ajax({
                    url: '/Sprints/AddTaskToSprint',
                    type: 'POST',
                    data: { sprintId: sprintId, taskId: taskId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        addingTaskInProgress = false;
                        if (response.success) {
                            showNotification('کار با موفقیت به اسپرینت اضافه شد', 'success');
                            selectedTaskId = null;
                            $('.available-task-item').removeClass('selected');
                            loadAvailableTasks();
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showNotification('خطا: ' + response.message, 'error');
                            taskItem.css('opacity', '1').css('pointer-events', 'auto');
                        }
                    },
                    error: function() {
                        addingTaskInProgress = false;
                        showNotification('خطا در ارتباط با سرور', 'error');
                        taskItem.css('opacity', '1').css('pointer-events', 'auto');
                    }
                });
            }

            function removeTaskFromSprint(taskId) {
                if (!confirm('آیا مطمئن هستید که می‌خواهید این کار را از اسپرینت خارج کنید؟')) {
                    return;
                }

                $.ajax({
                    url: '/Sprints/RemoveTaskFromSprint',
                    type: 'POST',
                    data: { sprintId: sprintId, taskId: taskId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            showNotification('کار با موفقیت از اسپرینت خارج شد', 'success');
                            // حذف کارت از صفحه
                            const card = document.querySelector(`.task-card[data-issue-id="${taskId}"]`);
                            if (card) {
                                card.style.transition = 'opacity 0.3s';
                                card.style.opacity = '0';
                                setTimeout(() => {
                                    const column = card.closest('.kanban-column-body');
                                    card.remove();
                                    updateIssueCounts();
                                    
                                    // نمایش پیام خالی اگر ستون خالی شد
                                    const remainingCards = column.querySelectorAll('.task-card');
                                    if (remainingCards.length === 0) {
                                        const emptyMsg = document.createElement('div');
                                        emptyMsg.className = 'empty-message text-muted text-center small p-4';
                                        emptyMsg.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                                        column.appendChild(emptyMsg);
                                    }
                                }, 300);
                            }
                            // بارگذاری مجدد کارهای موجود
                            loadAvailableTasks();
                        } else {
                            showNotification('خطا: ' + response.message, 'error');
                        }
                    },
                    error: function() {
                        showNotification('خطا در ارتباط با سرور', 'error');
                    }
                });
            }

            $(document).ready(function() {
                loadAvailableTasks();
            });

            // باز کردن Modal افزودن Subtask
            function openAddSubtaskModal(parentId, parentKey) {
                $('#subtaskParentId').val(parentId);
                $('#subtaskParentKey').val(parentKey);
                $('#subtaskTitle').val('');
                $('#subtaskCategory').val('');
                const modal = new bootstrap.Modal(document.getElementById('addSubtaskModal'));
                modal.show();
            }

            // ارسال درخواست ایجاد Subtask
            function submitSubtask() {
                const parentId = $('#subtaskParentId').val();
                const title = $('#subtaskTitle').val().trim();
                const categoryId = $('#subtaskCategory').val();

                if (!title) {
                    showNotification('عنوان زیرکار الزامی است', 'error');
                    return;
                }

                const data = {
                    parentId: parseInt(parentId),
                    title: title
                };

                if (categoryId) {
                    data.categoryId = parseInt(categoryId);
                }

                // نمایش loading
                const submitBtn = $('button[onclick="submitSubtask()"]');
                const originalText = submitBtn.html();
                submitBtn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> در حال ایجاد...');

                $.ajax({
                    url: '/Tasks/AddChildIssue',
                    type: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify(data),
                    success: function(response) {
                        if (response.success) {
                            showNotification(response.message || 'زیرکار با موفقیت ایجاد شد', 'success');
                            // بستن Modal
                            bootstrap.Modal.getInstance(document.getElementById('addSubtaskModal')).hide();
                            // بارگذاری مجدد صفحه برای نمایش زیرکار جدید
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showNotification('خطا: ' + (response.message || 'خطا در ایجاد زیرکار'), 'error');
                            submitBtn.prop('disabled', false).html(originalText);
                        }
                    },
                    error: function(xhr) {
                        let errorMsg = 'خطا در ارتباط با سرور';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            errorMsg = xhr.responseText;
                        }
                        showNotification('خطا: ' + errorMsg, 'error');
                        submitBtn.prop('disabled', false).html(originalText);
                    }
                });
            }

            // نمایش/مخفی کردن زیرکارها
            function toggleSubtasks(issueId) {
                const container = document.getElementById(`subtasks-${issueId}`);
                const icon = document.getElementById(`subtask-icon-${issueId}`);
                
                if (container.style.display === 'none') {
                    container.style.display = 'block';
                    icon.className = 'bi bi-chevron-up';
                } else {
                    container.style.display = 'none';
                    icon.className = 'bi bi-chevron-down';
                }
            }

            // حذف کار یا زیرکار
            function deleteTask(taskId, taskTitle) {
                if (!confirm(`آیا مطمئن هستید که می‌خواهید کار "${taskTitle}" را حذف کنید؟\n\nاین عمل قابل بازگشت نیست و تمام زیرکارهای آن نیز حذف خواهند شد.`)) {
                    return;
                }

                $.ajax({
                    url: '/Tasks/DeleteTask',
                    type: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({ taskId: taskId }),
                    success: function(response) {
                        if (response.success) {
                            showNotification(response.message || 'کار با موفقیت حذف شد', 'success');
                        } else {
                            showNotification('خطا: ' + (response.message || 'خطا در حذف کار'), 'error');
                            return;
                        }
                        // حذف کارت از صفحه
                        const card = document.querySelector(`.task-card[data-issue-id="${taskId}"]`);
                        const subtaskItem = document.querySelector(`.subtask-item`);
                        
                        if (card) {
                            card.style.transition = 'opacity 0.3s';
                            card.style.opacity = '0';
                            setTimeout(() => {
                                const column = card.closest('.kanban-column-body');
                                card.remove();
                                updateIssueCounts();
                                
                                const remainingCards = column.querySelectorAll('.task-card');
                                if (remainingCards.length === 0) {
                                    const emptyMsg = document.createElement('div');
                                    emptyMsg.className = 'empty-message text-muted text-center small p-4';
                                    emptyMsg.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                                    column.appendChild(emptyMsg);
                                }
                            }, 300);
                        } else if (subtaskItem && subtaskItem.closest(`[data-issue-id]`)) {
                            // اگر زیرکار حذف شد، صفحه را refresh کن
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            // اگر کارت پیدا نشد، صفحه را refresh کن
                            setTimeout(() => location.reload(), 1000);
                        }
                    },
                    error: function(xhr) {
                        let errorMsg = 'خطا در ارتباط با سرور';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            errorMsg = xhr.responseText;
                        }
                        showNotification('خطا: ' + errorMsg, 'error');
                    }
                });
            }

            // فرم ایجاد کار سریع
            $('#quickTaskForm').on('submit', function(e) {
                e.preventDefault();
                
                const title = $('#quickTaskTitle').val().trim();
                if (!title) {
                    showNotification('عنوان کار الزامی است', 'error');
                    return;
                }

                if (!quickTaskTargetStatusId) {
                    showNotification('ابتدا ستونی را برای افزودن کار انتخاب کنید', 'error');
                    return;
                }

                const issueType = parseInt($('#quickTaskType').val());
                const categoryId = $('#quickTaskCategory').val();
                const projectIssueTypeId = $('#quickTaskProjectIssueTypeId').val();
                
                const data = {
                    sprintId: sprintId,
                    title: title,
                    issueType: issueType,
                    statusId: quickTaskTargetStatusId
                };
                
                if (projectIssueTypeId) {
                    data.projectIssueTypeId = parseInt(projectIssueTypeId);
                }
                
                if (categoryId) {
                    data.categoryId = parseInt(categoryId);
                }

                // نمایش loading
                const submitBtn = $(this).find('button[type="submit"]');
                const originalText = submitBtn.html();
                submitBtn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> در حال ایجاد...');

                $.ajax({
                    url: '/Sprints/CreateQuickTask',
                    type: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify(data),
                    success: function(response) {
                        if (response.success) {
                            showNotification(response.message, 'success');
                            const modalElement = document.getElementById('quickTaskModal');
                            if (modalElement) {
                                bootstrap.Modal.getInstance(modalElement)?.hide();
                            }
                            $('#quickTaskTitle').val('');
                            $('#quickTaskCategory').val('');
                            resetQuickTaskTypeChips();
                            
                            // ذخیره اطلاعات برای scroll بعد از reload
                            const targetStatusId = response.statusId || quickTaskTargetStatusId;
                            sessionStorage.setItem('scrollToStatusAfterReload', targetStatusId.toString());
                            sessionStorage.setItem('highlightTaskAfterReload', response.taskId.toString());
                            
                            // رفرش بهینه صفحه با تاخیر کوتاه برای نمایش پیام موفقیت
                            setTimeout(function() {
                                window.location.reload();
                            }, 800);
                        } else {
                            showNotification('خطا: ' + response.message, 'error');
                            submitBtn.prop('disabled', false).html(originalText);
                            return;
                        }
                        submitBtn.prop('disabled', false).html(originalText);
                    },
                    error: function(xhr) {
                        const errorMsg = xhr.responseJSON?.message || 'خطا در ارتباط با سرور';
                        showNotification('خطا: ' + errorMsg, 'error');
                        submitBtn.prop('disabled', false).html(originalText);
                    }
                });
            });

            // خاتمه اسپرینت
            function completeSprint() {
                const confirmMsg = `آیا مطمئن هستید که می‌خواهید این اسپرینت را خاتمه دهید؟\n\n` +
                    `این عمل باعث می‌شود:\n` +
                    `✓ اسپرینت به حالت "خاتمه یافته" تغییر کند\n` +
                    `✓ تمام کارهای Done به صورت خودکار تکمیل شوند\n` +
                    `✓ به صفحه جزئیات پروژه هدایت شوید`;
                
                if (confirm(confirmMsg)) {
                    // ارسال فرم
                    document.getElementById('completeSprintForm').submit();
                }
            }
            </text>
        }
    </script>
}
