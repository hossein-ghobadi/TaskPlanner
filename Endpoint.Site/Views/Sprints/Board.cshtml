                <i class="bi bi-inbox"></i> بک لاگ
                <span class="badge bg-primary ms-1" id="backlogToggleBadge">@backLog.Count.ToString().ToPersianNumbers()</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="showBoardBtn" onclick="showBoardView()" style="display: none;">
                <i class="bi bi-kanban"></i> نمایش تخته
            </button>
        </div>
    </div>

    <!-- ستون‌های تخته -->
    <div class="board-columns" id="boardColumns">
       

        <div class="kanban-board" id="board" data-sprint-id="@Model.SprintId">


                @foreach (var status in Model.Statuses.OrderBy(s => s.Order))
                {
                    <div class="kanban-column"
                         ondragover="onDragOverColumn(event)"
                         ondragenter="onDragEnter(event)"
                         ondragleave="onDragLeave(event)"
