@model Endpoint.Site.Models.SprintBoardVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@using DNTPersianUtils.Core
@using System.Globalization
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{

    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["UseFluidLayout"] = true;
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var sprintId = ViewBag.SprintId as int?;
    var projectId = ViewBag.ProjectId as int?;
    var noActiveSprintBoard = ViewBag.NoActiveSprint as bool? == true;
    var hasPlanningSprint = ViewBag.HasPlanningSprint as bool? == true;
    var planningSprintId = ViewBag.PlanningSprintId as int?;
    var openCreateFromProjectBoard = ViewBag.OpenCreateSprintModal as bool? == true;
    // تاریخ شمسی با ارقام لاتین — persian-datepicker ورودی با ارقام فارسی را اشتباه پارس می‌کند
    var jalaliCal = new PersianCalendar();
    DateTime todayIran = DateTime.Today;
    try
    {
        var tz = TimeZoneInfo.FindSystemTimeZoneById("Iran Standard Time");
        todayIran = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tz).Date;
    }
    catch
    {
        try { todayIran = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "Asia/Tehran").Date; }
        catch { /* DateTime.Today */ }
    }

    string JalaliLatin(DateTime dt) =>
        $"{jalaliCal.GetYear(dt):0000}/{jalaliCal.GetMonth(dt):00}/{jalaliCal.GetDayOfMonth(dt):00}";

    var defaultStartPersianSprint = JalaliLatin(todayIran);
    var defaultEndPersianSprint = JalaliLatin(todayIran.AddDays(14));
    var workflowStatuses = ViewBag.WorkflowStatuses as List<WorkflowStatus> ?? new List<WorkflowStatus>();
    var defaultStatus = Model.Statuses.FirstOrDefault(s => s.IsDefault) ?? Model.Statuses.FirstOrDefault();
    var defaultStatusName = defaultStatus?.Name ?? "ستون اول";
    var finalStatus = Model.Statuses.FirstOrDefault(s => s.IsFinal);
    var finalStatusName = finalStatus?.Name ?? "Done";

    // دریافت ProjectIssueTypes برای Quick Task form
    var viewBagValue = ViewBag.ProjectIssueTypes;
    var projectIssueTypes = viewBagValue as List<ProjectIssueType> ?? new List<ProjectIssueType>();

    var backLog = ViewBag.backLog as List<TaskItem> ?? new List<TaskItem>();
    // Debug: بررسی ViewBag
    var viewBagType = viewBagValue?.GetType().Name ?? "null";
    var viewBagIsList = viewBagValue is List<ProjectIssueType>;
    var viewBagCount = (viewBagValue as List<ProjectIssueType>)?.Count ?? 0;

    // Debug: نمایش اطلاعات ProjectIssueTypes
    var debugInfo = new
    {
        ViewBagType = viewBagType,
        ViewBagIsList = viewBagIsList,
        ViewBagCount = viewBagCount,
        TotalProjectIssueTypes = projectIssueTypes.Count,
        StoryLevelTypes = projectIssueTypes.Where(pit => pit.Level == IssueTypeLevel.StoryLevel).Count(),
        CanAddToSprintTypes = projectIssueTypes.Where(pit => pit.CanAddToSprint).Count(),
        AllTypes = projectIssueTypes.Select(pit => new { 
            Name = pit.Name, 
            Level = pit.Level.ToString(), 
            CanAddToSprint = pit.CanAddToSprint,
            BaseType = pit.BaseType.ToString()
        }).ToList()
    };

    // فقط انواعی که می‌توانند به Sprint اضافه شوند (Story-level types)
    // اول از CanAddToSprint استفاده می‌کنیم، اگر خالی بود از Level استفاده می‌کنیم
    var availableIssueTypes = projectIssueTypes
        .Where(pit => pit.Level == IssueTypeLevel.StoryLevel)
        .Where(pit => pit.CanAddToSprint)
        .OrderBy(pit => pit.Order)
        .ToList();

    // اگر هنوز خالی بود، از همه Story-level types استفاده کن (برای پروژه‌های قدیمی)
    if (!availableIssueTypes.Any())
    {
        availableIssueTypes = projectIssueTypes
            .Where(pit => pit.Level == IssueTypeLevel.StoryLevel)
            .OrderBy(pit => pit.Order)
            .ToList();
    }

    // نوع پیش‌فرض: Task یا اولین گزینه موجود
    var defaultIssueType = availableIssueTypes.FirstOrDefault(pit => pit.BaseType == IssueType.Task && !pit.IsCustom) 
                           ?? availableIssueTypes.FirstOrDefault();
    var projectMembersForBoard = (ViewBag.ProjectMembers as List<ProjectMemberVm> ?? new List<ProjectMemberVm>())
        .Select(m => new { id = m.UserId, name = m.FullName ?? m.UserName })
        .ToList();
    var boardTodayPersian = DateTime.Today.ToShortPersianDateString();
    var sprintIsActive = Model.Status == SprintStatus.Active;
}

