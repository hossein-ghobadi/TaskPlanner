                <h2>@Model.SprintName</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted mb-2">@Model.Description</p>
                }
                <div class="d-flex gap-3 align-items-center">
                    <small class="text-muted">
                        <i class="bi bi-person"></i>
                        سازنده: @creatorName
                    </small>
                    <small class="text-muted">
                        <i class="bi bi-folder"></i>
                        پروژه: <a href="/Projects/Details/@Model.ProjectId" class="text-decoration-none">@Model.ProjectName</a>
                    </small>
                    <small class="text-muted">
                        <i class="bi bi-list-task"></i>
                        @Model.TotalTasks.ToString().ToPersianNumbers() کار
                    </small>
                    <small class="text-muted">
                        <i class="bi bi-check-circle"></i>
                        @Model.CompletedTasks.ToString().ToPersianNumbers() انجام شده
                    </small>
                </div>
            </div>
            <div class="d-flex flex-column align-items-end gap-2">
                <div class="d-flex gap-2 flex-wrap justify-content-end board-header-actions">
