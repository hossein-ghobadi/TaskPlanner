                    console.log('Response ok:', response.ok);

                    if (response.ok) {
                        messageInput.value = '';
                        fileInput.value = '';
                        document.getElementById('selectedFiles').innerHTML = '';
                        document.getElementById('audioPreview').innerHTML = '';
                        loadComments();
                    } else {
                        const errorText = await response.text();
                        console.log('Error response:', errorText);
                        alert('خطا در ارسال پیام: ' + errorText);
                    }
                } catch (err) {
                    console.error('Fetch error:', err);
                    alert('خطا در ارتباط با سرور: ' + err.message);
                }
            }
            
            // حذف پیام (اختیاری)
         // حذف کامنت
    async function deleteComment(commentId, triggerElement) {
        if (!confirm('آیا مطمئن هستید که می‌خواهید این پیام را حذف کنید؟')) {
            return;
        }

        let previousContent = '';
        if (triggerElement) {
            previousContent = triggerElement.innerHTML;
            triggerElement.style.pointerEvents = 'none';
            triggerElement.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
        }
        
        try {
            const formData = new FormData();
            formData.append('commentId', commentId);
            formData.append('__RequestVerificationToken', token);
            
            const response = await fetch('/Tasks/DeleteComment', {
                method: 'POST',
                body: formData
            });
            
            if (response.ok) {
                document.getElementById(`comment-${commentId}`)?.remove();
                
                const count = parseInt(document.getElementById('commentCount').textContent);
                document.getElementById('commentCount').textContent = Math.max(0, count - 1);
                
                const chatBox = document.getElementById('chatBox');
                if (chatBox.children.length === 0) {
                    chatBox.innerHTML = `
                        <div class="empty-state">
                            <i class="bi bi-chat-left"></i>
                            <p>هنوز پیامی ارسال نشده است.</p>
                        </div>
                    `;
                }
            }
        } catch (error) {
            console.error('خطا در حذف پیام:', error);
            alert('خطا در حذف پیام');
        } finally {
            if (triggerElement && document.body.contains(triggerElement)) {
                triggerElement.style.pointerEvents = '';
                triggerElement.innerHTML = previousContent || '<i class="bi bi-trash"></i> حذف';
            }
        }
    }
            // رویدادهای پایه
