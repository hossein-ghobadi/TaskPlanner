        <div class="mt-2 board-view-toggle-row">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="showToolbarBtn" onclick="toggleToolbar()">
                <i class="bi bi-funnel"></i> نمایش فیلترها
            </button>
