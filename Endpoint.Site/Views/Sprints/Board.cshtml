@model Endpoint.Site.Models.SprintBoardVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var sprintId = ViewBag.SprintId as int?;
    var projectId = ViewBag.ProjectId as int?;
    var workflowStatuses = ViewBag.WorkflowStatuses as List<WorkflowStatus> ?? new List<WorkflowStatus>();
    var defaultStatus = Model.Statuses.FirstOrDefault(s => s.IsDefault) ?? Model.Statuses.FirstOrDefault();
    var defaultStatusName = defaultStatus?.Name ?? "ستون اول";
    var finalStatus = Model.Statuses.FirstOrDefault(s => s.IsFinal);
    var finalStatusName = finalStatus?.Name ?? "Done";
    
    // دریافت ProjectIssueTypes برای Quick Task form
    var viewBagValue = ViewBag.ProjectIssueTypes;
    var projectIssueTypes = viewBagValue as List<ProjectIssueType> ?? new List<ProjectIssueType>();
    
    // Debug: بررسی ViewBag
    var viewBagType = viewBagValue?.GetType().Name ?? "null";
    var viewBagIsList = viewBagValue is List<ProjectIssueType>;
    var viewBagCount = (viewBagValue as List<ProjectIssueType>)?.Count ?? 0;
    
    // Debug: نمایش اطلاعات ProjectIssueTypes
    var debugInfo = new
    {
        ViewBagType = viewBagType,
        ViewBagIsList = viewBagIsList,
        ViewBagCount = viewBagCount,
        TotalProjectIssueTypes = projectIssueTypes.Count,
        StoryLevelTypes = projectIssueTypes.Where(pit => pit.Level == IssueTypeLevel.StoryLevel).Count(),
        CanAddToSprintTypes = projectIssueTypes.Where(pit => pit.CanAddToSprint).Count(),
        AllTypes = projectIssueTypes.Select(pit => new { 
            Name = pit.Name, 
            Level = pit.Level.ToString(), 
            CanAddToSprint = pit.CanAddToSprint,
            BaseType = pit.BaseType.ToString()
        }).ToList()
    };
    
    // فقط انواعی که می‌توانند به Sprint اضافه شوند (Story-level types)
    // اول از CanAddToSprint استفاده می‌کنیم، اگر خالی بود از Level استفاده می‌کنیم
    var availableIssueTypes = projectIssueTypes
        .Where(pit => pit.Level == IssueTypeLevel.StoryLevel)
        .Where(pit => pit.CanAddToSprint)
        .OrderBy(pit => pit.Order)
        .ToList();
    
    // اگر هنوز خالی بود، از همه Story-level types استفاده کن (برای پروژه‌های قدیمی)
    if (!availableIssueTypes.Any())
    {
        availableIssueTypes = projectIssueTypes
            .Where(pit => pit.Level == IssueTypeLevel.StoryLevel)
            .OrderBy(pit => pit.Order)
            .ToList();
    }
    
    // نوع پیش‌فرض: Task یا اولین گزینه موجود
    var defaultIssueType = availableIssueTypes.FirstOrDefault(pit => pit.BaseType == IssueType.Task && !pit.IsCustom) 
                           ?? availableIssueTypes.FirstOrDefault();
}

<style>
    .board-container {
        direction: rtl;
    }
    .board-header {
        margin-bottom: 1.5rem;
    }
    .board-header h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }
    .board-header .meta {
        color: #6c757d;
        font-size: 0.9rem;
    }
    .stats-compact {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    .stat-compact {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: #f8f9fa;
        border-radius: 8px;
        font-size: 0.9rem;
    }
    .stat-compact .label {
        color: #6c757d;
    }
    .stat-compact .value {
        font-weight: 600;
        color: #212529;
    }
    .board-toolbar {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    .toolbar-input,
    .toolbar-select {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
    }
    .toolbar-input:focus,
    .toolbar-select:focus {
        border-color: #0d6efd;
        outline: none;
        box-shadow: 0 0 0 2px rgba(13,110,253,0.1);
    }
    .btn-toggle {
        border: 1px solid #dee2e6;
        background: #fff;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: all 0.2s;
    }
    .btn-toggle.active {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }
    .board-layout {
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 1rem;
        direction: ltr;
    }
    .kanban-board {
        display: flex;
        gap: 0.75rem;
        padding: 0.5rem 0;
        overflow-x: auto;
    }
    .kanban-column {
        flex: 1;
        min-width: 240px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #dee2e6;
        display: flex;
        flex-direction: column;
    }
    .kanban-column.column-dragging {
        opacity: 0.6;
    }
    .kanban-column.column-drop-target {
        outline: 2px dashed #0d6efd;
    }
    .kanban-column-header {
        padding: 0.75rem;
        font-weight: 600;
        color: white;
        border-radius: 8px 8px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
    }
    .kanban-column-body {
        padding: 0.5rem;
        flex: 1;
        min-height: 300px;
        max-height: calc(100vh - 350px);
        overflow-y: auto;
    }
    .task-card {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        cursor: grab;
        transition: all 0.2s;
    }
    .task-card:hover {
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        transform: translateY(-1px);
    }
    .task-card:active {
        cursor: grabbing;
    }
    .task-card.dragging {
        opacity: 0.5;
    }
    .task-card[data-due-soon="true"] {
        border-left: 3px solid #f97316;
    }
    .task-card.filtered-out {
        opacity: 0.3;
        pointer-events: none;
    }
    .task-card-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 0.5rem;
    }
    .task-key {
        font-weight: 600;
        font-size: 0.85rem;
        color: #495057;
    }
    .task-actions {
        display: flex;
        gap: 0.25rem;
        align-items: center;
    }
    .task-actions .btn {
        padding: 0.25rem 0.4rem;
        font-size: 0.75rem;
        line-height: 1;
    }
    .task-title {
        font-size: 0.9rem;
        color: #212529;
        margin-bottom: 0.5rem;
        line-height: 1.4;
    }
    .task-title a {
        color: #0d6efd;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }
    .task-title a:hover {
        color: #0a58ca;
        text-decoration: underline;
    }
    .task-meta {
        font-size: 0.75rem;
        color: #6c757d;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .available-tasks-column {
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #dee2e6;
        display: flex;
        flex-direction: column;
        max-height: calc(100vh - 200px);
    }
    .available-tasks-header {
        padding: 0.75rem;
        background: #e9ecef;
        border-bottom: 1px solid #dee2e6;
        border-radius: 8px 8px 0 0;
        font-weight: 600;
        font-size: 0.9rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .available-tasks-body {
        padding: 0.5rem;
        overflow-y: auto;
        flex: 1;
    }
    .available-task-item {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        transition: all 0.2s;
        cursor: pointer;
    }
    .available-task-item:hover {
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        transform: translateY(-1px);
    }
    .available-task-item.selected {
        background: #e7f3ff;
        border-color: #0d6efd;
        border-width: 2px;
    }
    .available-task-item.selected .available-task-title::after {
        content: " ✓ انتخاب شده";
        color: #0d6efd;
        font-weight: bold;
        margin-right: 0.5rem;
    }
    .available-task-item.selected .available-task-meta::after {
        content: " (دوبار کلیک کنید برای افزودن)";
        color: #0d6efd;
        font-weight: 600;
    }
    .available-task-title {
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 0.25rem;
        color: #212529;
    }
    .available-task-title a {
        color: #0d6efd;
        text-decoration: none;
        transition: color 0.2s;
    }
    .available-task-title a:hover {
        color: #0a58ca;
        text-decoration: underline;
    }
    .available-task-meta {
        font-size: 0.75rem;
        color: #6c757d;
    }
    .drop-zone {
        min-height: 300px;
        display: flex;
        flex-direction: column;
    }
    .empty-message {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 0.85rem;
        text-align: center;
        padding: 2rem;
    }
    .quick-add-column-btn {
        background: rgba(13,110,253,0.1);
        border: 1px solid rgba(13,110,253,0.2);
        color: #0d6efd;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.8rem;
        transition: all 0.2s;
    }
    .quick-add-column-btn:hover {
        background: #0d6efd;
        color: #fff;
    }
    .issue-type-icon {
        font-size: 1rem;
    }
    .quick-task-card {
        border-radius: 12px;
    }
    .quick-task-card .card-header,
    #quickTaskModal .modal-header {
        background: linear-gradient(125deg, #2563eb, #4f46e5);
        color: #fff;
        padding: 1rem 1.5rem;
        border: none;
    }
    .quick-task-card label,
    #quickTaskModal label {
        font-weight: 600;
        color: #0f172a;
    }
    .helper-text {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 0.25rem;
    }
    .issue-type-chips {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .chip-option {
        border-radius: 6px;
        border: 1px solid #cbd5f5;
        padding: 0.35rem 1rem;
        background: #fff;
        color: #2563eb;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.85rem;
    }
    .chip-option.active {
        background: #2563eb;
        color: #fff;
        border-color: #1d4ed8;
    }
    .quick-task-meta {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        color: #94a3b8;
        font-size: 0.85rem;
    }
    @@media (max-width: 992px) {
        .board-layout {
            grid-template-columns: 1fr;
        }
        .available-tasks-column {
            max-height: 400px;
        }
    }
    @@media (max-width: 768px) {
        .kanban-board {
            overflow-x: auto;
        }
        .kanban-column {
            min-width: 260px;
            flex: 0 0 260px;
        }
        .stats-compact {
            font-size: 0.85rem;
        }
    }
</style>

<div class="board-container">
    <div class="board-header">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2>تخته کانبان</h2>
                <div class="meta">
                    <span>اسپرینت: <strong>@Model.SprintName</strong></span>
                    <span class="mx-2">|</span>
                    <span>پروژه: <a href="/Projects/Details/@Model.ProjectId">@Model.ProjectName</a></span>
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (Model.Status == SprintStatus.Active)
                {
                    <form method="post" action="/Sprints/ChangeStatus" class="d-inline" id="completeSprintForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.SprintId" />
                        <input type="hidden" name="status" value="@((int)SprintStatus.Completed)" />
                        <button type="button" class="btn btn-sm btn-danger" onclick="completeSprint()">
                            <i class="bi bi-check-circle"></i> خاتمه اسپرینت
                        </button>
                    </form>
                }
                @if (Model.Status != SprintStatus.Completed)
                {
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="openAddStatusModal()">
                        <i class="bi bi-plus-circle"></i> افزودن وضعیت
                    </button>
                }
                <a class="btn btn-sm btn-outline-primary" href="/Projects/Details/@Model.ProjectId">
                    <i class="bi bi-folder-open"></i> جزئیات پروژه
                </a>
            </div>
        </div>

        <div class="stats-compact">
            <div class="stat-compact">
                <span class="label">پیشرفت:</span>
                <span class="value">@Model.CompletionPercentage.ToString("F1")%</span>
            </div>
            <div class="stat-compact">
                <span class="label">کل:</span>
                <span class="value">@Model.TotalTasks</span>
            </div>
            <div class="stat-compact">
                <span class="label">انجام شده:</span>
                <span class="value text-success">@Model.CompletedTasks</span>
            </div>
            <div class="stat-compact">
                <span class="label">در حال انجام:</span>
                <span class="value text-primary">@Model.InProgressTasks</span>
            </div>
            <div class="stat-compact">
                <span class="label">مسدود:</span>
                <span class="value text-danger">@Model.BlockedTasks</span>
            </div>
        </div>

        <div class="board-toolbar">
            <input type="text" id="boardSearchInput" class="form-control toolbar-input" placeholder="جستجو..." style="min-width: 200px;">
            <select id="statusFilterSelect" class="form-select toolbar-select" style="min-width: 150px;">
                <option value="all">همه ستون‌ها</option>
                @foreach (var status in Model.Statuses.OrderBy(s => s.Order))
                {
                    <option value="@status.Id">@status.Name</option>
                }
            </select>
            <button type="button" id="dueSoonToggle" class="btn btn-toggle">
                <i class="bi bi-alarm"></i> موعد نزدیک
            </button>
        </div>
    </div>

    <div class="board-layout">
        <div class="kanban-board-container">

            <div class="kanban-board" id="board" data-sprint-id="@Model.SprintId">
                @foreach (var status in Model.Statuses.OrderBy(s => s.Order))
                {
                    <div class="kanban-column"
                         ondragover="onDragOverColumn(event)"
                         ondragenter="onDragEnter(event)"
                         ondragleave="onDragLeave(event)"
                         ondrop="onDropIssue(event, @status.Id)"
                         data-status-id="@status.Id">
                        <div class="kanban-column-header"
                             style="background-color: @(status.Color ?? "#6c757d");"
                             draggable="@(Model.Status != SprintStatus.Completed ? "true" : "false")"
                             ondragstart="onColumnDragStart(event)"
                             ondragend="onColumnDragEnd(event)">
                            <div>
                                <span>@status.Name</span>
                                <span class="badge bg-light text-dark ms-1">
                                    @{
                                        var count = Model.SprintIssues.Count(t =>
                                        (t.StatusId ?? (Model.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)) == status.Id);
                                    }
                                    @count
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                @if (Model.Status == SprintStatus.Active)
                                {
                                    <button type="button"
                                            class="quick-add-column-btn"
                                            data-status-id="@status.Id"
                                            data-status-name="@status.Name"
                                            title="افزودن سریع">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                }
                                @if (Model.Status != SprintStatus.Completed && !status.IsDefault && !status.IsFinal)
                                {
                                    <button type="button"
                                            class="btn btn-sm p-0 px-1 text-white"
                                            data-status-name="@status.Name"
                                            title="حذف وضعیت"
                                            onclick="event.preventDefault(); event.stopPropagation(); deleteStatus(@status.Id, this.dataset.statusName);"
                                            style="background: transparent; border: none; opacity: 0.8;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="kanban-column-body drop-zone" data-status-id="@status.Id">
                            @{
                                var cards = Model.SprintIssues
                                .Where(t => (t.StatusId ?? (Model.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)) == status.Id)
                                .OrderBy(t => t.Priority)
                                .ToList();
                            }
                            @if (cards.Any())
                            {
                                foreach (var issue in cards)
                                {
                                    var dueDate = issue.DueDate;
                                    var dueSoonFlag = dueDate.HasValue && dueDate.Value >= DateTime.UtcNow && dueDate.Value <= DateTime.UtcNow.AddDays(3);
                                    <div class="task-card"
                                         draggable="true"
                                         ondragstart="onDragIssue(event, @issue.Id)"
                                         onclick="handleCardClick(event, @issue.Id)"
                                         data-issue-id="@issue.Id"
                                         data-status-id="@status.Id"
                                         data-status-name="@status.Name"
                                         data-title="@issue.Title"
                                         data-assignee="@((issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "نامشخص"))"
                                         data-key="@issue.IssueKey"
                                         data-due="@dueDate?.ToString("o")"
                                         data-due-soon="@dueSoonFlag.ToString().ToLower()">

                                        <div class="task-card-header">
                                            <span class="task-key">@issue.IssueKey</span>
                                            <div class="task-actions">
                                                <span class="issue-type-icon" title="@issue.IssueTypeName">@issue.IssueTypeIcon</span>
                                                @if (Model.Status == SprintStatus.Active && finalStatus != null && status.Id != finalStatus.Id)
                                                {
                                                    <button class="btn btn-sm btn-success complete-task-btn"
                                                            onclick="event.stopPropagation(); event.preventDefault(); completeTask(@issue.Id);"
                                                            title="خاتمه کار">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                }
                                                @if (Model.Status == SprintStatus.Active && issue.CanHaveChildren)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            onclick="event.stopPropagation(); event.preventDefault(); openAddSubtaskModal(@issue.Id, '@issue.IssueKey');"
                                                            title="افزودن زیرکار">
                                                        <i class="bi bi-plus-circle"></i>
                                                    </button>
                                                }
                                                @if (Model.Status == SprintStatus.Active)
                                                {
                                                    <button class="btn btn-sm btn-outline-warning"
                                                            onclick="event.stopPropagation(); event.preventDefault(); removeTaskFromSprint(@issue.Id);"
                                                            title="خارج کردن از اسپرینت">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger"
                                                            onclick="event.stopPropagation(); event.preventDefault(); deleteTask(@issue.Id, '@issue.Title');"
                                                            title="حذف کار">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <div class="task-title">
                                            <a href="/Tasks/Details/@issue.Id" onclick="event.stopPropagation();">@issue.Title</a>
                                        </div>

                                        <div class="task-meta">
                                            <div>👤 @(issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "نامشخص")</div>
                                            @if (issue.DueDatePersian != "تعیین نشده")
                                            {
                                                <div>🗓️ @issue.DueDatePersian</div>
                                            }
                                            @if (issue.StoryPoints.HasValue && issue.StoryPoints > 0)
                                            {
                                                <div>⚡ @issue.StoryPoints SP</div>
                                            }
                                            @if (issue.ChildIssues != null && issue.ChildIssues.Any())
                                            {
                                                <div class="mt-1">
                                                    <button class="btn btn-sm btn-outline-secondary p-0 px-2"
                                                            onclick="event.stopPropagation(); event.preventDefault(); toggleSubtasks(@issue.Id);"
                                                            style="font-size: 0.7rem;">
                                                        <i class="bi bi-chevron-down" id="subtask-icon-@issue.Id"></i>
                                                        @issue.ChildIssues.Count زیرکار
                                                    </button>
                                                </div>
                                            }
                                        </div>

                                        @if (issue.ChildIssues != null && issue.ChildIssues.Any())
                                        {
                                            <div class="subtasks-container mt-2" id="subtasks-@issue.Id" style="display: none; border-top: 1px solid #dee2e6; padding-top: 8px;">
                                                @foreach (var subtask in issue.ChildIssues.OrderBy(c => c.CreatedAt))
                                                {
                                                    <div class="subtask-item d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded" style="font-size: 0.85rem;">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="issue-type-icon" style="font-size: 0.9rem;">@subtask.IssueTypeIcon</span>
                                                            <div>
                                                                <div class="fw-bold">@subtask.IssueKey: @subtask.Title</div>
                                                                @if (!string.IsNullOrEmpty(subtask.Description))
                                                                {
                                                                    <small class="text-muted">@(subtask.Description.Length > 50 ? subtask.Description.Substring(0, 50) + "..." : subtask.Description)</small>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="d-flex gap-1">
                                                            <a href="/Tasks/Details/@subtask.Id" class="btn btn-sm btn-outline-info p-0 px-1"
                                                               onclick="event.stopPropagation();"
                                                               title="جزئیات"
                                                               style="font-size: 0.7rem;">
                                                                <i class="bi bi-eye"></i>
                                                            </a>
                                                            @if (Model.Status == SprintStatus.Active)
                                                            {
                                                                <button class="btn btn-sm btn-outline-danger p-0 px-1"
                                                                        onclick="event.stopPropagation(); event.preventDefault(); deleteTask(@subtask.Id, '@subtask.Title');"
                                                                        title="حذف زیرکار"
                                                                        style="font-size: 0.7rem;">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-message">
                                    <i class="bi bi-inbox"></i><br>
                                    خالی
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.Status == SprintStatus.Active)
        {
            <div class="available-tasks-column">
                <div class="available-tasks-header">
                    <span>کارهای آماده</span>
                    <span class="badge bg-primary">@Model.TotalTasks</span>
                </div>
                <div id="availableTasksContainer" class="available-tasks-body">
                    <p class="text-muted text-center py-3">در حال بارگذاری...</p>
                </div>
            </div>
        }
    </div>
</div>


