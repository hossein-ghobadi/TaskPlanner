        text-overflow: ellipsis;
    }
    .attachment-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 8px;
    }
    .attachment-item {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 10px;
        padding: 7px 9px;
    }
    .attachment-actions,
    .message-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 6px;
    }
    .message-actions {
        margin-top: 8px;
    }
    .reply-inline-link,
    .attachment-file-link {
        color: #2563eb !important;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
    }
    .reply-inline-link:hover,
    .attachment-file-link:hover {
        color: #1d4ed8 !important;
        text-decoration: underline;
    }
    .message-text a {
        color: #2563eb;
        text-decoration: underline;
        word-break: break-all;
    }
    .attachment-actions,
    .message-actions {
        flex-wrap: wrap;
    }
    .message-actions a {
        opacity: 1;
        transition: opacity 0.2s, color 0.2s;
        text-decoration: none;
        font-size: 0.8rem;
    }
    .message-actions a:hover {
        opacity: 1;
    }

    .chat-input-area {
        padding: 14px 16px;
        background: #fff;
        border-top: 1px solid #e6eefc;
    }
    .reply-context {
        display: none;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 8px 10px;
        margin-bottom: 10px;
    }
    .reply-context.active {
        display: flex;
    }
    .reply-context-meta {
        font-size: 0.82rem;
        color: #1e3a8a;
        line-height: 1.5;
        flex: 1;
    }
    .reply-context-meta strong {
        display: block;
        font-weight: 700;
    }
    .reply-context-close {
        border: none;
        background: transparent;
        color: #1e40af;
        font-size: 0.95rem;
        cursor: pointer;
        padding: 0 2px;
        line-height: 1;
    }

    .chat-input-wrapper {
        display: flex;
        gap: 10px;
        align-items: flex-end;
    }

    .chat-input {
        flex: 1;
        border: 1px solid #dbe4f0;
        border-radius: 12px;
        padding: 10px 12px;
        font-size: 0.9rem;
        transition: border-color 0.2s;
        resize: none;
        min-height: 44px;
        max-height: 120px;
    }

        .chat-input:focus {
            outline: none;
            border-color: #3b82f6;
        }

    .chat-actions {
        display: flex;
        gap: 8px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .chat-action-btn {
        background: #f3f4f6;
        border: none;
        border-radius: 12px;
        padding: 10px 16px;
        font-size: 0.85rem;
        color: #4b5563;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .chat-action-btn:hover {
            background: #e5e7eb;
            color: #1f2937;
        }

        .chat-action-btn.recording {
            background: #fee2e2;
            color: #dc2626;
        }

            .chat-action-btn.recording:hover {
                background: #fecaca;
            }

    .chat-send-btn {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border: none;
        border-radius: 12px;
        padding: 10px 14px;
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .chat-send-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        }

        .chat-send-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    .file-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .file-preview-item {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
    }

        .file-preview-item img {
            max-width: 150px;
            max-height: 150px;
            border-radius: 12px;
        }

        .file-preview-item .remove-btn {
            position: absolute;
            top: 5px;
            right: 5px;
            background: rgba(220, 38, 38, 0.9);
            color: white;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 0.8rem;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #9ca3af;
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 15px;
            opacity: 0.5;
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
    }

        .status-badge.completed {
            background: #d1fae5;
            color: #065f46;
        }

        .status-badge.in-progress {
            background: #fef3c7;
            color: #92400e;
        }

    /* دکمه بازگشت */
    .back-btn {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px 20px;
        color: #4b5563;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        margin-bottom: 20px;
    }

        .back-btn:hover {
            background: #f9fafb;
            border-color: #3b82f6;
            color: #3b82f6;
        }

    /* ریسپانسیو */
    @@media (max-width: 768px) {
        .task-header h1 {
            font-size: 1.5rem;
        }

        .task-meta {
            flex-direction: column;
            gap: 10px;
