                                @if (Model.Status != SprintStatus.Completed && !status.IsDefault)
                                {
                                    <i class="bi bi-grip-vertical text-muted" style="cursor: grab;" title="بکشید و رها کنید برای تغییر ترتیب"></i>
                                }
                                <span>@status.Name</span>
                                <span class="badge bg-primary">
                                    @{
                                        var count = Model.SprintIssues.Count(t =>
                                        (t.StatusId ?? (Model.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)) == status.Id);
                                    }
                                    @count.ToString().ToPersianNumbers()
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                               
                                @if (Model.Status != SprintStatus.Completed && !status.IsDefault && !status.IsFinal)
