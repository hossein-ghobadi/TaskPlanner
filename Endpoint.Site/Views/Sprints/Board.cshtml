                    </a>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="boardBackgroundSelect" class="text-muted small mb-0">پس‌زمینه:</label>
                    <select id="boardBackgroundSelect" class="form-select form-select-sm" style="min-width: 170px;" onchange="changeBoardBackground(this.value)">
                        <option value="plain">ساده</option>
                        <option value="gradient">گرادیان</option>
                        <option value="soft">نرم و محو</option>
                        <option value="pattern">الگوی نقطه‌ای</option>
                        <option value="pastel">پاستلی</option>
                        
                    </select>
                </div>
            </div>
        </div>

        <!-- فیلترها (اختیاری - می‌تواند مخفی شود) -->
        <div class="board-toolbar mt-3" id="boardToolbar" style="display: none;">
            <input type="text" id="boardSearchInput" class="form-control toolbar-input" placeholder="جستجو..." style="min-width: 200px;">
            <select id="statusFilterSelect" class="form-select toolbar-select" style="min-width: 150px;">
                <option value="all">همه ستون‌ها</option>
                @foreach (var status in Model.Statuses.OrderBy(s => s.Order))
                {
                    <option value="@status.Id">@status.Name</option>
                }
            </select>
            <div class="d-flex align-items-center gap-2 flex-wrap" style="position: relative;">
                <select id="assigneeFilterSelect" class="form-select toolbar-select" style="min-width: 180px;">
                    <option value="all">همه افراد</option>
                    <option value="unassigned">تخصیص نیافته</option>
                    @foreach (var member in projectMembers)
                    {
                        <option value="@member.UserId">@(member.FullName ?? member.UserName)</option>
                    }
                </select>
                <span id="selectedAssigneeBadge" class="badge bg-primary d-none" style="font-size: 0.85rem;">
                    <i class="bi bi-funnel-fill"></i> 
                    <span id="selectedAssigneeName"></span>
                </span>
            </div>
            <button type="button" id="dueSoonToggle" class="btn btn-toggle">
                <i class="bi bi-alarm"></i> موعد نزدیک
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleToolbar()">
                <i class="bi bi-x"></i> بستن فیلترها
            </button>
