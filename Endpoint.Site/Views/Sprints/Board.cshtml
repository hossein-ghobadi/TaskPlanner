        async function openQuickTaskModalForStatus(statusId, statusName) {
            if (!statusId) {
                showNotification('ستون انتخاب‌شده معتبر نیست', 'error');
                return;
            }
            setQuickTaskTarget(statusId, statusName);
            document.querySelectorAll('.board-column-add-wrap').forEach(function(wrap) {
                const btn = wrap.querySelector('.quick-add-column-btn');
                const panel = wrap.querySelector('.board-inline-add');
                const inp = wrap.querySelector('.board-inline-add-input');
                const sid = btn ? parseInt(btn.dataset.statusId, 10) : 0;
                if (sid === statusId) {
                    if (btn) btn.classList.add('d-none');
                    if (panel) {
                        panel.classList.remove('d-none');
                        panel.removeAttribute('aria-hidden');
                    }
                    if (inp) {
                        inp.value = '';
                        setTimeout(function() { inp.focus(); }, 50);
                    }
                } else {
                    closeInlineQuickAdd(wrap);
                }
            });

            const container = document.getElementById('issueTypeChipsContainer');
            if (container) {
                container.innerHTML = '<div class="text-muted small">در حال بارگذاری...</div>';
            }
            try {
                const issueTypes = await loadProjectIssueTypes();
                renderIssueTypeChips(issueTypes);
            } catch (err) {
                console.error(err);
            }
        }
        // onclick در HTML به window نگاه می‌کند؛ تابع داخل بلوک if است و در همه مرورگرها global نیست
        window.openQuickTaskModalForStatus = openQuickTaskModalForStatus;

        // دریافت ProjectIssueTypes به صورت داینامیک
        async function loadProjectIssueTypes() {
            if (!projectId) {
                console.error('ProjectId is not available');
                return [];
            }

            try {
                const response = await fetch(`/Sprints/GetProjectIssueTypes?projectId=${projectId}`);
                const data = await response.json();
                
                if (data.success && data.issueTypes) {
                    return data.issueTypes;
                } else {
                    console.error('Failed to load issue types:', data.message);
                    return [];
                }
            } catch (error) {
                console.error('Error loading issue types:', error);
                return [];
            }
        }

        // ساخت issue type chips به صورت داینامیک
        function renderIssueTypeChips(issueTypes) {
            const container = document.getElementById('issueTypeChipsContainer');
            const hiddenSelect = document.getElementById('quickTaskType');
            const projectIssueTypeIdInput = document.getElementById('quickTaskProjectIssueTypeId');
            
            if (!container || !hiddenSelect || !projectIssueTypeIdInput) return;

            // فیلتر کردن فقط انواعی که می‌توانند به Sprint اضافه شوند
            const availableTypes = issueTypes.filter(type => 
                type.level === 'StoryLevel' && type.canAddToSprint
            );

            // اگر خالی بود، از همه Story-level types استفاده کن
            const finalTypes = availableTypes.length > 0 
                ? availableTypes 
                : issueTypes.filter(type => type.level === 'StoryLevel');

            // اگر هنوز خالی بود، از همه انواع استفاده کن (fallback)
            const typesToShow = finalTypes.length > 0 ? finalTypes : issueTypes;

            if (typesToShow.length === 0) {
                container.innerHTML = '<div class="text-danger small">هیچ نوع کاری یافت نشد</div>';
                return;
            }

            // پیدا کردن نوع پیش‌فرض (Task یا اولین گزینه)
            const defaultType = typesToShow.find(t => t.baseType === 'Task' && !t.isCustom) 
                               || typesToShow[0];

            // پاک کردن container
            container.innerHTML = '';
            hiddenSelect.innerHTML = '';

            // ساخت chips
            typesToShow.forEach((type, index) => {
                const isActive = defaultType && type.id === defaultType.id;
                
                // ساخت button chip
                const chipBtn = document.createElement('button');
                chipBtn.type = 'button';
                chipBtn.className = `chip-option ${isActive ? 'active' : ''}`;
                chipBtn.dataset.issueType = getIssueTypeEnumValue(type.baseType);
                chipBtn.dataset.projectIssueTypeId = type.id;
                chipBtn.innerHTML = `<span class="me-1">${type.icon || '📝'}</span> ${type.name}`;
                
                container.appendChild(chipBtn);

                // ساخت option برای select hidden
                const option = document.createElement('option');
                option.value = getIssueTypeEnumValue(type.baseType);
                option.dataset.projectIssueTypeId = type.id;
                option.textContent = `${type.icon || '📝'} ${type.name}`;
                if (isActive) {
                    option.selected = true;
                }
                hiddenSelect.appendChild(option);
            });

            // تنظیم مقدار پیش‌فرض
            if (defaultType && projectIssueTypeIdInput) {
                projectIssueTypeIdInput.value = defaultType.id;
            }

            // اضافه کردن event listeners
            initQuickAddTypeChips();
        }

        // تبدیل نام baseType به مقدار enum (مطابق با IssueType enum در C#)
        function getIssueTypeEnumValue(baseType) {
            const enumMap = {
                'Epic': 1,
                'Story': 2,
                'Task': 3,
                'Subtask': 4,
                'Bug': 5
            };
            return enumMap[baseType] !== undefined ? enumMap[baseType] : 3; // default: Task
        }

        function initQuickAddTypeChips() {
            const hiddenSelect = document.getElementById('quickTaskType');
            const projectIssueTypeIdInput = document.getElementById('quickTaskProjectIssueTypeId');
            const chipButtons = document.querySelectorAll('#issueTypeChipsContainer .chip-option');
            
            if (!hiddenSelect || !chipButtons.length) {
                return;
            }
            
            chipButtons.forEach(btn => {
                // حذف event listener قبلی (اگر وجود دارد)
                const newBtn = btn.cloneNode(true);
                btn.parentNode.replaceChild(newBtn, btn);
                
                newBtn.addEventListener('click', () => {
                    // دریافت دوباره همه دکمه‌ها از DOM (نه از متغیر قدیمی)
                    const allChipButtons = document.querySelectorAll('#issueTypeChipsContainer .chip-option');
                    allChipButtons.forEach(b => b.classList.remove('active'));
                    newBtn.classList.add('active');
                    hiddenSelect.value = newBtn.dataset.issueType;
                    
                    // تنظیم projectIssueTypeId
                    if (projectIssueTypeIdInput && newBtn.dataset.projectIssueTypeId) {
                        projectIssueTypeIdInput.value = newBtn.dataset.projectIssueTypeId;
                    } else if (projectIssueTypeIdInput) {
                        projectIssueTypeIdInput.value = '';
                    }
                });
            });
        }

        function resetQuickTaskTypeChips() {
            // این تابع دیگر استفاده نمی‌شود چون issue types به صورت داینامیک بارگذاری می‌شوند
            // اما برای سازگاری با کدهای قدیمی، آن را نگه می‌داریم
            const chipButtons = document.querySelectorAll('#issueTypeChipsContainer .chip-option');
            if (chipButtons.length > 0) {
                chipButtons.forEach(btn => btn.classList.remove('active'));
                chipButtons[0]?.classList.add('active');
                
                const hiddenSelect = document.getElementById('quickTaskType');
                const projectIssueTypeIdInput = document.getElementById('quickTaskProjectIssueTypeId');
                
                if (hiddenSelect && chipButtons[0]) {
                    hiddenSelect.value = chipButtons[0].dataset.issueType || hiddenSelect.value;
                }
                
                if (projectIssueTypeIdInput && chipButtons[0]?.dataset.projectIssueTypeId) {
                    projectIssueTypeIdInput.value = chipButtons[0].dataset.projectIssueTypeId;
                }
            }
        }

        function runCreateQuickTask(title, submitBtn, inlineWrap) {
            const t = (title || '').trim();
            if (!t) {
                showNotification('عنوان کار الزامی است', 'error');
                return;
            }
            if (!quickTaskTargetStatusId) {
                showNotification('ابتدا ستونی را برای افزودن کار انتخاب کنید', 'error');
                return;
            }
            const typeEl = document.getElementById('quickTaskType');
            const issueType = parseInt(typeEl && typeEl.value ? typeEl.value : '3', 10);
            const projectIssueTypeIdEl = document.getElementById('quickTaskProjectIssueTypeId');
            const projectIssueTypeId = projectIssueTypeIdEl && projectIssueTypeIdEl.value ? projectIssueTypeIdEl.value : '';

            const data = {
                sprintId: sprintId,
                title: t,
                issueType: issueType,
                statusId: quickTaskTargetStatusId
            };
            if (projectIssueTypeId) {
                data.projectIssueTypeId = parseInt(projectIssueTypeId, 10);
            }

            const $btn = submitBtn ? $(submitBtn) : null;
            let originalText = '';
            if ($btn && $btn.length) {
                originalText = $btn.html();
                $btn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> در حال ایجاد...');
            }

            $.ajax({
                url: '/Sprints/CreateQuickTask',
                type: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(data),
                success: function(response) {
                    if (response.success) {
                        showNotification(response.message, 'success');
                        if (inlineWrap) {
                            closeInlineQuickAdd(inlineWrap);
                        }
                        resetQuickTaskTypeChips();
                        const targetStatusId = response.statusId || quickTaskTargetStatusId;
                        appendQuickTaskCard({
                            id: response.taskId,
                            statusId: targetStatusId,
                            statusName: response.statusName || quickTaskTargetStatusName,
                            title: t,
                            issueKey: response.issueKey,
                            isCompleted: false
                        });
                        applyBoardFilters();
                        refreshEmptyColumnStyles();
                        if (response.taskId) {
                            highlightTaskCard(response.taskId);
                        }
                        if ($btn && $btn.length) {
                            $btn.prop('disabled', false).html(originalText);
                        }
                    } else {
                        showNotification('خطا: ' + response.message, 'error');
                        if ($btn && $btn.length) {
                            $btn.prop('disabled', false).html(originalText);
                        }
                    }
                },
                error: function(xhr) {
                    const errorMsg = xhr.responseJSON && xhr.responseJSON.message
                        ? xhr.responseJSON.message
                        : 'خطا در ارتباط با سرور';
                    showNotification('خطا: ' + errorMsg, 'error');
                    if ($btn && $btn.length) {
                        $btn.prop('disabled', false).html(originalText);
                    }
                }
            });
        }

        function appendQuickTaskCard(task) {
            if (!task || !task.statusId) {
                return;
            }
            const columnBody = document.querySelector(`.column-tasks[data-status-id="${task.statusId}"]`);
            if (!columnBody) {
                return;
            }

            const emptyMessage = columnBody.querySelector('.empty-message');
            if (emptyMessage) {
                emptyMessage.remove();
            }

            const card = document.createElement('div');
            card.className = 'task-card';
            card.draggable = true;
            card.dataset.issueId = task.id;
            card.dataset.statusId = task.statusId;
            card.dataset.statusName = task.statusName || '';
            card.dataset.title = task.title || '';
            card.dataset.assignee = task.assigneeName || 'نامشخص';
            card.dataset.assigneeId = task.assigneeId || 'unassigned';
            card.dataset.key = task.issueKey || '';
            card.dataset.due = '';
            card.dataset.dueSoon = 'false';
            card.dataset.isCompleted = String(!!task.isCompleted);
            card.addEventListener('dragstart', (e) => onDragIssue(e, task.id));
            card.addEventListener('click', (e) => handleCardClick(e, task.id));

            const safeTitle = escapeHtml(task.title || '');
            const issueKey = task.issueKey || 'جدید';
            const keyNumber = issueKey.includes('-') ? issueKey.split('-').pop() : issueKey;
            const safeKey = escapeHtml(keyNumber);
            const deleteTitleArgument = (task.title || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");

            const canComplete = canManageStatuses && finalStatusId && task.statusId !== finalStatusId;
            const canRemoveFromSprint = canManageStatuses && !task.isCompleted;
            const completeMenuItem = canComplete ? `
                <li>
                    <a class="dropdown-item complete-task-btn" href="#" onclick="event.stopPropagation(); event.preventDefault(); completeTask(${task.id});">
                        <i class="bi bi-check-lg text-success me-2"></i>خاتمه کار
                    </a>
                </li>` : '';
            const removeFromSprintMenuItem = canRemoveFromSprint ? `
                <li>
                    <a class="dropdown-item" href="#" onclick="event.stopPropagation(); event.preventDefault(); removeTaskFromSprint(${task.id});">
                        <i class="bi bi-x-circle text-warning me-2"></i>خارج کردن از اسپرینت
                    </a>
                </li>` : '';

            const actionButtons = canManageStatuses && !task.isCompleted ? `
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            type="button"
                            id="taskMenu-${task.id}"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            onclick="event.stopPropagation(); event.preventDefault();"
                            title="عملیات بیشتر">
                        <i class="bi bi-three-dots-vertical"></i>
                </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="taskMenu-${task.id}">
                        <li>
                            <a class="dropdown-item" href="#" onclick="event.stopPropagation(); event.preventDefault(); openEditTaskModal(${task.id});">
                                <i class="bi bi-pencil text-primary me-2"></i>ویرایش کار
                            </a>
                        </li>
                        ${completeMenuItem}
                        ${removeFromSprintMenuItem}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="#" onclick="event.stopPropagation(); event.preventDefault(); deleteTask(${task.id}, '${deleteTitleArgument}');">
                                <i class="bi bi-trash me-2"></i>حذف کار
                            </a>
                        </li>
                    </ul>
                </div>` : '';

            card.innerHTML = `
                <div class="task-card-header">
                    <div class="task-actions">
                        <span class="issue-type-icon" title="Task">🆕</span>
                        ${actionButtons}
                    </div>
                </div>
                <div class="task-title">
                    <a href="#" onclick="event.stopPropagation(); event.preventDefault(); openEditTaskModal(${task.id}); return false;">${safeTitle}</a>
                </div>
                <div class="task-meta">
                    <div>👤 ${escapeHtml(task.assigneeName || 'نامشخص')}</div>
                </div>
            `;

            columnBody.prepend(card);
            applyBoardFilters();
            updateIssueCounts();
            refreshEmptyColumnStyles();
        }

        function escapeHtml(value) {
            return (value ?? '').toString()
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function ensureColumnHasEmptyMessage(columnBody) {
            if (!columnBody) return;
            if (columnBody.querySelector('.task-card')) {
                return;
            }
            let emptyMessage = columnBody.querySelector('.empty-message');
            if (!emptyMessage) {
                emptyMessage = document.createElement('div');
                emptyMessage.className = 'empty-message text-muted text-center small p-4';
                emptyMessage.innerHTML = '<span class="column-empty-msg-inner"><i class="bi bi-inbox" aria-hidden="true"></i><span>هیچ آیتمی وجود ندارد</span></span>';
                columnBody.appendChild(emptyMessage);
            } else {
                emptyMessage.style.display = 'block';
            }
        }

        function moveCardToColumn(card, targetStatusId, targetStatusName) {
            if (!card || !targetStatusId) {
                return false;
            }
            const columnBody = document.querySelector(`.kanban-column-body[data-status-id="${targetStatusId}"]`);
            if (!columnBody) {
                return false;
            }

            const emptyMessage = columnBody.querySelector('.empty-message');
            if (emptyMessage) {
                emptyMessage.remove();
            }

            const sourceColumn = card.closest('.column-tasks');
            columnBody.prepend(card);
            card.dataset.statusId = targetStatusId;
            if (targetStatusName) {
                card.dataset.statusName = targetStatusName;
            }

            const completeBtn = card.querySelector('.complete-task-btn');
            if (completeBtn) {
                if (targetStatusId === finalStatusId) {
                    completeBtn.remove();
                }
            }

            if (sourceColumn && sourceColumn !== columnBody) {
                ensureColumnHasEmptyMessage(sourceColumn);
            }

            updateIssueCounts();
            return true;
        }

        function updateCardCompletedState(card, isCompleted) {
            if (!card) return;
            const completed = !!isCompleted;
            card.dataset.isCompleted = String(completed);

            if (!completed) return;

            // برای کارت‌های خاتمه‌یافته، هیچ عملیات مدیریتی نمایش داده نشود.
            card.querySelectorAll('a[onclick*="completeTask"], button[onclick*="completeTask"]').forEach(el => {
                const wrapper = el.closest('li') || el.closest('button');
                if (wrapper) wrapper.remove();
            });
            card.querySelectorAll('a[onclick*="deleteTask"], button[onclick*="deleteTask"]').forEach(el => {
                const wrapper = el.closest('li') || el.closest('button');
                if (wrapper) wrapper.remove();
            });
            card.querySelectorAll('a[onclick*="removeTaskFromSprint"], button[onclick*="removeTaskFromSprint"]').forEach(el => {
                const wrapper = el.closest('li') || el.closest('button');
                if (wrapper) wrapper.remove();
            });

            const dropdown = card.querySelector('.task-actions .dropdown');
            if (dropdown) {
                dropdown.remove();
            }
        }

        async function postJson(url, payload) {
            let res;
            try {
                res = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(payload)
                });
            } catch (networkError) {
                throw new Error('خطا در ارتباط با سرور');
            }

            const text = await res.text();
            let data = null;

            if (text) {
                try {
                    data = JSON.parse(text);
                } catch (err) {
                    data = null;
                }
            }

            if (!res.ok || (data && data.success === false)) {
                throw new Error(data?.message || text || 'خطای ناشناخته');
            }

            return data || { success: true };
        }

        function resetDropZoneStyles() {
            document.querySelectorAll('.column-tasks').forEach(zone => {
                zone.style.backgroundColor = '';
                zone.style.borderColor = '';
            });
        }

        function highlightColumnTarget(column, isActive) {
            if (!column) return;
            if (isActive) {
                column.classList.add('column-drop-target');
            } else {
                column.classList.remove('column-drop-target');
            }
        }

        function onColumnDragStart(e) {
            if (!canManageStatuses) {
                e.preventDefault();
                return;
            }
            
            // جلوگیری از drag کردن وقتی روی دکمه‌ها کلیک می‌شود
            if (e.target.closest('button') || e.target.closest('.quick-add-column-btn') || e.target.closest('.delete-status-btn')) {
                e.preventDefault();
                return;
            }

            const column = e.currentTarget.closest('.kanban-column');
            if (!column) {
                return;
            }

            // بررسی اینکه آیا ستون پیش‌فرض است یا نه
            const statusId = parseInt(column.dataset.statusId);
            if (statusId === defaultStatusId) {
                e.preventDefault();
                showNotification('وضعیت پیش‌فرض قابل جابجایی نیست', 'warning');
                return;
            }

            isColumnDragging = true;
            draggedColumnElement = column;
            column.classList.add('column-dragging');
            if (e.dataTransfer) {
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', 'column');
            }
        }

        function onColumnDragEnd() {
            if (draggedColumnElement) {
                draggedColumnElement.classList.remove('column-dragging');
                draggedColumnElement = null;
            }
            isColumnDragging = false;
            document.querySelectorAll('.kanban-column').forEach(col => col.classList.remove('column-drop-target'));
            resetDropZoneStyles();
        }

        function handleColumnDrop(targetColumn) {
            if (!isColumnDragging || !draggedColumnElement || !targetColumn || draggedColumnElement === targetColumn) {
                onColumnDragEnd();
                return;
            }

            // بررسی اینکه آیا ستون پیش‌فرض است یا نه (نباید جابجا شود)
            const draggedStatusId = parseInt(draggedColumnElement.dataset.statusId);
            const targetStatusId = parseInt(targetColumn.dataset.statusId);
            
            if (draggedStatusId === defaultStatusId) {
                showNotification('وضعیت پیش‌فرض قابل جابجایی نیست', 'warning');
                onColumnDragEnd();
                return;
            }

            const board = document.getElementById('board');
            if (!board) {
                onColumnDragEnd();
                return;
            }

            const columns = Array.from(board.querySelectorAll('.kanban-column'));
            const dragIndex = columns.indexOf(draggedColumnElement);
            const targetIndex = columns.indexOf(targetColumn);

            if (dragIndex === -1 || targetIndex === -1) {
                onColumnDragEnd();
                return;
            }

            // جابجایی ستون
            if (targetIndex < dragIndex) {
                board.insertBefore(draggedColumnElement, targetColumn);
            } else {
                board.insertBefore(draggedColumnElement, targetColumn.nextElementSibling);
            }

            onColumnDragEnd();
            persistColumnOrder();
        }

        async function persistColumnOrder() {
            if (!canManageStatuses) {
                return;
            }

            const columns = document.querySelectorAll('.kanban-column');
            if (!columns.length) {
                return;
            }

            const statusOrders = Array.from(columns)
                .map((column, index) => ({
                    statusId: parseInt(column.dataset.statusId, 10),
                    order: index + 1
                }))
                .filter(item => !Number.isNaN(item.statusId));

            if (!statusOrders.length) {
                return;
            }

            try {
                const data = await postJson('/WorkflowStatus/UpdateOrder', {
                    sprintId: sprintId,
                    statusOrders: statusOrders
                });
                showNotification(data.message || 'ترتیب ستون‌ها ذخیره شد', 'success');
            } catch (error) {
                showNotification(error.message || 'خطا در ذخیره ترتیب ستون‌ها', 'error');
            }
        }

        function openAddStatusModal() {
            if (!canManageStatuses) {
                showNotification('اسپرینت تکمیل‌شده قابل ویرایش نیست', 'error');
                return;
            }

            const modalElement = document.getElementById('addStatusModal');
            if (!modalElement) {
                return;
            }

            const nameInput = document.getElementById('statusName');
            const descInput = document.getElementById('statusDescription');
            const colorInput = document.getElementById('statusColor');
            if (nameInput) nameInput.value = '';
            if (descInput) descInput.value = '';
            if (colorInput) {
                colorInput.value = '#0d6efd';
            }

            const modal = new bootstrap.Modal(modalElement);
            modal.show();
        }

        function submitStatus() {
            return (async () => {
                if (!canManageStatuses) {
                    showNotification('اسپرینت تکمیل‌شده قابل ویرایش نیست', 'error');
                    return;
                }

                const nameInput = document.getElementById('statusName');
                const colorInput = document.getElementById('statusColor');
                const descInput = document.getElementById('statusDescription');
                if (!nameInput) {
                    return;
                }

                const name = nameInput.value.trim();
                if (!name) {
                    showNotification('نام وضعیت الزامی است', 'error');
                    nameInput.focus();
                    return;
                }

                const payload = {
                    sprintId: sprintId,
                    name: name,
                    color: colorInput?.value,
                    description: descInput?.value?.trim() || null
                };

                const submitBtn = document.getElementById('addStatusSubmitBtn');
                const originalText = submitBtn?.innerHTML;
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> در حال ثبت...';
                }

                try {
                    const data = await postJson('/WorkflowStatus/CreateInline', payload);
                    showNotification(data.message || 'وضعیت جدید ایجاد شد', 'success');
                    const modalElement = document.getElementById('addStatusModal');
                    if (modalElement) {
                        bootstrap.Modal.getInstance(modalElement)?.hide();
                    }
                    setTimeout(() => reloadBoard(), 1000);
                } catch (error) {
                    showNotification(error.message || 'خطا در ایجاد وضعیت', 'error');
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText || '<i class="bi bi-plus-circle"></i> ایجاد وضعیت';
                    }
                }
            })();
        }

        async function deleteStatus(statusId, statusName = '') {
            if (!canManageStatuses) {
                showNotification('اسپرینت تکمیل‌شده قابل ویرایش نیست', 'error');
                return;
            }

            if (!statusId) {
                return;
            }

            const confirmed = confirm(`آیا از حذف وضعیت "${statusName || ''}" مطمئن هستید؟\nتمام کارهای این وضعیت به وضعیت شروع منتقل می‌شوند.`);
            if (!confirmed) {
                return;
            }

            try {
                const data = await postJson('/WorkflowStatus/DeleteInline', { statusId });
                showNotification(data.message || 'وضعیت حذف شد', 'success');
                setTimeout(() => reloadBoard(), 800);
            } catch (error) {
                showNotification(error.message || 'خطا در حذف وضعیت', 'error');
            }
        }
        window.openAddStatusModal = openAddStatusModal;
        window.submitStatus = submitStatus;
        window.deleteStatus = deleteStatus;

        function onDragIssue(e, issueId) {
            isDragging = true;
            draggedIssueId = issueId;
            draggedCard = e.currentTarget;
            draggedCard.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', issueId);
            draggedCard.style.height = `${draggedCard.offsetHeight}px`;
        }

        // اگر drag از روی لینک/دکمه داخل کارت شروع شود، مرورگر ممکن است خود element را drag کند
        // و onDragIssue اجرا نشود؛ در نتیجه issueId خالی می‌شود و جابه‌جایی ظاهراً گیر می‌کند.
        document.addEventListener('dragstart', function (e) {
            if (e.target.closest('.task-card a, .task-card button')) {
                e.preventDefault();
            }
        }, true);

        function cleanupStaleModalBackdrops() {
            const hasOpenModal = !!document.querySelector('.modal.show');
            if (hasOpenModal) return;

            document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('padding-right');
            document.body.style.removeProperty('overflow');
        }

        document.addEventListener('hidden.bs.modal', function () {
            setTimeout(cleanupStaleModalBackdrops, 0);
        });
        document.addEventListener('DOMContentLoaded', function () {
            cleanupStaleModalBackdrops();
        });

        function handleCardClick(e, issueId) {
            // اگر drag در حال انجام است یا از دکمه/لینک کلیک شده، از redirect جلوگیری کن
            if (isDragging) {
                return;
            }
            if (draggedCard) {
                draggedCard.style.height = '';
            }
            // بررسی اینکه آیا از دکمه یا لینک کلیک شده یا نه
            if (e.target.closest('button') || e.target.closest('a')) {
                return;
            }
            // در غیر این صورت، به جزئیات کار برو
            // window.location.href = '/Tasks/Details/' + issueId;
            openEditTaskModal(issueId)
        }

        // متغیرهای touch برای موبایل
        let touchStartX = 0;
        let touchStartY = 0;
        let touchStartTime = 0;
        let touchCard = null;
        let touchScrollStartX = 0;
        let touchScrollStartY = 0;
        let isTouchScrolling = false;

        // ثبت موقعیت mouse down برای تشخیص drag vs click
        document.addEventListener('mousedown', function(e) {
            if (e.target.closest('.task-card')) {
                mouseDownX = e.clientX;
                mouseDownY = e.clientY;
            }
        });

        // بررسی اینکه آیا واقعاً drag شده یا فقط click
        document.addEventListener('mousemove', function(e) {
            if (mouseDownX !== 0 && mouseDownY !== 0) {
                const deltaX = Math.abs(e.clientX - mouseDownX);
                const deltaY = Math.abs(e.clientY - mouseDownY);
                // اگر بیش از 5 پیکسل حرکت کرده، drag است
                if (deltaX > 5 || deltaY > 5) {
                    isDragging = true;
                }
            }
        });

        // Reset موقعیت mouse بعد از mouse up
        document.addEventListener('mouseup', function(e) {
            if (!isDragging) {
                mouseDownX = 0;
                mouseDownY = 0;
            }
        });

        // Touch events برای موبایل
        document.addEventListener('touchstart', function(e) {
            const card = e.target.closest('.task-card');
            if (!card || !card.draggable) return;
            
            // اگر روی دکمه یا لینک کلیک شده، drag نکن
            if (e.target.closest('button') || e.target.closest('a')) {
                return;
            }
            
            const touch = e.touches[0];
            touchStartX = touch.clientX;
            touchStartY = touch.clientY;
            touchStartTime = Date.now();
            touchCard = card;
            touchScrollStartX = touch.clientX;
            touchScrollStartY = touch.clientY;
            isTouchScrolling = false;
        }, { passive: true });

        document.addEventListener('touchmove', function(e) {
            if (!touchCard) return;
            
            const touch = e.touches[0];
            const deltaX = touch.clientX - touchStartX;
            const deltaY = touch.clientY - touchStartY;
            const absDeltaX = Math.abs(deltaX);
            const absDeltaY = Math.abs(deltaY);
            
            // اگر حرکت کمتر از 10 پیکسل باشد، هنوز تصمیم نگرفته‌ایم
            if (absDeltaX < 10 && absDeltaY < 10) {
                return;
            }
            
            // اگر حرکت عمودی بیشتر باشد، این scroll است
            if (absDeltaY > absDeltaX && absDeltaY > 15) {
                isTouchScrolling = true;
                touchCard = null;
                return;
            }
            
            // اگر حرکت افقی بیشتر باشد و هنوز scroll نشده، این drag است
            if (absDeltaX > absDeltaY && absDeltaX > 15 && !isTouchScrolling) {
                e.preventDefault();
                e.stopPropagation();
                
                touchCard.classList.add('dragging');
                touchCard.style.opacity = '0.6';
                touchCard.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
                touchCard.style.zIndex = '1000';
                touchCard.style.position = 'relative';
                touchCard.style.transition = 'none';
                
                // پیدا کردن ستون هدف
                const elementBelow = document.elementFromPoint(touch.clientX, touch.clientY);
                const targetColumn = elementBelow?.closest('.column-tasks');
                const currentColumn = touchCard.closest('.column-tasks');
                
                // پاک کردن highlight قبلی
                document.querySelectorAll('.column-tasks').forEach(zone => {
                    if (zone !== targetColumn) {
                        highlightDropZone(zone, false);
                    }
                });
                
                if (targetColumn && targetColumn !== currentColumn) {
                    highlightDropZone(targetColumn, true);
                }
            }
        }, { passive: false });

        document.addEventListener('touchend', function(e) {
            if (!touchCard) return;
            
            const touch = e.changedTouches[0];
            const deltaX = touch.clientX - touchStartX;
            const deltaY = touch.clientY - touchStartY;
            const deltaTime = Date.now() - touchStartTime;
            const absDeltaX = Math.abs(deltaX);
            const absDeltaY = Math.abs(deltaY);
            
            // اگر drag انجام شده (نه scroll و نه tap)
            if (!isTouchScrolling && (absDeltaX > 30 || absDeltaY > 30)) {
                e.preventDefault();
                e.stopPropagation();
                
                // پیدا کردن ستون هدف
                const elementBelow = document.elementFromPoint(touch.clientX, touch.clientY);
                const targetColumnBody = elementBelow?.closest('.column-tasks');
                const currentColumnBody = touchCard.closest('.column-tasks');
                
                if (targetColumnBody && targetColumnBody !== currentColumnBody) {
                    const rawTargetStatusId = targetColumnBody.dataset.statusId;
                    const targetStatusId = rawTargetStatusId ? parseInt(rawTargetStatusId, 10) : null;
                    const issueId = parseInt(touchCard.dataset.issueId);
                    
                    if (issueId && (targetStatusId === null || !Number.isNaN(targetStatusId))) {
                        // انتقال task
                        handleTouchDrop(issueId, targetStatusId, touchCard, targetColumnBody);
                    } else {
                        // اگر انتقال انجام نشد، استایل را برگردان
                        touchCard.classList.remove('dragging');
                        touchCard.style.opacity = '';
                        touchCard.style.transform = '';
                        touchCard.style.zIndex = '';
                        touchCard.style.position = '';
                        touchCard.style.transition = '';
                    }
                } else {
                    // اگر ستون هدف پیدا نشد، استایل را برگردان
                    touchCard.classList.remove('dragging');
                    touchCard.style.opacity = '';
                    touchCard.style.transform = '';
                    touchCard.style.zIndex = '';
                    touchCard.style.position = '';
                    touchCard.style.transition = '';
                }
            } else if (deltaTime < 300 && absDeltaX < 10 && absDeltaY < 10) {
                // این یک tap است، نه drag - به جزئیات برو
                const issueId = parseInt(touchCard.dataset.issueId);
                if (issueId && !e.target.closest('button') && !e.target.closest('a')) {
                    // window.location.href = '/Tasks/Details/' + issueId;
                    openEditTaskModal(issueId);

                }
            } else {
                // اگر drag نبود، استایل را برگردان
                touchCard.classList.remove('dragging');
                touchCard.style.opacity = '';
                touchCard.style.transform = '';
                touchCard.style.zIndex = '';
                touchCard.style.position = '';
                touchCard.style.transition = '';
            }
            
            // پاک کردن highlight
            document.querySelectorAll('.column-tasks').forEach(zone => {
                highlightDropZone(zone, false);
            });
            
            // Reset
            touchCard = null;
            touchStartX = 0;
            touchStartY = 0;
            isTouchScrolling = false;
        }, { passive: false });

        // تابع helper برای handle کردن drop در touch
        async function handleTouchDrop(issueId, toStatusId, card, dropZone) {
            if (!issueId) return;
            
            card.style.opacity = '0.5';
            
            try {
                const isBacklogDrop = toStatusId === null || toStatusId === undefined || toStatusId === '';
                if (isBacklogDrop) {
                    await window.moveIssueToBacklog(issueId, card);
                    return;
                }

                const res = await fetch('/Tasks/MoveIssue', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ 
                        taskId: issueId, 
                        toStatusId: toStatusId,
                        reason: 'تماس از تخته کانبان (موبایل)'
                    })
                });

                if (!res.ok) {
                    const errorText = await res.text();
                    showNotification('خطا: ' + (errorText || 'خطا در انتقال وضعیت'), 'error');
                    card.style.opacity = '1';
                    return;
                }

                const result = await res.json();
                updateCardCompletedState(card, result?.isCompleted);
                
                card.classList.remove('dragging');
                card.style.opacity = '1';
                card.style.transform = '';
                
                const sourceColumn = card.closest('.column-tasks');
                
                if (dropZone) {
                    const emptyMessage = dropZone.querySelector('.empty-message');
                    if (emptyMessage) {
                        emptyMessage.remove();
                    }
                    
                    const firstCard = dropZone.querySelector('.task-card:not(.dragging)');
                    if (firstCard && firstCard !== card) {
                        dropZone.insertBefore(card, firstCard);
                    } else {
                        dropZone.insertBefore(card, dropZone.firstChild);
                    }
                }
                
                if (sourceColumn && sourceColumn !== dropZone) {
                    const sourceCards = sourceColumn.querySelectorAll('.task-card');
                    if (sourceCards.length === 0) {
                        const sourceEmptyMessage = sourceColumn.querySelector('.empty-message');
                        if (sourceEmptyMessage) {
                            sourceEmptyMessage.style.display = 'block';
                        } else {
                            const emptyMsg = document.createElement('div');
                            emptyMsg.className = 'empty-message text-muted text-center small p-4';
                            emptyMsg.innerHTML = '<span class="column-empty-msg-inner"><i class="bi bi-inbox" aria-hidden="true"></i><span>هیچ آیتمی وجود ندارد</span></span>';
                            sourceColumn.appendChild(emptyMsg);
                        }
                    }
                }
                
                updateIssueCounts();
                showNotification('کار با موفقیت منتقل شد', 'success');
            } catch (err) {
                console.error('Error:', err);
                showNotification('خطای شبکه: ' + err.message, 'error');
                card.style.opacity = '1';
            }
        }

        async function moveIssueToBacklog(issueId, card) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const body = new URLSearchParams({
                sprintId: String(sprintId),
                taskId: String(issueId)
            });

            const res = await fetch('/Sprints/RemoveTaskFromSprint', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest',
                    ...(token ? { 'RequestVerificationToken': token } : {})
                },
                body: body.toString()
            });

            let result = null;
            try {
                result = await res.json();
            } catch (_) {
                result = null;
            }

            if (!res.ok || !result?.success) {
                throw new Error(result?.message || 'خطا در انتقال کار به بک‌لاگ');
            }

            if (card) {
                card.remove();
                updateIssueCounts();
            }

            showNotification('کار با موفقیت به بک‌لاگ منتقل شد', 'success');
            if (typeof loadAvailableTasks === 'function') {
                loadAvailableTasks();
            }
        }
        window.moveIssueToBacklog = moveIssueToBacklog;

        function getDropZoneElement(element) {
            if (!element) return null;
            return element.classList?.contains('column-tasks')
                ? element
                : element.querySelector?.('.column-tasks');
        }

        function onDragOverColumn(e) {
            e.preventDefault();
            if (isColumnDragging) {
                // اگر در حال drag کردن ستون هستیم، highlight ستون مقصد
                const targetColumn = e.currentTarget.closest('.kanban-column');
                if (targetColumn && targetColumn !== draggedColumnElement) {
                    highlightColumnTarget(targetColumn, true);
                }
                return;
            }
            // برای drag کردن کارها
            if (e.dataTransfer) {
                e.dataTransfer.dropEffect = 'move';
            }
        }

        function highlightDropZone(element, isActive) {
            const zone = getDropZoneElement(element);
            if (!zone) return;
            if (isActive) {
                zone.style.backgroundColor = '#e3f2fd';
                zone.style.borderColor = '#2196f3';
            } else {
                zone.style.backgroundColor = '';
                zone.style.borderColor = '';
            }
        }

        function onDragEnter(e) {
            e.preventDefault();
            if (isColumnDragging) {
                highlightColumnTarget(e.currentTarget.closest('.kanban-column'), true);
                return;
            }
            highlightDropZone(e.currentTarget, true);
        }

        function onDragLeave(e) {
            if (isColumnDragging) {
                highlightColumnTarget(e.currentTarget.closest('.kanban-column'), false);
                return;
            }
            highlightDropZone(e.currentTarget, false);
        }

        async function onDropIssue(e, toStatusId) {
            e.preventDefault();
            if (isColumnDragging) {
                const columnElement = e.currentTarget.closest('.kanban-column');
                highlightColumnTarget(columnElement, false);
                handleColumnDrop(columnElement);
                return;
            }

            const dropZone = getDropZoneElement(e.currentTarget);
            if (dropZone) {
                highlightDropZone(dropZone, false);
            }
            
            const issueId = draggedIssueId || parseInt(e.dataTransfer.getData('text/plain'));
            if (!issueId) return;

            if (draggedCard) {
                draggedCard.style.opacity = '0.5';
            }

            try {
                const isBacklogDrop = toStatusId === null || toStatusId === undefined || toStatusId === '';
                if (isBacklogDrop) {
                    await window.moveIssueToBacklog(issueId, draggedCard);
                    return;
                }

                const res = await fetch('/Tasks/MoveIssue', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ 
                        taskId: issueId, 
                        toStatusId: toStatusId,
                        reason: 'تماس از تخته کانبان'
                    })
                });

                if (!res.ok) {
                    const errorText = await res.text();
                    alert('خطا: ' + errorText || 'خطا در انتقال وضعیت');
                    if (draggedCard) {
                        draggedCard.style.opacity = '1';
                    }
                    return;
                }

                const result = await res.json();
                console.log('Success:', result);
                updateCardCompletedState(draggedCard, result?.isCompleted);

                if (draggedCard) {
                    draggedCard.classList.remove('dragging');
                    draggedCard.style.opacity = '1';
                    
                    const sourceColumn = draggedCard.closest('.column-tasks');
                    
                    if (dropZone) {
                        const emptyMessage = dropZone.querySelector('.empty-message');
                        if (emptyMessage) {
                            emptyMessage.remove();
                        }
                        
                        // قرار دادن کارت در ابتدای لیست (قبل از همه کارت‌های دیگر)
                        const firstCard = dropZone.querySelector('.task-card:not(.dragging)');
                        if (firstCard && firstCard !== draggedCard) {
                            dropZone.insertBefore(draggedCard, firstCard);
                        } else {
                            // اگر کارت دیگری وجود ندارد یا این کارت اولین است، از prepend استفاده کن
                            dropZone.insertBefore(draggedCard, dropZone.firstChild);
                        }
                    }
                    
                    if (sourceColumn && sourceColumn !== dropZone) {
                        const sourceCards = sourceColumn.querySelectorAll('.task-card');
                        if (sourceCards.length === 0) {
                            const sourceEmptyMessage = sourceColumn.querySelector('.empty-message');
                            if (sourceEmptyMessage) {
                                sourceEmptyMessage.style.display = 'block';
                            } else {
                                const emptyMsg = document.createElement('div');
                                emptyMsg.className = 'empty-message text-muted text-center small p-4';
                                emptyMsg.innerHTML = '<span class="column-empty-msg-inner"><i class="bi bi-inbox" aria-hidden="true"></i><span>هیچ آیتمی وجود ندارد</span></span>';
                                sourceColumn.appendChild(emptyMsg);
                            }
                        }
                    }
                    
                    updateIssueCounts();
                } else {
                    reloadBoard();
                }

            } catch (err) {
                console.error('Error:', err);
                alert('خطای شبکه: ' + err.message);
                if (draggedCard) {
                    draggedCard.style.opacity = '1';
                }
            } finally {
                draggedIssueId = null;
                draggedCard = null;
            }
        }
        // Register critical inline DnD handlers immediately after declaration
        // so later unrelated script errors do not break drag/drop availability.
        window.onDragOverColumn = onDragOverColumn;
        window.onDragEnter = onDragEnter;
        window.onDragLeave = onDragLeave;
        window.onDropIssue = onDropIssue;

        async function completeTask(taskId) {
            if (!taskId) return;
            if (!finalStatusId) {
                showNotification('ستون نهایی برای این اسپرینت تعریف نشده است', 'error');
                return;
            }

            // دریافت اطلاعات کار برای نمایش در پیغام تایید
            const card = document.querySelector(`.task-card[data-issue-id="${taskId}"]`);
            const taskTitle = card?.dataset.title || 'این کار';
            const taskKey = card?.dataset.key || '';
            
            // نمایش پیغام تایید
            const confirmMessage = `آیا مطمئن هستید که می‌خواهید کار "${taskKey}: ${taskTitle}" را خاتمه دهید؟\n\nاین کار به ستون "${finalStatusName}" منتقل خواهد شد.`;
            if (!confirm(confirmMessage)) {
                return;
            }

            const previousOpacity = card ? card.style.opacity : null;
            if (card) {
                card.style.opacity = '0.5';
            }

            try {
                await postJson('/Tasks/MoveIssue', {
                    taskId: taskId,
                    toStatusId: finalStatusId,
                    reason: 'تکمیل از طریق دکمه'
                });

                const moved = moveCardToColumn(card, finalStatusId, finalStatusName);
                if (!moved) {
                    setTimeout(() => reloadBoard(), 500);
                } else {
                    showNotification('کار با موفقیت خاتمه یافت.', 'success');
                }
            } catch (error) {
                showNotification(error.message || 'خطا در خاتمه کار', 'error');
                if (card) {
                    card.style.opacity = previousOpacity ?? '1';
                }
            } finally {
                if (card) {
                    card.style.opacity = '1';
                }
            }
        }


                


        function countVisibleTaskCards(columnBody) {
            if (!columnBody) return 0;
            return columnBody.querySelectorAll('.task-card:not(.filtered-out)').length;
        }

        function updateIssueCounts() {
            document.querySelectorAll('.kanban-column').forEach(column => {
                const body = column.querySelector('.column-tasks');
                const count = countVisibleTaskCards(body);
                const badge = column.querySelector('.column-header .badge');
                if (badge) {
                    badge.textContent = count;
                }
            });

            const backlogBody = document.getElementById('tasks-backlog');
            const backlogCount = countVisibleTaskCards(backlogBody);
            const backlogCountBadge = document.getElementById('backlogCountBadge');
            const backlogToggleBadge = document.getElementById('backlogToggleBadge');
            if (backlogCountBadge) {
                backlogCountBadge.textContent = backlogCount;
            }
            if (backlogToggleBadge) {
                backlogToggleBadge.textContent = backlogCount;
            }
        }

        function setBoardViewMode(mode) {
            const boardColumns = document.getElementById('boardColumns');
            const backlogPanel = document.getElementById('backlogPanel');
            const showBacklogBtn = document.getElementById('showBacklogBtn');
            const showBoardBtn = document.getElementById('showBoardBtn');
            const isBacklog = mode === 'backlog';

            if (boardColumns) {
                boardColumns.style.display = isBacklog ? 'none' : '';
            }
            if (backlogPanel) {
                backlogPanel.classList.toggle('is-visible', isBacklog);
                backlogPanel.setAttribute('aria-hidden', isBacklog ? 'false' : 'true');
            }
            if (showBacklogBtn) {
                showBacklogBtn.style.display = isBacklog ? 'none' : '';
            }
            if (showBoardBtn) {
                showBoardBtn.style.display = isBacklog ? '' : 'none';
            }

            try {
                const state = loadBoardState() || {};
                state.viewMode = isBacklog ? 'backlog' : 'board';
                sessionStorage.setItem(BOARD_STATE_KEY, JSON.stringify(state));
            } catch (_) { /* ignore */ }
        }

        function showBacklogView() {
            setBoardViewMode('backlog');
            applyBoardFilters();
        }

        function showBoardView() {
            setBoardViewMode('board');
            applyBoardFilters();
        }

        function updateTaskCardFromEdit(formData) {
            const card = document.querySelector(`.task-card[data-issue-id="${formData.Id}"]`);
            if (!card) return false;

            card.dataset.title = formData.Title || '';
            const titleLink = card.querySelector('.task-title a');
            if (titleLink) {
                titleLink.textContent = formData.Title || '';
            }

            const assigneeSelect = document.getElementById('editTaskAssignedUser');
            const assigneeId = formData.AssignedUserId || 'unassigned';
            card.dataset.assigneeId = assigneeId;
            let assigneeName = 'نامشخص';
            if (assigneeSelect && assigneeId && assigneeId !== 'unassigned') {
                const opt = assigneeSelect.querySelector(`option[value="${CSS.escape(assigneeId)}"]`);
                assigneeName = opt ? opt.textContent.trim() : assigneeName;
            }
            card.dataset.assignee = assigneeName;
            const metaDiv = card.querySelector('.task-meta div');
            if (metaDiv) {
                metaDiv.textContent = `👤 ${assigneeName}`;
            }

            applyBoardFilters();
            return true;
        }

        // باز کردن modal ویرایش تسک
        // ذخیره اطلاعات اصلی تسک برای استفاده در submit
        let originalTaskData = null;
        let boardSubtaskParentId = null;
        let boardSubtaskPanelBound = false;

        function renderBoardSubtasks(items) {
            const listEl = document.getElementById('boardInlineSubtasksList');
            if (!listEl) return;
            const subtasks = Array.isArray(items) ? items : [];
            const badge = document.getElementById('boardSubtaskProgressBadge');
            if (badge) {
                const done = subtasks.filter(s => s.isCompleted).length;
                badge.textContent = subtasks.length ? `${done}/${subtasks.length}` : '0/0';
            }
            if (subtasks.length === 0) {
                listEl.innerHTML = '<li class="subtask-empty-board">هنوز کارکی ثبت نشده است.</li>';
                return;
            }
            listEl.innerHTML = subtasks.map(st => {
                const id = Number(st.id || 0);
                const title = escapeHtml(st.title || '');
                const completed = !!st.isCompleted;
                return `
                    <li class="subtask-item-board" data-subtask-id="${id}">
                        <div class="subtask-item-main-board">
                            <input type="checkbox" class="board-subtask-check" data-subtask-id="${id}" ${completed ? 'checked' : ''} />
                            <span class="subtask-title-board editable ${completed ? 'completed' : ''}" data-subtask-id="${id}" title="برای ویرایش کلیک کنید">${title}</span>
                        </div>
                        <div class="subtask-item-actions-board">
                            <button type="button" class="subtask-edit-btn-board" data-subtask-id="${id}" title="ویرایش" aria-label="ویرایش"><i class="bi bi-pencil"></i></button>
                            <button type="button" class="subtask-delete-btn-board" data-subtask-id="${id}" title="حذف" aria-label="حذف"><i class="bi bi-trash"></i></button>
                        </div>
                    </li>
                `;
            }).join('');
        }

        function beginBoardSubtaskEdit(subtaskId) {
            const listEl = document.getElementById('boardInlineSubtasksList');
            if (!listEl) return;
            const li = listEl.querySelector(`.subtask-item-board[data-subtask-id="${subtaskId}"]`);
            if (!li || li.querySelector('.subtask-edit-input-board')) return;

            const titleSpan = li.querySelector('.subtask-title-board');
            if (!titleSpan) return;
            const currentTitle = titleSpan.textContent.trim();
            const completed = titleSpan.classList.contains('completed');

            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'form-control form-control-sm subtask-edit-input-board';
            input.value = currentTitle;
            input.maxLength = 500;
            titleSpan.replaceWith(input);
            input.focus();
            input.select();

            let saving = false;
            const restoreTitle = (text) => {
                const span = document.createElement('span');
                span.className = `subtask-title-board editable${completed ? ' completed' : ''}`;
                span.dataset.subtaskId = String(subtaskId);
                span.title = 'برای ویرایش کلیک کنید';
                span.textContent = text;
                input.replaceWith(span);
            };

            const cancelEdit = () => {
                if (saving) return;
                restoreTitle(currentTitle);
            };

            const commitEdit = async () => {
                if (saving) return;
                const noteEl = document.getElementById('boardInlineSubtaskNote');
                const newTitle = input.value.trim();
                if (!newTitle) {
                    if (noteEl) noteEl.textContent = 'عنوان کارک الزامی است.';
                    input.focus();
                    return;
                }
                if (newTitle === currentTitle) {
                    cancelEdit();
                    return;
                }
                saving = true;
                try {
                    if (noteEl) noteEl.textContent = 'در حال ذخیره...';
                    await updateBoardSubtask(subtaskId, newTitle);
                    if (noteEl) noteEl.textContent = '';
                } catch (error) {
                    if (noteEl) noteEl.textContent = (error && error.message) || 'ویرایش کارک انجام نشد.';
                    saving = false;
                    restoreTitle(currentTitle);
                }
            };

            input.addEventListener('keydown', function (ev) {
                if (ev.key === 'Enter') {
                    ev.preventDefault();
                    commitEdit();
                } else if (ev.key === 'Escape') {
                    ev.preventDefault();
                    cancelEdit();
                }
            });
            input.addEventListener('blur', function () {
                setTimeout(function () {
                    if (document.activeElement === input) return;
                    commitEdit();
                }, 120);
            });
        }

        async function updateBoardSubtask(subtaskId, title) {
            const response = await fetch('/Tasks/UpdateInlineSubtask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ subtaskId, title })
            });
            if (!response.ok) {
                const errText = await response.text();
                throw new Error(errText || 'update_failed');
            }
            const result = await response.json();
            if (!result.success) {
                throw new Error(result.message || 'update_failed');
            }
            if (boardSubtaskParentId) {
                await loadBoardSubtasks(boardSubtaskParentId);
            }
        }

        async function loadBoardSubtasks(parentId) {
            const listEl = document.getElementById('boardInlineSubtasksList');
            if (!listEl) return;
            try {
                const response = await fetch(`/Tasks/GetSubtasks?parentId=${parentId}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!response.ok) throw new Error('load_failed');
                const data = await response.json();
                renderBoardSubtasks(data);
            } catch {
                listEl.innerHTML = '<li class="subtask-empty-board">خطا در دریافت کارک‌ها.</li>';
            }
        }

        async function addBoardSubtask(parentId) {
            const input = document.getElementById('boardInlineSubtaskTitle');
            const noteEl = document.getElementById('boardInlineSubtaskNote');
            if (!input) return;
            const title = (input.value || '').trim();
            if (!title) {
                if (noteEl) noteEl.textContent = 'عنوان کارک الزامی است.';
                return;
            }
            try {
                if (noteEl) noteEl.textContent = 'در حال افزودن...';
                const response = await fetch('/Tasks/AddInlineSubtask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ parentId, title })
                });
                if (!response.ok) {
                    const err = await response.text();
                    throw new Error(err || 'add_failed');
                }
                input.value = '';
                if (noteEl) noteEl.textContent = '';
                await loadBoardSubtasks(parentId);
            } catch (error) {
                if (noteEl) noteEl.textContent = (error && error.message) || 'افزودن کارک انجام نشد.';
            }
        }

        async function toggleBoardSubtask(subtaskId) {
            const noteEl = document.getElementById('boardInlineSubtaskNote');
            try {
                const response = await fetch('/Tasks/ToggleInlineSubtask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ subtaskId })
                });
                if (!response.ok) {
                    const err = await response.text();
                    throw new Error(err || 'toggle_failed');
                }
                if (boardSubtaskParentId) await loadBoardSubtasks(boardSubtaskParentId);
            } catch (error) {
                if (noteEl) noteEl.textContent = (error && error.message) || 'تغییر وضعیت کارک انجام نشد.';
                if (boardSubtaskParentId) await loadBoardSubtasks(boardSubtaskParentId);
            }
        }

        async function deleteBoardSubtask(subtaskId) {
            const noteEl = document.getElementById('boardInlineSubtaskNote');
            if (!confirm('این کارک حذف شود؟')) return;
            try {
                const response = await fetch('/Tasks/DeleteTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ taskId: subtaskId })
                });
                if (!response.ok) {
                    const err = await response.text();
                    throw new Error(err || 'delete_failed');
                }
                if (boardSubtaskParentId) await loadBoardSubtasks(boardSubtaskParentId);
            } catch (error) {
                if (noteEl) noteEl.textContent = (error && error.message) || 'حذف کارک انجام نشد.';
            }
        }

        function ensureBoardSubtaskPanelBound() {
            if (boardSubtaskPanelBound) return;
            const addBtn = document.getElementById('boardAddSubtaskBtn');
            const input = document.getElementById('boardInlineSubtaskTitle');
            const listEl = document.getElementById('boardInlineSubtasksList');
            if (!addBtn || !input) return;
            boardSubtaskPanelBound = true;
            addBtn.addEventListener('click', function () {
                if (boardSubtaskParentId) addBoardSubtask(boardSubtaskParentId);
            });
            input.addEventListener('keydown', function (ev) {
                if (ev.key === 'Enter') {
                    ev.preventDefault();
                    if (boardSubtaskParentId) addBoardSubtask(boardSubtaskParentId);
                }
            });
            if (listEl && !listEl.dataset.delegationBound) {
                listEl.dataset.delegationBound = '1';
                listEl.addEventListener('change', function (e) {
                    const t = e.target;
                    if (t.classList && t.classList.contains('board-subtask-check')) {
                        const sid = parseInt(t.getAttribute('data-subtask-id'), 10);
                        if (sid) toggleBoardSubtask(sid);
                    }
                });
                listEl.addEventListener('click', function (e) {
                    const editBtn = e.target.closest('.subtask-edit-btn-board');
                    if (editBtn) {
                        e.preventDefault();
                        const sid = parseInt(editBtn.getAttribute('data-subtask-id'), 10);
                        if (sid) beginBoardSubtaskEdit(sid);
                        return;
                    }
                    const titleEl = e.target.closest('.subtask-title-board.editable');
                    if (titleEl) {
                        const sid = parseInt(titleEl.getAttribute('data-subtask-id'), 10);
                        if (sid) beginBoardSubtaskEdit(sid);
                        return;
                    }
                    const btn = e.target.closest('.subtask-delete-btn-board');
                    if (btn) {
                        const sid = parseInt(btn.getAttribute('data-subtask-id'), 10);
                        if (sid) deleteBoardSubtask(sid);
                    }
                });
            }
        }

        function mapStoryPointsToEffortLevel(storyPoints) {
            const points = Number(storyPoints);
            if (!Number.isFinite(points)) return null;
            if (points <= 3) return 1;
            if (points <= 8) return 2;
            return 3;
        }

        function effortLevelToLabel(level) {
            const levelInt = Number(level);
            if (levelInt === 1) return 'ساده';
            if (levelInt === 2) return 'متوسط';
            if (levelInt === 3) return 'پرزحمت';
            return 'تعیین نشده';
        }
        
        async function openEditTaskModal(taskId) {
            if (!taskId) {
                showNotification('شناسه کار نامعتبر است', 'error');
                return;
            }

