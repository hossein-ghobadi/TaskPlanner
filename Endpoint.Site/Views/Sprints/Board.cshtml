@using System.Security.Claims
@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var projectMembers = ViewBag.ProjectMembers as List<ProjectMemberVm> ?? new List<ProjectMemberVm>();
    var projectCreator = projectMembers.FirstOrDefault(m => m.FullName?.Contains("سازنده پروژه") == true);
    var creatorName = projectCreator?.FullName?.Replace(" - سازنده پروژه", "") ?? "نامشخص";
}

<div class="board-container board-bg-plain" id="boardContainer">
    <div class="board-header">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h2>@Model.SprintName</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted mb-2">@Model.Description</p>
                }
                <div class="d-flex gap-3 align-items-center">
                    <small class="text-muted">
                        <i class="bi bi-person"></i>
                        سازنده: @creatorName
                    </small>
                    <small class="text-muted">
                        <i class="bi bi-folder"></i>
                        پروژه: <a href="/Projects/Details/@Model.ProjectId" class="text-decoration-none">@Model.ProjectName</a>
                    </small>
                    <small class="text-muted">
                        <i class="bi bi-list-task"></i>
                        @Model.TotalTasks.ToString().ToPersianNumbers() کار
                    </small>
                    <small class="text-muted">
                        <i class="bi bi-check-circle"></i>
                        @Model.CompletedTasks.ToString().ToPersianNumbers() انجام شده
                    </small>
                </div>
            </div>
            <div class="d-flex flex-column align-items-end gap-2">
                <div class="d-flex gap-2">
                    <a href="/Projects/Details/@Model.ProjectId" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-right"></i>
                        بازگشت به لیست
                    </a>
                    @if (Model.Status == SprintStatus.Active)
                    {
                        <form method="post" action="/Sprints/ChangeStatus" class="d-inline" id="completeSprintForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.SprintId" />
                            <input type="hidden" name="status" value="@((int)SprintStatus.Completed)" />
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="completeSprint()">
                                <i class="bi bi-check-circle"></i>
                                خاتمه اسپرینت
                            </button>
                        </form>
                    }
                    @if (Model.Status != SprintStatus.Completed)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="openAddStatusModal()">
                            <i class="bi bi-plus-circle"></i>
                            افزودن وضعیت
                        </button>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="boardBackgroundSelect" class="text-muted small mb-0">پس‌زمینه:</label>
                    <select id="boardBackgroundSelect" class="form-select form-select-sm" style="min-width: 170px;" onchange="changeBoardBackground(this.value)">
                        <option value="plain">ساده</option>
                        <option value="gradient">گرادیان</option>
                        <option value="soft">نرم و محو</option>
                        <option value="pattern">الگوی نقطه‌ای</option>
                        <option value="pastel">پاستلی</option>
                        <option value="photo-1">عکس ۱</option>
                        <option value="photo-2">عکس ۲</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- فیلترها (اختیاری - می‌تواند مخفی شود) -->
        <div class="board-toolbar mt-3" id="boardToolbar" style="display: none;">
            <input type="text" id="boardSearchInput" class="form-control toolbar-input" placeholder="جستجو..." style="min-width: 200px;">
            <select id="statusFilterSelect" class="form-select toolbar-select" style="min-width: 150px;">
                <option value="all">همه ستون‌ها</option>
                @foreach (var status in Model.Statuses.OrderBy(s => s.Order))
                {
                    <option value="@status.Id">@status.Name</option>
                }
            </select>
            <div class="d-flex align-items-center gap-2 flex-wrap" style="position: relative;">
                <select id="assigneeFilterSelect" class="form-select toolbar-select" style="min-width: 180px;">
                    <option value="all">همه افراد</option>
                    <option value="unassigned">تخصیص نیافته</option>
                    @foreach (var member in projectMembers)
                    {
                        <option value="@member.UserId">@(member.FullName ?? member.UserName)</option>
                    }
                </select>
                <span id="selectedAssigneeBadge" class="badge bg-primary d-none" style="font-size: 0.85rem;">
                    <i class="bi bi-funnel-fill"></i> 
                    <span id="selectedAssigneeName"></span>
                </span>
            </div>
