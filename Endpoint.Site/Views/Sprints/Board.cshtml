            // ساخت المان کامنت
            function parseReplyMeta(rawMessage) {
                const source = rawMessage || '';
                const structuredPattern = /^\[\[reply:(\d+):([^:\]]*):([^\]]*)\]\]\s*\n?/;
                const match = source.match(structuredPattern);
                if (match) {
                    const replyCommentId = parseInt(match[1], 10);
                    const userName = decodeURIComponent(match[2] || 'کاربر');
                    const target = decodeURIComponent(match[3] || 'متن پیوست');
                    return {
                        cleanMessage: source.replace(structuredPattern, '').trimStart(),
                        reply: {
                            commentId: Number.isNaN(replyCommentId) ? null : replyCommentId,
                            userName,
                            target
                        }
                    };
                }

                const legacyPattern = /^↪\s*پاسخ به\s+(.+?)\s*\((.+?)\)\s*\n?/;
                const legacy = source.match(legacyPattern);
                if (legacy) {
                    return {
                        cleanMessage: source.replace(legacyPattern, '').trimStart(),
                        reply: {
                            commentId: null,
                            userName: legacy[1] || 'کاربر',
                            target: legacy[2] || 'متن پیوست'
                        }
                    };
                }

                return { cleanMessage: source, reply: null };
            }

            function scrollToComment(commentId) {
                if (!commentId) {
                    showNotification('پیام مرجع یافت نشد', 'error');
                    return;
                }
                const targetEl = document.getElementById(`comment-${commentId}`);
                if (!targetEl) {
                    showNotification('پیام مرجع یافت نشد', 'error');
                    return;
                }
                const chatBox = document.getElementById('chatBox');
                if (chatBox) {
                    const targetTop = targetEl.offsetTop - 32;
                    chatBox.scrollTo({
                        top: Math.max(0, targetTop),
                        behavior: 'smooth'
                    });
                } else {
                    targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                targetEl.classList.add('target-highlight');
                setTimeout(() => targetEl.classList.remove('target-highlight'), 1800);
            }

            function escapeChatHtml(value) {
                return String(value ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function normalizeChatAttachmentUrl(rawUrl) {
                const value = String(rawUrl || '').trim();
                if (!value) return '';
                if (/^(https?:|blob:|data:)/i.test(value)) return value;
                return value.startsWith('/') ? value : `/${value}`;
            }

            /** لینک‌های http(s) داخل متن را برای همه کاربران قابل کلیک می‌کند */
            function linkifyChatText(text) {
                const source = String(text || '');
                if (!source) return '';
                const urlPattern = /(https?:\/\/[^\s<]+)/gi;
                let result = '';
                let lastIndex = 0;
                let match;
                while ((match = urlPattern.exec(source)) !== null) {
                    result += escapeChatHtml(source.slice(lastIndex, match.index));
                    const url = match[0].replace(/[.,);!?]+$/g, '');
                    const trailing = match[0].slice(url.length);
                    result += `<a href="${escapeChatHtml(url)}" target="_blank" rel="noopener noreferrer">${escapeChatHtml(url)}</a>${escapeChatHtml(trailing)}`;
                    lastIndex = match.index + match[0].length;
                }
                result += escapeChatHtml(source.slice(lastIndex));
                return result;
            }

            function createCommentElement(comment, commentsById) {
                const div = document.createElement('div');
                div.className = `chat-message ${comment.isCurrentUser ? 'own' : 'other'}`;
                div.id = `comment-${comment.id}`;
                const date = new Date(comment.createdAt).toLocaleString('fa-IR');
                const parsed = parseReplyMeta(comment.message);
                const cleanMessage = parsed.cleanMessage || '';
                const replyMeta = parsed.reply;
                const encodedUser = encodeURIComponent(comment.userName || 'کاربر');
                const encodedMessage = encodeURIComponent(cleanMessage);

                let replyReferenceHtml = '';
                if (replyMeta) {
                    const showTarget = replyMeta.target && replyMeta.target !== 'متن پیوست';
                    const replyTitle = showTarget
                        ? `در پاسخ به ${replyMeta.userName} (${replyMeta.target})`
                        : `در پاسخ به ${replyMeta.userName}`;
                    let replyPreviewHtml = '';
                    if (replyMeta.commentId && commentsById?.has(replyMeta.commentId)) {
                        const sourceComment = commentsById.get(replyMeta.commentId);
                        const sourceParsed = parseReplyMeta(sourceComment?.message || '');
                        const sourceText = (sourceParsed.cleanMessage || '').trim();
                        const sourcePreview = sourceText
                            ? (sourceText.length > 80 ? `${sourceText.substring(0, 80)}...` : sourceText)
                            : 'بدون متن';
                        replyPreviewHtml = `<div class="reply-reference-preview">${sourcePreview}</div>`;
                    }

                    if (replyMeta.commentId) {
                        replyReferenceHtml = `
                            <button type="button" class="reply-reference clickable js-scroll-to-reply" data-target-comment-id="${replyMeta.commentId}">
                                ${replyTitle}
                                ${replyPreviewHtml}
                            </button>
                        `;
                    } else {
                        replyReferenceHtml = `
                            <div class="reply-reference">
                                ${replyTitle}
                            </div>
                        `;
                    }
                }

                let attachmentsHtml = '';
                if (comment.attachments && comment.attachments.length > 0) {
                    attachmentsHtml = comment.attachments.map(att => {
                        // لینک فایل برای همه کاربران (نه فقط ارسال‌کننده)
                        const fileUrl = normalizeChatAttachmentUrl(att.filePath || att.FilePath || att.url || att.Url || '');
                        const fileName = att.fileName || att.FileName || 'فایل';
                        const safeFileName = escapeChatHtml(fileName);
                        const fileType = String(att.fileType || att.FileType || att.mimeType || att.MimeType || '');
                        const encodedTarget = encodeURIComponent(`فایل: ${fileName}`);
                        const openFileLink = fileUrl
                            ? `<a href="${escapeChatHtml(fileUrl)}" target="_blank" rel="noopener noreferrer" class="attachment-file-link">باز کردن فایل</a>`
                            : '';
                        const replyLink = `<a href="#" class="reply-inline-link js-reply-action" data-comment-id="${comment.id}" data-user="${encodedUser}" data-message="${encodedMessage}" data-target="${encodedTarget}">پاسخ به این فایل</a>`;
                        const actionsHtml = `<div class="attachment-actions">${openFileLink}${replyLink}</div>`;

                        if (/^image/i.test(fileType) || fileType === 'Image') {
                            return `
                                <div class="attachment-item">
                                    ${fileUrl ? `<a href="${escapeChatHtml(fileUrl)}" target="_blank" rel="noopener noreferrer"><img src="${escapeChatHtml(fileUrl)}" alt="${safeFileName}" style="max-width:200px; display:block; border-radius:8px;" /></a>` : `<span class="text-muted">${safeFileName}</span>`}
                                    ${actionsHtml}
                                </div>
                            `;
                        } else if (/^audio/i.test(fileType) || fileType === 'Audio') {
                            return `
                                <div class="attachment-item">
                                    ${fileUrl ? `<audio controls src="${escapeChatHtml(fileUrl)}" style="width:100%;"></audio>` : ''}
                                    ${actionsHtml}
                                </div>
                            `;
                        } else {
                            return `
                                <div class="attachment-item">
                                    ${fileUrl ? `<a href="${escapeChatHtml(fileUrl)}" target="_blank" rel="noopener noreferrer" class="attachment-file-link">📎 ${safeFileName}</a>` : `<span>📎 ${safeFileName}</span>`}
                                    ${actionsHtml}
                                </div>
                            `;
                        }
                    }).join('');
                }

                const textReplyLink = cleanMessage
                    ? `<a href="#" class="reply-inline-link js-reply-action" data-comment-id="${comment.id}" data-user="${encodedUser}" data-message="${encodedMessage}" data-target="${encodeURIComponent("متن پیوست")}">پاسخ به متن</a>`
                    : '';
                const deleteLink = comment.isCurrentUser
                    ? `<a href="#" class="reply-inline-link js-delete-comment" data-comment-id="${comment.id}">حذف</a>`
                    : '';

                div.innerHTML = `
                    <div class="message-card">
                        <div class="message-header">
                            <div class="message-user">${escapeChatHtml(comment.userName || 'کاربر')}</div>
                            <div class="message-time">${date}</div>
                        </div>
                        ${replyReferenceHtml}
                        ${cleanMessage ? `<div class="message-text">${linkifyChatText(cleanMessage)}</div>` : ''}
                        ${attachmentsHtml ? `<div class="attachment-list">${attachmentsHtml}</div>` : ''}
                        ${(textReplyLink || deleteLink) ? `<div class="message-actions">${textReplyLink}${deleteLink}</div>` : ''}
                    </div>
                `;

                const refBtn = div.querySelector('.js-scroll-to-reply');
                if (refBtn) {
                    refBtn.addEventListener('click', (event) => {
                        event.preventDefault();
                        const targetId = parseInt(refBtn.getAttribute('data-target-comment-id'), 10);
                        scrollToComment(Number.isNaN(targetId) ? null : targetId);
                    });
                }

                div.querySelectorAll('.js-reply-action').forEach((el) => {
                    el.addEventListener('click', (event) => {
                        event.preventDefault();
                        const commentId = parseInt(el.getAttribute('data-comment-id'), 10);
                        const user = el.getAttribute('data-user') || '';
                        const msg = el.getAttribute('data-message') || '';
                        const target = el.getAttribute('data-target') || '';
                        startReplyToComment(Number.isNaN(commentId) ? null : commentId, user, msg, target);
                    });
                });

                const deleteBtn = div.querySelector('.js-delete-comment');
                if (deleteBtn) {
                    deleteBtn.addEventListener('click', (event) => {
                        event.preventDefault();
                        const commentId = parseInt(deleteBtn.getAttribute('data-comment-id'), 10);
                        deleteComment(Number.isNaN(commentId) ? null : commentId, deleteBtn);
                    });
                }
                return div;
            }

            function startReplyToComment(commentId, encodedUserName, encodedMessage, encodedTarget) {
                const userName = decodeURIComponent(encodedUserName || '');
                const message = decodeURIComponent(encodedMessage || '');
                const target = decodeURIComponent(encodedTarget || 'پیوست');
                const compactMessage = message ? (message.length > 70 ? `${message.substring(0, 70)}...` : message) : 'بدون متن';
                const showTarget = target && target !== 'متن پیوست';

                replyContext = {
                    commentId,
                    userName: userName || 'کاربر',
                    target: target || 'پیوست',
                    preview: compactMessage
                };

                const replyInput = document.getElementById('replyToCommentId');
                const replyBox = document.getElementById('replyContextBox');
                const replyMeta = document.getElementById('replyContextMeta');
                const messageInput = document.getElementById('messageInput');

                if (replyInput) replyInput.value = String(commentId);
                if (replyMeta) {
                    replyMeta.innerHTML = showTarget
                        ? `<strong>پاسخ به ${replyContext.userName} (${replyContext.target})</strong>${replyContext.preview}`
                        : `<strong>پاسخ به ${replyContext.userName}</strong>${replyContext.preview}`;
                }
                if (replyBox) replyBox.classList.add('active');
                if (messageInput) {
                    messageInput.focus();
                    messageInput.placeholder = `پاسخ به ${replyContext.userName}...`;
                }
            }

            function clearReplyContext() {
                replyContext = null;
                const replyInput = document.getElementById('replyToCommentId');
                const replyBox = document.getElementById('replyContextBox');
                const messageInput = document.getElementById('messageInput');

                if (replyInput) replyInput.value = '';
                if (replyBox) replyBox.classList.remove('active');
                if (messageInput) messageInput.placeholder = 'توضیح پیوست را بنویسید...';
            }

            // نمایش فایل‌های انتخاب‌شده (فقط غیر تصویری)
                       // نمایش فایل‌های انتخاب‌شده (شامل تصویر و غیر تصویر)
            function showSelectedFiles() {
                const fileInput = document.getElementById('fileInput');
                const selectedFilesDiv = document.getElementById('selectedFiles');
