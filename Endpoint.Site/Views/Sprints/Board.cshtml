                         data-status-id="@status.Id"
                         data-status-order="@status.Order">
                        <div class="column-header"
                             draggable="@(Model.Status != SprintStatus.Completed ? "true" : "false")"
                             ondragstart="onColumnDragStart(event)"
                             ondragend="onColumnDragEnd(event)">
