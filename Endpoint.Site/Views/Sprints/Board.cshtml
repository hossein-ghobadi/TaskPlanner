@section Scripts {
    @await Html.PartialAsync("_DatePickerAssets")
    @Html.AntiForgeryToken()
    <script>
        const __noActiveSprintBoard = @(noActiveSprintBoard.ToString().ToLowerInvariant());
        if (__noActiveSprintBoard) {
            document.addEventListener('DOMContentLoaded', function () {
                if (window.$ && $.fn.persianDatepicker) {
                    $('#projectBoardCreateStartDisplay').persianDatepicker({
                        format: 'YYYY/MM/DD',
                        autoClose: true,
                        initialValue: true,
                        initialValueType: 'persian',
                        altField: '#projectBoardCreateStart',
                        altFormat: 'YYYY/MM/DD',
                        timePicker: { enabled: false },
                        calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' } }
                    });
                    $('#projectBoardCreateEndDisplay').persianDatepicker({
                        format: 'YYYY/MM/DD',
                        autoClose: true,
                        initialValue: true,
                        initialValueType: 'persian',
                        altField: '#projectBoardCreateEnd',
                        altFormat: 'YYYY/MM/DD',
                        timePicker: { enabled: false },
                        calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' } }
                    });
                    $('#projectBoardCreateStart').val($('#projectBoardCreateStartDisplay').val() || '');
                    $('#projectBoardCreateEnd').val($('#projectBoardCreateEndDisplay').val() || '');
                }
                if (@(openCreateFromProjectBoard.ToString().ToLowerInvariant())) {
                    var __pcmOpen = document.getElementById('projectBoardCreateSprintModal');
                    if (__pcmOpen && window.bootstrap) {
                        bootstrap.Modal.getOrCreateInstance(__pcmOpen).show();
                    }
                }
                var __params = new URLSearchParams(window.location.search);
                if (__params.get('openCreate') === 'true') {
                    var __pcm2 = document.getElementById('projectBoardCreateSprintModal');
                    if (__pcm2 && window.bootstrap) {
                        bootstrap.Modal.getOrCreateInstance(__pcm2).show();
                    }
                }
            });
        }

        if (!__noActiveSprintBoard) {
        let draggedIssueId = null;
        let draggedCard = null;
        let isDragging = false;
        let mouseDownX = 0;
        let mouseDownY = 0;
        let isColumnDragging = false;
        let draggedColumnElement = null;
        const projectId = @(projectId ?? 0);
        const sprintId = @(sprintId ?? 0);
        const canManageStatuses = @((Model.Status != SprintStatus.Completed).ToString().ToLower());
        const defaultStatusId = @(defaultStatus?.Id ?? 0);
        const defaultStatusName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaultStatusName));
        const finalStatusId = @(finalStatus?.Id ?? 0);
        const finalStatusName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalStatusName));
        const sprintIsActive = @(sprintIsActive.ToString().ToLower());
        const boardProjectMembers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(projectMembersForBoard));
        const boardDefaultIssueTypeId = @(defaultIssueType?.Id ?? 0);
        const boardDefaultIssueTypeBase = @((int)(defaultIssueType?.BaseType ?? IssueType.Task));
        const boardTodayPersian = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(boardTodayPersian));
        let quickTaskTargetStatusId = defaultStatusId;
        let quickTaskTargetStatusName = defaultStatusName;
        const boardFilters = {
            text: '',
            status: 'all',
            assignee: 'all',
            dueSoon: false
        };
        const BOARD_STATE_KEY = `boardState_sprint_${sprintId}`;

        function getBoardScrollEl() {
            return document.getElementById('board') || document.querySelector('.kanban-board');
        }

        function loadBoardState() {
            try {
                return JSON.parse(sessionStorage.getItem(BOARD_STATE_KEY) || 'null');
            } catch (_) {
                return null;
            }
        }

        function saveBoardState() {
            const board = getBoardScrollEl();
            const state = loadBoardState() || {};
            state.scrollLeft = board ? board.scrollLeft : 0;
            state.scrollY = window.scrollY || 0;
            state.filters = { ...boardFilters };
            sessionStorage.setItem(BOARD_STATE_KEY, JSON.stringify(state));
        }

        function persistBoardFilters() {
            const state = loadBoardState() || {};
            state.filters = { ...boardFilters };
            sessionStorage.setItem(BOARD_STATE_KEY, JSON.stringify(state));
        }

        function restoreBoardFiltersFromState(state) {
            if (!state?.filters) return;
            const f = state.filters;
            boardFilters.text = f.text || '';
            boardFilters.status = f.status || 'all';
            boardFilters.assignee = f.assignee || 'all';
            boardFilters.dueSoon = !!f.dueSoon;

            const searchInput = document.getElementById('boardSearchInput');
            const statusSelect = document.getElementById('statusFilterSelect');
            const assigneeSelect = document.getElementById('assigneeFilterSelect');
            const dueToggle = document.getElementById('dueSoonToggle');
            if (searchInput) searchInput.value = boardFilters.text;
            if (statusSelect) statusSelect.value = boardFilters.status;
            if (assigneeSelect) assigneeSelect.value = boardFilters.assignee;
            if (dueToggle) dueToggle.classList.toggle('active', boardFilters.dueSoon);

            const badge = document.getElementById('selectedAssigneeBadge');
            const badgeName = document.getElementById('selectedAssigneeName');
            if (badge && badgeName && assigneeSelect) {
                if (boardFilters.assignee === 'all') {
                    badge.classList.add('d-none');
                } else {
                    const opt = assigneeSelect.options[assigneeSelect.selectedIndex];
                    badgeName.textContent = boardFilters.assignee === 'unassigned' ? 'تخصیص نیافته' : (opt?.text || '');
                    badge.classList.remove('d-none');
                }
            }
        }

        function restoreBoardScrollFromState(state) {
            if (!state) return;
            const board = getBoardScrollEl();
            if (board && typeof state.scrollLeft === 'number') {
                board.scrollLeft = state.scrollLeft;
            }
            if (typeof state.scrollY === 'number') {
                window.scrollTo(0, state.scrollY);
            }
        }

        function highlightTaskCard(taskId) {
            const taskCard = document.querySelector(`.task-card[data-issue-id="${taskId}"]`);
            if (!taskCard) return;
            taskCard.style.transition = 'all 0.3s ease';
            taskCard.style.boxShadow = '0 0 20px rgba(37, 99, 235, 0.6)';
            taskCard.style.transform = 'scale(1.02)';
            setTimeout(function() {
                taskCard.style.boxShadow = '';
                taskCard.style.transform = '';
            }, 2000);
        }

        function setTaskModalMode(mode) {
            const isCreate = mode === 'create';
            document.getElementById('editTaskMode').value = mode;
            const titleEl = document.getElementById('editTaskModalLabel');
            const submitBtn = document.getElementById('editTaskSubmitBtn');
            const chatSection = document.querySelector('#editTaskModal .chat-container');
            const checklistPanel = document.getElementById('boardChecklistPanel');
            if (titleEl) {
                titleEl.innerHTML = isCreate
                    ? '<i class="bi bi-plus-circle me-2"></i>افزودن کار جدید'
                    : '<i class="bi bi-list-check me-2"></i>جزئیات و ویرایش کار';
            }
            if (submitBtn) {
                submitBtn.innerHTML = isCreate
                    ? '<i class="bi bi-plus-circle me-2"></i>افزودن کار'
                    : '<i class="bi bi-check-circle me-2"></i>ذخیره تغییرات';
            }
            if (chatSection) {
                chatSection.style.display = isCreate ? 'none' : '';
            }
            if (checklistPanel && isCreate) {
                checklistPanel.style.display = 'none';
                boardSubtaskParentId = null;
            }
        }

        function populateAssignedUserSelect(users, selectedId) {
            const assignedUserSelect = document.getElementById('editTaskAssignedUser');
            if (!assignedUserSelect) return;
            assignedUserSelect.innerHTML = '<option value="">-- انتخاب کاربر --</option>';
            (users || []).forEach(user => {
                const option = document.createElement('option');
                option.value = user.id;
                option.textContent = user.name;
                if (selectedId && user.id === selectedId) {
                    option.selected = true;
                }
                assignedUserSelect.appendChild(option);
            });
            assignedUserSelect.disabled = false;
        }

        function toLatinDigits(value) {
            if (!value) return '';
            return String(value)
                .replace(/[۰-۹]/g, (ch) => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(ch)))
                .replace(/[٠-٩]/g, (ch) => String('٠١٢٣٤٥٦٧٨٩'.indexOf(ch)));
        }

        function toPersianDigits(value) {
            return String(value ?? '').replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[parseInt(d, 10)]);
        }

        function getTaskModalStartDateSh() {
            const hiddenEl = document.getElementById('editTaskStartDate');
            const displayEl = document.getElementById('editTaskStartDateDisplay');
            const raw = (hiddenEl?.value || displayEl?.value || '').trim();
            return toLatinDigits(raw);
        }

        function syncTaskModalStartHidden() {
            const hiddenEl = document.getElementById('editTaskStartDate');
            if (!hiddenEl) return '';
            const fromAlt = window.$ ? toLatinDigits($('#editTaskStartDate').val() || '') : '';
            const fromDisplay = toLatinDigits(document.getElementById('editTaskStartDateDisplay')?.value || '');
            const normalized = fromAlt || fromDisplay;
            hiddenEl.value = normalized;
            return normalized;
        }

        function initTaskModalDatePickers(startDateValue) {
            if (!window.$ || !$.fn.persianDatepicker) return;
            const $startInput = $('#editTaskStartDateDisplay');
            const existingStartPicker = $startInput.data('datepicker');
            if (existingStartPicker && typeof existingStartPicker.destroy === 'function') {
                existingStartPicker.destroy();
            }
            const normalizedStart = toLatinDigits(startDateValue || '');
            $startInput.val(normalizedStart ? startDateValue : '').attr('value', normalizedStart ? startDateValue : '');
            if (document.getElementById('editTaskStartDate')) {
                document.getElementById('editTaskStartDate').value = normalizedStart;
            }
            $startInput.persianDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true,
                initialValueType: 'persian',
                initialValue: !!normalizedStart,
                altField: '#editTaskStartDate',
                altFormat: 'YYYY/MM/DD',
                timePicker: { enabled: false },
                calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' } },
                onSelect: function () {
                    syncTaskModalStartHidden();
                    updateComputedDueDateDisplay();
                }
            });
            syncTaskModalStartHidden();
            updateComputedDueDateDisplay();
        }

        function updateComputedDueDateDisplay(fallbackDueDateSh) {
            const displayEl = document.getElementById('editTaskComputedDueDate');
            if (!displayEl) return;
            const durationInput = document.getElementById('editTaskDurationDays');
            const durationRaw = durationInput ? durationInput.value : '';
            const duration = durationRaw === '' ? null : parseInt(toLatinDigits(durationRaw), 10);
            const startSh = syncTaskModalStartHidden() || getTaskModalStartDateSh();
            if (startSh && duration !== null && !Number.isNaN(duration) && duration >= 0 && window.persianDate) {
                try {
                    const parts = startSh.split('/').map(p => p.trim());
                    if (parts.length === 3) {
                        const year = parseInt(parts[0], 10);
                        const month = parseInt(parts[1], 10);
                        const day = parseInt(parts[2], 10);
                        if (year > 0 && month >= 1 && month <= 12 && day >= 1 && day <= 31) {
                            const duePd = new persianDate([year, month, day]).add('days', duration);
                            displayEl.textContent = toPersianDigits(duePd.format('YYYY/MM/DD'));
                            return;
                        }
                    }
                } catch (_) { /* fallback below */ }
            }
            displayEl.textContent = fallbackDueDateSh ? toPersianDigits(fallbackDueDateSh) : '—';
        }

