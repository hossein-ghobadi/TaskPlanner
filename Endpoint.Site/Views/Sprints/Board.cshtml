                                            title="حذف وضعیت"
                                            onclick="event.preventDefault(); event.stopPropagation(); deleteStatus(@status.Id, this.dataset.statusName);">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        @if (sprintIsActive)
                        {
                            <div class="column-add-task-bar">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary w-100 column-add-task-btn"
                                        data-status-id="@status.Id"
                                        data-status-name="@status.Name"
                                        title="افزودن کار در @status.Name">
                                    <i class="bi bi-plus-lg"></i>
                                    افزودن کار
                                </button>
                            </div>
                        }
                        <div class="column-tasks" id="tasks-@status.Id" data-status-id="@status.Id" ondrop="onDropIssue(event, @status.Id)" ondragover="onDragOverColumn(event)" ondragleave="onDragLeave(event)">
                            @{
                                var cards = Model.SprintIssues
                                .Where(t => (t.StatusId ?? (Model.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)) == status.Id)
                                .OrderByDescending(t => t.UpdatedAt)
                                .ThenBy(t => t.Priority)
                                .ToList();
                                

                            
                            }
                            @if (cards.Any())
                            {
                                foreach (var issue in cards)
                                {
                                    
                                    var dueDate = issue.DueDate;
                                    var now = DateTime.UtcNow;
                                    var dueSoonFlag = dueDate.HasValue && dueDate.Value >= now && dueDate.Value <= now.AddDays(3);
                                    <div class="task-card"
                                         draggable="true"
                                         ondragstart="onDragIssue(event, @issue.Id)"
                                         onclick="handleCardClick(event, @issue.Id)"
