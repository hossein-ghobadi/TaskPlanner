@using System.Security.Claims
@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var projectMembers = ViewBag.ProjectMembers as List<ProjectMemberVm> ?? new List<ProjectMemberVm>();
    var projectCreator = projectMembers.FirstOrDefault(m => m.FullName?.Contains("سازنده پروژه") == true);
    var creatorName = projectCreator?.FullName?.Replace(" - سازنده پروژه", "") ?? "نامشخص";
}

@if (noActiveSprintBoard)
{
    <div class="board-container board-bg-plain board-theme-classic" id="boardContainer">
        <div class="board-header">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2>@Model.SprintName</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-2">@Model.Description</p>
                    }
                    <div class="d-flex gap-3 align-items-center flex-wrap">
                        <small class="text-muted">
                            <i class="bi bi-folder"></i>
                            پروژه: <a href="/Projects/Details/@Model.ProjectId" class="text-decoration-none">@Model.ProjectName</a>
                        </small>
                    </div>
                </div>
                <div>
                    <a href="/Projects/Details/@Model.ProjectId" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-right"></i>
                        بازگشت به پروژه
                    </a>
                </div>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="board-awaiting-wrap px-2">
            <div class="board-awaiting-sprint card border-0">
                <div class="card-body text-center py-4 px-3">
                @if (hasPlanningSprint && planningSprintId.HasValue)
                {
                    <i class="bi bi-calendar2-event board-awaiting-icon board-awaiting-icon-planning d-block"></i>
                    <h5 class="mt-3 mb-2">اسپرینت در حال برنامه‌ریزی دارید</h5>
                    <p class="awaiting-desc small mb-0">ستون‌های کانبان پس از فعال‌سازی اسپرینت نمایش داده می‌شوند.</p>
                    <form method="post" action="/Sprints/ChangeStatus" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@planningSprintId.Value" />
                        <input type="hidden" name="status" value="@((int)SprintStatus.Active)" />
                        <button type="submit" class="btn btn-awaiting-success">
                            <i class="bi bi-play-circle"></i> فعال‌سازی اسپرینت
                        </button>
                    </form>
                    <div class="mt-2">
                        <a class="awaiting-link small" href="/Sprints/Index?projectId=@Model.ProjectId">مدیریت اسپرینت‌ها</a>
                    </div>
                }
                else
                {
                    <i class="bi bi-kanban board-awaiting-icon d-block"></i>
                    <h5 class="mt-3 mb-2">اسپرینت فعالی وجود ندارد</h5>
                    <p class="awaiting-desc small mb-0">یک اسپرینت بسازید و همزمان آن را شروع کنید تا ستون‌های تخته ظاهر شوند.</p>
                    <button type="button" class="btn btn-awaiting-primary mt-3" data-bs-toggle="modal" data-bs-target="#projectBoardCreateSprintModal">
                        <i class="bi bi-play-fill"></i> شروع اسپرینت
                    </button>
                }
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade project-board-create-modal" id="projectBoardCreateSprintModal" tabindex="-1" aria-labelledby="projectBoardCreateSprintModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="projectBoardCreateSprintModalLabel">شروع اسپرینت جدید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <form method="post" action="/Sprints/Create">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                    <input type="hidden" name="ActivateNow" value="true" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">پروژه</label>
                            <input type="text" class="form-control" value="@Model.ProjectName" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">نام اسپرینت <span class="text-danger">*</span></label>
                            <input name="Name" class="form-control" required maxlength="200" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">توضیحات</label>
                            <textarea name="Description" class="form-control" rows="3" maxlength="1000"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">تاریخ شروع <span class="text-danger">*</span></label>
                                <input type="text" id="projectBoardCreateStartDisplay" class="form-control" autocomplete="off" value="@defaultStartPersianSprint" />
                                <input type="hidden" name="StartDate" id="projectBoardCreateStart" value="@defaultStartPersianSprint" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">تاریخ پایان <span class="text-danger">*</span></label>
                                <input type="text" id="projectBoardCreateEndDisplay" class="form-control" autocomplete="off" value="@defaultEndPersianSprint" />
                                <input type="hidden" name="EndDate" id="projectBoardCreateEnd" value="@defaultEndPersianSprint" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">هدف اسپرینت</label>
                            <textarea name="Goal" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                        <button type="submit" class="btn btn-primary">ایجاد و شروع</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (!noActiveSprintBoard)
{
<div class="board-container board-bg-plain board-theme-classic" id="boardContainer">
    <div class="board-header">
        <div class="d-flex justify-content-between align-items-start">
