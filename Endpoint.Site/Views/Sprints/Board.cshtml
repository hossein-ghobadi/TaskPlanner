    /* استایل‌های مدرن برای صفحه کار */
    .task-details-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
    }

    /* هدر کار */
    .task-header {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border-radius: 20px;
        padding: 30px;
        color: white;
        margin-bottom: 30px;
        box-shadow: 0 10px 40px rgba(59, 130, 246, 0.3);
    }

        .task-header h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .task-header .task-icon {
            font-size: 2.5rem;
        }

        .task-header .task-key {
            background: rgba(255, 255, 255, 0.2);
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 500;
        }

    .task-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 20px;
    }

    .task-meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.15);
        padding: 8px 16px;
        border-radius: 12px;
        font-size: 0.9rem;
    }

        .task-meta-item i {
            font-size: 1.1rem;
        }

    /* کارت‌های اطلاعات */
    .info-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
        }

    .info-card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .info-card-title i {
            color: #3b82f6;
            font-size: 1.3rem;
        }

    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f3f4f6;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-item-label {
        color: #6b7280;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-item-value {
        color: #1f2937;
        font-weight: 500;
        text-align: left;
    }

    .badge-modern {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    /* بخش چت */
    .chat-container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 700px;
    }

    .chat-header {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        padding: 20px 25px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .chat-header h5 {
            margin: 0;
            font-size: 1.2rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .chat-count-badge {
        background: rgba(255, 255, 255, 0.25);
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background: #f9fafb;
    }

    .chat-message {
        margin-bottom: 20px;
        animation: fadeInUp 0.3s ease;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .chat-message.own {
        display: flex;
        justify-content: flex-end;
    }

    .chat-message.other {
        display: flex;
        justify-content: flex-start;
    }

    .message-bubble {
        max-width: 70%;
        padding: 12px 18px;
        border-radius: 18px;
        position: relative;
        word-wrap: break-word;
    }

        .message-bubble.own {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
            border-bottom-right-radius: 4px;
        }

        .message-bubble.other {
            background: white;
            color: #1f2937;
            border-bottom-left-radius: 4px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

    .message-user {
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 5px;
        color: #3b82f6;
    }

    .message-text {
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .message-time {
        font-size: 0.75rem;
        opacity: 0.7;
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .message-actions {
        margin-top: 8px;
        display: flex;
        gap: 10px;
    }

        .message-actions a {
            color: inherit;
            opacity: 0.7;
            transition: opacity 0.2s;
            text-decoration: none;
            font-size: 0.85rem;
        }

            .message-actions a:hover {
                opacity: 1;
            }

    .chat-input-area {
        padding: 20px;
        background: white;
        border-top: 1px solid #e5e7eb;
    }

    .chat-input-wrapper {
        display: flex;
        gap: 10px;
        align-items: flex-end;
    }

    .chat-input {
        flex: 1;
        border: 2px solid #e5e7eb;
        border-radius: 25px;
        padding: 12px 20px;
        font-size: 0.95rem;
        transition: border-color 0.2s;
        resize: none;
        min-height: 50px;
        max-height: 120px;
    }

        .chat-input:focus {
            outline: none;
            border-color: #3b82f6;
        }

    .chat-actions {
        display: flex;
        gap: 8px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .chat-action-btn {
        background: #f3f4f6;
        border: none;
        border-radius: 12px;
        padding: 10px 16px;
        font-size: 0.85rem;
        color: #4b5563;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .chat-action-btn:hover {
            background: #e5e7eb;
            color: #1f2937;
        }

        .chat-action-btn.recording {
            background: #fee2e2;
            color: #dc2626;
        }

            .chat-action-btn.recording:hover {
                background: #fecaca;
            }

    .chat-send-btn {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border: none;
        border-radius: 25px;
        padding: 12px 24px;
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .chat-send-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        }

        .chat-send-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    .file-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .file-preview-item {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
    }

        .file-preview-item img {
            max-width: 150px;
            max-height: 150px;
            border-radius: 12px;
        }

        .file-preview-item .remove-btn {
            position: absolute;
