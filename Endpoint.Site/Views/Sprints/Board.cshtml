<div class="board-container">
    <div class="board-header">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2>تخته کانبان</h2>
                <div class="meta">
                    <span>اسپرینت: <strong>@Model.SprintName</strong></span>
                    <span class="mx-2">|</span>
                    <span>پروژه: <a href="/Projects/Details/@Model.ProjectId">@Model.ProjectName</a></span>
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (Model.Status == SprintStatus.Active)
                {
                    <form method="post" action="/Sprints/ChangeStatus" class="d-inline" id="completeSprintForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.SprintId" />
                        <input type="hidden" name="status" value="@((int)SprintStatus.Completed)" />
                        <button type="button" class="btn btn-sm btn-danger" onclick="completeSprint()">
                            <i class="bi bi-check-circle"></i> خاتمه اسپرینت
                        </button>
                    </form>
                }
                @if (Model.Status != SprintStatus.Completed)
                {
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="openAddStatusModal()">
                        <i class="bi bi-plus-circle"></i> افزودن وضعیت
                    </button>
                }
                <a class="btn btn-sm btn-outline-primary" href="/Projects/Details/@Model.ProjectId">
                    <i class="bi bi-folder-open"></i> جزئیات پروژه
                </a>
            </div>
        </div>

        <div class="stats-compact">
            <div class="stat-compact">
                <span class="label">پیشرفت:</span>
                <span class="value">@Model.CompletionPercentage.ToString("F1")%</span>
            </div>
            <div class="stat-compact">
                <span class="label">کل:</span>
                <span class="value">@Model.TotalTasks</span>
            </div>
            <div class="stat-compact">
                <span class="label">انجام شده:</span>
                <span class="value text-success">@Model.CompletedTasks</span>
            </div>
            <div class="stat-compact">
                <span class="label">در حال انجام:</span>
                <span class="value text-primary">@Model.InProgressTasks</span>
            </div>
            <div class="stat-compact">
                <span class="label">مسدود:</span>
                <span class="value text-danger">@Model.BlockedTasks</span>
            </div>
        </div>

        <div class="board-toolbar">
            <input type="text" id="boardSearchInput" class="form-control toolbar-input" placeholder="جستجو..." style="min-width: 200px;">
            <select id="statusFilterSelect" class="form-select toolbar-select" style="min-width: 150px;">
                <option value="all">همه ستون‌ها</option>
                @foreach (var status in Model.Statuses.OrderBy(s => s.Order))
                {
                    <option value="@status.Id">@status.Name</option>
                }
            </select>
            <div class="d-flex align-items-center gap-2" style="position: relative;">
                <select id="assigneeFilterSelect" class="form-select toolbar-select" style="min-width: 180px;">
                    <option value="all">همه افراد</option>
                    <option value="unassigned">تخصیص نیافته</option>
                    @{
                        var projectMembers = ViewBag.ProjectMembers as List<ProjectMemberVm> ?? new List<ProjectMemberVm>();
                    }
                    @foreach (var member in projectMembers)
                    {
                        <option value="@member.UserId">@(member.FullName ?? member.UserName)</option>
                    }
                </select>
                <span id="selectedAssigneeBadge" class="badge bg-primary d-none" style="font-size: 0.85rem;">
                    <i class="bi bi-funnel-fill"></i> 
                    <span id="selectedAssigneeName"></span>
                </span>
            </div>
            <button type="button" id="dueSoonToggle" class="btn btn-toggle">
                <i class="bi bi-alarm"></i> موعد نزدیک
            </button>
        </div>
    </div>

    <div class="board-layout">
        <div class="kanban-board-container">

            <div class="kanban-board" id="board" data-sprint-id="@Model.SprintId">
                @foreach (var status in Model.Statuses.OrderBy(s => s.Order))
                {
                    <div class="kanban-column"
                         ondragover="onDragOverColumn(event)"
                         ondragenter="onDragEnter(event)"
                         ondragleave="onDragLeave(event)"
                         ondrop="onDropIssue(event, @status.Id)"
                         data-status-id="@status.Id">
                        <div class="kanban-column-header"
                             style="background-color: @(status.Color ?? "#6c757d");"
                             draggable="@(Model.Status != SprintStatus.Completed ? "true" : "false")"
                             ondragstart="onColumnDragStart(event)"
                             ondragend="onColumnDragEnd(event)">
                            <div>
                                <span>@status.Name</span>
                                <span class="badge bg-light text-dark ms-1">
                                    @{
                                        var count = Model.SprintIssues.Count(t =>
                                        (t.StatusId ?? (Model.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)) == status.Id);
                                    }
                                    @count
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                @if (Model.Status == SprintStatus.Active)
                                {
                                    <button type="button"
                                            class="quick-add-column-btn"
                                            data-status-id="@status.Id"
                                            data-status-name="@status.Name"
                                            title="افزودن سریع">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                }
                                @if (Model.Status != SprintStatus.Completed && !status.IsDefault && !status.IsFinal)
                                {
                                    <button type="button"
                                            class="btn btn-sm p-0 px-1 text-white"
                                            data-status-name="@status.Name"
                                            title="حذف وضعیت"
                                            onclick="event.preventDefault(); event.stopPropagation(); deleteStatus(@status.Id, this.dataset.statusName);"
                                            style="background: transparent; border: none; opacity: 0.8;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="kanban-column-body drop-zone" data-status-id="@status.Id">
                            @{
                                var cards = Model.SprintIssues
                                .Where(t => (t.StatusId ?? (Model.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)) == status.Id)
                                .OrderByDescending(t => t.UpdatedAt)
                                .ThenBy(t => t.Priority)
                                .ToList();
                            }
                            @if (cards.Any())
                            {
                                foreach (var issue in cards)
                                {
                                    var dueDate = issue.DueDate;
                                    var now = DateTime.UtcNow;
                                    var dueSoonFlag = dueDate.HasValue && dueDate.Value >= now && dueDate.Value <= now.AddDays(3);
                                    <div class="task-card"
                                         draggable="true"
                                         ondragstart="onDragIssue(event, @issue.Id)"
                                         onclick="handleCardClick(event, @issue.Id)"
                                         data-issue-id="@issue.Id"
                                         data-status-id="@status.Id"
                                         data-status-name="@status.Name"
                                         data-title="@issue.Title"
                                         data-assignee="@((issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "نامشخص"))"
                                         data-assignee-id="@(issue.AssignedUserId ?? "unassigned")"
                                         data-key="@issue.IssueKey"
                                         data-due="@dueDate?.ToString("o")"
                                         data-due-soon="@dueSoonFlag.ToString().ToLower()">

                                        <div class="task-card-header">
                                            <div class="task-actions">
                                                <span class="issue-type-icon" title="@issue.IssueTypeName">@issue.IssueTypeIcon</span>
                                                @if (Model.Status == SprintStatus.Active && issue.CanHaveChildren)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            onclick="event.stopPropagation(); event.preventDefault(); openAddSubtaskModal(@issue.Id, '@Html.Raw(issue.Title.Replace("'", "\\'"))');"
                                                            title="افزودن زیرتسک">
                                                        <i class="bi bi-plus-circle"></i>
                                                    </button>
                                                }
                                                @if (Model.Status == SprintStatus.Active)
                                                {
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                                type="button"
                                                                id="taskMenu-@issue.Id"
                                                                data-bs-toggle="dropdown"
                                                                aria-expanded="false"
                                                                onclick="event.stopPropagation(); event.preventDefault();"
                                                                title="عملیات بیشتر">
                                                            <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="taskMenu-@issue.Id">
                                                            <li>
                                                                <a class="dropdown-item" href="#" onclick="event.stopPropagation(); event.preventDefault(); openEditTaskModal(@issue.Id);">
                                                                    <i class="bi bi-pencil text-primary me-2"></i>ویرایش کار
                                                                </a>
                                                            </li>
                                                            @if (finalStatus != null && status.Id != finalStatus.Id)
                                                            {
                                                                <li>
                                                                    <a class="dropdown-item complete-task-btn" href="#" onclick="event.stopPropagation(); event.preventDefault(); completeTask(@issue.Id);">
                                                                        <i class="bi bi-check-lg text-success me-2"></i>خاتمه کار
                                                                    </a>
                                                                </li>
                                                            }
                                                            <li>
                                                                <a class="dropdown-item" href="#" onclick="event.stopPropagation(); event.preventDefault(); removeTaskFromSprint(@issue.Id);">
                                                                    <i class="bi bi-x-circle text-warning me-2"></i>خارج کردن از اسپرینت
                                                                </a>
                                                            </li>
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li>
                                                                <a class="dropdown-item text-danger" href="#" onclick="event.stopPropagation(); event.preventDefault(); deleteTask(@issue.Id, '@issue.Title');">
                                                                    <i class="bi bi-trash me-2"></i>حذف کار
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="task-title">
                                            <a href="/Tasks/Details/@issue.Id" onclick="event.stopPropagation();">@issue.Title</a>
                                        </div>

                                        <div class="task-meta">
                                            <div>👤 @(issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "نامشخص")</div>
                                            @{
                                                string dueText;
                                                string dueClass;
                                                if (!issue.DueDate.HasValue)
                                                {
                                                    dueText = "بدون موعد تحویل";
                                                    dueClass = "due-badge due-none";
                                                }
                                                else
                                                {
                                                    var today = DateTime.UtcNow.Date;
                                                    var dueDateOnly = issue.DueDate.Value.Date;
                                                    var diffDays = (dueDateOnly - today).Days;
                                                    if (diffDays >= 0)
                                                    {
                                                        var daysLeft = diffDays;
                                                        dueText = daysLeft == 0 ? "امروز موعد تحویل" : $"{daysLeft} روز مانده";
                                                        dueClass = "due-badge due-soon";
                                                    }
                                                    else
                                                    {
                                                        var daysPassed = Math.Abs(diffDays);
                                                        dueText = daysPassed == 0 ? "امروز موعد تحویل" : $"{daysPassed} روز گذشته";
                                                        dueClass = "due-badge due-past";
                                                    }
                                                }
                                            }
                                            <div class="@dueClass">
                                                <i class="bi bi-calendar-event"></i>
                                                @dueText
                                            </div>
                                            @if (issue.StoryPoints.HasValue && issue.StoryPoints > 0)
                                            {
                                                <div>⚡ @issue.StoryPoints SP</div>
                                            }
                                            @if (issue.ChildIssues != null && issue.ChildIssues.Any())
                                            {
                                                <div class="mt-1">
                                                    <button class="btn btn-sm btn-outline-secondary p-0 px-2"
                                                            onclick="event.stopPropagation(); event.preventDefault(); toggleSubtasks(@issue.Id);"
                                                            style="font-size: 0.7rem;">
                                                        <i class="bi bi-chevron-down" id="subtask-icon-@issue.Id"></i>
                                                        @issue.ChildIssues.Count کارک
                                                    </button>
                                                </div>
                                            }
                                        </div>

                                        @if (issue.ChildIssues != null && issue.ChildIssues.Any())
                                        {
                                            <div class="subtasks-container mt-2" id="subtasks-@issue.Id" style="display: none; border-top: 1px solid #dee2e6; padding-top: 8px;">
                                                @foreach (var subtask in issue.ChildIssues.OrderBy(c => c.CreatedAt))
                                                {
                                                    <div class="subtask-item d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded" style="font-size: 0.85rem;">
                                                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                                                            <span class="issue-type-icon" style="font-size: 0.9rem;">@subtask.IssueTypeIcon</span>
                                                            <div class="flex-grow-1">
                                                                <div class="fw-bold">@subtask.Title</div>
                                                                @if (!string.IsNullOrEmpty(subtask.Description))
                                                                {
                                                                    <small class="text-muted">@(subtask.Description.Length > 50 ? subtask.Description.Substring(0, 50) + "..." : subtask.Description)</small>
                                                                }
                                                            </div>
                                                        </div>
                                                        @if (Model.Status == SprintStatus.Active)
                                                        {
                                                            <div class="dropdown">
                                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle p-0 px-1"
                                                                        type="button"
                                                                        id="subtaskMenu-@subtask.Id"
                                                                        data-bs-toggle="dropdown"
                                                                        aria-expanded="false"
                                                                        onclick="event.stopPropagation(); event.preventDefault();"
                                                                        title="عملیات بیشتر"
                                                                        style="font-size: 0.7rem;">
                                                                    <i class="bi bi-three-dots-vertical"></i>
                                                                </button>
                                                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="subtaskMenu-@subtask.Id">
                                                                    <li>
                                                                        <a class="dropdown-item" href="#" onclick="event.stopPropagation(); event.preventDefault(); openEditTaskModal(@subtask.Id);">
                                                                            <i class="bi bi-pencil-square text-primary me-2"></i>ویرایش کار
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a class="dropdown-item" href="/Tasks/Details/@subtask.Id" onclick="event.stopPropagation();">
                                                                            <i class="bi bi-eye text-info me-2"></i>مشاهده جزئیات
                                                                        </a>
                                                                    </li>
                                                                    @{
                                                                        var subtaskStatus = Model.Statuses.FirstOrDefault(s => s.Id == subtask.StatusId);
                                                                        var subtaskIsFinal = subtaskStatus != null && subtaskStatus.IsFinal;
                                                                    }
                                                                    @if (finalStatus != null && !subtaskIsFinal)
                                                                    {
                                                                        <li>
                                                                            <a class="dropdown-item complete-task-btn" href="#" onclick="event.stopPropagation(); event.preventDefault(); completeTask(@subtask.Id);">
                                                                                <i class="bi bi-check-lg text-success me-2"></i>خاتمه کار
                                                                            </a>
                                                                        </li>
                                                                    }
                                                                    <li><hr class="dropdown-divider"></li>
                                                                    <li>
                                                                        <a class="dropdown-item text-danger" href="#" onclick="event.stopPropagation(); event.preventDefault(); deleteTask(@subtask.Id, '@subtask.Title');">
                                                                            <i class="bi bi-trash me-2"></i>حذف کار
                                                                        </a>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <a href="/Tasks/Details/@subtask.Id" class="btn btn-sm btn-outline-info p-0 px-1"
                                                               onclick="event.stopPropagation();"
                                                               title="جزئیات"
                                                               style="font-size: 0.7rem;">
                                                                <i class="bi bi-eye"></i>
                                                            </a>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-message">
                                    <i class="bi bi-inbox"></i><br>
                                    خالی
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.Status == SprintStatus.Active)
        {
            <div class="available-tasks-column">
                <div class="available-tasks-header">
                    <span>سبد کارها</span>
                    <span class="badge bg-primary">@Model.TotalTasks</span>
                </div>
                <div id="availableTasksContainer" class="available-tasks-body">
                    <p class="text-muted text-center py-3">در حال بارگذاری...</p>
                </div>
            </div>
        }
    </div>
</div>


<!-- Modal افزودن کارک -->
<div class="modal fade" id="addSubtaskModal" tabindex="-1" aria-labelledby="addSubtaskModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addSubtaskModalLabel">افزودن کارک</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addSubtaskForm">
                    <input type="hidden" id="subtaskParentId" />
                    <div class="mb-3">
                        <label for="subtaskParentKey" class="form-label">کار والد</label>
                        <input type="text" class="form-control" id="subtaskParentKey" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="subtaskTitle" class="form-label">عنوان کارک <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="subtaskTitle" required placeholder="عنوان کارک را وارد کنید">
                    </div>
                    <div class="mb-3">
                        <label for="subtaskCategory" class="form-label">دسته‌بندی</label>
                        <select class="form-select" id="subtaskCategory">
                            <option value="">-- بدون دسته --</option>
                            @{
                                var categoriesForSubtask = ViewBag.Categories as List<TaskPlanner.Domain.Entities.TaskPlanner.TaskCategory> ?? new List<TaskPlanner.Domain.Entities.TaskPlanner.TaskCategory>();
                            }
                            @foreach (var cat in categoriesForSubtask)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="alert alert-info mb-0" style="font-size: 0.9rem;">
                        <i class="bi bi-info-circle"></i>
                        <strong>نکته:</strong> مسئول کارک به صورت خودکار از کار والد گرفته می‌شود.
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="submitSubtask()">افزودن کارک</button>
            </div>
        </div>
    </div>
</div>
@if (Model.Status != SprintStatus.Completed)
{
    <div class="modal fade" id="addStatusModal" tabindex="-1" aria-labelledby="addStatusModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addStatusModalLabel">افزودن وضعیت جدید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="addStatusForm">
                        <div class="mb-3">
                            <label for="statusName" class="form-label">نام وضعیت <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="statusName" required placeholder="مثلاً بازبینی">
                        </div>
                        <div class="mb-3">
                            <label for="statusColor" class="form-label">رنگ وضعیت</label>
                            <input type="color" class="form-control form-control-color" id="statusColor" value="#0d6efd" title="رنگ وضعیت را انتخاب کنید">
                        </div>
                        <div class="mb-3">
                            <label for="statusDescription" class="form-label">توضیحات</label>
                            <textarea class="form-control" id="statusDescription" rows="3" placeholder="توضیح کوتاه برای این وضعیت"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-primary" id="addStatusSubmitBtn" onclick="submitStatus()">
                        <i class="bi bi-plus-circle"></i> ایجاد وضعیت
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Status == SprintStatus.Active)
{
    <div class="modal fade" id="quickTaskModal" tabindex="-1" aria-labelledby="quickTaskModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content quick-task-card">
                <div class="modal-header d-flex flex-wrap gap-3">
                    <div>
                        <div class="text-uppercase small opacity-75">Quick Add</div>
                        <h5 class="modal-title mb-0" id="quickTaskModalLabel">افزودن سریع کار به اسپرینت</h5>
                    </div>
                    <div class="quick-task-meta text-end ms-auto">
                        <span><i class="bi bi-lightning-charge-fill"></i> در کمتر از ۳۰ ثانیه</span>
                        <span><i class="bi bi-journal-check"></i> به‌صورت خودکار به ستون شروع می‌رود</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-primary d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-pin-angle"></i>
                        <span>افزودن مستقیم به ستون: <strong id="quickTaskTargetDisplay">@defaultStatusName</strong></span>
                    </div>
                    <form id="quickTaskForm" class="row g-4 align-items-end">
                        <div class="col-lg-6">
                            <label for="quickTaskTitle" class="form-label">عنوان کار <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg" id="quickTaskTitle" required placeholder="مثلاً گزارش خطای صفحه گزارش‌ها">
                            <div class="helper-text">عنوان واضح بنویسید تا اعضا بدون باز کردن جزئیات متوجه شوند.</div>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">نوع کار</label>
                            <div class="issue-type-chips" role="group" aria-label="انتخاب نوع کار" id="issueTypeChipsContainer">
                                <div class="text-muted small">در حال بارگذاری...</div>
                            </div>
                            <select class="form-select d-none" id="quickTaskType"></select>
                            <input type="hidden" id="quickTaskProjectIssueTypeId" value="0" />
                        </div>
                        <div class="col-lg-6">
                            <label for="quickTaskCategory" class="form-label">دسته‌بندی</label>
                            <select class="form-select form-select-lg" id="quickTaskCategory">
                                <option value="">دسته‌ای انتخاب نشده است</option>
                                @{
                                    var categories = ViewBag.Categories as List<TaskPlanner.Domain.Entities.TaskPlanner.TaskCategory> ?? new List<TaskPlanner.Domain.Entities.TaskPlanner.TaskCategory>();
                                }
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                            <div class="helper-text">بر اساس نوع کار، دسته‌بندی مناسب را انتخاب کنید (اختیاری).</div>
                        </div>
                        <div class="col-lg-6 text-lg-end">
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-magic me-1"></i> ساخت و افزودن به اسپرینت
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal ویرایش تسک -->
<div class="modal fade" id="editTaskModal" tabindex="-1" aria-labelledby="editTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editTaskModalLabel">ویرایش کار</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editTaskForm">
                    <input type="hidden" id="editTaskId" />
                    <input type="hidden" id="editTaskProjectId" />
                    <input type="hidden" id="editTaskProjectIssueTypeId" />
                    <input type="hidden" id="editTaskIssueTypeHidden" />
                    
                    <div class="mb-4">
                        <label for="editTaskTitle" class="form-label">
                            <i class="bi bi-card-heading text-primary"></i>
                            عنوان کار <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="editTaskTitle" required placeholder="عنوان کار را وارد کنید">
                    </div>
                    
                    <div class="mb-4">
                        <label for="editTaskDescription" class="form-label">
                            <i class="bi bi-file-text text-primary"></i>
                            توضیحات
                        </label>
                        <textarea class="form-control" id="editTaskDescription" rows="4" placeholder="توضیحات کار را وارد کنید"></textarea>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label for="editTaskStartDate" class="form-label">
                                <i class="bi bi-calendar-event text-primary"></i>
                                تاریخ شروع
                            </label>
                            <input type="text" class="form-control" id="editTaskStartDateDisplay" autocomplete="off">
                            <input type="hidden" id="editTaskStartDate">
                        </div>
                        <div class="col-md-6">
                            <label for="editTaskDueDate" class="form-label">
                                <i class="bi bi-calendar-check text-primary"></i>
                                تاریخ پایان
                            </label>
                            <input type="text" class="form-control" id="editTaskDueDateDisplay" autocomplete="off">
                            <input type="hidden" id="editTaskDueDate">
                        </div>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label for="editTaskCategory" class="form-label">
                                <i class="bi bi-collection text-primary"></i>
                                دسته‌بندی
                            </label>
                            <select class="form-select" id="editTaskCategory">
                                <option value="">-- بدون دسته --</option>
                                @{
                                    var categoriesForEdit = ViewBag.Categories as List<TaskPlanner.Domain.Entities.TaskPlanner.TaskCategory> ?? new List<TaskPlanner.Domain.Entities.TaskPlanner.TaskCategory>();
                                }
                                @foreach (var cat in categoriesForEdit)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editTaskAssignedUser" class="form-label">
                                <i class="bi bi-person text-primary"></i>
                                مسئول کار
                            </label>
                            <select class="form-select" id="editTaskAssignedUser">
                                <option value="">-- انتخاب کاربر --</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label for="editTaskStoryPoints" class="form-label">
                            <i class="bi bi-star text-primary"></i>
                            امتیاز داستان
                        </label>
                        <input type="number" class="form-control" id="editTaskStoryPoints" min="0" placeholder="مثلاً 5">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>انصراف
                </button>
                <button type="button" class="btn btn-primary" onclick="submitEditTask()">
                    <i class="bi bi-check-circle me-2"></i>ذخیره تغییرات
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        let draggedIssueId = null;
        let draggedCard = null;
        let isDragging = false;
        let mouseDownX = 0;
        let mouseDownY = 0;
        let isColumnDragging = false;
        let draggedColumnElement = null;
        const projectId = @(projectId ?? 0);
        const sprintId = @(sprintId ?? 0);
        const canManageStatuses = @((Model.Status != SprintStatus.Completed).ToString().ToLower());
        const defaultStatusId = @(defaultStatus?.Id ?? 0);
        const defaultStatusName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaultStatusName));
        const finalStatusId = @(finalStatus?.Id ?? 0);
        const finalStatusName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(finalStatusName));
        let quickTaskTargetStatusId = defaultStatusId;
        let quickTaskTargetStatusName = defaultStatusName;
        const boardFilters = {
            text: '',
            status: 'all',
            assignee: 'all',
            dueSoon: false
        };
        
        // ذخیره کارت‌های حذف شده برای بازگردانی
        const removedCards = new Map(); // key: card element, value: { parent, nextSibling }

        function showNotification(message, type = 'success') {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const alertHtml = `
                <div class="alert ${alertClass} alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 9999; min-width: 300px;">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('body').append(alertHtml);
            
            setTimeout(() => {
                $('.alert').fadeOut(300, function() {
                    $(this).remove();
                });
            }, 3000);
        }

        function evaluateDueSoon(card) {
            const dueValue = card.dataset.due;
            if (!dueValue) {
                return false;
            }
            const dueDate = new Date(dueValue);
            if (Number.isNaN(dueDate.getTime())) {
                return false;
            }
            const now = new Date();
            const diffHours = (dueDate.getTime() - now.getTime()) / 36e5;
            return diffHours >= 0 && diffHours <= 72;
        }

        function applyBoardFilters() {
            const text = boardFilters.text.trim().toLowerCase();
            const status = boardFilters.status;
            const assignee = boardFilters.assignee;
            const dueSoon = boardFilters.dueSoon;

            // ابتدا همه کارت‌های حذف شده را برگردان تا بتوانیم فیلتر جدید را اعمال کنیم
            removedCards.forEach((info, card) => {
                if (info.nextSibling && info.nextSibling.parentNode) {
                    info.parent.insertBefore(card, info.nextSibling);
                } else if (info.parent) {
                    info.parent.appendChild(card);
                }
            });
            removedCards.clear();

            // فیلتر کارت‌های اصلی
            document.querySelectorAll('.task-card').forEach(card => {
                if (!card.dataset.initializedDue) {
                    card.dataset.initializedDue = 'true';
                    card.dataset.dueSoon = card.dataset.dueSoon === 'true' ? 'true' : (evaluateDueSoon(card) ? 'true' : 'false');
                } else if (dueSoon) {
                    card.dataset.dueSoon = evaluateDueSoon(card) ? 'true' : 'false';
                }

                const title = (card.dataset.title || '').toLowerCase();
                const assigneeName = (card.dataset.assignee || '').toLowerCase();
                const assigneeId = card.dataset.assigneeId || 'unassigned';
                const key = (card.dataset.key || '').toLowerCase();

                const matchesText = !text || title.includes(text) || assigneeName.includes(text) || key.includes(text);
                const matchesStatus = status === 'all' || card.dataset.statusId === status;
                const matchesAssignee = assignee === 'all' || 
                    (assignee === 'unassigned' && assigneeId === 'unassigned') ||
                    (assignee !== 'unassigned' && assigneeId === assignee);
                const matchesDue = !dueSoon || card.dataset.dueSoon === 'true';

                const visible = matchesText && matchesStatus && matchesAssignee && matchesDue;
                
                if (visible) {
                    // اگر کارت حذف شده بود، دوباره اضافه کن
                    if (removedCards.has(card)) {
                        const info = removedCards.get(card);
                        if (info.nextSibling) {
                            info.parent.insertBefore(card, info.nextSibling);
                        } else {
                            info.parent.appendChild(card);
                        }
                        removedCards.delete(card);
                    }
                    card.classList.remove('filtered-out');
                    card.style.display = '';
                } else {
                    // کارت را از DOM حذف کن و اطلاعات آن را ذخیره کن
                    if (!removedCards.has(card) && card.parentNode) {
                        const parent = card.parentNode;
                        const nextSibling = card.nextSibling;
                        removedCards.set(card, { parent, nextSibling });
                        parent.removeChild(card);
                    }
                }
            });

            // فیلتر کارت‌های "سبد کارها"
            document.querySelectorAll('.available-task-item').forEach(item => {
                const assigneeId = item.dataset.assigneeId || 'unassigned';
                const matchesAssignee = assignee === 'all' || 
                    (assignee === 'unassigned' && assigneeId === 'unassigned') ||
                    (assignee !== 'unassigned' && assigneeId === assignee);
                
                item.style.display = matchesAssignee ? '' : 'none';
            });
        }

        function scrollToStatusColumn(statusId) {
            if (!statusId || statusId === 'all') {
                return;
            }
            const column = document.querySelector(`.kanban-column[data-status-id="${statusId}"]`);
            column?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }

        function registerBoardFilterEvents() {
            const searchInput = document.getElementById('boardSearchInput');
            const statusSelect = document.getElementById('statusFilterSelect');
            const assigneeSelect = document.getElementById('assigneeFilterSelect');
            const dueToggle = document.getElementById('dueSoonToggle');

            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    boardFilters.text = e.target.value || '';
                    applyBoardFilters();
                });
            }

            if (statusSelect) {
                statusSelect.addEventListener('change', (e) => {
                    boardFilters.status = e.target.value || 'all';
                    applyBoardFilters();
                    scrollToStatusColumn(boardFilters.status);
                });
            }

            if (assigneeSelect) {
                assigneeSelect.addEventListener('change', (e) => {
                    boardFilters.assignee = e.target.value || 'all';
                    updateAssigneeBadge();
                    applyBoardFilters();
                });
            }
            
            // تابع برای به‌روزرسانی نمایش مسئول انتخاب شده
            function updateAssigneeBadge() {
                const badge = document.getElementById('selectedAssigneeBadge');
                const badgeName = document.getElementById('selectedAssigneeName');
                const assigneeSelect = document.getElementById('assigneeFilterSelect');
                
                if (!badge || !badgeName || !assigneeSelect) return;
                
                const selectedValue = assigneeSelect.value;
                const selectedText = assigneeSelect.options[assigneeSelect.selectedIndex].text;
                
                if (selectedValue === 'all') {
                    badge.classList.add('d-none');
                } else {
                    badgeName.textContent = selectedValue === 'unassigned' ? 'تخصیص نیافته' : selectedText;
                    badge.classList.remove('d-none');
                }
            }
            
            // مقداردهی اولیه
            updateAssigneeBadge();

            if (dueToggle) {
                dueToggle.addEventListener('click', () => {
                    boardFilters.dueSoon = !boardFilters.dueSoon;
                    dueToggle.classList.toggle('active', boardFilters.dueSoon);
                    applyBoardFilters();
                });
            }
        }

        function setQuickTaskTarget(statusId, statusName) {
            quickTaskTargetStatusId = statusId || defaultStatusId;
            quickTaskTargetStatusName = statusName || defaultStatusName;
            const targetDisplay = document.getElementById('quickTaskTargetDisplay');
            if (targetDisplay) {
                targetDisplay.textContent = quickTaskTargetStatusName;
            }
        }

        async function openQuickTaskModalForStatus(statusId, statusName) {
            if (!statusId) {
                showNotification('ستون انتخاب‌شده معتبر نیست', 'error');
                return;
            }
            setQuickTaskTarget(statusId, statusName);
            const modalElement = document.getElementById('quickTaskModal');
            if (!modalElement) {
                return;
            }
            
            // بارگذاری issue types به صورت داینامیک
            const container = document.getElementById('issueTypeChipsContainer');
            if (container) {
                container.innerHTML = '<div class="text-muted small">در حال بارگذاری...</div>';
            }
            
            const issueTypes = await loadProjectIssueTypes();
            renderIssueTypeChips(issueTypes);
            
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalElement);
            modalInstance.show();
        }

        // دریافت ProjectIssueTypes به صورت داینامیک
        async function loadProjectIssueTypes() {
            if (!projectId) {
                console.error('ProjectId is not available');
                return [];
            }

            try {
                const response = await fetch(`/Sprints/GetProjectIssueTypes?projectId=${projectId}`);
                const data = await response.json();
                
                if (data.success && data.issueTypes) {
                    return data.issueTypes;
                } else {
                    console.error('Failed to load issue types:', data.message);
                    return [];
                }
            } catch (error) {
                console.error('Error loading issue types:', error);
                return [];
            }
        }

        // ساخت issue type chips به صورت داینامیک
        function renderIssueTypeChips(issueTypes) {
            const container = document.getElementById('issueTypeChipsContainer');
            const hiddenSelect = document.getElementById('quickTaskType');
            const projectIssueTypeIdInput = document.getElementById('quickTaskProjectIssueTypeId');
            
            if (!container) return;

            // فیلتر کردن فقط انواعی که می‌توانند به Sprint اضافه شوند
            const availableTypes = issueTypes.filter(type => 
                type.level === 'StoryLevel' && type.canAddToSprint
            );

            // اگر خالی بود، از همه Story-level types استفاده کن
            const finalTypes = availableTypes.length > 0 
                ? availableTypes 
                : issueTypes.filter(type => type.level === 'StoryLevel');

            // اگر هنوز خالی بود، از همه انواع استفاده کن (fallback)
            const typesToShow = finalTypes.length > 0 ? finalTypes : issueTypes;

            if (typesToShow.length === 0) {
                container.innerHTML = '<div class="text-danger small">هیچ نوع کاری یافت نشد</div>';
                return;
            }

            // پیدا کردن نوع پیش‌فرض (Task یا اولین گزینه)
            const defaultType = typesToShow.find(t => t.baseType === 'Task' && !t.isCustom) 
                               || typesToShow[0];

            // پاک کردن container
            container.innerHTML = '';
            hiddenSelect.innerHTML = '';

            // ساخت chips
            typesToShow.forEach((type, index) => {
                const isActive = defaultType && type.id === defaultType.id;
                
                // ساخت button chip
                const chipBtn = document.createElement('button');
                chipBtn.type = 'button';
                chipBtn.className = `chip-option ${isActive ? 'active' : ''}`;
                chipBtn.dataset.issueType = getIssueTypeEnumValue(type.baseType);
                chipBtn.dataset.projectIssueTypeId = type.id;
                chipBtn.innerHTML = `<span class="me-1">${type.icon || '📝'}</span> ${type.name}`;
                
                container.appendChild(chipBtn);

                // ساخت option برای select hidden
                const option = document.createElement('option');
                option.value = getIssueTypeEnumValue(type.baseType);
                option.dataset.projectIssueTypeId = type.id;
                option.textContent = `${type.icon || '📝'} ${type.name}`;
                if (isActive) {
                    option.selected = true;
                }
                hiddenSelect.appendChild(option);
            });

            // تنظیم مقدار پیش‌فرض
            if (defaultType && projectIssueTypeIdInput) {
                projectIssueTypeIdInput.value = defaultType.id;
            }

            // اضافه کردن event listeners
            initQuickAddTypeChips();
        }

        // تبدیل نام baseType به مقدار enum (مطابق با IssueType enum در C#)
        function getIssueTypeEnumValue(baseType) {
            const enumMap = {
                'Epic': 1,
                'Story': 2,
                'Task': 3,
                'Subtask': 4,
                'Bug': 5
            };
            return enumMap[baseType] !== undefined ? enumMap[baseType] : 3; // default: Task
        }

        function initQuickAddTypeChips() {
            const hiddenSelect = document.getElementById('quickTaskType');
            const projectIssueTypeIdInput = document.getElementById('quickTaskProjectIssueTypeId');
            const chipButtons = document.querySelectorAll('.issue-type-chips .chip-option');
            
            if (!hiddenSelect || !chipButtons.length) {
                return;
            }
            
            chipButtons.forEach(btn => {
                // حذف event listener قبلی (اگر وجود دارد)
                const newBtn = btn.cloneNode(true);
                btn.parentNode.replaceChild(newBtn, btn);
                
                newBtn.addEventListener('click', () => {
                    // دریافت دوباره همه دکمه‌ها از DOM (نه از متغیر قدیمی)
                    const allChipButtons = document.querySelectorAll('.issue-type-chips .chip-option');
                    allChipButtons.forEach(b => b.classList.remove('active'));
                    newBtn.classList.add('active');
                    hiddenSelect.value = newBtn.dataset.issueType;
                    
                    // تنظیم projectIssueTypeId
                    if (projectIssueTypeIdInput && newBtn.dataset.projectIssueTypeId) {
                        projectIssueTypeIdInput.value = newBtn.dataset.projectIssueTypeId;
                    } else if (projectIssueTypeIdInput) {
                        projectIssueTypeIdInput.value = '';
                    }
                });
            });
        }

        function resetQuickTaskTypeChips() {
            // این تابع دیگر استفاده نمی‌شود چون issue types به صورت داینامیک بارگذاری می‌شوند
            // اما برای سازگاری با کدهای قدیمی، آن را نگه می‌داریم
            const chipButtons = document.querySelectorAll('.issue-type-chips .chip-option');
            if (chipButtons.length > 0) {
                chipButtons.forEach(btn => btn.classList.remove('active'));
                chipButtons[0]?.classList.add('active');
                
                const hiddenSelect = document.getElementById('quickTaskType');
                const projectIssueTypeIdInput = document.getElementById('quickTaskProjectIssueTypeId');
                
                if (hiddenSelect && chipButtons[0]) {
                    hiddenSelect.value = chipButtons[0].dataset.issueType || hiddenSelect.value;
                }
                
                if (projectIssueTypeIdInput && chipButtons[0]?.dataset.projectIssueTypeId) {
                    projectIssueTypeIdInput.value = chipButtons[0].dataset.projectIssueTypeId;
                }
            }
        }

        function appendQuickTaskCard(task) {
            if (!task || !task.statusId) {
                return;
            }
            const columnBody = document.querySelector(`.kanban-column-body[data-status-id="${task.statusId}"]`);
            if (!columnBody) {
                return;
            }

            const emptyMessage = columnBody.querySelector('.empty-message');
            if (emptyMessage) {
                emptyMessage.remove();
            }

            const card = document.createElement('div');
            card.className = 'task-card';
            card.draggable = true;
            card.dataset.issueId = task.id;
            card.dataset.statusId = task.statusId;
            card.dataset.statusName = task.statusName || '';
            card.dataset.title = task.title || '';
            card.dataset.assignee = 'نامشخص';
            card.dataset.key = task.issueKey || '';
            card.dataset.due = '';
            card.dataset.dueSoon = 'false';
            card.addEventListener('dragstart', (e) => onDragIssue(e, task.id));
            card.addEventListener('click', (e) => handleCardClick(e, task.id));

            const safeTitle = escapeHtml(task.title || '');
            const issueKey = task.issueKey || 'جدید';
            const keyNumber = issueKey.includes('-') ? issueKey.split('-').pop() : issueKey;
            const safeKey = escapeHtml(keyNumber);
            const deleteTitleArgument = (task.title || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");

            const canComplete = canManageStatuses && finalStatusId && task.statusId !== finalStatusId;
            const completeMenuItem = canComplete ? `
                <li>
                    <a class="dropdown-item complete-task-btn" href="#" onclick="event.stopPropagation(); event.preventDefault(); completeTask(${task.id});">
                        <i class="bi bi-check-lg text-success me-2"></i>خاتمه کار
                    </a>
                </li>` : '';

            const actionButtons = canManageStatuses ? `
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            type="button"
                            id="taskMenu-${task.id}"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            onclick="event.stopPropagation(); event.preventDefault();"
                            title="عملیات بیشتر">
                        <i class="bi bi-three-dots-vertical"></i>
                </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="taskMenu-${task.id}">
                        <li>
                            <a class="dropdown-item" href="#" onclick="event.stopPropagation(); event.preventDefault(); openEditTaskModal(${task.id});">
                                <i class="bi bi-pencil text-primary me-2"></i>ویرایش کار
                            </a>
                        </li>
                        ${completeMenuItem}
                        <li>
                            <a class="dropdown-item" href="#" onclick="event.stopPropagation(); event.preventDefault(); removeTaskFromSprint(${task.id});">
                                <i class="bi bi-x-circle text-warning me-2"></i>خارج کردن از اسپرینت
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="#" onclick="event.stopPropagation(); event.preventDefault(); deleteTask(${task.id}, '${deleteTitleArgument}');">
                                <i class="bi bi-trash me-2"></i>حذف کار
                            </a>
                        </li>
                    </ul>
                </div>` : '';

            card.innerHTML = `
                <div class="task-card-header">
                    <div class="task-actions">
                        <span class="issue-type-icon" title="Task">🆕</span>
                        ${actionButtons}
                    </div>
                </div>
                <div class="task-title">
                    <a href="/Tasks/Details/${task.id}" onclick="event.stopPropagation();">${safeTitle}</a>
                </div>
                <div class="task-meta">
                    <div>👤 نامشخص</div>
                </div>
            `;

            columnBody.prepend(card);
            updateIssueCounts();
        }

        function escapeHtml(value) {
            return (value ?? '').toString()
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function ensureColumnHasEmptyMessage(columnBody) {
            if (!columnBody) return;
            if (columnBody.querySelector('.task-card')) {
                return;
            }
            let emptyMessage = columnBody.querySelector('.empty-message');
            if (!emptyMessage) {
                emptyMessage = document.createElement('div');
                emptyMessage.className = 'empty-message text-muted text-center small p-4';
                emptyMessage.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                columnBody.appendChild(emptyMessage);
            } else {
                emptyMessage.style.display = 'block';
            }
        }

        function moveCardToColumn(card, targetStatusId, targetStatusName) {
            if (!card || !targetStatusId) {
                return false;
            }
            const columnBody = document.querySelector(`.kanban-column-body[data-status-id="${targetStatusId}"]`);
            if (!columnBody) {
                return false;
            }

            const emptyMessage = columnBody.querySelector('.empty-message');
            if (emptyMessage) {
                emptyMessage.remove();
            }

            const sourceColumn = card.closest('.kanban-column-body');
            columnBody.prepend(card);
            card.dataset.statusId = targetStatusId;
            if (targetStatusName) {
                card.dataset.statusName = targetStatusName;
            }

            const completeBtn = card.querySelector('.complete-task-btn');
            if (completeBtn) {
                if (targetStatusId === finalStatusId) {
                    completeBtn.remove();
                }
            }

            if (sourceColumn && sourceColumn !== columnBody) {
                ensureColumnHasEmptyMessage(sourceColumn);
            }

            updateIssueCounts();
            return true;
        }

        async function postJson(url, payload) {
            let res;
            try {
                res = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(payload)
                });
            } catch (networkError) {
                throw new Error('خطا در ارتباط با سرور');
            }

            const text = await res.text();
            let data = null;

            if (text) {
                try {
                    data = JSON.parse(text);
                } catch (err) {
                    data = null;
                }
            }

            if (!res.ok || (data && data.success === false)) {
                throw new Error(data?.message || text || 'خطای ناشناخته');
            }

            return data || { success: true };
        }

        function resetDropZoneStyles() {
            document.querySelectorAll('.drop-zone').forEach(zone => {
                zone.style.backgroundColor = '';
                zone.style.borderColor = '';
            });
        }

        function highlightColumnTarget(column, isActive) {
            if (!column) return;
            if (isActive) {
                column.classList.add('column-drop-target');
            } else {
                column.classList.remove('column-drop-target');
            }
        }

        function onColumnDragStart(e) {
            if (!canManageStatuses) {
                e.preventDefault();
                return;
            }
            if (e.target.closest('button')) {
                e.preventDefault();
                return;
            }

            const column = e.currentTarget.closest('.kanban-column');
            if (!column) {
                return;
            }

            isColumnDragging = true;
            draggedColumnElement = column;
            column.classList.add('column-dragging');
            if (e.dataTransfer) {
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', 'column');
            }
        }

        function onColumnDragEnd() {
            if (draggedColumnElement) {
                draggedColumnElement.classList.remove('column-dragging');
                draggedColumnElement = null;
            }
            isColumnDragging = false;
            document.querySelectorAll('.kanban-column').forEach(col => col.classList.remove('column-drop-target'));
            resetDropZoneStyles();
        }

        function handleColumnDrop(targetColumn) {
            if (!isColumnDragging || !draggedColumnElement || !targetColumn || draggedColumnElement === targetColumn) {
                onColumnDragEnd();
                return;
            }

            const board = document.getElementById('board');
            if (!board) {
                onColumnDragEnd();
                return;
            }

            const columns = Array.from(board.children);
            const dragIndex = columns.indexOf(draggedColumnElement);
            const targetIndex = columns.indexOf(targetColumn);

            if (dragIndex === -1 || targetIndex === -1) {
                onColumnDragEnd();
                return;
            }

            if (targetIndex < dragIndex) {
                board.insertBefore(draggedColumnElement, targetColumn);
            } else {
                board.insertBefore(draggedColumnElement, targetColumn.nextElementSibling);
            }

            onColumnDragEnd();
            persistColumnOrder();
        }

        async function persistColumnOrder() {
            if (!canManageStatuses) {
                return;
            }

            const columns = document.querySelectorAll('.kanban-column');
            if (!columns.length) {
                return;
            }

            const statusOrders = Array.from(columns)
                .map((column, index) => ({
                    statusId: parseInt(column.dataset.statusId, 10),
                    order: index + 1
                }))
                .filter(item => !Number.isNaN(item.statusId));

            if (!statusOrders.length) {
                return;
            }

            try {
                const data = await postJson('/WorkflowStatus/UpdateOrder', {
                    sprintId: sprintId,
                    statusOrders: statusOrders
                });
                showNotification(data.message || 'ترتیب ستون‌ها ذخیره شد', 'success');
            } catch (error) {
                showNotification(error.message || 'خطا در ذخیره ترتیب ستون‌ها', 'error');
            }
        }

        function openAddStatusModal() {
            if (!canManageStatuses) {
                showNotification('اسپرینت تکمیل‌شده قابل ویرایش نیست', 'error');
                return;
            }

            const modalElement = document.getElementById('addStatusModal');
            if (!modalElement) {
                return;
            }

            const nameInput = document.getElementById('statusName');
            const descInput = document.getElementById('statusDescription');
            const colorInput = document.getElementById('statusColor');
            if (nameInput) nameInput.value = '';
            if (descInput) descInput.value = '';
            if (colorInput) {
                colorInput.value = '#0d6efd';
            }

            const modal = new bootstrap.Modal(modalElement);
            modal.show();
        }

        async function submitStatus() {
            if (!canManageStatuses) {
                showNotification('اسپرینت تکمیل‌شده قابل ویرایش نیست', 'error');
                return;
            }

            const nameInput = document.getElementById('statusName');
            const colorInput = document.getElementById('statusColor');
            const descInput = document.getElementById('statusDescription');
            if (!nameInput) {
                return;
            }

            const name = nameInput.value.trim();
            if (!name) {
                showNotification('نام وضعیت الزامی است', 'error');
                nameInput.focus();
                return;
            }

            const payload = {
                sprintId: sprintId,
                name: name,
                color: colorInput?.value,
                description: descInput?.value?.trim() || null
            };

            const submitBtn = document.getElementById('addStatusSubmitBtn');
            const originalText = submitBtn?.innerHTML;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> در حال ثبت...';
            }

            try {
                const data = await postJson('/WorkflowStatus/CreateInline', payload);
                showNotification(data.message || 'وضعیت جدید ایجاد شد', 'success');
                const modalElement = document.getElementById('addStatusModal');
                if (modalElement) {
                    bootstrap.Modal.getInstance(modalElement)?.hide();
                }
                setTimeout(() => location.reload(), 1000);
            } catch (error) {
                showNotification(error.message || 'خطا در ایجاد وضعیت', 'error');
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText || '<i class="bi bi-plus-circle"></i> ایجاد وضعیت';
                }
            }
        }

        async function deleteStatus(statusId, statusName = '') {
            if (!canManageStatuses) {
                showNotification('اسپرینت تکمیل‌شده قابل ویرایش نیست', 'error');
                return;
            }

            if (!statusId) {
                return;
            }

            const confirmed = confirm(`آیا از حذف وضعیت "${statusName || ''}" مطمئن هستید؟\nتمام کارهای این وضعیت به وضعیت شروع منتقل می‌شوند.`);
            if (!confirmed) {
                return;
            }

            try {
                const data = await postJson('/WorkflowStatus/DeleteInline', { statusId });
                showNotification(data.message || 'وضعیت حذف شد', 'success');
                setTimeout(() => location.reload(), 800);
            } catch (error) {
                showNotification(error.message || 'خطا در حذف وضعیت', 'error');
            }
        }

        function onDragIssue(e, issueId) {
            isDragging = true;
            draggedIssueId = issueId;
            draggedCard = e.currentTarget;
            draggedCard.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', issueId);
            draggedCard.style.height = `${draggedCard.offsetHeight}px`;
        }

        function handleCardClick(e, issueId) {
            // اگر drag در حال انجام است یا از دکمه/لینک کلیک شده، از redirect جلوگیری کن
            if (isDragging) {
                return;
            }
            if (draggedCard) {
                draggedCard.style.height = '';
            }
            // بررسی اینکه آیا از دکمه یا لینک کلیک شده یا نه
            if (e.target.closest('button') || e.target.closest('a')) {
                return;
            }
            // در غیر این صورت، به جزئیات کار برو
            window.location.href = '/Tasks/Details/' + issueId;
        }

        // ثبت موقعیت mouse down برای تشخیص drag vs click
        document.addEventListener('mousedown', function(e) {
            if (e.target.closest('.task-card')) {
                mouseDownX = e.clientX;
                mouseDownY = e.clientY;
            }
        });

        // بررسی اینکه آیا واقعاً drag شده یا فقط click
        document.addEventListener('mousemove', function(e) {
            if (mouseDownX !== 0 && mouseDownY !== 0) {
                const deltaX = Math.abs(e.clientX - mouseDownX);
                const deltaY = Math.abs(e.clientY - mouseDownY);
                // اگر بیش از 5 پیکسل حرکت کرده، drag است
                if (deltaX > 5 || deltaY > 5) {
                    isDragging = true;
                }
            }
        });

        // Reset موقعیت mouse بعد از mouse up
        document.addEventListener('mouseup', function(e) {
            if (!isDragging) {
                mouseDownX = 0;
                mouseDownY = 0;
            }
        });

        function getDropZoneElement(element) {
            if (!element) return null;
            return element.classList?.contains('drop-zone')
                ? element
                : element.querySelector?.('.drop-zone');
        }

        function onDragOverColumn(e) {
            if (isColumnDragging) {
                e.preventDefault();
                return;
            }
            e.preventDefault();
        }

        function highlightDropZone(element, isActive) {
            const zone = getDropZoneElement(element);
            if (!zone) return;
            if (isActive) {
                zone.style.backgroundColor = '#e3f2fd';
                zone.style.borderColor = '#2196f3';
            } else {
                zone.style.backgroundColor = '';
                zone.style.borderColor = '';
            }
        }

        function onDragEnter(e) {
            e.preventDefault();
            if (isColumnDragging) {
                highlightColumnTarget(e.currentTarget.closest('.kanban-column'), true);
                return;
            }
            highlightDropZone(e.currentTarget, true);
        }

        function onDragLeave(e) {
            if (isColumnDragging) {
                highlightColumnTarget(e.currentTarget.closest('.kanban-column'), false);
                return;
            }
            highlightDropZone(e.currentTarget, false);
        }

        async function onDropIssue(e, toStatusId) {
            e.preventDefault();
            if (isColumnDragging) {
                const columnElement = e.currentTarget.closest('.kanban-column');
                highlightColumnTarget(columnElement, false);
                handleColumnDrop(columnElement);
                return;
            }

            const dropZone = getDropZoneElement(e.currentTarget);
            if (dropZone) {
                highlightDropZone(dropZone, false);
            }
            
            const issueId = draggedIssueId || parseInt(e.dataTransfer.getData('text/plain'));
            if (!issueId) return;

            if (draggedCard) {
                draggedCard.style.opacity = '0.5';
            }

            try {
                const res = await fetch('/Tasks/MoveIssue', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ 
                        taskId: issueId, 
                        toStatusId: toStatusId,
                        reason: 'تماس از تخته کانبان'
                    })
                });

                if (!res.ok) {
                    const errorText = await res.text();
                    alert('خطا: ' + errorText || 'خطا در انتقال وضعیت');
                    if (draggedCard) {
                        draggedCard.style.opacity = '1';
                    }
                    return;
                }

                const result = await res.json();
                console.log('Success:', result);

                if (draggedCard) {
                    draggedCard.classList.remove('dragging');
                    draggedCard.style.opacity = '1';
                    
                    const sourceColumn = draggedCard.closest('.kanban-column-body');
                    
                    if (dropZone) {
                        const emptyMessage = dropZone.querySelector('.empty-message');
                        if (emptyMessage) {
                            emptyMessage.remove();
                        }
                        
                        // قرار دادن کارت در ابتدای لیست (قبل از همه کارت‌های دیگر)
                        const firstCard = dropZone.querySelector('.task-card:not(.dragging)');
                        if (firstCard && firstCard !== draggedCard) {
                            dropZone.insertBefore(draggedCard, firstCard);
                        } else {
                            // اگر کارت دیگری وجود ندارد یا این کارت اولین است، از prepend استفاده کن
                            dropZone.insertBefore(draggedCard, dropZone.firstChild);
                        }
                    }
                    
                    if (sourceColumn && sourceColumn !== dropZone) {
                        const sourceCards = sourceColumn.querySelectorAll('.task-card');
                        if (sourceCards.length === 0) {
                            const sourceEmptyMessage = sourceColumn.querySelector('.empty-message');
                            if (sourceEmptyMessage) {
                                sourceEmptyMessage.style.display = 'block';
                            } else {
                                const emptyMsg = document.createElement('div');
                                emptyMsg.className = 'empty-message text-muted text-center small p-4';
                                emptyMsg.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                                sourceColumn.appendChild(emptyMsg);
                            }
                        }
                    }
                    
                    updateIssueCounts();
                } else {
                    location.reload();
                }

            } catch (err) {
                console.error('Error:', err);
                alert('خطای شبکه: ' + err.message);
                if (draggedCard) {
                    draggedCard.style.opacity = '1';
                }
            } finally {
                draggedIssueId = null;
                draggedCard = null;
            }
        }

        async function completeTask(taskId) {
            if (!taskId) return;
            if (!finalStatusId) {
                showNotification('ستون نهایی برای این اسپرینت تعریف نشده است', 'error');
                return;
            }

            // دریافت اطلاعات کار برای نمایش در پیغام تایید
            const card = document.querySelector(`.task-card[data-issue-id="${taskId}"]`);
            const taskTitle = card?.dataset.title || 'این کار';
            const taskKey = card?.dataset.key || '';
            
            // نمایش پیغام تایید
            const confirmMessage = `آیا مطمئن هستید که می‌خواهید کار "${taskKey}: ${taskTitle}" را خاتمه دهید؟\n\nاین کار به ستون "${finalStatusName}" منتقل خواهد شد.`;
            if (!confirm(confirmMessage)) {
                return;
            }

            const previousOpacity = card ? card.style.opacity : null;
            if (card) {
                card.style.opacity = '0.5';
            }

            try {
                await postJson('/Tasks/MoveIssue', {
                    taskId: taskId,
                    toStatusId: finalStatusId,
                    reason: 'تکمیل از طریق دکمه'
                });

                const moved = moveCardToColumn(card, finalStatusId, finalStatusName);
                if (!moved) {
                    setTimeout(() => location.reload(), 500);
                } else {
                    showNotification('کار با موفقیت خاتمه یافت.', 'success');
                }
            } catch (error) {
                showNotification(error.message || 'خطا در خاتمه کار', 'error');
                if (card) {
                    card.style.opacity = previousOpacity ?? '1';
                }
            } finally {
                if (card) {
                    card.style.opacity = '1';
                }
            }
        }

        function updateIssueCounts() {
            document.querySelectorAll('.kanban-column').forEach(column => {
                const body = column.querySelector('.kanban-column-body');
                const count = body ? body.querySelectorAll('.task-card').length : 0;
                const badge = column.querySelector('.kanban-column-header .badge');
                if (badge) {
                    badge.textContent = count;
                }
            });
        }

        // باز کردن modal ویرایش تسک
        // ذخیره اطلاعات اصلی تسک برای استفاده در submit
        let originalTaskData = null;
        
        async function openEditTaskModal(taskId) {
            if (!taskId) {
                showNotification('شناسه کار نامعتبر است', 'error');
                return;
            }

            const modalElement = document.getElementById('editTaskModal');
            if (!modalElement) {
                showNotification('خطا در باز کردن فرم ویرایش', 'error');
                return;
            }

            // باز کردن modal
            const modal = new bootstrap.Modal(modalElement);
            modal.show();

            try {
                // دریافت اطلاعات کار با AJAX
                const response = await fetch(`/Tasks/GetTaskDetails?id=${taskId}`);
                
                // بررسی Content-Type
                const contentType = response.headers.get("content-type");
                if (!contentType || !contentType.includes("application/json")) {
                    const text = await response.text();
                    console.error('Expected JSON but got:', contentType, text.substring(0, 200));
                    throw new Error('سرور پاسخ غیرمنتظره‌ای برگرداند. لطفاً صفحه را رفرش کنید.');
                }
                
                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({ message: 'خطا در دریافت اطلاعات کار' }));
                    throw new Error(errorData.message || 'خطا در دریافت اطلاعات کار');
                }
                
                const taskData = await response.json();
                
                if (!taskData.success) {
                    throw new Error(taskData.message || 'خطا در دریافت اطلاعات کار');
                }
                
                // ذخیره اطلاعات اصلی برای استفاده در submit
                originalTaskData = taskData;
                
                // پر کردن فرم
                document.getElementById('editTaskId').value = taskData.id;
                document.getElementById('editTaskProjectId').value = taskData.projectId;
                document.getElementById('editTaskProjectIssueTypeId').value = taskData.projectIssueTypeId || '';
                document.getElementById('editTaskTitle').value = taskData.title || '';
                document.getElementById('editTaskDescription').value = taskData.description || '';
                document.getElementById('editTaskStartDateDisplay').value = taskData.startDateSh || '';
                document.getElementById('editTaskStartDate').value = taskData.startDateSh || '';
                document.getElementById('editTaskDueDateDisplay').value = taskData.dueDateSh || '';
                document.getElementById('editTaskDueDate').value = taskData.dueDateSh || '';
                document.getElementById('editTaskCategory').value = taskData.categoryId || '';
                document.getElementById('editTaskAssignedUser').value = taskData.assignedUserId || '';
                document.getElementById('editTaskStoryPoints').value = taskData.storyPoints || '';
                
                // ذخیره مقدار IssueType در hidden input (فیلد نمایش داده نمی‌شود)
                const issueTypeHidden = document.getElementById('editTaskIssueTypeHidden');
                if (taskData.issueType) {
                    issueTypeHidden.value = taskData.issueType;
                } else if (taskData.projectIssueTypeId && taskData.availableIssueTypes) {
                    // اگر issueType مستقیم نبود، از projectIssueTypeId پیدا کن
                    const matchingType = taskData.availableIssueTypes.find(it => it.id == taskData.projectIssueTypeId);
                    if (matchingType) {
                        issueTypeHidden.value = matchingType.baseType;
                    }
                }
                
                // پر کردن AssignedUser dropdown
                const assignedUserSelect = document.getElementById('editTaskAssignedUser');
                const assignedUserLabel = assignedUserSelect.previousElementSibling;
                const assignedUserContainer = assignedUserSelect.closest('.col-md-6');
                
                // چک کردن اینکه آیا این یک Subtask است (issueType === 4)
                const isSubtask = taskData.issueType === 4;
                
                if (isSubtask) {
                    // برای Subtask: غیرفعال کردن فیلد و نمایش پیام
                    assignedUserSelect.innerHTML = '<option value="">-- انتخاب کاربر --</option>';
                    if (taskData.assignedUsers && taskData.assignedUserId) {
                        // نمایش کاربر فعلی برای اطلاع (فقط خواندنی)
                        const currentUser = taskData.assignedUsers.find(u => u.id == taskData.assignedUserId);
                        if (currentUser) {
                            const option = document.createElement('option');
                            option.value = currentUser.id;
                            option.textContent = currentUser.name;
                            option.selected = true;
                            assignedUserSelect.appendChild(option);
                        }
                    }
                    assignedUserSelect.disabled = true;
                    assignedUserSelect.setAttribute('title', 'مسئول کارک به صورت خودکار از کار والد گرفته می‌شود');
                    
                    // اضافه کردن پیام توضیحی
                    let helpText = assignedUserContainer.querySelector('.subtask-assignee-help');
                    if (!helpText) {
                        helpText = document.createElement('small');
                        helpText.className = 'text-muted subtask-assignee-help';
                        helpText.style.display = 'block';
                        helpText.style.marginTop = '0.25rem';
                        helpText.innerHTML = '<i class="bi bi-info-circle"></i> مسئول کارک از کار والد گرفته می‌شود';
                        assignedUserSelect.parentNode.appendChild(helpText);
                    }
                } else {
                    // برای کارهای عادی: نمایش لیست کاربران
                    assignedUserSelect.innerHTML = '<option value="">-- انتخاب کاربر --</option>';
                    if (taskData.assignedUsers) {
                        taskData.assignedUsers.forEach(user => {
                            const option = document.createElement('option');
                            option.value = user.id;
                            option.textContent = user.name;
                            if (taskData.assignedUserId == user.id) {
                                option.selected = true;
                            }
                            assignedUserSelect.appendChild(option);
                        });
                    }
                    assignedUserSelect.disabled = false;
                    assignedUserSelect.removeAttribute('title');
                    
                    // حذف پیام توضیحی اگر وجود داشت
                    const helpText = assignedUserContainer?.querySelector('.subtask-assignee-help');
                    if (helpText) {
                        helpText.remove();
                    }
                }
                
                // تنظیم Persian Datepicker
                if ($.fn.persianDatepicker) {
                    $('#editTaskStartDateDisplay').persianDatepicker({
                        format: 'YYYY/MM/DD',
                        autoClose: true,
                        initialValueType: "persian",
                        initialValue: true,
                        altField: '#editTaskStartDate',
                        altFormat: 'YYYY/MM/DD',
                        timePicker: { enabled: false },
                        calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' } }
                    });
                    
                    $('#editTaskDueDateDisplay').persianDatepicker({
                        format: 'YYYY/MM/DD',
                        autoClose: true,
                        initialValueType: "persian",
                        initialValue: true,
                        altField: '#editTaskDueDate',
                        altFormat: 'YYYY/MM/DD',
                        timePicker: { enabled: false },
                        calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' } }
                    });
                }
                
            } catch (error) {
                showNotification('خطا در بارگذاری اطلاعات کار: ' + error.message, 'error');
                bootstrap.Modal.getInstance(modalElement)?.hide();
            }
        }
        
        // ارسال فرم ویرایش کار
        async function submitEditTask() {
            const taskId = document.getElementById('editTaskId').value;
            if (!taskId) {
                showNotification('شناسه کار نامعتبر است', 'error');
                return;
            }
            
            const title = document.getElementById('editTaskTitle').value.trim();
            if (!title) {
                showNotification('عنوان کار الزامی است', 'error');
                return;
            }
            
            // استفاده از hidden input برای IssueType
            const issueType = document.getElementById('editTaskIssueTypeHidden').value;
            if (!issueType) {
                showNotification('نوع کار الزامی است', 'error');
                return;
            }
            
            // دریافت ProjectIssueTypeId از hidden input
            const projectIssueTypeId = document.getElementById('editTaskProjectIssueTypeId').value || null;
            
            // برای Subtask، AssignedUserId را از داده‌های اصلی نگه دار (تغییر نمی‌دهیم)
            let assignedUserId = document.getElementById('editTaskAssignedUser').value || null;
            const isSubtask = parseInt(issueType) === 4;
            if (isSubtask && originalTaskData && originalTaskData.assignedUserId) {
                // برای Subtask، از AssignedUserId اصلی استفاده کن
                assignedUserId = originalTaskData.assignedUserId;
            }
            
            const formData = {
                Id: parseInt(taskId),
                Title: title,
                Description: document.getElementById('editTaskDescription').value || '',
                IssueType: parseInt(issueType),
                ProjectIssueTypeId: projectIssueTypeId ? parseInt(projectIssueTypeId) : null,
                ProjectId: parseInt(document.getElementById('editTaskProjectId').value),
                StartDateSh: document.getElementById('editTaskStartDate').value || '',
                DueDateSh: document.getElementById('editTaskDueDate').value || '',
                CategoryId: document.getElementById('editTaskCategory').value ? parseInt(document.getElementById('editTaskCategory').value) : null,
                AssignedUserId: assignedUserId,
                StoryPoints: document.getElementById('editTaskStoryPoints').value ? parseInt(document.getElementById('editTaskStoryPoints').value) : null
            };
            
            // نمایش loading
            const submitBtn = document.querySelector('button[onclick="submitEditTask()"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال ذخیره...';
            
            try {
                // دریافت AntiForgeryToken
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                
                const response = await fetch('/Tasks/Edit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        ...(token ? { 'RequestVerificationToken': token } : {})
                    },
                    body: JSON.stringify(formData),
                    credentials: 'same-origin'
                });
                
                // بررسی Content-Type
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.includes("application/json")) {
                    const result = await response.json();
                    if (response.ok && result.success) {
                        showNotification('کار با موفقیت ویرایش شد', 'success');
                        bootstrap.Modal.getInstance(document.getElementById('editTaskModal'))?.hide();
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showNotification('خطا: ' + (result.message || 'خطا در ویرایش کار'), 'error');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                } else {
                    // اگر JSON نبود، احتمالاً redirect شده یا خطا رخ داده
                    const text = await response.text();
                    console.error('Expected JSON but got:', contentType, text.substring(0, 200));
                    
                    if (response.redirected || response.status === 302 || response.status === 301) {
                        // احتمالاً redirect به login شده
                        showNotification('لطفاً دوباره وارد شوید', 'error');
                        setTimeout(() => location.reload(), 2000);
                    } else {
                        showNotification('خطا در ذخیره تغییرات. لطفاً صفحه را رفرش کنید.', 'error');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                }
            } catch (error) {
                console.error('Error submitting task:', error);
                showNotification('خطا در ارتباط با سرور: ' + error.message, 'error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }

        document.addEventListener('dragend', function() {
            if (isColumnDragging) {
                onColumnDragEnd();
                return;
            }
            isDragging = false;
            mouseDownX = 0;
            mouseDownY = 0;
            resetDropZoneStyles();
        });

        document.addEventListener('click', function(e) {
            const quickBtn = e.target.closest('.quick-add-column-btn');
            if (quickBtn) {
                e.preventDefault();
                e.stopPropagation();
                const statusId = parseInt(quickBtn.dataset.statusId, 10);
                openQuickTaskModalForStatus(statusId, quickBtn.dataset.statusName);
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            registerBoardFilterEvents();
            applyBoardFilters();
            const quickTaskModal = document.getElementById('quickTaskModal');
            if (quickTaskModal) {
                quickTaskModal.addEventListener('hidden.bs.modal', () => {
                    setQuickTaskTarget(defaultStatusId, defaultStatusName);
                    document.getElementById('quickTaskForm')?.reset();
                    // پاک کردن issue type chips برای بارگذاری مجدد در دفعه بعد
                    const container = document.getElementById('issueTypeChipsContainer');
                    if (container) {
                        container.innerHTML = '<div class="text-muted small">در حال بارگذاری...</div>';
                    }
                });
                
                // بارگذاری issue types هنگام باز شدن modal (برای اولین بار)
                quickTaskModal.addEventListener('show.bs.modal', async function() {
                    const container = document.getElementById('issueTypeChipsContainer');
                    if (container && container.innerHTML.includes('در حال بارگذاری')) {
                        const issueTypes = await loadProjectIssueTypes();
                        renderIssueTypeChips(issueTypes);
                    }
                });
            }
            
            // اسکرول به ستون و highlight کارت جدید بعد از reload
            const scrollToStatusId = sessionStorage.getItem('scrollToStatusAfterReload');
            const highlightTaskId = sessionStorage.getItem('highlightTaskAfterReload');
            
            if (scrollToStatusId) {
                setTimeout(function() {
                    const column = document.querySelector(`.kanban-column[data-status-id="${scrollToStatusId}"]`);
                    if (column) {
                        column.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                        
                        // highlight کارت جدید
                        if (highlightTaskId) {
                            const taskCard = document.querySelector(`.task-card[data-issue-id="${highlightTaskId}"]`);
                            if (taskCard) {
                                taskCard.style.transition = 'all 0.3s ease';
                                taskCard.style.boxShadow = '0 0 20px rgba(37, 99, 235, 0.6)';
                                taskCard.style.transform = 'scale(1.02)';
                                
                                setTimeout(function() {
                                    taskCard.style.boxShadow = '';
                                    taskCard.style.transform = '';
                                }, 2000);
                            }
                        }
                    }
                    
                    // پاک کردن sessionStorage
                    sessionStorage.removeItem('scrollToStatusAfterReload');
                    sessionStorage.removeItem('highlightTaskAfterReload');
                }, 300);
            }
        });

        // بارگذاری کارهای موجود (فقط برای اسپرینت فعال)
        @if (Model.Status == SprintStatus.Active)
        {
            <text>
            function loadAvailableTasks() {
                $.ajax({
                    url: '/Sprints/GetProjectTasks',
                    type: 'GET',
                    data: { projectId: projectId, sprintId: sprintId },
                    success: function(response) {
                        if (response.success) {
                            displayAvailableTasks(response.tasks);
                        } else {
                            $('#availableTasksContainer').html('<p class="text-muted">خطا در بارگذاری کارها: ' + response.message + '</p>');
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#availableTasksContainer').html('<p class="text-danger">خطا در ارتباط با سرور: ' + error + '</p>');
                    }
                });
            }

            let selectedTaskId = null;
            let clickTimeout = null;

            function displayAvailableTasks(tasks) {
                const container = $('#availableTasksContainer');
                
                if (tasks.length === 0) {
                    container.html('<div class="empty-message"><i class="bi bi-inbox"></i><br>کار قابل اضافه شدن وجود ندارد</div>');
                    return;
                }

                let html = '';
                tasks.forEach(task => {
                    const assigneeId = task.assignedUserId || 'unassigned';
                    html += `
                        <div class="available-task-item" data-task-id="${task.id}" data-assignee-id="${assigneeId}">
                            <div class="available-task-title">
                                <a href="/Tasks/Details/${task.id}" onclick="event.stopPropagation();">${escapeHtml(task.title || 'بدون عنوان')}</a>
                            </div>
                            <div class="available-task-meta">${escapeHtml(task.categoryName ?? 'بدون دسته')} • ${escapeHtml(task.assignedUserName ?? 'تخصیص نیافته')}</div>
                        </div>
                    `;
                });
                
                container.html(html);
                
                // اضافه کردن event listener برای انتخاب با یک کلیک
                container.off('click', '.available-task-item').on('click', '.available-task-item', function(e) {
                    e.stopPropagation();
                    const taskId = $(this).data('task-id');
                    if (!taskId) return;
                    
                    const taskItem = $(this);
                    
                    // اگر همان کار قبلی انتخاب شده بود، با دوبار کلیک اضافه کن
                    if (selectedTaskId === taskId) {
                        clearTimeout(clickTimeout);
                        addTaskToSprint(taskId);
                        selectedTaskId = null;
                        $('.available-task-item').removeClass('selected');
                    } else {
                        // انتخاب کار جدید
                        clearTimeout(clickTimeout);
                        $('.available-task-item').removeClass('selected');
                        taskItem.addClass('selected');
                        selectedTaskId = taskId;
                        
                        // اگر بعد از 2 ثانیه کلیک دیگری نشد، انتخاب را لغو کن
                        clickTimeout = setTimeout(() => {
                            $('.available-task-item').removeClass('selected');
                            selectedTaskId = null;
                        }, 2000);
                    }
                });
            }

            let addingTaskInProgress = false;
            
            function addTaskToSprint(taskId) {
                // جلوگیری از دوبار کلیک
                if (addingTaskInProgress) {
                    return;
                }
                
                addingTaskInProgress = true;
                
                // غیرفعال کردن کارت در حال اضافه شدن
                const taskItem = $(`.available-task-item[data-task-id="${taskId}"]`);
                taskItem.css('opacity', '0.5').css('pointer-events', 'none');
                
                $.ajax({
                    url: '/Sprints/AddTaskToSprint',
                    type: 'POST',
                    data: { sprintId: sprintId, taskId: taskId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        addingTaskInProgress = false;
                        if (response.success) {
                            showNotification('کار با موفقیت به اسپرینت اضافه شد', 'success');
                            selectedTaskId = null;
                            $('.available-task-item').removeClass('selected');
                            loadAvailableTasks();
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showNotification('خطا: ' + response.message, 'error');
                            taskItem.css('opacity', '1').css('pointer-events', 'auto');
                        }
                    },
                    error: function() {
                        addingTaskInProgress = false;
                        showNotification('خطا در ارتباط با سرور', 'error');
                        taskItem.css('opacity', '1').css('pointer-events', 'auto');
                    }
                });
            }

            function removeTaskFromSprint(taskId) {
                if (!confirm('آیا مطمئن هستید که می‌خواهید این کار را از اسپرینت خارج کنید؟')) {
                    return;
                }

                $.ajax({
                    url: '/Sprints/RemoveTaskFromSprint',
                    type: 'POST',
                    data: { sprintId: sprintId, taskId: taskId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            showNotification('کار با موفقیت از اسپرینت خارج شد', 'success');
                            // حذف کارت از صفحه
                            const card = document.querySelector(`.task-card[data-issue-id="${taskId}"]`);
                            if (card) {
                                card.style.transition = 'opacity 0.3s';
                                card.style.opacity = '0';
                                setTimeout(() => {
                                    const column = card.closest('.kanban-column-body');
                                    card.remove();
                                    updateIssueCounts();
                                    
                                    // نمایش پیام خالی اگر ستون خالی شد
                                    const remainingCards = column.querySelectorAll('.task-card');
                                    if (remainingCards.length === 0) {
                                        const emptyMsg = document.createElement('div');
                                        emptyMsg.className = 'empty-message text-muted text-center small p-4';
                                        emptyMsg.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                                        column.appendChild(emptyMsg);
                                    }
                                }, 300);
                            }
                            // بارگذاری مجدد تسک‌های موجود
                            loadAvailableTasks();
                        } else {
                            showNotification('خطا: ' + response.message, 'error');
                        }
                    },
                    error: function() {
                        showNotification('خطا در ارتباط با سرور', 'error');
                    }
                });
            }

            $(document).ready(function() {
                loadAvailableTasks();
            });

            // باز کردن Modal افزودن Subtask
            function openAddSubtaskModal(parentId, parentTitle) {
                $('#subtaskParentId').val(parentId);
                $('#subtaskParentKey').val(parentTitle);
                $('#subtaskTitle').val('');
                $('#subtaskCategory').val('');
                const modal = new bootstrap.Modal(document.getElementById('addSubtaskModal'));
                modal.show();
            }

            // ارسال درخواست ایجاد Subtask
            function submitSubtask() {
                const parentId = $('#subtaskParentId').val();
                const title = $('#subtaskTitle').val().trim();
                const categoryId = $('#subtaskCategory').val();

                if (!title) {
                    showNotification('عنوان کارک الزامی است', 'error');
                    return;
                }

                const data = {
                    parentId: parseInt(parentId),
                    title: title
                };

                if (categoryId) {
                    data.categoryId = parseInt(categoryId);
                }

                // نمایش loading
                const submitBtn = $('button[onclick="submitSubtask()"]');
                const originalText = submitBtn.html();
                submitBtn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> در حال ایجاد...');

                $.ajax({
                    url: '/Tasks/AddChildIssue',
                    type: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify(data),
                    success: function(response) {
                        if (response.success) {
                            showNotification(response.message || 'کارک با موفقیت ایجاد شد', 'success');
                            // بستن Modal
                            bootstrap.Modal.getInstance(document.getElementById('addSubtaskModal')).hide();
                            // بارگذاری مجدد صفحه برای نمایش زیرتسک جدید
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showNotification('خطا: ' + (response.message || 'خطا در ایجاد کارک'), 'error');
                            submitBtn.prop('disabled', false).html(originalText);
                        }
                    },
                    error: function(xhr) {
                        let errorMsg = 'خطا در ارتباط با سرور';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            errorMsg = xhr.responseText;
                        }
                        showNotification('خطا: ' + errorMsg, 'error');
                        submitBtn.prop('disabled', false).html(originalText);
                    }
                });
            }

            // نمایش/مخفی کردن کارک‌ها
            function toggleSubtasks(issueId) {
                const container = document.getElementById(`subtasks-${issueId}`);
                const icon = document.getElementById(`subtask-icon-${issueId}`);
                
                if (container.style.display === 'none') {
                    container.style.display = 'block';
                    icon.className = 'bi bi-chevron-up';
                } else {
                    container.style.display = 'none';
                    icon.className = 'bi bi-chevron-down';
                }
            }

            // حذف کار یا کارک
            function deleteTask(taskId, taskTitle) {
                if (!confirm(`آیا مطمئن هستید که می‌خواهید کار "${taskTitle}" را حذف کنید؟\n\nاین عمل قابل بازگشت نیست و تمام کارک‌های آن نیز حذف خواهند شد.`)) {
                    return;
                }

                $.ajax({
                    url: '/Tasks/DeleteTask',
                    type: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({ taskId: taskId }),
                    success: function(response) {
                        if (response.success) {
                            showNotification(response.message || 'تسک با موفقیت حذف شد', 'success');
                        } else {
                            showNotification('خطا: ' + (response.message || 'خطا در حذف تسک'), 'error');
                            return;
                        }
                        // حذف کارت از صفحه
                        const card = document.querySelector(`.task-card[data-issue-id="${taskId}"]`);
                        const subtaskItem = document.querySelector(`.subtask-item`);
                        
                        if (card) {
                            card.style.transition = 'opacity 0.3s';
                            card.style.opacity = '0';
                            setTimeout(() => {
                                const column = card.closest('.kanban-column-body');
                                card.remove();
                                updateIssueCounts();
                                
                                const remainingCards = column.querySelectorAll('.task-card');
                                if (remainingCards.length === 0) {
                                    const emptyMsg = document.createElement('div');
                                    emptyMsg.className = 'empty-message text-muted text-center small p-4';
                                    emptyMsg.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                                    column.appendChild(emptyMsg);
                                }
                            }, 300);
                        } else if (subtaskItem && subtaskItem.closest(`[data-issue-id]`)) {
                            // اگر زیرتسک حذف شد، صفحه را refresh کن
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            // اگر کارت پیدا نشد، صفحه را refresh کن
                            setTimeout(() => location.reload(), 1000);
                        }
                    },
                    error: function(xhr) {
                        let errorMsg = 'خطا در ارتباط با سرور';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            errorMsg = xhr.responseText;
                        }
                        showNotification('خطا: ' + errorMsg, 'error');
                    }
                });
            }

            // فرم ایجاد تسک سریع
            $('#quickTaskForm').on('submit', function(e) {
                e.preventDefault();
                
                const title = $('#quickTaskTitle').val().trim();
                if (!title) {
                    showNotification('عنوان کار الزامی است', 'error');
                    return;
                }

                if (!quickTaskTargetStatusId) {
                    showNotification('ابتدا ستونی را برای افزودن کار انتخاب کنید', 'error');
                    return;
                }

                const issueType = parseInt($('#quickTaskType').val());
                const categoryId = $('#quickTaskCategory').val();
                const projectIssueTypeId = $('#quickTaskProjectIssueTypeId').val();
                
                const data = {
                    sprintId: sprintId,
                    title: title,
                    issueType: issueType,
                    statusId: quickTaskTargetStatusId
                };
                
                if (projectIssueTypeId) {
                    data.projectIssueTypeId = parseInt(projectIssueTypeId);
                }
                
                if (categoryId) {
                    data.categoryId = parseInt(categoryId);
                }

                // نمایش loading
                const submitBtn = $(this).find('button[type="submit"]');
                const originalText = submitBtn.html();
                submitBtn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> در حال ایجاد...');

                $.ajax({
                    url: '/Sprints/CreateQuickTask',
                    type: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify(data),
                    success: function(response) {
                        if (response.success) {
                            showNotification(response.message, 'success');
                            const modalElement = document.getElementById('quickTaskModal');
                            if (modalElement) {
                                bootstrap.Modal.getInstance(modalElement)?.hide();
                            }
                            $('#quickTaskTitle').val('');
                            $('#quickTaskCategory').val('');
                            resetQuickTaskTypeChips();
                            
                            // ذخیره اطلاعات برای scroll بعد از reload
                            const targetStatusId = response.statusId || quickTaskTargetStatusId;
                            sessionStorage.setItem('scrollToStatusAfterReload', targetStatusId.toString());
                            sessionStorage.setItem('highlightTaskAfterReload', response.taskId.toString());
                            
                            // رفرش بهینه صفحه با تاخیر کوتاه برای نمایش پیام موفقیت
                            setTimeout(function() {
                                window.location.reload();
                            }, 800);
                        } else {
                            showNotification('خطا: ' + response.message, 'error');
                            submitBtn.prop('disabled', false).html(originalText);
                            return;
                        }
                        submitBtn.prop('disabled', false).html(originalText);
                    },
                    error: function(xhr) {
                        const errorMsg = xhr.responseJSON?.message || 'خطا در ارتباط با سرور';
                        showNotification('خطا: ' + errorMsg, 'error');
                        submitBtn.prop('disabled', false).html(originalText);
                    }
                });
            });

            // خاتمه اسپرینت
            function completeSprint() {
                const confirmMsg = `آیا مطمئن هستید که می‌خواهید این اسپرینت را خاتمه دهید؟\n\n` +
                    `این عمل باعث می‌شود:\n` +
                    `✓ اسپرینت به حالت "خاتمه یافته" تغییر کند\n` +
                    `✓ تمام کارهای Done به صورت خودکار تکمیل شوند\n` +
                    `✓ به صفحه جزئیات پروژه هدایت شوید`;
                
                if (confirm(confirmMsg)) {
                    // ارسال فرم
                    document.getElementById('completeSprintForm').submit();
                }
            }
            </text>
        }
    </script>
}
