                            <input type="hidden" name="id" value="@Model.SprintId" />
                            <input type="hidden" name="status" value="@((int)SprintStatus.Completed)" />
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="window.submitSprintCompletion()">
                                <i class="bi bi-check-circle"></i>
                                خاتمه اسپرینت
                            </button>
                        </form>
                    }
                    <a href="/Projects/Details/@Model.ProjectId" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-right"></i>
