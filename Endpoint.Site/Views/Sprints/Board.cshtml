            // ساخت المان کامنت
                        function createCommentElement(comment) {
                const div = document.createElement('div');
                div.className = `chat-message ${comment.isCurrentUser ? 'own' : 'other'}`;
                div.id = `comment-${comment.id}`;
                const date = new Date(comment.createdAt).toLocaleString('fa-IR');

                let attachmentsHtml = '';
                if (comment.attachments && comment.attachments.length > 0) {
                    attachmentsHtml = comment.attachments.map(att => {
                        // استفاده از filePath به جای url
                        const fileUrl = att.filePath || att.url || '';
                        const fileName = att.fileName || 'فایل';
                        const fileType = att.fileType || att.mimeType || '';

                        if (fileType === 'Image' || fileType.startsWith('image/')) {
                            return `<img src="${fileUrl}" alt="${fileName}" style="max-width:200px; display:block; margin-top:6px; border-radius:8px;" />`;
                        } else if (fileType === 'Audio' || fileType.startsWith('audio/')) {
                            return `<audio controls src="${fileUrl}" style="width:100%; margin-top:6px;"></audio>`;
                        } else {
                            return `<a href="${fileUrl}" target="_blank" style="display:inline-block; margin-top:6px;">📎 ${fileName}</a>`;
                        }
                    }).join('');
                }

                div.innerHTML = `
                    ${!comment.isCurrentUser ? `<div class="message-user">${comment.userName}</div>` : ''}
                    <div class="message-text">${comment.message ?? ''}</div>
                    ${attachmentsHtml}
                    <div class="message-time">${date} ${comment.isCurrentUser ? `<a href="#" onclick="deleteComment(${comment.id})" style="margin-left:8px;">حذف</a>` : ''}</div>
                `;
                return div;
            }

