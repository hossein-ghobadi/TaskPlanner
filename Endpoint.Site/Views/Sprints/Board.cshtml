                const assignedUserSelect = document.getElementById('editTaskAssignedUser');
                const assignedUserLabel = assignedUserSelect.previousElementSibling;
                const assignedUserContainer = assignedUserSelect.closest('.col-md-6');
                
                // چک کردن اینکه آیا این یک Subtask است (issueType === 4)
                const isSubtask = taskData.issueType === 4;
                
                if (isSubtask) {
                    // برای Subtask: غیرفعال کردن فیلد و نمایش پیام
                    assignedUserSelect.innerHTML = '<option value="">-- انتخاب کاربر --</option>';
                    if (taskData.assignedUsers && taskData.assignedUserId) {
                        // نمایش کاربر فعلی برای اطلاع (فقط خواندنی)
                        const currentUser = taskData.assignedUsers.find(u => u.id == taskData.assignedUserId);
                        if (currentUser) {
                            const option = document.createElement('option');
                            option.value = currentUser.id;
                            option.textContent = currentUser.name;
                            option.selected = true;
                            assignedUserSelect.appendChild(option);
                        }
                    }
                    assignedUserSelect.disabled = true;
                    assignedUserSelect.setAttribute('title', 'مسئول کارک به صورت خودکار از کار والد گرفته می‌شود');
                    if (effortLevelSelect) {
                        effortLevelSelect.disabled = true;
                        effortLevelSelect.setAttribute('title', 'سطح کارک از آیتم والد مدیریت می‌شود');
                    }
                    
                    // اضافه کردن پیام توضیحی
                    let helpText = assignedUserContainer.querySelector('.subtask-assignee-help');
                    if (!helpText) {
                        helpText = document.createElement('small');
                        helpText.className = 'text-muted subtask-assignee-help';
                        helpText.style.display = 'block';
                        helpText.style.marginTop = '0.25rem';
                        helpText.innerHTML = '<i class="bi bi-info-circle"></i> مسئول کارک از کار والد گرفته می‌شود';
                        assignedUserSelect.parentNode.appendChild(helpText);
                    }
                } else {
                    // برای کارهای عادی: نمایش لیست کاربران
                    assignedUserSelect.innerHTML = '<option value="">-- انتخاب کاربر --</option>';
                    if (taskData.assignedUsers) {
                        taskData.assignedUsers.forEach(user => {
                            const option = document.createElement('option');
                            option.value = user.id;
                            option.textContent = user.name;
                            if (taskData.assignedUserId == user.id) {
                                option.selected = true;
                            }
                            assignedUserSelect.appendChild(option);
                        });
                    }
                    assignedUserSelect.disabled = false;
                    assignedUserSelect.removeAttribute('title');
                    if (effortLevelSelect) {
                        effortLevelSelect.disabled = false;
                        effortLevelSelect.removeAttribute('title');
                    }
                    
                    // حذف پیام توضیحی اگر وجود داشت
                    const helpText = assignedUserContainer?.querySelector('.subtask-assignee-help');
                    if (helpText) {
                        helpText.remove();
                    }
                }

                   

                // تنظیم Persian Datepicker
                initTaskModalDatePickers(startDateValue);

                const boardChecklist = document.getElementById('boardChecklistPanel');
                const et = taskData.issueType != null ? parseInt(taskData.issueType, 10) : NaN;
                const isTaskForChecklist = !isSubtask && et === 3;
                if (boardChecklist) {
                    if (isTaskForChecklist) {
                        boardChecklist.style.display = '';
                        boardSubtaskParentId = taskData.id;
                        ensureBoardSubtaskPanelBound();
                        const noteSub = document.getElementById('boardInlineSubtaskNote');
                        if (noteSub) noteSub.textContent = '';
                        await loadBoardSubtasks(taskData.id);
                    } else {
                        boardChecklist.style.display = 'none';
                        boardSubtaskParentId = null;
                    }
                }
                
            } catch (error) {
                showNotification('خطا در بارگذاری اطلاعات کار: ' + error.message, 'error');
                bootstrap.Modal.getInstance(modalElement)?.hide();
            }
        }





        async function submitCreateTask() {
            const title = document.getElementById('editTaskTitle').value.trim();
            if (!title) {
                showNotification('عنوان کار الزامی است', 'error');
                document.getElementById('editTaskTitle')?.focus();
                return;
            }

            const statusId = parseInt(document.getElementById('editTaskTargetStatusId').value, 10);
            const statusName = document.getElementById('editTaskTargetStatusName').value || '';
            if (!statusId) {
                showNotification('ستون مقصد نامعتبر است', 'error');
                return;
            }

            const issueType = parseInt(document.getElementById('editTaskIssueTypeHidden').value || '3', 10);
            const projectIssueTypeId = document.getElementById('editTaskProjectIssueTypeId').value || null;
            const assignedUserSelect = document.getElementById('editTaskAssignedUser');
            const assignedUserId = assignedUserSelect?.value || null;
            const assignedUserName = assignedUserId
                ? (assignedUserSelect.options[assignedUserSelect.selectedIndex]?.text || 'نامشخص')
                : 'نامشخص';

            const payload = {
                sprintId: sprintId,
                title: title,
                description: document.getElementById('editTaskDescription').value || '',
                issueType: issueType,
                statusId: statusId,
                categoryId: document.getElementById('editTaskCategory').value ? parseInt(document.getElementById('editTaskCategory').value, 10) : null,
                featureId: document.getElementById('editTaskFeature').value ? parseInt(document.getElementById('editTaskFeature').value, 10) : null,
                assignedUserId: assignedUserId,
                startDateSh: syncTaskModalStartHidden() || '',
                durationDays: (() => {
                    const raw = document.getElementById('editTaskDurationDays')?.value;
                    if (raw === '' || raw === null || raw === undefined) return null;
                    const n = parseInt(raw, 10);
                    return Number.isNaN(n) ? null : n;
                })(),
                effortLevel: document.getElementById('editTaskEffortLevel').value
                    ? parseInt(document.getElementById('editTaskEffortLevel').value, 10)
                    : null
            };
            if (projectIssueTypeId) {
                payload.projectIssueTypeId = parseInt(projectIssueTypeId, 10);
            }

            const submitBtn = document.getElementById('editTaskSubmitBtn');
            const originalText = submitBtn?.innerHTML || '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال افزودن...';
            }

            try {
                const response = await fetch('/Sprints/CreateQuickTask', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(payload)
                });
                const responseText = await response.text();
                let result;
                try {
                    result = responseText ? JSON.parse(responseText) : {};
                } catch (_) {
                    throw new Error('پاسخ سرور نامعتبر است. لطفاً صفحه را رفرش کنید.');
                }
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'خطا در افزودن کار');
                }

                appendQuickTaskCard({
                    id: result.taskId,
                    statusId: result.statusId || statusId,
                    statusName: result.statusName || statusName,
                    title: title,
                    issueKey: result.issueKey,
                    isCompleted: false,
                    assigneeId: assignedUserId || 'unassigned',
                    assigneeName: assignedUserName
                });
                highlightTaskCard(result.taskId);
                showNotification(result.message || 'کار با موفقیت اضافه شد', 'success');

                document.getElementById('editTaskTitle').value = '';
                document.getElementById('editTaskDescription').value = '';
                document.getElementById('editTaskCategory').value = '';
                document.getElementById('editTaskFeature').value = '';
                if (assignedUserSelect) assignedUserSelect.value = '';
                const effortLevelSelect = document.getElementById('editTaskEffortLevel');
                if (effortLevelSelect) effortLevelSelect.value = '';
                const effortLevelDisplay = document.getElementById('editTaskEffortLevelDisplay');
                if (effortLevelDisplay) effortLevelDisplay.textContent = 'تعیین نشده';
                initTaskModalDatePickers('');
                const durationReset = document.getElementById('editTaskDurationDays');
                if (durationReset) durationReset.value = '';
                setTimeout(function() {
                    document.getElementById('editTaskTitle')?.focus();
                }, 100);
            } catch (error) {
                showNotification(error.message || 'خطا در افزودن کار', 'error');
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            }
        }

        // ارسال فرم ویرایش کار
        async function submitEditTask() {
            const mode = document.getElementById('editTaskMode')?.value || 'edit';
            if (mode === 'create') {
                await submitCreateTask();
                return;
            }

            const taskId = document.getElementById('editTaskId').value;
            if (!taskId) {
                showNotification('شناسه کار نامعتبر است', 'error');
                return;
            }
            
            const title = document.getElementById('editTaskTitle').value.trim();
            if (!title) {
                showNotification('عنوان کار الزامی است', 'error');
                return;
            }
            
            // استفاده از hidden input برای IssueType
            const issueType = document.getElementById('editTaskIssueTypeHidden').value;
            if (!issueType) {
                showNotification('نوع کار الزامی است', 'error');
                return;
            }
            
            // دریافت ProjectIssueTypeId از hidden input
            const projectIssueTypeId = document.getElementById('editTaskProjectIssueTypeId').value || null;
            
            // برای Subtask، AssignedUserId را از داده‌های اصلی نگه دار (تغییر نمی‌دهیم)
            let assignedUserId = document.getElementById('editTaskAssignedUser').value || null;
            const isSubtask = parseInt(issueType) === 4;
            if (isSubtask && originalTaskData && originalTaskData.assignedUserId) {
                // برای Subtask، از AssignedUserId اصلی استفاده کن
                assignedUserId = originalTaskData.assignedUserId;
            }
            
            const formData = {
                Id: parseInt(taskId),
                Title: title,
                Description: document.getElementById('editTaskDescription').value || '',
                IssueType: parseInt(issueType),
                ProjectIssueTypeId: projectIssueTypeId ? parseInt(projectIssueTypeId) : null,
                ProjectId: parseInt(document.getElementById('editTaskProjectId').value),
                StartDateSh: syncTaskModalStartHidden() || '',
                DurationDays: (() => {
                    const raw = document.getElementById('editTaskDurationDays')?.value;
                    if (raw === '' || raw === null || raw === undefined) return null;
                    const n = parseInt(raw, 10);
                    return Number.isNaN(n) ? null : n;
                })(),
                CategoryId: document.getElementById('editTaskCategory').value ? parseInt(document.getElementById('editTaskCategory').value) : null,
                FeatureId: document.getElementById('editTaskFeature').value ? parseInt(document.getElementById('editTaskFeature').value) : null,
                AssignedUserId: assignedUserId,
                EffortLevel: document.getElementById('editTaskEffortLevel').value
                    ? parseInt(document.getElementById('editTaskEffortLevel').value)
                    : null,
                // این فیلد در مودال نمایش داده نمی‌شود، مقدار قبلی را حفظ می‌کنیم
                StoryPoints: originalTaskData?.storyPoints ?? null
            };
            
            // نمایش loading
            const submitBtn = document.getElementById('editTaskSubmitBtn');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال ذخیره...';
            
            try {
                // دریافت AntiForgeryToken
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                
                const response = await fetch('/Tasks/EditFromBoard', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        ...(token ? { 'RequestVerificationToken': token } : {})
                    },
                    body: JSON.stringify(formData),
                    credentials: 'same-origin'
                });
                
                // بررسی Content-Type
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.includes("application/json")) {
                    const result = await response.json();
                    if (response.ok && result.success) {
                        showNotification('کار با موفقیت ویرایش شد', 'success');
                        bootstrap.Modal.getInstance(document.getElementById('editTaskModal'))?.hide();
                        if (!updateTaskCardFromEdit(formData)) {
                            setTimeout(() => reloadBoard(), 1000);
                        } else {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalText;
                        }
                    } else {
                        showNotification('خطا: ' + (result.message || 'خطا در ویرایش کار'), 'error');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                } else {
                    // اگر JSON نبود، احتمالاً redirect شده یا خطا رخ داده
                    const text = await response.text();
                    console.error('Expected JSON but got:', contentType, text.substring(0, 200));
                    
                    if (response.redirected || response.status === 302 || response.status === 301) {
                        // احتمالاً redirect به login شده
                        showNotification('لطفاً دوباره وارد شوید', 'error');
                        setTimeout(() => reloadBoard(), 2000);
                    } else {
                        showNotification('خطا در ذخیره تغییرات. لطفاً صفحه را رفرش کنید.', 'error');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                }
            } catch (error) {
                console.error('Error submitting task:', error);
                showNotification('خطا در ارتباط با سرور: ' + error.message, 'error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }

        function deleteTaskFromEditModal() {
            const taskIdValue = document.getElementById('editTaskId')?.value;
            if (!taskIdValue) {
                showNotification('شناسه کار نامعتبر است', 'error');
                return;
            }

            const taskTitle = document.getElementById('editTaskTitle')?.value?.trim() || 'این کار';
            deleteTask(parseInt(taskIdValue, 10), taskTitle);
            bootstrap.Modal.getInstance(document.getElementById('editTaskModal'))?.hide();
        }

