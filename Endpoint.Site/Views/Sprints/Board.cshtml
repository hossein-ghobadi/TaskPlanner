@model Endpoint.Site.Models.SprintBoardVm
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var sprintId = ViewBag.SprintId as int?;
    var projectId = ViewBag.ProjectId as int?;
    var workflowStatuses = ViewBag.WorkflowStatuses as List<WorkflowStatus> ?? new List<WorkflowStatus>();
}

<style>
    .kanban-board {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        padding: 1rem 0;
    }
    .kanban-column {
        min-width: 280px;
        max-width: 280px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }
    .kanban-column-header {
        padding: 12px;
        font-weight: bold;
        color: white;
        border-radius: 8px 8px 0 0;
        text-align: center;
        margin-bottom: 8px;
    }
    .kanban-column-body {
        padding: 8px;
        min-height: 400px;
        max-height: 70vh;
        overflow-y: auto;
    }
    .kanban-card {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 8px;
        cursor: grab;
        transition: all 0.2s;
    }
    .kanban-card:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        transform: translateY(-2px);
    }
    .kanban-card:active {
        cursor: grabbing;
    }
    .kanban-card.dragging {
        opacity: 0.5;
    }
    .issue-key {
        font-weight: bold;
        font-size: 0.85rem;
        color: #495057;
    }
    .issue-title {
        font-size: 0.9rem;
        margin: 6px 0;
        color: #212529;
    }
    .issue-meta {
        font-size: 0.75rem;
        color: #6c757d;
        margin-top: 6px;
    }
    .issue-type-icon {
        font-size: 1.2rem;
    }
    .drop-zone {
        min-height: 400px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">📋 تخته کانبان</h2>
        <p class="text-muted mb-0">
            <strong>اسپرینت:</strong> @Model.SprintName | 
            <strong>پروژه:</strong> <a href="/Projects/Details/@Model.ProjectId">@Model.ProjectName</a>
        </p>
    </div>
    <div>
        <a style="background-color: royalblue; color: white;" class="btn" href="/Projects/Index">
            <i class="bi bi-arrow-right"></i> پروژه ها
        </a>
    </div>
</div>


<!-- تخته کانبان -->
<div class="kanban-board" id="board" data-sprint-id="@Model.SprintId">
    @foreach (var status in Model.Statuses.OrderBy(s => s.Order))
    {
        <div class="kanban-column">
            <div class="kanban-column-header" style="background-color: @(status.Color ?? "#6c757d");">
                @status.Name
                <span class="badge bg-light text-dark ms-1">
                    @{
                        var count = Model.SprintIssues.Count(t =>
                        (t.StatusId ?? (Model.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)) == status.Id);
                    }
                    @count
                </span>
            </div>
            <div class="kanban-column-body drop-zone"
                 ondragover="event.preventDefault();"
                 ondragenter="onDragEnter(event)"
                 ondragleave="onDragLeave(event)"
                 ondrop="onDropIssue(event, @status.Id)"
                 data-status-id="@status.Id">
                @{
                    var cards = Model.SprintIssues
                    .Where(t => (t.StatusId ?? (Model.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)) == status.Id)
                    .OrderBy(t => t.Priority)
                    .ToList();
                }
                @if (cards.Any())
                {
                    foreach (var issue in cards)
                    {
                        <div class="kanban-card"
                             draggable="true"
                             ondragstart="onDragIssue(event, @issue.Id)"
                             onclick="handleCardClick(event, @issue.Id)"
                             data-issue-id="@issue.Id"
                             style="cursor: pointer;">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="issue-key">@issue.IssueKey</span>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="issue-type-icon" title="@issue.IssueTypeName">@issue.IssueTypeIcon</span>
                                    @if (Model.Status == SprintStatus.Active && issue.CanHaveChildren)
                                    {
                                        <button class="btn btn-sm btn-outline-primary p-0 px-1"
                                                onclick="event.stopPropagation(); event.preventDefault(); openAddSubtaskModal(@issue.Id, '@issue.IssueKey');"
                                                title="افزودن زیرتسک"
                                                style="font-size: 0.7rem; line-height: 1;">
                                            <i class="bi bi-plus-circle"></i>
                                        </button>
                                    }
                                    @if (Model.Status == SprintStatus.Active)
                                    {
                                        <button class="btn btn-sm btn-outline-warning p-0 px-1"
                                                onclick="event.stopPropagation(); event.preventDefault(); removeTaskFromSprint(@issue.Id);"
                                                title="خارج کردن از اسپرینت"
                                                style="font-size: 0.7rem; line-height: 1;">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger p-0 px-1"
                                                onclick="event.stopPropagation(); event.preventDefault(); deleteTask(@issue.Id, '@issue.Title');"
                                                title="حذف تسک"
                                                style="font-size: 0.7rem; line-height: 1;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="issue-title">@issue.Title</div>

                            <div class="issue-meta">
                                <div>👤 @(issue.AssignedUser?.FullName ?? issue.AssignedUserName ?? issue.AssignedUser?.UserName ?? "نامشخص")</div>
                                @if (issue.DueDatePersian != "تعیین نشده")
                                {
                                    <div>🗓️ @issue.DueDatePersian</div>
                                }
                                @if (issue.StoryPoints.HasValue && issue.StoryPoints > 0)
                                {
                                    <div>⚡ @issue.StoryPoints SP</div>
                                }
                                @if (issue.ChildIssues != null && issue.ChildIssues.Any())
                                {
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <button class="btn btn-sm btn-outline-secondary p-0 px-2"
                                                onclick="event.stopPropagation(); event.preventDefault(); toggleSubtasks(@issue.Id);"
                                                style="font-size: 0.7rem;">
                                            <i class="bi bi-chevron-down" id="subtask-icon-@issue.Id"></i>
                                            @issue.ChildIssues.Count زیرتسک
                                        </button>
                                    </div>
                                }
                            </div>

                            @* نمایش زیرتسک‌ها *@
                            @if (issue.ChildIssues != null && issue.ChildIssues.Any())
                            {
                                <div class="subtasks-container mt-2" id="subtasks-@issue.Id" style="display: none; border-top: 1px solid #dee2e6; padding-top: 8px;">
                                    @foreach (var subtask in issue.ChildIssues.OrderBy(c => c.CreatedAt))
                                    {
                                        <div class="subtask-item d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded" style="font-size: 0.85rem;">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="issue-type-icon" style="font-size: 0.9rem;">@subtask.IssueTypeIcon</span>
                                                <div>
                                                    <div class="fw-bold">@subtask.IssueKey: @subtask.Title</div>
                                                    @if (!string.IsNullOrEmpty(subtask.Description))
                                                    {
                                                        <small class="text-muted">@(subtask.Description.Length > 50 ? subtask.Description.Substring(0, 50) + "..." : subtask.Description)</small>
                                                    }
                                                </div>
                                            </div>
                                            <div class="d-flex gap-1">
                                                <a href="/Tasks/Details/@subtask.Id" class="btn btn-sm btn-outline-info p-0 px-1"
                                                   onclick="event.stopPropagation();"
                                                   title="جزئیات"
                                                   style="font-size: 0.7rem;">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                @if (Model.Status == SprintStatus.Active)
                                                {
                                                    <button class="btn btn-sm btn-outline-danger p-0 px-1"
                                                            onclick="event.stopPropagation(); event.preventDefault(); deleteTask(@subtask.Id, '@subtask.Title');"
                                                            title="حذف زیرتسک"
                                                            style="font-size: 0.7rem;">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="empty-message text-muted text-center small p-4">
                        <i class="bi bi-inbox"></i><br>
                        هیچ آیتمی وجود ندارد
                    </div>
                }
            </div>
        </div>
    }
</div>
<!-- تسک‌های موجود برای اضافه شدن به اسپرینت -->
@if (Model.Status == SprintStatus.Active)
{
    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">تسک‌های موجود</h5>
        </div>
        <div class="card-body">
            <div id="availableTasksContainer">
                <p class="text-muted">در حال بارگذاری...</p>
            </div>
        </div>
    </div>
}


<!-- بخش افزودن تسک سریع -->
@if (Model.Status == SprintStatus.Active)
{
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-plus-circle"></i> افزودن تسک جدید
            </h5>
        </div>
        <div class="card-body">
            <form id="quickTaskForm" class="row g-3">
                <div class="col-md-4">
                    <label for="quickTaskTitle" class="form-label">عنوان <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="quickTaskTitle" required placeholder="عنوان تسک را وارد کنید">
                </div>
                <div class="col-md-2">
                    <label for="quickTaskType" class="form-label">نوع</label>
                    <select class="form-select" id="quickTaskType">
                        <option value="@((int)IssueType.Task)" selected>تسک</option>
                        <option value="@((int)IssueType.Story)">استوری</option>
                        <option value="@((int)IssueType.Bug)">باگ</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="quickTaskCategory" class="form-label">دسته‌بندی</label>
                    <select class="form-select" id="quickTaskCategory">
                        <option value="">-- بدون دسته --</option>
                        @{
                            var categories = ViewBag.Categories as List<TaskPlanner.Domain.Entities.TaskPlanner.TaskCategory> ?? new List<TaskPlanner.Domain.Entities.TaskPlanner.TaskCategory>();
                        }
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle"></i> افزودن
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- اطلاعات اسپرینت -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h5>اطلاعات اسپرینت</h5>
                <p><strong>نام:</strong> @Model.SprintName</p>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p><strong>توضیحات:</strong> @Model.Description</p>
                }
                @if (!string.IsNullOrEmpty(Model.Goal))
                {
                    <p><strong>هدف:</strong> @Model.Goal</p>
                }
                <p><strong>تاریخ شروع:</strong> @Model.StartDatePersian</p>
                <p><strong>تاریخ پایان:</strong> @Model.EndDatePersian</p>
                <p>
                    <strong>وضعیت:</strong> 
                    <span class="badge @(Model.Status == SprintStatus.Active ? "bg-success" : Model.Status == SprintStatus.Completed ? "bg-secondary" : "bg-warning")">
                        @(Model.Status == SprintStatus.Active ? "فعال" : Model.Status == SprintStatus.Completed ? "خاتمه یافته" : "در حال برنامه‌ریزی")
                    </span>
                </p>
            </div>
            <div class="col-md-6">
                <h5>آمار</h5>
                <div class="mb-3">
                    <h6>پیشرفت کلی</h6>
                    <div class="progress">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @Model.CompletionPercentage%" aria-valuenow="@Model.CompletionPercentage" aria-valuemin="0" aria-valuemax="100">
                            @Model.CompletionPercentage.ToString("F1")%
                        </div>
                    </div>
                </div>
                <ul class="list-group">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        کل تسک‌ها
                        <span class="badge bg-primary rounded-pill">@Model.TotalTasks</span>
                    </li>
                    @foreach (var status in workflowStatuses)
                    {
                        var taskCountForStatus = Model.SprintIssues.Count(t => t.StatusId == status.Id);
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span style="color: @status.Color;">@status.Name</span>
                            <span class="badge rounded-pill" style="background-color: @status.Color;">@taskCountForStatus</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>


<!-- Modal افزودن Subtask -->
<div class="modal fade" id="addSubtaskModal" tabindex="-1" aria-labelledby="addSubtaskModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addSubtaskModalLabel">افزودن زیرتسک</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addSubtaskForm">
                    <input type="hidden" id="subtaskParentId" />
                    <div class="mb-3">
                        <label for="subtaskParentKey" class="form-label">تسک والد</label>
                        <input type="text" class="form-control" id="subtaskParentKey" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="subtaskTitle" class="form-label">عنوان زیرتسک <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="subtaskTitle" required placeholder="عنوان زیرتسک را وارد کنید">
                    </div>
                    <div class="mb-3">
                        <label for="subtaskCategory" class="form-label">دسته‌بندی</label>
                        <select class="form-select" id="subtaskCategory">
                            <option value="">-- بدون دسته --</option>
                            @{
                                var categoriesForSubtask = ViewBag.Categories as List<TaskPlanner.Domain.Entities.TaskPlanner.TaskCategory> ?? new List<TaskPlanner.Domain.Entities.TaskPlanner.TaskCategory>();
                            }
                            @foreach (var cat in categoriesForSubtask)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="submitSubtask()">افزودن زیرتسک</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        let draggedIssueId = null;
        let draggedCard = null;
        let isDragging = false;
        let mouseDownX = 0;
        let mouseDownY = 0;
        const projectId = @(projectId ?? 0);
        const sprintId = @(sprintId ?? 0);

        function onDragIssue(e, issueId) {
            isDragging = true;
            draggedIssueId = issueId;
            draggedCard = e.currentTarget;
            draggedCard.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', issueId);
        }

        function handleCardClick(e, issueId) {
            // اگر drag در حال انجام است یا از دکمه حذف کلیک شده، از redirect جلوگیری کن
            if (isDragging) {
                return;
            }
            // بررسی اینکه آیا از دکمه حذف کلیک شده یا نه
            if (e.target.closest('button')) {
                return;
            }
            // در غیر این صورت، به جزئیات تسک برو
            window.location.href = '/Tasks/Details/' + issueId;
        }

        // ثبت موقعیت mouse down برای تشخیص drag vs click
        document.addEventListener('mousedown', function(e) {
            if (e.target.closest('.kanban-card')) {
                mouseDownX = e.clientX;
                mouseDownY = e.clientY;
            }
        });

        // بررسی اینکه آیا واقعاً drag شده یا فقط click
        document.addEventListener('mousemove', function(e) {
            if (mouseDownX !== 0 && mouseDownY !== 0) {
                const deltaX = Math.abs(e.clientX - mouseDownX);
                const deltaY = Math.abs(e.clientY - mouseDownY);
                // اگر بیش از 5 پیکسل حرکت کرده، drag است
                if (deltaX > 5 || deltaY > 5) {
                    isDragging = true;
                }
            }
        });

        // Reset موقعیت mouse بعد از mouse up
        document.addEventListener('mouseup', function(e) {
            if (!isDragging) {
                mouseDownX = 0;
                mouseDownY = 0;
            }
        });

        function onDragEnter(e) {
            e.preventDefault();
            e.currentTarget.style.backgroundColor = '#e3f2fd';
            e.currentTarget.style.borderColor = '#2196f3';
        }

        function onDragLeave(e) {
            e.currentTarget.style.backgroundColor = '';
            e.currentTarget.style.borderColor = '';
        }

        async function onDropIssue(e, toStatusId) {
            e.preventDefault();
            const dropZone = e.currentTarget;
            onDragLeave(e);
            
            const issueId = draggedIssueId || parseInt(e.dataTransfer.getData('text/plain'));
            if (!issueId) return;

            if (draggedCard) {
                draggedCard.style.opacity = '0.5';
            }

            try {
                const res = await fetch('/Tasks/MoveIssue', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ 
                        taskId: issueId, 
                        toStatusId: toStatusId,
                        reason: 'تماس از تخته کانبان'
                    })
                });

                if (!res.ok) {
                    const errorText = await res.text();
                    alert('خطا: ' + errorText || 'خطا در انتقال وضعیت');
                    if (draggedCard) {
                        draggedCard.style.opacity = '1';
                    }
                    return;
                }

                const result = await res.json();
                console.log('Success:', result);

                if (draggedCard) {
                    draggedCard.classList.remove('dragging');
                    draggedCard.style.opacity = '1';
                    
                    const sourceColumn = draggedCard.closest('.kanban-column-body');
                    
                    if (dropZone) {
                        const emptyMessage = dropZone.querySelector('.empty-message');
                        if (emptyMessage) {
                            emptyMessage.style.display = 'none';
                        }
                        
                        dropZone.appendChild(draggedCard);
                    }
                    
                    if (sourceColumn && sourceColumn !== dropZone) {
                        const sourceCards = sourceColumn.querySelectorAll('.kanban-card');
                        if (sourceCards.length === 0) {
                            const sourceEmptyMessage = sourceColumn.querySelector('.empty-message');
                            if (sourceEmptyMessage) {
                                sourceEmptyMessage.style.display = 'block';
                            } else {
                                const emptyMsg = document.createElement('div');
                                emptyMsg.className = 'empty-message text-muted text-center small p-4';
                                emptyMsg.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                                sourceColumn.appendChild(emptyMsg);
                            }
                        }
                    }
                    
                    updateIssueCounts();
                } else {
                    location.reload();
                }

            } catch (err) {
                console.error('Error:', err);
                alert('خطای شبکه: ' + err.message);
                if (draggedCard) {
                    draggedCard.style.opacity = '1';
                }
            } finally {
                draggedIssueId = null;
                draggedCard = null;
            }
        }

        function updateIssueCounts() {
            document.querySelectorAll('.kanban-column').forEach(column => {
                const body = column.querySelector('.kanban-column-body');
                const count = body ? body.querySelectorAll('.kanban-card').length : 0;
                const badge = column.querySelector('.kanban-column-header .badge');
                if (badge) {
                    badge.textContent = count;
                }
            });
        }

        document.addEventListener('dragend', function(e) {
            isDragging = false;
            mouseDownX = 0;
            mouseDownY = 0;
            document.querySelectorAll('.drop-zone').forEach(zone => {
                zone.style.backgroundColor = '';
                zone.style.borderColor = '';
            });
        });

        // بارگذاری تسک‌های موجود (فقط برای اسپرینت فعال)
        @if (Model.Status == SprintStatus.Active)
        {
            <text>
            function showNotification(message, type = 'success') {
                const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
                const alertHtml = `
                    <div class="alert ${alertClass} alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 9999; min-width: 300px;">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                $('body').append(alertHtml);
                
                setTimeout(() => {
                    $('.alert').fadeOut(300, function() {
                        $(this).remove();
                    });
                }, 3000);
            }

            function loadAvailableTasks() {
                $.ajax({
                    url: '/Sprints/GetProjectTasks',
                    type: 'GET',
                    data: { projectId: projectId, sprintId: sprintId },
                    success: function(response) {
                        if (response.success) {
                            displayAvailableTasks(response.tasks);
                        } else {
                            $('#availableTasksContainer').html('<p class="text-muted">خطا در بارگذاری تسک‌ها: ' + response.message + '</p>');
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#availableTasksContainer').html('<p class="text-danger">خطا در ارتباط با سرور: ' + error + '</p>');
                    }
                });
            }

            function displayAvailableTasks(tasks) {
                const container = $('#availableTasksContainer');
                
                if (tasks.length === 0) {
                    container.html('<p class="text-muted">تسک قابل اضافه شدن وجود ندارد.</p>');
                    return;
                }

                let html = '<div class="list-group">';
                tasks.forEach(task => {
                    html += `
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">${task.title}</h6>
                                <small class="text-muted">${task.categoryName} - ${task.assignedUserName}</small>
                            </div>
                            <button class="btn btn-sm btn-success" onclick="addTaskToSprint(${task.id})">
                                <i class="bi bi-plus"></i> اضافه کردن
                            </button>
                        </div>
                    `;
                });
                html += '</div>';
                
                container.html(html);
            }

            function addTaskToSprint(taskId) {
                $.ajax({
                    url: '/Sprints/AddTaskToSprint',
                    type: 'POST',
                    data: { sprintId: sprintId, taskId: taskId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            showNotification('تسک با موفقیت به اسپرینت اضافه شد', 'success');
                            loadAvailableTasks();
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showNotification('خطا: ' + response.message, 'error');
                        }
                    },
                    error: function() {
                        showNotification('خطا در ارتباط با سرور', 'error');
                    }
                });
            }

            function removeTaskFromSprint(taskId) {
                if (!confirm('آیا مطمئن هستید که می‌خواهید این تسک را از اسپرینت خارج کنید؟')) {
                    return;
                }

                $.ajax({
                    url: '/Sprints/RemoveTaskFromSprint',
                    type: 'POST',
                    data: { sprintId: sprintId, taskId: taskId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            showNotification('تسک با موفقیت از اسپرینت خارج شد', 'success');
                            // حذف کارت از صفحه
                            const card = document.querySelector(`.kanban-card[data-issue-id="${taskId}"]`);
                            if (card) {
                                card.style.transition = 'opacity 0.3s';
                                card.style.opacity = '0';
                                setTimeout(() => {
                                    const column = card.closest('.kanban-column-body');
                                    card.remove();
                                    updateIssueCounts();
                                    
                                    // نمایش پیام خالی اگر ستون خالی شد
                                    const remainingCards = column.querySelectorAll('.kanban-card');
                                    if (remainingCards.length === 0) {
                                        const emptyMsg = document.createElement('div');
                                        emptyMsg.className = 'empty-message text-muted text-center small p-4';
                                        emptyMsg.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                                        column.appendChild(emptyMsg);
                                    }
                                }, 300);
                            }
                            // بارگذاری مجدد تسک‌های موجود
                            loadAvailableTasks();
                        } else {
                            showNotification('خطا: ' + response.message, 'error');
                        }
                    },
                    error: function() {
                        showNotification('خطا در ارتباط با سرور', 'error');
                    }
                });
            }

            $(document).ready(function() {
                loadAvailableTasks();
            });

            // باز کردن Modal افزودن Subtask
            function openAddSubtaskModal(parentId, parentKey) {
                $('#subtaskParentId').val(parentId);
                $('#subtaskParentKey').val(parentKey);
                $('#subtaskTitle').val('');
                $('#subtaskCategory').val('');
                const modal = new bootstrap.Modal(document.getElementById('addSubtaskModal'));
                modal.show();
            }

            // ارسال درخواست ایجاد Subtask
            function submitSubtask() {
                const parentId = $('#subtaskParentId').val();
                const title = $('#subtaskTitle').val().trim();
                const categoryId = $('#subtaskCategory').val();

                if (!title) {
                    showNotification('عنوان زیرتسک الزامی است', 'error');
                    return;
                }

                const data = {
                    parentId: parseInt(parentId),
                    title: title
                };

                if (categoryId) {
                    data.categoryId = parseInt(categoryId);
                }

                // نمایش loading
                const submitBtn = $('button[onclick="submitSubtask()"]');
                const originalText = submitBtn.html();
                submitBtn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> در حال ایجاد...');

                $.ajax({
                    url: '/Tasks/AddChildIssue',
                    type: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify(data),
                    success: function(response) {
                        if (response.success) {
                            showNotification(response.message || 'زیرتسک با موفقیت ایجاد شد', 'success');
                            // بستن Modal
                            bootstrap.Modal.getInstance(document.getElementById('addSubtaskModal')).hide();
                            // بارگذاری مجدد صفحه برای نمایش زیرتسک جدید
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showNotification('خطا: ' + (response.message || 'خطا در ایجاد زیرتسک'), 'error');
                            submitBtn.prop('disabled', false).html(originalText);
                        }
                    },
                    error: function(xhr) {
                        let errorMsg = 'خطا در ارتباط با سرور';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            errorMsg = xhr.responseText;
                        }
                        showNotification('خطا: ' + errorMsg, 'error');
                        submitBtn.prop('disabled', false).html(originalText);
                    }
                });
            }

            // نمایش/مخفی کردن زیرتسک‌ها
            function toggleSubtasks(issueId) {
                const container = document.getElementById(`subtasks-${issueId}`);
                const icon = document.getElementById(`subtask-icon-${issueId}`);
                
                if (container.style.display === 'none') {
                    container.style.display = 'block';
                    icon.className = 'bi bi-chevron-up';
                } else {
                    container.style.display = 'none';
                    icon.className = 'bi bi-chevron-down';
                }
            }

            // حذف تسک یا زیرتسک
            function deleteTask(taskId, taskTitle) {
                if (!confirm(`آیا مطمئن هستید که می‌خواهید تسک "${taskTitle}" را حذف کنید؟\n\nاین عمل قابل بازگشت نیست و تمام زیرتسک‌های آن نیز حذف خواهند شد.`)) {
                    return;
                }

                $.ajax({
                    url: '/Tasks/DeleteTask',
                    type: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({ taskId: taskId }),
                    success: function(response) {
                        if (response.success) {
                            showNotification(response.message || 'تسک با موفقیت حذف شد', 'success');
                        } else {
                            showNotification('خطا: ' + (response.message || 'خطا در حذف تسک'), 'error');
                            return;
                        }
                        // حذف کارت از صفحه
                        const card = document.querySelector(`.kanban-card[data-issue-id="${taskId}"]`);
                        const subtaskItem = document.querySelector(`.subtask-item`);
                        
                        if (card) {
                            card.style.transition = 'opacity 0.3s';
                            card.style.opacity = '0';
                            setTimeout(() => {
                                const column = card.closest('.kanban-column-body');
                                card.remove();
                                updateIssueCounts();
                                
                                const remainingCards = column.querySelectorAll('.kanban-card');
                                if (remainingCards.length === 0) {
                                    const emptyMsg = document.createElement('div');
                                    emptyMsg.className = 'empty-message text-muted text-center small p-4';
                                    emptyMsg.innerHTML = '<i class="bi bi-inbox"></i><br>هیچ آیتمی وجود ندارد';
                                    column.appendChild(emptyMsg);
                                }
                            }, 300);
                        } else if (subtaskItem && subtaskItem.closest(`[data-issue-id]`)) {
                            // اگر زیرتسک حذف شد، صفحه را refresh کن
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            // اگر کارت پیدا نشد، صفحه را refresh کن
                            setTimeout(() => location.reload(), 1000);
                        }
                    },
                    error: function(xhr) {
                        let errorMsg = 'خطا در ارتباط با سرور';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            errorMsg = xhr.responseText;
                        }
                        showNotification('خطا: ' + errorMsg, 'error');
                    }
                });
            }

            // فرم ایجاد تسک سریع
            $('#quickTaskForm').on('submit', function(e) {
                e.preventDefault();
                
                const title = $('#quickTaskTitle').val().trim();
                if (!title) {
                    showNotification('عنوان تسک الزامی است', 'error');
                    return;
                }

                const issueType = parseInt($('#quickTaskType').val());
                const categoryId = $('#quickTaskCategory').val();
                
                const data = {
                    sprintId: sprintId,
                    title: title,
                    issueType: issueType
                };
                
                if (categoryId) {
                    data.categoryId = parseInt(categoryId);
                }

                // نمایش loading
                const submitBtn = $(this).find('button[type="submit"]');
                const originalText = submitBtn.html();
                submitBtn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> در حال ایجاد...');

                $.ajax({
                    url: '/Sprints/CreateQuickTask',
                    type: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify(data),
                    success: function(response) {
                        if (response.success) {
                            showNotification(response.message, 'success');
                            // پاک کردن فرم
                            $('#quickTaskTitle').val('');
                            $('#quickTaskType').val('@((int)IssueType.Task)');
                            $('#quickTaskCategory').val('');
                            // بارگذاری مجدد صفحه برای نمایش تسک جدید
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showNotification('خطا: ' + response.message, 'error');
                            submitBtn.prop('disabled', false).html(originalText);
                        }
                    },
                    error: function(xhr) {
                        const errorMsg = xhr.responseJSON?.message || 'خطا در ارتباط با سرور';
                        showNotification('خطا: ' + errorMsg, 'error');
                        submitBtn.prop('disabled', false).html(originalText);
                    }
                });
            });
            </text>
        }
    </script>
}
