@model Endpoint.Site.Areas.TaskPlanner.Models.SprintBoardVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var backlog = ViewBag.BacklogIssues as IList<TaskItem>;
    bool hasActiveSprint = ViewBag.HasActiveSprint == true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">🗂️ بک‌لاگ پروژه</h2>
        <p class="text-muted mb-0">
            <strong>پروژه:</strong> <a href="/TaskPlanner/Projects/Details/@Model.ProjectId">@Model.ProjectName</a>
            @if (hasActiveSprint)
            {
                <span class="ms-3">
                    <strong>اسپرینت فعال:</strong> <a href="/TaskPlanner/Sprints/Board/@Model.SprintId">@Model.SprintName</a>
                </span>
            }
            else
            {
                <span class="ms-3 text-danger">اسپرینت فعالی وجود ندارد</span>
            }
        </p>
    </div>
    <div>
        <a class="btn btn-secondary" href="/TaskPlanner/Sprints/Index?projectId=@Model.ProjectId">بازگشت به اسپرینت‌ها</a>
        @if (hasActiveSprint)
        {
            <a class="btn btn-primary" href="/TaskPlanner/Sprints/Board/@Model.SprintId">رفتن به تخته کانبان</a>
        }
    </div>
    
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-6">
                <input id="search" class="form-control" placeholder="جستجو بر اساس عنوان..." />
            </div>
            <div class="col-md-3">
                <select id="filterType" class="form-select">
                    <option value="">همه نوع‌ها</option>
                    <option value="Epic">Epic</option>
                    <option value="Story">Story</option>
                    <option value="Task">Task</option>
                    <option value="Bug">Bug</option>
                    <option value="Subtask">Subtask</option>
                </select>
            </div>
            <div class="col-md-3">
                <select id="filterPriority" class="form-select">
                    <option value="">همه اولویت‌ها</option>
                    <option value="Critical">Critical</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div id="backlogList" class="row g-3">
    @if (backlog != null && backlog.Any())
    {
        foreach (var item in backlog)
        {
            <div class="col-md-6 backlog-item" data-type="@item.IssueTypeName" data-priority="@item.Priority" data-title="@item.Title">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-bold">
                                    <span class="me-2" title="@item.IssueTypeName">@item.IssueTypeIcon</span>
                                    @item.IssueKey - @item.Title
                                </div>
                                <div class="text-muted small">@item.IssueTypeName • اولویت: @item.Priority</div>
                                <div class="text-muted small">👤 @item.AssignedUserName</div>
                                @if (item.DueDatePersian != "تعیین نشده")
                                {
                                    <div class="text-muted small">🗓️ @item.DueDatePersian</div>
                                }
                            </div>
                            <div>
                                @if (hasActiveSprint)
                                {
                                    <button class="btn btn-sm btn-primary" onclick="addToSprint(@item.Id)">افزودن به اسپرینت</button>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">بدون اسپرینت فعال</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info mb-0">آیتمی در بک‌لاگ یافت نشد.</div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function addToSprint(taskId) {
            const sprintId = @Model.SprintId;
            if (!sprintId) { alert('اسپرینت فعالی وجود ندارد.'); return; }
            fetch('/TaskPlanner/Sprints/AddTaskToSprint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: new URLSearchParams({ sprintId: sprintId, taskId: taskId })
            }).then(r => r.json()).then(res => {
                if (!res.success) { alert(res.message || 'خطا در افزودن به اسپرینت'); return; }
                // حذف کارت از لیست بک‌لاگ
                const card = document.querySelector(`.backlog-item button[onclick="addToSprint(${taskId})"]`)?.closest('.backlog-item');
                if (card) card.remove();
            }).catch(() => alert('خطای شبکه'));
        }

        // فیلتر ساده
        const searchInput = document.getElementById('search');
        const filterType = document.getElementById('filterType');
        const filterPriority = document.getElementById('filterPriority');

        function applyFilters() {
            const q = (searchInput.value || '').trim().toLowerCase();
            const t = filterType.value;
            const p = filterPriority.value;
            document.querySelectorAll('#backlogList .backlog-item').forEach(el => {
                const title = (el.getAttribute('data-title') || '').toLowerCase();
                const type = el.getAttribute('data-type') || '';
                const pri = el.getAttribute('data-priority') || '';
                const match = (!q || title.includes(q)) && (!t || type === t) && (!p || pri === p);
                el.style.display = match ? '' : 'none';
            });
        }

        [searchInput, filterType, filterPriority].forEach(el => el.addEventListener('input', applyFilters));
    </script>
}


