@model IEnumerable<dynamic>
@using System.Globalization
@{
    ViewData["Title"] = "اعلان‌ها";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
    var notifications = Model?.ToList() ?? new List<dynamic>();
}

<div class="container-fluid px-1 px-md-2 py-2">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-bell me-2"></i>اعلان‌ها</h5>
            <span class="badge bg-secondary">@notifications.Count</span>
        </div>
        <div class="list-group list-group-flush">
            @if (notifications.Count == 0)
            {
                <div class="list-group-item text-muted py-4 text-center">اعلانی وجود ندارد.</div>
            }
            else
            {
                foreach (var item in notifications)
                {
                    var unreadClass = item.IsRead == true ? "" : "bg-light";
                    <div class="list-group-item @unreadClass">
                        <div class="fw-semibold">@item.Title</div>
                        <div class="small text-muted mt-1">@item.Message</div>
                        <div class="small text-secondary mt-2">
                            <i class="bi bi-clock me-1"></i>@FormatTehranPersianDateTime(item.CreatedAt)
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@functions {
    private static TimeZoneInfo TehranTimeZone()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Iran Standard Time"); } catch { }
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran"); } catch { }
        return TimeZoneInfo.Local;
    }

    private static DateTime ToTehranTime(DateTime dateTime)
    {
        var utc = dateTime.Kind == DateTimeKind.Utc ? dateTime : dateTime.ToUniversalTime();
        return TimeZoneInfo.ConvertTimeFromUtc(utc, TehranTimeZone());
    }

    public string FormatTehranPersianDateTime(object rawDate)
    {
        DateTime value;
        if (rawDate is DateTime dt)
        {
            value = dt;
        }
        else if (rawDate is DateTimeOffset dto)
        {
            value = dto.UtcDateTime;
        }
        else if (!DateTime.TryParse(rawDate?.ToString(), out value))
        {
            return "";
        }

        return ToTehranTime(value).ToString("yyyy/MM/dd HH:mm", new CultureInfo("fa-IR"));
    }
}
