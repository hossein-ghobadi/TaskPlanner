@model Endpoint.Site.Models.CrmManageVm
@{
    ViewData["Title"] = "مدیریت CRM";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="boards-page" style="max-width: 800px;">
    <div class="boards-head d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h1 class="boards-title mb-0">مدیریت CRM</h1>
        <a class="btn btn-outline-secondary btn-sm" href="/Leads/Index">بازگشت به لیدها</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-2">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-2">@TempData["Error"]</div>
    }

    @if (Model.OwnedCrms.Count > 1)
    {
        <form method="get" asp-action="Manage" class="mt-3 d-flex align-items-center gap-2">
            <label class="small text-muted mb-0" for="crmSelect">CRM</label>
            <select id="crmSelect" name="crmId" class="form-select form-select-sm" style="max-width: 240px;" onchange="this.form.submit()">
                @foreach (var crm in Model.OwnedCrms)
                {
                    if (crm.Id == Model.CrmId)
                    {
                        <option value="@crm.Id" selected>@crm.DisplayLabel</option>
                    }
                    else
                    {
                        <option value="@crm.Id">@crm.DisplayLabel</option>
                    }
                }
            </select>
        </form>
    }
    else
    {
        <p class="text-muted small mt-2 mb-0">در حال مدیریت: <strong>@Model.DisplayLabel</strong></p>
    }

    <div class="card border mt-3">
        <div class="card-header fw-bold">دعوت به CRM</div>
        <div class="card-body">
            <p class="small text-muted mb-3">
                افراد دعوت‌شده به <strong>همه لیدهای این CRM</strong> دسترسی دارند.
                برای ورود به پروژه باید جداگانه عضو پروژه شوند.
            </p>
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <form asp-controller="Crm" asp-action="AddMember" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="crmId" value="@Model.CrmId" />
                        <div class="flex-grow-1" style="min-width: 200px;">
                            <label class="form-label small mb-1">افزودن از همکاران</label>
                            <select name="memberUserId" class="form-select form-select-sm" required>
                                <option value="">— انتخاب کنید —</option>
                                @foreach (var u in Model.CollaboratorChoices)
                                {
                                    <option value="@u.Id">@u.DisplayName</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">افزودن</button>
                    </form>
                </div>
                <div class="col-md-6">
                    <form asp-controller="Crm" asp-action="InviteByPhone" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="crmId" value="@Model.CrmId" />
                        <div class="flex-grow-1" style="min-width: 200px;">
                            <label class="form-label small mb-1">دعوت با شماره موبایل</label>
                            <input type="text" name="phone" class="form-control form-control-sm" placeholder="مثلاً 0912..." autocomplete="tel" required />
                        </div>
                        <button type="submit" class="btn btn-outline-primary btn-sm">ارسال دعوت</button>
                    </form>
                </div>
            </div>

            @if (Model.Members.Any())
            {
                <h6 class="mt-4 mb-2 text-muted small">اعضای فعلی</h6>
                <ul class="list-group list-group-flush border rounded">
                    @foreach (var m in Model.Members)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span>@m.DisplayName</span>
                            <form asp-controller="Crm" asp-action="RemoveMember" method="post" class="m-0" onsubmit="return confirm('این همکار از CRM حذف شود؟');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="crmId" value="@Model.CrmId" />
                                <input type="hidden" name="memberUserId" value="@m.UserId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small mt-3 mb-0">هنوز عضوی به این CRM اضافه نشده است.</p>
            }

            @if (Model.PendingInvitations.Any())
            {
                <h6 class="mt-3 mb-2 text-muted small">دعوت‌های در انتظار</h6>
                <ul class="list-group list-group-flush border rounded">
                    @foreach (var inv in Model.PendingInvitations)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                            <span>@(inv.InviteeDisplayName ?? inv.InviteePhone)</span>
                            <form asp-controller="Crm" asp-action="CancelInvite" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="invitationId" value="@inv.Id" />
                                <input type="hidden" name="crmId" value="@Model.CrmId" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">لغو دعوت</button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
