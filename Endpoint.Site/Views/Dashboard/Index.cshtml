@model TaskPlanner.Application.Services.DashboardService.UserDashboardDto
@using TaskPlanner.Application.Services.DashboardService
@using DNTPersianUtils.Core
@{
    ViewData["Title"] = "داشبورد";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
    var chartsJson = ViewBag.ChartsJson as string ?? "{}";
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<div class="dashboard-overview-page">
    <header class="dashboard-overview-header mb-4">
        <nav class="dashboard-breadcrumb mb-2 text-muted small" aria-label="breadcrumb">
            <span>خانه</span>
            <span class="mx-1">/</span>
            <span class="fw-semibold text-dark">داشبورد</span>
        </nav>
        <h1 class="h3 fw-bold mb-1">نمای کلی کار شما</h1>
        <p class="text-muted mb-0">وضعیت پروژه‌ها، کارهای تخصیص‌یافته، جلسات لید و نمودارهای خلاصه در یک نگاه.</p>
    </header>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <a href="@Url.Action("Index", "Projects")" class="text-decoration-none">
                <div class="dash-stat-card dash-stat-card--indigo">
                    <div class="dash-stat-card__icon"><i class="bi bi-folder2-open"></i></div>
                    <div class="dash-stat-card__value">@Model.TotalProjectsCount.ToString().ToPersianNumbers()</div>
                    <div class="dash-stat-card__label">پروژه‌ها</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-xl-3">
            <div class="dash-stat-card dash-stat-card--amber">
                <div class="dash-stat-card__icon"><i class="bi bi-kanban"></i></div>
                <div class="dash-stat-card__value">@Model.MyOpenProjectTasks.ToString().ToPersianNumbers()</div>
                <div class="dash-stat-card__label">کار باز (پروژه)</div>
                @if (Model.MyOverdueProjectTasks > 0)
                {
                    <div class="dash-stat-card__hint text-danger small mt-1">
                        @Model.MyOverdueProjectTasks.ToString().ToPersianNumbers() سررسید گذشته
                    </div>
                }
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="dash-stat-card dash-stat-card--emerald">
                <div class="dash-stat-card__icon"><i class="bi bi-lightning-charge"></i></div>
                <div class="dash-stat-card__value">@Model.ActiveSprintCount.ToString().ToPersianNumbers()</div>
                <div class="dash-stat-card__label">اسپرینت فعال</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <a href="@Url.Action("Index", "Notifications")" class="text-decoration-none">
                <div class="dash-stat-card dash-stat-card--rose">
                    <div class="dash-stat-card__icon"><i class="bi bi-bell"></i></div>
                    <div class="dash-stat-card__value">@Model.UnreadNotifications.ToString().ToPersianNumbers()</div>
                    <div class="dash-stat-card__label">اعلان خوانده‌نشده</div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="dash-panel h-100">
                <h2 class="dash-panel__title"><i class="bi bi-clipboard-data me-2 text-secondary"></i>جمع‌بندی سریع</h2>
                <ul class="list-unstyled mb-0 dash-quick-list">
                    <li>
                        <span class="text-muted">کار انجام‌شده (پروژه)</span>
                        <strong>@Model.MyCompletedProjectTasks.ToString().ToPersianNumbers()</strong>
                    </li>
                    <li>
                        <span class="text-muted">کار تخته (باز / تمام)</span>
                        <strong>@Model.MyOpenBoardTasks.ToString().ToPersianNumbers() / @Model.MyCompletedBoardTasks.ToString().ToPersianNumbers()</strong>
                    </li>
                    <li>
                        <span class="text-muted">لیدهای در دسترس</span>
                        <strong>@Model.AccessibleLeadsCount.ToString().ToPersianNumbers()</strong>
                    </li>
                    <li>
                        <span class="text-muted">یادداشت شخصی</span>
                        <strong>@Model.PersonalNotesCount.ToString().ToPersianNumbers()</strong>
                    </li>
                    <li>
                        <span class="text-muted">همکار مرتبط</span>
                        <strong>@Model.CollaboratorCount.ToString().ToPersianNumbers()</strong>
                    </li>
                    <li>
                        <a href="@Url.Action("MyInvitations", "Invitations")" class="text-decoration-none d-flex justify-content-between align-items-center">
                            <span class="text-muted">دعوت پروژه در انتظار</span>
                            <strong class="text-primary">@Model.PendingProjectInviteCount.ToString().ToPersianNumbers()</strong>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="dash-panel h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="dash-panel__title mb-0"><i class="bi bi-calendar-week me-2 text-secondary"></i>جلسات پیشِ رو (لید)</h2>
                    <a href="@Url.Action("Index", "Leads")" class="btn btn-sm btn-outline-secondary rounded-pill">مشاهده لیدها</a>
                </div>
                @if (Model.UpcomingMeetings.Count == 0)
                {
                    <p class="text-muted mb-0 small">جلسه‌ای در ~۴۲ روز آینده ثبت نشده است.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless dash-meetings-table mb-0">
                            <thead>
                                <tr class="text-muted small">
                                    <th>زمان (محلی)</th>
                                    <th>لید</th>
                                    <th>نوع</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.UpcomingMeetings)
                                {
                                    var kindLabel = m.Kind == DashboardMeetingKind.ScheduledSession ? "جلسه ثبت‌شده" : "زمان روی لید";
                                    var meetingLocal = m.AtUtc.ToLocalTime();
                                    var daysUntilMeeting = (meetingLocal.Date - DateTime.Today).Days;
                                    var daysUntilLabel = $"{daysUntilMeeting.ToString().ToPersianNumbers()} روز باقی‌مانده";
                                    <tr>
                                        <td class="text-nowrap small">
                                            <div>@meetingLocal.ToShortPersianDateTimeString().ToPersianNumbers()</div>
                                            <div class="text-muted">@daysUntilLabel</div>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Details", "Leads", new { id = m.LeadId })" class="fw-medium text-decoration-none">@m.LeadTitle</a>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@kindLabel</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="dash-panel h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="dash-panel__title mb-0"><i class="bi bi-calendar-day me-2 text-secondary"></i>سررسید امروز</h2>
                    <span class="badge bg-light text-dark border">@Model.DueTasksToday.Count.ToString().ToPersianNumbers()</span>
                </div>
                @if (Model.DueTasksToday.Count == 0)
                {
                    <p class="text-muted small mb-0">برای امروز کاری با سررسید ثبت نشده است.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 dash-quick-list">
                        @foreach (var t in Model.DueTasksToday)
                        {
                            <li>
                                <a href="@Url.Action("Details", "Projects", new { id = t.ProjectId })" class="text-decoration-none d-flex justify-content-between align-items-start gap-2 dash-due-task-link">
                                    <span class="dash-due-task-title">@t.Title</span>
                                    <small class="text-muted dash-due-task-project">(@t.ProjectName)</small>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="dash-panel h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="dash-panel__title mb-0"><i class="bi bi-calendar2-day me-2 text-secondary"></i>سررسید فردا</h2>
                    <span class="badge bg-light text-dark border">@Model.DueTasksTomorrow.Count.ToString().ToPersianNumbers()</span>
                </div>
                @if (Model.DueTasksTomorrow.Count == 0)
                {
                    <p class="text-muted small mb-0">برای فردا کاری با سررسید ثبت نشده است.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 dash-quick-list">
                        @foreach (var t in Model.DueTasksTomorrow)
                        {
                            <li>
                                <a href="@Url.Action("Details", "Projects", new { id = t.ProjectId })" class="text-decoration-none d-flex justify-content-between align-items-start gap-2 dash-due-task-link">
                                    <span class="dash-due-task-title">@t.Title</span>
                                    <small class="text-muted dash-due-task-project">(@t.ProjectName)</small>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-3">
            <div class="dash-panel h-100">
                <h2 class="dash-panel__title">فروش و عدم فروش لیدها</h2>
                <p class="text-muted small mb-2">فروش: تبدیل‌شده · عدم فروش: جدید، در تماس، اعلام قیمت، از دست‌رفته</p>
                @if (Model.LeadSalesSlices.Count == 0)
                {
                    <p class="text-muted small mb-0 py-4 text-center">لیدی در مراحل فروش یا عدم فروش (جدید، در تماس، اعلام قیمت، از دست‌رفته، تبدیل‌شده) با مبلغ ثبت‌شده نیست.</p>
                }
                else
                {
                    <div class="dash-chart-wrap">
                        <canvas id="chartLeadSales" height="220" aria-label="نمودار فروش لید"></canvas>
                    </div>
                    <ul class="list-unstyled small text-muted mb-0 mt-2 dash-lead-sales-summary">
                        @foreach (var s in Model.LeadSalesSlices)
                        {
                            <li class="d-flex justify-content-between gap-2">
                                <span>@s.Label</span>
                                <span class="text-nowrap">@s.Amount.ToString("N0").ToPersianNumbers() تومان (@s.Count.ToString().ToPersianNumbers() لید)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
        <div class="col-lg-3">
            <div class="dash-panel h-100">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                    <h2 class="dash-panel__title mb-0">توزیع تسک در پروژه‌ها</h2>
                    <div class="btn-group btn-group-sm dash-segmented-control" role="group" aria-label="حالت نمایش نمودار تسک پروژه">
                        <button type="button" class="btn btn-outline-primary active" data-project-chart-mode="mine">کارهای خودم</button>
                        <button type="button" class="btn btn-outline-primary" data-project-chart-mode="all">کل پروژه</button>
                    </div>
                </div>
                @if (Model.ProjectTaskDistributionSlices.Count == 0 && Model.ProjectTaskDistributionAllSlices.Count == 0)
                {
                    <p class="text-muted small mb-0 py-4 text-center">تسک تخصیص‌یافته‌ای برای نمایش وجود ندارد.</p>
                }
                else
                {
                    <div class="dash-chart-wrap">
                        <canvas id="chartTasksByProject" height="220" aria-label="نمودار توزیع تسک در پروژه‌ها"></canvas>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-3">
            <div class="dash-panel h-100">
                <h2 class="dash-panel__title">قیف لیدها</h2>
                @if (Model.LeadPipelineSlices.Count == 0)
                {
                    <p class="text-muted small mb-0 py-4 text-center">هنوز لیدی به شما مرتبط نیست.</p>
                }
                else
                {
                    <div class="dash-chart-wrap">
                        <canvas id="chartLeads" height="220" aria-label="نمودار لید"></canvas>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-3">
            <div class="dash-panel h-100">
                <h2 class="dash-panel__title">سررسید ۷ روز آینده</h2>
                <div class="dash-chart-wrap">
                    <canvas id="chartDueWeek" height="220" aria-label="نمودار سررسید"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="dash-panel dash-panel--muted">
        <div class="row g-3 align-items-center">
            <div class="col-md-8">
                <h3 class="h6 fw-bold mb-1">میانبرها</h3>
                <p class="text-muted small mb-0">برای مدیریت روزمره از این لینک‌ها استفاده کنید.</p>
            </div>
            <div class="col-md-4 text-md-end">
                <div class="btn-group flex-wrap gap-1">
                    <a class="btn btn-sm btn-primary" href="@Url.Action("Index", "Projects")">پروژه‌ها</a>
                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", "Boards")">تخته‌ها</a>
                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", "PersonalNotes")">یادداشت‌ها</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
<script>
    (function () {
        var payload = @Html.Raw(chartsJson);
        var fa = (typeof document !== 'undefined' && document.documentElement && document.documentElement.lang === 'fa');

        function baseOptions() {
            return {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        rtl: fa,
                        labels: { font: { family: 'Vazir, Tahoma, sans-serif' } }
                    }
                }
            };
        }

        var ls = payload.leadSales || [];
        if (ls.length && document.getElementById('chartLeadSales')) {
            new Chart(document.getElementById('chartLeadSales'), {
                type: 'doughnut',
                data: {
                    labels: ls.map(function (x) { return x.label; }),
                    datasets: [{
                        data: ls.map(function (x) { return x.amount; }),
                        backgroundColor: ls.map(function (x) { return x.color; }),
                        borderWidth: 0
                    }]
                },
                options: Object.assign({}, baseOptions(), {
                    plugins: {
                        legend: {
                            position: 'bottom',
                            rtl: fa,
                            labels: { font: { family: 'Vazir, Tahoma, sans-serif' } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    var slice = ls[ctx.dataIndex];
                                    var amount = (slice && slice.amount != null) ? slice.amount : ctx.parsed;
                                    return ctx.label + ': ' + Number(amount).toLocaleString('fa-IR') + ' تومان';
                                }
                            }
                        }
                    }
                })
            });
        }

        var ppMine = payload.perProject || [];
        var ppAll = payload.perProjectAll || [];
        var projectChartCanvas = document.getElementById('chartTasksByProject');
        var projectChartButtons = Array.prototype.slice.call(document.querySelectorAll('[data-project-chart-mode]'));
        var projectChartByMode = {
            mine: ppMine,
            all: ppAll
        };

        function normalizeProjectChartMode(mode) {
            return mode === 'all' ? 'all' : 'mine';
        }

        function getProjectChartDataset(mode) {
            var normalizedMode = normalizeProjectChartMode(mode);
            return projectChartByMode[normalizedMode] || [];
        }

        function setProjectChartButtons(mode) {
            var normalizedMode = normalizeProjectChartMode(mode);
            projectChartButtons.forEach(function (btn) {
                var isActive = btn.getAttribute('data-project-chart-mode') === normalizedMode;
                btn.classList.toggle('active', isActive);
            });
        }

        if (projectChartCanvas && (ppMine.length || ppAll.length)) {
            var initialMode = ppMine.length ? 'mine' : 'all';
            var initialDataset = getProjectChartDataset(initialMode);
            var projectChart = new Chart(projectChartCanvas, {
                type: 'doughnut',
                data: {
                    labels: initialDataset.map(function (x) { return x.label; }),
                    datasets: [{
                        data: initialDataset.map(function (x) { return x.count; }),
                        backgroundColor: initialDataset.map(function (x) { return x.color; }),
                        borderWidth: 0
                    }]
                },
                options: baseOptions()
            });
            setProjectChartButtons(initialMode);

            projectChartButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetMode = normalizeProjectChartMode(btn.getAttribute('data-project-chart-mode'));
                    var nextDataset = getProjectChartDataset(targetMode);
                    projectChart.data.labels = nextDataset.map(function (x) { return x.label; });
                    projectChart.data.datasets[0].data = nextDataset.map(function (x) { return x.count; });
                    projectChart.data.datasets[0].backgroundColor = nextDataset.map(function (x) { return x.color; });
                    projectChart.update();
                    setProjectChartButtons(targetMode);
                });
            });
        }

        var l = payload.leads || [];
        if (l.length && document.getElementById('chartLeads')) {
            new Chart(document.getElementById('chartLeads'), {
                type: 'doughnut',
                data: {
                    labels: l.map(function (x) { return x.label; }),
                    datasets: [{
                        data: l.map(function (x) { return x.count; }),
                        backgroundColor: l.map(function (x) { return x.color; }),
                        borderWidth: 0
                    }]
                },
                options: baseOptions()
            });
        }

        var d = payload.dues || [];
        if (document.getElementById('chartDueWeek')) {
            new Chart(document.getElementById('chartDueWeek'), {
                type: 'bar',
                data: {
                    labels: d.map(function (x) { return x.label; }),
                    datasets: [{
                        label: 'تعداد کار با سررسید',
                        data: d.map(function (x) { return x.count; }),
                        backgroundColor: 'rgba(16, 185, 129, 0.55)',
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: Object.assign({}, baseOptions(), {
                    scales: {
                        x: {
                            ticks: { font: { family: 'Vazir, Tahoma, sans-serif' } }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1, font: { family: 'Vazir, Tahoma, sans-serif' } }
                        }
                    },
                    plugins: { legend: { display: false } }
                })
            });
        }
    })();
</script>
