@model IEnumerable<UserListVm>
@using Endpoint.Site.Models
@using System.Security.Claims
@{
    ViewData["Title"] = "مدیریت کاربران";
    Layout = "/Views/Shared/_Layout.cshtml";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 20;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-people-fill me-2"></i>
            مدیریت کاربران
        </h2>
        <div class="text-muted">
            <span>تعداد کل: <strong>@totalCount</strong></span>
        </div>
    </div>

    <!-- فرم جستجو -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index")" class="row g-3">
                <div class="col-md-8">
                    <input type="text" 
                           name="searchTerm" 
                           class="form-control" 
                           placeholder="جستجو بر اساس نام کاربری، ایمیل، نام کامل یا شماره تلفن..." 
                           value="@searchTerm" />
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-2"></i>
                            جستجو
                        </button>
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>
                                پاک کردن
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- پیام موفقیت -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- جدول کاربران -->
    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>نام کاربری</th>
                                <th>نام کامل</th>
                                <th>ایمیل</th>
                                <th>تلفن</th>
                                <th>نقش‌ها</th>
                                <th>وضعیت</th>
                                <th>تاریخ ثبت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@user.UserName</strong>
                                        @if (user.EmailConfirmed)
                                        {
                                            <i class="bi bi-check-circle-fill text-success ms-1" title="ایمیل تایید شده"></i>
                                        }
                                    </td>
                                    <td>@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td>@(string.IsNullOrWhiteSpace(user.Phone) ? "-" : user.Phone)</td>
                                    <td>
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge bg-info me-1">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">غیرفعال</span>
                                        }
                                    </td>
                                    <td>@user.InsertTime.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("ChangePassword", new { id = user.Id })" 
                                               class="btn btn-sm btn-outline-primary" 
                                               title="تغییر رمز عبور">
                                                <i class="bi bi-key"></i>
                                            </a>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-warning toggle-active-btn" 
                                                    data-user-id="@user.Id"
                                                    data-is-active="@user.IsActive.ToString().ToLower()"
                                                    title="@(user.IsActive ? "غیرفعال کردن" : "فعال کردن")">
                                                <i class="bi bi-@(user.IsActive ? "toggle-on" : "toggle-off")"></i>
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-danger delete-user-btn" 
                                                    data-user-id="@user.Id"
                                                    data-user-name="@user.UserName"
                                                    title="حذف کاربر">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- صفحه‌بندی -->
                @if (totalPages > 1)
                {
                    <nav aria-label="صفحه‌بندی">
                        <ul class="pagination justify-content-center">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = searchTerm, page = currentPage - 1, pageSize = pageSize })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = searchTerm, page = i, pageSize = pageSize })">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = searchTerm, page = currentPage + 1, pageSize = pageSize })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted"></i>
                    <h4 class="text-muted mt-3">کاربری یافت نشد</h4>
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <p class="text-muted">نتیجه‌ای برای جستجوی "@searchTerm" یافت نشد</p>
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            مشاهده همه کاربران
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const antiforgeryToken = document.body.dataset.antiforgeryToken;

            // حذف کاربر
            document.querySelectorAll('.delete-user-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const userId = this.dataset.userId;
                    const userName = this.dataset.userName;

                    if (!confirm(`آیا از حذف کاربر "${userName}" اطمینان دارید؟\n\nاین عمل قابل بازگشت نیست!`)) {
                        return;
                    }

                    fetch('@Url.Action("Delete")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': antiforgeryToken
                        },
                        body: `id=${encodeURIComponent(userId)}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            location.reload();
                        } else {
                            alert('خطا: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('خطا در حذف کاربر');
                    });
                });
            });

            // فعال/غیرفعال کردن کاربر
            document.querySelectorAll('.toggle-active-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const userId = this.dataset.userId;
                    const isActive = this.dataset.isActive === 'true';

                    fetch('@Url.Action("ToggleActive")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': antiforgeryToken
                        },
                        body: `id=${encodeURIComponent(userId)}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            location.reload();
                        } else {
                            alert('خطا: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('خطا در تغییر وضعیت کاربر');
                    });
                });
            });
        });
    </script>
}

<style>
    .table th {
        font-weight: 600;
        background-color: #f8f9fa;
    }

    .btn-group .btn {
        border-radius: 0;
    }

    .btn-group .btn:first-child {
        border-top-right-radius: 0.375rem;
        border-bottom-right-radius: 0.375rem;
    }

    .btn-group .btn:last-child {
        border-top-left-radius: 0.375rem;
        border-bottom-left-radius: 0.375rem;
    }
</style>

