@model IEnumerable<UserListVm>
@using Endpoint.Site.Models
@using System.Globalization
@using System.Security.Claims
@{
    ViewData["Title"] = "مدیریت کاربران";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 20;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();
}

<div class="container-fluid px-0 admin-users-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-people-fill me-2"></i>
            مدیریت کاربران
        </h2>
        <div class="text-muted">
            <span>تعداد کل: <strong>@totalCount</strong></span>
        </div>
    </div>

    <!-- فرم جستجو -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index")" class="row g-3">
                <div class="col-md-8">
                    <input type="text" 
                           name="searchTerm" 
                           class="form-control" 
                           placeholder="جستجو بر اساس نام کاربری، ایمیل، نام کامل یا شماره تلفن..." 
                           value="@searchTerm" />
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-2"></i>
                            جستجو
                        </button>
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>
                                پاک کردن
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- تعریف نقش جدید -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-2 align-items-center">
                <div class="col-md-8">
                    <input type="text"
                           id="newRoleName"
                           class="form-control"
                           placeholder="تعریف نقش جدید (مثال: PROJECT_MANAGER)" />
                </div>
                <div class="col-md-4">
                    <button type="button" id="createRoleBtn" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-plus-circle me-1"></i>
                        ایجاد نقش جدید
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- پیام موفقیت -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- جدول کاربران -->
    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>نام کاربری</th>
                                <th>نام کامل</th>
                                <th>ایمیل</th>
                                <th>تلفن</th>
                                <th>نقش‌ها</th>
                                <th>پروژه‌ها</th>
                                <th>وضعیت</th>
                                <th>تاریخ ثبت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@user.UserName</strong>
                                        @if (user.EmailConfirmed)
                                        {
                                            <i class="bi bi-check-circle-fill text-success ms-1" title="ایمیل تایید شده"></i>
                                        }
                                    </td>
                                    <td>@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td>@(string.IsNullOrWhiteSpace(user.Phone) ? "-" : user.Phone)</td>
                                    <td>
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge role-badge">
                                                    @role
                                                    <button type="button"
                                                            class="btn btn-sm p-0 ms-1 text-dark border-0 bg-transparent remove-role-btn"
                                                            data-user-id="@user.Id"
                                                            data-role-name="@role"
                                                            title="حذف نقش @role">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        <div class="input-group input-group-sm role-actions">
                                            <select class="form-select add-role-select" data-user-id="@user.Id">
                                                <option value="">انتخاب نقش</option>
                                                @foreach (var roleName in allRoles)
                                                {
                                                    <option value="@roleName">@roleName</option>
                                                }
                                            </select>
                                            <button type="button"
                                                    class="btn btn-outline-secondary add-role-btn"
                                                    data-user-id="@user.Id"
                                                    title="افزودن نقش">
                                                <i class="bi bi-plus-lg me-1"></i>
                                                افزودن نقش
                                            </button>
                                        </div>
                                    </td>
                                    <td class="projects-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @(user.ProjectCount > 0 ? "bg-primary" : "bg-secondary") project-count-badge">
                                                @user.ProjectCount
                                            </span>
                                            @if (user.ProjectCount > 0)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary view-projects-btn"
                                                        data-user-id="@user.Id"
                                                        data-user-name="@(string.IsNullOrWhiteSpace(user.FullName) ? user.UserName : user.FullName)"
                                                        title="مشاهده پروژه‌ها">
                                                    <i class="bi bi-folder2-open"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">غیرفعال</span>
                                        }
                                    </td>
                                    <td>@FormatTehranPersianDateTime(user.InsertTime)</td>
                                    <td class="operations-cell">
                                        <div class="user-actions" role="group">
                                            <a href="@Url.Action("ChangePassword", new { id = user.Id })" 
                                               class="btn btn-sm btn-outline-secondary" 
                                               title="تغییر رمز عبور">
                                                <i class="bi bi-key"></i>
                                            </a>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-secondary toggle-active-btn" 
                                                    data-user-id="@user.Id"
                                                    data-is-active="@user.IsActive.ToString().ToLower()"
                                                    title="@(user.IsActive ? "غیرفعال کردن" : "فعال کردن")">
                                                <i class="bi bi-@(user.IsActive ? "toggle-on" : "toggle-off")"></i>
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-secondary delete-user-btn" 
                                                    data-user-id="@user.Id"
                                                    data-user-name="@user.UserName"
                                                    title="حذف کاربر">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- صفحه‌بندی -->
                @if (totalPages > 1)
                {
                    <nav aria-label="صفحه‌بندی">
                        <ul class="pagination justify-content-center">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = searchTerm, page = currentPage - 1, pageSize = pageSize })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = searchTerm, page = i, pageSize = pageSize })">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = searchTerm, page = currentPage + 1, pageSize = pageSize })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted"></i>
                    <h4 class="text-muted mt-3">کاربری یافت نشد</h4>
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <p class="text-muted">نتیجه‌ای برای جستجوی "@searchTerm" یافت نشد</p>
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            مشاهده همه کاربران
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- مودال لیست پروژه‌های کاربر -->
<div class="modal fade" id="userProjectsModal" tabindex="-1" aria-labelledby="userProjectsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userProjectsModalLabel">
                    <i class="bi bi-folder2-open me-2"></i>
                    پروژه‌های <span id="userProjectsModalUserName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="userProjectsModalBody">
                <div class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <div class="mt-2">در حال بارگذاری پروژه‌ها...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const antiforgeryToken = document.body.dataset.antiforgeryToken;

            async function parseJsonResponse(response) {
                const contentType = response.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    return response.json();
                }

                const bodyText = await response.text();
                throw new Error(bodyText || 'پاسخ نامعتبر از سرور دریافت شد');
            }

            // حذف کاربر
            document.querySelectorAll('.delete-user-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const userId = this.dataset.userId;
                    const userName = this.dataset.userName;

                    if (!confirm(`آیا از حذف کاربر "${userName}" اطمینان دارید؟\n\nاین عمل قابل بازگشت نیست!`)) {
                        return;
                    }

                    fetch('@Url.Action("Delete")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': antiforgeryToken
                        },
                        body: `id=${encodeURIComponent(userId)}`
                    })
                    .then(parseJsonResponse)
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            location.reload();
                        } else {
                            alert('خطا: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('خطا در حذف کاربر: ' + (error.message || 'خطای ناشناخته'));
                    });
                });
            });

            // فعال/غیرفعال کردن کاربر
            document.querySelectorAll('.toggle-active-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const userId = this.dataset.userId;
                    const isActive = this.dataset.isActive === 'true';

                    fetch('@Url.Action("ToggleActive")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': antiforgeryToken
                        },
                        body: `id=${encodeURIComponent(userId)}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            location.reload();
                        } else {
                            alert('خطا: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('خطا در تغییر وضعیت کاربر');
                    });
                });
            });

            // افزودن نقش
            document.querySelectorAll('.add-role-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const userId = this.dataset.userId;
                    const select = document.querySelector(`.add-role-select[data-user-id="${userId}"]`);
                    const roleName = select?.value || '';

                    if (!roleName) {
                        alert('لطفا یک نقش انتخاب کنید');
                        return;
                    }

                    fetch('@Url.Action("AddRole")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': antiforgeryToken
                        },
                        body: `id=${encodeURIComponent(userId)}&roleName=${encodeURIComponent(roleName)}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            location.reload();
                        } else {
                            alert('خطا: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('خطا در افزودن نقش');
                    });
                });
            });

            // حذف نقش
            document.querySelectorAll('.remove-role-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const userId = this.dataset.userId;
                    const roleName = this.dataset.roleName;

                    if (!confirm(`آیا از حذف نقش "${roleName}" اطمینان دارید؟`)) {
                        return;
                    }

                    fetch('@Url.Action("RemoveRole")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': antiforgeryToken
                        },
                        body: `id=${encodeURIComponent(userId)}&roleName=${encodeURIComponent(roleName)}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            location.reload();
                        } else {
                            alert('خطا: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('خطا در حذف نقش');
                    });
                });
            });

            // تعریف نقش جدید
            const createRoleBtn = document.getElementById('createRoleBtn');
            const newRoleNameInput = document.getElementById('newRoleName');
            if (createRoleBtn && newRoleNameInput) {
                createRoleBtn.addEventListener('click', function () {
                    const roleName = (newRoleNameInput.value || '').trim();
                    if (!roleName) {
                        alert('لطفا نام نقش را وارد کنید');
                        return;
                    }

                    fetch('@Url.Action("CreateRole")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': antiforgeryToken
                        },
                        body: `roleName=${encodeURIComponent(roleName)}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            location.reload();
                        } else {
                            alert('خطا: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('خطا در ایجاد نقش جدید');
                    });
                });
            }

            const userProjectsModalEl = document.getElementById('userProjectsModal');
            const userProjectsModalBody = document.getElementById('userProjectsModalBody');
            const userProjectsModalUserName = document.getElementById('userProjectsModalUserName');
            const userProjectsModal = userProjectsModalEl ? new bootstrap.Modal(userProjectsModalEl) : null;

            function toPersianDigits(value) {
                return String(value)
                    .replace(/0/g, '۰')
                    .replace(/1/g, '۱')
                    .replace(/2/g, '۲')
                    .replace(/3/g, '۳')
                    .replace(/4/g, '۴')
                    .replace(/5/g, '۵')
                    .replace(/6/g, '۶')
                    .replace(/7/g, '۷')
                    .replace(/8/g, '۸')
                    .replace(/9/g, '۹');
            }

            function formatProjectDate(dateValue) {
                if (!dateValue) {
                    return '-';
                }

                const date = new Date(dateValue);
                if (Number.isNaN(date.getTime())) {
                    return '-';
                }

                return toPersianDigits(date.toLocaleDateString('fa-IR'));
            }

            function renderUserProjects(projects) {
                if (!projects || projects.length === 0) {
                    userProjectsModalBody.innerHTML = `
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-folder-x display-6 d-block mb-2"></i>
                            پروژه‌ای برای این کاربر ثبت نشده است.
                        </div>`;
                    return;
                }

                const rows = projects.map(project => `
                    <tr>
                        <td>${project.name}</td>
                        <td>${formatProjectDate(project.createdAt)}</td>
                        <td class="text-center">
                            <a href="/Projects/Details/${project.id}"
                               class="btn btn-sm btn-outline-primary"
                               title="مشاهده پروژه">
                                <i class="bi bi-box-arrow-up-left"></i>
                            </a>
                        </td>
                    </tr>`).join('');

                userProjectsModalBody.innerHTML = `
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>نام پروژه</th>
                                    <th>تاریخ ایجاد</th>
                                    <th class="text-center">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>`;
            }

            async function openUserProjectsModal(userId, userName) {
                if (!userProjectsModal || !userProjectsModalBody || !userProjectsModalUserName) {
                    return;
                }

                userProjectsModalUserName.textContent = userName || '';
                userProjectsModalBody.innerHTML = `
                    <div class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">در حال بارگذاری...</span>
                        </div>
                        <div class="mt-2">در حال بارگذاری پروژه‌ها...</div>
                    </div>`;

                userProjectsModal.show();

                try {
                    const response = await fetch(`@Url.Action("GetUserProjects")?id=${encodeURIComponent(userId)}`);
                    const data = await parseJsonResponse(response);

                    if (!data.success) {
                        userProjectsModalBody.innerHTML = `
                            <div class="alert alert-danger mb-0">
                                ${data.message || 'خطا در دریافت لیست پروژه‌ها'}
                            </div>`;
                        return;
                    }

                    if (data.userName) {
                        userProjectsModalUserName.textContent = data.userName;
                    }

                    renderUserProjects(data.projects);
                } catch (error) {
                    console.error('Error:', error);
                    userProjectsModalBody.innerHTML = `
                        <div class="alert alert-danger mb-0">
                            خطا در دریافت لیست پروژه‌ها
                        </div>`;
                }
            }

            document.querySelectorAll('.view-projects-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    openUserProjectsModal(this.dataset.userId, this.dataset.userName);
                });
            });

            document.querySelectorAll('.project-count-badge').forEach(badge => {
                const row = badge.closest('tr');
                const viewBtn = row?.querySelector('.view-projects-btn');
                if (!viewBtn) {
                    return;
                }

                badge.style.cursor = 'pointer';
                badge.title = 'مشاهده پروژه‌ها';
                badge.addEventListener('click', function () {
                    openUserProjectsModal(viewBtn.dataset.userId, viewBtn.dataset.userName);
                });
            });
        });
    </script>
}

@functions {
    private static TimeZoneInfo TehranTimeZone()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Iran Standard Time"); } catch { }
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran"); } catch { }
        return TimeZoneInfo.Local;
    }

    private static DateTime ToTehranTime(DateTime dateTime)
    {
        var utc = dateTime.Kind == DateTimeKind.Utc ? dateTime : dateTime.ToUniversalTime();
        return TimeZoneInfo.ConvertTimeFromUtc(utc, TehranTimeZone());
    }

    public string FormatTehranPersianDateTime(DateTime dateTime)
    {
        var tehran = ToTehranTime(dateTime);
        var pc = new PersianCalendar();
        var value = $"{pc.GetYear(tehran):0000}/{pc.GetMonth(tehran):00}/{pc.GetDayOfMonth(tehran):00} " +
                    $"{tehran.Hour:00}:{tehran.Minute:00}";

        return ToPersianDigits(value);
    }

    private static string ToPersianDigits(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            return input;
        }

        return input
            .Replace('0', '۰')
            .Replace('1', '۱')
            .Replace('2', '۲')
            .Replace('3', '۳')
            .Replace('4', '۴')
            .Replace('5', '۵')
            .Replace('6', '۶')
            .Replace('7', '۷')
            .Replace('8', '۸')
            .Replace('9', '۹');
    }
}

<style>
    .app-main-body {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .admin-users-page {
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    .admin-users-page > .card,
    .admin-users-page > .alert,
    .admin-users-page > .d-flex {
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    .table th {
        font-weight: 600;
        background-color: #f8f9fa;
    }

    .table-responsive {
        overflow-x: auto;
        overflow-y: visible;
    }

    .table {
        width: max-content;
        min-width: 100%;
    }

    .table th,
    .table td {
        white-space: normal;
        padding: 0.45rem 0.5rem;
        vertical-align: middle;
    }

    .table td:nth-child(1),
    .table td:nth-child(3),
    .table td:nth-child(4),
    .table td:nth-child(8),
    .table td:nth-child(9) {
        white-space: nowrap;
    }

    .projects-cell {
        min-width: 90px;
    }

    .project-count-badge {
        min-width: 2rem;
    }

