@model ProjectNote
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h2>جزئیات یادداشت</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <hr />
        <p><strong>پروژه:</strong> @Model.Project?.Name</p>
        <p><strong>تاریخ ایجاد:</strong> @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</p>
        @if (Model.UpdatedAt.HasValue)
        {
            <p><strong>آخرین ویرایش:</strong> @Model.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</p>
        }
        <hr />
        <div class="mb-3">
            <strong>محتوا:</strong>
            <div class="mt-2" style="white-space: pre-wrap;">@Model.Content</div>
        </div>

        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            <hr />
            <div class="mb-3">
                <strong>📎 فایل‌های پیوست:</strong>
                <div class="row mt-3">
                    @foreach (var att in Model.Attachments)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    @if (att.FileType == "Image")
                                    {
                                        <div class="mb-2">
                                            <img src="@att.FilePath" alt="@att.FileName" class="img-fluid rounded" style="max-height: 200px;" />
                                        </div>
                                        <span class="badge bg-primary">🖼️ تصویر</span>
                                    }
                                    else if (att.FileType == "Audio")
                                    {
                                        <div class="mb-2">
                                            <audio controls class="w-100">
                                                <source src="@att.FilePath" type="@att.MimeType">
                                                مرورگر شما از پخش صوت پشتیبانی نمی‌کند.
                                            </audio>
                                        </div>
                                        <span class="badge bg-info">🎵 صوت</span>
                                    }
                                    else if (att.FileType == "Document")
                                    {
                                        <span class="badge bg-success">📄 سند</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">📎 فایل</span>
                                    }
                                    <a href="@att.FilePath" download="@att.FileName" class="d-block mt-2">@att.FileName</a>
                                    <small class="text-muted">(@(att.FileSize / 1024) KB)</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">ویرایش</a>
    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id">حذف</a>
    <a class="btn btn-secondary" href="/ProjectNotes/Index?projectId=@Model.ProjectId">بازگشت به لیست یادداشت‌ها</a>
    <a class="btn btn-outline-secondary" href="/Projects/Details/@Model.ProjectId">بازگشت به پروژه</a>
</div>


