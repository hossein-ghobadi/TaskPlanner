@using Endpoint.Site.Models
@using TaskPlanner.Domain.Entities.TaskPlanner
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model ProjectNoteEditVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var existingAttachments = ViewBag.ExistingAttachments as ICollection<ProjectNoteAttachment>;
}

<div class="create-note-container">
    <!-- Header -->
    <div class="create-header">
        <a href="/ProjectNotes/Index?projectId=@Model.ProjectId" class="back-btn">
            <i class="bi bi-arrow-right"></i>
        </a>
        <h1 class="create-title">ویرایش یادداشت</h1>
        <span class="create-subtitle">برای پروژه: @ViewBag.ProjectName</span>
    </div>

@if (TempData["Success"] != null)
{
        <div class="alert alert-success alert-social" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
}
@if (TempData["Error"] != null)
{
        <div class="alert alert-danger alert-social" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]
        </div>
    }

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="create-form">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ProjectId" />
        <div id="deletedAttachmentsContainer"></div>

        <!-- Main Content Card -->
        <div class="create-card">
            <!-- Title Section -->
            <div class="form-group">
                <input asp-for="Title" class="form-input-title" placeholder="عنوان یادداشت را وارد کنید..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <!-- Content Section -->
            <div class="form-group">
                <textarea asp-for="Content" class="form-textarea" rows="6" placeholder="متن یادداشت خود را بنویسید..."></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <!-- Existing Attachments Section -->
            @if (existingAttachments != null && existingAttachments.Any())
            {
                <div class="existing-attachments-section">
                    <div class="files-preview-header">
                        <strong>فایل‌های پیوست موجود (@existingAttachments.Count فایل)</strong>
                    </div>
                    <div class="files-list" id="existingAttachments">
                        @foreach (var att in existingAttachments)
                        {
                            <div class="file-preview-item" id="attachment-@att.Id">
                                @if (att.FileType == "Image")
                                {
                                    <div class="file-preview-image">
                                        <img src="@att.FilePath" alt="@att.FileName" />
                                        <button type="button" class="file-remove-btn" onclick="deleteAttachment(@att.Id)">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </button>
                                    </div>
                                    <div class="file-preview-info">
                                        <span class="file-name">@att.FileName</span>
                                        <span class="file-size">@(Math.Round(att.FileSize / 1024.0, 2)) KB</span>
                                        <a href="@att.FilePath" target="_blank" class="file-download-link">
                                            <i class="bi bi-download"></i> دانلود
                                        </a>
                                    </div>
                                }
                                else if (att.FileType == "Audio")
                                {
                                    <div class="file-preview-audio">
                                        <audio controls>
                                            <source src="@att.FilePath" type="@att.MimeType">
                                        </audio>
                                        <button type="button" class="file-remove-btn" onclick="deleteAttachment(@att.Id)">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </button>
                                    </div>
                                    <div class="file-preview-info">
                                        <span class="file-name">@att.FileName</span>
                                        <span class="file-size">@(Math.Round(att.FileSize / 1024.0, 2)) KB</span>
                                        <a href="@att.FilePath" target="_blank" class="file-download-link">
                                            <i class="bi bi-download"></i> دانلود
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    var iconClass = att.FileType == "Document" ? "bi-file-earmark-text" : "bi-file-earmark";
                                    <div class="file-preview-icon">
                                        <i class="bi @iconClass"></i>
                                        <button type="button" class="file-remove-btn" onclick="deleteAttachment(@att.Id)">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </button>
                                    </div>
                                    <div class="file-preview-info">
                                        <span class="file-name">@att.FileName</span>
                                        <span class="file-size">@(Math.Round(att.FileSize / 1024.0, 2)) KB</span>
                                        <a href="@att.FilePath" target="_blank" class="file-download-link">
                                            <i class="bi bi-download"></i> دانلود
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Attachments Section -->
            <div class="attachments-section">
                <label class="attachment-label">
                    <input type="file" name="NewAttachments" class="file-input-hidden" id="fileInput" multiple 
                           accept="image/*,audio/*,.pdf,.doc,.docx,.txt,.zip,.rar" 
                           onchange="handleFileSelect(event)" />
                    <div class="file-input-trigger">
                        <i class="bi bi-paperclip"></i>
                        <span>افزودن فایل</span>
                    </div>
                </label>
                
                <!-- File Preview -->
                <div id="filesPreview" class="files-preview"></div>
            </div>

            <!-- Voice Recording Section -->
            <div class="voice-section">
                <button type="button" class="voice-btn" id="recordBtn" onclick="toggleRecording()">
                    <span class="voice-icon" id="recordIcon">
                        <i class="bi bi-mic"></i>
                    </span>
                    <span class="voice-text" id="recordText">ضبط صدا</span>
                    <span class="voice-timer" id="recordTimer">00:00</span>
                </button>
                <div id="audioPreview" class="audio-preview"></div>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <a class="btn-cancel" href="/ProjectNotes/Index?projectId=@Model.ProjectId">
                <i class="bi bi-x-circle"></i>
                <span>انصراف</span>
            </a>
            <button type="submit" class="btn-submit">
                <i class="bi bi-check-lg"></i>
                <span>ذخیره تغییرات</span>
            </button>
        </div>
    </form>
</div>

<style>
    .create-note-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    /* Header */
    .create-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid #e9ecef;
    }

    .back-btn {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        border-radius: 50%;
        color: #3b82f6;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .back-btn:hover {
        background: #e9ecef;
        transform: scale(1.1);
    }

    .create-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
        flex: 1;
    }

    .create-subtitle {
        font-size: 0.95rem;
        color: #6c757d;
        font-weight: normal;
    }

    /* Alert */
    .alert-social {
        border-radius: 12px;
        border: none;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 500;
    }

    /* Form */
    .create-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* Create Card */
    .create-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-input-title {
        width: 100%;
        border: none;
        border-bottom: 2px solid #e9ecef;
        padding: 0.75rem 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: #1a1a1a;
        background: transparent;
        transition: border-color 0.2s ease;
    }

    .form-input-title:focus {
        outline: none;
        border-bottom-color: #3b82f6;
    }

    .form-input-title::placeholder {
        color: #adb5bd;
    }

    .form-textarea {
        width: 100%;
        border: none;
        padding: 0;
        font-size: 1.05rem;
        line-height: 1.6;
        color: #4a5568;
        background: transparent;
        resize: vertical;
        min-height: 150px;
        font-family: inherit;
    }

    .form-textarea:focus {
        outline: none;
    }

    .form-textarea::placeholder {
        color: #adb5bd;
    }

    /* Existing Attachments */
    .existing-attachments-section {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e9ecef;
    }

    /* Attachments */
    .attachments-section {
        margin-top: 1.5rem;
    }

    .attachment-label {
        cursor: pointer;
    }

    .file-input-hidden {
        display: none;
    }

    .file-input-trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        background: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 10px;
        color: #6c757d;
        transition: all 0.2s ease;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .file-input-trigger:hover {
        background: #e9ecef;
        border-color: #3b82f6;
        color: #3b82f6;
    }

    .files-preview {
        margin-top: 1rem;
    }

    .files-preview-header {
        font-size: 0.9rem;
        color: #6c757d;
        margin-bottom: 0.75rem;
        font-weight: 500;
    }

    .files-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.75rem;
    }

    .file-preview-item {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 0.75rem;
        position: relative;
        transition: all 0.2s ease;
    }

    .file-preview-item:hover {
        background: #e9ecef;
        transform: translateY(-2px);
    }

    .file-preview-image {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        border-radius: 8px;
        overflow: hidden;
        background: white;
        margin-bottom: 0.5rem;
    }

    .file-preview-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .file-preview-audio {
        position: relative;
        background: white;
        border-radius: 8px;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .file-preview-audio audio {
        width: 100%;
        height: 32px;
    }

    .file-preview-icon {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 8px;
        margin-bottom: 0.5rem;
        font-size: 3rem;
        color: #6c757d;
    }

    .file-remove-btn {
        position: absolute;
        top: -8px;
        left: -8px;
        width: 28px;
        height: 28px;
        background: white;
        border: 2px solid #dee2e6;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ef4444;
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0;
        font-size: 1rem;
    }

    .file-remove-btn:hover {
        background: #fee;
        border-color: #ef4444;
        transform: scale(1.1);
    }

    .file-preview-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .file-name {
        font-size: 0.85rem;
        font-weight: 500;
        color: #1a1a1a;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .file-size {
        font-size: 0.75rem;
        color: #6c757d;
    }

    .file-download-link {
        font-size: 0.75rem;
        color: #3b82f6;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: 0.25rem;
        transition: color 0.2s ease;
    }

    .file-download-link:hover {
        color: #2563eb;
        text-decoration: underline;
    }

    /* Voice Recording */
    .voice-section {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e9ecef;
    }

    .voice-btn {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1.5rem;
        background: #f8f9fa;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        color: #6c757d;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        width: 100%;
        justify-content: center;
    }

    .voice-btn:hover {
        background: #e9ecef;
        border-color: #3b82f6;
        color: #3b82f6;
    }

    .voice-btn.recording {
        background: #fee;
        border-color: #ef4444;
        color: #ef4444;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    .voice-icon {
        font-size: 1.25rem;
    }

    .voice-timer {
        margin-right: auto;
        font-weight: 600;
    }

    .audio-preview {
        margin-top: 1rem;
    }

    /* Actions */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
    }

    .btn-cancel {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: #f8f9fa;
        border: none;
        border-radius: 10px;
        color: #6c757d;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .btn-cancel:hover {
        background: #e9ecef;
        color: #1a1a1a;
    }

    .btn-submit {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 2rem;
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border: none;
        border-radius: 10px;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .create-note-container {
            padding: 1rem 0.5rem;
        }

        .create-card {
            padding: 1.5rem;
        }

        .create-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .create-subtitle {
            margin-top: -0.5rem;
            margin-right: 3rem;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-cancel,
        .btn-submit {
            width: 100%;
            justify-content: center;
        }

        .files-list {
            grid-template-columns: 1fr;
        }

        .file-preview-icon {
            font-size: 2rem;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const deletedIds = [];
        const token = '@token';
        let mediaRecorder;
        let audioChunks = [];
        let recordingStartTime;
        let timerInterval;
        let selectedFiles = []; // ذخیره فایل‌های انتخاب شده

        // مدیریت انتخاب فایل‌ها
        function handleFileSelect(event) {
            const fileInput = event.target;
            const files = Array.from(fileInput.files);
            
            // اضافه کردن فایل‌های جدید به لیست
            files.forEach(file => {
                // بررسی تکراری نبودن
                const exists = selectedFiles.some(f => f.name === file.name && f.size === file.size);
                if (!exists) {
                    selectedFiles.push(file);
                }
            });
            
            updateFilesPreview();
            updateFileInput();
        }

        // به‌روزرسانی پیش‌نمایش فایل‌ها
        function updateFilesPreview() {
            const previewContainer = document.getElementById('filesPreview');
            
            if (selectedFiles.length === 0) {
                previewContainer.innerHTML = '';
                return;
            }
            
            previewContainer.innerHTML = `
                <div class="files-preview-header">
                    <strong>${selectedFiles.length} فایل انتخاب شده</strong>
                </div>
                <div class="files-list" id="filesList"></div>
            `;
            
            const filesList = document.getElementById('filesList');
            
            selectedFiles.forEach((file, index) => {
                const fileCard = createFilePreviewCard(file, index);
                filesList.appendChild(fileCard);
            });
        }

        // ساخت کارت پیش‌نمایش فایل
        function createFilePreviewCard(file, index) {
            const fileItem = document.createElement('div');
            fileItem.className = 'file-preview-item';
            
            // پیش‌نمایش بر اساس نوع فایل
            let previewHtml = '';
            
            if (file.type.startsWith('image/')) {
                const imageUrl = URL.createObjectURL(file);
                previewHtml = `
                    <div class="file-preview-image">
                        <img src="${imageUrl}" alt="${file.name}" />
                        <button type="button" class="file-remove-btn" onclick="removeFile(${index})">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>
                    <div class="file-preview-info">
                        <span class="file-name">${file.name}</span>
                        <span class="file-size">${formatFileSize(file.size)}</span>
                    </div>
                `;
            } else if (file.type.startsWith('audio/')) {
                const audioUrl = URL.createObjectURL(file);
                previewHtml = `
                    <div class="file-preview-audio">
                        <audio controls>
                            <source src="${audioUrl}" type="${file.type}">
                        </audio>
                        <button type="button" class="file-remove-btn" onclick="removeFile(${index})">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>
                    <div class="file-preview-info">
                        <span class="file-name">${file.name}</span>
                        <span class="file-size">${formatFileSize(file.size)}</span>
                    </div>
                `;
            } else {
                const iconClass = file.type.includes('pdf') ? 'bi-file-pdf' : 
                                 (file.type.includes('word') || file.type.includes('document')) ? 'bi-file-earmark-text' : 
                                 'bi-file-earmark';
                previewHtml = `
                    <div class="file-preview-icon">
                        <i class="bi ${iconClass}"></i>
                        <button type="button" class="file-remove-btn" onclick="removeFile(${index})">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>
                    <div class="file-preview-info">
                        <span class="file-name">${file.name}</span>
                        <span class="file-size">${formatFileSize(file.size)}</span>
                    </div>
                `;
            }
            
            fileItem.innerHTML = previewHtml;
            return fileItem;
        }

        // فرمت کردن حجم فایل
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        // حذف فایل از لیست
        function removeFile(index) {
            selectedFiles.splice(index, 1);
            updateFilesPreview();
            updateFileInput();
        }

        // به‌روزرسانی input فایل
        function updateFileInput() {
            const fileInput = document.getElementById('fileInput');
            const dataTransfer = new DataTransfer();
            
            selectedFiles.forEach(file => {
                dataTransfer.items.add(file);
            });
            
            fileInput.files = dataTransfer.files;
        }

        // حذف فایل پیوست موجود
        function deleteAttachment(id) {
            if (!confirm('آیا از حذف این فایل مطمئن هستید؟')) return;

            const card = document.getElementById('attachment-' + id);
            if (card) {
                card.remove();
                deletedIds.push(id);
                
                // افزودن hidden input برای این آیدی
                const container = document.getElementById('deletedAttachmentsContainer');
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'DeletedAttachmentIds';
                input.value = id;
                container.appendChild(input);
            }
        }

        async function toggleRecording() {
            if (!mediaRecorder || mediaRecorder.state === 'inactive') {
                await startRecording();
            } else {
                stopRecording();
            }
        }

        async function startRecording() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = (event) => {
                    if (event.data && event.data.size > 0) {
                        audioChunks.push(event.data);
                        console.log('Audio chunk captured:', event.data.size, 'bytes');
                    }
                };

                mediaRecorder.onstop = () => {
                    console.log('Recording stopped. Total chunks:', audioChunks.length);
                    
                    if (audioChunks.length === 0) {
                        alert('هیچ داده صوتی ضبط نشد. لطفاً دوباره تلاش کنید.');
                        stream.getTracks().forEach(track => track.stop());
                        return;
                    }
                    
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    console.log('Audio blob size:', audioBlob.size, 'bytes');
                    
                    if (audioBlob.size === 0) {
                        alert('فایل صوتی خالی است. لطفاً دوباره تلاش کنید.');
                        stream.getTracks().forEach(track => track.stop());
                        return;
                    }
                    
                    const audioUrl = URL.createObjectURL(audioBlob);
                    
                    const preview = document.getElementById('audioPreview');
                    const audioElement = document.createElement('audio');
                    audioElement.controls = true;
                    audioElement.src = audioUrl;
                    audioElement.className = 'w-100 mt-2';
                    preview.innerHTML = '';
                    preview.appendChild(audioElement);

                    const fileName = `voice_${new Date().getTime()}.webm`;
                    const file = new File([audioBlob], fileName, { type: 'audio/webm' });
                    addFileToInput(file);

                    stream.getTracks().forEach(track => track.stop());
                };

                // شروع ضبط با timeslice برای جمع‌آوری بهتر داده‌ها
                mediaRecorder.start(100);
                recordingStartTime = Date.now();
                console.log('Voice recording started...');
                
                document.getElementById('recordBtn').classList.add('recording');
                document.getElementById('recordIcon').innerHTML = '<i class="bi bi-stop-fill"></i>';
                document.getElementById('recordText').textContent = 'در حال ضبط...';

                timerInterval = setInterval(updateTimer, 1000);
            } catch (error) {
                alert('خطا در دسترسی به میکروفن: ' + error.message);
            }
        }

        function stopRecording() {
            if (mediaRecorder && mediaRecorder.state === 'recording') {
                mediaRecorder.stop();
                clearInterval(timerInterval);

                document.getElementById('recordBtn').classList.remove('recording');
                document.getElementById('recordIcon').innerHTML = '<i class="bi bi-mic"></i>';
                document.getElementById('recordText').textContent = 'ضبط صدا';
                document.getElementById('recordTimer').textContent = '00:00';
            }
        }

        function updateTimer() {
            const elapsed = Math.floor((Date.now() - recordingStartTime) / 1000);
            const minutes = Math.floor(elapsed / 60).toString().padStart(2, '0');
            const seconds = (elapsed % 60).toString().padStart(2, '0');
            document.getElementById('recordTimer').textContent = `${minutes}:${seconds}`;
        }

        function addFileToInput(file) {
            console.log('📎 addFileToInput called with:', file.name, file.size, 'bytes');
            
            // اضافه کردن به لیست فایل‌های انتخاب شده
            const exists = selectedFiles.some(f => f.name === file.name && f.size === file.size);
            if (!exists) {
                selectedFiles.push(file);
                updateFilesPreview();
                updateFileInput();
            }
            
            console.log('📎 Total files:', selectedFiles.length);
        }
    </script>
}
