@model IEnumerable<ProjectNote>
@using System.Globalization
@using TaskPlanner.Domain.Entities.TaskPlanner
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["UseFluidLayout"] = true;
}

@{
    var folders = ViewBag.Folders as List<ProjectNoteFolder> ?? new List<ProjectNoteFolder>();
    var currentFolder = ViewBag.CurrentFolder as ProjectNoteFolder;
    var folderId = ViewBag.FolderId as int?;
    var projectId = ViewBag.ProjectId as int?;
    var folderNotesCount = ViewBag.FolderNotesCount as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="notes-container-wrapper">
    @await Html.PartialAsync("/Views/Shared/Notes/_FoldersToolbar.cshtml", viewData: new ViewDataDictionary(ViewData)
    {
        ["Folders"] = folders,
        ["FolderId"] = folderId,
        ["FolderNotesCount"] = folderNotesCount,
        ["CreateFolderUrl"] = $"/ProjectNoteFolders/Create?projectId={projectId}&parentFolderId={folderId}",
        ["CreateFolderPostUrl"] = Url.Action("Create", "ProjectNoteFolders"),
        ["CreateFolderModalId"] = "projectCreateFolderModal",
        ["CreateFolderProjectId"] = projectId,
        ["CreateNoteUrl"] = $"/ProjectNotes/Create?projectId={projectId}&folderId={folderId}",
        ["BackUrl"] = $"/Projects/Details/{projectId}",
        ["BackLabel"] = "بازگشت به پروژه",
        ["EditFolderPostUrl"] = Url.Action("Edit", "ProjectNoteFolders"),
        ["DeleteFolderPostUrl"] = Url.Action("Delete", "ProjectNoteFolders"),
        ["AllNotesUrl"] = $"/ProjectNotes/Index?projectId={projectId}",
        ["FolderUrlTemplate"] = $"/ProjectNotes/Index?projectId={projectId}&folderId={{id}}",
        ["EditFolderUrlTemplate"] = "/ProjectNoteFolders/Edit?id={id}",
        ["DeleteFolderUrlTemplate"] = "/ProjectNoteFolders/Delete?id={id}"
    })

    <!-- Main Content -->
    <div class="social-feed-container">
        <!-- Header Section -->
        <div class="feed-header">
            <div class="header-content">
                <div class="breadcrumb-nav">
                    @if (currentFolder != null)
                    {
                        <a href="/ProjectNotes/Index?projectId=@projectId" class="breadcrumb-item">
                            <i class="bi bi-house"></i>
                            همه یادداشت‌ها
                        </a>
                        <span class="breadcrumb-separator">/</span>
                        <span class="breadcrumb-current">
                            <i class="bi bi-folder-fill" style="color: @(currentFolder.Color ?? "#3b82f6");"></i>
                            @currentFolder.Name
                        </span>
                    }
                    else
                    {
                        <h1 class="feed-title">
                            <i class="bi bi-journal-text"></i>
                            یادداشت‌های پروژه: @ViewBag.ProjectName
                        </h1>
                    }
                </div>
                <p class="feed-subtitle">یادداشت‌ها و نکات مربوط به این پروژه</p>
                <a class="btn-back-project" href="/Projects/Details/@projectId">
                    <i class="bi bi-arrow-right"></i>
                    <span>بازگشت به پروژه</span>
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-social" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-social" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @TempData["Error"]
            </div>
        }

        @if (Model.Any())
        {
            <!-- Social Media Feed -->
            <div class="social-feed" id="socialFeedView">
                @foreach (var note in Model.OrderByDescending(n => n.CreatedAt))
                {
                    var noteColor = "#3b82f6";
                    var timeAgo = GetTimeAgo(note.CreatedAt);

                    <article class="note-post" data-detail-url="/ProjectNotes/Details?id=@note.Id" style="border-top: 2px solid #d8dee6;">
                        <!-- Post Header -->
                        <div class="post-header">
                            <div class="post-avatar">
                                <div class="avatar-circle" style="background: linear-gradient(135deg, @noteColor 0%, #2563eb 100%);">
                                    <i class="bi bi-journal-text"></i>
                                </div>
                            </div>
                            <div class="post-author">
                                <div class="author-name">یادداشت پروژه</div>
                                <div class="post-time">
                                    <i class="bi bi-clock"></i>
                                    <span>@timeAgo</span>
                                    <span class="time-full">(@FormatTehranPersianDateTime(note.CreatedAt))</span>
                                </div>
                            </div>
                        </div>

                        <!-- Post Content -->
                        <div class="post-content">
                            <h3 class="post-title">@note.Title</h3>
                            @if (!string.IsNullOrEmpty(note.Content))
                            {
                                <div class="post-text">
                                    @Html.Raw(note.Content.Replace("\n", "<br/>"))
                                </div>
                            }
                        </div>

                        <!-- Post Attachments -->
                        @if (note.Attachments != null && note.Attachments.Any())
                        {
                            <div class="post-attachments" onclick="event.stopPropagation();">
                                @foreach (var att in note.Attachments.Take(4))
                                {
                                    @if (att.FileType == "Image")
                                    {
                                        @*<div class="attachment-item attachment-image">
                                            <img src="@att.FilePath" alt="@att.FileName" class="attachment-img" />
                                            <div class="attachment-overlay">
                                                <i class="bi bi-zoom-in"></i>
                                            </div>
                                        </div>*@
                                        <div class="attachment-item attachment-image">
                                            <!-- اضافه کردن onclick برای باز کردن مودال -->
                                            <img src="@att.FilePath"
                                                 alt="@att.FileName"
                                                 class="attachment-img"
                                                 onclick="openImageModal('@att.FilePath'); event.stopPropagation();" />
                                            <div class="attachment-overlay" onclick="openImageModal('@att.FilePath'); event.stopPropagation();">
                                                <i class="bi bi-zoom-in"></i>
                                            </div>
                                        </div>
                                    }
                                    else if (att.FileType == "Audio")
                                    {
                                        <div class="attachment-item attachment-audio">
                                            <audio controls class="attachment-audio-player">
                                                <source src="@att.FilePath" type="@att.MimeType">
                                            </audio>
                                            <div class="attachment-info">
                                                <i class="bi bi-music-note-beamed"></i>
                                                <span>@att.FileName</span>
                                            </div>
                                        </div>
                                    }
                                    else if (att.FileType == "Document")
                                    {
                                        <a href="@att.FilePath" target="_blank" class="attachment-item attachment-document">
                                            <div class="attachment-icon">
                                                <i class="bi bi-file-earmark-text"></i>
                                            </div>
                                            <div class="attachment-details">
                                                <span class="attachment-name">@att.FileName</span>
                                                <span class="attachment-size">@(Math.Round(att.FileSize / 1024.0, 1)) KB</span>
                                            </div>
                                            <i class="bi bi-download attachment-download"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@att.FilePath" target="_blank" class="attachment-item attachment-file">
                                            <div class="attachment-icon">
                                                <i class="bi bi-file-earmark"></i>
                                            </div>
                                            <div class="attachment-details">
                                                <span class="attachment-name">@att.FileName</span>
                                                <span class="attachment-size">@(Math.Round(att.FileSize / 1024.0, 1)) KB</span>
                                            </div>
                                            <i class="bi bi-download attachment-download"></i>
                                        </a>
                                    }
                                }
                                @if (note.Attachments.Count > 4)
                                {
                                    <div class="attachment-item attachment-more">
                                        <span>+@(note.Attachments.Count - 4)</span>
                                        <small>فایل بیشتر</small>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Post Footer -->
                        <div class="post-footer" onclick="event.stopPropagation();">
                            <div class="post-meta">
                                <span class="meta-item">
                                    <i class="bi bi-paperclip"></i>
                                    <span>@(note.Attachments?.Count ?? 0) فایل</span>
                                </span>
                            </div>
                            <div class="post-actions">
                                <a href="/ProjectNotes/MoveToFolder?id=@note.Id" class="action-btn">
                                    <i class="bi bi-folder"></i>
                                    <span>جابجا کردن</span>
                                </a>
                                <a href="/ProjectNotes/Edit?id=@note.Id" class="action-btn">
                                    <i class="bi bi-pencil"></i>
                                    <span>ویرایش</span>
                                </a>
                                <a href="/ProjectNotes/Delete?id=@note.Id" class="action-btn action-danger">
                                    <i class="bi bi-trash"></i>
                                    <span>حذف</span>
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
            <div id="imagePreviewModal" class="image-modal" onclick="closeImageModal()">
                <span class="close-modal" onclick="closeImageModal()">&times;</span>
                <img id="modalImage" src="" alt="Preview" />
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-journal-x"></i>
                </div>
                <h3>هنوز یادداشتی برای این پروژه وجود ندارد</h3>
                <p>با ایجاد اولین یادداشت خود شروع کنید</p>
                <a href="/ProjectNotes/Create?projectId=@ViewBag.ProjectId" class="btn-create-note">
                    <i class="bi bi-plus-lg"></i>
                    <span>ایجاد اولین یادداشت</span>
                </a>
            </div>
        }
    </div>
</div>
<script>
    document.addEventListener('click', function (event) {
        const card = event.target.closest('.note-post[data-detail-url]');
        if (!card) return;

        const interactive = event.target.closest('a, button, input, textarea, select, label, form, audio, .post-actions, .post-footer, .post-attachments');
        if (interactive) return;

        const url = card.getAttribute('data-detail-url');
        if (url) window.location.href = url;
    });

    function openImageModal(src)
        {
            const modal = document.getElementById('imagePreviewModal');
            const modalImg = document.getElementById('modalImage');
            modalImg.src = src;
            modal.classList.add('active');
        }

        function closeImageModal()
        {
            const modal = document.getElementById('imagePreviewModal');
            modal.classList.remove('active');
        }

        // بستن مودال با کلیک روی پس‌زمینه
        document.getElementById('imagePreviewModal').addEventListener('click', function(e) {
            if (e.target === this)
            {
                closeImageModal();
            }
        });

    // بستن با کلید Escape
    document.addEventListener('keydown', function(e)
        {
            if (e.key === 'Escape')
            {
                closeImageModal();
            }
        });
</script>
@functions {

    private static TimeZoneInfo TehranTimeZone()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Iran Standard Time"); } catch { }
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran"); } catch { }
        return TimeZoneInfo.Local;
    }

    private static DateTime ToTehranTime(DateTime dateTime)
    {
        var utc = dateTime.Kind == DateTimeKind.Utc ? dateTime : dateTime.ToUniversalTime();
        return TimeZoneInfo.ConvertTimeFromUtc(utc, TehranTimeZone());
    }

    public string FormatTehranPersianDateTime(DateTime dateTime)
    {
        var culture = new CultureInfo("fa-IR");
        return ToTehranTime(dateTime).ToString("yyyy/MM/dd HH:mm", culture);
    }

    public string GetTimeAgo(DateTime dateTime)
    {
        var now = TimeZoneInfo.ConvertTime(DateTime.UtcNow, TehranTimeZone());
        var diff = now - ToTehranTime(dateTime);


        if (diff.TotalSeconds < 60)
            return "همین الان";
        
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes} دقیقه پیش";
        
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours} ساعت پیش";
        
        if (diff.TotalDays < 7)
            return $"{(int)diff.TotalDays} روز پیش";
        
        if (diff.TotalDays < 30)
            return $"{(int)(diff.TotalDays / 7)} هفته پیش";
        
        if (diff.TotalDays < 365)
            return $"{(int)(diff.TotalDays / 30)} ماه پیش";
        
        return $"{(int)(diff.TotalDays / 365)} سال پیش";
    }
}

