@model IEnumerable<ProjectNote>
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>📝 یادداشت‌های پروژه: @ViewBag.ProjectName</h2>
    </div>
    <div class="d-flex gap-2">
        <!-- دکمه تغییر نمایش -->
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-outline-secondary" id="viewCardBtn" onclick="toggleView('card')">
                <i class="bi bi-grid-3x3-gap"></i> کارت
            </button>
            <button type="button" class="btn btn-outline-secondary" id="viewListBtn" onclick="toggleView('list')">
                <i class="bi bi-list-ul"></i> لیست
            </button>
        </div>
        
        <a class="btn btn-primary" href="/ProjectNotes/Create?projectId=@ViewBag.ProjectId">
            <i class="bi bi-plus-circle"></i> افزودن یادداشت
        </a>
        <a class="btn btn-outline-secondary" href="/Projects/Details/@ViewBag.ProjectId">
            <i class="bi bi-arrow-right"></i> بازگشت به پروژه
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Any())
{
    <!-- نمایش کارتی -->
    <div class="row" id="cardView">
        @foreach (var note in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm hover-shadow clickable-card" 
                     style="cursor: pointer;"
                     onclick="window.location.href='/ProjectNotes/Details?id=@note.Id'">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <i class="bi bi-journal-text text-primary"></i>
                            @note.Title
                        </h5>
                        
                        <div class="flex-grow-1">
                            @if (!string.IsNullOrEmpty(note.Content))
                            {
                                <p class="card-text text-muted" style="white-space: pre-wrap; max-height: 150px; overflow: hidden;">
                                    @(note.Content.Length > 200 ? note.Content.Substring(0, 200) + "..." : note.Content)
                                </p>
                            }
                            else
                            {
                                <p class="card-text text-muted fst-italic">بدون محتوا</p>
                            }

                            @* نمایش فایل‌های پیوست *@
                            @if (note.Attachments != null && note.Attachments.Any())
                            {
                                <div class="mt-3">
                                    <small class="text-muted">
                                        <i class="bi bi-paperclip"></i>
                                        @note.Attachments.Count فایل پیوست
                                    </small>
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        @foreach (var att in note.Attachments.Take(3))
                                        {
                                            @if (att.FileType == "Image")
                                            {
                                                <img src="@att.FilePath" alt="@att.FileName" 
                                                     class="img-thumbnail" 
                                                     style="width: 60px; height: 60px; object-fit: cover; cursor: pointer;"
                                                     title="@att.FileName"
                                                     onclick="event.stopPropagation(); window.location.href='/ProjectNotes/Details?id=@note.Id'" />
                                            }
                                            else if (att.FileType == "Audio")
                                            {
                                                <span class="badge bg-info" style="font-size: 0.9em;">
                                                    <i class="bi bi-music-note"></i> صوت
                                                </span>
                                            }
                                            else if (att.FileType == "Document")
                                            {
                                                <span class="badge bg-success" style="font-size: 0.9em;">
                                                    <i class="bi bi-file-earmark-text"></i> سند
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary" style="font-size: 0.9em;">
                                                    <i class="bi bi-file-earmark"></i> فایل
                                                </span>
                                            }
                                        }
                                        @if (note.Attachments.Count > 3)
                                        {
                                            <span class="badge bg-light text-dark">+@(note.Attachments.Count - 3)</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="bi bi-clock"></i>
                                @note.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                            </small>
                        </div>

                        <div class="btn-group mt-3" role="group" onclick="event.stopPropagation();">
                            <a href="/ProjectNotes/Edit?id=@note.Id" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> ویرایش
                            </a>
                            <a href="/ProjectNotes/Delete?id=@note.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> حذف
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- نمایش لیستی -->
    <div class="table-responsive" id="listView" style="display: none;">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 20%;">عنوان</th>
                    <th style="width: 35%;">محتوا</th>
                    <th style="width: 15%;">فایل‌های پیوست</th>
                    <th style="width: 15%;">تاریخ ایجاد</th>
                    <th style="width: 15%;">عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var note in Model)
            {
                <tr style="cursor: pointer;" onclick="window.location.href='/ProjectNotes/Details?id=@note.Id'">
                    <td>
                        <i class="bi bi-journal-text text-primary"></i>
                        <strong>@note.Title</strong>
                    </td>
                    <td>
                        <small class="text-muted" style="display: block; max-height: 60px; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(note.Content))
                            {
                                @(note.Content.Length > 100 ? note.Content.Substring(0, 100) + "..." : note.Content)
                            }
                            else
                            {
                                <em class="text-muted">بدون محتوا</em>
                            }
                        </small>
                    </td>
                    <td>
                        @if (note.Attachments != null && note.Attachments.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                @foreach (var att in note.Attachments.Take(2))
                                {
                                    @if (att.FileType == "Image")
                                    {
                                        <img src="@att.FilePath" alt="@att.FileName" 
                                             class="img-thumbnail" 
                                             style="width: 40px; height: 40px; object-fit: cover; cursor: pointer;"
                                             title="@att.FileName"
                                             onclick="event.stopPropagation(); window.location.href='/ProjectNotes/Details?id=@note.Id'" />
                                    }
                                    else if (att.FileType == "Audio")
                                    {
                                        <span class="badge bg-info" title="@att.FileName">
                                            <i class="bi bi-music-note"></i>
                                        </span>
                                    }
                                    else if (att.FileType == "Document")
                                    {
                                        <span class="badge bg-success" title="@att.FileName">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" title="@att.FileName">
                                            <i class="bi bi-file-earmark"></i>
                                        </span>
                                    }
                                }
                                @if (note.Attachments.Count > 2)
                                {
                                    <span class="badge bg-light text-dark" title="@note.Attachments.Count فایل">
                                        +@(note.Attachments.Count - 2)
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <small class="text-muted">-</small>
                        }
                    </td>
                    <td>
                        <small class="text-muted">
                            <i class="bi bi-clock"></i>
                            @note.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                            <br />
                            <span class="text-muted">@note.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                        </small>
                    </td>
                    <td onclick="event.stopPropagation();">
                        <div class="btn-group" role="group">
                            <a href="/ProjectNotes/Edit?id=@note.Id" class="btn btn-sm btn-outline-warning" title="ویرایش">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="/ProjectNotes/Delete?id=@note.Id" class="btn btn-sm btn-outline-danger" title="حذف">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
else
{
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-journal-x" style="font-size: 3rem;"></i>
        <h4 class="mt-3">هیچ یادداشتی برای این پروژه وجود ندارد</h4>
        <p>با کلیک بر روی دکمه "افزودن یادداشت" اولین یادداشت خود را ایجاد کنید.</p>
    </div>
}

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease, transform 0.2s ease;
    }
    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        transform: translateY(-2px);
    }
    .clickable-card {
        cursor: pointer;
    }
    .table-hover tbody tr {
        transition: background-color 0.2s ease;
    }
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }
</style>

<script>
    // ذخیره و بارگذاری حالت نمایش از localStorage
    function toggleView(viewType) {
        const cardView = document.getElementById('cardView');
        const listView = document.getElementById('listView');
        const cardBtn = document.getElementById('viewCardBtn');
        const listBtn = document.getElementById('viewListBtn');
        
        if (viewType === 'card') {
            cardView.style.display = 'flex';
            listView.style.display = 'none';
            cardBtn.classList.add('active');
            listBtn.classList.remove('active');
            localStorage.setItem('projectNotesViewType', 'card');
        } else {
            cardView.style.display = 'none';
            listView.style.display = 'block';
            cardBtn.classList.remove('active');
            listBtn.classList.add('active');
            localStorage.setItem('projectNotesViewType', 'list');
        }
    }
    
    // بارگذاری حالت ذخیره شده هنگام لود صفحه
    document.addEventListener('DOMContentLoaded', function() {
        const savedView = localStorage.getItem('projectNotesViewType') || 'card';
        toggleView(savedView);
    });
</script>
