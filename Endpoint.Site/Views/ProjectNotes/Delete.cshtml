@model ProjectNote
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h2>حذف یادداشت</h2>

<div class="alert alert-warning">
    <h4>آیا مطمئن هستید که می‌خواهید این یادداشت را حذف کنید؟</h4>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p><strong>پروژه:</strong> @Model.Project?.Name</p>
        <p><strong>تاریخ ایجاد:</strong> @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</p>
        <hr />
        <div style="white-space: pre-wrap;">@Model.Content</div>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">تایید حذف</button>
    <a class="btn btn-secondary" href="/TaskPlanner/ProjectNotes/Index?projectId=@Model.ProjectId">بازگشت به لیست یادداشت‌ها</a>
    <a class="btn btn-outline-secondary" href="/TaskPlanner/Projects/Details/@Model.ProjectId">بازگشت به پروژه</a>
</form>


