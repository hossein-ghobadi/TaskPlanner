@model IReadOnlyList<TaskPlanner.Application.Services.LeadService.LeadListItemDto>
@using TaskPlanner.Application.Services.LeadService
@using TaskPlanner.Application.Services.CrmService
@using TaskPlanner.Domain.Entities.TaskPlanner
@using DNTPersianUtils.Core
@{
    ViewData["Title"] = "لیدها (CRM)";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";

    var leads = (Model ?? Array.Empty<LeadListItemDto>()).ToList();
    var availableCrms = ViewBag.AvailableCrms as IReadOnlyList<CrmSelectDto> ?? Array.Empty<CrmSelectDto>();
    var selectedCrmId = ViewBag.SelectedCrmId as int?;
    var crmNameById = availableCrms.ToDictionary(c => c.Id, c => c.DisplayLabel);
    var columnOrder = new[]
    {
        LeadPipelineStatus.New,
        LeadPipelineStatus.Contacted,
        LeadPipelineStatus.QuoteAnnounced,
        LeadPipelineStatus.Qualified,
        LeadPipelineStatus.Converted,
        LeadPipelineStatus.Lost
    };
    var leadsByStatus = leads.GroupBy(x => x.Status).ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.CreatedAt).ToList());

    string StatusLabel(LeadPipelineStatus s) => s switch
    {
        LeadPipelineStatus.New => "جدید",
        LeadPipelineStatus.Contacted => "در تماس",
        LeadPipelineStatus.QuoteAnnounced => "اعلام قیمت",
        LeadPipelineStatus.Qualified => "قطعیت",
        LeadPipelineStatus.Converted => "تبدیل‌شده",
        LeadPipelineStatus.Lost => "از دست رفته",
        _ => s.ToString()
    };

    string StatusBadgeClass(LeadPipelineStatus s) => s switch
    {
        LeadPipelineStatus.New => "lead-status-pill lead-status-pill--new",
        LeadPipelineStatus.Contacted => "lead-status-pill lead-status-pill--contacted",
        LeadPipelineStatus.QuoteAnnounced => "lead-status-pill lead-status-pill--quote",
        LeadPipelineStatus.Qualified => "lead-status-pill lead-status-pill--qualified",
        LeadPipelineStatus.Converted => "lead-status-pill lead-status-pill--converted",
        LeadPipelineStatus.Lost => "lead-status-pill lead-status-pill--lost",
        _ => "lead-status-pill"
    };

    string KanbanColClass(LeadPipelineStatus s) => "leads-kanban-col--neutral";
}

<link rel="stylesheet" href="~/css/leads-index.css" asp-append-version="true" />

<div class="boards-page" id="leadsIndexRoot">
    <div class="leads-toolbar">
        <div class="leads-toolbar__title-block">
            <h1 class="leads-toolbar__title">لیدها</h1>
            <p class="leads-toolbar__meta">
                @leads.Count.ToString().ToPersianNumbers() لید
                @if (selectedCrmId is int sel && crmNameById.TryGetValue(sel, out var selectedLabel))
                {
                    <text>· @selectedLabel</text>
                }
                else if (availableCrms.Count > 1)
                {
                    <text>· همه فضاها</text>
                }
            </p>
        </div>

        <div class="leads-toolbar__actions">
            @if (availableCrms.Any())
            {
                <form method="get" asp-action="Index" class="leads-toolbar__cluster mb-0">
                    <i class="bi bi-funnel text-muted small ps-2"></i>
                    <select id="crmFilter" name="crmId" class="leads-toolbar__select form-select form-select-sm" aria-label="فیلتر فضا" onchange="this.form.submit()">
                        <option value="">همه</option>
                        @foreach (var crm in availableCrms)
                        {
                            if (selectedCrmId == crm.Id)
                            {
                                <option value="@crm.Id" selected>@crm.DisplayLabel</option>
                            }
                            else
                            {
                                <option value="@crm.Id">@crm.DisplayLabel</option>
                            }
                        }
                    </select>
                </form>
            }

            <div class="leads-toolbar__cluster leads-view-toggle" role="group" aria-label="نوع نما">
                <button type="button" class="btn active" id="leadsViewBtnList" aria-pressed="true">
                    <i class="bi bi-list-ul ms-1"></i>لیست
                </button>
                <button type="button" class="btn" id="leadsViewBtnBoard" aria-pressed="false">
                    <i class="bi bi-columns-gap ms-1"></i>تخته
                </button>
            </div>

            <a class="leads-toolbar__ghost" href="/Crm/Manage">
                <i class="bi bi-people"></i>
                <span>مدیریت CRM</span>
            </a>
            <a class="leads-toolbar__primary" href="@(selectedCrmId is int cid ? $"/Leads/Create?crmId={cid}" : "/Leads/Create")">
                <i class="bi bi-plus-lg"></i>
                <span>لید جدید</span>
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-2">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-2">@TempData["Error"]</div>
    }

    <div id="leadsViewListPane" class="leads-view-pane mt-2">
        @if (!leads.Any())
        {
            <div class="alert alert-light border mt-2">هنوز لیدی ثبت نشده است.</div>
        }
        else
        {
            <div class="table-responsive mt-2">
                <table class="table table-hover align-middle bg-white border rounded">
                    <thead class="table-light">
                        <tr>
                            <th>عنوان</th>
                            <th>CRM</th>
                            <th>شرکت</th>
                            <th>وضعیت</th>
                            <th>جلسه پیش‌رو</th>
                            <th>تاریخ</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in leads.OrderByDescending(x => x.CreatedAt))
                        {
                            <tr>
                                <td class="fw-semibold">@l.Title</td>
                                <td class="small text-muted">@(crmNameById.TryGetValue(l.CrmId, out var crmLabel) ? crmLabel : "—")</td>
                                <td>@(l.CompanyName ?? "—")</td>
                                <td><span class="badge @StatusBadgeClass(l.Status)">@StatusLabel(l.Status)</span></td>
                                @{
                                    var displaySessionAt = l.NextSessionAt ?? l.MeetingAt;
                                }
                                <td class="text-muted small">@(displaySessionAt.HasValue ? displaySessionAt.Value.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers() : "—")</td>
                                <td class="text-muted small">@l.CreatedAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()</td>
                                <td class="text-end">
                                    <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                                            <a class="btn btn-sm btn-outline-secondary" href="/Leads/Details/@l.Id">جزئیات</a>
                                        @if (!l.IsCrmOwner)
                                        {
                                            <span class="badge bg-light text-dark border">همکار</span>
                                        }
                                        @if (l.CanEdit && l.Status != LeadPipelineStatus.Converted)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary js-open-lead-edit" data-lead-id="@l.Id" title="ویرایش">ویرایش</button>
                                        }
                                        @if (l.CanOpenConvertedProject && l.ConvertedProjectId is int pid)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="/Projects/Details/@pid">پروژه</a>
                                        }
                                        @if (l.CanEdit)
                                        {
                                            <form asp-controller="Leads" asp-action="Delete" asp-route-id="@l.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('این لید برای همیشه حذف شود؟ پروژهٔ ساخته‌شده (در صورت وجود) حذف نمی‌شود.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div id="leadsViewBoardPane" class="leads-view-pane mt-2 d-none">
        <div class="leads-kanban d-flex gap-2 flex-nowrap overflow-auto pb-2">
            @foreach (var st in columnOrder)
            {
                var colLeads = leadsByStatus.TryGetValue(st, out var list) ? list : new List<LeadListItemDto>();
                <div class="leads-kanban-col @KanbanColClass(st)">
                    <div class="leads-kanban-col-header">
                        <span>@StatusLabel(st)</span>
                        <span class="badge rounded-pill @StatusBadgeClass(st)">@colLeads.Count.ToString().ToPersianNumbers()</span>
                    </div>
                    <div class="leads-kanban-col-body">
                        @if (!colLeads.Any())
                        {
                            <div class="leads-kanban-empty-hint">لیدی در این مرحله نیست</div>
                        }
                        else
                        {
                            foreach (var l in colLeads)
                            {
                                <div class="card leads-kanban-card mb-2">
                                    <div class="card-body">
                                        <div class="leads-kanban-card-title">@l.Title</div>
                                        <div class="leads-kanban-card-meta mb-2">
                                            @(crmNameById.TryGetValue(l.CrmId, out var cardCrm) ? cardCrm : "CRM") · @(l.CompanyName ?? "—") · @l.CreatedAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()
                                            @{
                                                var cardSessionAt = l.NextSessionAt ?? l.MeetingAt;
                                            }
                                            @if (cardSessionAt.HasValue)
                                            {
                                                <span class="d-block mt-1 text-primary">جلسه: @cardSessionAt.Value.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()</span>
                                            }
                                        </div>
                                        <div class="d-flex flex-wrap gap-1 justify-content-end">
                                            <a class="btn btn-sm btn-outline-secondary py-0 px-2" href="/Leads/Details/@l.Id">جزئیات</a>
                                            @if (!l.IsCrmOwner)
                                            {
                                                <span class="badge bg-light text-dark border py-1">همکار</span>
                                            }
                                            @if (l.CanEdit && l.Status != LeadPipelineStatus.Converted)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 js-open-lead-edit" data-lead-id="@l.Id">ویرایش</button>
                                            }
                                            @if (l.CanOpenConvertedProject && l.ConvertedProjectId is int pid)
                                            {
                                                <a class="btn btn-sm btn-outline-secondary py-0 px-2" href="/Projects/Details/@pid">پروژه</a>
                                            }
                                            @if (l.CanEdit)
                                            {
                                                <form asp-controller="Leads" asp-action="Delete" asp-route-id="@l.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('این لید برای همیشه حذف شود؟ پروژهٔ ساخته‌شده (در صورت وجود) حذف نمی‌شود.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">حذف</button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="leadEditModal" tabindex="-1" aria-labelledby="leadEditModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="leadEditModalTitle">ویرایش لید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="leadEditModalBody">
                <p class="text-muted small mb-0">در حال بارگذاری...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/toman-amount.js" asp-append-version="true"></script>
    <script>
        (function () {
            const storageKey = 'leadsIndexViewMode';
            const listPane = document.getElementById('leadsViewListPane');
            const boardPane = document.getElementById('leadsViewBoardPane');
            const btnList = document.getElementById('leadsViewBtnList');
            const btnBoard = document.getElementById('leadsViewBtnBoard');
            const modalEl = document.getElementById('leadEditModal');
            const bodyEl = document.getElementById('leadEditModalBody');
            if (!listPane || !boardPane || !btnList || !btnBoard) return;

            function applyViewMode(mode) {
                const isBoard = mode === 'board';
                listPane.classList.toggle('d-none', isBoard);
                boardPane.classList.toggle('d-none', !isBoard);
                btnList.classList.toggle('active', !isBoard);
                btnBoard.classList.toggle('active', isBoard);
                btnList.setAttribute('aria-pressed', (!isBoard).toString());
                btnBoard.setAttribute('aria-pressed', isBoard.toString());
                try { localStorage.setItem(storageKey, isBoard ? 'board' : 'list'); } catch (_) { }
            }

            btnList.addEventListener('click', function () { applyViewMode('list'); });
            btnBoard.addEventListener('click', function () { applyViewMode('board'); });

            try {
                var saved = localStorage.getItem(storageKey);
                if (saved === 'board') applyViewMode('board');
            } catch (_) { }

            if (!modalEl || !bodyEl) return;

            const bsModal = () => {
                if (!window.bootstrap || !window.bootstrap.Modal) {
                    throw new Error('bootstrap_modal_unavailable');
                }
                let inst = window.bootstrap.Modal.getInstance(modalEl);
                if (!inst) inst = new window.bootstrap.Modal(modalEl);
                return inst;
            };

            async function loadLeadEditForm(leadId) {
                bodyEl.innerHTML = '<p class="text-muted small mb-0 p-2">در حال بارگذاری...</p>';
                try {
                    bsModal().show();
                } catch {
                    alert('نمایش مودال در حال حاضر در دسترس نیست. لطفاً صفحه را یک‌بار رفرش کنید.');
                    return;
                }
                try {
                    const res = await fetch('/Leads/EditModal/' + encodeURIComponent(leadId), {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const html = await res.text();
                    bodyEl.innerHTML = html;
                    if (window.TomanAmount) {
                        window.TomanAmount.init(bodyEl);
                    }
                    if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                        window.jQuery.validator.unobtrusive.parse(bodyEl);
                    }
                } catch {
                    bodyEl.innerHTML = '<div class="alert alert-danger mb-0">خطا در ارتباط با سرور.</div>';
                }
            }

            document.getElementById('leadsIndexRoot').addEventListener('click', function (e) {
                const btn = e.target.closest('.js-open-lead-edit');
                if (!btn) return;
                const id = btn.getAttribute('data-lead-id');
                if (id) loadLeadEditForm(id);
            });

            modalEl.addEventListener('submit', async function (e) {
                const form = e.target && e.target.id === 'leadEditModalForm' ? e.target : null;
                if (!form) return;
                e.preventDefault();

                if (window.TomanAmount) {
                    window.TomanAmount.prepareForm(form);
                }

                const fd = new FormData(form);
                fd.set('returnTo', 'list');

                try {
                    const res = await fetch(form.action, {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const ct = (res.headers.get('content-type') || '').toLowerCase();
                    if (ct.indexOf('application/json') >= 0) {
                        const data = await res.json();
                        if (data.ok) {
                            bsModal().hide();
                            window.location.reload();
                            return;
                        }
                        alert(data.message || 'خطا در ذخیره');
                        return;
                    }
                    if (!res.ok) {
                        const errText = await res.text();
                        bodyEl.innerHTML = errText || '<div class="alert alert-danger mb-0">خطا</div>';
                    } else {
                        bodyEl.innerHTML = await res.text();
                    }
                    if (window.TomanAmount) {
                        window.TomanAmount.init(bodyEl);
                    }
                    if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                        window.jQuery.validator.unobtrusive.parse(bodyEl);
                    }
                } catch {
                    alert('خطا در ارتباط با سرور.');
                }
            }, true);
        })();
    </script>
}
