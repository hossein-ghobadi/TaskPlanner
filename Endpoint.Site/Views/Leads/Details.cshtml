@model TaskPlanner.Application.Services.LeadService.LeadDetailsDto
@using TaskPlanner.Domain.Entities.TaskPlanner
@using TaskPlanner.Application.Services.ProjectService
@using DNTPersianUtils.Core
@{
    ViewData["Title"] = Model.Title;
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
    var collaboratorChoices = ViewBag.CollaboratorChoices as IReadOnlyList<UserSelectDto> ?? Array.Empty<UserSelectDto>();
    var nextSession = Model.Sessions
        .Where(s => s.ScheduledAt >= DateTime.UtcNow)
        .OrderBy(s => s.ScheduledAt)
        .FirstOrDefault()
        ?? Model.Sessions.OrderByDescending(s => s.ScheduledAt).FirstOrDefault();

    string StatusLabel(LeadPipelineStatus s) => s switch
    {
        LeadPipelineStatus.New => "جدید",
        LeadPipelineStatus.Contacted => "در تماس",
        LeadPipelineStatus.Qualified => "قطعیت (آماده تبدیل)",
        LeadPipelineStatus.Converted => "تبدیل به پروژه",
        LeadPipelineStatus.Lost => "از دست رفته",
        _ => s.ToString()
    };
}

<div class="boards-page" style="max-width: 800px;">
    <div class="boards-head">
        <h1 class="boards-title mb-0">@Model.Title</h1>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <a class="btn btn-outline-secondary btn-sm" href="/Leads/Index">لیست لیدها</a>
            @if (!Model.IsOwner)
            {
                <span class="badge bg-secondary">همکار (فقط مشاهده)</span>
            }
            @if (Model.IsOwner && Model.Status != LeadPipelineStatus.Converted)
            {
                <a class="btn btn-outline-primary btn-sm" href="/Leads/Edit/@Model.Id">ویرایش</a>
            }
            @if (Model.ConvertedProjectId is int pid)
            {
                <a class="btn btn-primary btn-sm" href="/Projects/Details/@pid">رفتن به پروژه</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-2">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-2">@TempData["Error"]</div>
    }

    <div class="card border mt-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">وضعیت</dt>
                <dd class="col-sm-9">@StatusLabel(Model.Status)</dd>
                <dt class="col-sm-3">شرکت</dt>
                <dd class="col-sm-9">@(Model.CompanyName ?? "—")</dd>
                <dt class="col-sm-3">تماس</dt>
                <dd class="col-sm-9">@(Model.ContactName ?? "—")</dd>
                <dt class="col-sm-3">تلفن</dt>
                <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
                <dt class="col-sm-3">ایمیل</dt>
                <dd class="col-sm-9">@(Model.Email ?? "—")</dd>
                <dt class="col-sm-3">منبع</dt>
                <dd class="col-sm-9">@(Model.Source ?? "—")</dd>
                <dt class="col-sm-3">نزدیک‌ترین جلسه</dt>
                <dd class="col-sm-9">@(nextSession != null ? nextSession.ScheduledAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers() : "—")</dd>
                <dt class="col-sm-3">ایجاد</dt>
                <dd class="col-sm-9 text-muted small">@Model.CreatedAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()</dd>
                <dt class="col-sm-3">به‌روزرسانی</dt>
                <dd class="col-sm-9 text-muted small">@Model.UpdatedAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <hr />
                <h6 class="text-muted">یادداشت</h6>
                <p class="mb-0" style="white-space: pre-wrap;">@Model.Notes</p>
            }
        </div>
    </div>

    <div class="card border mt-3">
        <div class="card-header fw-bold">یادداشت‌های لید</div>
        <div class="card-body">
            @if (Model.IsOwner)
            {
                <form asp-controller="Leads" asp-action="AddLeadNote" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="leadId" value="@Model.Id" />
                    <div class="col-md-4">
                        <label class="form-label small mb-1">عنوان</label>
                        <input name="title" class="form-control form-control-sm" maxlength="200" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">متن یادداشت</label>
                        <input name="content" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">پیوست فایل</label>
                        <input name="attachments" type="file" class="form-control form-control-sm" multiple />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary btn-sm w-100">افزودن</button>
                    </div>
                </form>
            }

            @if (Model.NotesList.Any())
            {
                <hr />
                <ul class="list-group list-group-flush border rounded">
                    @foreach (var n in Model.NotesList.OrderByDescending(x => x.CreatedAt))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start flex-wrap gap-2 py-2">
                            <div>
                                <div class="fw-semibold">@n.Title</div>
                                @if (!string.IsNullOrWhiteSpace(n.Content))
                                {
                                    <div class="small text-muted" style="white-space: pre-wrap;">@n.Content</div>
                                }
                                @if (n.Attachments.Any())
                                {
                                    <div class="small mt-1">
                                        <span class="text-muted">پیوست‌ها:</span>
                                        @foreach (var a in n.Attachments)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@a.FileName</span>
                                        }
                                    </div>
                                }
                                <div class="small text-secondary mt-1">@n.CreatedAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()</div>
                            </div>
                            @if (Model.IsOwner)
                            {
                                <form asp-controller="Leads" asp-action="DeleteLeadNote" method="post" class="m-0" onsubmit="return confirm('این یادداشت حذف شود؟');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="leadId" value="@Model.Id" />
                                    <input type="hidden" name="noteId" value="@n.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small @(Model.IsOwner ? "mt-3" : "mt-0") mb-0">هنوز یادداشتی برای این لید ثبت نشده است.</p>
            }
        </div>
    </div>

    <div class="card border mt-3">
        <div class="card-header fw-bold">جلسات لید</div>
        <div class="card-body">
            @if (Model.IsOwner)
            {
                <form asp-controller="Leads" asp-action="AddSession" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="leadId" value="@Model.Id" />
                    <div class="col-md-4">
                        <label class="form-label small mb-1">تاریخ و ساعت جلسه (شمسی)</label>
                        <input id="leadSessionPersianInput"
                               name="meetingAtPersian"
                               type="text"
                               class="form-control form-control-sm"
                               placeholder="مثلاً 1405/02/15 14:30"
                               autocomplete="off"
                               required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">توضیحات (اختیاری)</label>
                        <input name="notes" type="text" class="form-control form-control-sm" maxlength="500" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">افزودن جلسه</button>
                    </div>
                </form>
            }

            @if (Model.Sessions.Any())
            {
                <hr />
                <ul class="list-group list-group-flush border rounded">
                    @foreach (var s in Model.Sessions.OrderBy(x => x.ScheduledAt))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                            <div>
                                <div class="fw-semibold">@s.ScheduledAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()</div>
                                @if (!string.IsNullOrWhiteSpace(s.Notes))
                                {
                                    <div class="small text-muted">@s.Notes</div>
                                }
                            </div>
                            @if (Model.IsOwner)
                            {
                                <form asp-controller="Leads" asp-action="DeleteSession" method="post" class="m-0" onsubmit="return confirm('این جلسه حذف شود؟');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="leadId" value="@Model.Id" />
                                    <input type="hidden" name="sessionId" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small @(Model.IsOwner ? "mt-3" : "mt-0") mb-0">هنوز جلسه‌ای برای این لید ثبت نشده است.</p>
            }
        </div>
    </div>

    @if (Model.IsOwner)
    {
        <div class="card border mt-3">
            <div class="card-header fw-bold">همکاران روی لید (CRM)</div>
            <div class="card-body">
                <p class="small text-muted mb-3">از بین <strong>همکاران تأییدشده</strong> فرد را اضافه کنید، یا با <strong>شماره موبایل</strong> دعوت بفرستید (کاربر باید در سیستم ثبت‌نام کرده باشد). همکاران لید را در «لیدها» و دعوت‌ها می‌بینند.</p>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <form asp-controller="Leads" asp-action="AddLeadMember" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="leadId" value="@Model.Id" />
                            <div class="flex-grow-1" style="min-width: 200px;">
                                <label class="form-label small mb-1">افزودن از همکاران</label>
                                <select name="memberUserId" class="form-select form-select-sm" required>
                                    <option value="">— انتخاب کنید —</option>
                                    @foreach (var u in collaboratorChoices)
                                    {
                                        <option value="@u.Id">@u.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">افزودن</button>
                        </form>
                    </div>
                    <div class="col-md-6">
                        <form asp-controller="Leads" asp-action="InviteLeadByPhone" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="leadId" value="@Model.Id" />
                            <div class="flex-grow-1" style="min-width: 200px;">
                                <label class="form-label small mb-1">دعوت با شماره موبایل</label>
                                <input type="text" name="phone" class="form-control form-control-sm" placeholder="مثلاً 0912..." autocomplete="tel" required />
                            </div>
                            <button type="submit" class="btn btn-outline-primary btn-sm">ارسال دعوت</button>
                        </form>
                    </div>
                </div>

                @if (Model.Members.Any())
                {
                    <h6 class="mt-4 mb-2 text-muted small">همکاران فعلی</h6>
                    <ul class="list-group list-group-flush border rounded">
                        @foreach (var m in Model.Members)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <span>@m.DisplayName</span>
                                <form asp-controller="Leads" asp-action="RemoveLeadMember" method="post" class="m-0" onsubmit="return confirm('این همکار از لید حذف شود؟');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="leadId" value="@Model.Id" />
                                    <input type="hidden" name="memberUserId" value="@m.UserId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </li>
                        }
                    </ul>
                }

                @if (Model.PendingInvitations.Any())
                {
                    <h6 class="mt-3 mb-2 text-muted small">دعوت‌های در انتظار</h6>
                    <ul class="list-group list-group-flush border rounded">
                        @foreach (var inv in Model.PendingInvitations)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                                <span>@(inv.InviteeDisplayName ?? inv.InviteePhone)</span>
                                <form asp-controller="Leads" asp-action="CancelLeadInvite" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="invitationId" value="@inv.Id" />
                                    <input type="hidden" name="leadId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">لغو دعوت</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    @if (Model.IsOwner && Model.Status == LeadPipelineStatus.Qualified && Model.ConvertedProjectId == null)
    {
        <div class="card border-success mt-3">
            <div class="card-header bg-success text-white">تبدیل به پروژه</div>
            <div class="card-body">
                <p class="small text-muted mb-3">با تبدیل، یک پروژه جدید با اطلاعات همین لید ساخته می‌شود و این لید به‌عنوان «تبدیل‌شده» علامت می‌خورد.</p>
                <form method="post" action="/Leads/Convert">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LeadId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">نام پروژه (اختیاری)</label>
                        <input type="text" name="ProjectName" class="form-control" placeholder="@Model.Title" maxlength="200" />
                        <div class="form-text">در صورت خالی بودن از عنوان لید استفاده می‌شود.</div>
                    </div>
                    <button type="submit" class="btn btn-success"><i class="bi bi-briefcase ms-1"></i>ایجاد پروژه</button>
                </form>
            </div>
        </div>
    }
    else if (Model.Status == LeadPipelineStatus.Converted && Model.ConvertedProjectId is int convId)
    {
        <div class="alert alert-info mt-3 mb-0">
            این لید در @(Model.ConvertedAt.HasValue ? Model.ConvertedAt.Value.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers() : "—") به <a href="/Projects/Details/@convId">پروژه شماره @convId.ToString().ToPersianNumbers()</a> تبدیل شده است.
        </div>
    }
    else if (Model.IsOwner && Model.ConvertedProjectId == null)
    {
        <div class="alert alert-light border mt-3 mb-0 small">
            برای فعال شدن دکمه تبدیل، در ویرایش لید وضعیت را به <strong>قطعیت</strong> (Qualified) تغییر دهید.
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            if (!(window.$ && $.fn.persianDatepicker)) return;
            $('#leadSessionPersianInput').persianDatepicker({
                format: 'YYYY/MM/DD HH:mm',
                autoClose: true,
                timePicker: {
                    enabled: true,
                    meridian: false
                },
                calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' } }
            });
        })();
    </script>
}
