@model TaskPlanner.Application.Services.LeadService.LeadDetailsDto
@using TaskPlanner.Domain.Entities.TaskPlanner
@using TaskPlanner.Application.Services.ProjectService
@using DNTPersianUtils.Core
@{
    ViewData["Title"] = Model.Title;
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
    var collaboratorChoices = ViewBag.CollaboratorChoices as IReadOnlyList<UserSelectDto> ?? Array.Empty<UserSelectDto>();
    var nextSession = Model.Sessions
        .Where(s => s.ScheduledAt >= DateTime.UtcNow)
        .OrderBy(s => s.ScheduledAt)
        .FirstOrDefault()
        ?? Model.Sessions.OrderByDescending(s => s.ScheduledAt).FirstOrDefault();

    string StatusLabel(LeadPipelineStatus s) => s switch
    {
        LeadPipelineStatus.New => "جدید",
        LeadPipelineStatus.Contacted => "در تماس",
        LeadPipelineStatus.QuoteAnnounced => "اعلام قیمت",
        LeadPipelineStatus.Qualified => "قطعیت (آماده تبدیل)",
        LeadPipelineStatus.Converted => "تبدیل به پروژه",
        LeadPipelineStatus.Lost => "از دست رفته",
        _ => s.ToString()
    };
}

<link rel="stylesheet" href="~/lib/easymde/dist/easymde.min.css">
<link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css">

<div class="boards-page" style="max-width: 800px;">
    <div class="boards-head">
        <h1 class="boards-title mb-0">@Model.Title</h1>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <a class="btn btn-outline-secondary btn-sm" href="/Leads/Index">لیست لیدها</a>
            @if (!Model.IsOwner)
            {
                <span class="badge bg-secondary">همکار (فقط مشاهده)</span>
            }
            @if (Model.IsOwner && Model.Status != LeadPipelineStatus.Converted)
            {
                <a class="btn btn-outline-primary btn-sm" href="/Leads/Edit/@Model.Id">ویرایش</a>
            }
            @if (Model.ConvertedProjectId is int pid)
            {
                <a class="btn btn-primary btn-sm" href="/Projects/Details/@pid">رفتن به پروژه</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-2">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-2">@TempData["Error"]</div>
    }

    <div class="card border mt-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">وضعیت</dt>
                <dd class="col-sm-9">@StatusLabel(Model.Status)</dd>
                <dt class="col-sm-3">شرکت</dt>
                <dd class="col-sm-9">@(Model.CompanyName ?? "—")</dd>
                <dt class="col-sm-3">تماس</dt>
                <dd class="col-sm-9">@(Model.ContactName ?? "—")</dd>
                <dt class="col-sm-3">تلفن</dt>
                <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
                <dt class="col-sm-3">ایمیل</dt>
                <dd class="col-sm-9">@(Model.Email ?? "—")</dd>
                <dt class="col-sm-3">منبع</dt>
                <dd class="col-sm-9">@(Model.Source ?? "—")</dd>
                <dt class="col-sm-3">نزدیک‌ترین جلسه</dt>
                <dd class="col-sm-9">@(nextSession != null ? nextSession.ScheduledAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers() : "—")</dd>
                <dt class="col-sm-3">ایجاد</dt>
                <dd class="col-sm-9 text-muted small">@Model.CreatedAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()</dd>
                <dt class="col-sm-3">به‌روزرسانی</dt>
                <dd class="col-sm-9 text-muted small">@Model.UpdatedAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <hr />
                <h6 class="text-muted">یادداشت</h6>
                <p class="mb-0" style="white-space: pre-wrap;">@Model.Notes</p>
            }
        </div>
    </div>

    <div class="card border mt-3">
        <div class="card-header fw-bold">یادداشت‌های لید</div>
        <div class="card-body">
            @if (Model.IsOwner)
            {
                <div class="d-flex justify-content-end">
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#leadNoteModal">
                        افزودن یادداشت
                    </button>
                </div>
            }

            @if (Model.NotesList.Any())
            {
                <hr />
                <ul class="list-group list-group-flush border rounded">
                    @foreach (var n in Model.NotesList.OrderByDescending(x => x.CreatedAt))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start flex-wrap gap-2 py-2">
                            <div>
                                <div class="fw-semibold">@n.Title</div>
                                @if (n.Attachments.Any())
                                {
                                    <div class="small mt-1">
                                        <span class="text-muted">پیوست‌ها (@n.Attachments.Count):</span>
                                        @foreach (var a in n.Attachments)
                                        {
                                            <a href="@a.FilePath"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="badge bg-light text-dark border me-1 text-decoration-none">
                                                @a.FileName
                                            </a>
                                        }
                                    </div>
                                }
                                <div class="small text-secondary mt-1">@n.CreatedAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()</div>
                            </div>
                            @if (Model.IsOwner)
                            {
                                <div class="d-flex gap-1">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#leadNoteEditModal"
                                            data-note-edit-open="true"
                                            data-note-id="@n.Id"
                                            data-note-title="@n.Title"
                                            data-note-content="@n.Content">
                                        ویرایش
                                    </button>
                                    <form asp-controller="Leads" asp-action="DeleteLeadNote" method="post" class="m-0" onsubmit="return confirm('این یادداشت حذف شود؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="leadId" value="@Model.Id" />
                                        <input type="hidden" name="noteId" value="@n.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                    </form>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small @(Model.IsOwner ? "mt-3" : "mt-0") mb-0">هنوز یادداشتی برای این لید ثبت نشده است.</p>
            }
        </div>
    </div>

    <div class="card border mt-3">
        <div class="card-header fw-bold">جلسات لید</div>
        <div class="card-body">
            @if (Model.IsOwner)
            {
                <form asp-controller="Leads" asp-action="AddSession" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="leadId" value="@Model.Id" />
                    <input id="leadSessionPersianCombinedInput" name="meetingAtPersian" type="hidden" />
                    <div class="col-md-4">
                        <label class="form-label small mb-1">تاریخ جلسه (شمسی)</label>
                        <input id="leadSessionPersianInput"
                               type="text"
                               class="form-control form-control-sm"
                               placeholder="مثلاً 1405/02/15"
                               autocomplete="off"
                               required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">ساعت جلسه</label>
                        <input id="leadSessionTimeInput"
                               type="text"
                               class="form-control form-control-sm"
                               placeholder="14:30"
                               inputmode="numeric"
                               autocomplete="off"
                               maxlength="5"
                               pattern="^([01]\d|2[0-3]):([0-5]\d)$"
                               required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">توضیحات (اختیاری)</label>
                        <input name="notes" type="text" class="form-control form-control-sm" maxlength="500" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">افزودن جلسه</button>
                    </div>
                </form>
            }

            @if (Model.Sessions.Any())
            {
                <hr />
                <ul class="list-group list-group-flush border rounded">
                    @foreach (var s in Model.Sessions.OrderBy(x => x.ScheduledAt))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                            <div>
                                <div class="fw-semibold">@s.ScheduledAt.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers()</div>
                                @if (!string.IsNullOrWhiteSpace(s.Notes))
                                {
                                    <div class="small text-muted">@s.Notes</div>
                                }
                            </div>
                            @if (Model.IsOwner)
                            {
                                <div class="d-flex gap-1">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-session-edit-toggle="session-edit-@s.Id">
                                        ویرایش
                                    </button>
                                    <form asp-controller="Leads" asp-action="DeleteSession" method="post" class="m-0" onsubmit="return confirm('این جلسه حذف شود؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="leadId" value="@Model.Id" />
                                        <input type="hidden" name="sessionId" value="@s.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                    </form>
                                </div>
                            }
                        </li>
                        @if (Model.IsOwner)
                        {
                            <li class="list-group-item bg-light" id="session-edit-@s.Id" style="display: none;">
                                <form asp-controller="Leads" asp-action="UpdateSession" method="post" class="row g-2 align-items-end lead-session-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="leadId" value="@Model.Id" />
                                    <input type="hidden" name="sessionId" value="@s.Id" />
                                    <input class="lead-session-combined-input" name="meetingAtPersian" type="hidden" />
                                    <div class="col-md-4">
                                        <label class="form-label small mb-1">تاریخ جلسه (شمسی)</label>
                                        <input type="text"
                                               class="form-control form-control-sm lead-session-date-input"
                                               value="@(s.ScheduledAt.ToLocalTime().ToString("yyyy/MM/dd"))"
                                               autocomplete="off"
                                               required />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small mb-1">ساعت جلسه</label>
                                        <input type="text"
                                               class="form-control form-control-sm lead-session-time-input"
                                               value="@(s.ScheduledAt.ToLocalTime().ToString("HH:mm"))"
                                               inputmode="numeric"
                                               autocomplete="off"
                                               maxlength="5"
                                               pattern="^([01]\d|2[0-3]):([0-5]\d)$"
                                               required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small mb-1">توضیحات (اختیاری)</label>
                                        <input name="notes" type="text" class="form-control form-control-sm" maxlength="500" value="@s.Notes" />
                                    </div>
                                    <div class="col-md-2 d-flex gap-1">
                                        <button type="submit" class="btn btn-primary btn-sm w-100">ذخیره</button>
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm w-100"
                                                data-session-edit-toggle="session-edit-@s.Id">
                                            بستن
                                        </button>
                                    </div>
                                </form>
                            </li>
                        }
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small @(Model.IsOwner ? "mt-3" : "mt-0") mb-0">هنوز جلسه‌ای برای این لید ثبت نشده است.</p>
            }
        </div>
    </div>

    @if (Model.IsOwner)
    {
        <div class="card border mt-3">
            <div class="card-header fw-bold">همکاران روی لید (CRM)</div>
            <div class="card-body">
                <p class="small text-muted mb-3">از بین <strong>همکاران تأییدشده</strong> فرد را اضافه کنید، یا با <strong>شماره موبایل</strong> دعوت بفرستید (کاربر باید در سیستم ثبت‌نام کرده باشد). همکاران لید را در «لیدها» و دعوت‌ها می‌بینند.</p>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <form asp-controller="Leads" asp-action="AddLeadMember" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="leadId" value="@Model.Id" />
                            <div class="flex-grow-1" style="min-width: 200px;">
                                <label class="form-label small mb-1">افزودن از همکاران</label>
                                <select name="memberUserId" class="form-select form-select-sm" required>
                                    <option value="">— انتخاب کنید —</option>
                                    @foreach (var u in collaboratorChoices)
                                    {
                                        <option value="@u.Id">@u.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">افزودن</button>
                        </form>
                    </div>
                    <div class="col-md-6">
                        <form asp-controller="Leads" asp-action="InviteLeadByPhone" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="leadId" value="@Model.Id" />
                            <div class="flex-grow-1" style="min-width: 200px;">
                                <label class="form-label small mb-1">دعوت با شماره موبایل</label>
                                <input type="text" name="phone" class="form-control form-control-sm" placeholder="مثلاً 0912..." autocomplete="tel" required />
                            </div>
                            <button type="submit" class="btn btn-outline-primary btn-sm">ارسال دعوت</button>
                        </form>
                    </div>
                </div>

                @if (Model.Members.Any())
                {
                    <h6 class="mt-4 mb-2 text-muted small">همکاران فعلی</h6>
                    <ul class="list-group list-group-flush border rounded">
                        @foreach (var m in Model.Members)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <span>@m.DisplayName</span>
                                <form asp-controller="Leads" asp-action="RemoveLeadMember" method="post" class="m-0" onsubmit="return confirm('این همکار از لید حذف شود؟');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="leadId" value="@Model.Id" />
                                    <input type="hidden" name="memberUserId" value="@m.UserId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </li>
                        }
                    </ul>
                }

                @if (Model.PendingInvitations.Any())
                {
                    <h6 class="mt-3 mb-2 text-muted small">دعوت‌های در انتظار</h6>
                    <ul class="list-group list-group-flush border rounded">
                        @foreach (var inv in Model.PendingInvitations)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                                <span>@(inv.InviteeDisplayName ?? inv.InviteePhone)</span>
                                <form asp-controller="Leads" asp-action="CancelLeadInvite" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="invitationId" value="@inv.Id" />
                                    <input type="hidden" name="leadId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">لغو دعوت</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    @if (Model.IsOwner && Model.Status == LeadPipelineStatus.Qualified && Model.ConvertedProjectId == null)
    {
        <div class="card border-success mt-3">
            <div class="card-header bg-success text-white">تبدیل به پروژه</div>
            <div class="card-body">
                <p class="small text-muted mb-3">با تبدیل، یک پروژه جدید با اطلاعات همین لید ساخته می‌شود و این لید به‌عنوان «تبدیل‌شده» علامت می‌خورد.</p>
                <form method="post" action="/Leads/Convert">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LeadId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">نام پروژه (اختیاری)</label>
                        <input type="text" name="ProjectName" class="form-control" placeholder="@Model.Title" maxlength="200" />
                        <div class="form-text">در صورت خالی بودن از عنوان لید استفاده می‌شود.</div>
                    </div>
                    <button type="submit" class="btn btn-success"><i class="bi bi-briefcase ms-1"></i>ایجاد پروژه</button>
                </form>
            </div>
        </div>
    }
    else if (Model.Status == LeadPipelineStatus.Converted && Model.ConvertedProjectId is int convId)
    {
        <div class="alert alert-info mt-3 mb-0">
            این لید در @(Model.ConvertedAt.HasValue ? Model.ConvertedAt.Value.ToLocalTime().ToShortPersianDateTimeString().ToPersianNumbers() : "—") به <a href="/Projects/Details/@convId">پروژه شماره @convId.ToString().ToPersianNumbers()</a> تبدیل شده است.
        </div>
    }
    else if (Model.IsOwner && Model.ConvertedProjectId == null)
    {
        <div class="alert alert-light border mt-3 mb-0 small">
            برای فعال شدن دکمه تبدیل، در ویرایش لید وضعیت را به <strong>قطعیت</strong> (Qualified) تغییر دهید.
        </div>
    }
</div>

@if (Model.IsOwner)
{
    <div class="modal fade lead-note-modal" id="leadNoteModal" tabindex="-1" aria-labelledby="leadNoteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="leadNoteModalLabel">ثبت یادداشت لید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <form asp-controller="Leads" asp-action="AddLeadNote" method="post" enctype="multipart/form-data">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leadId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">عنوان</label>
                            <input name="title" class="form-control" maxlength="200" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">متن یادداشت</label>
                            <textarea id="leadNoteEditor" name="content" class="form-control" rows="8" dir="rtl"></textarea>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">پیوست فایل‌ها</label>
                            <input name="attachments" type="file" class="form-control" multiple />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">انصراف</button>
                        <button type="submit" class="btn btn-primary">ثبت یادداشت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade lead-note-modal" id="leadNoteEditModal" tabindex="-1" aria-labelledby="leadNoteEditModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="leadNoteEditModalLabel">ویرایش یادداشت لید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <form asp-controller="Leads" asp-action="UpdateLeadNote" method="post" enctype="multipart/form-data">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leadId" value="@Model.Id" />
                        <input type="hidden" id="leadNoteEditNoteId" name="noteId" />
                        <div class="mb-3">
                            <label class="form-label">عنوان</label>
                            <input id="leadNoteEditTitle" name="title" class="form-control" maxlength="200" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">متن یادداشت</label>
                            <textarea id="leadNoteEditContent" name="content" class="form-control" rows="8" dir="rtl"></textarea>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">افزودن فایل جدید</label>
                            <input name="attachments" type="file" class="form-control" multiple />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">انصراف</button>
                        <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<style>
    .EasyMDEContainer .editor-toolbar {
        border-radius: 0.375rem 0.375rem 0 0;
        border-color: #dee2e6;
    }

    .EasyMDEContainer .CodeMirror {
        border-color: #dee2e6;
        min-height: 220px;
    }

    .lead-note-modal .EasyMDEContainer .CodeMirror,
    .lead-note-modal .EasyMDEContainer .CodeMirror pre,
    .lead-note-modal .EasyMDEContainer .CodeMirror-line {
        direction: ltr;
        text-align: right;
        unicode-bidi: plaintext;
    }

    .lead-note-modal .EasyMDEContainer .CodeMirror-scroll {
        padding-top: 0.5rem;
    }

    /* Fallback icons when Font Awesome webfont is unavailable */
    .EasyMDEContainer .editor-toolbar i.fa::before {
        font-family: inherit !important;
        font-style: normal;
        font-weight: 700;
        display: inline-block;
        line-height: 1;
    }

    .EasyMDEContainer .editor-toolbar .fa-bold::before { content: "B"; }
    .EasyMDEContainer .editor-toolbar .fa-italic::before { content: "I"; font-style: italic; }
    .EasyMDEContainer .editor-toolbar .fa-header::before { content: "H"; }
    .EasyMDEContainer .editor-toolbar .fa-quote-left::before { content: "\201C"; }
    .EasyMDEContainer .editor-toolbar .fa-list-ul::before { content: "\2022"; }
    .EasyMDEContainer .editor-toolbar .fa-list-ol::before { content: "1."; font-size: 0.8em; }
    .EasyMDEContainer .editor-toolbar .fa-question-circle::before { content: "?"; }
</style>

@section Scripts {
    @await Html.PartialAsync("_DatePickerAssets")
    <script src="~/lib/easymde/dist/easymde.min.js"></script>
    <script>
        (function () {
            const toLatinDigits = function (value) {
                return value
                    .replace(/[۰-۹]/g, function (d) { return String.fromCharCode(d.charCodeAt(0) - 1728); })
                    .replace(/[٠-٩]/g, function (d) { return String.fromCharCode(d.charCodeAt(0) - 1584); });
            };

            const normalizeTime = function (value) {
                return toLatinDigits(value.trim())
                    .replace(/[٫،]/g, ':')
                    .replace(/\s+/g, '');
            };

            const timePattern = /^([01]\d|2[0-3]):([0-5]\d)$/;

            const bindSessionForm = function (form) {
                const dateInput = form.querySelector('.lead-session-date-input') || form.querySelector('#leadSessionPersianInput');
                const timeInput = form.querySelector('.lead-session-time-input') || form.querySelector('#leadSessionTimeInput');
                const combinedInput = form.querySelector('.lead-session-combined-input') || form.querySelector('#leadSessionPersianCombinedInput');
                if (!(dateInput && timeInput && combinedInput)) return;

                form.addEventListener('submit', function (event) {
                    const dateValue = toLatinDigits(dateInput.value.trim()).replace(/-/g, '/');
                    const normalizedTime = normalizeTime(timeInput.value);

                    if (!dateValue) {
                        dateInput.setCustomValidity('تاریخ جلسه را وارد کنید.');
                        dateInput.reportValidity();
                        event.preventDefault();
                        return;
                    }
                    dateInput.setCustomValidity('');

                    if (!timePattern.test(normalizedTime)) {
                        timeInput.setCustomValidity('ساعت را با فرمت 23:59 تا 00:00 وارد کنید.');
                        timeInput.reportValidity();
                        event.preventDefault();
                        return;
                    }
                    timeInput.setCustomValidity('');
                    timeInput.value = normalizedTime;
                    combinedInput.value = dateValue + ' ' + normalizedTime;
                });
            };

            if (window.$ && $.fn.persianDatepicker) {
                $('#leadSessionPersianInput').persianDatepicker({
                    format: 'YYYY/MM/DD',
                    autoClose: true,
                    calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' } }
                });
                $('.lead-session-date-input').persianDatepicker({
                    format: 'YYYY/MM/DD',
                    autoClose: true,
                    calendar: { persian: { locale: 'fa', leapYearMode: 'astronomical' } }
                });
            }

            document.querySelectorAll('form.lead-session-form, form[action*="/Leads/AddSession"]').forEach(bindSessionForm);
        })();

        (function () {
            document.querySelectorAll('[data-session-edit-toggle]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const targetId = button.getAttribute('data-session-edit-toggle');
                    const target = targetId ? document.getElementById(targetId) : null;
                    if (!target) return;
                    target.style.display = target.style.display === 'none' ? '' : 'none';
                });
            });
        })();

        (function () {
            let leadNoteEditor;
            const modalElement = document.getElementById('leadNoteModal');
            if (!modalElement || !window.EasyMDE) return;

            modalElement.addEventListener('shown.bs.modal', function () {
                const textarea = document.getElementById('leadNoteEditor');
                if (!textarea) return;

                if (!leadNoteEditor) {
                    leadNoteEditor = new EasyMDE({
                        element: textarea,
                        spellChecker: false,
                        status: false,
                        direction: 'ltr',
                        toolbar: [
                            'bold',
                            'italic',
                            'heading',
                            '|',
                            'quote',
                            'unordered-list',
                            'ordered-list',
                            '|',
                            'guide'
                        ]
                    });
                }

                // CodeMirror inside modal needs refresh after modal transition.
                setTimeout(function () {
                    leadNoteEditor.codemirror.refresh();
                }, 50);
            });
        })();

        (function () {
            const editModalElement = document.getElementById('leadNoteEditModal');
            if (!editModalElement || !window.EasyMDE) return;
            const noteIdInput = document.getElementById('leadNoteEditNoteId');
            const titleInput = document.getElementById('leadNoteEditTitle');
            const contentInput = document.getElementById('leadNoteEditContent');
            if (!(noteIdInput && titleInput && contentInput)) return;
            let leadNoteEditEditor;

            const getEditorValue = function () {
                if (!leadNoteEditEditor) return contentInput.value || '';
                return leadNoteEditEditor.value();
            };

            document.querySelectorAll('[data-note-edit-open]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const noteId = button.getAttribute('data-note-id') || '';
                    const title = button.getAttribute('data-note-title') || '';
                    const content = button.getAttribute('data-note-content') || '';
                    noteIdInput.value = noteId;
                    titleInput.value = title;
                    if (leadNoteEditEditor) {
                        leadNoteEditEditor.value(content);
                    } else {
                        contentInput.value = content;
                    }
                });
            });

            editModalElement.addEventListener('shown.bs.modal', function () {
                if (!leadNoteEditEditor) {
                    leadNoteEditEditor = new EasyMDE({
                        element: contentInput,
                        spellChecker: false,
                        status: false,
                        direction: 'ltr',
                        toolbar: [
                            'bold',
                            'italic',
                            'heading',
                            '|',
                            'quote',
                            'unordered-list',
                            'ordered-list',
                            '|',
                            'guide'
                        ]
                    });
                }

                setTimeout(function () {
                    leadNoteEditEditor.codemirror.refresh();
                }, 50);
            });

            const editForm = editModalElement.querySelector('form');
            if (editForm) {
                editForm.addEventListener('submit', function () {
                    contentInput.value = getEditorValue();
                });
            }
        })();
    </script>
}
