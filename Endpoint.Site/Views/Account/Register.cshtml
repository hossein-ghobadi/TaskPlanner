@model Endpoint.Site.Models.RegisterViewModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "ثبت نام";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-5">
                <h2 class="card-title text-center mb-4">ثبت نام</h2>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
                    </div>
                }

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger mb-3 validation-summary" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">نام کامل</label>
                        <input asp-for="FullName" class="form-control" placeholder="نام و نام خانوادگی خود را وارد کنید" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">ایمیل</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">شماره تلفن</label>
                        <input asp-for="Phone" type="tel" class="form-control" placeholder="09123456789" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">رمز عبور</label>
                        <input asp-for="Password" class="form-control" placeholder="حداقل 6 کاراکتر" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">تکرار رمز عبور</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="رمز عبور را مجدد وارد کنید" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">ثبت نام</button>
                    
                    <div class="text-center">
                        <p class="mb-0">
                            قبلاً ثبت نام کرده‌اید؟
                            <a asp-action="Login" class="text-decoration-none">ورود</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    body {
        background: #f8f9fa;
    }
    
    .card {
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.1);
        background: #fff;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }
    
    .card-body {
        background: #fff;
        border-radius: 16px;
        color: #212529;
    }
    
    .card-title {
        font-weight: 700;
        color: #000;
        letter-spacing: -0.5px;
        margin-bottom: 2rem;
    }
    
    .form-label {
        color: #212529;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
        letter-spacing: 0.2px;
    }
    
    .form-control {
        border-radius: 10px;
        border: 1.5px solid #dee2e6;
        background: #fff;
        color: #212529;
        padding: 10px 16px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }
    
    .form-control:focus {
        background: #fff;
        border-color: #000;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
        color: #000;
        outline: none;
    }
    
    .form-control::placeholder {
        color: #adb5bd;
        font-size: 0.9rem;
    }
    
    .btn-primary {
        background: #000;
        color: #fff;
        border: 2px solid #000;
        font-weight: 600;
        border-radius: 10px;
        padding: 12px 24px;
        font-size: 1rem;
        transition: all 0.3s ease;
        letter-spacing: 0.3px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }
    
    .btn-primary:hover {
        background: #212529;
        color: #fff;
        border-color: #212529;
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    }
    
    .btn-primary:active {
        transform: translateY(0);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }
    
    .text-danger {
        color: #dc3545 !important;
        font-size: 0.85rem;
        font-weight: 500;
        margin-top: 0.25rem;
    }
    
    .alert-danger {
        background-color: #fff5f5 !important;
        border: 1.5px solid #feb2b2 !important;
        color: #c53030 !important;
        font-weight: 500;
        padding: 14px 16px;
        border-radius: 10px;
        font-size: 0.9rem;
    }
    
    /* مخفی کردن کادر validation summary وقتی خالی است */
    .validation-summary-valid,
    .validation-summary:empty {
        display: none !important;
    }
    
    .alert-danger i {
        margin-left: 6px;
    }
    
    .alert-danger ul {
        margin-bottom: 0;
        padding-right: 24px;
        margin-top: 0.5rem;
    }
    
    .alert-danger li {
        margin: 4px 0;
        color: #c53030;
        font-size: 0.9rem;
    }
    
    a {
        color: #000;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    
    a:hover {
        color: #495057;
        text-decoration: underline;
    }
    
    /* بهبود فاصله‌گذاری */
    .mb-3:last-of-type {
        margin-bottom: 1.5rem !important;
    }
    
    /* انیمیشن ظریف برای ورودی‌ها */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .card-body > * {
        animation: fadeIn 0.4s ease-out;
    }
    
    .card-body > *:nth-child(1) { animation-delay: 0.05s; }
    .card-body > *:nth-child(2) { animation-delay: 0.1s; }
    .card-body > *:nth-child(3) { animation-delay: 0.15s; }
    .card-body > *:nth-child(4) { animation-delay: 0.2s; }
    .card-body > *:nth-child(5) { animation-delay: 0.25s; }
    .card-body > *:nth-child(6) { animation-delay: 0.3s; }
    .card-body > *:nth-child(7) { animation-delay: 0.35s; }
    .card-body > *:nth-child(8) { animation-delay: 0.4s; }
</style>
