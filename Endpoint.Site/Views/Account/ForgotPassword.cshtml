@model Endpoint.Site.Models.ForgotPasswordViewModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "بازیابی رمز عبور";
}

<div class="auth-shell">
    <div class="auth-card">
        <section class="auth-brand-panel">
            <div class="brand-chip">
                <i class="bi bi-shield-lock"></i>
                Task Planner
            </div>
            <h1 class="auth-title">رمز عبور را بازیابی کن</h1>
            <p class="auth-subtitle">
                شماره موبایل ثبت‌شده را وارد کن تا کد تأیید برایت ارسال شود و بتوانی رمز عبور جدید تنظیم کنی.
            </p>
        </section>

        <section class="auth-form-panel">
            <h2 class="form-title">فراموشی رمز عبور</h2>
            <p class="form-subtitle">کد پیامکی و رمز عبور جدید را وارد کنید</p>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger mb-3 validation-summary" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label">شماره تلفن</label>
                    <input asp-for="Phone" type="tel" id="forgotPhone" class="form-control" placeholder="09123456789" maxlength="11" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SmsCode" class="form-label">کد تأیید پیامک</label>
                    <div class="sms-code-row">
                        <input asp-for="SmsCode" id="forgotSmsCode" class="form-control" placeholder="کد ارسال‌شده را وارد کنید" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
                        <button type="button" class="btn btn-sms-send" id="sendForgotSmsBtn">ارسال کد</button>
                    </div>
                    <div id="forgotSmsStatus" class="sms-status" aria-live="polite"></div>
                    <span asp-validation-for="SmsCode" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">رمز عبور جدید</label>
                    <div class="password-field-wrap">
                        <input asp-for="NewPassword" id="forgotPassword" class="form-control password-field-input" placeholder="حداقل 8 کاراکتر شامل حروف بزرگ، حروف کوچک و عدد" autocomplete="new-password" />
                        <button type="button" class="password-toggle-btn" data-target="forgotPassword" aria-label="نمایش رمز عبور" aria-pressed="false" title="نمایش رمز عبور">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">تکرار رمز عبور</label>
                    <div class="password-field-wrap">
                        <input asp-for="ConfirmPassword" id="forgotConfirmPassword" class="form-control password-field-input" placeholder="رمز عبور را مجدد وارد کنید" autocomplete="new-password" />
                        <button type="button" class="password-toggle-btn" data-target="forgotConfirmPassword" aria-label="نمایش رمز عبور" aria-pressed="false" title="نمایش رمز عبور">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-login-submit w-100 mb-3">تغییر رمز عبور</button>

                <p class="auth-switch-text mb-0 text-center">
                    رمز عبور را به خاطر آوردید؟
                    <a asp-action="Login">ورود</a>
                </p>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var buttons = document.querySelectorAll('.password-toggle-btn[data-target]');
            buttons.forEach(function (btn) {
                var targetId = btn.getAttribute('data-target');
                var input = targetId ? document.getElementById(targetId) : null;
                if (!input) return;
                var icon = btn.querySelector('i');
                btn.addEventListener('click', function () {
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                    if (icon) {
                        icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                    }
                });
            });
        })();
    </script>
    <script>
        (function () {
            var phoneInput = document.getElementById('forgotPhone');
            var sendBtn = document.getElementById('sendForgotSmsBtn');
            var statusEl = document.getElementById('forgotSmsStatus');
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!phoneInput || !sendBtn || !statusEl) return;

            var cooldownSeconds = 0;
            var cooldownTimer = null;

            function setStatus(message, isError) {
                statusEl.textContent = message || '';
                statusEl.className = 'sms-status' + (message ? (isError ? ' is-error' : ' is-success') : '');
            }

            function updateButtonLabel() {
                if (cooldownSeconds > 0) {
                    sendBtn.disabled = true;
                    sendBtn.textContent = 'ارسال مجدد (' + cooldownSeconds + ')';
                } else {
                    sendBtn.disabled = false;
                    sendBtn.textContent = 'ارسال کد';
                }
            }

            function startCooldown(seconds) {
                cooldownSeconds = seconds;
                updateButtonLabel();
                cooldownTimer = setInterval(function () {
                    cooldownSeconds -= 1;
                    if (cooldownSeconds <= 0) {
                        clearInterval(cooldownTimer);
                        cooldownTimer = null;
                        cooldownSeconds = 0;
                    }
                    updateButtonLabel();
                }, 1000);
            }

            sendBtn.addEventListener('click', function () {
                var phone = (phoneInput.value || '').replace(/\D/g, '');
                if (!/^09\d{9}$/.test(phone)) {
                    setStatus('شماره موبایل باید 11 رقم و با 09 شروع شود', true);
                    return;
                }

                sendBtn.disabled = true;
                setStatus('در حال ارسال کد...', false);

                fetch('@Url.Action("SendForgotPasswordSms", "Account")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenInput ? tokenInput.value : ''
                    },
                    body: JSON.stringify({ phone: phone })
                })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        setStatus(data.message || '', !data.success);
                        if (data.success) {
                            startCooldown(60);
                        } else {
                            sendBtn.disabled = false;
                        }
                    })
                    .catch(function () {
                        setStatus('خطا در ارسال پیامک. دوباره تلاش کنید.', true);
                        sendBtn.disabled = false;
                    });
            });
        })();
    </script>
}

<style>
    body {
        min-height: 100vh;
        background: radial-gradient(circle at 12% 20%, rgba(99, 102, 241, 0.1), transparent 44%),
                    radial-gradient(circle at 88% 82%, rgba(30, 64, 175, 0.08), transparent 40%),
                    #f7f7f5;
    }

    .auth-shell {
        min-height: calc(100vh - 6.5rem);
        display: grid;
        place-items: center;
        padding: 1.4rem 0 1.8rem;
    }

    .auth-card {
        width: min(1100px, 96vw);
        min-height: clamp(470px, 68vh, 620px);
        border-radius: 24px;
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(226, 232, 240, 0.95);
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.12);
        display: grid;
        grid-template-columns: minmax(320px, 1.05fr) minmax(380px, 1.25fr);
    }

    .auth-brand-panel {
        background: linear-gradient(160deg, #1f2937 0%, #1e3a8a 58%, #3730a3 100%);
        color: #eef2ff;
        padding: 2.45rem 2.15rem;
        position: relative;
        isolation: isolate;
    }

    .auth-brand-panel::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 20% 15%, rgba(255,255,255,0.25), transparent 42%);
        z-index: -1;
    }

    .brand-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.85rem;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        font-size: 0.86rem;
        margin-bottom: 1.25rem;
    }

    .auth-title {
        font-size: 1.9rem;
        font-weight: 800;
        margin: 0 0 0.8rem;
        letter-spacing: -0.3px;
    }

    .auth-subtitle {
        color: rgba(238, 242, 255, 0.92);
        margin-bottom: 1.8rem;
        line-height: 1.95;
        font-size: 0.95rem;
    }

    .auth-form-panel {
        padding: 2.55rem 2.15rem;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .form-title {
        color: #0f172a;
        font-size: 1.55rem;
        font-weight: 800;
        margin-bottom: 0.35rem;
    }

    .form-subtitle {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 1.6rem;
    }

    .form-label {
        color: #1e293b;
        font-weight: 600;
        font-size: 0.88rem;
        margin-bottom: 0.45rem;
    }

    .form-control {
        border-radius: 12px;
        border: 1.6px solid #dbe3ef;
        background: #fff;
        color: #0f172a;
        padding: 11px 14px;
        font-size: 0.95rem;
        transition: border-color 0.22s ease, box-shadow 0.22s ease;
    }

    .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
        outline: none;
    }

    .password-field-wrap {
        position: relative;
    }

    .password-field-wrap .password-field-input {
        padding-inline-end: 2.75rem;
    }

    .password-toggle-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        inset-inline-end: 0.35rem;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .btn-login-submit {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: #fff;
        border: none;
        font-weight: 700;
        border-radius: 12px;
        padding: 12px 20px;
        font-size: 0.96rem;
        box-shadow: 0 10px 22px rgba(79, 70, 229, 0.28);
    }

    .sms-code-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.6rem;
        align-items: stretch;
    }

    .btn-sms-send {
        border: 1.5px solid #c7d2fe;
        background: #eef2ff;
        color: #4338ca;
        font-weight: 700;
        border-radius: 12px;
        padding: 0 1rem;
        white-space: nowrap;
        min-width: 6.5rem;
    }

    .btn-sms-send:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }

    .sms-status {
        margin-top: 0.45rem;
        font-size: 0.84rem;
        font-weight: 600;
        min-height: 1.2rem;
    }

    .sms-status.is-success { color: #047857; }
    .sms-status.is-error { color: #be123c; }

    .text-danger {
        color: #dc3545 !important;
        font-size: 0.85rem;
        font-weight: 600;
        margin-top: 0.25rem;
    }

    .alert-danger {
        background-color: #fff1f2 !important;
        border: 1px solid #fecdd3 !important;
        color: #be123c !important;
        font-weight: 600;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: 0.88rem;
    }

    .validation-summary-valid,
    .validation-summary:empty {
        display: none !important;
    }

    .auth-switch-text {
        color: #64748b;
        font-size: 0.9rem;
    }

    .auth-switch-text a {
        color: #6366f1;
        font-weight: 600;
        text-decoration: none;
    }

    @@media (max-width: 991.98px) {
        .auth-card {
            grid-template-columns: 1fr;
            min-height: 0;
            width: min(760px, 100%);
        }

        .auth-brand-panel,
        .auth-form-panel {
            padding: 1.45rem 1.2rem;
        }
    }
</style>
