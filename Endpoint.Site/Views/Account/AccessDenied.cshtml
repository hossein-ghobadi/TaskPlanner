@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "دسترسی غیرمجاز";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">
                <div class="mb-4">
                    <i class="bi bi-shield-exclamation" style="font-size: 4rem; color: #f44336;"></i>
                </div>
                <h2 class="card-title mb-3">دسترسی غیرمجاز</h2>
                <p class="text-muted mb-4">
                    متأسفانه شما دسترسی لازم برای مشاهده این صفحه را ندارید.
                </p>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-primary">بازگشت به صفحه اصلی</a>
                    @if (User?.Identity?.IsAuthenticated == false)
                    {
                        <a asp-action="Login" asp-controller="Account" class="btn btn-outline-primary">ورود به سیستم</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
        border: none;
    }
    
    .bi-shield-exclamation {
        display: block;
        margin: 0 auto;
    }
</style>
