@model Endpoint.Site.Models.LoginViewModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "ورود به سیستم";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-5">
                <h2 class="card-title text-center mb-4">ورود به سیستم</h2>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
                    </div>
                }

                <form asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    
                    <div asp-validation-summary="All" class="alert alert-danger mb-3 validation-summary" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">ایمیل، نام کاربری یا شماره تلفن</label>
                        <input asp-for="UserName" class="form-control" placeholder="ایمیل، نام کاربری یا شماره تلفن خود را وارد کنید" autofocus />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">رمز عبور</label>
                        <div class="password-field-wrap">
                            <input asp-for="Password" id="loginPassword" class="form-control password-field-input" placeholder="رمز عبور خود را وارد کنید" autocomplete="current-password" />
                            <button type="button" class="password-toggle-btn" id="loginPasswordToggle" aria-label="نمایش رمز عبور" aria-pressed="false" title="نمایش رمز عبور">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label">
                            مرا به خاطر بسپار
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">ورود</button>
                    
                    <div class="text-center">
                        <p class="mb-0">
                            حساب کاربری ندارید؟
                            <a asp-action="Register" class="text-decoration-none">ثبت نام کنید</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.getElementById('loginPassword');
            var btn = document.getElementById('loginPasswordToggle');
            if (!input || !btn) return;
            var icon = btn.querySelector('i');
            btn.addEventListener('click', function () {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                btn.setAttribute('aria-label', show ? 'مخفی کردن رمز عبور' : 'نمایش رمز عبور');
                btn.setAttribute('title', show ? 'مخفی کردن رمز عبور' : 'نمایش رمز عبور');
                if (icon) {
                    icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                }
            });
        })();
    </script>
}

<style>
    body {
        background: #f8f9fa;
    }
    
    .card {
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.1);
        background: #fff;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }
    
    .card-body {
        background: #fff;
        border-radius: 16px;
        color: #212529;
    }
    
    .card-title {
        font-weight: 700;
        color: #1f2937;
        letter-spacing: -0.5px;
        margin-bottom: 2rem;
    }
    
    .form-label {
        color: #212529;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
        letter-spacing: 0.2px;
    }
    
    .form-control {
        border-radius: 10px;
        border: 1.5px solid #dee2e6;
        background: #fff;
        color: #212529;
        padding: 10px 16px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }
    
    .form-control:focus {
        background: #fff;
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        color: #1f2937;
        outline: none;
    }
    
    .form-control::placeholder {
        color: #adb5bd;
        font-size: 0.9rem;
    }

    .password-field-wrap {
        position: relative;
    }

    .password-field-wrap .password-field-input {
        padding-inline-end: 2.75rem;
    }

    .password-toggle-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        inset-inline-end: 0.35rem;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #6c757d;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: color 0.2s ease, background 0.2s ease;
    }

    .password-toggle-btn:hover {
        color: #495057;
        background: rgba(0, 0, 0, 0.05);
    }

    .password-toggle-btn:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
        color: #4f46e5;
    }
    
    .form-check-input {
        border: 1.5px solid #adb5bd;
        width: 1.1rem;
        height: 1.1rem;
        margin-top: 0.25rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    
    .form-check-input:checked {
        background-color: #6366f1;
        border-color: #6366f1;
    }
    
    .form-check-input:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }
    
    .form-check-label {
        color: #495057;
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
        user-select: none;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: #fff;
        border: 2px solid #6366f1;
        font-weight: 600;
        border-radius: 10px;
        padding: 12px 24px;
        font-size: 1rem;
        transition: all 0.3s ease;
        letter-spacing: 0.3px;
        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.25);
    }
    
    .btn-primary:hover {
        background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        color: #fff;
        border-color: #4f46e5;
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
    }
    
    .btn-primary:active {
        transform: translateY(0);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }
    
    .text-danger {
        color: #dc3545 !important;
        font-size: 0.85rem;
        font-weight: 500;
        margin-top: 0.25rem;
    }
    
    .alert-danger {
        background-color: #fff5f5 !important;
        border: 1.5px solid #feb2b2 !important;
        color: #c53030 !important;
        font-weight: 500;
        padding: 14px 16px;
        border-radius: 10px;
        font-size: 0.9rem;
    }
    
    /* مخفی کردن کادر validation summary وقتی خالی است */
    .validation-summary-valid,
    .validation-summary:empty {
        display: none !important;
    }
    
    .alert-danger i {
        margin-left: 6px;
    }
    
    .alert-danger ul {
        margin-bottom: 0;
        padding-right: 24px;
        margin-top: 0.5rem;
    }
    
    .alert-danger li {
        margin: 4px 0;
        color: #c53030;
        font-size: 0.9rem;
    }
    
    a {
        color: #6366f1;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    
    a:hover {
        color: #4f46e5;
        text-decoration: underline;
    }
    
    .form-check {
        padding-right: 1.5rem;
    }
    
    /* بهبود فاصله‌گذاری */
    .mb-3:last-of-type {
        margin-bottom: 1.5rem !important;
    }
    
    /* انیمیشن ظریف برای ورودی‌ها */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .card-body > * {
        animation: fadeIn 0.4s ease-out;
    }
    
    .card-body > *:nth-child(1) { animation-delay: 0.05s; }
    .card-body > *:nth-child(2) { animation-delay: 0.1s; }
    .card-body > *:nth-child(3) { animation-delay: 0.15s; }
    .card-body > *:nth-child(4) { animation-delay: 0.2s; }
    .card-body > *:nth-child(5) { animation-delay: 0.25s; }
    .card-body > *:nth-child(6) { animation-delay: 0.3s; }
</style>
