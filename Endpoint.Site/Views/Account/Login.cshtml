@model Endpoint.Site.Models.LoginViewModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "ورود به سیستم";
}

<div class="auth-shell">
    <div class="auth-card">
        <section class="auth-brand-panel">
            <div class="brand-chip">
                <i class="bi bi-kanban"></i>
                مدیریت پروژه
            </div>
            <h1 class="auth-title">خوش اومدی </h1>
            <p class="auth-subtitle">
                برای ادامه مدیریت تسک‌ها، گزارش‌گیری پیشرفت و همکاری تیمی وارد حساب کاربری‌ات شو.
            </p>
            <div class="auth-features">
                <div class="feature-item">
                    <i class="bi bi-check2-circle"></i>
                    <span>پیگیری شفاف وضعیت پروژه‌ها</span>
                </div>
                <div class="feature-item">
                    <i class="bi bi-check2-circle"></i>
                    <span>مدیریت وظایف تیم در یک داشبورد واحد</span>
                </div>
                <div class="feature-item">
                    <i class="bi bi-check2-circle"></i>
                    <span>دسترسی سریع به بردها و اسپرینت‌ها</span>
                </div>
            </div>
        </section>

        <section class="auth-form-panel">
            <h2 class="form-title">ورود به سیستم</h2>
            <p class="form-subtitle">لطفا اطلاعات ورود خود را وارد کنید</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
                </div>
            }

            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="All" class="alert alert-danger mb-3 validation-summary" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">ایمیل، نام کاربری یا شماره تلفن</label>
                    <input asp-for="UserName" class="form-control" placeholder="ایمیل، نام کاربری یا شماره تلفن خود را وارد کنید" autofocus />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">رمز عبور</label>
                    <div class="password-field-wrap">
                        <input asp-for="Password" id="loginPassword" class="form-control password-field-input" placeholder="رمز عبور خود را وارد کنید" autocomplete="current-password" />
                        <button type="button" class="password-toggle-btn" id="loginPasswordToggle" aria-label="نمایش رمز عبور" aria-pressed="false" title="نمایش رمز عبور">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                    <label asp-for="RememberMe" class="form-check-label">مرا به خاطر بسپار</label>
                </div>

                <button type="submit" class="btn btn-login-submit w-100 mb-3">ورود</button>

                <p class="auth-switch-text mb-0 text-center">
                    حساب کاربری ندارید؟
                    <a asp-action="Register">ثبت نام کنید</a>
                </p>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.getElementById('loginPassword');
            var btn = document.getElementById('loginPasswordToggle');
            if (!input || !btn) return;
            var icon = btn.querySelector('i');
            btn.addEventListener('click', function () {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                btn.setAttribute('aria-label', show ? 'مخفی کردن رمز عبور' : 'نمایش رمز عبور');
                btn.setAttribute('title', show ? 'مخفی کردن رمز عبور' : 'نمایش رمز عبور');
                if (icon) {
                    icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                }
            });
        })();
    </script>
}

<style>
    body {
        min-height: 100vh;
        background: radial-gradient(circle at 12% 20%, rgba(99, 102, 241, 0.1), transparent 44%),
                    radial-gradient(circle at 88% 82%, rgba(30, 64, 175, 0.08), transparent 40%),
                    #f7f7f5;
    }

    .auth-shell {
        min-height: calc(100vh - 6.5rem);
        display: grid;
        place-items: center;
        padding: 1.4rem 0 1.8rem;
    }

    .auth-card {
        width: min(1100px, 96vw);
        min-height: clamp(470px, 68vh, 620px);
        border-radius: 24px;
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(226, 232, 240, 0.95);
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.12);
        display: grid;
        grid-template-columns: minmax(320px, 1.05fr) minmax(380px, 1.25fr);
    }

    .auth-brand-panel {
        background: linear-gradient(160deg, #1f2937 0%, #1e3a8a 58%, #3730a3 100%);
        color: #eef2ff;
        padding: 2.45rem 2.15rem;
        position: relative;
        isolation: isolate;
    }

    .auth-brand-panel::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 20% 15%, rgba(255,255,255,0.28), transparent 42%);
        z-index: -1;
    }

    .brand-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.85rem;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        font-size: 0.86rem;
        margin-bottom: 1.25rem;
    }

    .auth-title {
        font-size: 1.9rem;
        font-weight: 800;
        margin: 0 0 0.8rem;
        letter-spacing: -0.3px;
    }

    .auth-subtitle {
        color: rgba(238, 242, 255, 0.92);
        margin-bottom: 1.8rem;
        line-height: 1.95;
        font-size: 0.95rem;
    }

    .auth-features {
        display: grid;
        gap: 0.8rem;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.92rem;
        color: #e0e7ff;
    }

    .feature-item i {
        color: #bfdbfe;
        font-size: 1rem;
    }

    .auth-form-panel {
        padding: 2.55rem 2.15rem;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .form-title {
        color: #0f172a;
        font-size: 1.55rem;
        font-weight: 800;
        margin-bottom: 0.35rem;
    }

    .form-subtitle {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 1.6rem;
    }

    .form-label {
        color: #1e293b;
        font-weight: 600;
        font-size: 0.88rem;
        margin-bottom: 0.45rem;
    }

    .form-control {
        border-radius: 12px;
        border: 1.6px solid #dbe3ef;
        background: #fff;
        color: #0f172a;
        padding: 11px 14px;
        font-size: 0.95rem;
        transition: border-color 0.22s ease, box-shadow 0.22s ease;
    }

    .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
        outline: none;
    }

    .form-control::placeholder {
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .password-field-wrap {
        position: relative;
    }

    .password-field-wrap .password-field-input {
        padding-inline-end: 2.75rem;
    }

    .password-toggle-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        inset-inline-end: 0.35rem;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: color 0.2s ease, background-color 0.2s ease;
    }

    .password-toggle-btn:hover {
        color: #334155;
        background-color: #f1f5f9;
    }

    .password-toggle-btn:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.28);
        color: #4f46e5;
    }

    .form-check-input {
        border: 1.5px solid #94a3b8;
        width: 1.05rem;
        height: 1.05rem;
        margin-top: 0.25rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .form-check-input:checked {
        background-color: #6366f1;
        border-color: #6366f1;
    }

    .form-check-input:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.16);
    }

    .form-check-label {
        color: #475569;
        font-weight: 500;
        font-size: 0.88rem;
        cursor: pointer;
        user-select: none;
    }

    .btn-login-submit {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: #fff;
        border: none;
        font-weight: 700;
        border-radius: 12px;
        padding: 12px 20px;
        font-size: 0.96rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 10px 22px rgba(79, 70, 229, 0.28);
    }

    .btn-login-submit:hover {
        background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 14px 28px rgba(67, 56, 202, 0.35);
    }

    .btn-login-submit:active {
        transform: translateY(0);
        box-shadow: 0 8px 18px rgba(67, 56, 202, 0.28);
    }

    .text-danger {
        color: #dc3545 !important;
        font-size: 0.85rem;
        font-weight: 600;
        margin-top: 0.25rem;
    }

    .alert-danger {
        background-color: #fff1f2 !important;
        border: 1px solid #fecdd3 !important;
        color: #be123c !important;
        font-weight: 600;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: 0.88rem;
    }

    .validation-summary-valid,
    .validation-summary:empty {
        display: none !important;
    }

    .alert-danger i {
        margin-left: 4px;
    }

    .alert-danger ul {
        margin-bottom: 0;
        padding-right: 1.15rem;
        margin-top: 0.35rem;
    }

    .alert-danger li {
        margin: 0.2rem 0;
        color: #be123c;
        font-size: 0.87rem;
    }

    .auth-switch-text {
        color: #64748b;
        font-size: 0.9rem;
    }

    .auth-switch-text a {
        color: #6366f1;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .auth-switch-text a:hover {
        color: #4f46e5;
        text-decoration: underline;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .auth-form-panel > * {
        animation: fadeIn 0.38s ease-out;
    }

    @@media (max-width: 991.98px) {
        .auth-shell {
            min-height: auto;
            padding-top: 1rem;
        }

        .auth-card {
            grid-template-columns: 1fr;
            border-radius: 18px;
            min-height: 0;
            width: min(760px, 100%);
        }

        .auth-brand-panel,
        .auth-form-panel {
            padding: 1.45rem 1.2rem;
        }

        .auth-title {
            font-size: 1.5rem;
        }
    }

    @@media (max-width: 575.98px) {
        .auth-card {
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.1);
        }
    }
</style>
