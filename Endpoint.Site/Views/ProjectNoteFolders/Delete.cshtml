@model ProjectNoteFolder
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "حذف پوشه";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        حذف پوشه
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-info-circle-fill"></i>
                        <strong>هشدار:</strong> آیا مطمئن هستید که می‌خواهید این پوشه را حذف کنید؟
                    </div>

                    <div class="mb-4">
                        <h5>
                            <i class="bi bi-folder-fill" style="color: @(Model.Color ?? "#3b82f6");"></i>
                            @Model.Name
                        </h5>
                        <hr />
                        <dl class="row">
                            <dt class="col-sm-4">پروژه:</dt>
                            <dd class="col-sm-8">@Model.Project?.Name</dd>

                            <dt class="col-sm-4">تاریخ ایجاد:</dt>
                            <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>

                            @if (Model.Children.Any())
                            {
                                <dt class="col-sm-4">پوشه‌های زیرمجموعه:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-warning text-dark">
                                        @Model.Children.Count پوشه
                                    </span>
                                    <small class="text-warning d-block mt-1">
                                        <i class="bi bi-info-circle"></i>
                                        این پوشه و تمام زیرپوشه‌هایش حذف خواهند شد.
                                    </small>
                                </dd>
                            }

                            @if (Model.Notes.Any())
                            {
                                <dt class="col-sm-4">یادداشت‌های موجود:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-info">
                                        @Model.Notes.Count یادداشت
                                    </span>
                                    <small class="text-success d-block mt-1">
                                        <i class="bi bi-check-circle"></i>
                                        یادداشت‌های موجود در این پوشه و زیرپوشه‌ها حذف نمی‌شوند و بدون پوشه می‌مانند.
                                    </small>
                                </dd>
                            }
                            else if (Model.Children.Any())
                            {
                                <dt class="col-sm-4">یادداشت‌های موجود:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-secondary">
                                        0 یادداشت در این پوشه
                                    </span>
                                    <small class="text-muted d-block mt-1">
                                        یادداشت‌های موجود در زیرپوشه‌ها نیز بدون پوشه می‌مانند.
                                    </small>
                                </dd>
                            }
                        </dl>
                    </div>

                    @if (Model.Children.Any())
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle-fill"></i>
                            <strong>توجه:</strong> با حذف این پوشه، <strong>@Model.Children.Count پوشه زیرمجموعه</strong> نیز حذف خواهند شد. 
                            یادداشت‌های موجود در این پوشه‌ها حذف نمی‌شوند و بدون پوشه می‌مانند.
                        </div>
                    }

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-controller="ProjectNotes" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary">
                                <i class="bi bi-arrow-right"></i>
                                انصراف
                            </a>
                            <button type="submit" class="btn btn-danger" onclick="return confirm('آیا مطمئن هستید که می‌خواهید این پوشه@(Model.Children.Any() ? " و تمام زیرپوشه‌هایش" : "") را حذف کنید؟\n\nیادداشت‌ها حذف نمی‌شوند و بدون پوشه می‌مانند.');">
                                <i class="bi bi-trash"></i>
                                حذف پوشه@(Model.Children.Any() ? " و زیرپوشه‌ها" : "")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

