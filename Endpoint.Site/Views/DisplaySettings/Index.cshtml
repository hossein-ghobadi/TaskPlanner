@model Endpoint.Site.Models.DisplaySettingsVm
@{
    ViewData["Title"] = "تنظیمات نمایش";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0" style="max-width: 720px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-eye me-2"></i>
                تنظیمات نمایش
            </h2>
            <p class="text-muted mb-0">مشخص کنید کدام بخش‌ها برای شما نمایش داده شوند.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post" asp-action="Index">
        @Html.AntiForgeryToken()

        <div class="card mb-3">
            <div class="card-header bg-white py-2">
                <strong>منوی اصلی</strong>
            </div>
            <div class="card-body py-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowLeads" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowLeads" class="form-check-label">
                                <i class="bi bi-person-lines-fill me-1"></i>
                                لیدها (CRM)
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowBoards" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowBoards" class="form-check-label">
                                <i class="bi bi-kanban me-1"></i>
                                تخته‌ها
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowMindMaps" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowMindMaps" class="form-check-label">
                                <i class="bi bi-diagram-3 me-1"></i>
                                مایندمپ‌ها
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowDesigns" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowDesigns" class="form-check-label">
                                <i class="bi bi-palette me-1"></i>
                                صفحه طراحی
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header bg-white py-2">
                <strong>بخش‌های پروژه</strong>
                <div class="small text-muted">برای همه پروژه‌ها یکسان اعمال می‌شود.</div>
            </div>
            <div class="card-body py-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowProjectTasks" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowProjectTasks" class="form-check-label">
                                <i class="bi bi-list-task me-1"></i>
                                لیست کارها
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowProjectKanban" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowProjectKanban" class="form-check-label">
                                <i class="bi bi-kanban me-1"></i>
                                تخته کانبان
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowProjectSprints" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowProjectSprints" class="form-check-label">
                                <i class="bi bi-calendar-range me-1"></i>
                                اسپرینت‌ها
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowProjectFeatures" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowProjectFeatures" class="form-check-label">
                                <i class="bi bi-puzzle me-1"></i>
                                فیچرها
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowProjectTickets" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowProjectTickets" class="form-check-label">
                                <i class="bi bi-ticket-detailed me-1"></i>
                                تیکت‌ها
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowProjectGallery" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowProjectGallery" class="form-check-label">
                                <i class="bi bi-images me-1"></i>
                                گالری عکس
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch mb-0 py-1">
                            <input asp-for="ShowProjectCategories" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="ShowProjectCategories" class="form-check-label">
                                <i class="bi bi-folder2 me-1"></i>
                                دسته‌بندی‌ها
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.CanManageAdminSections)
        {
            <div class="card mb-3">
                <div class="card-header bg-white py-2">
                    <strong>بخش‌های مدیریتی</strong>
                    <div class="small text-muted">فقط به‌خاطر دسترسی ادمین شما قابل تنظیم هستند.</div>
                </div>
                <div class="card-body py-3">
                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <div class="form-check form-switch mb-0 py-1">
                                <input asp-for="ShowAdminUsers" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="ShowAdminUsers" class="form-check-label">
                                    <i class="bi bi-people me-1"></i>
                                    مدیریت کاربران
                                </label>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-check form-switch mb-0 py-1">
                                <input asp-for="ShowAdminLeaves" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="ShowAdminLeaves" class="form-check-label">
                                    <i class="bi bi-calendar2-week me-1"></i>
                                    مرخصی همکاران
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>
                ذخیره تنظیمات
            </button>
            <a href="/Dashboard" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </form>
</div>
