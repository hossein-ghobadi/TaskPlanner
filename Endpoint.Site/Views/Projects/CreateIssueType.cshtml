@model TaskPlanner.Domain.Entities.TaskPlanner.ProjectIssueType
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var projectId = ViewBag.ProjectId as int?;
    var projectName = ViewBag.ProjectName as string ?? "پروژه";
}

<style>
    .form-section {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .form-section h5 {
        color: #2563eb;
        margin-bottom: 1rem;
        font-weight: 600;
    }
    .icon-preview {
        font-size: 3rem;
        text-align: center;
        padding: 1rem;
        background: #fff;
        border-radius: 8px;
        border: 2px dashed #dee2e6;
        margin-bottom: 1rem;
    }
    .color-preview {
        width: 50px;
        height: 50px;
        border-radius: 8px;
        border: 2px solid #dee2e6;
        display: inline-block;
        margin-right: 0.5rem;
    }
    .icon-picker-grid {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 0.5rem;
        margin-top: 0.5rem;
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }
    .icon-picker-btn {
        background: white;
        border: 2px solid #dee2e6;
        border-radius: 6px;
        padding: 0.5rem;
        font-size: 1.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 45px;
    }
    .icon-picker-btn:hover {
        background: #e9ecef;
        border-color: #2563eb;
        transform: scale(1.1);
    }
    .icon-picker-btn.selected {
        background: #2563eb;
        border-color: #2563eb;
        color: white;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-plus-circle me-2"></i>افزودن نوع تسک جدید
                    </h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        <a href="/Projects/IssueTypes/@projectId" class="text-decoration-none">
                            <i class="bi bi-arrow-right"></i> بازگشت به لیست انواع تسک
                        </a>
                        <span class="mx-2">|</span>
                        <a href="/Projects/Details/@projectId" class="text-decoration-none">
                            <i class="bi bi-arrow-right"></i> بازگشت به پروژه: <strong>@projectName</strong>
                        </a>
                    </p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="CreateIssueType" asp-route-projectId="@projectId" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="ProjectId" />

                        <div asp-validation-summary="All" class="alert alert-danger mb-3 validation-summary" role="alert"></div>

                        <div class="form-section">
                            <h5><i class="bi bi-info-circle me-2"></i>اطلاعات پایه</h5>
                            
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">نام نوع تسک <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="مثلاً: Feature, Enhancement, Technical Debt" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <small class="form-text text-muted">نامی واضح و قابل فهم انتخاب کنید.</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">توضیحات</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="توضیح کوتاه درباره این نوع تسک"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Icon" class="form-label">آیکون (Emoji)</label>
                                    <input asp-for="Icon" class="form-control" id="iconInput" placeholder="مثلاً: 🚀, ⚡, 🎯" maxlength="32" />
                                    <span asp-validation-for="Icon" class="text-danger"></span>
                                    <small class="form-text text-muted">یک emoji برای نمایش در رابط کاربری</small>
                                    <div id="iconPreview" class="icon-preview mt-2" style="display: none;"></div>
                                    
                                    <!-- لیست آیکون‌های قابل انتخاب -->
                                    <div class="mt-3">
                                        <label class="form-label small">انتخاب از لیست:</label>
                                        <div class="icon-picker-grid">
                                            <button type="button" class="icon-picker-btn" data-icon="📦">📦</button>
                                            <button type="button" class="icon-picker-btn" data-icon="✅">✅</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🔹">🔹</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🚀">🚀</button>
                                            <button type="button" class="icon-picker-btn" data-icon="⚡">⚡</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🎯">🎯</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🔥">🔥</button>
                                            <button type="button" class="icon-picker-btn" data-icon="💡">💡</button>
                                            <button type="button" class="icon-picker-btn" data-icon="⭐">⭐</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🎨">🎨</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🔧">🔧</button>
                                            <button type="button" class="icon-picker-btn" data-icon="📝">📝</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🐛">🐛</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🔒">🔒</button>
                                            <button type="button" class="icon-picker-btn" data-icon="📊">📊</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🎪">🎪</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🏆">🏆</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🎁">🎁</button>
                                            <button type="button" class="icon-picker-btn" data-icon="📱">📱</button>
                                            <button type="button" class="icon-picker-btn" data-icon="💻">💻</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🌐">🌐</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🔐">🔐</button>
                                            <button type="button" class="icon-picker-btn" data-icon="📈">📈</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🎬">🎬</button>
                                            <button type="button" class="icon-picker-btn" data-icon="🎮">🎮</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Color" class="form-label">رنگ (Hex)</label>
                                    <div class="input-group">
                                        <input type="color" class="form-control form-control-color" id="colorPicker" value="@(Model?.Color ?? "#3B82F6")" title="انتخاب رنگ">
                                        <input asp-for="Color" class="form-control" placeholder="#3B82F6" maxlength="32" id="colorInput" />
                                    </div>
                                    <span asp-validation-for="Color" class="text-danger"></span>
                                    <small class="form-text text-muted">رنگ برای نمایش در رابط کاربری</small>
                                </div>
                            </div>

                        </div>

                        <!-- تنظیمات پیشرفته - فقط hidden input‌ها -->
                        <input type="hidden" asp-for="BaseType" value="@TaskPlanner.Domain.Entities.TaskPlanner.IssueType.Task" />
                        <input type="hidden" asp-for="Level" value="@TaskPlanner.Domain.Entities.TaskPlanner.IssueTypeLevel.StoryLevel" />
                        <input type="hidden" asp-for="CanAddToSprint" value="true" />
                        <input type="hidden" asp-for="CanHaveChildren" value="true" />
                        <input type="hidden" asp-for="IncludeInReports" value="true" />

                        <div class="d-flex justify-content-between mt-4">
                            <a href="/Projects/IssueTypes/@projectId" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-2"></i>انصراف
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>ایجاد نوع تسک
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // همگام‌سازی color picker با input
        document.addEventListener('DOMContentLoaded', function() {
            const colorPicker = document.getElementById('colorPicker');
            const colorInput = document.getElementById('colorInput');
            const iconInput = document.querySelector('input[name="Icon"]');

            if (colorPicker && colorInput) {
                colorPicker.addEventListener('input', function() {
                    colorInput.value = colorPicker.value;
                });

                colorInput.addEventListener('input', function() {
                    if (/^#[0-9A-F]{6}$/i.test(colorInput.value)) {
                        colorPicker.value = colorInput.value;
                    }
                });
            }

            // نمایش پیش‌نمایش آیکون
            if (iconInput) {
                iconInput.addEventListener('input', function() {
                    updateIconPreview(this.value);
                });
                
                // نمایش اولیه
                if (iconInput.value) {
                    updateIconPreview(iconInput.value);
                }
            }

            // مدیریت انتخاب آیکون از لیست
            const iconPickerButtons = document.querySelectorAll('.icon-picker-btn');
            iconPickerButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    const selectedIcon = this.getAttribute('data-icon');
                    if (iconInput) {
                        iconInput.value = selectedIcon;
                        updateIconPreview(selectedIcon);
                    }
                    
                    // حذف selected از همه دکمه‌ها
                    iconPickerButtons.forEach(b => b.classList.remove('selected'));
                    // اضافه کردن selected به دکمه انتخاب شده
                    this.classList.add('selected');
                });
            });

            // علامت‌گذاری آیکون انتخاب شده فعلی
            if (iconInput && iconInput.value) {
                iconPickerButtons.forEach(btn => {
                    if (btn.getAttribute('data-icon') === iconInput.value) {
                        btn.classList.add('selected');
                    }
                });
            }
        });

        function updateIconPreview(icon) {
            const preview = document.getElementById('iconPreview');
            if (preview) {
                if (icon && icon.trim()) {
                    preview.textContent = icon;
                    preview.style.display = 'block';
                } else {
                    preview.style.display = 'none';
                }
            }
        }
    </script>
}

