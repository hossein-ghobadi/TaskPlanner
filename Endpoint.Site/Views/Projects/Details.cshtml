@section Scripts {
    @await Html.PartialAsync("_ChatAssets")
<script>
(() => {
    const projectId = @Model.Id;
    const currentUserId = '@currentUserId';
    const token = document.body.dataset.antiforgeryToken;

    const groupsListEl = document.getElementById('projectChatGroupsList');
    const messagesEl = document.getElementById('projectChatMessages');
    const headerEl = document.getElementById('projectChatCurrentHeader');
    const messageInputEl = document.getElementById('projectChatMessageInput');
    const sendBtnEl = document.getElementById('projectChatSendBtn');
    const fileInputEl = document.getElementById('projectChatFileInput');
    const recordBtnEl = document.getElementById('projectChatRecordBtn');
    const recordTextEl = document.getElementById('projectChatRecordText');
    const recordTimerEl = document.getElementById('projectChatRecordTimer');
    const attachmentPreviewEl = document.getElementById('projectChatAttachmentPreview');
    const replyPreviewEl = document.getElementById('projectChatReplyPreview');
    const createGroupBtnEl = document.getElementById('createProjectChatGroupBtn');
    const addMembersBtnEl = document.getElementById('addProjectChatMembersBtn');

    function resizeProjectChatMessageInput() {
        messageInputEl.style.height = 'auto';
        messageInputEl.style.height = `${Math.min(messageInputEl.scrollHeight, 140)}px`;
    }

    let connection = null;
    let activeGroupId = null;
    let activeGroupMeta = null;
    let manageGroupId = null;
    let groupsCache = [];
    let selectedFiles = [];
    let mediaRecorder = null;
    let audioChunks = [];
    let recordingStartTime = null;
    let recordingTimer = null;
    let replyingToMessage = null;

    async function ensureConnection() {
        if (connection) {
            return;
        }

        connection = new signalR.HubConnectionBuilder()
            .withUrl('/chathub')
            .withAutomaticReconnect()
            .build();

        connection.on('projectGroupMessageCreated', (message) => {
            if (!message || message.groupId !== activeGroupId) {
                return;
            }
            appendMessage(message);
        });

        connection.on('projectGroupAttachmentDeleted', (payload) => {
            if (!payload) {
                return;
            }
            if (payload.messageDeleted) {
                document.getElementById(`project-chat-message-${payload.messageId}`)?.remove();
                if (!messagesEl.children.length) {
                    messagesEl.innerHTML = '<div class="text-center text-muted py-4">هنوز پیامی در این گروه ثبت نشده است.</div>';
                }
                return;
            }
            document.querySelector(`[data-attachment-item-id="${payload.attachmentId}"]`)?.remove();
        });

        connection.on('projectGroupMessageDeleted', (payload) => {
            if (!payload || !payload.messageId) {
                return;
            }
            document.getElementById(`project-chat-message-${payload.messageId}`)?.remove();
            if (!messagesEl.children.length) {
                messagesEl.innerHTML = '<div class="text-center text-muted py-4">هنوز پیامی در این گروه ثبت نشده است.</div>';
            }
        });

        await connection.start();
    }

    function showAlert(message, type = 'success') {
        const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
        const html = `
            <div class="alert ${alertClass} alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 1055; min-width: 280px;">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;
        document.body.insertAdjacentHTML('beforeend', html);
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert.position-fixed');
            alerts.forEach(a => a.remove());
        }, 2600);
    }

    async function loadGroups() {
        const response = await fetch(`/ProjectTeamChats/GetGroups?projectId=${projectId}`);
        if (!response.ok) {
            groupsListEl.innerHTML = '<div class="p-3 text-danger">خطا در دریافت گروه‌ها</div>';
            return;
        }

        groupsCache = await response.json();
        renderGroups();
    }

    function renderGroups() {
        if (!groupsCache.length) {
            groupsListEl.innerHTML = '<div class="p-3 text-muted">هنوز گروهی ایجاد نشده است.</div>';
            return;
        }

        groupsListEl.innerHTML = groupsCache.map(g => `
            <div class="team-chat-group-item ${activeGroupId === g.id ? 'active' : ''}" data-group-id="${g.id}">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-bold">${escapeHtml(g.name)}</div>
                        <small class="text-muted">${g.membersCount} عضو</small>
                    </div>
                    <div class="d-flex gap-1">
                        ${g.canManageMembers ? `<button class="btn btn-sm btn-outline-secondary manage-members-btn" data-group-id="${g.id}" title="مدیریت اعضا"><i class="bi bi-gear"></i></button>` : ''}
                    </div>
                </div>
            </div>
        `).join('');
    }

    async function selectGroup(groupId) {
        const group = groupsCache.find(g => g.id === groupId);
        if (!group) {
            return;
        }

        if (activeGroupId && connection) {
            await connection.invoke('LeaveProjectGroup', activeGroupId);
        }

        activeGroupId = groupId;
        activeGroupMeta = group;
        renderGroups();
        headerEl.innerHTML = `<strong>${escapeHtml(group.name)}</strong> <span class="text-muted small ms-2">(${group.membersCount} عضو)</span>`;
        sendBtnEl.disabled = false;
        messagesEl.innerHTML = '<div class="text-center text-muted py-4">در حال بارگذاری پیام‌ها...</div>';
        clearReplyTarget();

        await ensureConnection();
        await connection.invoke('JoinProjectGroup', groupId);
        await loadMessages(groupId);
    }

    async function loadMessages(groupId) {
        const response = await fetch(`/ProjectTeamChats/GetMessages?groupId=${groupId}`);
        if (!response.ok) {
            messagesEl.innerHTML = '<div class="text-center text-danger py-4">خطا در دریافت پیام‌ها</div>';
            return;
        }

        const messages = await response.json();
        if (!messages.length) {
            messagesEl.innerHTML = '<div class="text-center text-muted py-4">هنوز پیامی در این گروه ثبت نشده است.</div>';
            return;
        }

        messagesEl.innerHTML = '';
        messages.forEach(appendMessage);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function appendMessage(message) {
        if (document.getElementById(`project-chat-message-${message.id}`)) {
            return;
        }

        const mine = message.userId === currentUserId || message.isCurrentUser;
        const dateText = new Date(message.createdAt).toLocaleString('fa-IR');
        const attachmentsHtml = renderMessageAttachments(message.attachments || [], mine);
        const replyHtml = renderReplyPreview(message);
        const replyActionBtn = `<button type="button" class="btn btn-sm btn-link p-0 mt-1 reply-chat-message-btn" data-message-id="${message.id}" data-message-user="${escapeHtml(message.userName)}" data-message-text="${escapeHtml(message.message || '')}" title="پاسخ"><i class="bi bi-reply"></i> پاسخ</button>`;
        const deleteMessageBtn = mine
            ? `<button type="button" class="btn btn-sm btn-link text-danger p-0 mt-1 ms-2 delete-chat-message-btn" data-message-id="${message.id}" title="حذف پیام"><i class="bi bi-trash"></i> حذف</button>`
            : '';
        const html = `
            <div id="project-chat-message-${message.id}" class="team-chat-message ${mine ? 'mine' : ''}">
                <div class="small text-muted mb-1">${escapeHtml(message.userName)} - ${dateText}</div>
                <div class="team-chat-bubble">
                    ${replyHtml}
                    ${message.message ? `<div class="team-chat-message-text">${escapeHtml(message.message)}</div>` : ''}
                    ${attachmentsHtml}
                    <div>${replyActionBtn}${deleteMessageBtn}</div>
                </div>
            </div>`;
        messagesEl.insertAdjacentHTML('beforeend', html);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function renderReplyPreview(message) {
        if (!message || !message.replyToMessageId) {
            return '';
        }

        const previewUser = escapeHtml(message.replyPreviewUserName || 'کاربر');
        const previewText = escapeHtml(message.replyPreviewMessage || '(بدون متن)');
        return `<div class="chat-reply-preview jump-to-replied-message" data-reply-to-message-id="${message.replyToMessageId}" title="رفتن به پیام اصلی"><div class="small text-primary fw-bold">${previewUser}</div><div class="small text-muted">${previewText}</div></div>`;
    }

    function setReplyTarget(payload) {
        replyingToMessage = payload;
        const previewUser = escapeHtml(payload.userName || 'کاربر');
        const previewText = escapeHtml(payload.messageText || '');
        replyPreviewEl.classList.remove('d-none');
        replyPreviewEl.innerHTML = `
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                    <div class="small text-primary fw-bold">پاسخ به ${previewUser}</div>
                    <div class="small text-muted">${previewText}</div>
                </div>
                <button type="button" class="btn btn-sm btn-link text-danger p-0" id="cancelReplyBtn" title="لغو پاسخ">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>`;
        document.getElementById('cancelReplyBtn')?.addEventListener('click', clearReplyTarget);
    }

    function clearReplyTarget() {
        replyingToMessage = null;
        replyPreviewEl.classList.add('d-none');
        replyPreviewEl.innerHTML = '';
    }

    function jumpToMessage(messageId) {
        const targetEl = document.getElementById(`project-chat-message-${messageId}`);
        if (!targetEl) {
            showAlert('پیام مرجع در لیست فعلی پیدا نشد', 'error');
            return;
        }

        targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        targetEl.classList.add('chat-message-target-highlight');
        setTimeout(() => targetEl.classList.remove('chat-message-target-highlight'), 2200);
    }

    function renderMessageAttachments(attachments, canDelete) {
        if (!attachments || !attachments.length) {
            return '';
        }

        return `<div class="mt-2">${attachments.map(att => {
            const deleteBtn = canDelete
                ? `<button type="button" class="btn btn-sm btn-link text-danger p-0 delete-chat-attachment-btn ms-1" data-attachment-id="${att.id}" title="حذف فایل"><i class="bi bi-trash"></i></button>`
                : '';

            if (att.fileType === 'Image') {
                return `<div class="mb-2" data-attachment-item-id="${att.id}"><a href="${att.filePath}" target="_blank" rel="noopener"><img src="${att.filePath}" alt="${escapeHtml(att.fileName)}" class="chat-attachment-thumb" /></a>${deleteBtn}</div>`;
            }

            if (att.fileType === 'Audio') {
                return `<div class="mb-2 chat-audio-wrap" data-attachment-item-id="${att.id}"><audio class="chat-audio-player" controls preload="metadata" src="${att.filePath}"></audio><div><a href="${att.filePath}" target="_blank" rel="noopener" class="small">دانلود ویس</a>${deleteBtn}</div></div>`;
            }

            return `<div class="mb-1" data-attachment-item-id="${att.id}"><a href="${att.filePath}" target="_blank" rel="noopener"><i class="bi bi-file-earmark"></i> ${escapeHtml(att.fileName)}</a>${deleteBtn}</div>`;
        }).join('')}</div>`;
    }

    function renderSelectedFiles() {
        if (!attachmentPreviewEl) {
            return;
        }

        if (!selectedFiles.length) {
            attachmentPreviewEl.innerHTML = '';
            return;
        }

        attachmentPreviewEl.innerHTML = selectedFiles.map((file, index) => {
            if (file.type && file.type.startsWith('image/')) {
                const url = URL.createObjectURL(file);
                return `
                    <span class="member-pill">
                        <img src="${url}" class="chat-attachment-thumb" style="max-width:80px; max-height:60px;" />
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 remove-selected-file-btn" data-index="${index}">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    </span>`;
            }
            return `
                <span class="member-pill">
                    <span>${escapeHtml(file.name)}</span>
                    <button type="button" class="btn btn-sm btn-link text-danger p-0 remove-selected-file-btn" data-index="${index}">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </span>`;
        }).join('');
    }

    function addSelectedFiles(files) {
        if (!files || !files.length) {
            return;
        }
        selectedFiles.push(...Array.from(files));
        renderSelectedFiles();
    }

    function removeSelectedFile(index) {
        selectedFiles = selectedFiles.filter((_, i) => i !== index);
        renderSelectedFiles();
    }

    async function deleteAttachment(attachmentId) {
        if (!attachmentId) {
            return;
        }

        const body = new URLSearchParams();
        body.append('attachmentId', String(attachmentId));

        const response = await fetch('/ProjectTeamChats/DeleteAttachment', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                'RequestVerificationToken': token
            },
            body: body.toString()
        });

        if (!response.ok) {
            const errorText = await response.text();
            showAlert(errorText || 'خطا در حذف فایل', 'error');
            return;
        }

        const result = await response.json();
        if (result.messageDeleted) {
            document.getElementById(`project-chat-message-${result.messageId}`)?.remove();
            if (!messagesEl.children.length) {
                messagesEl.innerHTML = '<div class="text-center text-muted py-4">هنوز پیامی در این گروه ثبت نشده است.</div>';
            }
        } else {
            document.querySelector(`[data-attachment-item-id="${result.attachmentId}"]`)?.remove();
        }
    }

    async function deleteMessage(messageId) {
        if (!messageId) {
            return;
        }

        const body = new URLSearchParams();
        body.append('messageId', String(messageId));

        const response = await fetch('/ProjectTeamChats/DeleteMessage', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                'RequestVerificationToken': token
            },
            body: body.toString()
        });

        if (!response.ok) {
            const errorText = await response.text();
            showAlert(errorText || 'خطا در حذف پیام', 'error');
            return;
        }

        const result = await response.json();
        document.getElementById(`project-chat-message-${result.messageId}`)?.remove();
        if (!messagesEl.children.length) {
            messagesEl.innerHTML = '<div class="text-center text-muted py-4">هنوز پیامی در این گروه ثبت نشده است.</div>';
        }
    }

    async function startVoiceRecording() {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            const preferredMime = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
                ? 'audio/webm;codecs=opus'
                : (MediaRecorder.isTypeSupported('audio/ogg;codecs=opus') ? 'audio/ogg;codecs=opus' : 'audio/webm');

            mediaRecorder = new MediaRecorder(stream, { mimeType: preferredMime });
            audioChunks = [];
            mediaRecorder.ondataavailable = (event) => {
                if (event.data && event.data.size > 0) {
                    audioChunks.push(event.data);
                }
            };

            mediaRecorder.onstop = () => {
                stream.getTracks().forEach(t => t.stop());
                if (!audioChunks.length) {
                    return;
                }
                const blob = new Blob(audioChunks, { type: mediaRecorder.mimeType || 'audio/webm' });
                const normalizedType = (blob.type || 'audio/webm').split(';')[0].trim() || 'audio/webm';
                const ext = normalizedType.includes('ogg') ? '.ogg' : '.webm';
                const file = new File([blob], `voice_${Date.now()}${ext}`, { type: normalizedType });
                addSelectedFiles([file]);
            };

            mediaRecorder.start(100);
            recordingStartTime = Date.now();
            recordTextEl.textContent = 'توقف';
            recordBtnEl.classList.remove('btn-outline-secondary');
            recordBtnEl.classList.add('btn-outline-danger');
            recordingTimer = setInterval(() => {
                const elapsedSec = Math.floor((Date.now() - recordingStartTime) / 1000);
                const mm = String(Math.floor(elapsedSec / 60)).padStart(2, '0');
                const ss = String(elapsedSec % 60).padStart(2, '0');
                recordTimerEl.textContent = `${mm}:${ss}`;
            }, 1000);
        } catch (err) {
            showAlert('خطا در دسترسی به میکروفن', 'error');
        }
    }

    function stopVoiceRecording() {
        if (mediaRecorder && mediaRecorder.state === 'recording') {
            mediaRecorder.stop();
        }
        if (recordingTimer) {
            clearInterval(recordingTimer);
            recordingTimer = null;
        }
        recordTextEl.textContent = 'ضبط ویس';
        recordTimerEl.textContent = '';
        recordBtnEl.classList.remove('btn-outline-danger');
        recordBtnEl.classList.add('btn-outline-secondary');
    }

    async function sendMessage() {
        const message = (messageInputEl.value || '').trim();
        if (!activeGroupId || (!message && !selectedFiles.length)) {
            return;
        }

        sendBtnEl.disabled = true;
        try {
            const formData = new FormData();
            formData.append('GroupId', String(activeGroupId));
            formData.append('Message', message);
            if (replyingToMessage?.id) {
                formData.append('ReplyToMessageId', String(replyingToMessage.id));
            }
            selectedFiles.forEach(file => formData.append('Attachments', file));

            const response = await fetch('/ProjectTeamChats/SendMessage', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            });

            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(errorText || 'خطا در ارسال پیام');
            }

            messageInputEl.value = '';
            resizeProjectChatMessageInput();
            selectedFiles = [];
            renderSelectedFiles();
            clearReplyTarget();
        } catch (error) {
            showAlert(error.message || 'خطا در ارسال پیام', 'error');
        } finally {
            sendBtnEl.disabled = false;
        }
    }

    async function createGroup() {
        const nameInput = document.getElementById('newProjectChatGroupName');
        const groupName = (nameInput.value || '').trim();
        if (!groupName) {
            showAlert('نام گروه را وارد کنید', 'error');
            return;
        }

        const selectedMembers = Array.from(document.querySelectorAll('.create-group-member-checkbox:checked'))
            .map(c => c.value);

        const response = await fetch('/ProjectTeamChats/CreateGroup', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                projectId,
                name: groupName,
                memberUserIds: selectedMembers
            })
        });

        if (!response.ok) {
            const errorText = await response.text();
            showAlert(errorText || 'خطا در ایجاد گروه', 'error');
            return;
        }

        nameInput.value = '';
        document.querySelectorAll('.create-group-member-checkbox').forEach(c => c.checked = false);
        bootstrap.Modal.getOrCreateInstance(document.getElementById('createTeamChatGroupModal')).hide();
        await loadGroups();
        const created = await response.json();
        if (created.groupId) {
            await selectGroup(created.groupId);
        }
        showAlert('گروه با موفقیت ایجاد شد');
    }

    async function openManageMembers(groupId) {
        manageGroupId = groupId;
        document.querySelectorAll('.manage-group-member-checkbox').forEach(c => c.checked = false);

        const response = await fetch(`/ProjectTeamChats/GetGroupMembers?groupId=${groupId}`);
        if (!response.ok) {
            showAlert('خطا در دریافت اعضای گروه', 'error');
            return;
        }

        const members = await response.json();
        const memberSet = new Set(members.map(m => m.userId));
        const membersContainer = document.getElementById('projectChatCurrentMembersContainer');

        membersContainer.innerHTML = members.length
            ? members.map(m => {
                const removable = activeGroupMeta && activeGroupMeta.canManageMembers;
                const removeButton = removable
                    ? `<button class="btn btn-sm btn-link text-danger p-0 remove-group-member-btn" data-user-id="${m.userId}" title="حذف عضو"><i class="bi bi-x-circle"></i></button>`
                    : '';
                return `<span class="member-pill">${escapeHtml(m.displayName)} ${removeButton}</span>`;
            }).join('')
            : '<span class="text-muted">عضوی وجود ندارد.</span>';

        document.querySelectorAll('.manage-group-member-checkbox').forEach(c => {
            c.checked = memberSet.has(c.value);
        });

        bootstrap.Modal.getOrCreateInstance(document.getElementById('manageProjectChatMembersModal')).show();
    }

    async function addMembersToGroup() {
        if (!manageGroupId) {
            return;
        }

        const selectedUserIds = Array.from(document.querySelectorAll('.manage-group-member-checkbox:checked'))
            .map(c => c.value);

        const response = await fetch('/ProjectTeamChats/AddMembers', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ groupId: manageGroupId, userIds: selectedUserIds })
        });

        if (!response.ok) {
            const errorText = await response.text();
            showAlert(errorText || 'خطا در افزودن اعضا', 'error');
            return;
        }

        await loadGroups();
        await openManageMembers(manageGroupId);
        showAlert('اعضا به‌روزرسانی شدند');
    }

    async function removeMemberFromGroup(userId) {
        if (!manageGroupId || !userId) {
            return;
        }

        const body = new URLSearchParams();
        body.append('groupId', manageGroupId);
        body.append('memberUserId', userId);

        const response = await fetch('/ProjectTeamChats/RemoveMember', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                'RequestVerificationToken': token
            },
            body: body.toString()
        });

        if (!response.ok) {
            const errorText = await response.text();
            showAlert(errorText || 'خطا در حذف عضو', 'error');
            return;
        }

        await loadGroups();
        await openManageMembers(manageGroupId);
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    groupsListEl.addEventListener('click', async (event) => {
        const manageBtn = event.target.closest('.manage-members-btn');
        if (manageBtn) {
            const groupId = Number(manageBtn.dataset.groupId);
            const group = groupsCache.find(g => g.id === groupId);
            if (group) {
                activeGroupMeta = group;
            }
            await openManageMembers(groupId);
            return;
        }

        const item = event.target.closest('.team-chat-group-item');
        if (!item) {
            return;
        }

        const groupId = Number(item.dataset.groupId);
        await selectGroup(groupId);
    });

    document.getElementById('projectChatCurrentMembersContainer').addEventListener('click', async (event) => {
        const removeBtn = event.target.closest('.remove-group-member-btn');
        if (!removeBtn) {
            return;
        }
        const userId = removeBtn.dataset.userId;
        await removeMemberFromGroup(userId);
    });

    sendBtnEl.addEventListener('click', sendMessage);
    messageInputEl.addEventListener('input', resizeProjectChatMessageInput);
    messageInputEl.addEventListener('keydown', async (event) => {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            await sendMessage();
        }
    });
    fileInputEl.addEventListener('change', (event) => {
        addSelectedFiles(event.target.files);
        fileInputEl.value = '';
    });
    messageInputEl.addEventListener('paste', (event) => {
        if (!event.clipboardData || !event.clipboardData.items) {
            return;
        }
        const imageFiles = [];
        for (const item of event.clipboardData.items) {
            if (item.kind === 'file' && item.type.startsWith('image/')) {
                const file = item.getAsFile();
                if (file) {
                    imageFiles.push(file);
                }
            }
        }
        if (imageFiles.length) {
            event.preventDefault();
            addSelectedFiles(imageFiles);
        }
    });
    recordBtnEl.addEventListener('click', async () => {
        if (mediaRecorder && mediaRecorder.state === 'recording') {
            stopVoiceRecording();
            return;
        }
        await startVoiceRecording();
    });
    attachmentPreviewEl.addEventListener('click', (event) => {
        const removeBtn = event.target.closest('.remove-selected-file-btn');
        if (!removeBtn) {
            return;
        }
        const index = Number(removeBtn.dataset.index);
        if (!Number.isNaN(index)) {
            removeSelectedFile(index);
        }
    });
    messagesEl.addEventListener('click', async (event) => {
        const deleteMessageBtn = event.target.closest('.delete-chat-message-btn');
        if (deleteMessageBtn) {
            const messageId = Number(deleteMessageBtn.dataset.messageId);
            if (!Number.isNaN(messageId)) {
                if (!confirm('آیا از حذف این پیام مطمئن هستید؟')) {
                    return;
                }
                await deleteMessage(messageId);
            }
            return;
        }

        const jumpBtn = event.target.closest('.jump-to-replied-message');
        if (jumpBtn) {
            const targetId = Number(jumpBtn.dataset.replyToMessageId);
            if (!Number.isNaN(targetId)) {
                jumpToMessage(targetId);
            }
            return;
        }

        const replyBtn = event.target.closest('.reply-chat-message-btn');
        if (replyBtn) {
            const messageId = Number(replyBtn.dataset.messageId);
            if (Number.isNaN(messageId)) {
                return;
            }
            const userName = replyBtn.dataset.messageUser || 'کاربر';
            const messageText = replyBtn.dataset.messageText || '';
            setReplyTarget({ id: messageId, userName, messageText });
            messageInputEl.focus();
            return;
        }

        const deleteBtn = event.target.closest('.delete-chat-attachment-btn');
        if (!deleteBtn) {
            return;
        }

        const attachmentId = Number(deleteBtn.dataset.attachmentId);
        if (Number.isNaN(attachmentId)) {
            return;
        }

        if (!confirm('آیا از حذف این فایل مطمئن هستید؟')) {
            return;
        }
        await deleteAttachment(attachmentId);
    });
    createGroupBtnEl.addEventListener('click', createGroup);
    addMembersBtnEl.addEventListener('click', addMembersToGroup);

    document.addEventListener('DOMContentLoaded', async () => {
        await loadGroups();
        if (groupsCache.length) {
            await selectGroup(groupsCache[0].id);
        }
    });
})();
</script>
}
