@model Endpoint.Site.Models.ProjectCardVm
@using System.Collections.Generic
@using TaskPlanner.Application.Services.ProjectService

@{
    var currentUserId = ViewData["CurrentUserId"] as string;
    var sprintLookup = ViewData["SprintLookup"] as Dictionary<int, int>;
    var status = ViewData["Status"] is ProjectListFilter selectedStatus ? selectedStatus : ProjectListFilter.Open;
}

<div class="col">
    <div class="project-card js-project-card @(Model.IsClosed ? "is-closed" : "")" data-details-url="@Url.Action("Details", "Projects", new { id = Model.Id })">
        <a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3 gap-2">
                    <h5 class="card-title fw-bold mb-0">@Model.Name</h5>
                    <div class="d-flex flex-column align-items-end gap-1">
                        @if (Model.IsClosed)
                        {
                            <span class="badge bg-secondary">بسته</span>
                        }
                        <span class="badge bg-primary">
                            @Model.TaskCount کار
                        </span>
                    </div>
                </div>
                <p class="card-text text-muted description-text">&nbsp;</p>
            </div>
        </a>

        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2">
                    @if (sprintLookup != null && sprintLookup.ContainsKey(Model.Id))
                    {
                        <a class="btn btn-sm btn-outline-success" asp-controller="Sprints" asp-action="Board" asp-route-id="@sprintLookup[Model.Id]" title="برد اسپرینت فعال">
                            <i class="bi bi-kanban"></i>
                        </a>
                    }
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Tasks" asp-action="Index" asp-route-projectId="@Model.Id" title="لیست کارها">
                        <i class="bi bi-list-task"></i>
                    </a>
                </div>
                <div class="d-flex gap-2">
                    <form asp-action="ToggleClosed" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="status" value="@status" />
                        <button type="submit"
                                class="btn btn-sm @(Model.IsClosed ? "btn-outline-success" : "btn-outline-warning")"
                                title="@(Model.IsClosed ? "باز کردن پروژه" : "بستن پروژه")">
                            <i class="bi @(Model.IsClosed ? "bi-unlock" : "bi-lock")"></i>
                        </button>
                    </form>
                    @if (Model.CreatorUserId == currentUserId)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary js-edit-project-btn"
                                data-project-id="@Model.Id"
                                data-bs-toggle="modal"
                                data-bs-target="#editProjectModal"
                                title="ویرایش">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger js-delete-project-btn"
                                data-project-id="@Model.Id"
                                data-project-name="@Model.Name"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteProjectModal"
                                title="حذف">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
