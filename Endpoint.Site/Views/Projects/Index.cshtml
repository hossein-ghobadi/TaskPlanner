@model Endpoint.Site.Models.ProjectsIndexVm
@{
    ViewData["Title"] = "داشبورد";
    ViewData["UseFluidLayout"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
    var projects = Model?.Projects ?? new List<Endpoint.Site.Models.ProjectCardVm>();
}

<link rel="stylesheet" href="~/css/projects-index.css" />

<div class="dashboard-page">
    <partial name="_ProjectsHeader" />

    @await Html.PartialAsync("_ProjectsStats", viewData: new ViewDataDictionary(ViewData)
    {
        ["ProjectCount"] = Model?.TotalProjectsCount ?? projects.Count,
        ["PendingInviteCount"] = Model?.PendingInviteCount ?? 0,
        ["CollaboratorCount"] = Model?.CollaboratorCount ?? 0,
        ["RecentNoteCount"] = Model?.RecentNoteCount ?? 0
    })

    @await Html.PartialAsync("_ProjectsGrid", projects, new ViewDataDictionary(ViewData)
    {
        ["CurrentUserId"] = Model?.CurrentUserId ?? string.Empty,
        ["SprintLookup"] = Model?.ActiveSprintByProject ?? new Dictionary<int, int>(),
        ["Page"] = Model?.Page ?? 1,
        ["PageSize"] = Model?.PageSize ?? 4,
        ["HasMoreProjects"] = Model?.HasMoreProjects ?? false
    })
</div>

<script>
    (function () {
        // Ensure refresh/load always starts from top on this page.
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }

        var resetScrollTop = function () {
            window.scrollTo(0, 0);
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', resetScrollTop, { once: true });
        } else {
            resetScrollTop();
        }

        // Also handle browser back-forward cache restores.
        window.addEventListener('pageshow', resetScrollTop);
    })();
</script>
