@model IEnumerable<Project>
@using TaskPlanner.Domain.Entities.TaskPlanner
@using System.Security.Claims
@{
    ViewData["Title"] = "داشبورد";
    Layout = "/Views/Shared/_Layout.cshtml";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var pendingProjectInvitations = ViewBag.PendingProjectInvitations as List<ProjectInvitation> ?? new List<ProjectInvitation>();
    var pendingSystemInvitations = ViewBag.PendingSystemInvitations as List<ProjectInvitation> ?? new List<ProjectInvitation>();
    var inviterLookup = ViewBag.InviterLookup as Dictionary<string, string> ?? new Dictionary<string, string>();
    var recentNotes = ViewBag.RecentNotes as List<PersonalNote> ?? new List<PersonalNote>();
}

<!-- بخش خوش‌آمدگویی -->
<div class="welcome-section mb-4">
    <h1 class="display-5 fw-bold mb-2">به برنامه‌ریز خود خوش آمدید! 👋</h1>
    <p class="text-muted">تمام ابزارهای مدیریت کار و پروژه شما در یک مکان</p>
</div>

<!-- محتوای اصلی با سایدبار -->
<div class="main-content-wrapper">
    <!-- محتوای اصلی -->
    <div class="main-content">
        <!-- بخش پروژه‌ها -->
        <div class="projects-section mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title">
            <i class="bi bi-briefcase me-2"></i>
            پروژه‌های من
        </h2>
       
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        <!-- کارت افزودن پروژه جدید -->
        <div class="col">
            <a href="/Projects/Create" class="text-decoration-none">
                <div class="project-card project-card-add">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center" style="min-height: 200px;">
                        <div class="add-project-icon mb-3">
                            <i class="bi bi-plus-circle"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-2">پروژه جدید</h5>
                        <p class="card-text text-muted text-center mb-0">ایجاد یک پروژه جدید</p>
                    </div>
                </div>
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            @foreach (var p in Model)
            {
                <div class="col">
                    <div class="project-card">
                        <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="card-title fw-bold mb-0">@p.Name</h5>
                                    <span class="badge bg-primary">
                                        @{
                                            var filteredTaskCount = p.Tasks?
                                                .Count(t => t.CanAddToSprint) ?? 0;
                                        }
                                        @filteredTaskCount کار
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <p class="card-text text-muted description-text">
                                        @p.Description
                                    </p>
                                }
                                else
                                {
                                    <p class="card-text text-muted">بدون توضیحات</p>
                                }
                            </div>
                        </a>
                        <div class="card-footer">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex gap-2">
                                    @{ var sprintLookup = ViewBag.ActiveSprintByProject as System.Collections.Generic.Dictionary<int,int>; }
                                    @if (sprintLookup != null && sprintLookup.ContainsKey(p.Id))
                                    {
                                        <a class="btn btn-sm btn-outline-success" asp-controller="Sprints" asp-action="Board" asp-route-id="@sprintLookup[p.Id]" title="برد اسپرینت فعال" onclick="event.stopPropagation();">
                                            <i class="bi bi-kanban"></i>
                                        </a>
                                    }
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Tasks" asp-action="Index" asp-route-projectId="@p.Id" title="لیست کارها" onclick="event.stopPropagation();">
                                        <i class="bi bi-list-task"></i>
                                    </a>
                                </div>
                                @if (p.CreatorUserId == currentUserId)
                                {
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id" title="ویرایش" onclick="event.stopPropagation();">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.Id" title="حذف" onclick="event.stopPropagation();">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-inbox display-1 text-muted mb-3"></i>
            <h4 class="text-muted">هنوز پروژه‌ای ندارید</h4>
            <p class="text-muted mb-4">با ایجاد اولین پروژه خود شروع کنید</p>
            <a href="/Projects/Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>
                ایجاد اولین پروژه
            </a>
        </div>
    }
        </div>
    </div>

    <!-- سایدبار -->
    <aside class="sidebar">
        <!-- دعوت‌های در انتظار -->
        @if (pendingProjectInvitations.Any() || pendingSystemInvitations.Any())
        {
            <div class="sidebar-card mb-4">
                <div class="sidebar-card-header">
                    <h5 class="sidebar-card-title">
                        <i class="bi bi-envelope-fill text-danger me-2"></i>
                        دعوت‌های در انتظار
                        <span class="badge bg-danger ms-2">@(pendingProjectInvitations.Count + pendingSystemInvitations.Count)</span>
                    </h5>
                </div>
                <div class="sidebar-card-body">
                    @if (pendingProjectInvitations.Any())
                    {
                        <div class="mb-3">
                            <h6 class="sidebar-subtitle mb-2">
                                <i class="bi bi-briefcase me-1"></i>
                                دعوت‌های پروژه
                            </h6>
                            @foreach (var invite in pendingProjectInvitations.Take(3))
                            {
                                <div class="invitation-item mb-2">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <p class="mb-1 fw-semibold">@(invite.Project?.Name ?? "پروژه")</p>
                                            <small class="text-muted">
                                                <i class="bi bi-person me-1"></i>
                                                @(inviterLookup.ContainsKey(invite.InviterId) ? inviterLookup[invite.InviterId] : "کاربر ناشناس")
                                            </small>
                                        </div>
                                    </div>
                                    <div class="mt-2 d-flex gap-2">
                                        <form method="post" action="/ProjectInvitations/RespondToInvite" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@invite.Id" />
                                            <input type="hidden" name="accept" value="true" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check me-1"></i>
                                                قبول
                                            </button>
                                        </form>
                                        <form method="post" action="/ProjectInvitations/RespondToInvite" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@invite.Id" />
                                            <input type="hidden" name="accept" value="false" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x me-1"></i>
                                                رد
                                            </button>
                                        </form>
                                        <a href="/Projects/Details/@invite.ProjectId" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>
                                            مشاهده
                                        </a>
                                    </div>
                                </div>
                                @if (invite != pendingProjectInvitations.Take(3).Last())
                                {
                                    <hr class="my-2" />
                                }
                            }
                            @if (pendingProjectInvitations.Count > 3)
                            {
                                <a href="/Invitations/MyInvitations" class="btn btn-sm btn-outline-primary w-100 mt-2">
                                    مشاهده همه (@pendingProjectInvitations.Count)
                                </a>
                            }
                        </div>
                    }

                    @if (pendingSystemInvitations.Any())
                    {
                        @if (pendingProjectInvitations.Any())
                        {
                            <hr class="my-3" />
                        }
                        <div>
                            <h6 class="sidebar-subtitle mb-2">
                                <i class="bi bi-people me-1"></i>
                                دعوت‌های سیستم
                            </h6>
                            @foreach (var invite in pendingSystemInvitations.Take(3))
                            {
                                <div class="invitation-item mb-2">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <p class="mb-1 fw-semibold">دعوت به سیستم</p>
                                            <small class="text-muted">
                                                <i class="bi bi-person me-1"></i>
                                                @(inviterLookup.ContainsKey(invite.InviterId) ? inviterLookup[invite.InviterId] : "کاربر ناشناس")
                                            </small>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <form method="post" action="/Invitations/RespondToSystemInvite" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@invite.Id" />
                                            <input type="hidden" name="accept" value="true" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check me-1"></i>
                                                قبول
                                            </button>
                                        </form>
                                        <form method="post" action="/Invitations/RespondToSystemInvite" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@invite.Id" />
                                            <input type="hidden" name="accept" value="false" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x me-1"></i>
                                                رد
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                @if (invite != pendingSystemInvitations.Take(3).Last())
                                {
                                    <hr class="my-2" />
                                }
                            }
                            @if (pendingSystemInvitations.Count > 3)
                            {
                                <a href="/Invitations/MyInvitations" class="btn btn-sm btn-outline-primary w-100 mt-2">
                                    مشاهده همه (@pendingSystemInvitations.Count)
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- پیام عدم وجود دعوت -->
            <div class="sidebar-card mb-4">
                <div class="sidebar-card-header">
                    <h5 class="sidebar-card-title">
                        <i class="bi bi-envelope text-muted me-2"></i>
                        دعوت‌های در انتظار
                    </h5>
                </div>
                <div class="sidebar-card-body text-center py-3">
                    <p class="text-muted mb-0 small">هیچ دعوتی در انتظار نیست</p>
                    <a href="/Invitations/MyInvitations" class="btn btn-sm btn-outline-primary mt-2">
                        مشاهده همه دعوت‌ها
                    </a>
                </div>
            </div>
        }

        <!-- یادداشت‌های اخیر -->
        @if (recentNotes.Any())
        {
            <div class="sidebar-card mb-4">
                <div class="sidebar-card-header">
                    <h5 class="sidebar-card-title">
                        <i class="bi bi-journal-text text-info me-2"></i>
                        یادداشت‌های اخیر
                    </h5>
                </div>
                <div class="sidebar-card-body">
                    @foreach (var note in recentNotes.Take(5))
                    {
                        <div class="note-item mb-2">
                            <a href="/PersonalNotes/Details/@note.Id" class="text-decoration-none text-dark">
                                <div class="d-flex align-items-start">
                                    @if (note.IsPinned)
                                    {
                                        <i class="bi bi-pin-angle-fill text-warning me-2 mt-1"></i>
                                    }
                                    <div class="flex-grow-1">
                                        <p class="mb-1 fw-semibold">@note.Title</p>
                                        @if (!string.IsNullOrWhiteSpace(note.Content))
                                        {
                                            <small class="text-muted d-block" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                @note.Content
                                            </small>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                        @if (note != recentNotes.Take(5).Last())
                        {
                            <hr class="my-2" />
                        }
                    }
                    <a href="/PersonalNotes/Index" class="btn btn-sm btn-outline-info w-100 mt-2">
                        <i class="bi bi-arrow-left me-1"></i>
                        مشاهده همه یادداشت‌ها
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- پیام عدم وجود یادداشت -->
            <div class="sidebar-card mb-4">
                <div class="sidebar-card-header">
                    <h5 class="sidebar-card-title">
                        <i class="bi bi-journal-text text-muted me-2"></i>
                        یادداشت‌های اخیر
                    </h5>
                </div>
                <div class="sidebar-card-body text-center py-3">
                    <p class="text-muted mb-0 small">یادداشتی وجود ندارد</p>
                    <a href="/PersonalNotes/Create" class="btn btn-sm btn-outline-info mt-2">
                        <i class="bi bi-plus me-1"></i>
                        ایجاد یادداشت جدید
                    </a>
                </div>
            </div>
        }

        <!-- دسترسی سریع -->
        <div class="sidebar-card">
            <div class="sidebar-card-header">
                <h5 class="sidebar-card-title">
                    <i class="bi bi-lightning-charge text-warning me-2"></i>
                    دسترسی سریع
                </h5>
            </div>
            <div class="sidebar-card-body">
                <div class="quick-links">
                    <a href="/Tasks/Weekly" class="quick-link-item">
                        <i class="bi bi-calendar-week text-primary"></i>
                        <span>برنامه هفتگی</span>
                    </a>
                    <a href="/Tasks/Index" class="quick-link-item">
                        <i class="bi bi-list-task text-warning"></i>
                        <span>لیست کارها</span>
                    </a>
                    <a href="/PersonalNotes/Index" class="quick-link-item">
                        <i class="bi bi-journal-text text-info"></i>
                        <span>یادداشت‌های شخصی</span>
                    </a>
                    <a href="/Invitations/MyInvitations" class="quick-link-item">
                        <i class="bi bi-envelope text-danger"></i>
                        <span>دعوت‌ها</span>
                    </a>
                </div>
            </div>
        </div>
    </aside>
</div>

<style>
    /* بخش خوش‌آمدگویی */
    .welcome-section {
        padding: 2rem 0;
        border-bottom: 2px solid #e9ecef;
    }

    /* لایه‌بندی اصلی با سایدبار */
    .main-content-wrapper {
        display: flex;
        flex-direction: row-reverse; /* برای قرارگیری sidebar در سمت راست */
        gap: 2rem;
        align-items: flex-start;
    }

    .main-content {
        flex: 1;
        min-width: 0;
    }

    .sidebar {
        width: 320px;
        flex-shrink: 0;
        position: sticky;
        top: 2rem;
        max-height: calc(100vh - 4rem);
        overflow-y: auto;
        align-self: flex-start;
    }

    /* کارت‌های سایدبار */
    .sidebar-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .sidebar-card-header {
        background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .sidebar-card-title {
        font-size: 1rem;
        font-weight: 600;
        color: #1f2937;
        margin: 0;
        display: flex;
        align-items: center;
    }

    .sidebar-subtitle {
        font-size: 0.875rem;
        font-weight: 600;
        color: #4b5563;
        margin: 0;
    }

    .sidebar-card-body {
        padding: 1.25rem;
    }

    /* آیتم‌های دعوت */
    .invitation-item {
        padding: 0.75rem;
        background: #f9fafb;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .invitation-item:hover {
        background: #f3f4f6;
    }

    /* آیتم‌های یادداشت */
    .note-item {
        padding: 0.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .note-item:hover {
        background: #f9fafb;
    }

    /* لینک‌های دسترسی سریع */
    .quick-links {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .quick-link-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: #f9fafb;
        border-radius: 8px;
        text-decoration: none;
        color: #374151;
        transition: all 0.2s ease;
        font-size: 0.9rem;
    }

    .quick-link-item:hover {
        background: #f3f4f6;
        color: #1f2937;
        transform: translateX(-4px);
    }

    .quick-link-item i {
        font-size: 1.25rem;
    }

    /* گرادیانت‌ها */
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    }

    .bg-gradient-danger {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }

    .bg-gradient-purple {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
    }

    /* بخش پروژه‌ها */
    .projects-section {
        margin-top: 0;
    }

    .section-title {
        color: #2d3748;
        font-size: 1.75rem;
        font-weight: 600;
        margin: 0;
    }

    .btn-create {
        border-radius: 12px;
        padding: 0.625rem 1.5rem;
        font-weight: 500;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
    }

    /* کارت‌های پروژه */
    .project-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
        border: 2px solid #f3f4f6;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .project-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
        border-color: #e5e7eb;
    }

    .project-card .card-body {
        padding: 1.5rem;
        flex-grow: 1;
    }

    .project-card .card-title {
        font-size: 1.25rem;
        color: #1f2937;
    }

    .project-card .description-text {
        min-height: 3rem;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        font-size: 0.9rem;
    }

    .project-card .card-footer {
        background: #f9fafb;
        border-top: 1px solid #e5e7eb;
        padding: 1rem 1.5rem;
    }

    .project-card .btn {
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .project-card .badge {
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        font-weight: 500;
    }

    /* کارت افزودن پروژه */
    .project-card-add {
        border: 2px dashed #d1d5db;
        background: linear-gradient(135deg, #f9fafb 0%, #ffffff 100%);
        cursor: pointer;
    }

    .project-card-add:hover {
        border-color: #6366f1;
        background: linear-gradient(135deg, #f0f0ff 0%, #ffffff 100%);
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(99, 102, 241, 0.15);
    }

    .add-project-icon {
        width: 80px;
        height: 80px;
        border-radius: 16px;
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2.5rem;
        transition: all 0.3s ease;
    }

    .project-card-add:hover .add-project-icon {
        transform: scale(1.1);
        box-shadow: 0 8px 16px rgba(139, 92, 246, 0.3);
    }

    /* حالت خالی */
    .empty-state i {
        opacity: 0.3;
    }

    /* ریسپانسیو */
    @@media (max-width: 992px) {
        .main-content-wrapper {
            flex-direction: column;
        }

        .sidebar {
            width: 100%;
            position: static;
            max-height: none;
        }

        .sidebar-card {
            margin-bottom: 1.5rem;
        }
    }

    @@media (max-width: 768px) {
        .welcome-section h1 {
            font-size: 1.75rem;
        }

        .welcome-section {
            padding: 1.5rem 0;
        }

        .main-content-wrapper {
            gap: 1.5rem;
        }

        .sidebar-card-header {
            padding: 0.875rem 1rem;
        }

        .sidebar-card-body {
            padding: 1rem;
        }

        .invitation-item,
        .note-item {
            padding: 0.625rem;
        }
    }
</style>
