@model TaskPlanner.Domain.Entities.TaskPlanner.ProjectIssueType

<div class="issue-type-card">
    <div class="issue-type-header">
        <div class="d-flex align-items-center">
            <i class="bi bi-grip-vertical sortable-handle me-2"></i>
            <span class="issue-type-icon">@(Model.Icon ?? "📝")</span>
            <div>
                <h5 class="mb-0">@Model.Name</h5>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <small class="text-muted">@Model.Description</small>
                }
            </div>
        </div>
        <div>
            @{
                var badgeClass = Model.Level switch
                {
                    TaskPlanner.Domain.Entities.TaskPlanner.IssueTypeLevel.StoryLevel => "badge-story-level",
                    TaskPlanner.Domain.Entities.TaskPlanner.IssueTypeLevel.Epic => "badge-epic",
                    TaskPlanner.Domain.Entities.TaskPlanner.IssueTypeLevel.Subtask => "badge-subtask",
                    _ => "badge-default"
                };
            }
            <span class="issue-type-badge @badgeClass">
                @Model.Level.ToString()
            </span>
        </div>
    </div>

    <div class="mt-3">
        <div class="d-flex flex-wrap gap-2 mb-2">
            @if (Model.CanAddToSprint)
            {
                <span class="badge bg-success">
                    <i class="bi bi-check-circle me-1"></i>قابل افزودن به Sprint
                </span>
            }
            else
            {
                <span class="badge bg-secondary">
                    <i class="bi bi-x-circle me-1"></i>غیرقابل افزودن به Sprint
                </span>
            }

            @if (Model.CanHaveChildren)
            {
                <span class="badge bg-info">
                    <i class="bi bi-diagram-3 me-1"></i>قابل داشتن زیرکار
                </span>
            }

            @if (Model.IncludeInReports)
            {
                <span class="badge bg-primary">
                    <i class="bi bi-graph-up me-1"></i>در گزارش‌ها
                </span>
            }

            @if (!Model.IsCustom)
            {
                <span class="badge bg-warning">
                    <i class="bi bi-shield-check me-1"></i>پیش‌فرض
                </span>
            }
        </div>

        <div class="small text-muted mb-2">
            <div><strong>Base Type:</strong> @Model.BaseType</div>
            <div><strong>Order:</strong> @Model.Order</div>
            @if (!string.IsNullOrEmpty(Model.Color))
            {
                <div>
                    <strong>Color:</strong> 
                    <span class="badge" style="background-color: @Model.Color;">@Model.Color</span>
                </div>
            }
        </div>

        <div class="d-flex gap-2 mt-3">
            <a href="/Projects/EditIssueType/@Model.Id" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-pencil me-1"></i>ویرایش
            </a>
            @if (Model.IsCustom)
            {
                <button type="button" 
                        class="btn btn-sm btn-outline-danger" 
                        onclick="deleteIssueType(@Model.Id, '@Model.Name')">
                    <i class="bi bi-trash me-1"></i>حذف
                </button>
            }
        </div>
    </div>
</div>




