@model IEnumerable<Endpoint.Site.Models.ProjectCardVm>
@using System.Collections.Generic
@using TaskPlanner.Application.Services.ProjectService

@{
    var currentUserId = ViewData["CurrentUserId"] as string;
    var sprintLookup = ViewData["SprintLookup"] as Dictionary<int, int> ?? new Dictionary<int, int>();
    var projects = Model?.ToList() ?? new List<Endpoint.Site.Models.ProjectCardVm>();
    var status = ViewData["Status"] is ProjectListFilter selectedStatus ? selectedStatus : ProjectListFilter.Open;
    var allProjectsCount = ViewData["AllProjectsCount"] as int? ?? 0;
}

<div class="projects-section" id="projectsSection">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="section-title mb-0"><i class="bi bi-briefcase me-2"></i>پروژه‌های من</h2>
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 project-status-filter">
            <label class="form-label mb-0 small text-muted" for="projectStatusFilter">وضعیت</label>
            <select class="form-select form-select-sm" id="projectStatusFilter" name="status" onchange="this.form.submit()">
                @if (status == ProjectListFilter.Open)
                {
                    <option value="@ProjectListFilter.Open" selected>پروژه‌های باز</option>
                }
                else
                {
                    <option value="@ProjectListFilter.Open">پروژه‌های باز</option>
                }
                @if (status == ProjectListFilter.Closed)
                {
                    <option value="@ProjectListFilter.Closed" selected>پروژه‌های بسته</option>
                }
                else
                {
                    <option value="@ProjectListFilter.Closed">پروژه‌های بسته</option>
                }
                @if (status == ProjectListFilter.All)
                {
                    <option value="@ProjectListFilter.All" selected>همه پروژه‌ها</option>
                }
                else
                {
                    <option value="@ProjectListFilter.All">همه پروژه‌ها</option>
                }
            </select>
        </form>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3" id="projectsCardsContainer">
        <partial name="_ProjectAddCard" />
        @await Html.PartialAsync("_ProjectCards", projects, new ViewDataDictionary(ViewData)
        {
            ["CurrentUserId"] = currentUserId,
            ["SprintLookup"] = sprintLookup,
            ["Status"] = status
        })
    </div>

    @{
        var page = (ViewData["Page"] as int?) ?? 1;
        var pageSize = (ViewData["PageSize"] as int?) ?? 4;
        var hasMoreProjects = (ViewData["HasMoreProjects"] as bool?) ?? false;
    }
    <div id="projectsLoadMoreState"
         class="text-center mt-4 text-muted"
         data-next-page="@(page + 1)"
         data-page-size="@pageSize"
         data-has-more="@(hasMoreProjects ? "true" : "false")"
         data-status="@status"
         style="display:@(hasMoreProjects ? "block" : "none")">
        <span id="projectsLoadMoreText">در حال آماده‌سازی بارگذاری بیشتر...</span>
    </div>
    <div id="projectsLoadMoreSentinel" style="height:1px;" aria-hidden="true"></div>

    @if (!projects.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-inbox display-1 text-muted mb-3"></i>
            @if (status == ProjectListFilter.Open && allProjectsCount > 0)
            {
                <h4 class="text-muted">پروژه بازی وجود ندارد</h4>
                <p class="text-muted mb-4">پروژه‌های بسته‌شده را از فیلتر «پروژه‌های بسته» یا «همه پروژه‌ها» ببینید.</p>
            }
            else if (status == ProjectListFilter.Closed)
            {
                <h4 class="text-muted">پروژه بسته‌ای وجود ندارد</h4>
                <p class="text-muted mb-4">با فیلتر «پروژه‌های باز» می‌توانید پروژه‌های فعال را ببینید.</p>
            }
            else
            {
                <h4 class="text-muted">هنوز پروژه‌ای ندارید</h4>
                <p class="text-muted mb-4">با ایجاد اولین پروژه شروع کنید</p>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProjectModal">
                    <i class="bi bi-plus-circle me-2"></i>ایجاد اولین پروژه
                </button>
            }
        </div>
    }
</div>

<script>
    (function () {
        if (!window.__projectsCardTapBinding) {
            window.__projectsCardTapBinding = true;
            document.addEventListener('click', function (event) {
                var card = event.target.closest('.js-project-card');
                if (!card) return;

                var interactive = event.target.closest('a, button, input, textarea, select, label, form');
                if (interactive) return;

                var detailsUrl = card.getAttribute('data-details-url');
                if (detailsUrl) {
                    window.location.href = detailsUrl;
                }
            });
        }

        var loadMoreState = document.getElementById('projectsLoadMoreState');
        var loadMoreText = document.getElementById('projectsLoadMoreText');
        var sentinel = document.getElementById('projectsLoadMoreSentinel');
        var cardsContainer = document.getElementById('projectsCardsContainer');

        if (loadMoreState && loadMoreText && sentinel && cardsContainer) {
            var isLoading = false;
            var ticking = false;

            var loadNextPage = async function () {
                if (isLoading) return;
                if (loadMoreState.getAttribute('data-has-more') !== 'true') return;

                var nextPage = loadMoreState.getAttribute('data-next-page');
                var pageSize = loadMoreState.getAttribute('data-page-size');
                if (!nextPage || !pageSize) return;

                isLoading = true;
                loadMoreText.textContent = 'در حال بارگذاری...';

                try {
                    var url = '/Projects/IndexCards?page=' + encodeURIComponent(nextPage)
                        + '&pageSize=' + encodeURIComponent(pageSize)
                        + '&status=' + encodeURIComponent(loadMoreState.getAttribute('data-status') || 'Open');
                    var response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) {
                        throw new Error('load-failed');
                    }

                    var html = await response.text();
                    cardsContainer.insertAdjacentHTML('beforeend', html);

                    var hasMore = response.headers.get('X-Has-More') === 'true';
                    loadMoreState.setAttribute('data-has-more', hasMore ? 'true' : 'false');

                    if (hasMore) {
                        loadMoreState.setAttribute('data-next-page', String(parseInt(nextPage, 10) + 1));
                        loadMoreText.textContent = 'برای بارگذاری بیشتر اسکرول کنید...';
                    } else {
                        loadMoreState.style.display = 'none';
                    }
                } catch (_) {
                    loadMoreText.textContent = 'خطا در بارگذاری. با اسکرول دوباره تلاش می‌شود...';
                } finally {
                    isLoading = false;
                }
            };

            var shouldLoadMoreByViewport = function () {
                if (loadMoreState.getAttribute('data-has-more') !== 'true') return false;
                var rect = sentinel.getBoundingClientRect();
                return rect.top <= (window.innerHeight + 260);
            };

            var onScrollOrResize = function () {
                if (ticking) return;
                ticking = true;
                window.requestAnimationFrame(function () {
                    if (shouldLoadMoreByViewport()) {
                        loadNextPage();
                    }
                    ticking = false;
                });
            };

            if (window.__projectsInfiniteObserver && typeof window.__projectsInfiniteObserver.disconnect === 'function') {
                window.__projectsInfiniteObserver.disconnect();
            }

            if ('IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            loadNextPage();
                        }
                    });
                }, {
                    root: null,
                    rootMargin: '200px 0px',
                    threshold: 0
                });

                window.__projectsInfiniteObserver = observer;
                observer.observe(sentinel);
                if (loadMoreState.getAttribute('data-has-more') === 'true') {
                    loadMoreText.textContent = 'برای بارگذاری بیشتر اسکرول کنید...';
                }
            }

            // Robust fallback: works even if IntersectionObserver is delayed/missed.
            window.addEventListener('scroll', onScrollOrResize, { passive: true });
            window.addEventListener('resize', onScrollOrResize, { passive: true });
            onScrollOrResize();
        }
    })();
</script>
