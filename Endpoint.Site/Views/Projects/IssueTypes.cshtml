@model List<TaskPlanner.Domain.Entities.TaskPlanner.ProjectIssueType>
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var projectId = ViewBag.ProjectId as int?;
    var projectName = ViewBag.ProjectName as string ?? "پروژه";
    var isCreator = ViewBag.IsCreator as bool? ?? false;
}

@Html.AntiForgeryToken()

<style>
    .issue-type-card {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        background: #fff;
    }
    .issue-type-card:hover {
        border-color: #2563eb;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
        transform: translateY(-2px);
    }
    .issue-type-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
    }
    .issue-type-icon {
        font-size: 2rem;
        margin-left: 0.75rem;
    }
    .issue-type-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
    }
    .badge-story-level {
        background: #dbeafe;
        color: #1e40af;
    }
    .badge-epic {
        background: #f3e8ff;
        color: #6b21a8;
    }
    .badge-subtask {
        background: #e0f2fe;
        color: #0c4a6e;
    }
    .badge-default {
        background: #f1f5f9;
        color: #475569;
    }
    .sortable-handle {
        cursor: move;
        color: #94a3b8;
        font-size: 1.2rem;
    }
    .sortable-handle:hover {
        color: #2563eb;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-tags-fill me-2"></i>مدیریت انواع کار
            </h2>
            <p class="text-muted mb-0">
                <a href="/Projects/Details/@projectId" class="text-decoration-none">
                    <i class="bi bi-arrow-right"></i> بازگشت به پروژه: <strong>@projectName</strong>
                </a>
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-warning" onclick="migrateIssueTypeNames()">
                <i class="bi bi-arrow-repeat me-2"></i>به‌روزرسانی نام‌های پیش‌فرض
            </button>
            <a href="/Projects/CreateIssueType/@projectId" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>افزودن نوع جدید
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle me-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-info-circle"></i>
        <div>
            <strong>نکته:</strong> در این صفحه همه انواع کار (Epic، StoryLevel، Subtask) نمایش داده می‌شوند. همه قابل ویرایش هستند اما فقط انواع سفارشی (کاستوم) قابل حذف هستند.
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox" style="font-size: 4rem; color: #cbd5e1;"></i>
            <p class="text-muted mt-3">هنوز نوع کاری تعریف نشده است.</p>
            <a href="/Projects/CreateIssueType/@projectId" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>افزودن اولین نوع کار
            </a>
        </div>
    }
    else
    {
        // گروه‌بندی بر اساس Level
        var epicTypes = Model.Where(x => x.Level == TaskPlanner.Domain.Entities.TaskPlanner.IssueTypeLevel.Epic).OrderBy(x => x.Order).ToList();
        var storyLevelTypes = Model.Where(x => x.Level == TaskPlanner.Domain.Entities.TaskPlanner.IssueTypeLevel.StoryLevel).OrderBy(x => x.Order).ToList();
        var subtaskTypes = Model.Where(x => x.Level == TaskPlanner.Domain.Entities.TaskPlanner.IssueTypeLevel.Subtask).OrderBy(x => x.Order).ToList();
        
        <div id="issueTypesList">
            @if (epicTypes.Any())
            {
                <div class="mb-4">
                    <h5 class="mb-3 text-muted">
                        <i class="bi bi-box-seam me-2"></i>انواع Epic
                    </h5>
                    <div class="row">
                        @foreach (var issueType in epicTypes)
                        {
                            <div class="col-md-6 col-lg-4 mb-3" data-issue-type-id="@issueType.Id">
                                @Html.Partial("_IssueTypeCard", issueType)
                            </div>
                        }
                    </div>
                </div>
            }
            
            @if (storyLevelTypes.Any())
            {
                <div class="mb-4">
                    <h5 class="mb-3 text-muted">
                        <i class="bi bi-list-task me-2"></i>انواع Story-Level (کار و انواع سفارشی)
                    </h5>
                    <div class="row">
                        @foreach (var issueType in storyLevelTypes)
                        {
                            <div class="col-md-6 col-lg-4 mb-3" data-issue-type-id="@issueType.Id">
                                @Html.Partial("_IssueTypeCard", issueType)
                            </div>
                        }
                    </div>
                </div>
            }
            
            @if (subtaskTypes.Any())
            {
                <div class="mb-4">
                    <h5 class="mb-3 text-muted">
                        <i class="bi bi-diagram-3 me-2"></i>انواع Subtask
                    </h5>
                    <div class="row">
                        @foreach (var issueType in subtaskTypes)
                        {
                            <div class="col-md-6 col-lg-4 mb-3" data-issue-type-id="@issueType.Id">
                                @Html.Partial("_IssueTypeCard", issueType)
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/sortablejs/Sortable.min.js"></script>
    <script>
        let sortableInstance = null;

        document.addEventListener('DOMContentLoaded', function() {
            // ایجاد Sortable برای هر گروه (Epic, StoryLevel, Subtask) - فقط در همان گروه قابل جابجایی
            const allRows = document.querySelectorAll('#issueTypesList .row');
            
            allRows.forEach((row) => {
                new Sortable(row, {
                    handle: '.sortable-handle',
                    animation: 150,
                    group: {
                        name: 'issueTypes',
                        pull: false, // جلوگیری از جابجایی بین گروه‌ها
                        put: false    // جلوگیری از اضافه کردن به گروه‌های دیگر
                    },
                    onEnd: function(evt) {
                        updateOrder();
                    }
                });
            });
        });

        function updateOrder() {
            const items = document.querySelectorAll('[data-issue-type-id]');
            const orders = Array.from(items).map((item, index) => ({
                Id: parseInt(item.dataset.issueTypeId),
                Order: index + 1
            }));

            fetch('/Projects/UpdateIssueTypeOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(orders)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification(data.message || 'ترتیب با موفقیت به‌روزرسانی شد', 'success');
                } else {
                    showNotification(data.message || 'خطا در به‌روزرسانی ترتیب', 'error');
                    location.reload(); // در صورت خطا، صفحه را reload کن
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('خطا در ارتباط با سرور', 'error');
                location.reload();
            });
        }

        function deleteIssueType(id, name) {
            if (!confirm(`آیا مطمئن هستید که می‌خواهید نوع کار "${name}" را حذف کنید؟\n\nاین عمل قابل بازگشت نیست.`)) {
                return;
            }

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/Projects/DeleteIssueType/${id}`;
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token.value;
                form.appendChild(tokenInput);
            }

            document.body.appendChild(form);
            form.submit();
        }

        function showNotification(message, type) {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const alertHtml = `
                <div class="alert ${alertClass} alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 9999; min-width: 300px;">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', alertHtml);
            
            setTimeout(() => {
                const alert = document.querySelector('.alert');
                if (alert) {
                    alert.remove();
                }
            }, 5000);
        }

        function migrateIssueTypeNames() {
            if (!confirm('آیا مطمئن هستید که می‌خواهید نام‌های پیش‌فرض را به‌روزرسانی کنید؟\n\nاین عمل نام‌های "اپیک"، "کار" و "زیرکار" را به ترتیب به "ویژگی"، "کار" و "کارک" تغییر می‌دهد.')) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!token) {
                showNotification('خطا: توکن امنیتی یافت نشد', 'error');
                return;
            }

            const projectId = @projectId;
            
            // استفاده از form برای ارسال صحیح AntiForgeryToken
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Projects/MigrateIssueTypeNames';
            
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token.value;
            form.appendChild(tokenInput);

            // اضافه کردن projectId به form
            if (projectId) {
                const projectIdInput = document.createElement('input');
                projectIdInput.type = 'hidden';
                projectIdInput.name = 'projectId';
                projectIdInput.value = projectId;
                form.appendChild(projectIdInput);
            }

            document.body.appendChild(form);
            form.submit();
        }
    </script>
}

